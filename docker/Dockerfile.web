# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution file
COPY FIS.sln .
COPY Directory.Build.props .
COPY CodeAnalysis.ruleset .
COPY nuget.config .

# Copy project files
COPY src/Core/FIS.Core.Domain/FIS.Core.Domain.csproj src/Core/FIS.Core.Domain/
COPY src/Core/FIS.Core.Application/FIS.Core.Application.csproj src/Core/FIS.Core.Application/
COPY src/Core/FIS.Core.Infrastructure/FIS.Core.Infrastructure.csproj src/Core/FIS.Core.Infrastructure/
COPY src/Data/FIS.Data.SqlServer/FIS.Data.SqlServer.csproj src/Data/FIS.Data.SqlServer/
COPY src/Services/FIS.Web/FIS.Web.csproj src/Services/FIS.Web/

# Restore packages
RUN dotnet restore src/Services/FIS.Web/FIS.Web.csproj

# Copy source code
COPY src/ src/

# Build the application
RUN dotnet build src/Services/FIS.Web/FIS.Web.csproj -c Release --no-restore

# Publish the application
RUN dotnet publish src/Services/FIS.Web/FIS.Web.csproj -c Release --no-build -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy published application
COPY --from=build /app/publish .

# Create non-root user for security
RUN groupadd -r fisweb && useradd -r -g fisweb fisweb
RUN chown -R fisweb:fisweb /app
USER fisweb

# Configure ports
EXPOSE 8080

# Set entry point
ENTRYPOINT ["dotnet", "FIS.Web.dll"]
