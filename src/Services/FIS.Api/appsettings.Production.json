{
  "ConnectionStrings": {
    "Default": "Server=192.0.2.10,1433;Database=legacy;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=False;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "Provider": "MicrosoftGraph",
    "GraphEndpoint": "https://graph.microsoft.com/v1.0",
    "GraphAuthentication": "managed-identity",
    "GraphTenantId": "",
    "GraphClientId": "",
    "GraphManagedIdentityClientId": "",
    "GraphSenderUserPrincipalName": "",
    "FromAddress": "",
    "FromName": "FIS - Fleet Information System",
    "PasswordResetBaseUrl": "https://fis.corptech.co.za",
    "PasswordResetTokenLifetimeMinutes": 30
  },
  "EmailDelivery": {
    "ProviderOrder": ["Graph"],
    "TimeoutSeconds": 30,
    "MaxTotalAttachmentBytes": 20971520,
    "Smtp": {
      "Port": 587,
      "TlsMode": "StartTls",
      "Authentication": "password",
      "FromAddress": "",
      "FromName": "FIS - Fleet Information System"
    },
    "SendGrid": {
      "FromAddress": "",
      "FromName": "FIS - Fleet Information System"
    }
  },
  "SystemSettings": {
    "KeyVaultUri": "",
    "SessionRefreshLifetimeMinutes": 480,
    "RememberRefreshLifetimeMinutes": 10080
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 500
      },
      {
        "Endpoint": "POST:*/api/notification/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "POST:*/api/email-configuration/*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "PUT:*/api/email-configuration",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "CallbackPath": "/signin-oidc"
  },
  "JwtSettings": {
    "Issuer": "FIS.Api",
    "Audience": "FIS.Web",
    "ExpirationMinutes": 480,
    "EnforcePasswordExpiry": true,
    "PasswordExpiryDays": 30
  },
  "AuthenticationSettings": {
    "RequireAuthentication": true,
    "Comment": "PRODUCTION - Authentication is REQUIRED for all API endpoints"
  },
  "Cors": {
    "Origins": ["https://fis.api.corptech.co.za", "https://fis.corptech.co.za"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "FIS.Api.Requests": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5015"
      }
    }
  }
}
