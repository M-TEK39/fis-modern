{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=legacy;Integrated Security=True;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "UseSSL": true,
    "FromName": "FIS - Fleet Information System"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 500
      },
      {
        "Endpoint": "POST:*/api/notification/*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "CallbackPath": "/signin-oidc"
  },
  "JwtSettings": {
    "Issuer": "FIS.Api",
    "Audience": "FIS.Web",
    "ExpirationMinutes": 480
  },
  "AuthenticationSettings": {
    "RequireAuthentication": false,
    "Comment": "DEVELOPMENT - Set to false to bypass auth and allow any credentials."
  },
  "Cors": {
    "Origins": ["http://localhost:5001", "https://localhost:5001"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
