{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=legacy;Integrated Security=True;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "Provider": "MicrosoftGraph",
    "GraphEndpoint": "https://graph.microsoft.com/v1.0",
    "GraphAuthentication": "managed-identity",
    "GraphTenantId": "",
    "GraphClientId": "",
    "GraphManagedIdentityClientId": "",
    "GraphSenderUserPrincipalName": "",
    "FromAddress": "",
    "FromName": "FIS - Fleet Information System",
    "PasswordResetBaseUrl": "http://localhost:5268",
    "PasswordResetTokenLifetimeMinutes": 30
  },
  "EmailDelivery": {
    "ProviderOrder": ["Graph"],
    "TimeoutSeconds": 30,
    "MaxTotalAttachmentBytes": 20971520,
    "Smtp": {
      "Port": 587,
      "TlsMode": "StartTls",
      "Authentication": "password",
      "FromAddress": "",
      "FromName": "FIS - Fleet Information System"
    },
    "SendGrid": {
      "FromAddress": "",
      "FromName": "FIS - Fleet Information System"
    }
  },
  "SystemSettings": {
    "KeyVaultUri": "",
    "SessionRefreshLifetimeMinutes": 480,
    "RememberRefreshLifetimeMinutes": 10080
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 5000
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 500
      },
      {
        "Endpoint": "POST:*/api/notification/*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "POST:*/api/email-configuration/*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "PUT:*/api/email-configuration",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "CallbackPath": "/signin-oidc"
  },
  "JwtSettings": {
    "Issuer": "FIS.Api",
    "Audience": "FIS.Web",
    "ExpirationMinutes": 480
  },
  "AuthenticationSettings": {
    "RequireAuthentication": false,
    "Comment": "DEVELOPMENT - Set to false to bypass auth and allow any credentials."
  },
  "Cors": {
    "Origins": ["http://localhost:5001", "https://localhost:5001"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
