{
  "name": "@fis/web-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "docker compose -f ../../../docker/docker-compose.dev.yml up --build fis-api-dev fis-web-next-dev",
    "dev:down": "docker compose -f ../../../docker/docker-compose.dev.yml down",
    "db:start": "docker compose -f ../../../docker/docker-compose.dev.yml up -d mssql && docker compose -f ../../../docker/docker-compose.dev.yml up db-bootstrap",
    "db:seed": "docker compose -f ../../../docker/docker-compose.dev.yml --profile seed run --rm db-seed",
    "build": "next build",
    "build:safe": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "prettier": "3.9.6",
    "typescript": "^6.0.3"
  }
}
