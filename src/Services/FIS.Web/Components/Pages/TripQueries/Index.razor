@page "/trip-query"
@page "/Trips/TripQuery.aspx"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject ReportCatalogApiService ReportService
@inject IJSRuntime JS

<PageTitle>Trip Queries - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-question-mark"></i>
            Trip Queries
        </h1>
        <p class="page-description">Trip queries from report trip summary/detail APIs.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadQueries">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trip queries...</p>
        </div>
    }
    else if (_queries.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-question-mark"></i>
            <h3>No trip queries</h3>
            <p>No trip query records matched your current criteria.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@FilteredQueries.Count Query record(s)</span>
                <div class="table-controls">
                    <select class="form-select" @bind="_statusFilter" @bind:after="ResetPaging">
                        <option value="">All trip queries</option>
                        <option value="open">Open trips</option>
                        <option value="closed">Closed trips</option>
                        <option value="vehicle">Vehicle-linked trips</option>
                        <option value="notes">Trips with notes</option>
                    </select>
                </div>
            </div>
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input"
                           type="search"
                           placeholder="Search trip number, vehicle, status, notes..."
                           @bind="_searchTerm"
                           @bind:event="oninput"
                           @bind:after="ResetPaging" />
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <button type="button" class="search-clear" @onclick="ClearSearch" aria-label="Clear search">
                            <i class="bx bx-x"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Query #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var query in PagedQueries)
                        {
                            <tr>
                                <td>@query.Number</td>
                                <td>@query.Vehicle</td>
                                <td><span class="badge">@query.Status</span></td>
                                <td>@query.Created.ToString("yyyy-MM-dd")</td>
                                <td>@query.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<TripQueryItem> _queries = new();
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<TripQueryItem> FilteredQueries => _queries
        .Where(MatchesSearch)
        .Where(MatchesFilter)
        .ToList();
    private IEnumerable<TripQueryItem> PagedQueries => FilteredQueries.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredQueries.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadQueries();
    }

    private async Task LoadQueries()
    {
        _loading = true;
        try
        {
            var summaries = await ReportService.GetTripSummaryAsync();
            _queries = summaries
                .Select(t => new TripQueryItem(
                    Number: t.TripId.ToString(),
                    Vehicle: t.VehicleRegistration ?? t.VmfCode?.ToString() ?? "Unknown",
                    Status: t.Status ?? "Unknown",
                    Created: t.TripDate ?? DateTime.MinValue,
                    Notes: t.Notes ?? string.Empty
                ))
                .ToList();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading trip queries: {ex.Message}");
            _queries = new();
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ResetPaging()
    {
        _page = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _page = 1;
    }

    private bool MatchesSearch(TripQueryItem item)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return true;
        }

        var search = _searchTerm.Trim();
        return Contains(item.Number, search) ||
            Contains(item.Vehicle, search) ||
            Contains(item.Status, search) ||
            Contains(item.Notes, search);
    }

    private bool MatchesFilter(TripQueryItem item)
    {
        return _statusFilter switch
        {
            "open" => Contains(item.Status, "open"),
            "closed" => Contains(item.Status, "closed") || Contains(item.Status, "complete"),
            "vehicle" => !string.IsNullOrWhiteSpace(item.Vehicle) && !string.Equals(item.Vehicle, "Unknown", StringComparison.OrdinalIgnoreCase),
            "notes" => !string.IsNullOrWhiteSpace(item.Notes),
            _ => true
        };
    }

    private static bool Contains(string? value, string search)
        => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private sealed record TripQueryItem(string Number, string Vehicle, string Status, DateTime Created, string Notes);
}
