@page "/tracking/reports"
@rendermode InteractiveServer

<PageTitle>Tracking - MobiTrax - Reports Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Tracking - MobiTrax - Reports Menu
        </h1>
        <p class="page-description">Reports menu for tracking.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>One Vehicle &amp; One Tracking Device Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/one-vehicle">1) Tracking Report for ONE Vehicle</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/one-device">2) Tracking Report for ONE Tracking Device</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>All Vehicle &amp; All Tracking Device's Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/all-vehicle">3) Tracking Report for ALL Vehicle</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/all-device">4) Tracking Report for ALL Tracking Device</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>OTHER Tracking Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/install-period">5) Tracking Report for an Install PERIOD</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/site-period">6) Tracking Report for a Site / ALL Site's</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/reports/dept-period">7) Tracking Report for a Dept / ALL Dept's</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking">Return To Main Page</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>
</div>
