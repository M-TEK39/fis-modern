@page "/tracking/maintenance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject TrackingApiService TrackingService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Tracking Maintenance
        </h1>
        <p class="page-description">Capture and maintain tracking records for a selected vehicle.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SearchTracking">Search</button>
            <button class="btn btn-secondary" @onclick="PrepareAdd">Add</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _tracking.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-wrench"></i>
            <h3>No tracking records found</h3>
            <p>Search by GG/Reg number to view tracking maintenance.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Install Date</th>
                            <th>Track Type</th>
                            <th>Remove Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@FormatDate(item.install_date)</td>
                                <td>@item.track_type</td>
                                <td>@FormatDate(item.remove_date)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => EditTracking(item)">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_tracking.Count > 0)
        {
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        }
    }

    @if (_showForm)
    {
        <Modal IsVisible="_showForm" Title="Tracking Maintenance" ShowFooter="false" OnCancel="HideForm">
            <ChildContent>
                <div class="form-card">
                    <div class="form-row">
                        <label class="form-label">Tracker Number</label>
                        <input class="form-input" @bind="_form.track_num" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Install Date</label>
                        <input type="date" class="form-input" @bind="_form.install_date" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Tracker Status</label>
                        <select class="form-select" @bind="_form.track_status">
                            <option value="Installed">Installed</option>
                            <option value="Removed">Removed</option>
                            <option value="Stolen">Stolen</option>
                            <option value="None">None</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Tracker Type</label>
                        <select class="form-select" @bind="_form.track_type">
                            <option value="New">New</option>
                            <option value="Reused">Re-used</option>
                            <option value="None">None</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Previous GG</label>
                        <input class="form-input" @bind="_form.gg_previous" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Follow GG</label>
                        <input class="form-input" @bind="_form.gg_follow" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Remove Date</label>
                        <input type="date" class="form-input" @bind="_form.remove_date" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Notes</label>
                        <input class="form-input" @bind="_form.track_note" />
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SaveTracking">Submit</button>
                        <button class="btn btn-secondary" @onclick="HideForm">Cancel</button>
                    </div>
                </div>
            </ChildContent>
        </Modal>
    }
</div>

@code {
    private bool _loading;
    private bool _showForm;
    private bool _hasSearched;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<TrackingDto> _tracking = new();
    private TrackingDto _form = new();
    private TrackingDto? _editing;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TrackingDto> PagedResults => _tracking.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_tracking.Count / (double)_pageSize));

    private async Task SearchTracking()
    {
        _loading = true;
        _hasSearched = true;
        _tracking = new List<TrackingDto>();
        try
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                _vehicleMatches = new();
                _selectedVmfCode = null;
                _page = 1;
                return;
            }

            var searchTerm = _searchTerm.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _searchMode);
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            if (_selectedVmfCode.HasValue)
            {
                var all = await TrackingService.GetAllAsync<TrackingDto>();
                _tracking = all.Where(t => t.vmf_code == _selectedVmfCode.Value).ToList();
            }
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareAdd()
    {
        _editing = null;
        _form = new TrackingDto();
        _showForm = true;
    }

    private void EditTracking(TrackingDto tracking)
    {
        _editing = tracking;
        _form = new TrackingDto
        {
            track_code = tracking.track_code,
            vmf_code = tracking.vmf_code,
            track_num = tracking.track_num,
            gg_previous = tracking.gg_previous,
            gg_follow = tracking.gg_follow,
            install_date = tracking.install_date,
            remove_date = tracking.remove_date,
            track_status = tracking.track_status,
            track_type = tracking.track_type,
            track_note = tracking.track_note
        };
        _showForm = true;
    }

    private async Task SaveTracking()
    {
        _loading = true;
        try
        {
            if (_editing == null)
            {
                _form.vmf_code ??= ResolveVmfCode();
                await TrackingService.CreateAsync(_form);
            }
            else
            {
                await TrackingService.UpdateAsync(_form.track_code, _form);
            }

            _showForm = false;
            await SearchTracking();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private int? ResolveVmfCode()
    {
        if (_selectedVmfCode.HasValue && _selectedVmfCode.Value > 0)
        {
            return _selectedVmfCode.Value;
        }
        return null;
    }

    private async Task HideForm()
    {
        _showForm = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _tracking = new();
        _showForm = false;
        _page = 1;
    }
}
