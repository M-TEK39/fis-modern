@page "/tracking"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TrackingApiService TrackingService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Tracking - MobiTrax - Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-radar"></i>
            Tracking - MobiTrax - Maintenance Menu
        </h1>
        <p class="page-description">Tracking maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasTrackingRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Tracking</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Tracking - MobiTrax - Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/under_constr.aspx">Tracking Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Tracking - MobiTrax - Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/tracking/maintenance">1) Tracking Maintenance</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Tracking Device Preview"
                      SearchPlaceholder="Search tracker number, GG code, status, notes..."
                      EmptyMessage="No tracking records match the current search or filter."
                      EmptyIcon="bx bx-radar"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
    }
</div>

@code {
    private bool _hasTrackingRole;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("trackNumber", "Tracker No."),
        new("vmfCode", "GG Code"),
        new("installDate", "Installed"),
        new("removeDate", "Removed"),
        new("status", "Status"),
        new("type", "Type"),
        new("note", "Note")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Active tracking devices", "lifecycle", "Active"),
        new("Removed tracking devices", "lifecycle", "Removed"),
        new("Vehicles with previous GG", "historyStatus", "Previous GG")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasTrackingRole = HasRole(authState.User, "Tracking");
        if (!_hasTrackingRole)
        {
            _loading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var tracking = await TrackingService.GetAllAsync<TrackingDto>();
            _rows = tracking
                .OrderByDescending(item => item.install_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["trackNumber"] = item.track_num,
                    ["vmfCode"] = item.vmf_code?.ToString(),
                    ["installDate"] = FormatDate(item.install_date),
                    ["removeDate"] = FormatDate(item.remove_date),
                    ["status"] = item.track_status,
                    ["type"] = item.track_type,
                    ["note"] = item.track_note,
                    ["lifecycle"] = item.remove_date.HasValue ? "Removed" : "Active",
                    ["historyStatus"] = string.IsNullOrWhiteSpace(item.gg_previous) ? "No Previous GG" : "Previous GG",
                    ["_href"] = $"/tracking/maintenance?vmfCode={item.vmf_code}&trackCode={item.track_code}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading tracking preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
