@page "/tracking/reports/dept-period"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for a Dept - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-buildings"></i>
            Tracking Report for a Dept / ALL Dept's
        </h1>
        <p class="page-description">Legacy placeholder for Tracking/RPT_dept_period_main_track.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">From Date</label>
            <input type="date" class="form-input" @bind="_fromDate" />
        </div>
        <div class="form-row">
            <label class="form-label">To Date</label>
            <input type="date" class="form-input" @bind="_toDate" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-buildings"></i>
            <h3>No tracking records found</h3>
            <p>Choose a date range.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@item.vmf_code</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<TrackingDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<TrackingDto>();
        try
        {
            var all = await TrackingService.GetAllAsync<TrackingDto>();
            _results = all.Where(t => (!_fromDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date >= _fromDate.Value.Date)) &&
                                      (!_toDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date <= _toDate.Value.Date)))
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
