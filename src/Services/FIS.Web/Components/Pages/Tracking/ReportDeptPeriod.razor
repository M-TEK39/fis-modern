@page "/tracking/reports/dept-period"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject VehicleApiService VehicleService
@inject DepartmentApiService DepartmentService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for a Dept - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-buildings"></i>
            Tracking Report for a Dept / ALL Dept's
        </h1>
        <p class="page-description">View tracking records by department and period.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Scope</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="deptScope" checked="@(_departmentScope == "all")" @onchange='() => _departmentScope = "all"' />
                    All Departments
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="deptScope" checked="@(_departmentScope == "one")" @onchange='() => _departmentScope = "one"' />
                    Only One Department
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">Department</label>
            <select class="form-select" @bind="_departmentCode">
                <option value="">Select department</option>
                @foreach (var department in _departments)
                {
                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label class="form-label">From Date</label>
            <input type="date" class="form-input" @bind="_fromDate" />
        </div>
        <div class="form-row">
            <label class="form-label">To Date</label>
            <input type="date" class="form-input" @bind="_toDate" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-buildings"></i>
            <h3>No tracking records found</h3>
            <p>Choose a date range.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@GetVehicleLabel(item.vmf_code)</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_results.Count > 0)
        {
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        }
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _departmentScope = "one";
    private int? _departmentCode;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<TrackingDto> _results = new();
    private List<DepartmentDto> _departments = new();
    private List<SiteResponseDto> _sites = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TrackingDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _departments = await DepartmentService.GetDepartmentsAsync();
        _sites = await SiteService.GetAllAsync();
        await LoadVehicleLookupAsync();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var all = await TrackingService.GetAllAsync<TrackingDto>();
            _results = all.Where(t => (!_fromDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date >= _fromDate.Value.Date)) &&
                                      (!_toDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date <= _toDate.Value.Date)))
                .ToList();

            if (_departmentScope == "one" && _departmentCode.HasValue)
            {
                var siteCodes = _sites
                    .Where(s => s.DepartmentCode == _departmentCode.Value)
                    .Select(s => s.SiteCode)
                    .ToHashSet();
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                var vmfForDepartment = vehicles.Data
                    .Where(v => v.site_code.HasValue && siteCodes.Contains(v.site_code.Value))
                    .Select(v => v.vmf_code)
                    .ToHashSet();
                _results = _results
                    .Where(t => t.vmf_code.HasValue && vmfForDepartment.Contains(t.vmf_code.Value))
                    .ToList();
            }
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private async Task LoadVehicleLookupAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabelByVmf = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(
                g => g.Key,
                g => FormatVehicleLabel(g.First()));
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
}
