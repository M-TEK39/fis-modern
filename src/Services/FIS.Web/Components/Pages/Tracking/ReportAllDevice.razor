@page "/tracking/reports/all-device"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for ALL Tracking Device - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-chip"></i>
            Tracking Report for ALL Tracking Device
        </h1>
        <p class="page-description">View tracker activity across all tracking devices.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Tracker Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "New")" @onchange='() => _trackerType = "New"' />
                    New
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "Reused")" @onchange='() => _trackerType = "Reused"' />
                    Re-used
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "All")" @onchange='() => _trackerType = "All"' />
                    All
                </label>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Report Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-chip"></i>
            <h3>No tracking records found</h3>
            <p>Load report to view all devices.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@GetVehicleLabel(item.vmf_code)</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_results.Count > 0)
        {
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        }
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _trackerType = "All";
    private List<TrackingDto> _results = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TrackingDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicleLookupAsync();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var all = await TrackingService.GetAllAsync<TrackingDto>();
            _results = _trackerType switch
            {
                "New" => all.Where(t => string.Equals(t.track_type, "New", StringComparison.OrdinalIgnoreCase)).ToList(),
                "Reused" => all.Where(t => string.Equals(t.track_type, "Reused", StringComparison.OrdinalIgnoreCase)).ToList(),
                _ => all
            };
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private async Task LoadVehicleLookupAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabelByVmf = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(
                g => g.Key,
                g => FormatVehicleLabel(g.First()));
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
}
