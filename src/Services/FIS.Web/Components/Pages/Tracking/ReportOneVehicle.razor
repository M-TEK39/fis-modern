@page "/tracking/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for ONE Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Tracking Report for ONE Vehicle
        </h1>
        <p class="page-description">Legacy Tracking/RPT_one_gg_main_track.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "gg")" @onchange='() => _searchMode = "gg"' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "gp")" @onchange='() => _searchMode = "gp"' />
                    GP
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_searchMode == "gg" ? "GG Number" : "GP Number")</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No tracking records found</h3>
            <p>Search by GG or registration number.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Install Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@FormatDate(item.install_date)</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _searchTerm = string.Empty;
    private string _searchMode = "gp";
    private List<TrackingDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var matches = await VehicleLookupService.SearchAsync(_searchTerm);
            var vmfCode = matches.FirstOrDefault()?.VmfCode;
            if (vmfCode.HasValue)
            {
                var all = await TrackingService.GetAllAsync<TrackingDto>();
                _results = all.Where(t => t.vmf_code == vmfCode.Value).ToList();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
}
