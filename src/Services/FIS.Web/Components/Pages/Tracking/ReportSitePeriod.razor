@page "/tracking/reports/site-period"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for a Site - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map"></i>
            Tracking Report for a Site / ALL Site's
        </h1>
        <p class="page-description">Legacy Tracking/RPT_site_period_main_track.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Scope</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="siteScope" checked="@(_siteScope == "all")" @onchange='() => _siteScope = "all"' />
                    All Sites
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="siteScope" checked="@(_siteScope == "one")" @onchange='() => _siteScope = "one"' />
                    Only One Site
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">Site</label>
            <select class="form-select" @bind="_siteCode">
                <option value="">Select site</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.SiteCode">@site.DepartmentNumber - @site.Description</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label class="form-label">From Date</label>
            <input type="date" class="form-input" @bind="_fromDate" />
        </div>
        <div class="form-row">
            <label class="form-label">To Date</label>
            <input type="date" class="form-input" @bind="_toDate" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-map"></i>
            <h3>No tracking records found</h3>
            <p>Choose filters to load tracking data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@item.vmf_code</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _siteScope = "one";
    private short? _siteCode;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<TrackingDto> _results = new();
    private List<SiteResponseDto> _sites = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var all = await TrackingService.GetAllAsync<TrackingDto>();
            _results = all.Where(t => (!_fromDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date >= _fromDate.Value.Date)) &&
                                      (!_toDate.HasValue || (t.install_date.HasValue && t.install_date.Value.Date <= _toDate.Value.Date)))
                .ToList();

            if (_siteScope == "one" && _siteCode.HasValue)
            {
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                var vmfForSite = vehicles.Data
                    .Where(v => v.site_code == _siteCode)
                    .Select(v => v.vmf_code)
                    .ToHashSet();
                _results = _results
                    .Where(t => t.vmf_code.HasValue && vmfForSite.Contains(t.vmf_code.Value))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
