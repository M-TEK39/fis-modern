@page "/tracking/reports/site-period"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for a Site - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map"></i>
            Tracking Report for a Site / ALL Site's
        </h1>
        <p class="page-description">View tracking records by site and period.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Scope</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="siteScope" checked="@(_siteScope == "all")" @onchange='() => _siteScope = "all"' />
                    All Sites
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="siteScope" checked="@(_siteScope == "one")" @onchange='() => _siteScope = "one"' />
                    Only One Site
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">Site</label>
            <select class="form-select" @bind="_siteCode">
                <option value="">Select site</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label class="form-label">From Date</label>
            <input type="date" class="form-input" @bind="_fromDate" />
        </div>
        <div class="form-row">
            <label class="form-label">To Date</label>
            <input type="date" class="form-input" @bind="_toDate" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-map"></i>
            <h3>No tracking records found</h3>
            <p>Choose filters to load tracking data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tracker Number</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.track_num</td>
                                <td>@GetVehicleLabel(item.vmf_code)</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_results.Count > 0)
        {
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        }
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _siteScope = "one";
    private short? _siteCode;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<TrackingDto> _results = new();
    private List<SiteResponseDto> _sites = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TrackingDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        await LoadVehicleLookupAsync();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var report = await TrackingService.GetSitePeriodReportAsync(new TrackingSitePeriodReportRequestDto
            {
                SiteCode = _siteCode ?? 0,
                AllSites = _siteScope == "all",
                StartDate = (_fromDate ?? DateTime.Today.AddYears(-50)).Date,
                EndDate = (_toDate ?? DateTime.Today.AddYears(10)).Date
            });
            _results = report.Data;
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private async Task LoadVehicleLookupAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabelByVmf = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(
                g => g.Key,
                g => FormatVehicleLabel(g.First()));
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
