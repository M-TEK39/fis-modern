@page "/tracking/reports/all-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrackingApiService TrackingService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for ALL Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Tracking Report for ALL Vehicle
        </h1>
        <p class="page-description">Legacy Tracking/RPT_all_gg_main_track.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Tracker Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "New")" @onchange='() => _trackerType = "New"' />
                    New
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "Reused")" @onchange='() => _trackerType = "Reused"' />
                    Re-used
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="trackerType" checked="@(_trackerType == "All")" @onchange='() => _trackerType = "All"' />
                    All
                </label>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
            <a class="btn btn-secondary" href="/tracking/reports">Report Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No tracking records found</h3>
            <p>Load report to view all vehicles.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Tracker Number</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.vmf_code</td>
                                <td>@item.track_num</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _trackerType = "All";
    private List<TrackingDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _hasSearched = true;
        _results = new List<TrackingDto>();
        try
        {
            var all = await TrackingService.GetAllAsync<TrackingDto>();
            _results = _trackerType switch
            {
                "New" => all.Where(t => string.Equals(t.track_type, "New", StringComparison.OrdinalIgnoreCase)).ToList(),
                "Reused" => all.Where(t => string.Equals(t.track_type, "Reused", StringComparison.OrdinalIgnoreCase)).ToList(),
                _ => all
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
