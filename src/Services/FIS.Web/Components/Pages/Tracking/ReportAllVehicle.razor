@page "/tracking/reports/all-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject TrackingApiService TrackingService
@inject IJSRuntime JSRuntime

<PageTitle>Tracking Report for ALL Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Tracking Report for ALL Vehicle
        </h1>
        <p class="page-description">Legacy placeholder for Tracking/RPT_all_gg_main_track.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadReport">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No tracking records found</h3>
            <p>Load report to view all vehicles.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Tracker Number</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.vmf_code</td>
                                <td>@item.track_num</td>
                                <td>@item.track_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


    <LegacyEndpointActionPanel
        LegacyPath="Tracking/RPT_all_gg_main_track.aspx"
        Endpoint="api/tracking/reports/all-vehicles"
        HttpMethod="POST"
        ButtonText="Test Tracking All Vehicles Report Endpoint"
        ReportType="tracking-report-all-vehicles" />

@code {
    private bool _loading;
    private List<TrackingDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<TrackingDto>();
        try
        {
            _results = await TrackingService.GetAllAsync<TrackingDto>();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
