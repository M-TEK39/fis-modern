@page "/contracts"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Contracts Menu - Fleet Information System</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Contracts Menu
        </h1>
        <p class="page-description">Vehicle contract maintenance aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoMainMenu">Main Menu</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoContractsMenu">Contracts Menu</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoTop">Top</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoBottom">Bottom</button>
    </div>
</div>

<div class="page-content">
    <div id="ContractsMenu" class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractsInfo">
                <span>Contracts Information / Help</span>
                <i class="bx @(_showContractsInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractsInfo)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/help">Contracts Information / Help</a>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractMaintenance">
                <span>Contract Maintenance</span>
                <i class="bx @(_showContractMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts">1) Vehicle Contract Maintenance</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/backdating-approval">2) Vehicle Contract Back Date Requests - Approval</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/backdating-history">3) Vehicle Contract History Backdating</a>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractBookings">
                <span>Vehicle Bookings</span>
                <i class="bx @(_showContractBookings ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractBookings)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/call-centre">1) Vehicle Bookings</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Vehicle Contract Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="contract-search-row">
                            <span class="contract-search-label">Select the vehicle to manage:</span>
                            <div class="contract-search-inputs">
                                <div class="contract-search-radio">
                                    <label class="form-label">
                                        <input type="radio" name="searchType" value="GG" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                                        GG
                                    </label>
                                    <label class="form-label">
                                        <input type="radio" name="searchType" value="GP" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                                        GP Number
                                    </label>
                                </div>
                                <input type="text"
                                       class="form-input"
                                       placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")"
                                       @bind="_searchQuery"
                                       @bind:event="oninput" />
                                <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicle" disabled="@_searching">
                                    @if (_searching)
                                    {
                                        <span class="spinner-sm"></span>
                                        <span>Searching...</span>
                                    }
                                    else
                                    {
                                        <span>Search</span>
                                    }
                                </button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearSearch" disabled="@_searching">Clear</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_searchError))
                        {
                            <div class="form-error contract-search-error">@_searchError</div>
                        }
                        @if (_selectedVehicle != null)
                        {
                            <div class="contract-search-result">
                                <div><strong>Selected Vehicle:</strong> @_selectedVehicle.fleet_number (@_selectedVehicle.registration_number)</div>
                                <div>Make/Model: @_selectedVehicle.model_name | Status: @_selectedVehicle.status_description</div>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="OpenSelectedVehicle">Open Contract Management</button>
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <div class="contract-filters">
            <label class="form-label">
                <input type="checkbox" checked="@_filterPermanent" @onchange="TogglePermanent" />
                Permanent
            </label>
            <label class="form-label">
                <input type="checkbox" checked="@_filterDaily" @onchange="ToggleDaily" />
                Daily
            </label>
            <label class="form-label">
                <input type="checkbox" checked="@_filterHourly" @onchange="ToggleHourly" />
                Hourly
            </label>
            <label class="form-label">
                <input type="checkbox" checked="@_filterRelieve" @onchange="ToggleRelieve" />
                Relieve
            </label>
            <label class="form-label">
                <input type="checkbox" checked="@_filterLease" @onchange="ToggleLease" />
                Lease
            </label>
        </div>

        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Pending Contracts</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="contract-legacy-content">
                        @if (_loadingContracts)
                        {
                            <div class="loading-state">
                                <div class="spinner"></div>
                                <p>Loading pending contracts...</p>
                            </div>
                        }
                        else if (FilteredPendingContracts.Count == 0)
                        {
                            <div class="empty-state">
                                <i class="bx bx-file"></i>
                                <h3>No pending contracts</h3>
                                <p>Pending contracts will appear here once they require action.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var contract in FilteredPendingContracts)
                            {
                                <table class="contract-subtable">
                                    <tbody>
                                        <tr>
                                            <th>GG Number</th>
                                            <td>@GetFleetNumber(contract)</td>
                                            <th>Status</th>
                                            <td>@GetVehicleStatus(contract)</td>
                                            <th>Contract Type</th>
                                            <td>@GetContractType(contract)</td>
                                            <th>Contract Status</th>
                                            <td>@GetContractStatus(contract)</td>
                                        </tr>
                                        <tr>
                                            <th>Reg Number</th>
                                            <td>@GetRegNumber(contract)</td>
                                            <th>Hire Type</th>
                                            <td>@GetHireType(contract)</td>
                                            <th>Start Date</th>
                                            <td>@FormatDate(contract.start_date)</td>
                                            <th>Status Date</th>
                                            <td>@FormatDate(contract.end_date)</td>
                                        </tr>
                                        <tr>
                                            <th>Make</th>
                                            <td>@GetMake(contract)</td>
                                            <th>Location</th>
                                            <td>@GetLocation(contract)</td>
                                            <th>Modified</th>
                                            <td>@FormatDate(contract.end_date)</td>
                                            <th rowspan="2" class="contract-action-header">Action</th>
                                            <td rowspan="2" class="contract-actions">
                                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "view")'>View</button>
                                                @if (CanReviewContract(contract))
                                                {
                                                    <button class="btn btn-primary btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "review")'>Review</button>
                                                    <button class="btn btn-success btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "process")'>Process</button>
                                                }
                                                @if (CanEditContract(contract))
                                                {
                                                    <button class="btn btn-warning btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "edit")'>Edit</button>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Model</th>
                                            <td colspan="3">@GetModel(contract)</td>
                                            <th>Username</th>
                                            <td>@GetUserName(contract)</td>
                                        </tr>
                                        <tr>
                                            <th>Department</th>
                                            <td colspan="3">@GetDepartment(contract)</td>
                                            <th>Site</th>
                                            <td colspan="3">@GetSite(contract)</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="contract-divider"></div>
                            }
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<a id="PageBottom"></a>

@code {
    private bool _showContractsInfo = true;
    private bool _showContractMaintenance = true;
    private bool _showContractBookings = true;


    private string _searchType = "GG";
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private VehicleDto? _selectedVehicle;

    private bool _loadingContracts = true;
    private List<ContractDto> _pendingContracts = new();

    private bool _filterPermanent = true;
    private bool _filterDaily = true;
    private bool _filterHourly = true;
    private bool _filterRelieve = true;
    private bool _filterLease = true;
    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasContractApproverRole;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadPendingContracts();
    }

    private async Task LoadPendingContracts()
    {
        _loadingContracts = true;
        try
        {
            var contracts = await ContractService.GetRecentContractsWindowAsync();
            _pendingContracts = await FilterPendingContractsAsync(contracts);
            await HydratePendingContractsAsync();
        }
        finally
        {
            _loadingContracts = false;
        }
    }

    private void ToggleContractsInfo() => _showContractsInfo = !_showContractsInfo;
    private void ToggleContractMaintenance() => _showContractMaintenance = !_showContractMaintenance;
    private void ToggleContractBookings() => _showContractBookings = !_showContractBookings;

    private void GoMainMenu() => Navigation.NavigateTo("/home");
    private void GoContractsMenu() => Navigation.NavigateTo("/contracts#ContractsMenu");
    private void GoTop() => Navigation.NavigateTo("/contracts#PageTop");
    private void GoBottom() => Navigation.NavigateTo("/contracts#PageBottom");

    private void SetSearchType(string type)
    {
        _searchType = type;
        _searchError = null;
    }

    private async Task SearchVehicle()
    {
        _searchError = null;
        _selectedVehicle = null;

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchError = _searchType == "GG" ? "Enter a GG number to search." : "Enter a GP number to search.";
            return;
        }

        _searching = true;
        try
        {
            var results = await VehicleService.SearchVehiclesAsync(_searchQuery.Trim());
            var query = _searchQuery.Trim();
            if (_searchType == "GG")
            {
                _selectedVehicle = results
                    .FirstOrDefault(v =>
                        string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                _selectedVehicle = results
                    .FirstOrDefault(v =>
                        string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase));
            }

            _selectedVehicle ??= results.FirstOrDefault(v =>
                _searchType == "GG"
                    ? (v.fleet_number?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                    : (v.registration_number?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));

            if (_selectedVehicle == null)
            {
                _searchError = "No vehicles matched the search criteria.";
            }
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchError = null;
        _selectedVehicle = null;
    }

    private async Task OpenSelectedVehicle()
    {
        if (_selectedVehicle == null)
        {
            return;
        }

        var contract = await ContractService.GetLatestContractForVehicleAsync(_selectedVehicle.vmf_code);
        var ggNumber = Uri.EscapeDataString(_selectedVehicle.fleet_number ?? "");
        var regNumber = Uri.EscapeDataString(_selectedVehicle.registration_number ?? "");
        if (contract?.contract_id > 0)
        {
            Navigation.NavigateTo($"/contracts/detail?contractId={contract.contract_id}&ggnumber={ggNumber}&regnumber={regNumber}");
            return;
        }

        Navigation.NavigateTo($"/contracts/detail?ggnumber={ggNumber}&regnumber={regNumber}");
    }

    private void OpenContractDetail(ContractDto contract, string action)
    {
        var contractId = contract.contract_id;
        var regNumber = Uri.EscapeDataString(contract.vehicle_registration ?? "");
        var ggNumber = Uri.EscapeDataString(contract.Vehicle?.fleet_number ?? "");
        Navigation.NavigateTo($"/contracts/detail?contractId={contractId}&action={action}&ggnumber={ggNumber}&regnumber={regNumber}");
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    }

    private static string FormatDate(DateTime date)
    {
        return date.ToString("yyyy/MM/dd");
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetFleetNumber(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.fleet_number ?? contract.vehicle_registration);

    private static string GetRegNumber(ContractDto contract)
        => ValueOrDash(contract.vehicle_registration);

    private static string GetVehicleStatus(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.status_description ?? contract.status);

    private static string GetContractType(ContractDto contract)
        => ValueOrDash(contract.contractor_name);

    private static string GetContractStatus(ContractDto contract)
        => ValueOrDash(contract.status);

    private static string GetHireType(ContractDto contract)
        => ValueOrDash(contract.contractor_name);

    private static string GetMake(ContractDto contract)
        => ValueOrDash(contract.vehicle_make);

    private static string GetLocation(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.location_description);

    private static string GetModel(ContractDto contract)
        => ValueOrDash(contract.vehicle_model ?? contract.Vehicle?.model_name);

    private static string GetUserName(ContractDto contract)
        => ValueOrDash("-");

    private static string GetDepartment(ContractDto contract)
        => ValueOrDash(contract.department_name ?? contract.Department?.department_description);

    private static string GetSite(ContractDto contract)
        => ValueOrDash(contract.site_code?.ToString());

    private List<ContractDto> FilteredPendingContracts
        => _pendingContracts.Where(MatchesContractTypeFilter).ToList();

    private void TogglePermanent(ChangeEventArgs _) => _filterPermanent = !_filterPermanent;
    private void ToggleDaily(ChangeEventArgs _) => _filterDaily = !_filterDaily;
    private void ToggleHourly(ChangeEventArgs _) => _filterHourly = !_filterHourly;
    private void ToggleRelieve(ChangeEventArgs _) => _filterRelieve = !_filterRelieve;
    private void ToggleLease(ChangeEventArgs _) => _filterLease = !_filterLease;

    private bool MatchesContractTypeFilter(ContractDto contract)
    {
        var contractType = (GetContractType(contract) ?? string.Empty).Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(contractType))
        {
            return true;
        }

        if ((contractType.Contains("permanent") || contractType.Contains("perm")) && !_filterPermanent)
        {
            return false;
        }

        if (contractType.Contains("daily") && !_filterDaily)
        {
            return false;
        }

        if (contractType.Contains("hourly") && !_filterHourly)
        {
            return false;
        }

        if ((contractType.Contains("relieve") || contractType.Contains("relief")) && !_filterRelieve)
        {
            return false;
        }

        if (contractType.Contains("lease") && !_filterLease)
        {
            return false;
        }

        return true;
    }

    private async Task<List<ContractDto>> FilterPendingContractsAsync(List<ContractDto> contracts)
    {
        var pending = contracts
            .Where(c => c.contract_status_code == 1)
            .ToList();

        foreach (var contract in contracts)
        {
            if (pending.Any(p => p.contract_id == contract.contract_id))
            {
                continue;
            }

            var pendingResponse = await ContractService.GetActionAsync($"api/contracts/{contract.contract_id}/pending");
            if (!pendingResponse.Success || string.IsNullOrWhiteSpace(pendingResponse.ResponseBody))
            {
                continue;
            }

            try
            {
                using var doc = JsonDocument.Parse(pendingResponse.ResponseBody);
                if (doc.RootElement.TryGetProperty("isPending", out var isPending) && isPending.GetBoolean())
                {
                    if (doc.RootElement.TryGetProperty("submittedByUserCode", out var submittedBy))
                    {
                        if (submittedBy.ValueKind == JsonValueKind.Number && submittedBy.TryGetInt32(out var submittedByCode))
                        {
                            contract.created_by_user_code = submittedByCode;
                        }
                        else if (submittedBy.ValueKind == JsonValueKind.String && int.TryParse(submittedBy.GetString(), out submittedByCode))
                        {
                            contract.created_by_user_code = submittedByCode;
                        }
                    }

                    pending.Add(contract);
                }
            }
            catch
            {
                // Ignore malformed pending responses and continue.
            }
        }

        return pending;
    }

    private async Task HydratePendingContractsAsync()
    {
        if (_pendingContracts.Count == 0)
        {
            return;
        }

        foreach (var contract in _pendingContracts)
        {
            if (contract.vmf_code.HasValue && contract.Vehicle == null)
            {
                contract.Vehicle = await VehicleService.GetVehicleAsync(contract.vmf_code.Value);
            }

            if (contract.site_code.HasValue && contract.Department == null)
            {
                var site = await SiteService.GetByIdAsync(contract.site_code.Value);
                if (site?.DepartmentCode != null)
                {
                    contract.Department = await DepartmentService.GetDepartmentAsync(site.DepartmentCode.Value);
                }
            }
        }
    }

    private bool CanReviewContract(ContractDto contract)
        => _hasContractApproverRole && !IsCurrentUserContractCapturer(contract);

    private bool CanEditContract(ContractDto contract)
        => IsCurrentUserContractCapturer(contract) || !_hasContractApproverRole;

    private bool IsCurrentUserContractCapturer(ContractDto contract)
    {
        if (_currentUserAccessCode is not > 0)
        {
            return false;
        }

        if (contract.user_code is > 0 && contract.user_code.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        return contract.created_by_user_code is > 0 && contract.created_by_user_code.Value == _currentUserAccessCode.Value;
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _hasContractApproverRole = HasAnyRole(user, "contracts approver", "contracts_approver", "back dating contract (approver)");

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        if (!_hasContractApproverRole && (_currentAccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
        {
            _hasContractApproverRole = true;
        }
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool HasAnyRole(ClaimsPrincipal user, params string[] roles)
    {
        foreach (var role in roles)
        {
            if (user.IsInRole(role))
            {
                return true;
            }
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => roles.Any(role => string.Equals(item, role, StringComparison.OrdinalIgnoreCase))));
    }
}
