@page "/contracts"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject DriverApiService DriverService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Contracts Menu - Fleet Information System</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Contracts Menu
        </h1>
        <p class="page-description">Vehicle contract maintenance.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoMainMenu">Main Menu</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoContractsMenu">Contracts Menu</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoTop">Top</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoBottom">Bottom</button>
    </div>
</div>

<div class="page-content">
    <div id="ContractsMenu" class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractsInfo">
                <span>Contracts Information / Help</span>
                <i class="bx @(_showContractsInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractsInfo)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/help">Contracts Information / Help</a>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractMaintenance">
                <span>Contract Maintenance</span>
                <i class="bx @(_showContractMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts">1) Vehicle Contract Maintenance</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/backdating-approval">2) Vehicle Contract Back Date Requests - Approval</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/backdating-history">3) Vehicle Contract History Backdating</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/contracts/print-menu">4) Contract Print Out Menu</a>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleContractBookings">
                <span>Vehicle Bookings</span>
                <i class="bx @(_showContractBookings ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showContractBookings)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/call-centre">1) Vehicle Bookings</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Vehicle Contract Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="contract-search-row">
                            <span class="contract-search-label">Select the vehicle to manage:</span>
                            <div class="contract-search-inputs">
                                <div class="contract-search-radio">
                                    <label class="form-label">
                                        <input type="radio" name="searchType" value="GG" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                                        GG
                                    </label>
                                    <label class="form-label">
                                        <input type="radio" name="searchType" value="GP" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                                        GP Number
                                    </label>
                                </div>
                                <input type="text"
                                       class="form-input"
                                       placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")"
                                       @bind="_searchQuery"
                                       @bind:event="oninput" />
                                <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicle" disabled="@_searching">
                                    @if (_searching)
                                    {
                                        <span class="spinner-sm"></span>
                                        <span>Searching...</span>
                                    }
                                    else
                                    {
                                        <span>Search</span>
                                    }
                                </button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearSearch" disabled="@_searching">Clear</button>
                            </div>
                            <div class="contract-search-inputs fis-mt-05">
                                <select class="form-select" style="min-width: 22rem;" @bind="_selectedVehicleVmfCode" @bind:after="OnSelectedVehicleChanged" disabled="@(_vehicleSearchMatches.Count == 0)">
                                    <option value="">Select vehicle...</option>
                                    @foreach (var vehicle in _vehicleSearchMatches)
                                    {
                                        <option value="@vehicle.vmf_code">@GetVehicleContextLabel(vehicle)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_searchError))
                        {
                            <div class="form-error contract-search-error">@_searchError</div>
                        }
                        @if (_selectedVehicle != null)
                        {
                            <div class="contract-search-result">
                                <div><strong>Selected Vehicle:</strong> @GetVehicleContextLabel(_selectedVehicle)</div>
                                <div>Make/Model: @_selectedVehicle.model_name | Status: @_selectedVehicle.status_description</div>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="OpenSelectedVehicle">Open Contract Management</button>
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Contracts</span>
                <div class="table-controls">
                    <select class="form-select" style="min-width: 10rem;" @bind="_statusFilter">
                        <option value="">All Statuses</option>
                        <option value="0">Draft</option>
                        <option value="1">Pending Review</option>
                        <option value="2">Approved</option>
                        <option value="3">Active</option>
                        <option value="4">Declined for Correction</option>
                        <option value="5">Declined</option>
                        <option value="6">Cancelled</option>
                        <option value="7">Closed</option>
                    </select>
                    <select class="form-select" style="min-width: 10rem;" @bind="_siteFilter">
                        <option value="">All Sites</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.SiteCode.ToString()">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                    <select class="form-select" style="min-width: 9rem;" @bind="_stillCurrentFilter">
                        <option value="">All</option>
                        <option value="Y">Still Current</option>
                        <option value="N">Not Current</option>
                    </select>
                    <input type="date" class="form-input" @bind-value="_startDateFrom" @bind-value:format="yyyy-MM-dd" />
                    <input type="date" class="form-input" @bind-value="_startDateTo" @bind-value:format="yyyy-MM-dd" />
                    <button class="btn btn-primary btn-sm" type="button" @onclick="ApplyFiltersAsync" disabled="@_loadingContracts">Apply</button>
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearFiltersAsync" disabled="@_loadingContracts">Reset</button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <div class="alert @(_actionError ? "alert-error" : "alert-success")" style="margin:0.75rem 0;">@_actionMessage</div>
            }

            @if (_loadingContracts)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading contracts...</p>
                </div>
            }
            else if (_contracts.Count == 0)
            {
                <div class="empty-state">
                    <i class="bx bx-file"></i>
                    <h3>No contracts found</h3>
                    <p>No records matched the selected filters.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Contract #</th>
                                <th>Vehicle (Fleet/GG No)</th>
                                <th>Site/Dept</th>
                                <th>Driver</th>
                                <th>Start Date</th>
                                <th>Target Return</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contract in _contracts)
                            {
                                <tr>
                                    <td>@contract.contract_id</td>
                                    <td>@GetVehicleDisplay(contract)</td>
                                    <td>@GetSiteDepartmentDisplay(contract)</td>
                                    <td>@ValueOrDash(contract.driver_name)</td>
                                    <td>@FormatDate(contract.start_date)</td>
                                    <td>@FormatDate(contract.target_return_date)</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(contract.contract_status_code)">@GetStatusLabel(contract)</span>
                                    </td>
                                    <td class="actions-column">
                                        <div class="table-actions">
                                            @foreach (var action in GetRowActions(contract))
                                            {
                                                @if (action.Kind == "print")
                                                {
                                                    <a class="btn btn-secondary btn-sm" href="@GetPrintoutUrl(contract.contract_id)" target="_blank">@action.Label</a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary btn-sm" type="button" @onclick="() => RunRowActionAsync(contract, action)">@action.Label</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPageAsync" disabled="@(_page <= 1 || _loadingContracts)">Previous</button>
                    <div class="pagination-info">Page @_page of @Math.Max(1, _totalPages)</div>
                    <button class="pagination-btn" @onclick="NextPageAsync" disabled="@(_page >= _totalPages || _loadingContracts)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_totalRecords | Page size: @_pageSize</div>
            }
        </div>
    </div>
</div>

@if (_showEditModal && _editingContractModel != null)
{
    <Modal IsVisible="_showEditModal"
           Title="@GetEditModalTitle()"
           ShowFooter="false"
           ShowCloseButton="true"
           Size="Modal.ModalSize.Large"
           OnCancel="CloseEditModalAsync">
        <ChildContent>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_editingContractModel.SiteCode" disabled="@_editSaving">
                        <option value="">Select site</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Target Return Date</label>
                    <input type="date" class="form-input" @bind-value="_editingContractModel.TargetReturnDate" @bind-value:format="yyyy-MM-dd" disabled="@_editSaving" />
                </div>
                <div class="form-group">
                    <label class="form-label">Start Odometer</label>
                    <input type="number" min="0" class="form-input" @bind="_editingContractModel.StartOdometer" disabled="@_editSaving" />
                </div>
                <div class="form-group">
                    <label class="form-label">Driver ID</label>
                    <select class="form-select" @bind="_editingContractModel.DriverId" disabled="@_editSaving">
                        <option value="">Select driver</option>
                        @foreach (var driver in _drivers)
                        {
                            <option value="@driver.site_driver_code.ToString()">@DriverDisplay(driver)</option>
                        }
                    </select>
                </div>
                <div class="form-group form-group-full">
                    <label class="form-label">Notes</label>
                    <textarea class="form-textarea" rows="4" @bind="_editingContractModel.Notes" disabled="@_editSaving"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_editValidationMessage))
            {
                <div class="alert alert-error" style="margin-top:0.75rem;">@_editValidationMessage</div>
            }

            <div class="form-actions" style="margin-top:1rem; display:flex; gap:0.5rem; justify-content:flex-end;">
                <button class="btn btn-secondary" type="button" @onclick="CloseEditModalAsync" disabled="@_editSaving">Cancel</button>
                <button class="btn btn-primary" type="button" @onclick="SaveEditedContractAsync" disabled="@_editSaving">
                    @if (_editSaving)
                    {
                        <span class="spinner-sm"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
                @if (CanResubmitEditedContract())
                {
                    <button class="btn btn-warning" type="button" @onclick="SaveAndResubmitEditedContractAsync" disabled="@_editSaving">
                        Save + Resubmit
                    </button>
                }
            </div>
        </ChildContent>
    </Modal>
}

<a id="PageBottom"></a>

@code {
    private bool _showContractsInfo = true;
    private bool _showContractMaintenance = true;
    private bool _showContractBookings = true;

    private string _searchType = "GG";
    private string _searchQuery = string.Empty;
    private bool _searching;
    private string? _searchError;
    private List<VehicleDto> _vehicleSearchMatches = new();
    private int? _selectedVehicleVmfCode;
    private VehicleDto? _selectedVehicle;

    private bool _loadingContracts = true;
    private readonly List<ContractDto> _contracts = new();
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();

    private string _statusFilter = string.Empty;
    private string _siteFilter = string.Empty;
    private string _stillCurrentFilter = string.Empty;
    private DateTime? _startDateFrom;
    private DateTime? _startDateTo;

    private int _page = 1;
    private readonly int _pageSize = 12;
    private int _totalPages = 1;
    private int _totalRecords;

    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasContractApproverRole;
    private bool _isAdminUser;

    private string _actionMessage = string.Empty;
    private bool _actionError;
    private bool _showEditModal;
    private bool _editSaving;
    private string? _editValidationMessage;
    private ContractEditModel? _editingContractModel;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();
        await LoadContractsPageAsync();
    }

    private async Task LoadContractsPageAsync()
    {
        _loadingContracts = true;
        _actionMessage = string.Empty;
        try
        {
            var query = new ContractsPageQuery
            {
                Page = _page,
                PageSize = _pageSize,
                StatusCode = ParseShort(_statusFilter),
                SiteCode = ParseShort(_siteFilter),
                StillCurrent = string.IsNullOrWhiteSpace(_stillCurrentFilter) ? null : _stillCurrentFilter,
                StartDateFrom = _startDateFrom,
                StartDateTo = _startDateTo
            };

            var result = await ContractService.GetContractsPageAsync(query);

            _contracts.Clear();
            _contracts.AddRange(result.Data);
            _totalRecords = result.TotalRecords;
            _totalPages = Math.Max(1, result.TotalPages);

            await EnrichContractsAsync();
        }
        finally
        {
            _loadingContracts = false;
        }
    }

    private async Task EnrichContractsAsync()
    {
        foreach (var contract in _contracts)
        {
            if (string.IsNullOrWhiteSpace(contract.fleet_number) || string.IsNullOrWhiteSpace(contract.vehicle_registration))
            {
                if (contract.vmf_code is > 0)
                {
                    contract.Vehicle ??= await VehicleService.GetVehicleAsync(contract.vmf_code.Value);
                    contract.fleet_number ??= contract.Vehicle?.fleet_number;
                    contract.vehicle_registration = string.IsNullOrWhiteSpace(contract.vehicle_registration)
                        ? (contract.Vehicle?.registration_number ?? string.Empty)
                        : contract.vehicle_registration;
                }
            }

            if (string.IsNullOrWhiteSpace(contract.site_name) && contract.site_code is > 0)
            {
                var site = _sites.FirstOrDefault(s => s.SiteCode == contract.site_code.Value)
                    ?? await SiteService.GetByIdAsync(contract.site_code.Value);
                contract.site_name = site?.Description;

                if (string.IsNullOrWhiteSpace(contract.department_name) && site?.DepartmentCode is > 0)
                {
                    var dept = await DepartmentService.GetDepartmentAsync(site.DepartmentCode.Value);
                    contract.department_name = dept?.department_description ?? contract.department_name;
                }
            }
        }
    }

    private void ToggleContractsInfo() => _showContractsInfo = !_showContractsInfo;
    private void ToggleContractMaintenance() => _showContractMaintenance = !_showContractMaintenance;
    private void ToggleContractBookings() => _showContractBookings = !_showContractBookings;

    private void GoMainMenu() => Navigation.NavigateTo("/home");
    private void GoContractsMenu() => Navigation.NavigateTo("/contracts#ContractsMenu");
    private void GoTop() => Navigation.NavigateTo("/contracts#PageTop");
    private void GoBottom() => Navigation.NavigateTo("/contracts#PageBottom");

    private void SetSearchType(string type)
    {
        _searchType = type;
        _searchError = null;
    }

    private async Task SearchVehicle()
    {
        _searchError = null;
        _selectedVehicle = null;
        _selectedVehicleVmfCode = null;
        _vehicleSearchMatches = new();

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchError = _searchType == "GG" ? "Enter a GG number to search." : "Enter a GP number to search.";
            return;
        }

        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var results = await VehicleService.SearchVehiclesAsync(query);
            _vehicleSearchMatches = RankVehicleMatchesBySearchType(results, query, _searchType);
            if (_vehicleSearchMatches.Count == 0)
            {
                _searchError = "No vehicles matched the search criteria.";
                return;
            }

            _searchError = "Select a vehicle from the list to continue.";
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _searchError = null;
        _vehicleSearchMatches = new();
        _selectedVehicleVmfCode = null;
        _selectedVehicle = null;
    }

    private Task OnSelectedVehicleChanged()
    {
        _selectedVehicle = _selectedVehicleVmfCode.HasValue
            ? _vehicleSearchMatches.FirstOrDefault(v => v.vmf_code == _selectedVehicleVmfCode.Value)
            : null;
        return Task.CompletedTask;
    }

    private static List<VehicleDto> RankVehicleMatchesBySearchType(List<VehicleDto> matches, string query, string searchType)
    {
        return (searchType == "GG"
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                searchType == "GG"
                    ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(v =>
                searchType == "GG"
                    ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private async Task OpenSelectedVehicle()
    {
        if (_selectedVehicle == null)
        {
            return;
        }

        var contract = await ContractService.GetLatestContractForVehicleAsync(_selectedVehicle.vmf_code);
        var ggNumber = Uri.EscapeDataString(_selectedVehicle.fleet_number ?? string.Empty);
        var regNumber = Uri.EscapeDataString(_selectedVehicle.registration_number ?? string.Empty);

        if (contract?.contract_id > 0)
        {
            Navigation.NavigateTo($"/contracts/detail?contractId={contract.contract_id}&ggnumber={ggNumber}&regnumber={regNumber}");
            return;
        }

        Navigation.NavigateTo($"/contracts/detail?ggnumber={ggNumber}&regnumber={regNumber}");
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadContractsPageAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _statusFilter = string.Empty;
        _siteFilter = string.Empty;
        _stillCurrentFilter = string.Empty;
        _startDateFrom = null;
        _startDateTo = null;
        _page = 1;
        await LoadContractsPageAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_page <= 1)
        {
            return;
        }

        _page--;
        await LoadContractsPageAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= _totalPages)
        {
            return;
        }

        _page++;
        await LoadContractsPageAsync();
    }

    private async Task RunRowActionAsync(ContractDto contract, ContractRowAction action)
    {
        _actionError = false;
        _actionMessage = string.Empty;

        if (action.Kind == "edit")
        {
            OpenEditModal(contract);
            return;
        }

        if (action.Kind == "view" || action.Kind == "review")
        {
            var ggNumber = Uri.EscapeDataString(contract.fleet_number ?? contract.Vehicle?.fleet_number ?? string.Empty);
            var regNumber = Uri.EscapeDataString(contract.vehicle_registration ?? contract.Vehicle?.registration_number ?? string.Empty);
            var actionParam = action.Kind == "view" ? string.Empty : $"&action={action.Kind}";
            Navigation.NavigateTo($"/contracts/detail?contractId={contract.contract_id}{actionParam}&ggnumber={ggNumber}&regnumber={regNumber}");
            return;
        }

        var endpoint = action.Kind switch
        {
            "submit" => $"api/contracts/{contract.contract_id}/submit",
            "resubmit" => $"api/contracts/{contract.contract_id}/submit",
            "recall" => $"api/contracts/{contract.contract_id}/recall",
            "activate" => $"api/contracts/{contract.contract_id}/approve-activate",
            "extend" => $"api/contracts/{contract.contract_id}/extend",
            "close" => $"api/contracts/{contract.contract_id}/close",
            "cancel" => $"api/contracts/{contract.contract_id}/cancel",
            _ => string.Empty
        };

        if (string.IsNullOrWhiteSpace(endpoint))
        {
            return;
        }

        var response = await ContractService.PostActionAsync(endpoint, new { });
        _actionError = !response.Success;
        _actionMessage = response.Message;

        await LoadContractsPageAsync();
    }

    private void OpenEditModal(ContractDto contract)
    {
        if (!IsCurrentUserContractCapturer(contract) && !_isAdminUser)
        {
            _actionError = true;
            _actionMessage = "Only the original contract capturer can edit this record.";
            return;
        }

        _editingContractModel = new ContractEditModel
        {
            ContractId = contract.contract_id,
            StatusCode = contract.contract_status_code ?? 0,
            SiteCode = contract.site_code,
            DriverId = string.IsNullOrWhiteSpace(contract.driver_id) ? null : contract.driver_id.Trim(),
            Notes = contract.contract_notes ?? string.Empty,
            TargetReturnDate = contract.target_return_date
        };

        _editValidationMessage = null;
        _showEditModal = true;
    }

    private Task CloseEditModalAsync()
    {
        _showEditModal = false;
        _editSaving = false;
        _editValidationMessage = null;
        _editingContractModel = null;
        return Task.CompletedTask;
    }

    private async Task SaveEditedContractAsync()
    {
        await SaveEditedContractCoreAsync(resubmitAfterSave: false);
    }

    private async Task SaveAndResubmitEditedContractAsync()
    {
        await SaveEditedContractCoreAsync(resubmitAfterSave: true);
    }

    private async Task SaveEditedContractCoreAsync(bool resubmitAfterSave)
    {
        if (_editingContractModel == null)
        {
            return;
        }

        _editValidationMessage = null;
        if (_editingContractModel.SiteCode is null or <= 0)
        {
            _editValidationMessage = "Select a site before saving.";
            return;
        }

        _editSaving = true;
        _actionMessage = string.Empty;
        _actionError = false;

        try
        {
            var editResult = await ContractService.PutActionAsync($"api/contracts/{_editingContractModel.ContractId}/edit", new
            {
                SiteCode = _editingContractModel.SiteCode,
                DriverId = string.IsNullOrWhiteSpace(_editingContractModel.DriverId) ? null : _editingContractModel.DriverId.Trim(),
                Notes = string.IsNullOrWhiteSpace(_editingContractModel.Notes) ? null : _editingContractModel.Notes.Trim(),
                TargetReturnDate = _editingContractModel.TargetReturnDate,
                StartOdometer = _editingContractModel.StartOdometer
            });

            if (!editResult.Success)
            {
                _actionError = true;
                _actionMessage = editResult.Message;
                return;
            }

            if (resubmitAfterSave && _editingContractModel.StatusCode == 4)
            {
                var submitResult = await ContractService.PostActionAsync($"api/contracts/{_editingContractModel.ContractId}/submit", new { });
                _actionError = !submitResult.Success;
                _actionMessage = submitResult.Message;
            }
            else
            {
                _actionMessage = editResult.Message;
            }

            if (!_actionError)
            {
                await CloseEditModalAsync();
            }

            await LoadContractsPageAsync();
        }
        finally
        {
            _editSaving = false;
        }
    }

    private bool CanResubmitEditedContract()
        => _editingContractModel?.StatusCode == 4;

    private string GetEditModalTitle()
    {
        if (_editingContractModel == null)
        {
            return "Edit Contract";
        }

        return _editingContractModel.StatusCode == 4
            ? $"Edit Contract {_editingContractModel.ContractId} (Correction)"
            : $"Edit Contract {_editingContractModel.ContractId}";
    }

    private IReadOnlyList<ContractRowAction> GetRowActions(ContractDto contract)
    {
        var statusCode = contract.contract_status_code ?? -1;
        var isCapturer = IsCurrentUserContractCapturer(contract);
        var canReview = _hasContractApproverRole && !isCapturer;
        var actions = statusCode switch
        {
            0 => (_isAdminUser || isCapturer)
                ? new[] { new ContractRowAction("Edit", "edit"), new ContractRowAction("Submit", "submit") }
                : Array.Empty<ContractRowAction>(),
            1 => _isAdminUser
                ? new[] { new ContractRowAction("Recall", "recall"), new ContractRowAction("Review", "review") }
                : isCapturer
                    ? new[] { new ContractRowAction("Recall", "recall") }
                    : canReview
                        ? new[] { new ContractRowAction("Review", "review") }
                        : Array.Empty<ContractRowAction>(),
            2 => (_isAdminUser || canReview)
                ? new[] { new ContractRowAction("Activate", "activate") }
                : Array.Empty<ContractRowAction>(),
            3 => (_isAdminUser || canReview)
                ? new[]
                {
                    new ContractRowAction("Extend", "extend"),
                    new ContractRowAction("Close", "close"),
                    new ContractRowAction("Cancel", "cancel")
                }
                : Array.Empty<ContractRowAction>(),
            4 => _isAdminUser
                ? new[] { new ContractRowAction("Edit", "edit") }
                : isCapturer
                    ? new[] { new ContractRowAction("Edit", "edit"), new ContractRowAction("Resubmit", "resubmit") }
                    : Array.Empty<ContractRowAction>(),
            6 or 7 => new[] { new ContractRowAction("View", "view") },
            _ => Array.Empty<ContractRowAction>()
        };

        if (statusCode >= 2)
        {
            return actions.Append(new ContractRowAction("Print", "print")).ToList();
        }

        return actions;
    }

    private bool IsCurrentUserContractCapturer(ContractDto contract)
    {
        if (_currentUserAccessCode is not > 0)
        {
            return false;
        }

        if (contract.user_code is > 0 && contract.user_code.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        return contract.created_by_user_code is > 0 && contract.created_by_user_code.Value == _currentUserAccessCode.Value;
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _hasContractApproverRole = HasAnyRole(user, "contracts approver", "contracts_approver", "back dating contract (approver)");

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        if (!_hasContractApproverRole && (_currentAccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
        {
            _hasContractApproverRole = true;
        }

        _isAdminUser = HasAnyRole(user, "admin", "administrator")
            || (_currentAccessLevel & LegacyPermissionBits.UserAdministration) == LegacyPermissionBits.UserAdministration;
    }

    private static short? ParseShort(string? value)
    {
        return short.TryParse(value, out var parsed) ? parsed : null;
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool HasAnyRole(ClaimsPrincipal user, params string[] roles)
    {
        foreach (var role in roles)
        {
            if (user.IsInRole(role))
            {
                return true;
            }
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => roles.Any(role => string.Equals(item, role, StringComparison.OrdinalIgnoreCase))));
    }

    private static string GetVehicleDisplay(ContractDto contract)
    {
        var fleet = ValueOrDash(contract.fleet_number ?? contract.Vehicle?.fleet_number);
        var registration = ValueOrDash(contract.vehicle_registration ?? contract.Vehicle?.registration_number);
        return $"{fleet} / {registration}";
    }

    private static string GetSiteDepartmentDisplay(ContractDto contract)
    {
        var site = ValueOrDash(contract.site_name);
        var dept = ValueOrDash(contract.department_name);
        return $"{site} / {dept}";
    }

    private static string GetStatusLabel(ContractDto contract)
    {
        return contract.contract_status_code switch
        {
            0 => "Draft",
            1 => "Pending Review",
            2 => "Approved",
            3 => "Active",
            4 => "Declined for Correction",
            5 => "Declined",
            6 => "Cancelled",
            7 => "Closed",
            _ => ValueOrDash(contract.status)
        };
    }

    private static string GetStatusBadgeClass(short? statusCode)
        => statusCode switch
        {
            1 => "badge-warning",
            2 => "status-info",
            3 => "badge-success",
            4 => "badge-warning",
            5 => "badge-error",
            6 => "badge-error",
            _ => string.Empty
        };

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    }

    private static string FormatDate(DateTime date)
    {
        return date.ToString("yyyy/MM/dd");
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleContextLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string DriverDisplay(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code})";
    }

