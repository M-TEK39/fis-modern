@using FIS.Web.Models

@if (Loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading contracts...</p>
    </div>
}
else if (Contracts.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-file"></i>
        <h3>No contracts found</h3>
        <p>@(HasSearchTerm ? "No contracts match your search criteria" : "Get started by creating your first vehicle contract")</p>
        @if (!HasSearchTerm)
        {
            <button class="btn btn-primary" @onclick="OnAddContract">
                <i class="bx bx-plus plus-icon"></i>
                New Contract
            </button>
        }
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">@Contracts.Count Contract(s)</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="OnRefresh" title="Refresh">
                    <i class="bx bx-refresh"></i>
                </button>
            </div>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Contract No.</th>
                        <th>Vehicle</th>
                        <th>Department</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Monthly Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contract in Contracts)
                    {
                        <tr>
                            <td class="contract-number">@ValueOrDash(contract.contract_number)</td>
                            <td class="vehicle-info">
                                <div class="vehicle-reg">@ValueOrDash(contract.Vehicle?.registration_number ?? contract.vehicle_registration)</div>
                                <div class="vehicle-details">@ValueOrDash(contract.Vehicle?.model_name ?? contract.vehicle_model)</div>
                            </td>
                            <td class="department-name">@ValueOrDash(contract.Department?.department_description ?? contract.department_name)</td>
                            <td class="date-cell">@FormatDate(contract.start_date)</td>
                            <td class="date-cell">@FormatDate(contract.end_date)</td>
                            <td>
                                <span class="status-badge @(GetStatusClass(contract))">
                                    @GetStatusText(contract)
                                </span>
                            </td>
                            <td class="cost-cell">
                                @if (contract.monthly_cost.HasValue)
                                {
                                    <span class="cost-amount">R @contract.monthly_cost.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="cost-empty">-</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <div class="action-buttons">
                                    <button class="btn-icon btn-sm" @onclick="() => OnView.InvokeAsync(contract)" title="View Details">
                                        <i class="bx bx-show"></i>
                                    </button>
                                    <button class="btn-icon btn-sm" @onclick="() => OnEdit.InvokeAsync(contract)" title="Edit Contract">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(contract)" title="Delete Contract">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public List<ContractDto> Contracts { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool HasSearchTerm { get; set; }
    [Parameter] public EventCallback OnAddContract { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<ContractDto> OnView { get; set; }
    [Parameter] public EventCallback<ContractDto> OnEdit { get; set; }
    [Parameter] public EventCallback<ContractDto> OnDelete { get; set; }

    private string GetStatusClass(ContractDto contract)
    {
        if (!contract.end_date.HasValue && string.IsNullOrWhiteSpace(contract.status))
            return "status-unknown";

        var now = DateTime.Now.Date;
        var startDate = contract.start_date.Date;
        var endDate = contract.end_date?.Date;

        if (!string.IsNullOrWhiteSpace(contract.status))
        {
            var normalized = contract.status.ToLowerInvariant();
            if (normalized.Contains("active"))
                return "status-active";
            if (normalized.Contains("pending") || normalized.Contains("upcoming"))
                return "status-upcoming";
            if (normalized.Contains("expired") || normalized.Contains("cancel") || normalized.Contains("closed"))
                return "status-expired";
        }

        if (endDate.HasValue && now < startDate)
            return "status-upcoming";
        else if (endDate.HasValue && now >= startDate && now <= endDate.Value)
            return "status-active";
        else
            return "status-expired";
    }

    private string GetStatusText(ContractDto contract)
    {
        if (!string.IsNullOrWhiteSpace(contract.status))
            return contract.status;
        if (!contract.end_date.HasValue)
            return "Unknown";

        var now = DateTime.Now.Date;
        var startDate = contract.start_date.Date;
        var endDate = contract.end_date.Value.Date;

        if (now < startDate)
            return "Upcoming";
        else if (now >= startDate && now <= endDate)
            return "Active";
        else
            return "Expired";
    }

    private static string FormatDate(DateTime? date)
        => date.HasValue ? date.Value.ToString("dd/MM/yyyy") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
