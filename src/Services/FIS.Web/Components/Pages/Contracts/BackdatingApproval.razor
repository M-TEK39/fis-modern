@page "/contracts/backdating-approval"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject DriverApiService DriverService
@inject UserApiService UserService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Contract Back Date Requests - Approval</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-time-five"></i>
            Vehicle Backdating Contract Management
        </h1>
        <p class="page-description">Pending authorisation for backdated contract requests.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Contracts Menu</a>
        <button class="btn btn-secondary btn-sm" @onclick="GoTop">Top</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoBottom">Bottom</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="2">Vehicle Backdating Contract Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th>Select the vehicle to manage:</th>
                    <td>
                        <div class="contract-search-inputs">
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="searchType" value="GG" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                                    GG
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="searchType" value="GP" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                                    GP Number
                                </label>
                            </div>
                            <input type="text"
                                   class="form-input"
                                   placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")"
                                   @bind="_searchQuery"
                                   @bind:event="oninput" />
                            <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicle" disabled="@_searching">
                                @if (_searching)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <span>Search</span>
                                }
                            </button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearSearch" disabled="@_searching">Clear</button>
                        </div>
                        <div class="contract-search-inputs fis-mt-05">
                            <select class="form-select minw-select-lg" @bind="_selectedVehicleVmfCode" @bind:after="OnSelectedVehicleChanged" disabled="@(_vehicleSearchMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _vehicleSearchMatches)
                                {
                                    <option value="@vehicle.vmf_code">@GetVehicleContextLabel(vehicle)</option>
                                }
                            </select>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_searchError))
                        {
                            <div class="form-error contract-search-error">@_searchError</div>
                        }
                        @if (_selectedVehicle != null)
                        {
                            <div class="contract-search-result">
                                <div><strong>Selected Vehicle:</strong> @GetVehicleContextLabel(_selectedVehicle)</div>
                                <div>Make/Model: @_selectedVehicle.model_name | Status: @_selectedVehicle.status_description</div>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="OpenSelectedVehicle">Open Backdating Review</button>
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Pending Authorisation on Backdating Contracts</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="contract-legacy-content">
                        @if (_loadingContracts)
                        {
                            <div class="loading-state">
                                <div class="spinner"></div>
                                <p>Loading pending backdating requests...</p>
                            </div>
                        }
                        else if (_pendingContracts.Count == 0)
                        {
                            <div class="empty-state">
                                <i class="bx bx-file"></i>
                                <h3>No pending backdating requests</h3>
                                <p>No pending backdating requests match the current filters.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var contract in PagedPendingContracts)
                            {
                                <table class="contract-subtable">
                                    <tbody>
                                        <tr>
                                            <th>GG Number</th>
                                            <td>@GetFleetNumber(contract)</td>
                                            <th>Status</th>
                                            <td>@GetVehicleStatus(contract)</td>
                                            <th>Contract Type</th>
                                            <td>@GetContractType(contract)</td>
                                            <th>Contract Status</th>
                                            <td>@GetContractStatus(contract)</td>
                                        </tr>
                                        <tr>
                                            <th>Reg Number</th>
                                            <td>@GetRegNumber(contract)</td>
                                            <th>Hire Type</th>
                                            <td>@GetHireType(contract)</td>
                                            <th>Start Date</th>
                                            <td>@FormatDate(contract.start_date)</td>
                                            <th>Status Date</th>
                                            <td>@FormatDate(contract.end_date)</td>
                                        </tr>
                                        <tr>
                                            <th>Make</th>
                                            <td>@GetMake(contract)</td>
                                            <th>Location</th>
                                            <td>@GetLocation(contract)</td>
                                            <th>Modified</th>
                                            <td>@FormatDate(contract.end_date)</td>
                                            <th rowspan="2" class="contract-action-header">Action</th>
                                            <td rowspan="2" class="contract-actions">
                                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "view")'>View</button>
                                                @if (CanReviewContract(contract))
                                                {
                                                    <button class="btn btn-primary btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "review")'>Review</button>
                                                    <button class="btn btn-success btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "process")'>Process</button>
                                                }
                                                @if (CanEditContract(contract))
                                                {
                                                    <button class="btn btn-warning btn-sm" type="button" @onclick='() => OpenContractDetail(contract, "edit")'>Edit</button>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Model</th>
                                            <td colspan="3">@GetModel(contract)</td>
                                            <th>Username</th>
                                            <td>@GetUserName(contract)</td>
                                        </tr>
                                        <tr>
                                            <th>Department</th>
                                            <td colspan="3">@GetDepartment(contract)</td>
                                            <th>Site</th>
                                            <td colspan="3">@GetSite(contract)</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="contract-divider"></div>
                            }
                        }
                    </td>
                </tr>
            </tbody>
        </table>
        @if (_pendingContracts.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_pendingContracts.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

<a id="PageBottom"></a>

@code {

    private string _searchType = "GG";
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private List<VehicleDto> _vehicleSearchMatches = new();
    private int? _selectedVehicleVmfCode;
    private VehicleDto? _selectedVehicle;

    private bool _loadingContracts = true;
    private List<ContractDto> _pendingContracts = new();
    private Dictionary<int, int> _pendingSubmittedByUserCodes = new();
    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasContractApproverRole;
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<ContractDto> PagedPendingContracts
        => _pendingContracts.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private int TotalPages
        => Math.Max(1, (int)Math.Ceiling(_pendingContracts.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadPendingContracts();
    }

    private async Task LoadPendingContracts()
    {
        _loadingContracts = true;
        try
        {
            var contracts = await ContractService.GetContractsAsync();
            _pendingContracts = await FilterPendingContractsAsync(contracts);
            _page = 1;
            await HydratePendingContractsAsync();
        }
        finally
        {
            _loadingContracts = false;
        }
    }

    private async Task<List<ContractDto>> FilterPendingContractsAsync(List<ContractDto> contracts)
    {
        var pending = new List<ContractDto>();
        _pendingSubmittedByUserCodes.Clear();
        foreach (var contract in contracts)
        {
            var pendingResponse = await ContractService.GetActionAsync($"api/contracts/{contract.contract_id}/pending");
            if (!pendingResponse.Success || string.IsNullOrWhiteSpace(pendingResponse.ResponseBody))
            {
                continue;
            }

            try
            {
                using var doc = JsonDocument.Parse(pendingResponse.ResponseBody);
                if (doc.RootElement.TryGetProperty("isPending", out var isPending) && isPending.GetBoolean())
                {
                    if (doc.RootElement.TryGetProperty("submittedByUserCode", out var submittedBy))
                    {
                        if (submittedBy.ValueKind == JsonValueKind.Number && submittedBy.TryGetInt32(out var submittedByCode))
                        {
                            _pendingSubmittedByUserCodes[contract.contract_id] = submittedByCode;
                        }
                        else if (submittedBy.ValueKind == JsonValueKind.String && int.TryParse(submittedBy.GetString(), out submittedByCode))
                        {
                            _pendingSubmittedByUserCodes[contract.contract_id] = submittedByCode;
                        }
                    }

                    pending.Add(contract);
                }
            }
            catch
            {
                // Ignore malformed pending responses and continue.
            }
        }

        return pending;
    }

    private void GoTop() => Navigation.NavigateTo("/contracts/backdating-approval#PageTop");
    private void GoBottom() => Navigation.NavigateTo("/contracts/backdating-approval#PageBottom");

    private void SetSearchType(string type)
    {
        _searchType = type;
        _searchError = null;
    }

    private async Task SearchVehicle()
    {
        _searchError = null;
        _selectedVehicle = null;
        _selectedVehicleVmfCode = null;
        _vehicleSearchMatches = new();

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchError = _searchType == "GG" ? "Enter a GG number to search." : "Enter a GP number to search.";
            return;
        }

        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var results = await VehicleService.SearchVehiclesAsync(query);
            _vehicleSearchMatches = RankVehicleMatchesBySearchType(results, query, _searchType);
            if (_vehicleSearchMatches.Count == 0)
            {
                _searchError = "No vehicles matched the search criteria.";
                return;
            }

            _searchError = "Select a vehicle from the list to continue.";
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchError = null;
        _vehicleSearchMatches = new();
        _selectedVehicleVmfCode = null;
        _selectedVehicle = null;
    }

    private Task OnSelectedVehicleChanged()
    {
        _selectedVehicle = _selectedVehicleVmfCode.HasValue
            ? _vehicleSearchMatches.FirstOrDefault(v => v.vmf_code == _selectedVehicleVmfCode.Value)
            : null;
        return Task.CompletedTask;
    }

    private void OpenSelectedVehicle()
    {
        if (_selectedVehicle == null)
        {
            return;
        }

        var ggNumber = Uri.EscapeDataString(_selectedVehicle.fleet_number ?? "");
        var regNumber = Uri.EscapeDataString(_selectedVehicle.registration_number ?? "");
        Navigation.NavigateTo($"/contracts/backdating-approval/detail?ggnumber={ggNumber}&regnumber={regNumber}&action=review");
    }

    private void OpenContractDetail(ContractDto contract, string action)
    {
        var contractId = contract.contract_id;
        var regNumber = Uri.EscapeDataString(contract.vehicle_registration ?? "");
        var ggNumber = Uri.EscapeDataString(contract.Vehicle?.fleet_number ?? "");
        Navigation.NavigateTo($"/contracts/backdating-approval/detail?contractId={contractId}&action={action}&ggnumber={ggNumber}&regnumber={regNumber}");
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    }

    private static string FormatDate(DateTime date)
    {
        return date.ToString("yyyy/MM/dd");
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetFleetNumber(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.fleet_number ?? contract.fleet_number);

    private static string GetRegNumber(ContractDto contract)
        => ValueOrDash(contract.vehicle_registration);

    private static string GetVehicleStatus(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.status_description ?? contract.status);

    private static string GetContractType(ContractDto contract)
        => GetContractTypeLabel(contract.contract_type_code ?? contract.contractor_name);

    private static string GetContractStatus(ContractDto contract)
        => ValueOrDash(contract.status);

    private static string GetHireType(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.type_name ?? GetContractTypeLabel(contract.contract_type_code ?? contract.contractor_name));

    private static string GetMake(ContractDto contract)
        => ValueOrDash(contract.vehicle_make);

    private static string GetLocation(ContractDto contract)
        => ValueOrDash(contract.Vehicle?.location_description);

    private static string GetModel(ContractDto contract)
        => ValueOrDash(contract.vehicle_model ?? contract.Vehicle?.model_name);

    private string GetUserName(ContractDto contract)
        => ResolveUserDisplay(GetCapturerUserCode(contract) ?? contract.user_code);

    private static string GetDepartment(ContractDto contract)
        => ValueOrDash(contract.department_name ?? contract.Department?.department_description);

    private string GetSite(ContractDto contract)
        => ValueOrDash(_siteNames.TryGetValue(contract.site_code ?? 0, out var name) ? name : contract.site_code?.ToString());

    private async Task HydratePendingContractsAsync()
    {
        if (_pendingContracts.Count == 0)
        {
            return;
        }

        if (_siteNames.Count == 0)
        {
            var sites = await SiteService.GetAllAsync();
            _siteNames = sites.ToDictionary(s => s.SiteCode, s => s.Description ?? s.SiteCode.ToString());
        }

        if (_drivers.Count == 0)
        {
            _drivers = await DriverService.GetDriversAsync();
        }

        if (_userProfilesByCode.Count == 0)
        {
            var profiles = await UserService.GetAllProfilesAsync();
            _userProfilesByCode = profiles
                .Where(profile => profile.UserAccessCode > 0)
                .GroupBy(profile => (int)profile.UserAccessCode)
                .ToDictionary(group => group.Key, group => group.First());
        }

        foreach (var contract in _pendingContracts)
        {
            if (contract.vmf_code.HasValue && contract.Vehicle == null)
            {
                contract.Vehicle = await VehicleService.GetVehicleAsync(contract.vmf_code.Value);
            }

            if (contract.site_code.HasValue && contract.Department == null)
            {
                var site = await SiteService.GetByIdAsync(contract.site_code.Value);
                if (site?.DepartmentCode != null)
                {
                    contract.Department = await DepartmentService.GetDepartmentAsync(site.DepartmentCode.Value);
                }
            }
        }
    }

    private Dictionary<short, string> _siteNames = new();
    private List<DriverDto> _drivers = new();
    private Dictionary<int, UserProfileDto> _userProfilesByCode = new();

    private string GetDriverName(ContractDto contract)
    {
        if (!string.IsNullOrWhiteSpace(contract.driver_name))
        {
            return contract.driver_name.Trim();
        }

        if (_drivers.Count == 0)
        {
            return "-";
        }

        if (contract.site_driver_code is > 0)
        {
            var matchedDriver = _drivers.FirstOrDefault(d => d.site_driver_code == contract.site_driver_code.Value);
            if (matchedDriver != null)
            {
                return $"{matchedDriver.driver_firstname} {matchedDriver.driver_surname}".Trim();
            }
        }

        var driverId = contract.driver_id;
        if (string.IsNullOrWhiteSpace(driverId))
        {
            return "-";
        }

        var normalizedDriverId = driverId.Trim();
        var driver = _drivers.FirstOrDefault(d =>
            string.Equals(d.driver_SA_id, normalizedDriverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(d.driver_passportnumber, normalizedDriverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(d.driver_persalnumber, normalizedDriverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(d.driver_contractnumber, normalizedDriverId, StringComparison.OrdinalIgnoreCase));
        if (driver == null)
        {
            return normalizedDriverId;
        }

        return $"{driver.driver_firstname} {driver.driver_surname}".Trim();
    }

    private string ResolveUserDisplay(int? userAccessCode)
    {
        if (userAccessCode is > 0 && _userProfilesByCode.TryGetValue(userAccessCode.Value, out var profile))
        {
            return ValueOrDash($"{profile.FirstName} {profile.LastName}".Trim());
        }

        return "-";
    }

    private static string GetContractTypeLabel(string? contractTypeCode)
    {
        var code = (contractTypeCode ?? string.Empty).Trim().ToUpperInvariant();
        return code switch
        {
            "A" => "Daily",
            "B" => "Hourly",
            "C" => "Permanent",
            "D" => "Relieve",
            "E" => "Lease",
            _ => string.IsNullOrWhiteSpace(code) ? "-" : code
        };
    }

    private bool CanReviewContract(ContractDto contract)
        => _hasContractApproverRole && !IsCurrentUserContractCapturer(contract);

    private bool CanEditContract(ContractDto contract)
        => IsCurrentUserContractCapturer(contract) || !_hasContractApproverRole;

    private bool IsCurrentUserContractCapturer(ContractDto contract)
    {
        if (_currentUserAccessCode is not > 0)
        {
            return false;
        }

        if (contract.user_code is > 0 && contract.user_code.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        var createdByUserCode = GetCapturerUserCode(contract);
        return createdByUserCode is > 0 && createdByUserCode.Value == _currentUserAccessCode.Value;
    }

    private int? GetCapturerUserCode(ContractDto contract)
    {
        if (contract.created_by_user_code is > 0)
        {
            return contract.created_by_user_code;
        }

        return contract.contract_id > 0 && _pendingSubmittedByUserCodes.TryGetValue(contract.contract_id, out var submittedByUserCode)
            ? submittedByUserCode
            : null;
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _hasContractApproverRole = HasAnyRole(user, "contracts approver", "contracts_approver", "back dating contract (approver)");

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        if (!_hasContractApproverRole && (_currentAccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
        {
            _hasContractApproverRole = true;
        }
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool HasAnyRole(ClaimsPrincipal user, params string[] roles)
    {
        foreach (var role in roles)
        {
            if (user.IsInRole(role))
            {
                return true;
            }
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => roles.Any(role => string.Equals(item, role, StringComparison.OrdinalIgnoreCase))));
    }

    private static string GetVehicleContextLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> RankVehicleMatchesBySearchType(List<VehicleDto> matches, string query, string searchType)
    {
        return (searchType == "GG"
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                searchType == "GG"
                    ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(v =>
                searchType == "GG"
                    ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }
}
