@code {
    [SupplyParameterFromQuery(Name = "ggnumber")] public string? GgNumber { get; set; }
    [SupplyParameterFromQuery(Name = "regnumber")] public string? RegNumber { get; set; }
    [SupplyParameterFromQuery(Name = "contractId")] public string? ContractId { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? Action { get; set; }

    private ContractDto? _contract;
    private VehicleDto? _vehicle;
    private SiteResponseDto? _site;
    private DepartmentDto? _department;
    private List<DepartmentDto> _departments = new();
    private List<SiteResponseDto> _sites = new();
    private List<ProvinceDto> _provinces = new();
    private int _selectedDepartmentCode;
    private short _selectedSiteCode;
    private bool _actionRunning;
    private bool _actionStatusError;
    private string _actionStatusMessage = string.Empty;
    private string _approvalNotes = string.Empty;
    private string _declineReason = string.Empty;
    private bool _isContractActive;
    private bool _hasPendingContract;
    private bool _openContractMode;
    private bool _reviewPendingMode;
    private bool _reassignMode;
    private bool _extendMode;
    private bool _closeMode;
    private bool _siteUpdateMode;
    private short? _reassignOriginalSiteCode;
    private DateTime? _extendOriginalTargetReturnDate;
    private DateTime? _extendTargetReturnDate;
    private short? _closeHomeDepartmentCode;
    private short? _closeHomeSiteCode;
    private int? _closeHomeDriverCode;
    private DateTime _closeEndDate = DateTime.Today;
    private int _closeEndOdometer;
    private string _closeNotes = string.Empty;
    private bool _createHomeCustodyContract = true;
    private short? _siteUpdateDepartmentCode;
    private short? _siteUpdateSiteCode;
    private int? _siteUpdateDriverCode;
    private string _siteUpdateNotes = string.Empty;
    private bool _siteUpdateCreateHomeContract = true;
    private bool _scrollToTopPending = true;
    private bool _submittedByCurrentUserInSession;
    private int? _pendingSubmittedByUserCode;
    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasContractApproverRole;
    private bool _isAdminUser;
    private short? _currentUserSiteCode;
    private HashSet<string> _currentUserRoleTokens = new(StringComparer.OrdinalIgnoreCase);
    private VehicleTariffPreviewResponseDto? _tariffPreview;
    private bool _showTariffWarning;
    private Dictionary<int, UserProfileDto> _userProfilesByCode = new();
    private List<DriverDto> _drivers = new();
    private short? _selectedAuthoriserCode;
    private int? _selectedSiteDriverCode;
    private static readonly (string Code, string Label)[] ContractTypeOptions =
    {
        ("A", "Daily"),
        ("B", "Hourly"),
        ("C", "Permanent"),
        ("D", "Relieve"),
        ("E", "Lease")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ResolveCurrentUserContextAsync();
            await LoadLookupDataAsync();
            await LoadUserProfilesAsync();
            await LoadDriverDataAsync();

            if (int.TryParse(ContractId, out var contractId))
            {
                _contract = await ContractService.GetContractAsync(contractId);
            }

            if (_contract?.vmf_code != null)
            {
                _vehicle = await VehicleService.GetVehicleAsync(_contract.vmf_code.Value);
            }

            if (_vehicle == null)
            {
                _vehicle = await FindVehicleFromQuery();
            }

            if (_contract == null && _vehicle != null)
            {
                _contract = await ContractService.GetLatestContractForVehicleAsync(_vehicle.vmf_code);
            }

            if (_contract?.site_code != null)
            {
                _site = await SiteService.GetByIdAsync(_contract.site_code.Value);
                if (_site?.DepartmentCode != null)
                {
                    _department = await DepartmentService.GetDepartmentAsync(_site.DepartmentCode.Value);
                }
            }

            SyncContractSelection();

        _approvalNotes = string.Empty;
            await EvaluateContractStateAsync();
            await LoadTariffPreviewAsync();
        }
        catch
        {
        }
    }

    protected override Task OnParametersSetAsync()
    {
        _scrollToTopPending = true;
        return base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToTopPending)
        {
            _scrollToTopPending = false;
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private async Task<VehicleDto?> FindVehicleFromQuery()
    {
        var preferFleet = !string.IsNullOrWhiteSpace(GgNumber);
        var query = preferFleet
            ? GgNumber?.Trim() ?? string.Empty
            : !string.IsNullOrWhiteSpace(RegNumber)
                ? RegNumber?.Trim() ?? string.Empty
                : string.Empty;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var results = await VehicleService.SearchVehiclesAsync(query);
        var ranked = RankVehicleMatches(results, query, preferFleet);
        if (ranked.Count == 0)
        {
            return null;
        }

        var exactMatches = ranked.Where(v => preferFleet
            ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
            : string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (exactMatches.Count != 1)
        {
            return null;
        }

        return exactMatches.SingleOrDefault();
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, bool preferFleet)
    {
        return (preferFleet
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                preferFleet
                    ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(v =>
                preferFleet
                    ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private string GetQuery(string key)
    {
        return key switch
        {
            "ggnumber" => GgNumber ?? "-",
            "regnumber" => RegNumber ?? "-",
            "contractId" => ContractId ?? "-",
            "action" => Action ?? "-",
            _ => "-"
        };
    }

    private string GetVehicleContextLabel()
    {
        var gg = PreferVehicleValue(_vehicle?.fleet_number, "ggnumber");
        var gp = PreferVehicleValue(_vehicle?.registration_number, "regnumber");
        var vmf = _vehicle?.vmf_code.ToString() ?? "-";
        return $"{gg} / {gp} ({vmf})";
    }

    private string PreferVehicleValue(string? value, string queryKey)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        var queryValue = GetQuery(queryKey);
        return ValueOrDash(queryValue);
    }

    private string GetPrintoutUrl()
    {
        var id = ResolveContractId();
        return id > 0 ? $"/contracts/printout?contractId={id}" : "/contracts";
    }

    private async Task RunContractActionAsync(string action)
    {
        var vmfCode = _vehicle?.vmf_code ?? _contract?.vmf_code ?? 0;

        if (RequiresJurisdictionControl(action) && !ValidateJurisdictionAccess(action, out var jurisdictionMessage))
        {
            _actionStatusError = true;
            _actionStatusMessage = jurisdictionMessage;
            return;
        }

        if (action == "open")
        {
            _reassignMode = false;
            _extendMode = false;
            _closeMode = false;
            _siteUpdateMode = false;
            if (vmfCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a valid vehicle before opening a contract.";
                return;
            }

            if (IsContractOpenBlockedByTariff())
            {
                _actionStatusError = true;
                _actionStatusMessage = BuildMissingTariffOpenMessage();
                return;
            }

            _openContractMode = true;
            _reviewPendingMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Complete contract details, then submit for approval.";
            return;
        }

        if (action == "review-pending")
        {
            _reassignMode = false;
            _extendMode = false;
            _closeMode = false;
            _siteUpdateMode = false;
            if (!CanCurrentUserReviewPendingContract())
            {
                _actionStatusError = true;
                _actionStatusMessage = "You cannot review or approve your own pending contract.";
                return;
            }

            _reviewPendingMode = true;
            _openContractMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Pending contract loaded for review.";
            return;
        }

        if (action == "review-correction")
        {
            _reassignMode = false;
            _extendMode = false;
            _closeMode = false;
            _siteUpdateMode = false;
            _openContractMode = true;
            _reviewPendingMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Correction contract loaded. Update details and submit for approval.";
            return;
        }

        if (action == "site-update")
        {
            if (!_siteUpdateMode)
            {
                EnterSiteUpdateMode();
                return;
            }

            if (_siteUpdateDepartmentCode is not > 0 || _siteUpdateSiteCode is not > 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select the GFleet department and site before saving the vehicle home assignment.";
                return;
            }

            if (_siteUpdateCreateHomeContract && _siteUpdateDriverCode is not > 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a custodian driver before creating a home custody contract.";
                return;
            }
        }

        if (action == "reassign")
        {
            if (!_reassignMode)
            {
                EnterReassignMode();
                return;
            }

            if (_selectedSiteCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a valid site before saving reassignment.";
                return;
            }

            if (_reassignOriginalSiteCode.HasValue && _reassignOriginalSiteCode.Value == _selectedSiteCode)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a different site to reassign this contract.";
                return;
            }

            if (!ValidateReassignEmailControls(out var emailControlMessage))
            {
                _actionStatusError = true;
                _actionStatusMessage = emailControlMessage;
                return;
            }
        }

        if (action == "extend")
        {
            if (!_extendMode)
            {
                EnterExtendMode();
                return;
            }

            if (!_extendTargetReturnDate.HasValue)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a new return date before saving extension.";
                return;
            }

            if (_extendOriginalTargetReturnDate.HasValue
                && _extendTargetReturnDate.Value.Date <= _extendOriginalTargetReturnDate.Value.Date)
            {
                _actionStatusError = true;
                _actionStatusMessage = "New return date must be later than the current return date.";
                return;
            }
        }

        if (action == "close")
        {
            if (!_closeMode)
            {
                EnterCloseMode();
                return;
            }

            if (_closeHomeDepartmentCode is not > 0 || _closeHomeSiteCode is not > 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select the GFleet department and site before closing the contract.";
                return;
            }

            if (_closeEndOdometer < 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Close odometer cannot be negative.";
                return;
            }

            if (_createHomeCustodyContract && _closeHomeDriverCode is not > 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a GFleet custodian driver before closing the contract.";
                return;
            }
        }

        _actionRunning = true;
        _actionStatusMessage = string.Empty;

        var contractId = ResolveContractId();
        var actionContractId = await ResolveActionContractIdAsync(action, contractId);
        if (actionContractId <= 0 && action is not "submit" and not "cancel" and not "site-update")
        {
            _actionStatusError = true;
            _actionStatusMessage = "Contract ID is required for this action.";
            _actionRunning = false;
            return;
        }

        if ((action == "decline" || action == "decline-correction") && string.IsNullOrWhiteSpace(_declineReason))
        {
            _actionStatusError = true;
            _actionStatusMessage = "Decline reason is required.";
            _actionRunning = false;
            return;
        }

        if (action is "approve" or "approve-activate" or "decline" or "decline-correction")
        {
            if (!CanCurrentUserReviewPendingContract())
            {
                _actionStatusError = true;
                _actionStatusMessage = "You cannot review or approve your own pending contract.";
                _actionRunning = false;
                return;
            }
        }

        var endpoint = action switch
        {
            "extend" => $"api/contracts/{actionContractId}/extend",
            "reassign" => $"api/contracts/{actionContractId}/reassign",
            "close" => $"api/contracts/{actionContractId}/close",
            "site-update" => $"api/contracts/vehicle/{vmfCode}/site-assignment",
            "relief" => $"api/contracts/{actionContractId}/relief",
            "recall" => $"api/contracts/{actionContractId}/recall",
            "submit" => $"api/contracts/{actionContractId}/submit",
            "cancel" => $"api/contracts/{actionContractId}/cancel",
            "approve" => $"api/contracts/{actionContractId}/approve",
            "approve-activate" => $"api/contracts/{actionContractId}/approve-activate",
            "decline-correction" => $"api/contracts/{actionContractId}/decline-correction",
            "decline" => $"api/contracts/{actionContractId}/decline",
            _ => $"api/contracts/{actionContractId}/pending"
        };

        FinanceApiResult result;
        if (action == "extend")
        {
            result = await ContractService.PutActionAsync(endpoint, new
            {
                NewTargetReturnDate = _extendTargetReturnDate?.Date
            });
        }
        else if (action == "close")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                EndDate = _closeEndDate.Date,
                EndOdometer = _closeEndOdometer,
                Notes = string.IsNullOrWhiteSpace(_closeNotes) ? _approvalNotes : _closeNotes,
                HomeDepartmentCode = _closeHomeDepartmentCode,
                HomeSiteCode = _closeHomeSiteCode,
                HomeSiteDriverCode = _closeHomeDriverCode,
                CreateHomeCustodyContract = _createHomeCustodyContract
            });
        }
        else if (action == "site-update")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                DepartmentCode = _siteUpdateDepartmentCode,
                SiteCode = _siteUpdateSiteCode,
                SiteDriverCode = _siteUpdateDriverCode,
                CreateHomeCustodyContract = _siteUpdateCreateHomeContract,
                Notes = string.IsNullOrWhiteSpace(_siteUpdateNotes) ? _approvalNotes : _siteUpdateNotes
            });
        }
        else if (action == "reassign")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                NewVmfCode = (int?)null,
                NewSiteCode = _selectedSiteCode > 0 ? (short?)_selectedSiteCode : null,
                Reason = string.IsNullOrWhiteSpace(_approvalNotes) ? "Reassignment requested from contract detail." : _approvalNotes
            });
        }
        else if (action == "relief")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                ReliefVmfCode = vmfCode,
                StartOdometer = _vehicle?.current_odo,
                TargetReturnDate = DateTime.UtcNow.Date.AddDays(7),
                Reason = string.IsNullOrWhiteSpace(_approvalNotes) ? "Relief contract requested from contract detail." : _approvalNotes
            });
        }
        else if (action == "submit")
        {
            if (vmfCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a valid vehicle before submitting a contract.";
                _actionRunning = false;
                return;
            }

            if (_selectedSiteCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select the client site before submitting a contract.";
                _actionRunning = false;
                return;
            }

            if (!HasValidTariffForSubmission())
            {
                _actionStatusError = true;
                _actionStatusMessage = BuildMissingTariffMessage();
                _actionRunning = false;
                return;
            }

            ApplySelectionToContract();
            ApplyClientSelectionToContract();

            if (contractId <= 0)
            {
                var createResult = await ContractService.PostActionAsync("api/contracts/hire", new
                {
                    VmfCode = vmfCode,
                    SiteCode = _selectedSiteCode,
                    StartOdometer = _contract?.start_odometer ?? _vehicle?.current_odo,
                    DriverId = _contract?.driver_id,
                    SiteDriverCode = _selectedSiteDriverCode ?? 0,
                    UserCode = _selectedAuthoriserCode ?? 0,
                    Authorisation = _contract?.authorisation,
                    TargetReturnDate = _extendTargetReturnDate?.Date ?? _contract?.target_return_date?.Date,
                    Notes = _approvalNotes
                });

                if (!createResult.Success)
                {
                    _actionStatusError = true;
                    _actionStatusMessage = createResult.Message;
                    _actionRunning = false;
                    return;
                }

                var createdContractId = TryExtractContractId(createResult.ResponseBody);
                if (createdContractId > 0)
                {
                    _contract = await ContractService.GetContractAsync(createdContractId);
                    contractId = createdContractId;
                    actionContractId = createdContractId;
                }
            }

            if (actionContractId > 0 && ((_contract?.contract_status_code ?? 0) is 0 or 4 || _openContractMode))
            {
                var editResult = await SaveEditableContractAsync(actionContractId);
                if (!editResult.Success)
                {
                    _actionStatusError = true;
                    _actionStatusMessage = editResult.Message;
                    _actionRunning = false;
                    return;
                }
            }

            if (actionContractId <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Contract could not be created for submission.";
                _actionRunning = false;
                return;
            }

            result = await ContractService.PostActionAsync($"api/contracts/{actionContractId}/submit", new
            {
                ApprovalNotes = _approvalNotes
            });
        }
        else if (action == "cancel")
        {
            if (_openContractMode && contractId <= 0)
            {
                _openContractMode = false;
                _actionStatusError = false;
                _actionStatusMessage = "Open contract draft cancelled.";
                _actionRunning = false;
                return;
            }

            result = await ContractService.PostActionAsync(endpoint, new
            {
                CancellationReason = _declineReason
            });
        }
        else if (action == "recall")
        {
            if (!IsCurrentUserContractCapturer())
            {
                _actionStatusError = true;
                _actionStatusMessage = "Only the original capturer can recall this contract.";
                _actionRunning = false;
                return;
            }

            result = await ContractService.PostActionAsync(endpoint, new { });
        }
        else if (action == "approve" || action == "approve-activate")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                ApprovalNotes = _approvalNotes
            });
        }
        else if (action == "decline" || action == "decline-correction")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                DeclineReason = _declineReason
            });
        }
        else
        {
            result = await ContractService.PostActionAsync(endpoint, new { });
        }

        _actionStatusError = !result.Success;
        _actionStatusMessage = result.Message;
        _actionRunning = false;

        if (result.Success)
        {
            if (action is "reassign" or "extend" or "close" or "site-update")
            {
                _reassignMode = false;
                _extendMode = false;
                _closeMode = false;
                _siteUpdateMode = false;
                _reassignOriginalSiteCode = null;
                _extendOriginalTargetReturnDate = null;
            }

            if (action == "recall")
            {
                _openContractMode = true;
                _reviewPendingMode = false;
            }

            if (action == "submit")
            {
                _submittedByCurrentUserInSession = true;
            }

            if (action == "site-update")
            {
                _contract = null;
            }

            await RefreshContractContextAsync(action == "site-update" ? 0 : actionContractId);
            await EvaluateContractStateAsync();
            _approvalNotes = string.Empty;
            _declineReason = string.Empty;
        }
    }

