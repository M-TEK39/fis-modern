    private bool ValidateReassignEmailControls(out string message)
    {
        message = string.Empty;

        if (!_currentUserAccessCode.HasValue || _currentUserAccessCode.Value <= 0)
        {
            message = "Cannot proceed with reassignment: current user profile is not resolved.";
            return false;
        }

        if (!TryGetValidEmail(_currentUserAccessCode.Value, out _))
        {
            message = "Cannot proceed with reassignment: requester email is missing or invalid.";
            return false;
        }

        if (_contract?.approver_code is > 0)
        {
            if (_contract.approver_code.Value == _currentUserAccessCode.Value)
            {
                message = "Cannot proceed with reassignment: requester cannot approve own move.";
                return false;
            }

            if (!TryGetValidEmail(_contract.approver_code.Value, out _))
            {
                message = "Cannot proceed with reassignment: approver email is missing or invalid.";
                return false;
            }
        }

        return true;
    }

    private bool TryGetValidEmail(int userCode, out string? email)
    {
        email = null;
        if (!_userProfilesByCode.TryGetValue(userCode, out var profile))
        {
            return false;
        }

        var candidate = profile.Email?.Trim();
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return false;
        }

        var at = candidate.IndexOf('@');
        var dot = candidate.LastIndexOf('.');
        var valid = at > 0 && dot > at + 1 && dot < candidate.Length - 1;
        if (!valid)
        {
            return false;
        }

        email = candidate;
        return true;
    }

    private bool RequiresJurisdictionControl(string action)
    {
        return action is "open" or "submit" or "cancel" or "extend" or "reassign" or "close" or "site-update" or "review-pending" or "review-correction" or "recall" or "approve" or "approve-activate" or "decline" or "decline-correction";
    }

    private bool ValidateJurisdictionAccess(string action, out string message)
    {
        message = string.Empty;

        if (_isAdminUser)
        {
            return true;
        }

        if (_currentUserSiteCode is not > 0)
        {
            message = "Access denied: your site jurisdiction is not configured. Contact administrator.";
            return false;
        }

        var actionSiteCode = ResolveActionSiteCode(action);
        if (actionSiteCode is > 0 && actionSiteCode.Value != _currentUserSiteCode.Value)
        {
            message = $"Access denied: this contract/site is outside your jurisdiction (your site: {_currentUserSiteCode}).";
            return false;
        }

        var category = ResolveContractJurisdictionCategory();
        if (!HasJurisdictionRoleForCategory(category))
        {
            message = $"Access denied: you do not have {category.ToUpperInvariant()} jurisdiction rights.";
            return false;
        }

        return true;
    }

    private short? ResolveActionSiteCode(string action)
    {
        if (action == "reassign" && _reassignMode && _selectedSiteCode > 0)
        {
            return _selectedSiteCode;
        }

        if (_contract?.site_code is > 0)
        {
            return _contract.site_code;
        }

        if (_vehicle?.site_code is > 0)
        {
            return _vehicle.site_code;
        }

        return null;
    }

    private string ResolveContractJurisdictionCategory()
    {
        var typeText = (_vehicle?.type_name ?? string.Empty).Trim();
        var contractTypeCode = (GetResolvedContractTypeCode() ?? string.Empty).Trim().ToUpperInvariant();
        var combined = $"{typeText} {contractTypeCode}".Trim().ToLowerInvariant();

        if (combined.Contains("lease", StringComparison.OrdinalIgnoreCase) || contractTypeCode == "E")
        {
            return "lease";
        }

        if (combined.Contains("tss", StringComparison.OrdinalIgnoreCase))
        {
            return "tss";
        }

        if (combined.Contains("pool", StringComparison.OrdinalIgnoreCase) || combined.Contains("vip", StringComparison.OrdinalIgnoreCase))
        {
            return "pool";
        }

        return "general";
    }

    private bool HasJurisdictionRoleForCategory(string category)
    {
        if (_isAdminUser || _currentUserRoleTokens.Count == 0)
        {
            return true;
        }

        return category switch
        {
            "lease" => HasRoleKeyword("lease"),
            "pool" => HasRoleKeyword("pool", "vip"),
            "tss" => HasRoleKeyword("tss"),
            _ => true
        };
    }

    private bool HasRoleKeyword(params string[] keywords)
    {
        foreach (var role in _currentUserRoleTokens)
        {
            foreach (var keyword in keywords)
            {
                if (role.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private static string GetContractTypeLabel(string? contractTypeCode)
    {
        var code = (contractTypeCode ?? string.Empty).Trim().ToUpperInvariant();
        return code switch
        {
            "A" => "Daily",
            "B" => "Hourly",
            "C" => "Permanent",
            "D" => "Relieve",
            "E" => "Lease",
            _ => string.IsNullOrWhiteSpace(code) ? "-" : code
        };
    }

    private string BuildApprovalSummary()
    {
        var openedBy = ResolveUserDisplay(GetCapturerUserCode());
        var openedOn = _contract?.start_date.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy");
        var status = ValueOrDash(_contract?.status);

        return $"CONTRACT OPENED BY {openedBy.ToUpperInvariant()} ON THE {openedOn} AND CURRENTLY IN STATUS: {status.ToUpperInvariant()}.";
    }

    private async Task EvaluateContractStateAsync()
    {
        var statusCode = _contract?.contract_status_code;
        var stillCurrent = (_contract?.still_current ?? string.Empty).Trim().ToUpperInvariant();
        var status = (_contract?.status ?? string.Empty).Trim().ToLowerInvariant();

        if (stillCurrent is "Y" or "N")
        {
            _isContractActive = stillCurrent == "Y";
        }
        else
        {
            _isContractActive =
                statusCode == 3
                || (!string.IsNullOrWhiteSpace(status) && (status.Contains("active") || status.Contains("in service")));
        }

        _hasPendingContract = statusCode == 1;
        var contractId = ResolveContractId();
        if (!_hasPendingContract && contractId > 0)
        {
            var pendingResponse = await ContractService.GetActionAsync($"api/contracts/{contractId}/pending");
            if (pendingResponse.Success && !string.IsNullOrWhiteSpace(pendingResponse.ResponseBody))
            {
                var pendingDetails = ExtractPendingDetails(pendingResponse.ResponseBody);
                _hasPendingContract = pendingDetails.IsPending;
                _pendingSubmittedByUserCode = pendingDetails.SubmittedByUserCode;
            }
        }

        var action = (Action ?? string.Empty).Trim().ToLowerInvariant();
        if (_hasPendingContract)
        {
            _reviewPendingMode = CanCurrentUserReviewPendingContract() && (action is "review" or "process");
            _openContractMode = false;
        }
        else if (IsCorrectionState())
        {
            _openContractMode = action is "review-correction" or "edit";
            _reviewPendingMode = false;
        }
        else if (!_isContractActive)
        {
            var isDraft = (_contract?.contract_status_code ?? -1) == 0;
            _openContractMode = action is "open" || (isDraft && ResolveContractId() > 0 && IsCurrentUserContractCapturer());
            _reviewPendingMode = false;
        }
        else
        {
            _openContractMode = false;
            _reviewPendingMode = false;
        }
    }

    private bool IsPendingAwaitingReview() => _hasPendingContract && !_reviewPendingMode;
    private bool IsPendingInReview() => _hasPendingContract && _reviewPendingMode;
    private bool IsActiveContractState() => _isContractActive && !_hasPendingContract;
    private bool IsApprovedAwaitingActivationState() => _contract?.contract_status_code == 2 && !IsActiveContractState();
    private bool IsCorrectionState() => _contract?.contract_status_code == 4;
    private bool IsNewContractState() => !_isContractActive && !_hasPendingContract && !IsApprovedAwaitingActivationState() && !IsCorrectionState();
    private bool IsReviewerMode() => IsPendingInReview();
    private bool CanCurrentUserReviewPendingContract() => _hasContractApproverRole && !IsCurrentUserContractCapturer();
    private bool HasReviewerNotes() => !string.IsNullOrWhiteSpace(_contract?.contract_notes);
    private bool ShowContractForm() => _reviewPendingMode || _openContractMode || _siteUpdateMode || IsActiveContractState() || IsApprovedAwaitingActivationState();

    private bool IsCurrentUserContractCapturer()
    {
        if (_currentUserAccessCode is not > 0)
        {
            return false;
        }

        var contractUserCode = _contract?.user_code;
        if (contractUserCode is > 0 && contractUserCode.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        var createdByUserCode = GetCapturerUserCode();
        if (createdByUserCode is > 0 && createdByUserCode.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        return _submittedByCurrentUserInSession;
    }

    private int? GetCapturerUserCode()
        => _contract?.created_by_user_code ?? _pendingSubmittedByUserCode;

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _hasContractApproverRole = HasAnyRole(user, "contracts approver", "contracts_approver", "back dating contract (approver)");

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        if (!_hasContractApproverRole && (_currentAccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
        {
            _hasContractApproverRole = true;
        }

        _isAdminUser = HasAnyRole(user, "admin", "administrator")
            || (_currentAccessLevel & LegacyPermissionBits.UserAdministration) == LegacyPermissionBits.UserAdministration;

        _currentUserRoleTokens = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .SelectMany(c => c.Value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
            .Where(static x => !string.IsNullOrWhiteSpace(x))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private string? GetResolvedContractTypeCode()
        => !string.IsNullOrWhiteSpace(_contract?.contract_type_code)
            ? _contract?.contract_type_code
            : _contract?.contractor_name;

    private void ResetInvalidClientSelections()
    {
        if (_selectedSiteCode <= 0)
        {
            _selectedAuthoriserCode = null;
            _selectedSiteDriverCode = null;
            return;
        }

        if (_selectedAuthoriserCode is > 0
            && !AvailableAuthorisers.Any(profile => profile.UserAccessCode == _selectedAuthoriserCode.Value))
        {
            _selectedAuthoriserCode = null;
        }

        if (_selectedSiteDriverCode is > 0
            && !AvailableSiteDrivers.Any(driver => driver.site_driver_code == _selectedSiteDriverCode.Value))
        {
            _selectedSiteDriverCode = null;
        }
    }

    private int? ResolveSelectedSiteDriverCode()
    {
        if (_contract?.site_driver_code is > 0)
        {
            return _contract.site_driver_code;
        }

        if (string.IsNullOrWhiteSpace(_contract?.driver_id))
        {
            return null;
        }

        var driverId = _contract.driver_id.Trim();
        var matchedDriver = _drivers.FirstOrDefault(driver =>
            string.Equals(driver.driver_SA_id, driverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(driver.driver_passportnumber, driverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(driver.driver_persalnumber, driverId, StringComparison.OrdinalIgnoreCase)
            || string.Equals(driver.driver_contractnumber, driverId, StringComparison.OrdinalIgnoreCase));

        return matchedDriver?.site_driver_code;
    }

    private void ApplyClientSelectionToContract()
    {
        _contract ??= new ContractDto();
        _contract.user_code = _selectedAuthoriserCode;

        if (_selectedSiteDriverCode is > 0)
        {
            var selectedDriver = AvailableSiteDrivers.FirstOrDefault(driver => driver.site_driver_code == _selectedSiteDriverCode.Value)
                ?? _drivers.FirstOrDefault(driver => driver.site_driver_code == _selectedSiteDriverCode.Value);

            if (selectedDriver != null)
            {
                _contract.site_driver_code = selectedDriver.site_driver_code;
                _contract.driver_id = FirstNonEmpty(
                    selectedDriver.driver_SA_id,
                    selectedDriver.driver_passportnumber,
                    selectedDriver.driver_persalnumber,
                    selectedDriver.driver_contractnumber);
                _contract.driver_name = DriverDisplay(selectedDriver);
                return;
            }
        }

        _contract.site_driver_code = null;
        _contract.driver_id = null;
        _contract.driver_name = null;
    }

    private static string? FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private bool SelectedDriverHasValidLicence()
        => GetSelectedDriver()?.driver_licence_ExpiryDate is DateTime expiry && expiry.Date >= DateTime.Today;

    private string SelectedDriverLicenceHint()
        => GetSelectedDriver()?.driver_licence_ExpiryDate?.ToString("yyyy/MM/dd") ?? "no expiry";

    private DriverDto? GetSelectedDriver()
        => _selectedSiteDriverCode is > 0
            ? _drivers.FirstOrDefault(driver => driver.site_driver_code == _selectedSiteDriverCode.Value)
            : null;

    private string ResolveUserDisplay(int? userAccessCode)
    {
        if (userAccessCode is > 0 && _userProfilesByCode.TryGetValue(userAccessCode.Value, out var profile))
        {
            return AuthoriserDisplay(profile);
        }

        return "-";
    }

    private static bool HasAnyRole(ClaimsPrincipal user, params string[] roles)
    {
        foreach (var role in roles)
        {
            if (user.IsInRole(role))
            {
                return true;
            }
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => roles.Any(role => string.Equals(item, role, StringComparison.OrdinalIgnoreCase))));
    }

    private async Task RefreshContractContextAsync(int contractIdHint)
    {
        var contractId = contractIdHint > 0 ? contractIdHint : ResolveContractId();
        if (contractId > 0)
        {
            _contract = await ContractService.GetContractAsync(contractId);
        }
        else if (_vehicle != null)
        {
            _contract = await ContractService.GetLatestContractForVehicleAsync(_vehicle.vmf_code);
        }

        if (_contract?.vmf_code != null)
        {
            _vehicle = await VehicleService.GetVehicleAsync(_contract.vmf_code.Value);
        }

        SyncContractSelection();
        await LoadTariffPreviewAsync();
    }

    private FinanceApiResult BuildLocalValidationError(string message)
        => new()
        {
            Success = false,
            Message = message
        };

    private async Task<FinanceApiResult> SaveEditableContractAsync(int contractId)
    {
        if (contractId <= 0)
        {
            return BuildLocalValidationError("Contract could not be resolved before saving.");
        }

        if (_selectedSiteCode <= 0)
        {
            return BuildLocalValidationError("Select a client site before saving the contract.");
        }

        return await ContractService.PutActionAsync($"api/contracts/{contractId}/edit", new
        {
            SiteCode = _selectedSiteCode,
            DriverId = _contract?.driver_id ?? string.Empty,
            SiteDriverCode = _selectedSiteDriverCode ?? 0,
            UserCode = _selectedAuthoriserCode ?? 0,
            Authorisation = _contract?.authorisation ?? string.Empty,
            Notes = _approvalNotes,
            TargetReturnDate = _extendTargetReturnDate?.Date ?? _contract?.target_return_date?.Date,
            StartOdometer = _contract?.start_odometer ?? _vehicle?.current_odo
        });
    }

    private async Task<int> ResolveActionContractIdAsync(string action, int fallbackContractId)
    {
        if (action is not ("close" or "extend" or "reassign"))
        {
            return fallbackContractId;
        }

        var vmfCode = _vehicle?.vmf_code ?? _contract?.vmf_code ?? 0;
        if (vmfCode <= 0)
        {
            return fallbackContractId;
        }

        var activeContracts = await ContractService.GetContractsAsync();
        var activeForVehicle = activeContracts
            .Where(c => c.vmf_code == vmfCode)
            .Where(c =>
                string.Equals((c.still_current ?? string.Empty).Trim(), "Y", StringComparison.OrdinalIgnoreCase)
                || c.contract_status_code == 3
                || ((c.status ?? string.Empty).Contains("active", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(c => c.contract_id)
            .FirstOrDefault();

        return activeForVehicle?.contract_id ?? fallbackContractId;
    }

    private static bool ExtractIsPending(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return false;
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            return doc.RootElement.TryGetProperty("isPending", out var value) && value.GetBoolean();
        }
        catch
        {
            return false;
        }
    }

    private static (bool IsPending, int? SubmittedByUserCode) ExtractPendingDetails(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return (false, null);
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            var root = doc.RootElement;
            var isPending = root.TryGetProperty("isPending", out var pendingValue) && pendingValue.GetBoolean();

            int? submittedBy = null;
            if (root.TryGetProperty("submittedByUserCode", out var submittedByValue))
            {
                if (submittedByValue.ValueKind == JsonValueKind.Number && submittedByValue.TryGetInt32(out var parsed))
                {
                    submittedBy = parsed;
                }
                else if (submittedByValue.ValueKind == JsonValueKind.String && int.TryParse(submittedByValue.GetString(), out parsed))
                {
                    submittedBy = parsed;
                }
            }

            return (isPending, submittedBy);
        }
        catch
        {
            return (false, null);
        }
    }

    private async Task LoadTariffPreviewAsync()
    {
        _tariffPreview = null;
        _showTariffWarning = false;

        var vmfCode = _vehicle?.vmf_code ?? _contract?.vmf_code;
        if (vmfCode is not > 0)
        {
            return;
        }

        _tariffPreview = await TariffService.GetPreviewForVehicleAsync(vmfCode.Value);
        _showTariffWarning = ShouldShowTariffWarning();

        if (_openContractMode && IsTariffBlockedForCurrentContract())
        {
            _openContractMode = false;
            _actionStatusError = true;
            _actionStatusMessage = BuildMissingTariffOpenMessage();
        }
    }

    private static string FormatCurrency(decimal? amount)
    {
        return amount.HasValue ? $"R {amount.Value:N2}" : "R -";
    }

    private string FormatCombinedMonthlyDaily()
    {
        var monthly = FormatCurrency(_tariffPreview?.Tariff?.MonthlyFixedAmount);
        var daily = FormatCurrency(_tariffPreview?.Tariff?.DailyFixedAmount);
        return $"{monthly} / {daily}";
    }

    private decimal? CalculateTariffSubTotal()
    {
        if (_tariffPreview?.Tariff == null)
        {
            return null;
        }

        var fixedAmount = _tariffPreview.Tariff.MonthlyFixedAmount ?? 0m;
        var kmAmount = _tariffPreview.Tariff.MonthlyOdoAmount ?? 0m;
        return fixedAmount + kmAmount;
    }

    private bool HasValidTariffForSubmission()
    {
        return _tariffPreview?.Tariff != null;
    }

    private bool IsTariffBlockedForCurrentContract()
    {
        return _tariffPreview?.Tariff == null;
    }

    private bool IsContractOpenBlockedByTariff()
    {
        return IsNewContractState() && IsTariffBlockedForCurrentContract();
    }

    private bool ShouldShowTariffWarning()
    {
        return (IsNewContractState() || ShowContractForm()) && IsTariffBlockedForCurrentContract();
    }

    private string BuildMissingTariffMessage()
    {
        if (!string.IsNullOrWhiteSpace(_tariffPreview?.Note))
        {
            return $"Cannot submit contract: {_tariffPreview.Note}";
        }

        return "Cannot submit contract: no valid tariff found for this vehicle.";
    }

    private string BuildMissingTariffOpenMessage()
    {
        if (!string.IsNullOrWhiteSpace(_tariffPreview?.Note))
        {
            return $"Cannot open contract: {_tariffPreview.Note}";
        }

        return "Cannot open contract: no approved tariff is captured for this vehicle.";
    }

    private string BuildTariffWarningBannerMessage()
    {
        return _openContractMode || ShowContractForm()
            ? BuildMissingTariffMessage().Replace("Cannot submit contract: ", string.Empty, StringComparison.Ordinal)
            : BuildMissingTariffOpenMessage().Replace("Cannot open contract: ", string.Empty, StringComparison.Ordinal);
    }

    private static int TryExtractContractId(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return 0;
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            var root = doc.RootElement;
            if (TryReadInt(root, "contract_id", out var id)
                || TryReadInt(root, "contractId", out id)
                || TryReadInt(root, "contract_code", out id)
                || TryReadInt(root, "contractCode", out id))
            {
                return id;
            }
        }
        catch
        {
        }

        return 0;
    }

    private static bool TryReadInt(JsonElement root, string propertyName, out int value)
    {
        value = 0;
        if (!root.TryGetProperty(propertyName, out var property))
        {
            return false;
        }

        if (property.ValueKind == JsonValueKind.Number && property.TryGetInt32(out value))
        {
            return true;
        }

        return property.ValueKind == JsonValueKind.String && int.TryParse(property.GetString(), out value);
    }

    private static string NormalizeNotesForDisplay(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return string.Empty;
        }

        var lines = notes
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(static l => l.Trim())
            .Where(static l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        for (var i = 0; i < lines.Count; i++)
        {
            var line = lines[i];
            line = CollapseRepeatedPrefix(line, "Approval:");
            line = CollapseRepeatedPrefix(line, "Approved & Activated:");
            line = CollapseRepeatedPrefix(line, "Correction Required:");
            line = CollapseRepeatedPrefix(line, "Declined:");
            lines[i] = line;
        }

        return string.Join(Environment.NewLine, lines.Distinct());
    }

    private static string CollapseRepeatedPrefix(string input, string prefix)
    {
        var output = input;
        var repeated = $"{prefix} {prefix}";
        while (output.Contains(repeated, StringComparison.OrdinalIgnoreCase))
        {
            output = output.Replace(repeated, prefix, StringComparison.OrdinalIgnoreCase).Trim();
        }

        return output;
    }
