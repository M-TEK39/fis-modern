@page "/contracts/detail"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Text.Json
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject DepartmentApiService DepartmentService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Contract Detail Management</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Contract Management
        </h1>
        <p class="page-description">Vehicle contract detail management aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Return to Search</a>
        <a class="btn btn-secondary btn-sm" href="/contracts">Active Contract Overview</a>
        <button class="btn btn-secondary btn-sm" type="button" onclick="window.print()">Print</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-banner contract-banner-info">
        <i class="bx bx-info-circle"></i>
        <span>Contract for <strong>@GetQuery("ggnumber")</strong> || <strong>@GetQuery("regnumber")</strong></span>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Vehicle Contract Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="contract-cell-label">Available Actions:</th>
                    <td colspan="3">
                        @if (IsPendingAwaitingReview() && CanCurrentUserReviewPendingContract())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-danger btn-sm contract-pending-btn" type="button" @onclick='() => RunContractActionAsync("review-pending")' disabled="@_actionRunning">Pending Contract Exists : Click to Review</button>
                            </div>
                        }
                        else if (IsPendingAwaitingReview())
                        {
                            <div class="contract-action-group">
                                <span class="contract-muted">Pending contract submitted and awaiting reviewer action.</span>
                            </div>
                        }
                        else if (IsPendingInReview())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("approve")' disabled="@_actionRunning">Approve</button>
                                <button class="btn btn-success btn-sm" type="button" @onclick='() => RunContractActionAsync("approve-activate")' disabled="@_actionRunning">Approve and Activate</button>
                                <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("decline-correction")' disabled="@_actionRunning">Decline For Correction</button>
                                <button class="btn btn-danger btn-sm" type="button" @onclick='() => RunContractActionAsync("decline")' disabled="@_actionRunning">Decline</button>
                            </div>
                        }
                        else if (IsApprovedAwaitingActivationState())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-success btn-sm" type="button" @onclick='() => RunContractActionAsync("approve-activate")' disabled="@_actionRunning">Activate Approved Contract</button>
                                <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("decline-correction")' disabled="@_actionRunning">Decline For Correction</button>
                                <button class="btn btn-danger btn-sm" type="button" @onclick='() => RunContractActionAsync("decline")' disabled="@_actionRunning">Decline</button>
                            </div>
                        }
                        else if (IsCorrectionState())
                        {
                            if (!_openContractMode)
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("review-correction")' disabled="@_actionRunning">Load Correction and Resubmit</button>
                                </div>
                            }
                            else
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("submit")' disabled="@_actionRunning">Submit For approval</button>
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                                </div>
                            }
                        }
                        else if (IsNewContractState())
                        {
                            @if (!_openContractMode)
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-primary btn-sm" type="button" @onclick='() => RunContractActionAsync("open")' disabled="@_actionRunning">Open a Contract</button>
                                </div>
                            }
                            else
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("submit")' disabled="@_actionRunning">Submit For approval</button>
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                                </div>
                            }
                        }
                        else if (IsActiveContractState())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("extend")' disabled="@_actionRunning">Extend Active Contract</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("reassign")' disabled="@_actionRunning">Reassign Contract</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("close")' disabled="@_actionRunning">Close Active Contract</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_actionStatusMessage))
                        {
                            <div class="alert @(_actionStatusError ? "alert-error" : "alert-success")" style="margin-top:0.75rem;">
                                @_actionStatusMessage
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (ShowContractForm())
    {
    @if (IsReviewerMode())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Approval Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="contract-approval-summary">
                            @BuildApprovalSummary()
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else if (HasReviewerNotes())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Reviewer Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <textarea class="form-input contract-notes" rows="4" readonly>@NormalizeNotesForDisplay(_contract?.contract_notes)</textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (IsReviewerMode())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Approval Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <textarea class="form-input contract-notes" rows="4" placeholder="Approval notes..." @bind="_approvalNotes"></textarea>
                            <input class="form-input" style="margin-top:0.5rem;" placeholder="Decline reason (required for decline actions)" @bind="_declineReason" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Vehicle Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                        <th>GG Number</th>
                                        <td>@(ValueOrDash(_vehicle?.fleet_number) ?? GetQuery("ggnumber"))</td>
                                        <th>Registration Number</th>
                                        <td>@(ValueOrDash(_vehicle?.registration_number) ?? GetQuery("regnumber"))</td>
                                    <th>Identification</th>
                                    <td rowspan="5" class="contract-photo-cell">
                                        <div class="contract-photo-box">Vehicle Photos</div>
                                    </td>
                                </tr>
                                <tr>
                                        <th>VIN / Chassis Number</th>
                                        <td>@ValueOrDash(_vehicle?.chassis_number)</td>
                                        <th>Engine Number</th>
                                        <td>@ValueOrDash(_vehicle?.engine_number_1)</td>
                                </tr>
                                <tr>
                                        <th>Make &amp; Model</th>
                                        <td>@ValueOrDash(_vehicle?.model_name)</td>
                                        <th>Year Manufactured</th>
                                        <td>@(_vehicle?.year_manufactured?.ToString() ?? "-")</td>
                                </tr>
                                <tr>
                                        <th>Colour</th>
                                        <td>@ValueOrDash(_vehicle?.colour)</td>
                                        <th>Depot Location</th>
                                        <td>@ValueOrDash(_vehicle?.location_description)</td>
                                </tr>
                                <tr>
                                        <th>Hire Type</th>
                                        <td>@ValueOrDash(_vehicle?.type_name ?? GetContractTypeLabel(_contract?.contractor_name))</td>
                                        <th>Hired From</th>
                                        <td>@ValueOrDash(_vehicle?.purchased_from)</td>
                                </tr>
                                <tr>
                                        <th>Status</th>
                                        <td>@ValueOrDash(_contract?.status ?? _vehicle?.status_description)</td>
                                        <th>Status Date</th>
                                        <td>@ValueOrDash(_contract?.end_date?.ToString("yyyy/MM/dd") ?? _vehicle?.vehicle_status_date?.ToString("yyyy/MM/dd"))</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Contract Readiness</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th rowspan="3">Contract Client<br /><span class="contract-muted">* Intended or current active contract</span></th>
                                        <th>Department</th>
                                        <td colspan="2">
                                            <select class="form-select">
                                                <option value="">@(ValueOrDash(_department?.department_description) ?? "Select Department")</option>
                                            </select>
                                        </td>
                                    <td rowspan="4" class="contract-tariff-cell">
                                        <table class="contract-subtable">
                                            <thead>
                                                <tr>
                                                    <th colspan="4">Tariff Detail</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <th>Tariff Type</th>
                                                    <td>-</td>
                                                    <td colspan="2">
                                                        <input type="checkbox" /> Active / Valid Tariff
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>Monthly Rate</th>
                                                    <th>Daily Rate</th>
                                                    <th>KM Rate</th>
                                                    <th>Excess KM Rate</th>
                                                </tr>
                                                <tr>
                                                    <td>R -</td>
                                                    <td>R -</td>
                                                    <td>R -</td>
                                                    <td>R -</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                        <th>Site</th>
                                        <td colspan="2">
                                            <select class="form-select">
                                                <option value="">@(ValueOrDash(_site?.Description) ?? "Select Site")</option>
                                            </select>
                                        </td>
                                </tr>
                                <tr>
                                    <th colspan="2"></th>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Valid Financial System &amp; Codes
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Active Fuelcard <span class="contract-muted">[Fuel Card #]</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Current Contract
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Vehicle Assessment Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="contract-inline-label">Sets of Keys</label>
                                        <select class="form-select contract-inline-select">
                                            <option>--</option>
                                            <option>1</option>
                                            <option>2</option>
                                            <option>3</option>
                                        </select>
                                    </td>
                                    <td><input type="checkbox" /> License Disc</td>
                                    <td><input type="checkbox" /> Wheel Spanner</td>
                                    <td><input type="checkbox" /> Jack</td>
                                    <td><input type="checkbox" /> Fuel Card (Card #)</td>
                                </tr>
                                <tr>
                                    <td><input type="checkbox" /> Wheel Lock Key</td>
                                    <td><input type="checkbox" /> COF Disc</td>
                                    <td><input type="checkbox" /> Spare Wheel</td>
                                    <td><input type="checkbox" /> Smash &amp; Grab</td>
                                    <td>
                                        <input type="checkbox" /> Logbook
                                        <input class="form-input contract-input-sm" placeholder="Start #" />
                                        <input class="form-input contract-input-sm" placeholder="End #" />
                                    </td>
                                </tr>
                                <tr>
                                    <td><input type="checkbox" /> Gear Lock</td>
                                    <td><input type="checkbox" /> Tracker</td>
                                    <td><input type="checkbox" /> Radio</td>
                                    <td><input type="checkbox" /> Fire Extinguisher</td>
                                    <td><input type="checkbox" /> Damages</td>
                                </tr>
                                <tr>
                                    <th>Notes</th>
                                    <td colspan="4">
                                        <textarea class="form-input contract-notes" rows="3" placeholder="Assessment notes..."></textarea>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Client Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th rowspan="3">Contract Client</th>
                                    <th>Department</th>
                                    <td colspan="3">
                                        <input class="form-input" readonly value="@ValueOrDash(_department?.department_description)" />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Site</th>
                                    <td colspan="3">
                                        <input class="form-input" readonly value="@ValueOrDash(_site?.Description)" />
                                    </td>
                                </tr>
                                <tr>
                                    <th colspan="4"></th>
                                </tr>
                                <tr>
                                    <th>Authoriser Name</th>
                                    <td colspan="2">
                                        <input class="form-input" readonly value="@ValueOrDash(_contract?.contractor_name)" />
                                    </td>
                                    <th>Authorization</th>
                                    <td>
                                        <input class="form-input" readonly value="@ValueOrDash(_contract?.status)" />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Driver Name</th>
                                    <td colspan="2">
                                        <input class="form-input" readonly value="-" />
                                    </td>
                                    <td colspan="2">
                                        <input type="checkbox" /> Valid Driver's License <span class="contract-muted">(expiry)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Collected By Detail</th>
                                    <td colspan="4">
                                        <table class="contract-subtable">
                                            <tbody>
                                                <tr>
                                                    <th>Name</th>
                                                    <td><input class="form-input" /></td>
                                                    <th>Surname</th>
                                                    <td><input class="form-input" /></td>
                                                </tr>
                                                <tr>
                                                    <th>ID Number</th>
                                                    <td><input class="form-input" /></td>
                                                    <th>Passport Number</th>
                                                    <td><input class="form-input" /></td>
                                                </tr>
                                                <tr>
                                                    <th>Office Telephone</th>
                                                    <td><input class="form-input" /></td>
                                                    <th>Cellphone</th>
                                                    <td><input class="form-input" /></td>
                                                </tr>
                                                <tr>
                                                    <th>Office / Section</th>
                                                    <td><input class="form-input" /></td>
                                                    <th>Designation / Rank</th>
                                                    <td><input class="form-input" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Notes</th>
                                    <td colspan="4">
                                        <textarea class="form-input contract-notes" rows="3" @bind="_approvalNotes"></textarea>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Billing Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th>Financial System</th>
                                    <td>-</td>
                                    <td colspan="3">
                                        <input type="checkbox" /> Valid Financial System &amp; Codes
                                    </td>
                                </tr>
                                <tr>
                                    <th>Project</th>
                                    <td colspan="2">
                                        <select class="form-select">
                                            <option value="">Select Project</option>
                                        </select>
                                    </td>
                                    <th>Fund</th>
                                    <td colspan="2">
                                        <select class="form-select">
                                            <option value="">Select Fund</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Responsibility</th>
                                    <td colspan="2">
                                        <select class="form-select">
                                            <option value="">Select Responsibility</option>
                                        </select>
                                    </td>
                                    <th>Objective</th>
                                    <td>
                                        <select class="form-select">
                                            <option value="">Select Objective</option>
                                        </select>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Contract Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th>Contract Type</th>
                                    <td>
                                        <input class="form-input" readonly value="@GetContractTypeLabel(_contract?.contractor_name)" />
                                    </td>
                                    <td colspan="2">
                                        <input type="checkbox" /> Opt-In for Relief Vehicle
                                    </td>
                                    <th>Contract Status</th>
                                    <td>@ValueOrDash(_contract?.status)</td>
                                    <th>Last Billed Date</th>
                                    <td>@FormatDate(_contract?.end_date)</td>
                                </tr>
                                <tr>
                                    <th>Start Date</th>
                                    <td><input type="date" class="form-input" value="@FormatDateForInput(_contract?.start_date)" readonly /></td>
                                    <th>End Date</th>
                                    <td><input type="date" class="form-input" value="@FormatDateForInput(_contract?.end_date)" readonly /></td>
                                    <th>Contract Period</th>
                                    <td>
                                        <select class="form-select contract-inline-select">
                                            <option value="">--</option>
                                            <option>12</option>
                                            <option>24</option>
                                            <option>36</option>
                                            <option>48</option>
                                            <option>60</option>
                                            <option>72</option>
                                            <option>84</option>
                                        </select>
                                        <span class="contract-muted">Lease Months</span>
                                    </td>
                                    <th>Return Date</th>
                                    <td><input type="date" class="form-input" value="@FormatDateForInput(_contract?.end_date)" readonly /></td>
                                </tr>
                                <tr>
                                    <th>Back Dating Required</th>
                                    <td><input type="checkbox" /></td>
                                    <th>Back Dating Start Date</th>
                                    <td><input type="date" class="form-input" /></td>
                                    <th>Back Dating Status</th>
                                    <td colspan="3">Requested / Declined / Approved</td>
                                </tr>
                                <tr>
                                    <th>Start Odometer</th>
                                    <td><input type="number" class="form-input" value="@(_vehicle?.current_odo?.ToString() ?? "")" readonly /></td>
                                    <th>End Odometer</th>
                                    <td><input type="number" class="form-input" value="@(_vehicle?.current_odo?.ToString() ?? "")" readonly /></td>
                                    <th>Contract Kilometers</th>
                                    <td><input type="number" class="form-input" readonly /></td>
                                    <th>End Kilometers</th>
                                    <td><input type="number" class="form-input" value="@(_vehicle?.current_odo?.ToString() ?? "")" readonly /></td>
                                </tr>
                                <tr>
                                    <th>Notes</th>
                                    <td colspan="7">
                                        <textarea class="form-input contract-notes" rows="3" @bind="_approvalNotes"></textarea>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Tariff Summary Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th>Monthly Tariff (p/m) / Daily Tariff (p/d)</th>
                                    <td>R -</td>
                                    <th>KM Tariff (p/km)</th>
                                    <td>R -</td>
                                    <th>Excess KM Tariff (p/km)</th>
                                    <td>R -</td>
                                </tr>
                                <tr>
                                    <td colspan="6"><em>* Estimated Total of Tariff Charges Over the Contract Period (excluding fuel, oil, tolls, fines, losses, damages, excess charges)</em></td>
                                </tr>
                                <tr>
                                    <th>Total Fixed Tariff Charges</th>
                                    <td>R -</td>
                                    <th>Total KM Charges</th>
                                    <td>R -</td>
                                    <th>Sub-Total (All Charges)</th>
                                    <td>R -</td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "ggnumber")] public string? GgNumber { get; set; }
    [SupplyParameterFromQuery(Name = "regnumber")] public string? RegNumber { get; set; }
    [SupplyParameterFromQuery(Name = "contractId")] public string? ContractId { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? Action { get; set; }

    private ContractDto? _contract;
    private VehicleDto? _vehicle;
    private SiteResponseDto? _site;
    private DepartmentDto? _department;
    private bool _actionRunning;
    private bool _actionStatusError;
    private string _actionStatusMessage = string.Empty;
    private string _approvalNotes = string.Empty;
    private string _declineReason = string.Empty;
    private bool _isContractActive;
    private bool _hasPendingContract;
    private bool _openContractMode;
    private bool _reviewPendingMode;
    private bool _scrollToTopPending = true;
    private bool _submittedByCurrentUserInSession;
    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasContractApproverRole;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ResolveCurrentUserContextAsync();

            if (int.TryParse(ContractId, out var contractId))
            {
                _contract = await ContractService.GetContractAsync(contractId);
            }

            if (_contract?.vmf_code != null)
            {
                _vehicle = await VehicleService.GetVehicleAsync(_contract.vmf_code.Value);
            }

            if (_vehicle == null)
            {
                _vehicle = await FindVehicleFromQuery();
            }

            if (_contract == null && _vehicle != null)
            {
                _contract = await ContractService.GetLatestContractForVehicleAsync(_vehicle.vmf_code);
            }

            if (_contract?.site_code != null)
            {
                _site = await SiteService.GetByIdAsync(_contract.site_code.Value);
                if (_site?.DepartmentCode != null)
                {
                    _department = await DepartmentService.GetDepartmentAsync(_site.DepartmentCode.Value);
                }
            }

        _approvalNotes = string.Empty;
            await EvaluateContractStateAsync();
        }
        catch
        {
        }
    }

    protected override Task OnParametersSetAsync()
    {
        _scrollToTopPending = true;
        return base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToTopPending)
        {
            _scrollToTopPending = false;
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private async Task<VehicleDto?> FindVehicleFromQuery()
    {
        var query = !string.IsNullOrWhiteSpace(GgNumber)
            ? GgNumber.Trim()
            : !string.IsNullOrWhiteSpace(RegNumber)
                ? RegNumber.Trim()
                : string.Empty;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var results = await VehicleService.SearchVehiclesAsync(query);
        return results.FirstOrDefault();
    }

    private string GetQuery(string key)
    {
        return key switch
        {
            "ggnumber" => GgNumber ?? "-",
            "regnumber" => RegNumber ?? "-",
            "contractId" => ContractId ?? "-",
            "action" => Action ?? "-",
            _ => "-"
        };
    }

    private async Task RunContractActionAsync(string action)
    {
        var vmfCode = _vehicle?.vmf_code ?? _contract?.vmf_code ?? 0;

        if (action == "open")
        {
            if (vmfCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a valid vehicle before opening a contract.";
                return;
            }

            _openContractMode = true;
            _reviewPendingMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Complete contract details, then submit for approval.";
            return;
        }

        if (action == "review-pending")
        {
            if (!CanCurrentUserReviewPendingContract())
            {
                _actionStatusError = true;
                _actionStatusMessage = "You cannot review or approve your own pending contract.";
                return;
            }

            _reviewPendingMode = true;
            _openContractMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Pending contract loaded for review.";
            return;
        }

        if (action == "review-correction")
        {
            _openContractMode = true;
            _reviewPendingMode = false;
            _actionStatusError = false;
            _actionStatusMessage = "Correction contract loaded. Update details and submit for approval.";
            return;
        }

        _actionRunning = true;
        _actionStatusMessage = string.Empty;

        var contractId = ResolveContractId();
        var actionContractId = await ResolveActionContractIdAsync(action, contractId);
        if (actionContractId <= 0 && action != "submit" && action != "cancel")
        {
            _actionStatusError = true;
            _actionStatusMessage = "Contract ID is required for this action.";
            _actionRunning = false;
            return;
        }

        if ((action == "decline" || action == "decline-correction") && string.IsNullOrWhiteSpace(_declineReason))
        {
            _actionStatusError = true;
            _actionStatusMessage = "Decline reason is required.";
            _actionRunning = false;
            return;
        }

        if (action is "approve" or "approve-activate" or "decline" or "decline-correction")
        {
            if (!CanCurrentUserReviewPendingContract())
            {
                _actionStatusError = true;
                _actionStatusMessage = "You cannot review or approve your own pending contract.";
                _actionRunning = false;
                return;
            }
        }

        var endpoint = action switch
        {
            "extend" => $"api/contracts/{actionContractId}/extend",
            "reassign" => $"api/contracts/{actionContractId}/reassign",
            "close" => $"api/contracts/{actionContractId}/close",
            "relief" => $"api/contracts/{actionContractId}/relief",
            "submit" => $"api/contracts/{actionContractId}/submit",
            "cancel" => $"api/contracts/{actionContractId}/cancel",
            "approve" => $"api/contracts/{actionContractId}/approve",
            "approve-activate" => $"api/contracts/{actionContractId}/approve-activate",
            "decline-correction" => $"api/contracts/{actionContractId}/decline-correction",
            "decline" => $"api/contracts/{actionContractId}/decline",
            _ => $"api/contracts/{actionContractId}/pending"
        };

        FinanceApiResult result;
        if (action == "extend")
        {
            result = await ContractService.PutActionAsync(endpoint, new
            {
                NewTargetReturnDate = DateTime.UtcNow.Date.AddDays(30)
            });
        }
        else if (action == "close")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                EndDate = DateTime.UtcNow.Date,
                EndOdometer = Math.Max(_vehicle?.current_odo ?? 0, 0),
                Notes = _approvalNotes
            });
        }
        else if (action == "reassign")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                NewVmfCode = vmfCode > 0 ? (int?)vmfCode : null,
                NewSiteCode = _contract?.site_code,
                Reason = string.IsNullOrWhiteSpace(_approvalNotes) ? "Reassignment requested from contract detail." : _approvalNotes
            });
        }
        else if (action == "relief")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                ReliefVmfCode = vmfCode,
                StartOdometer = _vehicle?.current_odo,
                TargetReturnDate = DateTime.UtcNow.Date.AddDays(7),
                Reason = string.IsNullOrWhiteSpace(_approvalNotes) ? "Relief contract requested from contract detail." : _approvalNotes
            });
        }
        else if (action == "submit")
        {
            if (vmfCode <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Select a valid vehicle before submitting a contract.";
                _actionRunning = false;
                return;
            }

            if (contractId <= 0)
            {
                var createResult = await ContractService.PostActionAsync("api/contracts/hire", new
                {
                    VmfCode = vmfCode,
                    SiteCode = _contract?.site_code ?? (short)0,
                    StartOdometer = _vehicle?.current_odo,
                    Notes = _approvalNotes
                });

                if (!createResult.Success)
                {
                    _actionStatusError = true;
                    _actionStatusMessage = createResult.Message;
                    _actionRunning = false;
                    return;
                }

                var createdContractId = TryExtractContractId(createResult.ResponseBody);
                if (createdContractId > 0)
                {
                    _contract = await ContractService.GetContractAsync(createdContractId);
                    contractId = createdContractId;
                    actionContractId = createdContractId;
                }
            }

            if (actionContractId <= 0)
            {
                _actionStatusError = true;
                _actionStatusMessage = "Contract could not be created for submission.";
                _actionRunning = false;
                return;
            }

            result = await ContractService.PostActionAsync($"api/contracts/{actionContractId}/submit", new
            {
                ApprovalNotes = _approvalNotes
            });
        }
        else if (action == "cancel")
        {
            if (_openContractMode && contractId <= 0)
            {
                _openContractMode = false;
                _actionStatusError = false;
                _actionStatusMessage = "Open contract draft cancelled.";
                _actionRunning = false;
                return;
            }

            result = await ContractService.PostActionAsync(endpoint, new
            {
                CancellationReason = _declineReason
            });
        }
        else if (action == "approve" || action == "approve-activate")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                ApprovalNotes = _approvalNotes
            });
        }
        else if (action == "decline" || action == "decline-correction")
        {
            result = await ContractService.PostActionAsync(endpoint, new
            {
                DeclineReason = _declineReason
            });
        }
        else
        {
            result = await ContractService.PostActionAsync(endpoint, new { });
        }

        _actionStatusError = !result.Success;
        _actionStatusMessage = result.Message;
        _actionRunning = false;

        if (result.Success)
        {
            if (action == "submit")
            {
                _submittedByCurrentUserInSession = true;
            }

            await RefreshContractContextAsync(actionContractId);
            await EvaluateContractStateAsync();
            _approvalNotes = string.Empty;
            _declineReason = string.Empty;
        }
    }

    private int ResolveContractId()
    {
        if (_contract?.contract_id > 0)
        {
            return _contract.contract_id;
        }

        return int.TryParse(ContractId, out var id) && id > 0 ? id : 0;
    }

    private static string? ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? date) => date?.ToString("yyyy/MM/dd") ?? "-";

    private static string FormatDateForInput(DateTime? date) => date?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static string GetContractTypeLabel(string? contractTypeCode)
    {
        var code = (contractTypeCode ?? string.Empty).Trim().ToUpperInvariant();
        return code switch
        {
            "A" => "Daily",
            "B" => "Hourly",
            "C" => "Permanent",
            "D" => "Relieve",
            "E" => "Lease",
            _ => string.IsNullOrWhiteSpace(code) ? "-" : code
        };
    }

    private string BuildApprovalSummary()
    {
        var openedBy = ValueOrDash(_contract?.contractor_name) ?? "Unknown";
        var openedOn = _contract?.start_date.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy");
        var status = ValueOrDash(_contract?.status) ?? "Awaiting Approval";

        return $"CONTRACT OPENED BY {openedBy.ToUpperInvariant()} ON THE {openedOn} AND CURRENTLY IN STATUS: {status.ToUpperInvariant()}.";
    }

    private async Task EvaluateContractStateAsync()
    {
        var statusCode = _contract?.contract_status_code;
        var stillCurrent = (_contract?.still_current ?? string.Empty).Trim().ToUpperInvariant();
        var status = (_contract?.status ?? string.Empty).Trim().ToLowerInvariant();

        if (stillCurrent is "Y" or "N")
        {
            _isContractActive = stillCurrent == "Y";
        }
        else
        {
            _isContractActive =
                statusCode == 3
                || (!string.IsNullOrWhiteSpace(status) && (status.Contains("active") || status.Contains("in service")));
        }

        _hasPendingContract = statusCode == 1;
        var contractId = ResolveContractId();
        if (!_hasPendingContract && contractId > 0)
        {
            var pendingResponse = await ContractService.GetActionAsync($"api/contracts/{contractId}/pending");
            if (pendingResponse.Success && !string.IsNullOrWhiteSpace(pendingResponse.ResponseBody))
            {
                var pendingDetails = ExtractPendingDetails(pendingResponse.ResponseBody);
                _hasPendingContract = pendingDetails.IsPending;
                if (pendingDetails.SubmittedByUserCode is > 0 && _contract != null)
                {
                    _contract.created_by_user_code = pendingDetails.SubmittedByUserCode.Value;
                }
            }
        }

        var action = (Action ?? string.Empty).Trim().ToLowerInvariant();
        if (_hasPendingContract)
        {
            _reviewPendingMode = CanCurrentUserReviewPendingContract() && (action is "review" or "process");
            _openContractMode = false;
        }
        else if (!_isContractActive)
        {
            _openContractMode = action is "open";
            _reviewPendingMode = false;
        }
        else
        {
            _openContractMode = false;
            _reviewPendingMode = false;
        }
    }

    private bool IsPendingAwaitingReview() => _hasPendingContract && !_reviewPendingMode;
    private bool IsPendingInReview() => _hasPendingContract && _reviewPendingMode;
    private bool IsActiveContractState() => _isContractActive && !_hasPendingContract;
    private bool IsApprovedAwaitingActivationState() => _contract?.contract_status_code == 2 && !IsActiveContractState();
    private bool IsCorrectionState() => _contract?.contract_status_code == 4;
    private bool IsNewContractState() => !_isContractActive && !_hasPendingContract && !IsApprovedAwaitingActivationState() && !IsCorrectionState();
    private bool IsReviewerMode() => IsPendingInReview();
    private bool CanCurrentUserReviewPendingContract() => _hasContractApproverRole && !IsCurrentUserContractCapturer();
    private bool HasReviewerNotes() => !string.IsNullOrWhiteSpace(_contract?.contract_notes);
    private bool ShowContractForm() => _reviewPendingMode || _openContractMode || IsActiveContractState() || IsApprovedAwaitingActivationState();

    private bool IsCurrentUserContractCapturer()
    {
        if (_currentUserAccessCode is not > 0)
        {
            return false;
        }

        var contractUserCode = _contract?.user_code;
        if (contractUserCode is > 0 && contractUserCode.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        var createdByUserCode = _contract?.created_by_user_code;
        if (createdByUserCode is > 0 && createdByUserCode.Value == _currentUserAccessCode.Value)
        {
            return true;
        }

        return _submittedByCurrentUserInSession;
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _hasContractApproverRole = HasAnyRole(user, "contracts approver", "contracts_approver", "back dating contract (approver)");

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        if (!_hasContractApproverRole && (_currentAccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
        {
            _hasContractApproverRole = true;
        }
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool HasAnyRole(ClaimsPrincipal user, params string[] roles)
    {
        foreach (var role in roles)
        {
            if (user.IsInRole(role))
            {
                return true;
            }
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => roles.Any(role => string.Equals(item, role, StringComparison.OrdinalIgnoreCase))));
    }

    private async Task RefreshContractContextAsync(int contractIdHint)
    {
        var contractId = contractIdHint > 0 ? contractIdHint : ResolveContractId();
        if (contractId > 0)
        {
            _contract = await ContractService.GetContractAsync(contractId);
        }
        else if (_vehicle != null)
        {
            _contract = await ContractService.GetLatestContractForVehicleAsync(_vehicle.vmf_code);
        }

        if (_contract?.vmf_code != null)
        {
            _vehicle = await VehicleService.GetVehicleAsync(_contract.vmf_code.Value);
        }
    }

    private async Task<int> ResolveActionContractIdAsync(string action, int fallbackContractId)
    {
        if (action is not ("close" or "extend" or "reassign"))
        {
            return fallbackContractId;
        }

        var vmfCode = _vehicle?.vmf_code ?? _contract?.vmf_code ?? 0;
        if (vmfCode <= 0)
        {
            return fallbackContractId;
        }

        var activeContracts = await ContractService.GetContractsAsync();
        var activeForVehicle = activeContracts
            .Where(c => c.vmf_code == vmfCode)
            .Where(c =>
                string.Equals((c.still_current ?? string.Empty).Trim(), "Y", StringComparison.OrdinalIgnoreCase)
                || c.contract_status_code == 3
                || ((c.status ?? string.Empty).Contains("active", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(c => c.contract_id)
            .FirstOrDefault();

        return activeForVehicle?.contract_id ?? fallbackContractId;
    }

    private static bool ExtractIsPending(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return false;
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            return doc.RootElement.TryGetProperty("isPending", out var value) && value.GetBoolean();
        }
        catch
        {
            return false;
        }
    }

    private static (bool IsPending, int? SubmittedByUserCode) ExtractPendingDetails(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return (false, null);
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            var root = doc.RootElement;
            var isPending = root.TryGetProperty("isPending", out var pendingValue) && pendingValue.GetBoolean();

            int? submittedBy = null;
            if (root.TryGetProperty("submittedByUserCode", out var submittedByValue))
            {
                if (submittedByValue.ValueKind == JsonValueKind.Number && submittedByValue.TryGetInt32(out var parsed))
                {
                    submittedBy = parsed;
                }
                else if (submittedByValue.ValueKind == JsonValueKind.String && int.TryParse(submittedByValue.GetString(), out parsed))
                {
                    submittedBy = parsed;
                }
            }

            return (isPending, submittedBy);
        }
        catch
        {
            return (false, null);
        }
    }

    private static int TryExtractContractId(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return 0;
        }

        try
        {
            using var doc = JsonDocument.Parse(responseBody);
            var root = doc.RootElement;
            if (TryReadInt(root, "contract_id", out var id)
                || TryReadInt(root, "contractId", out id)
                || TryReadInt(root, "contract_code", out id)
                || TryReadInt(root, "contractCode", out id))
            {
                return id;
            }
        }
        catch
        {
        }

        return 0;
    }

    private static bool TryReadInt(JsonElement root, string propertyName, out int value)
    {
        value = 0;
        if (!root.TryGetProperty(propertyName, out var property))
        {
            return false;
        }

        if (property.ValueKind == JsonValueKind.Number && property.TryGetInt32(out value))
        {
            return true;
        }

        return property.ValueKind == JsonValueKind.String && int.TryParse(property.GetString(), out value);
    }

    private static string NormalizeNotesForDisplay(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return string.Empty;
        }

        var lines = notes
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(static l => l.Trim())
            .Where(static l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        for (var i = 0; i < lines.Count; i++)
        {
            var line = lines[i];
            line = CollapseRepeatedPrefix(line, "Approval:");
            line = CollapseRepeatedPrefix(line, "Approved & Activated:");
            line = CollapseRepeatedPrefix(line, "Correction Required:");
            line = CollapseRepeatedPrefix(line, "Declined:");
            lines[i] = line;
        }

        return string.Join(Environment.NewLine, lines.Distinct());
    }

    private static string CollapseRepeatedPrefix(string input, string prefix)
    {
        var output = input;
        var repeated = $"{prefix} {prefix}";
        while (output.Contains(repeated, StringComparison.OrdinalIgnoreCase))
        {
            output = output.Replace(repeated, prefix, StringComparison.OrdinalIgnoreCase).Trim();
        }

        return output;
    }
