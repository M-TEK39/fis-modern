    private string BuildCloseProvinceGuidance()
    {
        var homeSite = FindSite(_closeHomeSiteCode);
        if (homeSite == null)
        {
            return "Select a GFleet site to confirm the return-home province.";
        }

        var homeProvince = ProvinceDisplay(homeSite.ProvinceCode);
        var currentSite = FindSite(_vehicle?.location_code);
        var currentProvince = currentSite == null ? "unknown province" : ProvinceDisplay(currentSite.ProvinceCode);
        var selectedDriver = HomeDriverOptions.FirstOrDefault(driver => driver.site_driver_code == _closeHomeDriverCode);

        if (selectedDriver == null)
        {
            return $"Vehicle will return to {ValueOrDash(homeSite.Description)} in {homeProvince}. Select a GFleet custodian driver from the same site/province.";
        }

        var driverSite = FindSite(selectedDriver.site_code);
        var driverProvince = driverSite == null ? "unknown province" : ProvinceDisplay(driverSite.ProvinceCode);
        if (selectedDriver.site_code != homeSite.SiteCode)
        {
            return $"Selected driver belongs to {ValueOrDash(driverSite?.Description)} in {driverProvince}. Choose a driver linked to {ValueOrDash(homeSite.Description)} in {homeProvince}.";
        }

        return $"Vehicle current site: {ValueOrDash(currentSite?.Description)} ({currentProvince}). Return-home site: {ValueOrDash(homeSite.Description)} ({homeProvince}).";
    }

    private string BuildSiteUpdateProvinceGuidance()
    {
        var targetSite = FindSite(_siteUpdateSiteCode);
        if (targetSite == null)
        {
            return "Select the corrected GFleet site to confirm the province.";
        }

        var targetProvince = ProvinceDisplay(targetSite.ProvinceCode);
        var selectedDriver = SiteUpdateDriverOptions.FirstOrDefault(driver => driver.site_driver_code == _siteUpdateDriverCode);
        if (selectedDriver == null)
        {
            return $"Vehicle site will be corrected to {ValueOrDash(targetSite.Description)} in {targetProvince}. Select a custodian driver from that same site.";
        }

        var driverSite = FindSite(selectedDriver.site_code);
        var driverProvince = driverSite == null ? "unknown province" : ProvinceDisplay(driverSite.ProvinceCode);
        if (selectedDriver.site_code != targetSite.SiteCode)
        {
            return $"Selected driver belongs to {ValueOrDash(driverSite?.Description)} in {driverProvince}. Choose a driver from {ValueOrDash(targetSite.Description)} in {targetProvince}.";
        }

        return $"Corrected site and custodian are aligned to {ValueOrDash(targetSite.Description)} in {targetProvince}.";
    }

