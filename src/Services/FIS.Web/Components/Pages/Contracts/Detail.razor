@page "/contracts/detail"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Text.Json
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject TariffApiService TariffService
@inject DepartmentApiService DepartmentService
@inject SiteApiService SiteService
@inject ProvinceApiService ProvinceService
@inject UserApiService UserService
@inject DriverApiService DriverService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Contract Detail Management</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Contract Management
        </h1>
        <p class="page-description">Vehicle contract detail management.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Return to Search</a>
        <a class="btn btn-secondary btn-sm" href="/contracts">Active Contract Overview</a>
        <a class="btn btn-secondary btn-sm" href="/contracts/print-menu">Print Menu</a>
        <a class="btn btn-secondary btn-sm" href="@GetPrintoutUrl()" target="_blank">Print</a>
    </div>
</div>

<div class="page-content">
    <div class="contract-banner contract-banner-info">
        <i class="bx bx-info-circle"></i>
        <span>Contract for <strong>@GetVehicleContextLabel()</strong></span>
    </div>
    @if (_showTariffWarning)
    {
        <div class="contract-banner contract-banner-warning">
            <i class="bx bx-error"></i>
            <span>@BuildTariffWarningBannerMessage()</span>
        </div>
    }

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Vehicle Contract Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="contract-cell-label">Available Actions:</th>
                    <td colspan="3">
                        @if (IsPendingAwaitingReview() && CanCurrentUserReviewPendingContract())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-danger btn-sm contract-pending-btn" type="button" @onclick='() => RunContractActionAsync("review-pending")' disabled="@_actionRunning">Pending Contract Exists : Click to Review</button>
                            </div>
                        }
                        else if (IsPendingAwaitingReview())
                        {
                            <div class="contract-action-group">
                                @if (IsCurrentUserContractCapturer())
                                {
                                    <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("recall")' disabled="@_actionRunning">Recall to Draft</button>
                                }
                                else
                                {
                                    <span class="contract-muted">Pending contract submitted and awaiting reviewer action.</span>
                                }
                            </div>
                        }
                        else if (IsPendingInReview())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("approve")' disabled="@_actionRunning">Approve</button>
                                <button class="btn btn-success btn-sm" type="button" @onclick='() => RunContractActionAsync("approve-activate")' disabled="@_actionRunning">Approve and Activate</button>
                                <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("decline-correction")' disabled="@_actionRunning">Decline For Correction</button>
                                <button class="btn btn-danger btn-sm" type="button" @onclick='() => RunContractActionAsync("decline")' disabled="@_actionRunning">Decline</button>
                            </div>
                        }
                        else if (IsApprovedAwaitingActivationState())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-success btn-sm" type="button" @onclick='() => RunContractActionAsync("approve-activate")' disabled="@_actionRunning">Activate Approved Contract</button>
                                <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("decline-correction")' disabled="@_actionRunning">Decline For Correction</button>
                                <button class="btn btn-danger btn-sm" type="button" @onclick='() => RunContractActionAsync("decline")' disabled="@_actionRunning">Decline</button>
                            </div>
                        }
                        else if (IsCorrectionState())
                        {
                            if (!_openContractMode)
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-warning btn-sm" type="button" @onclick='() => RunContractActionAsync("review-correction")' disabled="@_actionRunning">Load Correction and Resubmit</button>
                                </div>
                            }
                            else
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("submit")' disabled="@_actionRunning">Submit For approval</button>
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                                </div>
                            }
                        }
                        else if (IsNewContractState())
                        {
                            @if (!_openContractMode)
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-primary btn-sm" type="button" @onclick='() => RunContractActionAsync("open")' disabled="@(_actionRunning || IsContractOpenBlockedByTariff())">Open a Contract</button>
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("site-update")' disabled="@_actionRunning">@(_siteUpdateMode ? "Save Vehicle Site / Custodian" : "Update Vehicle Site / Custodian")</button>
                                    @if (_siteUpdateMode)
                                    {
                                        <button class="btn btn-warning btn-sm" type="button" @onclick="CancelActiveEditMode">Cancel Edit Mode</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="contract-action-group">
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("submit")' disabled="@_actionRunning">Submit For approval</button>
                                    <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                                </div>
                            }
                        }
                        else if (IsActiveContractState())
                        {
                            <div class="contract-action-group">
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("extend")' disabled="@_actionRunning">@(_extendMode ? "Save Extension" : "Extend Active Contract")</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("reassign")' disabled="@_actionRunning">@(_reassignMode ? "Save Reassign" : "Reassign Contract")</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("close")' disabled="@_actionRunning">@(_closeMode ? "Save Close and Return Home" : "Close Active Contract")</button>
                                <button class="btn btn-secondary btn-sm" type="button" @onclick='() => RunContractActionAsync("cancel")' disabled="@_actionRunning">Cancel Loaded Contract</button>
                                @if (_extendMode || _reassignMode || _closeMode)
                                {
                                    <button class="btn btn-warning btn-sm" type="button" @onclick="CancelActiveEditMode">Cancel Edit Mode</button>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_actionStatusMessage))
                        {
                            <div class="alert @(_actionStatusError ? "alert-error" : "alert-success")" style="margin-top:0.75rem;">
                                @_actionStatusMessage
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (ShowContractForm())
    {
    @if (IsReviewerMode())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Approval Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="contract-approval-summary">
                            @BuildApprovalSummary()
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else if (HasReviewerNotes())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Reviewer Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <textarea class="form-input contract-notes" rows="4" readonly>@NormalizeNotesForDisplay(_contract?.contract_notes)</textarea>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (IsReviewerMode())
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Approval Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <textarea class="form-input contract-notes" rows="4" placeholder="Approval notes..." @bind="_approvalNotes"></textarea>
                            <input class="form-input" style="margin-top:0.5rem;" placeholder="Decline reason (required for decline actions)" @bind="_declineReason" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Vehicle Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                        <th>GG Number</th>
                                        <td>@PreferVehicleValue(_vehicle?.fleet_number, "ggnumber")</td>
                                        <th>Registration Number</th>
                                        <td>@PreferVehicleValue(_vehicle?.registration_number, "regnumber")</td>
                                    <th>Identification</th>
                                    <td rowspan="5" class="contract-photo-cell">
                                        <div class="contract-photo-box">Vehicle Photos</div>
                                    </td>
                                </tr>
                                <tr>
                                        <th>VIN / Chassis Number</th>
                                        <td>@ValueOrDash(_vehicle?.chassis_number)</td>
                                        <th>Engine Number</th>
                                        <td>@ValueOrDash(_vehicle?.engine_number_1)</td>
                                </tr>
                                <tr>
                                        <th>Make &amp; Model</th>
                                        <td>@ValueOrDash(_vehicle?.model_name)</td>
                                        <th>Year Manufactured</th>
                                        <td>@(_vehicle?.year_manufactured?.ToString() ?? "-")</td>
                                </tr>
                                <tr>
                                        <th>Colour</th>
                                        <td>@ValueOrDash(_vehicle?.colour)</td>
                                        <th>Depot Location</th>
                                        <td>@ValueOrDash(_vehicle?.location_description)</td>
                                </tr>
                                <tr>
                                        <th>Hire Type</th>
                                        <td>@ValueOrDash(_vehicle?.type_name ?? GetContractTypeLabel(GetResolvedContractTypeCode()))</td>
                                        <th>Hired From</th>
                                        <td>@ValueOrDash(_vehicle?.purchased_from)</td>
                                </tr>
                                <tr>
                                        <th>Status</th>
                                        <td>@ValueOrDash(_contract?.status ?? _vehicle?.status_description)</td>
                                        <th>Status Date</th>
                                        <td>@ValueOrDash(_contract?.end_date?.ToString("yyyy/MM/dd") ?? _vehicle?.vehicle_status_date?.ToString("yyyy/MM/dd"))</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (_closeMode)
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Close Contract and Return Vehicle Home</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <table class="contract-subtable">
                                <tbody>
                                    <tr>
                                        <th>GFleet Department</th>
                                        <td>
                                            <select class="form-select" @bind="_closeHomeDepartmentCode" @bind:after="OnCloseDepartmentChanged">
                                                <option value="">Select Department</option>
                                                @foreach (var department in HomeDepartmentOptions)
                                                {
                                                    <option value="@department.department_code">@DepartmentDisplay(department)</option>
                                                }
                                            </select>
                                        </td>
                                        <th>GFleet Site</th>
                                        <td>
                                            <select class="form-select" @bind="_closeHomeSiteCode" @bind:after="OnCloseSiteChanged">
                                                <option value="">Select Site</option>
                                                @foreach (var site in HomeSiteOptions)
                                                {
                                                    <option value="@site.SiteCode">@SiteDisplay(site)</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Custodian Driver</th>
                                        <td>
                                            <select class="form-select" @bind="_closeHomeDriverCode" @bind:after="OnCloseDriverChanged">
                                                <option value="">Select GFleet Driver</option>
                                                @foreach (var driver in HomeDriverOptions)
                                                {
                                                    <option value="@driver.site_driver_code">@DriverDisplay(driver)</option>
                                                }
                                            </select>
                                        </td>
                                        <th>Driver Licence</th>
                                        <td>@SelectedHomeDriverLicenceHint()</td>
                                    </tr>
                                    <tr>
                                        <th>Province Check</th>
                                        <td colspan="3">@BuildCloseProvinceGuidance()</td>
                                    </tr>
                                    <tr>
                                        <th>Close Date</th>
                                        <td>
                                            <input type="date" class="form-input" @bind-value="_closeEndDate" @bind-value:format="yyyy-MM-dd" />
                                        </td>
                                        <th>Close Odometer</th>
                                        <td>
                                            <input type="number" class="form-input" min="0" @bind="_closeEndOdometer" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Create Home Custody Contract</th>
                                        <td><input type="checkbox" @bind="_createHomeCustodyContract" /></td>
                                        <th>Selected Home</th>
                                        <td>@SelectedHomeSummary()</td>
                                    </tr>
                                    <tr>
                                        <th>Close Notes</th>
                                        <td colspan="3">
                                            <textarea class="form-input contract-notes" rows="3" @bind="_closeNotes"></textarea>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (_siteUpdateMode)
    {
        <div class="contract-section">
            <table class="contract-legacy-table">
                <thead>
                    <tr class="contract-legacy-heading">
                        <th colspan="4">Update Vehicle Site and Custodian</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <table class="contract-subtable">
                                <tbody>
                                    <tr>
                                        <th>Department</th>
                                        <td>
                                            <select class="form-select" @bind="_siteUpdateDepartmentCode" @bind:after="OnSiteUpdateDepartmentChanged">
                                                <option value="">Select Department</option>
                                                @foreach (var department in HomeDepartmentOptions)
                                                {
                                                    <option value="@department.department_code">@DepartmentDisplay(department)</option>
                                                }
                                            </select>
                                        </td>
                                        <th>Site</th>
                                        <td>
                                            <select class="form-select" @bind="_siteUpdateSiteCode" @bind:after="OnSiteUpdateSiteChanged">
                                                <option value="">Select Site</option>
                                                @foreach (var site in SiteUpdateSiteOptions)
                                                {
                                                    <option value="@site.SiteCode">@SiteDisplay(site)</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Custodian Driver</th>
                                        <td>
                                            <select class="form-select" @bind="_siteUpdateDriverCode" @bind:after="OnSiteUpdateDriverChanged">
                                                <option value="">Select Driver</option>
                                                @foreach (var driver in SiteUpdateDriverOptions)
                                                {
                                                    <option value="@driver.site_driver_code">@DriverDisplay(driver)</option>
                                                }
                                            </select>
                                        </td>
                                        <th>Create Home Custody Contract</th>
                                        <td><input type="checkbox" @bind="_siteUpdateCreateHomeContract" /></td>
                                    </tr>
                                    <tr>
                                        <th>Province Check</th>
                                        <td colspan="3">@BuildSiteUpdateProvinceGuidance()</td>
                                    </tr>
                                    <tr>
                                        <th>Notes</th>
                                        <td colspan="3">
                                            <textarea class="form-input contract-notes" rows="3" @bind="_siteUpdateNotes"></textarea>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Contract Readiness</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th rowspan="3">Contract Client<br /><span class="contract-muted">* Intended or current active contract</span></th>
                                        <th>Department</th>
                                        <td colspan="2">
                                            <select class="form-select" @bind="_selectedDepartmentCode" @bind:after="OnDepartmentChanged" disabled="@(!CanEditContractSite())">
                                                <option value="0">Select Department</option>
                                                @foreach (var department in _departments)
                                                {
                                                    <option value="@department.department_code">@DepartmentDisplay(department)</option>
                                                }
                                            </select>
                                        </td>
                                    <td rowspan="4" class="contract-tariff-cell">
                                        <table class="contract-subtable">
                                            <thead>
                                                <tr>
                                                    <th colspan="4">Tariff Detail</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <th>Tariff Type</th>
                                                    <td>@ValueOrDash(_tariffPreview?.Tariff == null ? "-" : "Class Tariff")</td>
                                                    <td colspan="2">
                                                        <input type="checkbox" checked="@(_tariffPreview?.Tariff != null)" disabled /> Active / Valid Tariff
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>Monthly Rate</th>
                                                    <th>Daily Rate</th>
                                                    <th>KM Rate</th>
                                                    <th>Excess KM Rate</th>
                                                </tr>
                                                <tr>
                                                    <td>@FormatCurrency(_tariffPreview?.Tariff?.MonthlyFixedAmount)</td>
                                                    <td>@FormatCurrency(_tariffPreview?.Tariff?.DailyFixedAmount)</td>
                                                    <td>@FormatCurrency(_tariffPreview?.Tariff?.MonthlyOdoAmount)</td>
                                                    <td>@FormatCurrency(_tariffPreview?.Tariff?.FuelKiloTariff)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                        <th>Site</th>
                                        <td colspan="2">
                                            <select class="form-select" @bind="_selectedSiteCode" @bind:after="OnSiteChanged" disabled="@(!CanEditContractSite())">
                                                <option value="0">Select Site</option>
                                                @foreach (var site in SelectableSites)
                                                {
                                                    <option value="@site.SiteCode">@SiteDisplay(site)</option>
                                                }
                                            </select>
                                        </td>
                                </tr>
                                <tr>
                                    <th colspan="2"></th>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Valid Financial System &amp; Codes
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Active Fuelcard <span class="contract-muted">(Fuel Card Number)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <input type="checkbox" /> Current Contract
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th>Vehicle Assessment Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="contract-inline-label">Sets of Keys</label>
                                        <select class="form-select contract-inline-select">
                                            <option>--</option>
                                            <option>1</option>
                                            <option>2</option>
                                            <option>3</option>
                                        </select>
                                    </td>
                                    <td><input type="checkbox" /> License Disc</td>
                                    <td><input type="checkbox" /> Wheel Spanner</td>
                                    <td><input type="checkbox" /> Jack</td>
                                    <td><input type="checkbox" /> Fuel Card (Card #)</td>
                                </tr>
                                <tr>
                                    <td><input type="checkbox" /> Wheel Lock Key</td>
                                    <td><input type="checkbox" /> COF Disc</td>
                                    <td><input type="checkbox" /> Spare Wheel</td>
                                    <td><input type="checkbox" /> Smash &amp; Grab</td>
                                    <td>
                                        <input type="checkbox" /> Logbook
                                        <input class="form-input contract-input-sm" placeholder="Start #" />
                                        <input class="form-input contract-input-sm" placeholder="End #" />
                                    </td>
                                </tr>
                                <tr>
                                    <td><input type="checkbox" /> Gear Lock</td>
                                    <td><input type="checkbox" /> Tracker</td>
                                    <td><input type="checkbox" /> Radio</td>
                                    <td><input type="checkbox" /> Fire Extinguisher</td>
                                    <td><input type="checkbox" /> Damages</td>
                                </tr>
                                <tr>
                                    <th>Notes</th>
                                    <td colspan="4">
                                        <textarea class="form-input contract-notes" rows="3" placeholder="Assessment notes..."></textarea>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="4">Client Details</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <table class="contract-subtable">
                            <tbody>
                                <tr>
                                    <th rowspan="3">Contract Client</th>
                                    <th>Department</th>
                                    <td colspan="3">
                                        <select class="form-select" @bind="_selectedDepartmentCode" @bind:after="OnDepartmentChanged" disabled="@(!CanEditContractSite())">
                                            <option value="0">Select Department</option>
                                            @foreach (var department in _departments)
                                            {
                                                <option value="@department.department_code">@DepartmentDisplay(department)</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Site</th>
                                    <td colspan="3">
                                        <select class="form-select" @bind="_selectedSiteCode" @bind:after="OnSiteChanged" disabled="@(!CanEditContractSite())">
                                            <option value="0">Select Site</option>
                                            @foreach (var site in SelectableSites)
                                            {
                                                <option value="@site.SiteCode">@SiteDisplay(site)</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <th colspan="4"></th>
                                </tr>
                                <tr>
                                    <th>Authoriser Name</th>
                                    <td colspan="2">
                                        <select class="form-select" @bind="_selectedAuthoriserCode" @bind:after="OnAuthoriserChanged" disabled="@(!CanEditContractSite())">
                                            <option value="">Select Authoriser</option>
                                            @foreach (var authoriser in AvailableAuthorisers)
                                            {
                                                <option value="@authoriser.UserAccessCode">@AuthoriserDisplay(authoriser)</option>
                                            }
                                        </select>
                                    </td>
                                    <th>Authorization</th>
                                    <td>
                                        <input class="form-input"
                                               value="@(_contract?.authorisation ?? string.Empty)"
                                               @onchange="OnAuthorisationChanged"
                                               readonly="@(!CanEditContractSite())" />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Driver Name</th>
                                    <td colspan="2">
                                        <select class="form-select" @bind="_selectedSiteDriverCode" @bind:after="OnDriverChanged" disabled="@(!CanEditContractSite())">
                                            <option value="">Select Driver</option>
                                            @foreach (var driver in AvailableSiteDrivers)
                                            {
                                                <option value="@driver.site_driver_code">@DriverDisplay(driver)</option>
                                            }
                                        </select>
                                    </td>
                                    <td colspan="2">
                                        <input type="checkbox" checked="@SelectedDriverHasValidLicence()" disabled /> Valid Driver's License <span class="contract-muted">(@SelectedDriverLicenceHint())</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Collected By Detail</th>
                                    <td colspan="4">
