@page "/contracts/relief-vehicle-search"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService

<PageTitle>Vehicle Contract Relief Vehicle Search</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-search"></i>
            Relief Vehicle Search
        </h1>
        <p class="page-description">Search for relief vehicles linked to contracts.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Contracts Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Relief Vehicle Search</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" placeholder="Enter GG number" @bind="_ggNumber" @bind:event="oninput" />
                </div>
                <div class="form-field">
                    <label class="form-label">Registration Number</label>
                    <input class="form-input" placeholder="Enter registration number" @bind="_registrationNumber" @bind:event="oninput" />
                </div>
            </div>
            <div style="margin-top: 1rem;">
                <button class="btn btn-primary btn-sm" @onclick="SearchVehicles" disabled="@_loading">Search</button>
                <button class="btn btn-secondary btn-sm" @onclick="ClearSearch" disabled="@_loading">Clear</button>
            </div>
        </div>
    </div>

    <div class="form-card" style="margin-top: 1rem;">
        <div class="form-card-header">
            <h2>Search Results</h2>
        </div>
        <div class="form-card-body">
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="loading-state">
                                            <div class="spinner"></div>
                                            <p>Loading...</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (_results.Count == 0)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <i class="bx bx-car"></i>
                                            <h3>No relief vehicles found</h3>
                                            <p>Search results will appear here.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vehicle in _results)
                                {
                                    <tr>
                                        <td>@vehicle.fleet_number</td>
                                        <td>@vehicle.registration_number</td>
                                        <td>@vehicle.type_name</td>
                                        <td>@vehicle.model_name</td>
                                        <td>@vehicle.status_description</td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm" href="@($"/contracts/detail?ggnumber={vehicle.fleet_number}&regnumber={vehicle.registration_number}")">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _ggNumber = "";
    private string _registrationNumber = "";
    private bool _loading;
    private List<VehicleDto> _results = new();

    private async Task SearchVehicles()
    {
        _loading = true;
        try
        {
            var query = string.IsNullOrWhiteSpace(_ggNumber) ? _registrationNumber : _ggNumber;
            if (string.IsNullOrWhiteSpace(query))
            {
                _results = new();
                return;
            }

            _results = await VehicleService.SearchVehiclesAsync(query.Trim());
        }
        catch
        {
            _results = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearSearch()
    {
        _ggNumber = "";
        _registrationNumber = "";
        _results = new();
    }
}
