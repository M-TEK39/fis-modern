@page "/contracts/relief-vehicle-search"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService

<PageTitle>Vehicle Contract Relief Vehicle Search</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-search"></i>
            Relief Vehicle Search
        </h1>
        <p class="page-description">Search for relief vehicles linked to contracts.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Contracts Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Relief Vehicle Search</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">
                        <input type="radio" name="reliefSearchType" checked="@(_searchMode == "gg")" @onchange='() => SetSearchMode("gg")' />
                        GG
                    </label>
                    <label class="form-label">
                        <input type="radio" name="reliefSearchType" checked="@(_searchMode == "gp")" @onchange='() => SetSearchMode("gp")' />
                        GP
                    </label>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_searchMode == "gg" ? "GG Number" : "Registration Number")</label>
                    <input class="form-input" placeholder="@(_searchMode == "gg" ? "Enter GG number" : "Enter registration number")" @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div style="margin-top: 1rem;">
                <button class="btn btn-primary btn-sm" @onclick="SearchVehicles" disabled="@_loading">Search</button>
                <button class="btn btn-secondary btn-sm" @onclick="ClearSearch" disabled="@_loading">Clear</button>
            </div>
        </div>
    </div>

    <div class="form-card" style="margin-top: 1rem;">
        <div class="form-card-header">
            <h2>Search Results</h2>
        </div>
        <div class="form-card-body">
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Make</th>
                                <th>Model</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="loading-state">
                                            <div class="spinner"></div>
                                            <p>Loading...</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (_results.Count == 0)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <i class="bx bx-car"></i>
                                            <h3>No relief vehicles found</h3>
                                            <p>Try another GG/GP search or adjust filters.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vehicle in PagedResults)
                                {
                                    <tr>
                                        <td>@ValueOrDash(vehicle.fleet_number)</td>
                                        <td>@ValueOrDash(vehicle.registration_number)</td>
                                        <td>@vehicle.type_name</td>
                                        <td>@vehicle.model_name</td>
                                        <td>@vehicle.status_description</td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm" href="@BuildContractDetailUrl(vehicle)">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    </div>
</div>

@code {
    private string _searchMode = "gg";
    private string _searchQuery = "";
    private bool _loading;
    private List<VehicleDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<VehicleDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private async Task SearchVehicles()
    {
        _loading = true;
        try
        {
            var query = _searchQuery;
            if (string.IsNullOrWhiteSpace(query))
            {
                _results = new();
                return;
            }

            var endpoint = $"api/contracts/relief/search?query={Uri.EscapeDataString(query.Trim())}";
            await ContractService.GetActionAsync(endpoint);

            _results = RankVehicleMatches(
                await VehicleService.SearchVehiclesAsync(query.Trim()),
                query.Trim(),
                _searchMode == "gg");
            _page = 1;
        }
        catch
        {
            _results = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _results = new();
        _page = 1;
    }

    private void SetSearchMode(string mode)
    {
        if (_searchMode == mode)
        {
            return;
        }

        _searchMode = mode;
        _searchQuery = string.Empty;
        _results = new();
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, bool preferFleet)
    {
        return (preferFleet
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                preferFleet
                    ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string BuildContractDetailUrl(VehicleDto vehicle)
    {
        var gg = Uri.EscapeDataString(vehicle.fleet_number ?? string.Empty);
        var reg = Uri.EscapeDataString(vehicle.registration_number ?? string.Empty);
        return $"/contracts/detail?ggnumber={gg}&regnumber={reg}";
    }
}
