@page "/contracts/backdating-history"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject DriverApiService DriverService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Contract History Backdating</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-history"></i>
            Vehicle Contract History Backdating Management
        </h1>
        <p class="page-description">Review historical backdating records by vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Contracts Menu</a>
        <button class="btn btn-secondary btn-sm" @onclick="GoTop">Top</button>
        <button class="btn btn-secondary btn-sm" @onclick="GoBottom">Bottom</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-banner contract-banner-warning">
        <i class="bx bx-error-circle"></i>
        <span>@_limitedAccessMessage</span>
    </div>
    <div class="contract-banner contract-banner-info">
        <i class="bx bx-info-circle"></i>
        <span>@_infoMessage</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(_apiStatusMessage))
    {
        <div class="alert @(_apiStatusError ? "alert-error" : "alert-success")" style="margin-bottom: 1rem;">
            @_apiStatusMessage
        </div>
    }

    <div class="contract-section">
        <table class="contract-legacy-table">
            <thead>
                <tr class="contract-legacy-heading">
                    <th colspan="2">Vehicle Contract History Backdating Management</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th>Select the vehicle to manage:</th>
                    <td>
                        <div class="contract-search-inputs">
                            <div class="contract-search-radio">
                                <label class="form-label">
                                    <input type="radio" name="searchType" value="GG" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                                    GG
                                </label>
                                <label class="form-label">
                                    <input type="radio" name="searchType" value="GP" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                                    GP Number
                                </label>
                            </div>
                            <input type="text"
                                   class="form-input"
                                   placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")"
                                   @bind="_searchQuery"
                                   @bind:event="oninput" />
                            <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicle" disabled="@_searching">
                                @if (_searching)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <span>Search</span>
                                }
                            </button>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearSearch" disabled="@_searching">Clear</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_searchError))
                        {
                            <div class="form-error contract-search-error">@_searchError</div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>GG Number / R:</th>
                    <td>@(_selectedVehicle?.fleet_number ?? "-")</td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <th>Registration Number:</th>
                    <td>@(_selectedVehicle?.registration_number ?? "-")</td>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td colspan="3">@_feedbackMessage</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="contract-section">
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Contract Code</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Start Odometer</th>
                            <th>End Odometer</th>
                            <th>Status</th>
                            <th>Department Number</th>
                            <th>Department</th>
                            <th>Site</th>
                            <th>Driver</th>
                            <th>Still Current</th>
                            <th>Capturer Lastname</th>
                            <th>Capturer Firstname</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_historyContracts.Count == 0)
                        {
                            <tr>
                                <td colspan="14">No Contract History Found</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var contract in _historyContracts)
                            {
                                <tr class="@GetHistoryRowClass(contract)">
                                    <td>@contract.contract_id</td>
                                    <td>@FormatDate(contract.start_date)</td>
                                    <td>@FormatDate(contract.end_date)</td>
                                    <td>@GetOdometerDisplay(_editStartOdometer, contract)</td>
                                    <td>@GetOdometerDisplay(_editEndOdometer, contract)</td>
                                    <td>@ValueOrDash(contract.status)</td>
                                    <td>@ValueOrDash(contract.Department?.department_number)</td>
                                    <td>@ValueOrDash(contract.Department?.department_description)</td>
                                    <td>@GetSiteName(contract)</td>
                                    <td>@ValueOrDash(GetDriverName(contract))</td>
                                    <td>@ValueOrDash(contract.status)</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>
                                        <button class="btn btn-secondary btn-sm" type="button" @onclick="() => SelectContractForEdit(contract)">View</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="contract-section contract-history-edit">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <td>Contract Code:</td>
                    <td><input class="form-input" value="@(_selectedHistoryContract?.contract_id.ToString() ?? string.Empty)" readonly /></td>
                </tr>
                <tr>
                    <td>Department:</td>
                    <td><input class="form-input" value="@(_selectedHistoryContract?.Department?.department_description ?? string.Empty)" readonly /></td>
                </tr>
                <tr>
                    <td>Site:</td>
                    <td><input class="form-input" value="@(_selectedHistoryContract == null ? string.Empty : GetSiteName(_selectedHistoryContract))" readonly /></td>
                </tr>
                <tr>
                    <td>Start Date:</td>
                    <td><input class="form-input" placeholder="yyyy/MM/dd" @bind="_editStartDate" disabled="@(_selectedHistoryContract == null)" /></td>
                </tr>
                <tr>
                    <td>End Date:</td>
                    <td><input class="form-input" placeholder="yyyy/MM/dd" @bind="_editEndDate" disabled="@(_selectedHistoryContract == null)" /></td>
                </tr>
                <tr>
                    <td>Start Odometer:</td>
                    <td><input type="number" class="form-input" @bind="_editStartOdometer" disabled="@(_selectedHistoryContract == null)" /></td>
                </tr>
                <tr>
                    <td>End Odometer:</td>
                    <td>
                        <input type="number" class="form-input" @bind="_editEndOdometer" disabled="@(_selectedHistoryContract == null)" />
                        <span class="contract-muted" style="margin-left: 0.5rem;">@(_selectedHistoryContract == null ? "Select a contract row to edit" : $"Selected Contract: {_selectedHistoryContract.contract_id}")</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button class="btn btn-primary btn-sm" type="button" @onclick="SubmitSelectedContractUpdate" disabled="@(_selectedHistoryContract == null || _submitting)">Submit</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<a id="PageBottom"></a>

@code {
    private string _limitedAccessMessage = "Limited access: some history actions may be restricted based on your role.";
    private string _infoMessage = "Search for a vehicle to view contract history backdating.";
    private string _feedbackMessage = "";

    private string _searchType = "GG";
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private VehicleDto? _selectedVehicle;
    private List<ContractDto> _historyContracts = new();
    private ContractDto? _selectedHistoryContract;
    private string _editStartDate = string.Empty;
    private string _editEndDate = string.Empty;
    private int? _editStartOdometer;
    private int? _editEndOdometer;
    private bool _submitting;
    private Dictionary<short, string> _siteNames = new();
    private List<DriverDto> _drivers = new();
    private bool _apiStatusError;
    private string _apiStatusMessage = string.Empty;

    private void GoTop() => Navigation.NavigateTo("/contracts/backdating-history#PageTop");
    private void GoBottom() => Navigation.NavigateTo("/contracts/backdating-history#PageBottom");

    private void SetSearchType(string type)
    {
        _searchType = type;
        _searchError = null;
    }

    private async Task SearchVehicle()
    {
        _searchError = null;
        _selectedVehicle = null;
        _feedbackMessage = "";
        _historyContracts = new();
        _selectedHistoryContract = null;

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchError = _searchType == "GG" ? "Enter a GG number to search." : "Enter a GP number to search.";
            return;
        }

        _searching = true;
        try
        {
            var results = await VehicleService.SearchVehiclesAsync(_searchQuery.Trim());
            _selectedVehicle = results.FirstOrDefault();
            if (_selectedVehicle == null)
            {
                _searchError = "No vehicles matched the search criteria.";
                return;
            }

            await LoadContractHistory();
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchError = null;
        _selectedVehicle = null;
        _feedbackMessage = "";
        _historyContracts = new();
        _selectedHistoryContract = null;
    }

    private async Task LoadContractHistory()
    {
        if (_selectedVehicle?.vmf_code == null)
        {
            return;
        }

        var apiResult = await ContractService.GetActionAsync($"api/contracts/backdating/history/{_selectedVehicle.vmf_code}");
        _apiStatusError = !apiResult.Success;
        _apiStatusMessage = $"{apiResult.Message} Endpoint: {apiResult.Endpoint}";

        var contracts = await ContractService.GetContractsAsync();
        _historyContracts = contracts
            .Where(c => c.vmf_code == _selectedVehicle.vmf_code)
            .OrderByDescending(c => c.start_date)
            .ToList();

        await HydrateHistoryContractsAsync();

        if (_historyContracts.Count > 0)
        {
            SelectContractForEdit(_historyContracts[0]);
        }
        else
        {
            _feedbackMessage = "No Contract History Found";
            _selectedHistoryContract = null;
        }
    }

    private async Task HydrateHistoryContractsAsync()
    {
        if (_historyContracts.Count == 0)
        {
            return;
        }

        if (_siteNames.Count == 0)
        {
            var sites = await SiteService.GetAllAsync();
            _siteNames = sites.ToDictionary(s => s.SiteCode, s => s.Description ?? s.SiteCode.ToString());
        }

        if (_drivers.Count == 0)
        {
            _drivers = await DriverService.GetDriversAsync();
        }

        foreach (var contract in _historyContracts)
        {
            if (contract.vmf_code.HasValue && contract.Vehicle == null)
            {
                contract.Vehicle = await VehicleService.GetVehicleAsync(contract.vmf_code.Value);
            }

            if (contract.site_code.HasValue && contract.Department == null)
            {
                var site = await SiteService.GetByIdAsync(contract.site_code.Value);
                if (site?.DepartmentCode != null)
                {
                    contract.Department = await DepartmentService.GetDepartmentAsync(site.DepartmentCode.Value);
                }
            }
        }
    }

    private string GetSiteName(ContractDto contract)
        => ValueOrDash(_siteNames.TryGetValue(contract.site_code ?? 0, out var name) ? name : contract.site_code?.ToString());

    private string GetDriverName(ContractDto contract)
    {
        if (_drivers.Count == 0 || contract.contractor_name == null)
        {
            return "-";
        }

        if (!int.TryParse(contract.contractor_name, out var driverCode))
        {
            return contract.contractor_name;
        }

        var driver = _drivers.FirstOrDefault(d => d.site_driver_code == driverCode);
        if (driver == null)
        {
            return contract.contractor_name;
        }

        return $"{driver.driver_firstname} {driver.driver_surname}".Trim();
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    }

    private static string FormatDateForInput(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
    }

    private void SelectContractForEdit(ContractDto contract)
    {
        _selectedHistoryContract = contract;
        _editStartDate = FormatDateForInput(contract.start_date);
        _editEndDate = FormatDateForInput(contract.end_date);
        _editStartOdometer = null;
        _editEndOdometer = null;
        _feedbackMessage = $"Loaded contract {contract.contract_id} for update.";
    }

    private async Task SubmitSelectedContractUpdate()
    {
        if (_selectedHistoryContract == null)
        {
            _feedbackMessage = "Select a contract first.";
            return;
        }

        if (!TryParseInputDate(_editStartDate, out var startDate))
        {
            _feedbackMessage = "Start date is required.";
            return;
        }

        DateTime? endDate = null;
        if (!string.IsNullOrWhiteSpace(_editEndDate))
        {
            if (!TryParseInputDate(_editEndDate, out var parsedEndDate))
            {
                _feedbackMessage = "End date is invalid.";
                return;
            }

            endDate = parsedEndDate;
        }

        _submitting = true;
        try
        {
            var payload = new ContractUpdateDto
            {
                contract_number = _selectedHistoryContract.contract_number,
                vehicle_registration = _selectedHistoryContract.vehicle_registration,
                department_code = _selectedHistoryContract.department_code,
                contractor_name = _selectedHistoryContract.contractor_name,
                start_date = startDate,
                end_date = endDate,
                monthly_cost = _selectedHistoryContract.monthly_cost,
                status = _selectedHistoryContract.status,
                contract_notes = _selectedHistoryContract.contract_notes
            };

            var updated = await ContractService.UpdateContractAsync(_selectedHistoryContract.contract_id, payload);
            _selectedHistoryContract.start_date = updated.start_date;
            _selectedHistoryContract.end_date = updated.end_date;
            _selectedHistoryContract.contract_notes = updated.contract_notes;
            _feedbackMessage = $"Contract {_selectedHistoryContract.contract_id} updated successfully.";
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Failed to update contract {_selectedHistoryContract.contract_id}.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _submitting = false;
        }
    }

    private static bool TryParseInputDate(string value, out DateTime parsedDate)
    {
        return DateTime.TryParse(value, out parsedDate);
    }

    private string GetHistoryRowClass(ContractDto contract)
    {
        return _selectedHistoryContract?.contract_id == contract.contract_id ? "contract-selected-row" : string.Empty;
    }

    private string GetOdometerDisplay(int? editedValue, ContractDto contract)
    {
        if (_selectedHistoryContract?.contract_id == contract.contract_id && editedValue.HasValue)
        {
            return editedValue.Value.ToString();
        }

        return "-";
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
