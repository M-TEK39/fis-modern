@page "/contracts/print-menu"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ContractApiService ContractService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Contract Print Out Menu</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-printer"></i>
            Contract Print Out Menu
        </h1>
        <p class="page-description">Search contracts and print or download a client-facing copy.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/contracts">Contracts Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Search Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="contractPrintSearchType" checked="@(_searchMode == "Contract")" @onchange='() => SetSearchMode("Contract")' />
                            Contract #
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="contractPrintSearchType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="contractPrintSearchType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Search Value</label>
                    <input class="form-input" @bind="_searchValue" placeholder="@GetSearchPlaceholder()" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_loading">Search</button>
                <button class="btn btn-secondary" @onclick="LoadRecentAsync" disabled="@_loading">Load Recent</button>
                <button class="btn btn-secondary" @onclick="ClearAsync" disabled="@_loading">Clear</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success") fis-mt-10">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading contracts...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No contracts to print</h3>
            <p>Search by contract number, GG, or GP.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Contract Print Results</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Contract #</th>
                            <th>Fleet/GG</th>
                            <th>Registration</th>
                            <th>Status</th>
                            <th>Current</th>
                            <th>Start Date</th>
                            <th>Target Return</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in PagedResults)
                        {
                            <tr>
                                <td>@contract.contract_id</td>
                                <td>@ValueOrDash(contract.fleet_number)</td>
                                <td>@ValueOrDash(contract.vehicle_registration)</td>
                                <td>@ValueOrDash(GetStatusLabel(contract))</td>
                                <td>@ValueOrDash(contract.still_current)</td>
                                <td>@FormatDate(contract.start_date)</td>
                                <td>@FormatDate(contract.target_return_date)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn btn-secondary btn-sm" href="@GetPrintoutUrl(contract.contract_id)" target="_blank">Preview</a>
                                        <a class="btn btn-secondary btn-sm" href="@GetAutoPrintUrl(contract.contract_id)" target="_blank">Print</a>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => DownloadAsync(contract.contract_id)">Download</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _isError;
    private string _message = string.Empty;
    private string _searchMode = "Contract";
    private string _searchValue = string.Empty;
    private List<ContractDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<ContractDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        _loading = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var page = await ContractService.GetContractsPageAsync(new ContractsPageQuery
            {
                Page = 1,
                PageSize = 120
            });
            _results = page.Data
                .OrderByDescending(c => c.contract_id)
                .ToList();
            _page = 1;
            _message = $"Loaded {_results.Count} contract(s).";
        }
        catch (Exception ex)
        {
            _results = new();
            _isError = true;
            _message = "Unable to load contracts.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading recent contracts for print menu: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var value = (_searchValue ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(value))
            {
                await LoadRecentAsync();
                return;
            }

            var matches = new List<ContractDto>();
            if (_searchMode == "Contract")
            {
                if (!int.TryParse(value, out var contractId) || contractId <= 0)
                {
                    _isError = true;
                    _message = "Enter a valid contract number.";
                    _results = new();
                    return;
                }

                var contract = await ContractService.GetContractAsync(contractId);
                if (contract != null)
                {
                    matches.Add(contract);
                }
            }
            else
            {
                var vehicles = await VehicleService.SearchVehiclesAsync(value);
                var filteredVehicles = _searchMode == "GG"
                    ? vehicles.Where(v => string.Equals(v.fleet_number?.Trim(), value, StringComparison.OrdinalIgnoreCase)).ToList()
                    : vehicles.Where(v => string.Equals(v.registration_number?.Trim(), value, StringComparison.OrdinalIgnoreCase)).ToList();

                if (filteredVehicles.Count == 0)
                {
                    filteredVehicles = _searchMode == "GG"
                        ? vehicles.Where(v => (v.fleet_number ?? string.Empty).Contains(value, StringComparison.OrdinalIgnoreCase)).ToList()
                        : vehicles.Where(v => (v.registration_number ?? string.Empty).Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
                }

                foreach (var vehicle in filteredVehicles.Take(50))
                {
                    var contract = await ContractService.GetLatestContractForVehicleAsync(vehicle.vmf_code);
                    if (contract != null)
                    {
                        if (string.IsNullOrWhiteSpace(contract.fleet_number))
                        {
                            contract.fleet_number = vehicle.fleet_number;
                        }

                        if (string.IsNullOrWhiteSpace(contract.vehicle_registration))
                        {
                            contract.vehicle_registration = vehicle.registration_number ?? string.Empty;
                        }

                        matches.Add(contract);
                    }
                }
            }

            _results = matches
                .GroupBy(c => c.contract_id)
                .Select(g => g.First())
                .OrderByDescending(c => c.contract_id)
                .ToList();
            _page = 1;

            if (_results.Count == 0)
            {
                _isError = true;
                _message = "No matching contracts found.";
            }
            else
            {
                _message = $"Found {_results.Count} contract(s).";
            }
        }
        catch (Exception ex)
        {
            _results = new();
            _isError = true;
            _message = "Unable to search contracts.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Contract print menu search failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ClearAsync()
    {
        _searchMode = "Contract";
        _searchValue = string.Empty;
        _results = new();
        _message = string.Empty;
        _isError = false;
        _page = 1;
        return Task.CompletedTask;
    }

    private async Task DownloadAsync(int contractId)
    {
        if (contractId <= 0)
        {
            return;
        }

        var printout = await ContractService.GetContractPrintoutAsync(contractId);
        if (printout?.Contract == null)
        {
            _isError = true;
            _message = $"Unable to download contract {contractId}.";
            return;
        }

        var fileName = $"Contract_{contractId}_{DateTime.Now:yyyyMMdd_HHmm}.txt";
        var content = BuildDownloadText(printout);
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, content, "text/plain;charset=utf-8");
        _isError = false;
        _message = "Request completed successfully.";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _message = string.Empty;
        _isError = false;
    }

    private string GetSearchPlaceholder()
        => _searchMode switch
        {
            "GG" => "Enter GG number",
            "GP" => "Enter GP number",
            _ => "Enter contract number"
        };

    private static string GetStatusLabel(ContractDto contract)
        => contract.contract_status_code switch
        {
            0 => "Draft",
            1 => "Pending Review",
            2 => "Approved",
            3 => "Active",
            4 => "Declined for Correction",
            5 => "Declined",
            6 => "Cancelled",
            7 => "Closed",
            _ => ValueOrDash(contract.status)
        };

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? date)
        => date.HasValue ? date.Value.ToString("yyyy-MM-dd") : "-";

    private static string FormatDate(DateTime date)
        => date.ToString("yyyy-MM-dd");

    private static string GetPrintoutUrl(int contractId)
        => $"/contracts/printout?contractId={contractId}";

    private static string GetAutoPrintUrl(int contractId)
        => $"/contracts/printout?contractId={contractId}&autoprint=1";

    private static string BuildDownloadText(ContractPrintoutDto printout)
    {
        var lines = new List<string>
        {
            $"Document: {ValueOrDash(printout.DocumentTitle)}",
            $"Printed At: {ValueOrDash(printout.PrintedAt?.ToString("yyyy-MM-dd HH:mm"))}",
            string.Empty,
            "CONTRACT",
            $"Contract #: {printout.Contract?.ContractCode}",
            $"Status: {ValueOrDash(printout.Contract?.StatusText)}",
            $"Still Current: {ValueOrDash(printout.Contract?.StillCurrent)}",
            $"Start Date: {ValueOrDash(printout.Contract?.StartDate)}",
            $"End Date: {ValueOrDash(printout.Contract?.EndDate)}",
            $"Target Return Date: {ValueOrDash(printout.Contract?.TargetReturnDate)}",
            $"Driver ID: {ValueOrDash(printout.Contract?.DriverId)}",
            $"Notes: {ValueOrDash(printout.Contract?.Notes)}",
            string.Empty,
            "VEHICLE",
            $"Fleet/GG: {ValueOrDash(printout.Vehicle?.FleetNumber)}",
            $"Registration: {ValueOrDash(printout.Vehicle?.RegistrationNumber)}",
            $"Vehicle ID: {ValueOrDash(printout.Vehicle?.VmfCode?.ToString())}",
            string.Empty,
            "SITE",
            $"Site: {ValueOrDash(printout.Site?.Description)}",
            $"Responsible: {ValueOrDash(printout.Site?.ResponsiblePerson)}",
            $"Telephone: {ValueOrDash(printout.Site?.Telephone)}",
            string.Empty,
            "AUDIT TRAIL"
        };

        if (printout.AuditTrail == null || printout.AuditTrail.Count == 0)
        {
            lines.Add("No audit entries.");
            return string.Join(Environment.NewLine, lines);
        }

        foreach (var item in printout.AuditTrail)
        {
            lines.Add(
                $"{ValueOrDash(item.PerformedAt)} | {ValueOrDash(item.Action)} | User {ValueOrDash(item.PerformedByUserCode?.ToString())} | {ValueOrDash(item.OldStatus)} -> {ValueOrDash(item.NewStatus)} | {ValueOrDash(item.Notes)}");
        }

        return string.Join(Environment.NewLine, lines);
    }
}
