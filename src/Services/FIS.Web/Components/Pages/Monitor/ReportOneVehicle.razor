@page "/monitor/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Inquiry Report on ONE Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Inquiry Report on ONE Vehicle
        </h1>
        <p class="page-description">Single-vehicle inquiry reporting workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "ENGINE")" @onchange='() => SetSearchMode("ENGINE")' />
                    Engine
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "VIN")" @onchange='() => SetSearchMode("VIN")' />
                    VIN / Chassis
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "INVOICE")" @onchange='() => SetSearchMode("INVOICE")' />
                    Invoice
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@VehicleSearchHelper.GetSearchLabel(_searchMode)</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="SearchVehiclesAsync">Find</button>
            <button class="btn btn-primary" @onclick="LoadInquiries" disabled="@(!_selectedVmfCode.HasValue)">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No inquiries found</h3>
            <p>Search by GG, GP, engine, VIN/chassis, or invoice number.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Inquiry Type</th>
                            <th>Capture Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.monitor_code</td>
                                <td>@item.Inquiry_type</td>
                                <td>@FormatDate(item.Capture_dat)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<MonitorDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<MonitorDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private async Task SearchVehiclesAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            _results = new();
            return;
        }

        _loading = true;
        try
        {
            var searchTerm = _searchTerm.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = VehicleSearchHelper.RankVehicleLookupMatches(matches, searchTerm, _searchMode);
            _results = new();
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInquiries()
    {
        if (!_selectedVmfCode.HasValue)
        {
            _results = new();
            return;
        }

        _loading = true;
        _results = new List<MonitorDto>();
        try
        {
            var all = await MonitorService.GetAllAsync<MonitorDto>();
            _results = all.Where(m => m.vmf_code == _selectedVmfCode.Value).ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _results = new();
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
