@page "/monitor/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Inquiry Report on ONE Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Inquiry Report on ONE Vehicle
        </h1>
        <p class="page-description">Legacy placeholder for Monitor/RPT_Mon_one_gg_main.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">GG / Reg Number</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadInquiries">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No inquiries found</h3>
            <p>Search by GG or registration number.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Inquiry Type</th>
                            <th>Capture Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.monitor_code</td>
                                <td>@item.Inquiry_type</td>
                                <td>@FormatDate(item.Capture_dat)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string _searchTerm = string.Empty;
    private List<MonitorDto> _results = new();

    private async Task LoadInquiries()
    {
        _loading = true;
        _results = new List<MonitorDto>();
        try
        {
            var matches = await VehicleLookupService.SearchAsync(_searchTerm);
            var vmfCode = matches.FirstOrDefault()?.VmfCode;
            if (vmfCode.HasValue)
            {
                var all = await MonitorService.GetAllAsync<MonitorDto>();
                _results = all.Where(m => m.vmf_code == vmfCode.Value).ToList();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
}
