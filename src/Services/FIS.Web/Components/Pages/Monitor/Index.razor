@page "/monitor"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject IJSRuntime JSRuntime

<PageTitle>Monitor Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-line-chart"></i>
            Monitor Maintenance Menu
        </h1>
        <p class="page-description">Monitor inquiry menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>INQUIRY Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/capture">1) Capture a New Inquiry</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/edit">2) Edit / Update an Existing Inquiry</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports">3) Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Monitor Inquiry Preview"
                      SearchPlaceholder="Search inquiry type, driver, description, GG code..."
                      EmptyMessage="No monitor inquiries match the current search or filter."
                      EmptyIcon="bx bx-line-chart"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("captureDate", "Capture Date"),
        new("vmfCode", "GG Code"),
        new("type", "Inquiry Type"),
        new("driver", "Driver"),
        new("site", "Site"),
        new("description", "Description")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Vehicle-linked inquiries", "vehicleStatus", "Vehicle Linked"),
        new("Driver-linked inquiries", "driverStatus", "Driver Linked"),
        new("Unassigned vehicle inquiries", "vehicleStatus", "No Vehicle")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var inquiries = await MonitorService.GetAllAsync<MonitorDto>();
            _rows = inquiries
                .OrderByDescending(item => item.Capture_dat ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["captureDate"] = FormatDate(item.Capture_dat),
                    ["vmfCode"] = item.vmf_code?.ToString(),
                    ["type"] = item.Inquiry_type,
                    ["driver"] = item.Driver_name,
                    ["site"] = item.Driver_Site?.ToString(),
                    ["description"] = item.Inquiry_Desc,
                    ["vehicleStatus"] = item.vmf_code.HasValue ? "Vehicle Linked" : "No Vehicle",
                    ["driverStatus"] = string.IsNullOrWhiteSpace(item.Driver_name) ? "No Driver" : "Driver Linked"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading monitor preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
