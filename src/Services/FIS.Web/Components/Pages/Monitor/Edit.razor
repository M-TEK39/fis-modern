@page "/monitor/edit"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject SiteApiService SiteService
@inject DriverApiService DriverService
@inject IJSRuntime JSRuntime

<PageTitle>Edit / Update an Existing Inquiry - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit-alt"></i>
            Edit / Update an Existing Inquiry
        </h1>
        <p class="page-description">Monitor inquiry edit workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Reference Number</label>
            <input class="form-input" @bind="_referenceNumber" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadInquiry">Submit</button>
            <a class="btn btn-secondary" href="/monitor">Menu</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }

    @if (_showForm && _editing != null)
    {
        <div class="form-card">
            <div class="form-row">
                <label class="form-label">Capture Date</label>
                <input type="date" class="form-input" @bind="_editing.Capture_dat" />
            </div>
            <div class="form-row">
                <label class="form-label">Inquiry Type</label>
                <select class="form-select" @bind="_editing.Inquiry_type">
                    @foreach (var option in _inquiryTypes)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Inquiry Description</label>
                <input class="form-input" @bind="_editing.Inquiry_Desc" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver</label>
                <select class="form-select" @bind="_selectedDriverCode" @bind:after="OnDriverChangedAsync">
                    <option value="">Select driver...</option>
                    @foreach (var driver in _drivers)
                    {
                        <option value="@driver.site_driver_code">@DriverOptionLabel(driver)</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Driver Name</label>
                <input class="form-input" @bind="_editing.Driver_name" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver Persal No</label>
                <input class="form-input" @bind="_editing.Driver_persalno" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver Site</label>
                <select class="form-select" @bind="_editing.Driver_Site">
                    <option value="">Select site</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveInquiry">Submit</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showForm;
    private string _referenceNumber = string.Empty;
    private MonitorDto? _editing;
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();
    private int? _selectedDriverCode;
    private readonly List<string> _inquiryTypes = new()
    {
        "Fuel_Consumption",
        "Fuel_overfill",
        "NoFuel_6months",
        "Oil_Consumption",
        "Tyre_Usage",
        "Card_Dormant",
        "NoMaintain_2000lt"
    };

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();
    }

    private async Task LoadInquiry()
    {
        _loading = true;
        try
        {
            if (short.TryParse(_referenceNumber, out var code))
            {
                _editing = await MonitorService.GetByIdAsync<MonitorDto>(code);
                if (_editing != null && !_inquiryTypes.Contains(_editing.Inquiry_type ?? string.Empty, StringComparer.OrdinalIgnoreCase))
                {
                    _editing.Inquiry_type = _inquiryTypes.FirstOrDefault() ?? string.Empty;
                }
                _showForm = _editing != null;
                if (_editing?.Driver_persalno != null)
                {
                    var matched = _drivers.FirstOrDefault(d => d.driver_persalnumber == _editing.Driver_persalno);
                    _selectedDriverCode = matched?.site_driver_code;
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveInquiry()
    {
        if (_editing == null)
        {
            return;
        }

        _loading = true;
        try
        {
            await MonitorService.UpdateAsync(_editing.monitor_code, _editing);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnDriverChangedAsync()
    {
        if (_editing == null || !_selectedDriverCode.HasValue)
        {
            return Task.CompletedTask;
        }

        var selected = _drivers.FirstOrDefault(d => d.site_driver_code == _selectedDriverCode.Value);
        if (selected == null)
        {
            return Task.CompletedTask;
        }

        _editing.Driver_name = $"{selected.driver_firstname} {selected.driver_surname}".Trim();
        _editing.Driver_persalno = selected.driver_persalnumber;
        _editing.Driver_Site = (short?)selected.site_code;
        return Task.CompletedTask;
    }

    private static string DriverOptionLabel(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code})";
    }
}
