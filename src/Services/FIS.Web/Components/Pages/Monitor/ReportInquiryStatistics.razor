@page "/monitor/reports/inquiry-statistics"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject IJSRuntime JSRuntime

<PageTitle>Inquiry Statistics - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-alt-2"></i>
            Inquiry Statistics
        </h1>
        <p class="page-description">Legacy placeholder for Monitor/RPT_mon_stat_captur_main.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadStats">Load Statistics</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_stats.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-bar-chart-alt-2"></i>
            <h3>No statistics available</h3>
            <p>Load statistics to view inquiry counts.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Inquiry Type</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _stats)
                        {
                            <tr>
                                <td>@item.Key</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private Dictionary<string, int> _stats = new();

    private async Task LoadStats()
    {
        _loading = true;
        _stats = new Dictionary<string, int>();
        try
        {
            var all = await MonitorService.GetAllAsync<MonitorDto>();
            _stats = all.GroupBy(m => string.IsNullOrWhiteSpace(m.Inquiry_type) ? "(Unknown)" : m.Inquiry_type)
                .ToDictionary(g => g.Key, g => g.Count());
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
