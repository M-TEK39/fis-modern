@page "/monitor/reports/inquiry-statistics"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MonitorApiService MonitorService
@inject IJSRuntime JSRuntime

<PageTitle>Inquiry Statistics - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-alt-2"></i>
            Inquiry Statistics
        </h1>
        <p class="page-description">Inquiry statistics reporting workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">From Date</label>
            <input type="date" class="form-input" @bind="_fromDate" />
        </div>
        <div class="form-row">
            <label class="form-label">To Date</label>
            <input type="date" class="form-input" @bind="_toDate" />
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadStats" disabled="_loading">Load Statistics</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_stats.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-bar-chart-alt-2"></i>
            <h3>No statistics available</h3>
            <p>Load statistics to view inquiry counts.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Inquiry Type</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedStats)
                        {
                            <tr>
                                <td>@item.InquiryType</td>
                                <td>@item.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_stats.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_stats.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private List<MonitorStatisticItemDto> _stats = new();
    private DateTime _fromDate = DateTime.Today.AddDays(-30);
    private DateTime _toDate = DateTime.Today;
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<MonitorStatisticItemDto> PagedStats
        => _stats.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_stats.Count / (double)_pageSize));

    private async Task LoadStats()
    {
        _loading = true;
        _stats = new List<MonitorStatisticItemDto>();
        try
        {
            if (_toDate.Date < _fromDate.Date)
            {
                await JSRuntime.InvokeVoidAsync("console.error", "End date cannot be before start date.");
                return;
            }

            var report = await MonitorService.GetInquiryStatisticsAsync(new MonitorStatsRequestDto
            {
                StartDate = _fromDate.Date,
                EndDate = _toDate.Date
            });

            _stats = report.Data
                .OrderByDescending(item => item.Count)
                .ThenBy(item => item.InquiryType, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
