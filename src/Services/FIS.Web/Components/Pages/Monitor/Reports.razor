@page "/monitor/reports"
@rendermode InteractiveServer

<PageTitle>Monitor Inquiry Reports Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Monitor Inquiry Reports Menu
        </h1>
        <p class="page-description">Reports menu for monitor inquiries.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>One INQUIRY Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/one-reference-number">1) Inquiry Report on ONE Reference Number</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/one-vehicle">2) Inquiry Report on ONE Vehicle</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/reprint">3) Reprint an Inquiry Report</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Other Inquiry Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/dept-site-period">4) Inquiry Info, for a Dept / Site, for a period</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/clo-inquiry">5) Client Liaison Officer (CLO) Inquiry Report</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor/reports/inquiry-statistics">6) Inquiry Statistics</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/monitor">Return To Main Page</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

</div>
