@page "/call-centre/reports/clo-report"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject SiteApiService SiteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Client Liaison Officer Report - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            CALL CENTRE Client Relations Officer's REPORT
        </h1>
        <p class="page-description">CLO report by period and site.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Begin Date</th>
                    <td><input class="form-input" style="max-width: 12rem;" placeholder="e.g. 2002/03/01" @bind="_beginDateText" /></td>
                </tr>
                <tr>
                    <th>End Date</th>
                    <td><input class="form-input" style="max-width: 12rem;" placeholder="e.g. 2002/03/31" @bind="_endDateText" /></td>
                </tr>
                <tr>
                    <th>Site</th>
                    <td>
                        <select class="form-select" style="max-width: 24rem;" @bind="_siteCode">
                            <option value="">All Sites</option>
                            @foreach (var site in _sites.OrderBy(s => s.Description))
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">Submit</button>
                        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Report Menu</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading...</p></div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-id-card"></i><h3>No records found</h3><p>Update criteria and submit.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_results.Count CLO record(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference Number</th>
                            <th>Call Date</th>
                            <th>Capture Name</th>
                            <th>Driver Site</th>
                            <th>GG Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@ValueOrDash(item.Capture_name)</td>
                                <td>@GetSiteText(item.Driver_Site)</td>
                                <td>@ValueOrDash(item.GG_number)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _beginDateText = string.Empty;
    private string _endDateText = DateTime.Today.ToString("yyyy/MM/dd");
    private short? _siteCode;
    private List<SiteResponseDto> _sites = new();
    private List<CallCentreDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<CallCentreDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _results = new();

        if (!TryParseDate(_beginDateText, out var beginDate))
        {
            _message = "Begin Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        if (!TryParseDate(_endDateText, out var endDate))
        {
            _message = "End Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            var all = await CallCentreService.GetAllAsync<CallCentreDto>();
            var query = all.Where(c => c.Call_date.HasValue && c.Call_date.Value.Date >= beginDate.Date && c.Call_date.Value.Date <= endDate.Date);

            if (_siteCode.HasValue)
            {
                query = query.Where(c => c.Driver_Site == _siteCode.Value);
            }

            _results = query.OrderByDescending(c => c.Call_date).ThenByDescending(c => c.Call_centre_code).ToList();
            _page = 1;
            _message = $"Loaded {_results.Count} CLO record(s).";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = "Failed to load CLO report.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool TryParseDate(string? value, out DateTime parsedDate)
    {
        parsedDate = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim().Replace("-", "/");
        return DateTime.TryParse(normalized, out parsedDate);
    }

    private static string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string GetSiteText(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? siteCode.Value.ToString() : $"{site.DepartmentNumber} - {site.Description}";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
