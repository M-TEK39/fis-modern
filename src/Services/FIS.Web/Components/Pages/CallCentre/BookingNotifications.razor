@page "/call-centre/bookings/notifications"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Notification e-mail Addresses - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-envelope"></i>
            Notification e-mail Addresses
        </h1>
        <p class="page-description">Legacy placeholder for CallCentre/Bookings/Reg_email.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-envelope"></i>
        <h3>Booking notifications pending</h3>
        <p>This page will mirror the legacy booking notification list.</p>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/Bookings/Reg_email.aspx"
        Endpoint="api/booking/notifications"
        HttpMethod="GET"
        ButtonText="Test Booking Notification Endpoint"
        ReportType="booking-notification-list" />
</div>
