@page "/call-centre/reports/dept-site-period"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject SiteApiService SiteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Call Centre Report by Dept/Site - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-buildings"></i>
            Call Centre Report for a Dept (Site)
        </h1>
        <p class="page-description">Report criteria for site and period.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/call-centre/reports">Report Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Site: List by</th>
                    <td>
                        <label class="form-label mr-1">
                            <input type="radio" name="site-sort" checked="@(_siteSort == "name")" @onchange='() => SetSiteSort("name")' />
                            Name
                        </label>
                        <label class="form-label">
                            <input type="radio" name="site-sort" checked="@(_siteSort == "code")" @onchange='() => SetSiteSort("code")' />
                            Code
                        </label>
                    </td>
                </tr>
                <tr>
                    <th>Site</th>
                    <td>
                        <select class="form-select maxw-select-2xl" @bind="_siteCode">
                            <option value="">Select site</option>
                            @foreach (var site in SortedSites)
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <th>Begin Date</th>
                    <td>
                        <input class="form-input maxw-input-xl" placeholder="e.g. 2002/03/01" @bind="_fromDateText" />
                    </td>
                </tr>
                <tr>
                    <th>End Date</th>
                    <td>
                        <input class="form-input maxw-input-xl" placeholder="e.g. 2002/03/31" @bind="_toDateText" />
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button class="btn btn-primary btn-sm" type="button" @onclick="LoadReport" disabled="@_loading">Submit</button>
                        <button class="btn btn-secondary btn-sm" type="button" @onclick="GoReportMenu" disabled="@_loading">Report Menu</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_reportLoaded && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No records found</h3>
            <p>No call centre records matched the selected site and date range.</p>
        </div>
    }
    else if (_results.Count > 0)
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_results.Count record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Call Date</th>
                            <th>Call Time</th>
                            <th>Caller</th>
                            <th>Driver</th>
                            <th>GG Number</th>
                            <th>Site</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@FormatTime(item.Call_time)</td>
                                <td>@ValueOrDash(item.Caller_name)</td>
                                <td>@ValueOrDash(item.Driver_name)</td>
                                <td>@ValueOrDash(item.GG_number)</td>
                                <td>@GetSiteText(item.Driver_Site)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _reportLoaded;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _siteSort = "code";
    private short? _siteCode;
    private string _fromDateText = string.Empty;
    private string _toDateText = string.Empty;
    private List<SiteResponseDto> _sites = new();
    private List<CallCentreDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<CallCentreDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private IEnumerable<SiteResponseDto> SortedSites =>
        _siteSort == "name"
            ? _sites.OrderBy(s => s.Description)
            : _sites.OrderBy(s => s.DepartmentNumber).ThenBy(s => s.Description);

    private void SetSiteSort(string sort) => _siteSort = sort;

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _messageIsError = false;
        _reportLoaded = false;
        _results = new();

        if (!_siteCode.HasValue)
        {
            _message = "Select a site before submitting.";
            _messageIsError = true;
            return;
        }

        if (!TryParseLegacyDate(_fromDateText, out var fromDate))
        {
            _message = "Begin date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        if (!TryParseLegacyDate(_toDateText, out var toDate))
        {
            _message = "End date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            var all = await CallCentreService.GetAllAsync<CallCentreDto>();
            _results = all
                .Where(c => c.Driver_Site == _siteCode
                    && c.Call_date.HasValue
                    && c.Call_date.Value.Date >= fromDate.Date
                    && c.Call_date.Value.Date <= toDate.Date)
                .OrderByDescending(c => c.Call_date)
                .ThenByDescending(c => c.Call_time)
                .ToList();
            _page = 1;

            _reportLoaded = true;
            _message = _siteCode.HasValue
                ? $"Report generated for {GetSiteText(_siteCode)}."
                : "Report generated.";
        }
        catch (Exception ex)
        {
            _message = "Failed to generate report.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool TryParseLegacyDate(string? value, out DateTime parsedDate)
    {
        parsedDate = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim().Replace("-", "/");
        return DateTime.TryParse(normalized, out parsedDate);
    }

    private string GetSiteText(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? siteCode.Value.ToString() : $"{site.DepartmentNumber} - {site.Description}";
    }

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy/MM/dd") : "-";
    private static string FormatTime(DateTime? value) => value.HasValue ? value.Value.ToString("hh:mm:ss tt") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
