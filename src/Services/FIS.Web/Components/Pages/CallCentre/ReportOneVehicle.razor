@page "/call-centre/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject VehicleLookupApiService VehicleLookupService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Incident Report on ONE Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Incident Report on ONE Vehicle
        </h1>
        <p class="page-description">Vehicle incident lookup by GG, GP, engine, VIN/chassis, or invoice number.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Vehicle Number</th>
                    <td>
                        <div class="contract-search-inputs">
                            <div class="contract-search-radio">
                                <label class="form-radio-label"><input type="radio" name="vehicleType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' /> GP</label>
                                <label class="form-radio-label"><input type="radio" name="vehicleType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' /> GG</label>
                                <label class="form-radio-label"><input type="radio" name="vehicleType" checked="@(_searchMode == "ENGINE")" @onchange='() => SetSearchMode("ENGINE")' /> Engine</label>
                                <label class="form-radio-label"><input type="radio" name="vehicleType" checked="@(_searchMode == "VIN")" @onchange='() => SetSearchMode("VIN")' /> VIN / Chassis</label>
                                <label class="form-radio-label"><input type="radio" name="vehicleType" checked="@(_searchMode == "INVOICE")" @onchange='() => SetSearchMode("INVOICE")' /> Invoice</label>
                            </div>
                            <input class="form-input maxw-input-lg" @bind="_searchTerm" placeholder="@VehicleSearchHelper.GetSearchPlaceholder(_searchMode)" />
                            <button class="btn btn-secondary btn-sm" @onclick="SearchVehicleAsync" disabled="@_loading">Find</button>
                            <select class="form-select maxw-select-lg" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                                }
                            </select>
                            <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">Submit</button>
                            <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Menu</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No incidents found</h3>
            <p>Enter a valid vehicle number and submit.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle Number</th>
                            <th>Reference Number (GMT)</th>
                            <th>Incident</th>
                            <th>Call Date</th>
                            <th>Caller</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@GetResultVehicleNumber(item)</td>
                                <td>@item.Call_centre_code</td>
                                <td>@ValueOrDash(item.Incident_type)</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@ValueOrDash(item.Caller_name)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _searchTerm = string.Empty;
    private string _searchMode = "GP";
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private string _selectedVehicleNumber = string.Empty;
    private List<CallCentreDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<CallCentreDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _results = new();

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _message = "Enter a vehicle number.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            if (!_selectedVmfCode.HasValue)
            {
                await SearchVehicleAsync();
            }

            if (!_selectedVmfCode.HasValue)
            {
                _message = "No vehicle selected.";
                _messageIsError = true;
                return;
            }

            var all = await CallCentreService.GetAllAsync<CallCentreDto>();
            _results = all.Where(c => c.vmf_code == _selectedVmfCode.Value).OrderByDescending(c => c.Call_date).ToList();
            _selectedVehicleNumber = ResolveSelectedVehicleNumber();
            _page = 1;

            _message = _results.Count == 0
                ? "No incidents found for the selected vehicle."
                : $"Loaded {_results.Count} incident(s) for vehicle {_searchTerm.Trim().ToUpperInvariant()}.";
            _messageIsError = _results.Count == 0;
        }
        catch (Exception ex)
        {
            _message = "Failed to load vehicle incidents.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchVehicleAsync()
    {
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _selectedVehicleNumber = string.Empty;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return;
        }

        try
        {
            var searchTerm = _searchTerm.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = VehicleSearchHelper.RankVehicleLookupMatches(matches, searchTerm, _searchMode);
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _selectedVehicleNumber = string.Empty;
        _results = new();
        _message = string.Empty;
        _page = 1;
    }

    private string ResolveSelectedVehicleNumber()
    {
        if (!_selectedVmfCode.HasValue)
        {
            return string.Empty;
        }

        var selected = _vehicleMatches.FirstOrDefault(v => v.VmfCode == _selectedVmfCode.Value);
        if (selected == null)
        {
            return string.Empty;
        }

        var preferred = VehicleSearchHelper.GetSearchValue(selected, _searchMode);
        if (!string.IsNullOrWhiteSpace(preferred))
        {
            return preferred.Trim();
        }

        var fallback = _searchMode == "GG" ? selected.RegistrationNumber : selected.GGNumber;
        return fallback?.Trim() ?? string.Empty;
    }

    private string GetResultVehicleNumber(CallCentreDto item)
    {
        if (_searchMode == "GG" && !string.IsNullOrWhiteSpace(item.GG_number))
        {
            return item.GG_number;
        }

        if (!string.IsNullOrWhiteSpace(_selectedVehicleNumber))
        {
            return _selectedVehicleNumber;
        }

        return ValueOrDash(_searchTerm);
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
