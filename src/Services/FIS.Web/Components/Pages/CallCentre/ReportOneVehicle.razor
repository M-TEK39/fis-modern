@page "/call-centre/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject CallCentreApiService CallCentreService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Incident Report on ONE Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Incident Report on ONE Vehicle
        </h1>
        <p class="page-description">Legacy placeholder for CallCentre/RPT_Call_one_gg_main.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">GG / Reg Number</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadReport">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No incidents found</h3>
            <p>Search by vehicle number.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Call Date</th>
                            <th>Caller</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@item.Caller_name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/RPT_call_one_gg_main.aspx"
        Endpoint="api/callcentre/vehicle/1"
        HttpMethod="GET"
        ButtonText="Test One Vehicle Report Endpoint"
        ReportType="call-centre-report-one-vehicle" />
</div>

@code {
    private bool _loading;
    private string _searchTerm = string.Empty;
    private List<CallCentreDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<CallCentreDto>();
        try
        {
            var matches = await VehicleLookupService.SearchAsync(_searchTerm);
            var vmfCode = matches.FirstOrDefault()?.VmfCode;
            if (vmfCode.HasValue)
            {
                var all = await CallCentreService.GetAllAsync<CallCentreDto>();
                _results = all.Where(c => c.vmf_code == vmfCode.Value).ToList();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
}
