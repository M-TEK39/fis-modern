@page "/call-centre/incident/capture"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject VehicleLookupApiService VehicleLookupService
@inject SiteApiService SiteService
@inject DriverApiService DriverService
@inject IJSRuntime JSRuntime

<PageTitle>Capture a New Incident - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit"></i>
            Capture a New Incident
        </h1>
        <p class="page-description">Capture and submit a new call centre incident.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Vehicle Lookup</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Lookup Type</label>
                    <div class="form-grid">
                        <label class="form-label">
                            <input type="radio" name="lookupType" checked="@(_lookupType == "GG")" @onchange='() => SetLookupType("GG")' />
                            GG
                        </label>
                        <label class="form-label">
                            <input type="radio" name="lookupType" checked="@(_lookupType == "GP")" @onchange='() => SetLookupType("GP")' />
                            Reg Number
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_lookupType == "GP" ? "Reg Number" : "GG Number")</label>
                    <input class="form-input" @bind="_searchTerm" />
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                        <option value="">Select vehicle...</option>
                        @foreach (var vehicle in _vehicleMatches)
                        {
                            <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="LoadVehicle">Load Vehicle</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }

    @if (_showForm)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Incident Details</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Call Date</label>
                        <input type="date" class="form-input" @bind="_form.Call_date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Call Time</label>
                        <input type="time" class="form-input" @bind="_callTime" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Capture Name</label>
                        <input class="form-input" @bind="_form.Capture_name" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Caller Name</label>
                        <input class="form-input" @bind="_form.Caller_name" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver</label>
                        <select class="form-select" @bind="_selectedDriverCode" @bind:after="OnDriverChangedAsync">
                            <option value="">Select driver...</option>
                            @foreach (var driver in _drivers)
                            {
                                <option value="@driver.site_driver_code">@DriverOptionLabel(driver)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver Name</label>
                        <input class="form-input" @bind="_form.Driver_name" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver Persal No</label>
                        <input class="form-input" @bind="_form.Driver_persalno" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver License No</label>
                        <input class="form-input" @bind="_form.Driver_Licno" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver Site</label>
                        <select class="form-select" @bind="_form.Driver_Site">
                            <option value="">Select site</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver Tel</label>
                        <input class="form-input" @bind="_form.Driver_tel" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver Cell</label>
                        <input class="form-input" @bind="_form.Driver_cell" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveIncident">Submit</button>
                    <button class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showForm;
    private string _searchTerm = string.Empty;
    private string _lookupType = "GG";
    private TimeOnly? _callTime;
    private CallCentreDto _form = new();
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();
    private int? _selectedDriverCode;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();
    }

    private async Task LoadVehicle()
    {
        _loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                _vehicleMatches = new();
                _selectedVmfCode = null;
                _showForm = false;
                return;
            }

            var searchTerm = _searchTerm.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _lookupType);
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            var selectedVehicle = _vehicleMatches.FirstOrDefault(v => v.VmfCode == _selectedVmfCode);
            if (selectedVehicle == null)
            {
                _showForm = false;
                return;
            }

            _form = new CallCentreDto
            {
                vmf_code = selectedVehicle.VmfCode,
                GG_number = selectedVehicle.GGNumber,
                Call_date = DateTime.Today
            };
            _showForm = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveIncident()
    {
        _loading = true;
        try
        {
            if (_callTime.HasValue)
            {
                _form.Call_time = DateTime.Today.Add(_callTime.Value.ToTimeSpan());
            }

            await CallCentreService.CreateAsync(_form);
            ResetForm();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetForm()
    {
        _form = new CallCentreDto();
        _showForm = false;
        _searchTerm = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _callTime = null;
        _selectedDriverCode = null;
    }

    private Task OnDriverChangedAsync()
    {
        if (!_selectedDriverCode.HasValue)
        {
            _form.Driver_name = null;
            _form.Driver_persalno = null;
            _form.Driver_Licno = null;
            _form.Driver_Site = null;
            return Task.CompletedTask;
        }

        var selected = _drivers.FirstOrDefault(d => d.site_driver_code == _selectedDriverCode.Value);
        if (selected == null)
        {
            return Task.CompletedTask;
        }

        _form.Driver_name = $"{selected.driver_firstname} {selected.driver_surname}".Trim();
        _form.Driver_persalno = selected.driver_persalnumber;
        _form.Driver_Licno = selected.driver_licence_number;
        _form.Driver_Site = (short?)selected.site_code;
        return Task.CompletedTask;
    }

    private static string DriverOptionLabel(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code})";
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string lookupType)
    {
        var query = keyword.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return new List<VehicleLookupDto>();
        }

        var isGpLookup = string.Equals(lookupType, "GP", StringComparison.OrdinalIgnoreCase);
        return matches
            .Where(v => isGpLookup
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGpLookup
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetLookupType(string lookupType)
    {
        _lookupType = lookupType;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _showForm = false;
    }
}
