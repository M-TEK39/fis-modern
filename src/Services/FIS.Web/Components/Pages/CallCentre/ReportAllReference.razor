@page "/call-centre/reports/all-reference"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Incident Report on ALL Call Numbers - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            Incident Report on ALL Call Numbers
        </h1>
        <p class="page-description">Legacy placeholder for CallCentre/RPT_call_all_num_main.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadReport">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-list-ul"></i>
            <h3>No incidents found</h3>
            <p>Load report to view call numbers.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Call Date</th>
                            <th>Caller</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@item.Caller_name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private List<CallCentreDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<CallCentreDto>();
        try
        {
            _results = await CallCentreService.GetAllAsync<CallCentreDto>();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
}
