@page "/call-centre/reports/all-reference"
@page "/CallCentre/RPT_call_all_num_main.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Incident Report on ALL Call Numbers - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            CALL CENTRE INCIDENT REPORT
        </h1>
        <p class="page-description">Incident report by type and date range.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Incident</th>
                    <td>
                        <div class="contract-search-inputs">
                            <label class="form-label"><input type="radio" name="incident" checked="@(_incidentFilter == "all")" @onchange='() => _incidentFilter = "all"' /> ALL</label>
                            <label class="form-label"><input type="radio" name="incident" checked="@(_incidentFilter == "accident")" @onchange='() => _incidentFilter = "accident"' /> Accident</label>
                            <label class="form-label"><input type="radio" name="incident" checked="@(_incidentFilter == "hijack")" @onchange='() => _incidentFilter = "hijack"' /> Hi-Jack</label>
                            <label class="form-label"><input type="radio" name="incident" checked="@(_incidentFilter == "loss")" @onchange='() => _incidentFilter = "loss"' /> Loss</label>
                            <label class="form-label"><input type="radio" name="incident" checked="@(_incidentFilter == "road")" @onchange='() => _incidentFilter = "road"' /> Road Assist</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>Begin Date</th>
                    <td><input class="form-input maxw-input-lg" placeholder="e.g. 2003/03/01" @bind="_beginDateText" /></td>
                </tr>
                <tr>
                    <th>End Date</th>
                    <td><input class="form-input maxw-input-lg" placeholder="e.g. 2003/03/31" @bind="_endDateText" /></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">Submit</button>
                        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Report Menu</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading...</p></div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-list-ul"></i><h3>No incidents found</h3><p>Update filters and submit.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_results.Count incident(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference Number (GMT)</th>
                            <th>Incident</th>
                            <th>Call Date</th>
                            <th>Caller</th>
                            <th>GG Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@ValueOrDash(item.Incident_type)</td>
                                <td>@FormatDate(item.Call_date)</td>
                                <td>@ValueOrDash(item.Caller_name)</td>
                                <td>@ValueOrDash(item.GG_number)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_results.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_results.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _incidentFilter = "all";
    private string _beginDateText = string.Empty;
    private string _endDateText = DateTime.Today.ToString("yyyy/MM/dd");
    private List<CallCentreDto> _results = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<CallCentreDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _results = new();

        if (!TryParseDate(_beginDateText, out var beginDate))
        {
            _message = "Begin Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        if (!TryParseDate(_endDateText, out var endDate))
        {
            _message = "End Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            var all = await CallCentreService.GetAllAsync<CallCentreDto>();
            var query = all.Where(c => c.Call_date.HasValue && c.Call_date.Value.Date >= beginDate.Date && c.Call_date.Value.Date <= endDate.Date);

            if (_incidentFilter != "all")
            {
                query = query.Where(c => MatchesIncident(c.Incident_type, _incidentFilter));
            }

            _results = query.OrderByDescending(c => c.Call_date).ThenByDescending(c => c.Call_centre_code).ToList();
            _page = 1;
            _message = $"Loaded {_results.Count} incident(s).";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = "Failed to load incidents.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool MatchesIncident(string? incidentType, string filter)
    {
        var value = (incidentType ?? string.Empty).Trim().ToLowerInvariant();
        return filter switch
        {
            "accident" => value.Contains("accident"),
            "hijack" => value.Contains("hijack") || value.Contains("hi-jack"),
            "loss" => value.Contains("loss"),
            "road" => value.Contains("road") || value.Contains("assist"),
            _ => true
        };
    }

    private static bool TryParseDate(string? value, out DateTime parsedDate)
    {
        parsedDate = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim().Replace("-", "/");
        return DateTime.TryParse(normalized, out parsedDate);
    }

    private static string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
