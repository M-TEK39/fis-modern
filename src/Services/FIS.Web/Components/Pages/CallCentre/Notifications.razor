@page "/call-centre/notifications"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Notification List for eMail Addresses - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-envelope"></i>
            Notification List for eMail Addresses
        </h1>
        <p class="page-description">Call centre notification workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadNotifications">Load Notifications</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_notifications.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-envelope"></i>
            <h3>No notifications available</h3>
            <p>No notifications match the current filter selection.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedNotifications)
                        {
                            <tr>
                                <td>@item</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_notifications.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_notifications.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private List<string> _notifications = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<string> PagedNotifications => _notifications.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_notifications.Count / (double)_pageSize));

    private async Task LoadNotifications()
    {
        _loading = true;
        _notifications = new List<string>();
        try
        {
            _notifications = await CallCentreService.GetAllAsync<string>();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
