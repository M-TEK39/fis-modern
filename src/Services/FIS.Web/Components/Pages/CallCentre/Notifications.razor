@page "/call-centre/notifications"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Notification List for eMail Addresses - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-envelope"></i>
            Notification List for eMail Addresses
        </h1>
        <p class="page-description">Legacy CallCentre/MNT_call_notify_pass.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadNotifications">Load Notifications</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_notifications.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-envelope"></i>
            <h3>No notifications available</h3>
            <p>Notification data endpoint pending.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _notifications)
                        {
                            <tr>
                                <td>@item</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/MNT_call_notify_pass.aspx"
        Endpoint="api/callcentre/notifications"
        HttpMethod="GET"
        ButtonText="Test Notification List Endpoint"
        ReportType="call-centre-notifications" />

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/MNT_call_notify_pass.aspx"
        Endpoint="api/notification/config/status"
        HttpMethod="GET"
        ButtonText="Test Notification Config Endpoint"
        ReportType="notification-config-status" />
</div>

@code {
    private bool _loading;
    private List<string> _notifications = new();

    private async Task LoadNotifications()
    {
        _loading = true;
        _notifications = new List<string>();
        try
        {
            _notifications = await CallCentreService.GetAllAsync<string>();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
