@page "/call-centre/reports/data-access"
@page "/CallCentre/RPT_call_oneaccess_main.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Full Report on Data Access Detail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-lock-alt"></i>
            Full Report on Data Access Detail
        </h1>
        <p class="page-description">Lookup capture/access trail by GMT reference.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Reference Number</th>
                    <td>
                        <div class="contract-search-inputs">
                            <span class="form-label">GMT</span>
                            <input class="form-input maxw-input-lg" @bind="_referenceNumber" />
                            <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">Submit</button>
                            <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Menu</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_result != null)
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <tbody>
                        <tr><th>Reference Number</th><td>@_result.Call_centre_code</td></tr>
                        <tr><th>User Access ID</th><td>@(_result.User_access_code?.ToString() ?? "-")</td></tr>
                        <tr><th>Capture Name</th><td>@ValueOrDash(_result.Capture_name)</td></tr>
                        <tr><th>Date Created</th><td>@_result.date_created.ToString("yyyy/MM/dd HH:mm")</td></tr>
                        <tr><th>Date Updated</th><td>@FormatDateTime(_result.date_updated)</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _referenceNumber = string.Empty;
    private CallCentreDto? _result;

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _result = null;

        if (!short.TryParse(_referenceNumber?.Trim(), out var code))
        {
            _message = "Enter a valid GMT reference number.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            _result = await CallCentreService.GetByIdAsync<CallCentreDto>(code);
            if (_result == null)
            {
                _message = $"No access record found for GMT {code}.";
                _messageIsError = true;
            }
            else
            {
                _message = $"Data access detail loaded for GMT {code}.";
                _messageIsError = false;
            }
        }
        catch (Exception ex)
        {
            _message = "Failed to load data access detail.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy/MM/dd HH:mm") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
