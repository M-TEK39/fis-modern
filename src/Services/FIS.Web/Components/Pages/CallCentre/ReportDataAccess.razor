@page "/call-centre/reports/data-access"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Full Report on Data Access Detail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-lock-alt"></i>
            Full Report on Data Access Detail
        </h1>
        <p class="page-description">Legacy placeholder for CallCentre/RPT_call_oneaccess_main.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadReport">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>No incidents found</h3>
            <p>Load report to view data access details.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>User Code</th>
                            <th>Capture Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _results)
                        {
                            <tr>
                                <td>@item.Call_centre_code</td>
                                <td>@item.User_access_code</td>
                                <td>@item.Capture_name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/RPT_call_oneaccess_main.aspx"
        Endpoint="api/callcentre/reports/data-access"
        HttpMethod="GET"
        ButtonText="Test Data Access Report Endpoint"
        ReportType="call-centre-report-data-access" />
</div>

@code {
    private bool _loading;
    private List<CallCentreDto> _results = new();

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<CallCentreDto>();
        try
        {
            _results = await CallCentreService.GetAllAsync<CallCentreDto>();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
