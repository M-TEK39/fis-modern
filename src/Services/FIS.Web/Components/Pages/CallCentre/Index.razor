@page "/call-centre"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Call Centre Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-phone-call"></i>
            Call Centre Maintenance Menu
        </h1>
        <p class="page-description">Call centre maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Call Centre Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/help">Call Centre Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Incident Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/incident/capture">1) Capture a New Incident</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/incident/edit">2) Edit / Update an Existing Incident</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/notifications">3) Notification List for eMail Addresses</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports">4) Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile" id="booking-section">
            <div class="menu-tile-header">
                <span>Booking Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/bookings/notifications">1) Notification e-mail Addresses</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/bookings/help">Booking information/help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Call Centre Incident Preview"
                      SearchPlaceholder="Search incident type, caller, driver, GG number..."
                      EmptyMessage="No call centre incidents match the current search or filter."
                      EmptyIcon="bx bx-phone-call"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("callDate", "Call Date"),
        new("ggNumber", "GG Number"),
        new("incidentType", "Incident Type"),
        new("caller", "Caller"),
        new("driver", "Driver"),
        new("site", "Site")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Vehicle-linked incidents", "vehicleStatus", "Vehicle Linked"),
        new("Driver-linked incidents", "driverStatus", "Driver Linked"),
        new("Caller captured", "callerStatus", "Caller Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var incidents = await CallCentreService.GetAllAsync<CallCentreDto>();
            _rows = incidents
                .OrderByDescending(item => item.Call_date ?? item.date_created)
                .Select(item => new Dictionary<string, string?>
                {
                    ["callDate"] = FormatDate(item.Call_date),
                    ["ggNumber"] = item.GG_number ?? item.vmf_code?.ToString(),
                    ["incidentType"] = item.Incident_type,
                    ["caller"] = item.Caller_name,
                    ["driver"] = item.Driver_name,
                    ["site"] = item.Driver_Site?.ToString(),
                    ["vehicleStatus"] = item.vmf_code.HasValue || !string.IsNullOrWhiteSpace(item.GG_number) ? "Vehicle Linked" : "No Vehicle",
                    ["driverStatus"] = string.IsNullOrWhiteSpace(item.Driver_name) ? "No Driver" : "Driver Linked",
                    ["callerStatus"] = string.IsNullOrWhiteSpace(item.Caller_name) ? "No Caller" : "Caller Captured"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading call centre preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
