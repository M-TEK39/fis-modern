@page "/call-centre/incident/edit"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject SiteApiService SiteService
@inject DriverApiService DriverService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Edit / Update an Existing Incident - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit-alt"></i>
            Edit / Update an Existing Incident
        </h1>
        <p class="page-description">Call centre incident edit workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Reference Number</label>
            <input class="form-input" @bind="_referenceNumber" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadIncident">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }

    @if (_showForm && _editing != null)
    {
        <div class="form-card">
            <div class="form-row">
                <label class="form-label">Call Date</label>
                <input type="date" class="form-input" @bind="_editing.Call_date" />
            </div>
            <div class="form-row">
                <label class="form-label">Call Time</label>
                <input type="time" class="form-input" @bind="_callTime" />
            </div>
            <div class="form-row">
                <label class="form-label">Capture Name</label>
                <input class="form-input" @bind="_editing.Capture_name" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver</label>
                <select class="form-select" @bind="_selectedDriverCode" @bind:after="OnDriverChangedAsync">
                    <option value="">Select driver...</option>
                    @foreach (var driver in _drivers)
                    {
                        <option value="@driver.site_driver_code">@DriverOptionLabel(driver)</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Driver Name</label>
                <input class="form-input" @bind="_editing.Driver_name" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver Persal No</label>
                <input class="form-input" @bind="_editing.Driver_persalno" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver License No</label>
                <input class="form-input" @bind="_editing.Driver_Licno" />
            </div>
            <div class="form-row">
                <label class="form-label">Driver Site</label>
                <select class="form-select" @bind="_editing.Driver_Site">
                    <option value="">Select site</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Caller Name</label>
                <input class="form-input" @bind="_editing.Caller_name" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveIncident">Submit</button>
            </div>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery(Name = "referenceNumber")]
    public string? ReferenceNumber { get; set; }

    private bool _loading;
    private bool _showForm;
    private string _referenceNumber = string.Empty;
    private TimeOnly? _callTime;
    private CallCentreDto? _editing;
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();
    private int? _selectedDriverCode;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();

        if (!string.IsNullOrWhiteSpace(ReferenceNumber))
        {
            _referenceNumber = ReferenceNumber.Trim();
            await LoadIncident();
        }
    }

    private async Task LoadIncident()
    {
        _loading = true;
        try
        {
            if (short.TryParse(_referenceNumber, out var code))
            {
                _editing = await CallCentreService.GetByIdAsync<CallCentreDto>(code);
                if (string.Equals(_editing?.Incident_type, "Booking", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo($"/call-centre/bookings?gmt={code}");
                    return;
                }

                if (_editing?.Call_time.HasValue == true)
                {
                    _callTime = TimeOnly.FromDateTime(_editing.Call_time.Value);
                }
                if (_editing?.Driver_persalno != null)
                {
                    var matched = _drivers.FirstOrDefault(d => d.driver_persalnumber == _editing.Driver_persalno);
                    _selectedDriverCode = matched?.site_driver_code;
                }
                _showForm = _editing != null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveIncident()
    {
        if (_editing == null)
        {
            return;
        }

        _loading = true;
        try
        {
            if (_callTime.HasValue)
            {
                _editing.Call_time = DateTime.Today.Add(_callTime.Value.ToTimeSpan());
            }

            await CallCentreService.UpdateAsync(_editing.Call_centre_code, _editing);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnDriverChangedAsync()
    {
        if (_editing == null || !_selectedDriverCode.HasValue)
        {
            return Task.CompletedTask;
        }

        var selected = _drivers.FirstOrDefault(d => d.site_driver_code == _selectedDriverCode.Value);
        if (selected == null)
        {
            return Task.CompletedTask;
        }

        _editing.Driver_name = $"{selected.driver_firstname} {selected.driver_surname}".Trim();
        _editing.Driver_persalno = selected.driver_persalnumber;
        _editing.Driver_Licno = selected.driver_licence_number;
        _editing.Driver_Site = (short?)selected.site_code;
        return Task.CompletedTask;
    }

    private static string DriverOptionLabel(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code})";
    }
}
