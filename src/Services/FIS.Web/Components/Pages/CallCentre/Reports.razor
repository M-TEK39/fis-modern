@page "/call-centre/reports"
@rendermode InteractiveServer

<PageTitle>Call Centre Reports Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Call Centre Reports Menu
        </h1>
        <p class="page-description">Legacy reports menu for call centre incidents.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>One Call Incident Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/one-reference">1) Incident Report on ONE Reference Number</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/one-vehicle">2) Incident Report on ONE Vehicle</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>All Call Incident Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/all-reference">3) Incident Report on ALL Call Numbers</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Other Call Incident Reports:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/dept-site-period">4) Call Centre Info, for a Dept / Site, for a period</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/statistics">5) Call Centre Statistics</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/clo-report">6) Client Liaison Officer (CLO) Report</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/data-access">7) Full Report on Data Access Detail</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/call-centre/reports/open-calls">8) Open Calls (Calls NOT Closed)</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>
    </div>
</div>
