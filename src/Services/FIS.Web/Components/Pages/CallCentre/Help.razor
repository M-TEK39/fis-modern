@page "/call-centre/help"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Call Centre Maintenance Help - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Call Centre Maintenance Information / Help
        </h1>
        <p class="page-description">Legacy placeholder for CallCentre/Doc/Doc_CallCentre.htm.</p>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-help-circle"></i>
        <h3>Call centre help pending</h3>
        <p>This page will mirror the legacy call centre help document.</p>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="CallCentre/Doc/Doc_CallCentre.htm"
        Endpoint="api/callcentre/help"
        HttpMethod="GET"
        ButtonText="Test Call Centre Help Endpoint"
        ReportType="call-centre-help" />
</div>
