@page "/call-centre/reports/statistics"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Call Centre Statistics - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-alt-2"></i>
            CALL CENTRE INCIDENT REPORT - Statistics
        </h1>
        <p class="page-description">Statistics by period and capture person last name.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Begin Date</th>
                    <td><input class="form-input" style="max-width: 12rem;" placeholder="e.g. 2002/03/01" @bind="_beginDateText" /></td>
                </tr>
                <tr>
                    <th>End Date</th>
                    <td><input class="form-input" style="max-width: 12rem;" placeholder="e.g. 2002/03/31" @bind="_endDateText" /></td>
                </tr>
                <tr>
                    <th>Capture Person Last Name</th>
                    <td><input class="form-input" style="max-width: 14rem;" @bind="_captureLastName" /></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button class="btn btn-primary btn-sm" @onclick="LoadStats" disabled="@_loading">Submit</button>
                        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Report Menu</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading...</p></div>
    }
    else if (_stats.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-bar-chart-alt-2"></i><h3>No statistics available</h3><p>Update criteria and submit.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Capture Name</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _stats.OrderByDescending(x => x.Value))
                        {
                            <tr>
                                <td>@item.Key</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _beginDateText = string.Empty;
    private string _endDateText = DateTime.Today.ToString("yyyy/MM/dd");
    private string _captureLastName = string.Empty;
    private Dictionary<string, int> _stats = new();

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadStats()
    {
        _message = string.Empty;
        _stats = new();

        if (!TryParseDate(_beginDateText, out var beginDate))
        {
            _message = "Begin Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        if (!TryParseDate(_endDateText, out var endDate))
        {
            _message = "End Date is required in yyyy/MM/dd format.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            var all = await CallCentreService.GetAllAsync<CallCentreDto>();
            var query = all.Where(c => c.Call_date.HasValue && c.Call_date.Value.Date >= beginDate.Date && c.Call_date.Value.Date <= endDate.Date);

            if (!string.IsNullOrWhiteSpace(_captureLastName))
            {
                query = query.Where(c => !string.IsNullOrWhiteSpace(c.Capture_name)
                    && c.Capture_name.Contains(_captureLastName.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            _stats = query
                .GroupBy(c => string.IsNullOrWhiteSpace(c.Capture_name) ? "(Unknown)" : c.Capture_name!)
                .ToDictionary(g => g.Key, g => g.Count());

            _message = $"Loaded {_stats.Values.Sum()} incident(s) across {_stats.Count} capture person(s).";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = "Failed to load statistics report.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool TryParseDate(string? value, out DateTime parsedDate)
    {
        parsedDate = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim().Replace("-", "/");
        return DateTime.TryParse(normalized, out parsedDate);
    }
}
