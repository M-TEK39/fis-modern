@page "/call-centre/reports/one-reference"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject CallCentreApiService CallCentreService
@inject SiteApiService SiteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Incident Report on ONE Reference Number - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Incident Report on ONE Reference Number
        </h1>
        <p class="page-description">Reference lookup by GMT number.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu">Report Menu</button>
    </div>
</div>

<div class="page-content">
    <div class="contract-section">
        <table class="contract-legacy-table">
            <tbody>
                <tr>
                    <th>Reference Number</th>
                    <td>
                        <div class="contract-search-inputs">
                            <span class="form-label">GMT</span>
                            <input class="form-input" style="max-width: 12rem;" @bind="_referenceNumber" />
                            <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">Submit</button>
                            <button class="btn btn-secondary btn-sm" @onclick="GoReportMenu" disabled="@_loading">Menu</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_result != null)
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <tbody>
                        <tr><th>Reference Number</th><td>@_result.Call_centre_code</td></tr>
                        <tr><th>Incident</th><td>@ValueOrDash(_result.Incident_type)</td></tr>
                        <tr><th>Call Date</th><td>@FormatDate(_result.Call_date)</td></tr>
                        <tr><th>Call Time</th><td>@FormatTime(_result.Call_time)</td></tr>
                        <tr><th>Caller</th><td>@ValueOrDash(_result.Caller_name)</td></tr>
                        <tr><th>Driver</th><td>@ValueOrDash(_result.Driver_name)</td></tr>
                        <tr><th>Driver Site</th><td>@GetSiteText(_result.Driver_Site)</td></tr>
                        <tr><th>GG Number</th><td>@ValueOrDash(_result.GG_number)</td></tr>
                        <tr><th>Captured By</th><td>@ValueOrDash(_result.Capture_name)</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _messageIsError;
    private string _message = string.Empty;
    private string _referenceNumber = string.Empty;
    private List<SiteResponseDto> _sites = new();
    private CallCentreDto? _result;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private void GoReportMenu() => Navigation.NavigateTo("/call-centre/reports");

    private async Task LoadReport()
    {
        _message = string.Empty;
        _result = null;

        if (!short.TryParse(_referenceNumber?.Trim(), out var code))
        {
            _message = "Enter a valid GMT reference number.";
            _messageIsError = true;
            return;
        }

        _loading = true;
        try
        {
            _result = await CallCentreService.GetByIdAsync<CallCentreDto>(code);
            if (_result == null)
            {
                _message = $"No incident found for GMT {code}.";
                _messageIsError = true;
            }
            else
            {
                _message = $"Incident GMT {code} loaded.";
                _messageIsError = false;
            }
        }
        catch (Exception ex)
        {
            _message = "Failed to load incident.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("yyyy/MM/dd") : "-";
    private static string FormatTime(DateTime? date) => date.HasValue ? date.Value.ToString("HH:mm:ss") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string GetSiteText(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? siteCode.Value.ToString() : $"{site.DepartmentNumber} - {site.Description}";
    }
}
