@page "/call-centre/bookings"
@page "/call-centre/bookings/menu"
@page "/callcentre/bookings/Bookings_menu.aspx"
@page "/CallCentre/Bookings/Booking_1G.aspx"
@page "/CallCentre/Bookings/Edit_Booking_1G.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject BookingApiService BookingService
@inject CallCentreApiService CallCentreService
@inject IJSRuntime JSRuntime

<PageTitle>Call Centre Bookings - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar"></i>
            Call Centre Booking Workflow
        </h1>
        <p class="page-description">Capture new bookings or edit existing bookings linked from call centre incidents.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Existing Booking ID (optional)</label>
            <input class="form-input" @bind="_lookupBookingId" placeholder="Enter booking ID for edit" />
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="LoadBookingAsync">Load Booking</button>
            <button class="btn btn-primary" @onclick="PrepareNew">New Booking</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading booking...</p>
        </div>
    }

    @if (_form is not null)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>@(_isEditMode ? $"Edit Booking #{_form.booking_id}" : "Capture Booking")</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Name</label>
                        <input class="form-input" @bind="_form.name" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site Code</label>
                        <input class="form-input" @bind="_form.site_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Telephone</label>
                        <input class="form-input" @bind="_form.telephone" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">VMF Code</label>
                        <input type="number" class="form-input" @bind="_form.vmf_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Class Code</label>
                        <input type="number" class="form-input" @bind="_form.class_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">User ID</label>
                        <input type="number" class="form-input" @bind="_form.user_id" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Location Code</label>
                        <input type="number" class="form-input" @bind="_form.location_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input type="text" class="form-input" @bind="_startDateText" placeholder="yyyy-MM-dd HH:mm" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input type="text" class="form-input" @bind="_endDateText" placeholder="yyyy-MM-dd HH:mm" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Booking Status</label>
                        <input class="form-input" @bind="_form.booking_status" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Collected (0/1)</label>
                        <input type="number" class="form-input" @bind="_form.collected" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Booking Date</label>
                        <input type="text" class="form-input" @bind="_bookingDateText" placeholder="yyyy-MM-dd HH:mm" />
                    </div>
                    <div class="form-field form-field-full">
                        <label class="form-label">Notes</label>
                        <textarea class="form-input" rows="3" @bind="_form.notes"></textarea>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Submit</button>
                    <button class="btn btn-secondary" @onclick="PrepareNew" disabled="@_saving">Clear</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "gmt")]
    public string? Gmt { get; set; }

    private bool _loading;
    private bool _saving;
    private bool _isEditMode;
    private string _lookupBookingId = string.Empty;
    private BookingDto? _form;
    private string? _sourceGmtReference;
    private string _startDateText = string.Empty;
    private string _endDateText = string.Empty;
    private string _bookingDateText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (short.TryParse(Gmt, out var gmtReference))
        {
            _sourceGmtReference = gmtReference.ToString();
            await LoadByGmtReferenceAsync(gmtReference);
            return;
        }

        PrepareNew();
    }

    private async Task LoadByGmtReferenceAsync(short gmtReference)
    {
        _loading = true;
        try
        {
            var incident = await CallCentreService.GetByIdAsync<CallCentreDto>(gmtReference);
            if (incident is null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Call-centre reference GMT {gmtReference} was not found.");
                PrepareNew();
                return;
            }

            if (!short.TryParse(incident.Incident_Desc, out var bookingId))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"No linked booking ID was found on GMT {gmtReference}. You can capture a new booking or load one manually.");
                PrepareNew();
                return;
            }

            _lookupBookingId = bookingId.ToString();
            await LoadBookingAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading booking by GMT reference: {ex.Message}");
            PrepareNew();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareNew()
    {
        _isEditMode = false;
        _form = new BookingDto
        {
            booking_date = DateTime.UtcNow,
            start_date = DateTime.UtcNow,
            end_date = DateTime.UtcNow,
            booking_status = "Pending",
            collected = 0
        };
        SyncDateTexts();
    }

    private async Task LoadBookingAsync()
    {
        if (!short.TryParse(_lookupBookingId, out var bookingId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Enter a valid booking ID.");
            return;
        }

        _loading = true;
        try
        {
            var booking = await BookingService.GetByIdAsync<BookingDto>(bookingId);
            if (booking is null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Booking ID {bookingId} not found.");
                return;
            }

            _form = booking;
            _isEditMode = true;
            SyncDateTexts();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading booking: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        if (!TryParseDates())
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please provide valid booking/start/end dates.");
            return;
        }

        _saving = true;
        try
        {
            if (_isEditMode)
            {
                await BookingService.UpdateAsync(_form.booking_id, _form);
            }
            else
            {
                var created = await BookingService.CreateAsync(_form);
                if (created is not null)
                {
                    _form = created;
                    _isEditMode = true;
                    _lookupBookingId = created.booking_id.ToString();
                    SyncDateTexts();
                    await LinkBookingToSourceIncidentAsync(created.booking_id);
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error saving booking: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void SyncDateTexts()
    {
        if (_form is null)
        {
            return;
        }

        _startDateText = ToInputDateTime(_form.start_date);
        _endDateText = _form.end_date.HasValue ? ToInputDateTime(_form.end_date.Value) : string.Empty;
        _bookingDateText = ToInputDateTime(_form.booking_date);
    }

    private bool TryParseDates()
    {
        if (_form is null)
        {
            return false;
        }

        if (!DateTime.TryParse(_startDateText, out var startDate) ||
            !DateTime.TryParse(_bookingDateText, out var bookingDate))
        {
            return false;
        }

        _form.start_date = startDate;
        _form.booking_date = bookingDate;

        if (!string.IsNullOrWhiteSpace(_endDateText))
        {
            if (!DateTime.TryParse(_endDateText, out var endDate))
            {
                return false;
            }

            _form.end_date = endDate;
        }
        else
        {
            _form.end_date = null;
        }

        return true;
    }

    private static string ToInputDateTime(DateTime value)
        => value.ToString("yyyy-MM-ddTHH:mm");

    private async Task LinkBookingToSourceIncidentAsync(short bookingId)
    {
        if (!short.TryParse(_sourceGmtReference, out var gmtReference))
        {
            return;
        }

        try
        {
            var incident = await CallCentreService.GetByIdAsync<CallCentreDto>(gmtReference);
            if (incident is null)
            {
                return;
            }

            incident.Incident_Desc = bookingId.ToString();
            if (string.IsNullOrWhiteSpace(incident.Incident_type))
            {
                incident.Incident_type = "Booking";
            }

            await CallCentreService.UpdateAsync(incident.Call_centre_code, incident);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error linking booking to GMT incident: {ex.Message}");
        }
    }
}
