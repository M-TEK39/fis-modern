@page "/third-party"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject PrivateHireApiService PrivateHireService
@inject IJSRuntime JS

<PageTitle>Third Party Rentals - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building-house"></i>
            Third Party Rentals
        </h1>
        <p class="page-description">Third party rental summary from Private Hire API.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadRentals">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading rentals...</p>
        </div>
    }
    else if (_rentals.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-building-house"></i>
            <h3>No rental records</h3>
            <p>Awaiting third party rental API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_rentals.Count Rental(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Rental #</th>
                            <th>Provider</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in _rentals)
                        {
                            <tr>
                                <td>@rental.Number</td>
                                <td>@rental.Provider</td>
                                <td>@rental.Vehicle</td>
                                <td><span class="badge">@rental.Status</span></td>
                                <td>@rental.Start.ToString("yyyy-MM-dd")</td>
                                <td>@rental.End.ToString("yyyy-MM-dd")</td>
                                <td>@rental.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<RentalItem> _rentals = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRentals();
    }

    private async Task LoadRentals()
    {
        _loading = true;
        try
        {
            var vehicles = await PrivateHireService.GetVehiclesAsync();
            var contractors = await PrivateHireService.GetContractorsAsync();

            _rentals = vehicles.Select(v =>
            {
                var contractor = contractors.FirstOrDefault(c => c.contractor_id == v.contractor_id);
                return new RentalItem(
                    Number: v.vehicle_id.ToString(),
                    Provider: contractor?.company_name ?? v.contractor_name,
                    Vehicle: v.registration_number,
                    Status: v.hire_status,
                    Start: v.hire_start_date ?? DateTime.MinValue,
                    End: v.hire_end_date ?? DateTime.MinValue,
                    Notes: v.notes ?? string.Empty
                );
            }).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading rentals: {ex.Message}");
            _rentals = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record RentalItem(string Number, string Provider, string Vehicle, string Status, DateTime Start, DateTime End, string Notes);
}
