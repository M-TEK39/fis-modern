@page "/third-party"
@page "/ThirdParty/Rental.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ThirdPartyApiService ThirdPartyService
@inject IJSRuntime JS

<PageTitle>Third Party Rentals - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-buildings"></i>
            Third Party Rental Suppliers
        </h1>
        <p class="page-description">Supplier, project, and allocation maintenance.</p>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "suppliers" ? "active" : "")" @onclick='() => SetActiveTab("suppliers")'>Suppliers</button>
        <button class="tab @(_activeTab == "projects" ? "active" : "")" @onclick='() => SetActiveTab("projects")'>Project</button>
        <button class="tab @(_activeTab == "allocation" ? "active" : "")" @onclick='() => SetActiveTab("allocation")'>Supplier & Vehicle Allocation</button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "suppliers")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Suppliers Maintenance</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-actions fis-justify-start">
                        <button class="btn btn-secondary" @onclick='() => SetSupplierMode("add")'>Add New Supplier</button>
                        <button class="btn btn-secondary" @onclick='() => SetSupplierMode("edit")'>Edit Supplier</button>
                    </div>

                    @if (_supplierMode == "intro")
                    {
                        <div class="form-section">
                            <p>Welcome to the supplier info screen. Please select a task using the buttons above.</p>
                        </div>
                    }
                    else if (_supplierMode == "add")
                    {
                        <EditForm Model="_supplierForm" OnValidSubmit="HandleSupplierSave">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="bx bx-user-plus"></i>
                                    Add New Supplier
                                </h3>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Supplier Name</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Name" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Physical Address</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.Address" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Postal Address</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.PostalAddress" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Office Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Tel" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Cell Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Cell" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Fax Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Fax" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">E-Mail Address</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Email" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Contact Person</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.ContactPerson" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Notes</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.Notes" />
                                    </div>
                                </div>
                                <div class="form-section">
                                    <h4 class="form-section-title"><i class="bx bx-list-check"></i> Services</h4>
                                    <div class="form-grid">
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.VehicleRental" /> Vehicle Rental</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.ChauffeurService" /> Chauffeur Service</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Maintenance" /> Maintenance</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Insurance" /> Insurance</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Other" /> Other</label>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button class="btn btn-secondary" type="button" @onclick="ClearSupplierForm">Clear Fields</button>
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </EditForm>
                        @if (!string.IsNullOrWhiteSpace(_supplierError))
                        {
                            <div class="alert alert-danger">@_supplierError</div>
                        }
                        @if (_supplierSaved)
                        {
                            <div class="alert alert-success">Supplier saved.</div>
                        }
                    }
                    else if (_supplierMode == "edit")
                    {
                        <EditForm Model="_supplierForm" OnValidSubmit="HandleSupplierSave">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="bx bx-edit"></i>
                                    Edit Suppliers
                                </h3>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Select a Supplier</label>
                                        <select class="form-select" value="@_selectedSupplierId" @onchange="OnSupplierSelected">
                                            <option value="">Select...</option>
                                            @foreach (var supplier in _suppliers)
                                            {
                                                <option value="@supplier.supplier_id">@supplier.name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Supplier Name</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Name" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Physical Address</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.Address" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Postal Address</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.PostalAddress" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Office Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Tel" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Cell Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Cell" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Fax Number</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Fax" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">E-Mail Address</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.Email" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Contact Person</label>
                                        <InputText class="form-input" @bind-Value="_supplierForm.ContactPerson" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Notes</label>
                                        <InputTextArea class="form-input" @bind-Value="_supplierForm.Notes" />
                                    </div>
                                </div>
                                <div class="form-section">
                                    <h4 class="form-section-title"><i class="bx bx-list-check"></i> Services</h4>
                                    <div class="form-grid">
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.VehicleRental" /> Vehicle Rental</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.ChauffeurService" /> Chauffeur Service</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Maintenance" /> Maintenance</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Insurance" /> Insurance</label>
                                        <label class="form-label form-checkbox"><input type="checkbox" @bind="_supplierForm.Other" /> Other</label>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </EditForm>
                        @if (!string.IsNullOrWhiteSpace(_supplierError))
                        {
                            <div class="alert alert-danger">@_supplierError</div>
                        }
                        @if (_supplierSaved)
                        {
                            <div class="alert alert-success">Supplier updated.</div>
                        }
                    }
                </div>
            </div>
        }
        else if (_activeTab == "projects")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Project Maintenance</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-actions fis-justify-start">
                        <button class="btn btn-secondary" @onclick='() => SetProjectMode("add")'>Add New Project</button>
                        <button class="btn btn-secondary" @onclick='() => SetProjectMode("edit")'>Edit Project</button>
                    </div>

                    @if (_projectMode == "intro")
                    {
                        <div class="form-section">
                            <p>Welcome to the project info screen. Please select a task using the buttons above.</p>
                        </div>
                    }
                    else if (_projectMode == "add")
                    {
                        <EditForm Model="_projectForm" OnValidSubmit="HandleProjectSave">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="bx bx-folder-plus"></i>
                                    Add New Project
                                </h3>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Department</label>
                                        <select class="form-select" value="@_projectForm.DepartmentCode" @onchange="OnDepartmentChanged">
                                            <option value="">Select...</option>
                                            @foreach (var department in _departments)
                                            {
                                                <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Site</label>
                                        <select class="form-select" @bind="_projectForm.SiteCode">
                                            <option value="">Select...</option>
                                            @foreach (var site in _sites)
                                            {
                                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Project Description</label>
                                        <InputTextArea class="form-input" @bind-Value="_projectForm.Description" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project Start Date</label>
                                        <InputDate class="form-input" @bind-Value="_projectForm.StartDate" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project End Date</label>
                                        <InputDate class="form-input" @bind-Value="_projectForm.EndDate" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project Responsible Person</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.ResponsiblePerson" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Tel Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Tel" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Cell Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Cell" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Fax Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Fax" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Project Notes</label>
                                        <InputTextArea class="form-input" @bind-Value="_projectForm.Notes" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button class="btn btn-secondary" type="button" @onclick="ClearProjectForm">Clear Fields</button>
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </EditForm>
                        @if (!string.IsNullOrWhiteSpace(_projectError))
                        {
                            <div class="alert alert-danger">@_projectError</div>
                        }
                        @if (_projectSaved)
                        {
                            <div class="alert alert-success">Project saved.</div>
                        }
                    }
                    else if (_projectMode == "edit")
                    {
                        <EditForm Model="_projectForm" OnValidSubmit="HandleProjectSave">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="bx bx-edit"></i>
                                    Edit Project
                                </h3>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Department</label>
                                        <select class="form-select" value="@_selectedProjectDepartment" @onchange="OnProjectDepartmentChanged">
                                            <option value="">Select...</option>
                                            @foreach (var department in _departments)
                                            {
                                                <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project</label>
                                        <select class="form-select" value="@_selectedProjectId" @onchange="OnProjectSelected">
                                            <option value="">Select...</option>
                                            @foreach (var project in _projects)
                                            {
                                                <option value="@project.project_id">@project.description</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <label class="form-label">Project Description</label>
                                        <InputTextArea class="form-input" @bind-Value="_projectForm.Description" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project Start Date</label>
                                        <InputDate class="form-input" @bind-Value="_projectForm.StartDate" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project End Date</label>
                                        <InputDate class="form-input" @bind-Value="_projectForm.EndDate" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Project Responsible Person</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.ResponsiblePerson" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Tel Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Tel" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Cell Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Cell" />
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Fax Number</label>
                                        <InputText class="form-input" @bind-Value="_projectForm.Fax" />
                                    </div>
                                    <div class="form-field form-group-full">
                                        <label class="form-label">Project Notes</label>
                                        <InputTextArea class="form-input" @bind-Value="_projectForm.Notes" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </EditForm>
                        @if (!string.IsNullOrWhiteSpace(_projectError))
                        {
                            <div class="alert alert-danger">@_projectError</div>
                        }
                        @if (_projectSaved)
                        {
                            <div class="alert alert-success">Project updated.</div>
                        }
                    }
                </div>
            </div>
        }
        else if (_activeTab == "allocation")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Supplier & Vehicle Allocation</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" value="@_allocationDepartment" @onchange="OnAllocationDepartmentChanged">
                                <option value="">Select...</option>
                                @foreach (var department in _departments)
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Project</label>
                            <select class="form-select" value="@_allocationProjectId" @onchange="OnAllocationProjectChanged">
                                <option value="">Select...</option>
                                @foreach (var project in _allocationProjects)
                                {
                                    <option value="@project.project_id">@project.description</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Supplier</label>
                            <select class="form-select" value="@_allocationSupplierId" @onchange="OnAllocationSupplierChanged">
                                <option value="">Select supplier...</option>
                                @foreach (var supplier in _suppliers)
                                {
                                    <option value="@supplier.supplier_id">@supplier.name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="tabs fis-mt-1">
                        @foreach (var requirement in _classRequirements)
                        {
                            <button class="tab @(requirement.class_id.ToString() == _allocationTab ? "active" : "")"
                                    @onclick='() => SetAllocationTab(requirement.class_id.ToString())'>
                                @requirement.class_name
                            </button>
                        }
                    </div>

                    <div class="table-container fis-mt-1">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Registration Number</th>
                                        <th>Model Description</th>
                                        <th>Model Year</th>
                                        <th>Chassis Number</th>
                                        <th>Select</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_supplierVehicles.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6">No vehicles found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var vehicle in PagedSupplierVehicles)
                                        {
                                            <tr>
                                                <td>@vehicle.vehicle_id</td>
                                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                                <td>@ValueOrDash(vehicle.model_description)</td>
                                                <td>@vehicle.model_year</td>
                                                <td>@ValueOrDash(vehicle.chassis_number)</td>
                                                <td>
                                                    <button class="btn btn-secondary btn-sm" @onclick="() => SelectAllocationVehicle(vehicle)">Select</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="pagination-controls fis-mt-1">
                            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                            <div class="pagination-info">Page @_page of @TotalPages</div>
                            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="bx bx-info-circle"></i>
                            Supplier Vehicle Detail
                        </h3>
                        <div class="form-grid">
                            <div class="form-field">
                                <label class="form-label">Vehicle ID</label>
                                <InputText class="form-input" Value="@(_selectedVehicle?.vehicle_id.ToString() ?? string.Empty)" disabled />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Registration Number</label>
                                <InputText class="form-input" Value="@(ValueOrDash(_selectedVehicle?.registration_number))" disabled />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Model Description</label>
                                <InputText class="form-input" Value="@(ValueOrDash(_selectedVehicle?.model_description))" disabled />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Model Year</label>
                                <InputText class="form-input" Value="@(_selectedVehicle?.model_year ?? string.Empty)" disabled />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Chassis Number</label>
                                <InputText class="form-input" Value="@(ValueOrDash(_selectedVehicle?.chassis_number))" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="HandleAllocation">Allocate</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_allocationError))
                    {
                        <div class="alert alert-danger">@_allocationError</div>
                    }
                    @if (_allocationSaved)
                    {
                        <div class="alert alert-success">Allocation saved.</div>
                    }
                </div>
            </div>
        }
    </div>

    <DataPreviewTable Title="Third Party Supplier Preview"
                      SearchPlaceholder="Search supplier, service, contact, email, telephone..."
                      EmptyMessage="No third party suppliers match the current search or filter."
                      EmptyIcon="bx bx-building-house"
                      IsLoading="false"
                      Columns="_previewColumns"
                      Rows="SupplierPreviewRows"
                      Filters="_previewFilters" />
</div>

@code {
    private string _activeTab = "suppliers";
    private string _supplierMode = "intro";
    private string _projectMode = "intro";
    private string _allocationTab = string.Empty;

    private readonly SupplierForm _supplierForm = new();
    private bool _supplierSaved;
    private string? _supplierError;
    private int? _selectedSupplierId;

    private readonly ProjectForm _projectForm = new();
    private bool _projectSaved;
    private string? _projectError;
    private int? _selectedProjectId;
    private short? _selectedProjectDepartment;

    private short? _allocationDepartment;
    private int? _allocationProjectId;
    private int? _allocationSupplierId;
    private bool _allocationSaved;
    private string? _allocationError;

    private List<ThirdPartySupplierDto> _suppliers = new();
    private List<DepartmentDto> _departments = new();
    private List<SiteResponseDto> _sites = new();
    private List<ThirdPartyProjectDto> _projects = new();
    private List<ThirdPartyProjectDto> _allocationProjects = new();
    private List<ThirdPartyVehicleDto> _supplierVehicles = new();
    private List<ThirdPartyClassRequirementDto> _classRequirements = new();
    private ThirdPartyVehicleDto? _selectedVehicle;
    private List<Dictionary<string, string?>> SupplierPreviewRows => _suppliers
        .OrderBy(item => item.name)
        .Select(item => new Dictionary<string, string?>
        {
            ["name"] = item.name,
            ["service"] = item.service_code,
            ["contact"] = item.contact_person,
            ["email"] = item.email,
            ["telephone"] = item.tel ?? item.cell,
            ["status"] = item.active.GetValueOrDefault(true) ? "Active" : "Inactive",
            ["emailStatus"] = string.IsNullOrWhiteSpace(item.email) ? "No Email" : "Email Captured",
            ["contactStatus"] = string.IsNullOrWhiteSpace(item.contact_person) ? "No Contact" : "Contact Captured",
            ["_href"] = $"/third-party?tab=suppliers&supplierId={item.supplier_id}"
        })
        .ToList();

    private readonly IReadOnlyList<DataPreviewColumn> _previewColumns =
    [
        new("name", "Supplier"),
        new("service", "Service"),
        new("contact", "Contact"),
        new("email", "Email"),
        new("telephone", "Telephone"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _previewFilters =
    [
        new("Active suppliers", "status", "Active"),
        new("Inactive suppliers", "status", "Inactive"),
        new("Suppliers with email", "emailStatus", "Email Captured"),
        new("Suppliers with contact", "contactStatus", "Contact Captured")
    ];
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<ThirdPartyVehicleDto> PagedSupplierVehicles => _supplierVehicles.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_supplierVehicles.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        try
        {
            _departments = await ThirdPartyService.GetDepartmentsAsync();
            _suppliers = await ThirdPartyService.GetSuppliersAsync();
        }
        catch (Exception ex)
        {
            _supplierError = "Failed to load third-party data.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private void SetSupplierMode(string mode)
    {
        _supplierMode = mode;
        _supplierSaved = false;
        _supplierError = null;
    }

    private void SetProjectMode(string mode)
    {
        _projectMode = mode;
        _projectSaved = false;
        _projectError = null;
    }

    private void SetAllocationTab(string tab)
    {
        _allocationTab = tab;
    }

    private async Task HandleSupplierSave()
    {
        _supplierError = null;
        _supplierSaved = false;

        var payload = new ThirdPartySupplierCreateDto
        {
            name = _supplierForm.Name,
            address = _supplierForm.Address,
            postal_address = _supplierForm.PostalAddress,
            tel = _supplierForm.Tel,
            fax = _supplierForm.Fax,
            cell = _supplierForm.Cell,
            email = _supplierForm.Email,
            contact_person = _supplierForm.ContactPerson,
            notes = _supplierForm.Notes,
            service_code = _supplierForm.GetServiceCode(),
            active = true
        };

        try
        {
            if (_selectedSupplierId.HasValue && _supplierMode == "edit")
            {
                await ThirdPartyService.UpdateSupplierAsync(_selectedSupplierId.Value, payload);
            }
            else
            {
                await ThirdPartyService.CreateSupplierAsync(payload);
            }

            _suppliers = await ThirdPartyService.GetSuppliersAsync();
            _supplierSaved = true;
        }
        catch (Exception ex)
        {
            _supplierError = "Failed to save supplier.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void ClearSupplierForm()
    {
        _supplierForm.Reset();
        _selectedSupplierId = null;
        _supplierSaved = false;
        _supplierError = null;
    }

    private Task OnSupplierSelected(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var supplierId))
        {
            _selectedSupplierId = null;
            return Task.CompletedTask;
        }

        _selectedSupplierId = supplierId;
        var selected = _suppliers.FirstOrDefault(s => s.supplier_id == supplierId);
        if (selected != null)
        {
            _supplierForm.Load(selected);
        }

        return Task.CompletedTask;
    }

