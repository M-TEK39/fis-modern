    private async Task OnDepartmentChanged(ChangeEventArgs args)
    {
        if (!short.TryParse(args.Value?.ToString(), out var departmentCode))
        {
            _sites = new();
            _projectForm.DepartmentCode = null;
            return;
        }

        _projectForm.DepartmentCode = departmentCode;
        _sites = await ThirdPartyService.GetSitesByDepartmentAsync(departmentCode);
    }

    private async Task OnProjectDepartmentChanged(ChangeEventArgs args)
    {
        if (!short.TryParse(args.Value?.ToString(), out var departmentCode))
        {
            _projects = new();
            _selectedProjectDepartment = null;
            return;
        }

        _selectedProjectDepartment = departmentCode;
        _projects = await ThirdPartyService.GetProjectsByDepartmentAsync(departmentCode);
    }

    private async Task OnProjectSelected(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var projectId))
        {
            _selectedProjectId = null;
            return;
        }

        _selectedProjectId = projectId;
        var selected = _projects.FirstOrDefault(p => p.project_id == projectId);
        if (selected != null)
        {
            _projectForm.Load(selected);
            if (selected.department_code.HasValue)
            {
                _sites = await ThirdPartyService.GetSitesByDepartmentAsync(selected.department_code.Value);
            }
        }
    }

    private async Task OnAllocationDepartmentChanged(ChangeEventArgs args)
    {
        if (!short.TryParse(args.Value?.ToString(), out var departmentCode))
        {
            _allocationDepartment = null;
            _allocationProjects = new();
            return;
        }

        _allocationDepartment = departmentCode;
        _allocationProjects = await ThirdPartyService.GetProjectsByDepartmentAsync(departmentCode);
    }

    private async Task OnAllocationProjectChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var projectId))
        {
            _allocationProjectId = null;
            _classRequirements = new();
            return;
        }

        _allocationProjectId = projectId;
        _classRequirements = await ThirdPartyService.GetClassRequirementsAsync(projectId);
        _allocationTab = _classRequirements.FirstOrDefault()?.class_id.ToString() ?? string.Empty;
    }

    private async Task OnAllocationSupplierChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var supplierId))
        {
            _allocationSupplierId = null;
            _supplierVehicles = new();
            return;
        }

        _allocationSupplierId = supplierId;
        _supplierVehicles = await ThirdPartyService.GetVehiclesBySupplierAsync(supplierId);
        _page = 1;
    }

    private void SelectAllocationVehicle(ThirdPartyVehicleDto vehicle)
    {
        _selectedVehicle = vehicle;
    }

    private async Task HandleAllocation()
    {
        _allocationError = null;
        _allocationSaved = false;

        if (!_allocationProjectId.HasValue || !_allocationSupplierId.HasValue || _selectedVehicle == null)
        {
            _allocationError = "Select project, supplier, and vehicle first.";
            return;
        }

        if (!int.TryParse(_allocationTab, out var classId))
        {
            _allocationError = "Select a class category.";
            return;
        }

        var payload = new ThirdPartyAllocationCreateDto
        {
            project_id = _allocationProjectId.Value,
            supplier_id = _allocationSupplierId.Value,
            vehicle_id = _selectedVehicle.vehicle_id,
            class_id = classId,
            quantity = 1
        };

        try
        {
            await ThirdPartyService.CreateAllocationAsync(payload);
            _allocationSaved = true;
        }
        catch (Exception ex)
        {
            _allocationError = "Failed to save allocation.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed class SupplierForm
    {
        [Required]
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? PostalAddress { get; set; }
        public string? Tel { get; set; }
        public string? Cell { get; set; }
        public string? Fax { get; set; }
        public string? Email { get; set; }
        public string? ContactPerson { get; set; }
        public string? Notes { get; set; }
        public bool VehicleRental { get; set; }
        public bool ChauffeurService { get; set; }
        public bool Maintenance { get; set; }
        public bool Insurance { get; set; }
        public bool Other { get; set; }

        public string? GetServiceCode()
        {
            if (VehicleRental) return "VehicleRental";
            if (ChauffeurService) return "ChauffeurService";
            if (Maintenance) return "Maintenance";
            if (Insurance) return "Insurance";
            if (Other) return "Other";
            return null;
        }

        public void Load(ThirdPartySupplierDto supplier)
        {
            Name = supplier.name ?? string.Empty;
            Address = supplier.address;
            PostalAddress = supplier.postal_address;
            Tel = supplier.tel;
            Cell = supplier.cell;
            Fax = supplier.fax;
            Email = supplier.email;
            ContactPerson = supplier.contact_person;
            Notes = supplier.notes;
        }

        public void Reset()
        {
            Name = string.Empty;
            Address = null;
            PostalAddress = null;
            Tel = null;
            Cell = null;
            Fax = null;
            Email = null;
            ContactPerson = null;
            Notes = null;
            VehicleRental = false;
            ChauffeurService = false;
            Maintenance = false;
            Insurance = false;
            Other = false;
        }
    }

    private sealed class ProjectForm
    {
        [Required]
        public short? DepartmentCode { get; set; }
        public short? SiteCode { get; set; }
        [Required]
        public string Description { get; set; } = string.Empty;
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? ResponsiblePerson { get; set; }
        public string? Tel { get; set; }
        public string? Fax { get; set; }
        public string? Cell { get; set; }
        public string? Notes { get; set; }

        public void Load(ThirdPartyProjectDto project)
        {
            DepartmentCode = project.department_code;
            SiteCode = project.site_code;
            Description = project.description ?? string.Empty;
            StartDate = project.start_date;
            EndDate = project.end_date;
            ResponsiblePerson = project.responsible_person;
            Tel = project.rp_tel;
            Fax = project.rp_fax;
            Cell = project.rp_cell;
            Notes = project.notes;
        }

        public void Reset()
        {
            DepartmentCode = null;
            SiteCode = null;
            Description = string.Empty;
            StartDate = null;
            EndDate = null;
            ResponsiblePerson = null;
            Tel = null;
            Fax = null;
            Cell = null;
            Notes = null;
        }
    }
}
