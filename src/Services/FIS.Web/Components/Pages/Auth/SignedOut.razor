@page "/signedout"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout
@inject NavigationManager Navigation

<PageTitle>Signed Out - Fleet Information System</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <div class="success-icon">
            <i class="bx bx-check-circle"></i>
        </div>
        <h1>You've been signed out</h1>
        <p>Your session has been ended successfully.</p>
    </div>

    <div class="auth-actions">
        <a href="/login" class="btn btn-primary auth-btn">
            Sign In Again
        </a>
        <a href="/" class="btn btn-secondary auth-btn auth-outline">
            Return to Home
        </a>
    </div>
</div>

<style>
    .success-icon {
        font-size: 4rem;
        color: #28a745;
        margin-bottom: 1rem;
    }

    .success-icon i {
        display: block;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        // Optional: Auto-redirect to login after a few seconds
        // Task.Delay(3000).ContinueWith(_ => Navigation.NavigateTo("/login"));
    }
}
