@page "/logout"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using FIS.Web.Services
@attribute [AllowAnonymous]
@layout FIS.Web.Components.Layout.AuthLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthApiService AuthService

<PageTitle>Signing Out...</PageTitle>

<div class="auth-logout-shell">
    <div class="auth-logout-card">
        <div class="spinner"></div>
        <h3>Signing you out...</h3>
        <p>Please wait while we clear your session.</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Check if user is authenticated via Entra ID (has specific Entra ID claims)
        var isEntraIdUser = user.HasClaim(c => c.Type == "preferred_username") || 
                           user.HasClaim(c => c.Type == "http://schemas.microsoft.com/identity/claims/objectidentifier");

        if (isEntraIdUser)
        {
            // Entra ID user - redirect to Microsoft logout
            Navigation.NavigateTo("/Account/Logout", forceLoad: true);
        }
        else
        {
            // JWT user - clear token and redirect to login
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
