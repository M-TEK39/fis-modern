@page "/reset-password"
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject AuthApiService AuthService

<PageTitle>Reset Password - Fleet Information System</PageTitle>

<div class="auth-card auth-card-wide">
    @if (_completed)
    {
        <div class="auth-header">
            <h1>Password Reset Complete</h1>
            <p>Your password has been changed successfully.</p>
        </div>
        <a class="btn btn-primary auth-btn" href="/login">Continue to sign in</a>
    }
    else if (string.IsNullOrWhiteSpace(Token))
    {
        <div class="auth-header">
            <h1>Invalid Reset Link</h1>
            <p>This password reset link is missing or invalid. Request a new link to continue.</p>
        </div>
        <a class="btn btn-primary auth-btn" href="/forgot-password">Request a new link</a>
    }
    else
    {
        <div class="auth-header">
            <h1>Choose a New Password</h1>
            <p>This link verifies your email address. Choose a new password to regain access.</p>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="auth-error" role="alert">
                    <i class="bx bx-error-circle"></i>
                    <span>@_errorMessage</span>
                </div>
            }

            <div class="form-grid auth-form">
                <div class="form-field">
                    <label class="form-label" for="new-password">New password</label>
                    <InputText id="new-password" class="form-input" type="password" @bind-Value="_model.NewPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => _model.NewPassword" />
                </div>
                <div class="form-field">
                    <label class="form-label" for="confirm-password">Confirm new password</label>
                    <InputText id="confirm-password" class="form-input" type="password" @bind-Value="_model.ConfirmNewPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => _model.ConfirmNewPassword" />
                </div>
            </div>

            <p class="auth-footnote">Use at least 8 characters with uppercase, lowercase, a number, and a special character.</p>

            <div class="auth-actions">
                <button type="submit" class="btn btn-primary auth-btn" disabled="@_submitting">
                    @(_submitting ? "Resetting..." : "Reset password")
                </button>
                <a class="btn btn-secondary auth-btn auth-outline" href="/login">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private readonly PasswordResetModel _model = new();
    private bool _submitting;
    private bool _completed;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _submitting = true;

        try
        {
            var response = await AuthService.ForgotPasswordConfirmAsync(new ForgotPasswordConfirmRequest
            {
                Token = Token ?? string.Empty,
                NewPassword = _model.NewPassword,
                ConfirmNewPassword = _model.ConfirmNewPassword
            });

            if (response.Success)
            {
                _completed = true;
            }
            else
            {
                _errorMessage = response.Message ?? "Password reset failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Password reset failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class PasswordResetModel
    {
        [Required(ErrorMessage = "New password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm the new password.")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
