@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration

<PageTitle>Sign In - Fleet Information System</PageTitle>

<div class="auth-card">
    <img src="http://www.gfleet.gov.za/images/top.jpg" alt="Gauteng Provincial Government" class="auth-logo" />

    @if (_isAuthenticated)
    {
        <div class="auth-header">
            <h1>Already Signed In</h1>
            <p>You're already authenticated.</p>
        </div>
        <div class="auth-actions">
            <a class="btn btn-primary auth-btn" href="/home">
                Go to Home
            </a>
            <form method="post" action="/Account/Logout" class="auth-logout-form">
                <button type="submit" class="btn btn-secondary auth-btn auth-outline auth-logout-btn">
                    Sign Out
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="auth-header">
            <h1>Fleet Information System</h1>
            <p>Choose how you want to sign in.</p>
        </div>
        <div class="auth-actions">
            @if (_isMicrosoftSignInConfigured)
            {
                <a class="btn btn-primary auth-btn" href="/MicrosoftIdentity/Account/SignIn">
                    Sign in with Microsoft
                </a>
            }
            <a class="btn btn-secondary auth-btn auth-outline" href="/login/legacy">
                Password Sign In
            </a>
        </div>
        <p class="auth-footnote">
            Authorized Gauteng Provincial Government staff only.
        </p>
    }
</div>

@code {
    private bool _isAuthenticated = false;
    private bool _isMicrosoftSignInConfigured = false;

    protected override async Task OnInitializedAsync()
    {
        _isMicrosoftSignInConfigured = !string.IsNullOrWhiteSpace(Configuration["AzureAd:ClientId"]);

        // Check if user is authenticated (but don't redirect - prevents loop)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
    }
}
