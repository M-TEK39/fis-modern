@page "/login"
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout

<PageTitle>Sign In - Fleet Information System</PageTitle>

<div class="auth-card">
    <img src="http://www.gfleet.gov.za/images/top.jpg" alt="Gauteng Provincial Government" class="auth-logo" />
    <div class="auth-header">
        <h1>Fleet Information System</h1>
        <p>Choose how you want to sign in.</p>
    </div>
    <div class="auth-actions">
        <a class="btn btn-primary auth-btn" href="/MicrosoftIdentity/Account/SignIn">
            Sign in with Microsoft
        </a>
        <a class="btn btn-secondary auth-btn auth-outline" href="/login/legacy">
            Legacy Sign In
        </a>
    </div>
    <p class="auth-footnote">
        Authorized Gauteng Provincial Government staff only.
    </p>
</div>
