@page "/reports/audit-trail"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Audit Trail Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-history"></i>
            Audit Trail Reports
        </h1>
        <p class="page-description">Legacy audit trail report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/finance/audit-trail">Finance Audit Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Audit Trail Report Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("department")'>1) Audit Trail grouped by Department in a date range</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("site")'>2) Audit Trail grouped by Site in a date range</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle")'>3) Audit Trail grouped per Vehicle in a date range</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">4) Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/audit-trail">Back to Audit Trail Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/audit-trail" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/audit-trail", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "department" => "audit-trail-department",
        "site" => "audit-trail-site",
        "vehicle" => "audit-trail-vehicle",
        _ => "audit-trail"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "department" => "Audit Trail grouped by Department in a date range",
        "site" => "Audit Trail grouped by Site in a date range",
        "vehicle" => "Audit Trail grouped per Vehicle in a date range",
        _ => "Audit Trail Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "department" => "department",
            "site" => "site",
            "vehicle" => "vehicle",
            _ => "department"
        };
}
