@page "/reports/audit-trail"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Audit Trail Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-history"></i>
            Audit Trail Reports
        </h1>
        <p class="page-description">Audit trail entries for report access and generation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/finance/audit-trail">Finance Audit Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Search</label>
                        <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="Report type, action, user, audit id" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Report Type</label>
                        <select class="form-select" @bind="_reportType">
                            <option value="all">All</option>
                            @foreach (var reportType in _reportTypes)
                            {
                                <option value="@reportType">@reportType</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResultsAsync">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadReportAsync" disabled="@_loading">Preview Modern Table</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    @if (_isResultView)
    {
        <LegacyDynamicReportGrid ReportKey="audit-trail" FiltersUrl="@_pageRoute" />
    }
    else
    {

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Audit Trail Activity</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card fis-mb-075">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Report Type</th>
                        <th>Action</th>
                        <th>User</th>
                        <th>Accessed Date</th>
                        <th>Audit ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="5">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="5">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.ReportType</td>
                                <td>@row.Action</td>
                                <td>@ValueOrDash(row.UserId)</td>
                                <td>@FormatDate(row.AccessedDate)</td>
                                <td>@row.AuditId</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showFieldSelector;
    private string _searchTerm = string.Empty;
    private string _reportType = "all";
    private List<ReportAuditRow> _rows = new();
    private List<string> _reportTypes = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private readonly List<ExportField> _exportFields =
    [
        new("report_type", "Report Type", true),
        new("action", "Action", true),
        new("user", "User", true),
        new("accessed_date", "Accessed Date", true),
        new("audit_id", "Audit ID", true)
    ];

    private List<ReportAuditRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));


    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);
    private const string _pageRoute = "/reports/audit-trail";
    private string? _lastAutoLoadUri;

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? QSearch { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QRtype { get; set; }

    protected override Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        if (_isResultView && uri != _lastAutoLoadUri)
        {
            _lastAutoLoadUri = uri;
            ApplyQueryFilters();
        }
        return Task.CompletedTask;
    }

    private Dictionary<string, string?> BuildQueryFilters() => new()
    {
        { "search", _searchTerm },
        { "rtype", _reportType },
    };

    private void ApplyQueryFilters()
    {
        _searchTerm = QSearch ?? string.Empty;
        _reportType = QRtype ?? "all";
    }

    private void NavigateToResultsAsync()
    {
        _lastAutoLoadUri = null;
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl(_pageRoute, BuildQueryFilters()));
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var report = await ReportService.GetReportAuditTrailAsync();
            var rows = report.Entries.Select(entry => new ReportAuditRow
            {
                ReportType = entry.ReportType,
                Action = entry.Action,
                UserId = entry.UserId,
                AccessedDate = entry.AccessedDate,
                AuditId = entry.AuditId
            });

            _reportTypes = rows
                .Select(r => r.ReportType)
                .Where(r => !string.IsNullOrWhiteSpace(r))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(r => r)
                .ToList();

            if (_reportType != "all")
            {
                rows = rows.Where(r => string.Equals(r.ReportType, _reportType, StringComparison.OrdinalIgnoreCase));
            }

            var q = _searchTerm.Trim();
            if (!string.IsNullOrWhiteSpace(q))
            {
                rows = rows.Where(r =>
                    Contains(r.ReportType, q)
                    || Contains(r.Action, q)
                    || Contains(r.UserId, q)
                    || r.AuditId.ToString().Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            _rows = rows
                .OrderByDescending(r => r.AccessedDate)
                .ThenBy(r => r.ReportType)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading audit trail report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _reportType = "all";
    }

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "report_type" => row.ReportType,
                "action" => row.Action,
                "user" => ValueOrDash(row.UserId),
                "accessed_date" => FormatDate(row.AccessedDate),
                "audit_id" => row.AuditId.ToString(),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"audit_trail_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }

    private sealed class ReportAuditRow
    {
        public string ReportType { get; set; } = "-";
        public string Action { get; set; } = "-";
        public string UserId { get; set; } = "-";
        public DateTime AccessedDate { get; set; }
        public int AuditId { get; set; }
    }
}
