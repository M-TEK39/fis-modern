@page "/reports/vehicles"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Vehicle Reports
        </h1>
        <p class="page-description">Vehicle list report by GG/GP search with status and site context.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadVehiclesAsync" disabled="_loading">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearSearch">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Vehicle Report</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Vehicle</th>
                        <th>Make/Model</th>
                        <th>Status</th>
                        <th>Site</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading report...</td></tr>
                    }
                    else if (_vehicles.Count == 0)
                    {
                        <tr><td colspan="6">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var vehicle in _vehicles)
                        {
                            <tr>
                                <td>@ValueOrDash(vehicle.fleet_number)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@GetVehicleLabel(vehicle)</td>
                                <td>@ValueOrDash(vehicle.model_name)</td>
                                <td>@ValueOrDash(vehicle.status_description)</td>
                                <td>@ValueOrDash(vehicle.location_description)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private bool _loading;
    private List<VehicleDto> _vehicles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVehiclesAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        _loading = true;
        try
        {
            var query = _searchTerm.Trim();
            var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 250, search: string.IsNullOrWhiteSpace(query) ? null : query);
            _vehicles = string.IsNullOrWhiteSpace(query)
                ? page.Data
                : RankVehicleMatches(page.Data, query, _searchMode);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicle report: {ex.Message}");
            _vehicles = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicles = new();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
}
