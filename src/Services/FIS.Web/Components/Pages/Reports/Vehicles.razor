@page "/reports/vehicles"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Vehicle Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Vehicle Reports
        </h1>
        <p class="page-description">Legacy vehicle report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Vehicle Report Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-by-number")'>1) Information On A Vehicle BY GG, Registration, Engine or Chassis Number</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-by-barcode")'>2) Information On A Vehicle BY barcode</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-vehicles")'>3) Information On All Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-with-history")'>4) Information On Vehicles With A History</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("selected-vehicles")'>5) Report For Selected Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("older-than-5y-over-120k")'>6) Vehicles Older Than 5 Years And Done More Than 120000 km's</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("older-than-5y-over-120k-period")'>7) Vehicles Older Than 5 Years And Done More Than 120000 km's WITH km's Travelled for a period</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("provincial-numbers")'>8) Vehicles With Provincial Numbers</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("value-inservice")'>9) Value Of IN SERVICE Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("inservice-per-gg")'>10) All IN SERVICE Vehicles per GG Number</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("inservice-per-dept")'>11) All IN SERVICE Vehicles per Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("inservice-wesbank")'>12) All IN SERVICE Vehicles with Departments or Blank (for Wesbank)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-with-barcodes")'>13) All vehicles with barcodes</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("replaced-per-dept")'>14) All vehicles replaced/not replaced per Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("lpg-converted")'>15) All LPG Converted Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("extended-service")'>16) All Extended Service Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-extras")'>17) All Vehicles fitted with Extra's e.g."Tyre Safety Bands", "Netstar"</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-els-manual")'>18) Information On Vehicles on ELS or Manual LOGSHEET</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("universal-selected")'>19) Universal report for selected vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/vehicles">Back to Vehicle Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/vehicles" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/vehicles", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "vehicle-by-number" => "vehicles",
        "vehicle-by-barcode" => "vehicle-by-barcode",
        "all-vehicles" => "vehicles",
        "vehicles-with-history" => "vehicles-with-history",
        "selected-vehicles" => "vehicles-selected",
        "older-than-5y-over-120k" => "vehicles-older-than-5y-over-120k",
        "older-than-5y-over-120k-period" => "vehicles-older-than-5y-over-120k-period",
        "provincial-numbers" => "vehicles-provincial-numbers",
        "value-inservice" => "vehicles-value-inservice",
        "inservice-per-gg" => "vehicles-inservice-per-gg",
        "inservice-per-dept" => "vehicles-inservice-per-dept",
        "inservice-wesbank" => "vehicles-inservice-wesbank",
        "all-with-barcodes" => "vehicles-with-barcodes",
        "replaced-per-dept" => "vehicles-replaced-per-dept",
        "lpg-converted" => "vehicles-lpg-converted",
        "extended-service" => "vehicles-extended-service",
        "vehicle-extras" => "vehicles-extras",
        "vehicles-els-manual" => "vehicles-els-manual",
        "universal-selected" => "vehicles-universal-selected",
        _ => "vehicles"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "vehicle-by-number" => "Information On A Vehicle BY GG, Registration, Engine or Chassis Number",
        "vehicle-by-barcode" => "Information On A Vehicle BY barcode",
        "all-vehicles" => "Information On All Vehicles",
        "vehicles-with-history" => "Information On Vehicles With A History",
        "selected-vehicles" => "Report For Selected Vehicles",
        "older-than-5y-over-120k" => "Vehicles Older Than 5 Years And Done More Than 120000 km's",
        "older-than-5y-over-120k-period" => "Vehicles Older Than 5 Years And Done More Than 120000 km's WITH km's Travelled for a period",
        "provincial-numbers" => "Vehicles With Provincial Numbers",
        "value-inservice" => "Value Of IN SERVICE Vehicles",
        "inservice-per-gg" => "All IN SERVICE Vehicles per GG Number",
        "inservice-per-dept" => "All IN SERVICE Vehicles per Department",
        "inservice-wesbank" => "All IN SERVICE Vehicles with Departments or Blank (for Wesbank)",
        "all-with-barcodes" => "All vehicles with barcodes",
        "replaced-per-dept" => "All vehicles replaced/not replaced per Department",
        "lpg-converted" => "All LPG Converted Vehicles",
        "extended-service" => "All Extended Service Vehicles",
        "vehicle-extras" => "All Vehicles fitted with Extra's e.g. Tyre Safety Bands, Netstar",
        "vehicles-els-manual" => "Information On Vehicles on ELS or Manual LOGSHEET",
        "universal-selected" => "Universal report for selected vehicles",
        _ => "Vehicle Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "vehicle-by-number" => "vehicle-by-number",
            "vehicle-by-barcode" => "vehicle-by-barcode",
            "all-vehicles" => "all-vehicles",
            "vehicles-with-history" => "vehicles-with-history",
            "selected-vehicles" => "selected-vehicles",
            "older-than-5y-over-120k" => "older-than-5y-over-120k",
            "older-than-5y-over-120k-period" => "older-than-5y-over-120k-period",
            "provincial-numbers" => "provincial-numbers",
            "value-inservice" => "value-inservice",
            "inservice-per-gg" => "inservice-per-gg",
            "inservice-per-dept" => "inservice-per-dept",
            "inservice-wesbank" => "inservice-wesbank",
            "all-with-barcodes" => "all-with-barcodes",
            "replaced-per-dept" => "replaced-per-dept",
            "lpg-converted" => "lpg-converted",
            "extended-service" => "extended-service",
            "vehicle-extras" => "vehicle-extras",
            "vehicles-els-manual" => "vehicles-els-manual",
            "universal-selected" => "universal-selected",
            _ => "all-vehicles"
        };
}
