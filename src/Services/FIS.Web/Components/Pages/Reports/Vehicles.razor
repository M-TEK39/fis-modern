@page "/reports/vehicles"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Vehicle Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Vehicle Reports
        </h1>
        <p class="page-description">Vehicle list report with legacy-aligned model, type, status, and site descriptions.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Number Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                GP
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "ENGINE")" @onchange='() => SetSearchMode("ENGINE")' />
                                Engine
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "VIN")" @onchange='() => SetSearchMode("VIN")' />
                                VIN / Chassis
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "INVOICE")" @onchange='() => SetSearchMode("INVOICE")' />
                                Invoice
                            </label>
                        </div>
                        <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@VehicleSearchHelper.GetSearchPlaceholder(_searchMode)" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResultsAsync">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadVehiclesAsync" disabled="@_loading">Preview Modern Table</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearSearch">Reset</button>
                </div>
            </div>
        </div>
    }
    @if (_isResultView)
    {
        <LegacyDynamicReportGrid ReportKey="vehicles" FiltersUrl="@_pageRoute" />
    }
    else
    {

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Vehicle Report</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _vehicles.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Model</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Site</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading report...</td></tr>
                    }
                    else if (_vehicles.Count == 0)
                    {
                        <tr><td colspan="6">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var vehicle in _vehicles)
                        {
                            <tr>
                                <td>@ValueOrDash(vehicle.fleet_number)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@ValueOrDash(vehicle.model_name)</td>
                                <td>@ValueOrDash(vehicle.type_name)</td>
                                <td>@ValueOrDash(vehicle.status_description)</td>
                                <td>@ValueOrDash(vehicle.location_description)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>

@code {
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private bool _loading;
    private bool _showFieldSelector;
    private List<VehicleDto> _vehicles = new();
    private readonly List<ExportField> _exportFields =
    [
        new("fleet_number", "GG Number", true),
        new("registration_number", "GP Number", true),
        new("model_name", "Model", true),
        new("type_name", "Type", true),
        new("status_description", "Status", true),
        new("location_description", "Site", true)
    ];


    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);
    private const string _pageRoute = "/reports/vehicles";
    private string? _lastAutoLoadUri;

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "mode")]
    public string? QMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? QSearch { get; set; }

    protected override Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        if (_isResultView && uri != _lastAutoLoadUri)
        {
            _lastAutoLoadUri = uri;
            ApplyQueryFilters();
        }

        return Task.CompletedTask;
    }

    private Dictionary<string, string?> BuildQueryFilters() => new()
    {
        { "mode", _searchMode },
        { "search", _searchTerm },
    };

    private void ApplyQueryFilters()
    {
        _searchMode = QMode ?? "GG";
        _searchTerm = QSearch ?? string.Empty;
    }

    private void NavigateToResultsAsync()
    {
        _lastAutoLoadUri = null;
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl(_pageRoute, BuildQueryFilters()));
    }

    private async Task LoadVehiclesAsync()
    {
        _loading = true;
        try
        {
            var query = _searchTerm.Trim();
            var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 250, search: string.IsNullOrWhiteSpace(query) ? null : query);
            _vehicles = string.IsNullOrWhiteSpace(query)
                ? page.Data
                : VehicleSearchHelper.RankVehicleMatches(page.Data, query, _searchMode);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicle report: {ex.Message}");
            _vehicles = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicles = new();
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _vehicles)
        {
            var values = selected.Select(field => field.Key switch
            {
                "fleet_number" => ValueOrDash(row.fleet_number),
                "registration_number" => ValueOrDash(row.registration_number),
                "model_name" => ValueOrDash(row.model_name),
                "type_name" => ValueOrDash(row.type_name),
                "status_description" => ValueOrDash(row.status_description),
                "location_description" => ValueOrDash(row.location_description),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"vehicles_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
