@page "/reports/tariffs"
@page "/Validation/RPTtariffs.aspx"
@page "/Validation/RPT_Class_Tariff.aspx"
@page "/Validation/RPT_Licence_Tariff.aspx"
@page "/Validation/RPT_Model_Tariff.aspx"
@page "/Validation/RPT_Taxi_Tariff.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Tariffs Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calculator"></i>
            Tariffs Reports
        </h1>
        <p class="page-description">Legacy tariffs report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/validation">Validation Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Tariffs Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("class-codes-with-tariffs")'>1) Class codes with tariffs</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("licence-fees")'>2) Licence fees</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("make-model-with-tariffs")'>3) Make Model with tariffs</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("private-taxi-tariffs")'>4) Private Taxi Tariffs</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("nom-vehicles-without-tariffs")'>5) List of NOM Vehicles that don't have Tariffs</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/tariffs">Back to Tariffs Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/tariffs" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode) || !string.IsNullOrWhiteSpace(ResolveLegacyReportType());

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/tariffs", filters));
    }

    private string GetReportKey() => ResolveReportType() switch
    {
        "class-codes-with-tariffs" => "tariffs-class-codes",
        "licence-fees" => "tariffs-licence-fees",
        "make-model-with-tariffs" => "tariffs-make-model",
        "private-taxi-tariffs" => "tariffs-private-taxi",
        "nom-vehicles-without-tariffs" => "vehicles-no-tariff",
        _ => "tariffs-class-codes"
    };

    private string GetSelectedCaption() => ResolveReportType() switch
    {
        "class-codes-with-tariffs" => "Class codes with tariffs",
        "licence-fees" => "Licence fees",
        "make-model-with-tariffs" => "Make Model with tariffs",
        "private-taxi-tariffs" => "Private Taxi Tariffs",
        "nom-vehicles-without-tariffs" => "List of NOM Vehicles that don't have Tariffs",
        _ => "Tariffs Reports"
    };

    private string ResolveReportType()
    {
        var legacy = ResolveLegacyReportType();
        return string.IsNullOrWhiteSpace(legacy)
            ? NormalizeReportType(QReportType)
            : legacy;
    }

    private string ResolveLegacyReportType()
    {
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "validation/rpt_class_tariff.aspx" => "class-codes-with-tariffs",
            "validation/rpt_licence_tariff.aspx" => "licence-fees",
            "validation/rpt_model_tariff.aspx" => "make-model-with-tariffs",
            "validation/rpt_taxi_tariff.aspx" => "private-taxi-tariffs",
            _ => string.Empty
        };
    }

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "class-codes-with-tariffs" => "class-codes-with-tariffs",
            "licence-fees" => "licence-fees",
            "make-model-with-tariffs" => "make-model-with-tariffs",
            "private-taxi-tariffs" => "private-taxi-tariffs",
            "nom-vehicles-without-tariffs" => "nom-vehicles-without-tariffs",
            _ => "class-codes-with-tariffs"
        };
}
