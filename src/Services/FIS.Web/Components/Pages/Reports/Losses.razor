@page "/reports/losses"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject LossReportApiService ReportService
@inject IJSRuntime JS

<PageTitle>Losses Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Losses Reports
        </h1>
        <p class="page-description">Legacy placeholder for losses/Losses.aspx.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses/reports")'>Open Losses Reports</button>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-file"></i>
        <h3>Losses Reports pending</h3>
        <p>This page will mirror the legacy report.</p>
        <button class="btn btn-primary btn-sm" @onclick="TestEndpoint">Ping Losses Report Endpoint</button>
    </div>
</div>

@code {
    private async Task TestEndpoint()
    {
        try
        {
            await ReportService.GetAllAsync<Dictionary<string, object>>(new { });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error pinging losses report endpoint: {ex.Message}");
        }
    }
}
