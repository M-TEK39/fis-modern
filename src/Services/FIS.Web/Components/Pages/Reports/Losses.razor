@page "/reports/losses"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Losses Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-error"></i>
            Losses Reports
        </h1>
        <p class="page-description">Legacy losses report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/losses">Losses Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Losses Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Losses for one vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-losses-sorted")'>2) All Losses Sorted By Loss type, Department number GG number or Loss Date</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("outstanding-report")'>3) Losses where Report from Department is outstanding</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("with-report")'>4) Losses where Reports from Departments were supplied</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("site-period-vip-gg-hire")'>5) Losses Report for a Site, for a Period, for VIP/GG, for Hire Type</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/losses">Back to Losses Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/losses" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/losses", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "losses-one-vehicle",
        "all-losses-sorted" => "losses",
        "outstanding-report" => "losses-outstanding-report",
        "with-report" => "losses-with-report",
        "site-period-vip-gg-hire" => "losses-site-period-vip-gg-hire",
        _ => "losses"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Losses for one vehicle",
        "all-losses-sorted" => "All Losses Sorted By Loss type, Department number GG number or Loss Date",
        "outstanding-report" => "Losses where Report from Department is outstanding",
        "with-report" => "Losses where Reports from Departments were supplied",
        "site-period-vip-gg-hire" => "Losses Report for a Site, for a Period, for VIP/GG, for Hire Type",
        _ => "Losses Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "all-losses-sorted" => "all-losses-sorted",
            "outstanding-report" => "outstanding-report",
            "with-report" => "with-report",
            "site-period-vip-gg-hire" => "site-period-vip-gg-hire",
            _ => "all-losses-sorted"
        };
}
