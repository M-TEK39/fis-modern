@page "/reports/losses"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject LossReportApiService ReportService
@inject IJSRuntime JS

<PageTitle>Losses Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Losses Reports
        </h1>
        <p class="page-description">Losses reporting workflow and report launcher.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses/reports")'>Open Losses Reports</button>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-file"></i>
        <h3>Losses Reports</h3>
        <p>Use this page to launch and validate losses report output.</p>
        <button class="btn btn-primary btn-sm" @onclick="ValidateReportAccessAsync">Validate Report Access</button>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-10">
                @_statusMessage
            </div>
        }
    </div>
</div>

@code {
    private bool _statusError;
    private string _statusMessage = string.Empty;

    private async Task ValidateReportAccessAsync()
    {
        try
        {
            await ReportService.GetAllAsync<Dictionary<string, object>>(new { });
            _statusError = false;
            _statusMessage = "Request completed successfully.";
        }
        catch (Exception ex)
        {
            _statusError = true;
            _statusMessage = "Unable to validate report access.";
            await JS.InvokeVoidAsync("console.error", $"Error validating losses report access: {ex.Message}");
        }
    }
}
