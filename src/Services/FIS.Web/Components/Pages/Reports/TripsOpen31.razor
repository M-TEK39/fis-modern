@page "/reports/trips-open-31"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Trips Open for Over 31 Days - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-time-five"></i>
            Trips Open for Over 31 Days
        </h1>
        <p class="page-description">Legacy open-trip exception report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/trip-authorities">Trip Authorities</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Trips that are open for over 31 days (All Departments)</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="trips-open-31" FiltersUrl="/reports/trips-open-31" />
</div>
