@page "/reports/vip-pool-income-previous"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject TripApiService TripService
@inject ContractApiService ContractService
@inject IJSRuntime JSRuntime

<PageTitle>VIP/Pool Utilization with Income (Previous Months) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar"></i>
            VIP and Pool Utilization (Previous Months Including Income)
        </h1>
        <p class="page-description">Historical month-by-month utilization and estimated income.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Historical Income Utilization</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Active Vehicles</th>
                        <th>Total Trips</th>
                        <th>Utilization %</th>
                        <th>Estimated Monthly Cost Base (R)</th>
                        <th>Estimated Income (R)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="6">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.MonthLabel</td>
                                <td>@row.ActiveVehicles</td>
                                <td>@row.TotalTrips</td>
                                <td>@row.UtilizationPercent.ToString("0.0")%</td>
                                <td>@row.MonthlyCostBase.ToString("N2")</td>
                                <td>@row.EstimatedIncome.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private List<MonthIncomeRow> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private List<MonthIncomeRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var end = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddDays(-1);
            var start = end.AddMonths(-11);

            var trips = await TripService.GetDateRangeAsync(start, end);
            var contractPage = await ContractService.GetContractsPageAsync(new ContractsPageQuery
            {
                Page = 1,
                PageSize = 5000
            });
            var monthlyCostByVmf = contractPage.Data
                .Where(c => c.vmf_code.HasValue)
                .GroupBy(c => c.vmf_code!.Value)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.contract_id).FirstOrDefault()?.monthly_cost ?? 0m);

            _rows = trips
                .Where(t => t.VmfCode > 0)
                .GroupBy(t => new DateTime(t.TripDate.Year, t.TripDate.Month, 1))
                .OrderByDescending(g => g.Key)
                .Select(g =>
                {
                    var all = g.ToList();
                    var activeVehicles = all.Select(t => t.VmfCode).Distinct().ToList();
                    var daysInMonth = DateTime.DaysInMonth(g.Key.Year, g.Key.Month);
                    var activeDays = all.Select(t => t.TripDate.Date).Distinct().Count();
                    var utilization = activeDays * 100d / Math.Max(1, daysInMonth);
                    var monthlyCostBase = activeVehicles.Sum(vmf => monthlyCostByVmf.TryGetValue(vmf, out var value) ? value : 0m);
                    var estimatedIncome = monthlyCostBase * (decimal)(utilization / 100d);
                    return new MonthIncomeRow(
                        MonthLabel: g.Key.ToString("yyyy-MM"),
                        ActiveVehicles: activeVehicles.Count,
                        TotalTrips: all.Count,
                        UtilizationPercent: utilization,
                        MonthlyCostBase: monthlyCostBase,
                        EstimatedIncome: estimatedIncome);
                })
                .ToList();

            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading VIP/pool income previous report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed record MonthIncomeRow(
        string MonthLabel,
        int ActiveVehicles,
        int TotalTrips,
        double UtilizationPercent,
        decimal MonthlyCostBase,
        decimal EstimatedIncome);
}
