@page "/reports/vip-pool-income-previous"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>VIP/Pool Utilization with Income (Previous Months) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar"></i>
            VIP and Pool Utilization (Previous Months Including Income)
        </h1>
        <p class="page-description">Legacy generated utilization+income history report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Utilization of VIP and Pool vehicles (previous months including income)</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="vip-pool-income-previous" FiltersUrl="/reports/vip-pool-income-previous" />
</div>
