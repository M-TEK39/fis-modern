@page "/reports/high-distance-dept"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>High Distance Vehicles (Department) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trending-up"></i>
            Vehicles with High Distances (Department)
        </h1>
        <p class="page-description">Legacy department high-distance report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Vehicles with high distances in department</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="high-distance-dept" FiltersUrl="/reports/high-distance-dept" />
</div>
