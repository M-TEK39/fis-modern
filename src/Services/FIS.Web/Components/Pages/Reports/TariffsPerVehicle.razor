@page "/reports/tariffs-per-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Tariffs per Vehicle (2008 and Later) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-detail"></i>
            Tariffs per Vehicle (2008 and Later)
        </h1>
        <p class="page-description">Legacy tariffs-per-vehicle report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/reports/tariffs-fin-year">Tariffs Fin Year</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">List of Tariffs per Vehicle - effective 1-Apr-2009: Vehicles where year model is 2008 and Later</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="tariffs-per-vehicle" FiltersUrl="/reports/tariffs-per-vehicle" />
</div>
