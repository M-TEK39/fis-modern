@page "/reports/logsheets"
@page "/Logs/Log_Report.aspx"
@page "/logs/RPT_outstanding1.aspx"
@page "/logs/RPT_Logs_per_vehicle.aspx"
@page "/logs/RPT_Logs_per_vehicle_1.aspx"
@page "/logs/RPT_logsheet_per_vehicle.aspx"
@page "/logs/RPT_logsheet_per_rek.aspx"
@page "/logs/RPT_uits_els_en_logs_geld_main.aspx"
@page "/logs/RPT_Logs_per_dept_1.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Log Sheet Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Log Sheet Reports
        </h1>
        <p class="page-description">Legacy log sheet report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/logsheets">Log Sheet Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Log Report Main Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Log Report On One Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-odo-balance")'>2) Report Per Vehicle - Log Odo Balance</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-contract-els-manual")'>3) Vehicle report - View: Contracts, ELS &amp; Manual Logs Details in one report</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-details-per-rek")'>4) Report Vehicle Details Per Rek num.</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-outstanding")'>5) All outstanding Logsheets</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("per-dept-site")'>6) Logsheet Report per Department or Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">7) Return to Main Report Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/logsheets">Back to Log Sheet Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/logsheets" />
    }
</div>

@code {
    private bool _isResultView => ResolveLegacyReportTypeFromPath() is not null || ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/logsheets", filters));
    }

    private string GetReportKey() => ResolveReportType() switch
    {
        "one-vehicle" => "logsheets-one-vehicle",
        "vehicle-odo-balance" => "logsheets-vehicle-odo-balance",
        "vehicle-contract-els-manual" => "vehicle-logs-report",
        "vehicle-details-per-rek" => "logsheets-vehicle-details-per-rek",
        "all-outstanding" => "logsheets-all-outstanding",
        "per-dept-site" => "logsheets",
        _ => "logsheets"
    };

    private string GetSelectedCaption() => ResolveReportType() switch
    {
        "one-vehicle" => "Log Report On One Vehicle",
        "vehicle-odo-balance" => "Report Per Vehicle - Log Odo Balance",
        "vehicle-contract-els-manual" => "Vehicle report - View: Contracts, ELS & Manual Logs Details in one report",
        "vehicle-details-per-rek" => "Report Vehicle Details Per Rek num.",
        "all-outstanding" => "All outstanding Logsheets",
        "per-dept-site" => "Logsheet Report per Department or Site",
        _ => "Log Sheet Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "vehicle-odo-balance" => "vehicle-odo-balance",
            "vehicle-contract-els-manual" => "vehicle-contract-els-manual",
            "vehicle-details-per-rek" => "vehicle-details-per-rek",
            "all-outstanding" => "all-outstanding",
            "per-dept-site" => "per-dept-site",
            _ => "per-dept-site"
        };

    private string ResolveReportType()
        => ResolveLegacyReportTypeFromPath() ?? NormalizeReportType(QReportType);

    private string? ResolveLegacyReportTypeFromPath()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();

        return path switch
        {
            "logs/rpt_outstanding1.aspx" => "one-vehicle",
            "logs/rpt_logs_per_vehicle.aspx" => "one-vehicle",
            "logs/rpt_logs_per_vehicle_1.aspx" => "vehicle-odo-balance",
            "logs/rpt_logsheet_per_vehicle.aspx" => "vehicle-contract-els-manual",
            "logs/rpt_logsheet_per_rek.aspx" => "vehicle-details-per-rek",
            "logs/rpt_uits_els_en_logs_geld_main.aspx" => "all-outstanding",
            "logs/rpt_logs_per_dept_1.aspx" => "per-dept-site",
            _ => null
        };
    }
}
