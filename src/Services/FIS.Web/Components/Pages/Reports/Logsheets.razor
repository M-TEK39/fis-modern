@page "/reports/logsheets"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject ReportCatalogApiService ReportCatalogService
@inject IJSRuntime JSRuntime

<PageTitle>Log Sheet Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Log Sheet Reports
        </h1>
        <p class="page-description">Legacy placeholder for logs/Log_Report.aspx.</p>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-file"></i>
            <h3>No reports available</h3>
            <p>Report catalog unavailable or empty.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_reports.Count report(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in _reports)
                        {
                            <tr>
                                <td>@report.Name</td>
                                <td>@report.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


    <LegacyEndpointActionPanel
        LegacyPath="Logs/Log_Report.aspx"
        Endpoint="api/logsheet/reports/menu"
        HttpMethod="GET"
        ButtonText="Test Logsheet Reports Menu Endpoint"
        ReportType="logsheet-reports-menu" />

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Logs_per_vehicle.aspx"
        Endpoint="api/logsheet/reports/one-vehicle"
        HttpMethod="POST"
        ButtonText="Test Logsheet One Vehicle Report Endpoint"
        ReportType="logsheet-report-one-vehicle" />

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_logsheet_per_rek.aspx"
        Endpoint="api/logsheet/reports/one-requisition"
        HttpMethod="POST"
        ButtonText="Test Logsheet One Requisition Report Endpoint"
        ReportType="logsheet-report-one-requisition" />

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Logs_per_Dept_1.aspx"
        Endpoint="api/logsheet/reports/department-period"
        HttpMethod="POST"
        ButtonText="Test Logsheet Department Period Report Endpoint"
        ReportType="logsheet-report-department-period" />

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Logs_captured_1.aspx"
        Endpoint="api/logsheet/reports/captured"
        HttpMethod="POST"
        ButtonText="Test Logsheet Captured Report Endpoint"
        ReportType="logsheet-report-captured" />

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Log_per_year.aspx"
        Endpoint="api/logsheet/reports/total-km-per-class-code"
        HttpMethod="POST"
        ButtonText="Test Logsheet Total KM Report Endpoint"
        ReportType="logsheet-report-total-km" />

@code {
    private bool _loading = true;
    private List<ReportDto> _reports = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports = await ReportCatalogService.GetAvailableAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
