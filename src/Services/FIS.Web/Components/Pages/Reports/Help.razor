@page "/reports/help"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>Reports Maintenance Information / Help - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Reports Maintenance Information / Help
        </h1>
        <p class="page-description">Reference guidance for report flows and usage.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading help content...</p>
        </div>
    }
    else if (_sections.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No help content available</h3>
            <p>No structured help content is available right now.</p>
        </div>
    }
    else
    {
        @foreach (var item in _sections)
        {
            <div class="form-card fis-mb-15">
                <div class="form-card-header">
                    <h3>@item.Title</h3>
                </div>
                <div class="form-card-body">
                    <p>@item.Content</p>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading;
    private List<HelpSection> _sections = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHelpAsync();
    }

    private async Task LoadHelpAsync()
    {
        _loading = true;
        try
        {
            var help = await ReportService.GetHelpAsync();
            if (help.Sections.Count == 0)
            {
                _sections = BuildFallbackHelp();
                return;
            }

            _sections = help.Sections
                .Select(s => new HelpSection(s.Title, s.Content))
                .Where(s => !string.IsNullOrWhiteSpace(s.Content))
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading reports help: {ex.Message}");
            _sections = BuildFallbackHelp();
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<HelpSection> BuildFallbackHelp()
    {
        return
        [
            new("Report Navigation", "Use Reports Maintenance Menu for quick report shortcuts and FIS Report Menu for full module-specific reporting."),
            new("Date Ranges", "When supplying date filters, use From/To values in chronological order. If reversed, the system normalizes automatically."),
            new("Vehicle Identifiers", "Most reports accept GG Number, GP Registration Number or VMF code. Exact matches are ranked first."),
            new("Workflow Reports", "Contract and vehicle workflow statuses are available in report tables to support review and approval tracking.")
        ];
    }

    private sealed record HelpSection(string Title, string Content);
}
