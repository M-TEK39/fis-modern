@page "/reports/high-distance-all"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>High Distance Vehicles (All Departments) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-line-chart"></i>
            Vehicles with High Distances (All Departments)
        </h1>
        <p class="page-description">Legacy all-departments high-distance report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Vehicles with high distances in all departments (Per Department)</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="high-distance-all" FiltersUrl="/reports/high-distance-all" />
</div>
