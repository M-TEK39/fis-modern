@page "/reports"
@rendermode InteractiveServer

<PageTitle>Reports Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file-find"></i>
            Reports Maintenance Menu
        </h1>
        <p class="page-description">Reports maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Reports Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/help">Reports Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Available Reports</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/trip-authority">Trip Authority Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/fis-report">FIS Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/system-audit-trail">System Audit Trail (Entity Changes, User Status &amp; Password History)</a>
                    <span class="menu-item-badge">Audit</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Quick Links - Frequently Used Reports</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-info">1) General Vehicle Information Report (New!!!)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/contracts">2) Contract Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/contract-history">2.2) Contract History</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/departments-sites">3) Department &amp; Site Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/unallocated-vehicles">4) Un-allocated vehicles</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/high-distance-dept">5) Vehicles with high distances in department</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/high-distance-all">6) Vehicles with high distances in all departments (Per Department)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/trips-open-31">7) View Trips that are open for over 31 days (All Departments)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-logs-report">8) Vehicle report - View: Contracts, ELS &amp; Manual Logs Details in one report</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/asset-list">9) Asset List: All Vehicles in FIS with status New &amp; In-Service</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-status-range">9.1) View list of vehicles of a selected 'Vehicle Status' in a Date Range</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-status-all">9.2) All Vehicle Status</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/incorrect-quantities">9.3) Report to show incorrect calculated quantities</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vip-self-drive-utilization">9.4) VIP Self-Drive Rental Utilization (Actual Check-out / Check-in Days)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vip-pool-utilization-current">9.5) Utilization of VIP and Pool vehicles ( H.O.D. report - current month )</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vip-pool-utilization-previous">9.5.1) Utilization of VIP and Pool vehicles ( H.O.D. report - previous months )</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vip-pool-income-current">9.6) Utilization of VIP and Pool vehicles ( current month, including income )</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vip-pool-income-previous">9.6.1) Utilization of VIP and Pool vehicles ( previous months including income )</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicles-no-tariff">9.7) List of Vehicles with Expired or No Tariff Loaded (New and In Service)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/previous-fin-year">10.1) List of Previous Fin Year transactions but captured in current fin year (All Depts)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-additions">10.2) All Vehicle ADDITIONS in a date range</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-disposals">10.3) All Vehicle "DISPOSALS" in a date range</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/vehicle-list-date-range">10.4) List of "VEHICLES" in a Selected DATE RANGE (ie: Fleet List showing all veh. statuses)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/capture-activity">10.5) Capture Activity Report (All Modules)</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/tariffs-fin-year">11) View List of Published Tariffs in a Financial Year.</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Published Tariffs</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/tariffs-class-2007">12) List of Tariffs by Class groupings: All vehicles with year model 2007 and Earlier.</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/reports/tariffs-per-vehicle">13) List of Tariffs per Vehicle - effective 1-Apr-2009: Vehicles where year model is 2008 and Later.</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Report Catalog Preview"
                      SearchPlaceholder="Search report name, category, route..."
                      EmptyMessage="No reports match the current search or filter."
                      EmptyIcon="bx bx-file-find"
                      IsLoading="false"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("category", "Category"),
        new("name", "Report"),
        new("route", "Route"),
        new("type", "Type")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Vehicle reports", "category", "Vehicle"),
        new("Contract reports", "category", "Contract"),
        new("Audit reports", "category", "Audit"),
        new("Tariff reports", "category", "Tariff"),
        new("Trip reports", "category", "Trip")
    ];

    private readonly IReadOnlyList<Dictionary<string, string?>> _rows =
    [
        Row("Trip", "Trip Authority Reports", "/reports/trip-authority", "Menu"),
        Row("FIS", "FIS Reports", "/reports/fis-report", "Menu"),
        Row("Audit", "System Audit Trail", "/reports/system-audit-trail", "Audit"),
        Row("Vehicle", "General Vehicle Information Report", "/reports/vehicle-info", "Menu"),
        Row("Contract", "Contract Reports", "/reports/contracts", "Menu"),
        Row("Contract", "Contract History", "/reports/contract-history", "Menu"),
        Row("Department", "Department & Site Reports", "/reports/departments-sites", "Menu"),
        Row("Vehicle", "Un-allocated vehicles", "/reports/unallocated-vehicles", "Menu"),
        Row("Vehicle", "Vehicles with high distances in department", "/reports/high-distance-dept", "Menu"),
        Row("Vehicle", "Vehicles with high distances in all departments", "/reports/high-distance-all", "Menu"),
        Row("Trip", "Trips open for over 31 days", "/reports/trips-open-31", "Menu"),
        Row("Vehicle", "Vehicle contracts, ELS and manual logs", "/reports/vehicle-logs-report", "Menu"),
        Row("Vehicle", "Asset List", "/reports/asset-list", "Menu"),
        Row("Vehicle", "Vehicle Status Date Range", "/reports/vehicle-status-range", "Menu"),
        Row("Vehicle", "All Vehicle Status", "/reports/vehicle-status-all", "Menu"),
        Row("Vehicle", "Incorrect calculated quantities", "/reports/incorrect-quantities", "Menu"),
        Row("Vehicle", "VIP Self-Drive Rental Utilization", "/reports/vip-self-drive-utilization", "Menu"),
        Row("Vehicle", "VIP and Pool Utilization Current Month", "/reports/vip-pool-utilization-current", "Menu"),
        Row("Vehicle", "VIP and Pool Utilization Previous Months", "/reports/vip-pool-utilization-previous", "Menu"),
        Row("Vehicle", "Vehicles with Expired or No Tariff Loaded", "/reports/vehicles-no-tariff", "Menu"),
        Row("Finance", "Previous financial year transactions", "/reports/previous-fin-year", "Menu"),
        Row("Vehicle", "Vehicle Additions", "/reports/vehicle-additions", "Menu"),
        Row("Vehicle", "Vehicle Disposals", "/reports/vehicle-disposals", "Menu"),
        Row("Vehicle", "Vehicle List Date Range", "/reports/vehicle-list-date-range", "Menu"),
        Row("Audit", "Capture Activity Report", "/reports/capture-activity", "Menu"),
        Row("Tariff", "Published Tariffs by Financial Year", "/reports/tariffs-fin-year", "Menu"),
        Row("Tariff", "Tariffs by Class Groupings", "/reports/tariffs-class-2007", "Menu"),
        Row("Tariff", "Tariffs per Vehicle", "/reports/tariffs-per-vehicle", "Menu")
    ];

    private static Dictionary<string, string?> Row(string category, string name, string route, string type)
    {
        return new Dictionary<string, string?>
        {
            ["category"] = category,
            ["name"] = name,
            ["route"] = route,
            ["type"] = type
        };
    }
}
