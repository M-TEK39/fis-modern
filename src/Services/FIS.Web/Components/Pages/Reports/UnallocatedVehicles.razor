@page "/reports/unallocated-vehicles"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Un-allocated Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-git-branch"></i>
            Un-allocated Vehicles
        </h1>
        <p class="page-description">Legacy un-allocated vehicles report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Un-allocated vehicles Report</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports/fis-report">Back to FIS Report Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="unallocated-vehicles" FiltersUrl="/reports/unallocated-vehicles" />
</div>
