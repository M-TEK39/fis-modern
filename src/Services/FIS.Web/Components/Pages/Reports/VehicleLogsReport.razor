@page "/reports/vehicle-logs-report"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject LogbookApiService LogbookService
@inject LogsheetApiService LogsheetService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Logs Report - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            Vehicle Report - Contracts, ELS &amp; Manual Logs
        </h1>
        <p class="page-description">Combined report per vehicle for contracts, logbooks and logsheets.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                        <option value="">Select vehicle</option>
                        @foreach (var vehicle in _vehicleMatches)
                        {
                            <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync" disabled="@_loading">Find</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="@(_loading || !_selectedVmfCode.HasValue)">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Vehicle Logs Summary</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleSummaryFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadSummaryCsvAsync" disabled="@(_loading || _selectedVehicle is null)">Download CSV</button>
            </div>
        </div>
        @if (_showSummaryFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _summaryExportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Active Contract</th>
                        <th>Total Contracts (Window)</th>
                        <th>Manual Logbooks</th>
                        <th>ELS Logsheets</th>
                        <th>Last Log Month</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading report...</td></tr>
                    }
                    else if (_selectedVehicle is null)
                    {
                        <tr><td colspan="6">Select a vehicle to view report.</td></tr>
                    }
                    else
                    {
                        <tr>
                            <td>@GetVehicleLabel(_selectedVehicle)</td>
                            <td>@(_activeContractId?.ToString() ?? "-")</td>
                            <td>@_contractHistoryCount</td>
                            <td>@_logbookCount</td>
                            <td>@_logsheetCount</td>
                            <td>@(_lastLogMonth?.ToString("yyyy-MM") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">ELS Logsheets</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleLogsheetFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadLogsheetCsvAsync" disabled="@(_loading || _vehicleLogsheets.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showLogsheetFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _logsheetExportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Log ID</th>
                        <th>Month</th>
                        <th>Start ODO</th>
                        <th>End ODO</th>
                        <th>Site</th>
                        <th>Days Used</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading logsheets...</td></tr>
                    }
                    else if (PagedLogsheets.Count == 0)
                    {
                        <tr><td colspan="6">No logsheets found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedLogsheets)
                        {
                            <tr>
                                <td>@row.log_code</td>
                                <td>@row.month.ToString("yyyy-MM")</td>
                                <td>@row.start_odo.ToString("N0")</td>
                                <td>@row.end_odo.ToString("N0")</td>
                                <td>@GetSiteLabel(row.site_code)</td>
                                <td>@(row.days_used?.ToString() ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_vehicleLogsheets.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_vehicleLogsheets.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private int? _selectedVmfCode;
    private List<VehicleDto> _vehicleMatches = new();
    private VehicleDto? _selectedVehicle;
    private int? _activeContractId;
    private int _contractHistoryCount;
    private int _logbookCount;
    private int _logsheetCount;
    private DateTime? _lastLogMonth;
    private List<LogsheetDto> _vehicleLogsheets = new();
    private Dictionary<short, string> _siteLabels = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private bool _showSummaryFieldSelector;
    private bool _showLogsheetFieldSelector;
    private readonly List<ExportField> _summaryExportFields =
    [
        new("vehicle", "Vehicle", true),
        new("active_contract", "Active Contract", true),
        new("total_contracts", "Total Contracts (Window)", true),
        new("manual_logbooks", "Manual Logbooks", true),
        new("els_logsheets", "ELS Logsheets", true),
        new("last_log_month", "Last Log Month", true)
    ];
    private readonly List<ExportField> _logsheetExportFields =
    [
        new("log_id", "Log ID", true),
        new("month", "Month", true),
        new("start_odo", "Start ODO", true),
        new("end_odo", "End ODO", true),
        new("site", "Site", true),
        new("days_used", "Days Used", true)
    ];

    private List<LogsheetDto> PagedLogsheets => _vehicleLogsheets.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_vehicleLogsheets.Count / (double)_pageSize));

    private async Task SearchVehiclesAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            _selectedVehicle = null;
            return;
        }

        _loading = true;
        try
        {
            var query = _searchTerm.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = RankVehicleMatches(matches, query, _searchMode);
            _vehicleLogsheets = new();
            _selectedVehicle = null;

            if (_vehicleMatches.All(v => v.vmf_code != _selectedVmfCode))
            {
                _selectedVmfCode = null;
                _selectedVehicle = null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error searching vehicle logs report: {ex.Message}");
            _vehicleMatches = new();
            _selectedVehicle = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadReportAsync()
    {
        if (!_selectedVmfCode.HasValue)
        {
            _selectedVehicle = null;
            _vehicleLogsheets = new();
            return;
        }

        _loading = true;
        try
        {
            if (_siteLabels.Count == 0)
            {
                var sites = await SiteService.GetAllAsync();
                _siteLabels = sites
                    .GroupBy(s => s.SiteCode)
                    .ToDictionary(
                        g => g.Key,
                        g => $"{ValueOrDash(g.First().Description)} ({g.Key})");
            }

            _selectedVehicle = _vehicleMatches.FirstOrDefault(v => v.vmf_code == _selectedVmfCode.Value)
                ?? await VehicleService.GetVehicleAsync(_selectedVmfCode.Value);

            var activeContract = await ContractService.GetLatestContractForVehicleAsync(_selectedVmfCode.Value);
            _activeContractId = activeContract?.contract_id;

            var contractWindow = await ContractService.GetRecentContractsWindowAsync();
            _contractHistoryCount = contractWindow.Count(c => c.vmf_code == _selectedVmfCode.Value);

            var logbooks = await LogbookService.GetAllAsync<LogbookDto>();
            _logbookCount = logbooks.Count(l => l.vmf_code == _selectedVmfCode.Value);

            var logsheets = await LogsheetService.GetAllAsync<LogsheetDto>();
            _vehicleLogsheets = logsheets
                .Where(l => l.vmf_code == _selectedVmfCode.Value)
                .OrderByDescending(l => l.month)
                .ToList();
            _logsheetCount = _vehicleLogsheets.Count;
            _lastLogMonth = _vehicleLogsheets.FirstOrDefault()?.month;
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicle logs report: {ex.Message}");
            _vehicleLogsheets = new();
            _selectedVehicle = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _selectedVmfCode = null;
        _selectedVehicle = null;
        _vehicleMatches = new();
        _vehicleLogsheets = new();
        _activeContractId = null;
        _contractHistoryCount = 0;
        _logbookCount = 0;
        _logsheetCount = 0;
        _lastLogMonth = null;
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _selectedVehicle = null;
        _vehicleLogsheets = new();
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string GetSiteLabel(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        return _siteLabels.TryGetValue(siteCode.Value, out var label)
            ? label
            : siteCode.Value.ToString();
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleSummaryFieldSelector()
    {
        _showSummaryFieldSelector = !_showSummaryFieldSelector;
    }

    private void ToggleLogsheetFieldSelector()
    {
        _showLogsheetFieldSelector = !_showLogsheetFieldSelector;
    }

    private async Task DownloadSummaryCsvAsync()
    {
        if (_selectedVehicle is null)
        {
            return;
        }

        var selected = _summaryExportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        var values = selected.Select(field => field.Key switch
        {
            "vehicle" => GetVehicleLabel(_selectedVehicle),
            "active_contract" => _activeContractId?.ToString() ?? "-",
            "total_contracts" => _contractHistoryCount.ToString(),
            "manual_logbooks" => _logbookCount.ToString(),
            "els_logsheets" => _logsheetCount.ToString(),
            "last_log_month" => _lastLogMonth?.ToString("yyyy-MM") ?? "-",
            _ => "-"
        });
        lines.Add(string.Join(",", values.Select(CsvCell)));

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"vehicle_logs_summary_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private async Task DownloadLogsheetCsvAsync()
    {
        var selected = _logsheetExportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        foreach (var row in _vehicleLogsheets)
        {
            var values = selected.Select(field => field.Key switch
            {
                "log_id" => row.log_code.ToString(),
                "month" => row.month.ToString("yyyy-MM"),
                "start_odo" => row.start_odo.ToString("N0"),
                "end_odo" => row.end_odo.ToString("N0"),
                "site" => GetSiteLabel(row.site_code),
                "days_used" => row.days_used?.ToString() ?? "-",
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"vehicle_logs_els_logsheets_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
