@page "/reports/logbooks"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportCatalogApiService ReportCatalogService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Logbook Reports
        </h1>
        <p class="page-description">Browse available logbook reports.</p>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-file"></i>
            <h3>No reports available</h3>
            <p>Report catalog unavailable or empty.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_reports.Count report(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in PagedReports)
                        {
                            <tr>
                                <td>@report.Name</td>
                                <td>@report.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<ReportDto> _reports = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<ReportDto> PagedReports => _reports.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_reports.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports = await ReportCatalogService.GetAvailableAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
            _page = 1;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
