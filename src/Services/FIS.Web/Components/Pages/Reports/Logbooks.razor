@page "/reports/logbooks"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Logbook Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Logbook Reports
        </h1>
        <p class="page-description">Legacy logbook report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/logbooks">Logbook Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Logbook Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Logbook Report on ONE Vehicle</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("logbook-number")'>2) Logbook Report on Logbook Number</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("dept-site-period")'>3) Logbook Report, for a Dept/Site, for a period</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/logbooks">Back to Logbook Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/logbooks" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/logbooks", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "logbooks-one-vehicle",
        "logbook-number" => "logbooks-number",
        "dept-site-period" => "logbooks",
        _ => "logbooks"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Logbook Report on ONE Vehicle",
        "logbook-number" => "Logbook Report on Logbook Number",
        "dept-site-period" => "Logbook Report, for a Dept/Site, for a period",
        _ => "Logbook Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "logbook-number" => "logbook-number",
            "dept-site-period" => "dept-site-period",
            _ => "dept-site-period"
        };
}
