@page "/reports/logbooks"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportCatalogApiService ReportCatalogService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Logbook Reports
        </h1>
        <p class="page-description">Legacy placeholder for logbook/RPTLogbk.aspx.</p>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-file"></i>
            <h3>No reports available</h3>
            <p>Report catalog unavailable or empty.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_reports.Count report(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in _reports)
                        {
                            <tr>
                                <td>@report.Name</td>
                                <td>@report.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<ReportDto> _reports = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports = await ReportCatalogService.GetAvailableAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
