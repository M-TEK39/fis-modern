@page "/reports/logbooks"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportCatalogApiService ReportCatalogService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Logbook Reports
        </h1>
        <p class="page-description">Browse available logbook reports.</p>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-file"></i>
            <h3>No reports available</h3>
            <p>Report catalog unavailable or empty.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_reports.Count report(s)</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                    <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _reports.Count == 0)">Download CSV</button>
                </div>
            </div>
            @if (_showFieldSelector)
            {
                <div class="form-card" style="margin:0 0 0.75rem 0;">
                    <div class="form-card-body">
                        <div class="form-grid">
                            @foreach (var field in _exportFields)
                            {
                                <div class="form-field">
                                    <label class="form-label">
                                        <input type="checkbox" @bind="field.Selected" />
                                        @field.Label
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in PagedReports)
                        {
                            <tr>
                                <td>@report.Name</td>
                                <td>@report.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _showFieldSelector;
    private List<ReportDto> _reports = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private readonly List<ExportField> _exportFields =
    [
        new("report", "Report", true),
        new("description", "Description", true)
    ];

    private IEnumerable<ReportDto> PagedReports => _reports.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_reports.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports = await ReportCatalogService.GetAvailableAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
            _page = 1;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        foreach (var row in _reports)
        {
            var values = selected.Select(field => field.Key switch
            {
                "report" => row.Name ?? "-",
                "description" => row.Description ?? "-",
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"logbook_reports_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
