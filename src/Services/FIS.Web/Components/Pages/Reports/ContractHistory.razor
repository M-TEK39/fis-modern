@page "/reports/contract-history"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Contract History - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-history"></i>
            Contract History
        </h1>
        <p class="page-description">Legacy contract-history search flow with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Number Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label"><input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />GG</label>
                            <label class="form-radio-label"><input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />GP</label>
                            <label class="form-radio-label"><input type="radio" name="searchMode" checked="@(_searchMode == "ENGINE")" @onchange='() => SetSearchMode("ENGINE")' />Engine</label>
                            <label class="form-radio-label"><input type="radio" name="searchMode" checked="@(_searchMode == "VIN")" @onchange='() => SetSearchMode("VIN")' />VIN / Chassis</label>
                        </div>
                        <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="Enter GG, GP, Engine or VIN/Chassis" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResults">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Contract History</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/contract-history">Back to Search</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="contract-history" FiltersUrl="/reports/contract-history" />
    }
</div>

@code {
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "mode")]
    public string? QMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? QSearch { get; set; }

    protected override Task OnParametersSetAsync()
    {
        _searchMode = QMode ?? _searchMode;
        _searchTerm = QSearch ?? _searchTerm;
        return Task.CompletedTask;
    }

    private void SetSearchMode(string value) => _searchMode = value;

    private void NavigateToResults()
    {
        var filters = new Dictionary<string, string?>
        {
            ["mode"] = _searchMode,
            ["search"] = _searchTerm
        };
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/contract-history", filters));
    }

    private void ResetFilters()
    {
        _searchMode = "GG";
        _searchTerm = string.Empty;
    }
}
