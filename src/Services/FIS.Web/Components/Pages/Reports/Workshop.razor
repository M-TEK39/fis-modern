@page "/reports/workshop"
@page "/Workshop/RPTWorkshop.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Workshop Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Workshop Reports
        </h1>
        <p class="page-description">Legacy workshop report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/workshop">Workshop Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Workshop Reports</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Workshop Report on One Vehicle</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("print-job-card")'>2) Print a Workshop Job Card</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("period")'>3) Workshop Report for a Period</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("in-workshop")'>4) List of Vehicles still in Workshop</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-merchants")'>5) List of All Merchants</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/workshop">Back to Workshop Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/workshop" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/workshop", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "workshop-one-vehicle",
        "print-job-card" => "workshop-print-job-card",
        "period" => "workshop",
        "in-workshop" => "workshop-in-shop",
        "all-merchants" => "workshop-merchants",
        _ => "workshop"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Workshop Report on One Vehicle",
        "print-job-card" => "Print a Workshop Job Card",
        "period" => "Workshop Report for a Period",
        "in-workshop" => "List of Vehicles still in Workshop",
        "all-merchants" => "List of All Merchants",
        _ => "Workshop Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "print-job-card" => "print-job-card",
            "period" => "period",
            "in-workshop" => "in-workshop",
            "all-merchants" => "all-merchants",
            _ => "period"
        };
}
