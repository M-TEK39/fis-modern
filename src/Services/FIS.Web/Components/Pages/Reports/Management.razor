@page "/reports/management"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Management Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-line-chart"></i>
            Management Reports
        </h1>
        <p class="page-description">Legacy management report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/reports">Main Report Page</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Management Report Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("ggmt-management")'>1) GGMT Management Reports</a><span class="menu-item-badge">Menu</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("incorrect-captured-data")'>2) Report On Incorrect Captured Data</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("fis-site-management-info")'>3) FIS Site Management Information</a><span class="menu-item-badge">Menu</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">6) Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/management">Back to Management Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/management" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/management", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "ggmt-management" => "management-ggmt",
        "incorrect-captured-data" => "management-incorrect-captured-data",
        "fis-site-management-info" => "management-site-info",
        _ => "management"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "ggmt-management" => "GGMT Management Reports",
        "incorrect-captured-data" => "Report On Incorrect Captured Data",
        "fis-site-management-info" => "FIS Site Management Information",
        _ => "Management Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "ggmt-management" => "ggmt-management",
            "incorrect-captured-data" => "incorrect-captured-data",
            "fis-site-management-info" => "fis-site-management-info",
            _ => "ggmt-management"
        };
}
