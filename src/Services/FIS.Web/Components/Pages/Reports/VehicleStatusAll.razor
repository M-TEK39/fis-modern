@page "/reports/vehicle-status-all"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>All Vehicle Status - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-category"></i>
            All Vehicle Status
        </h1>
        <p class="page-description">Status distribution and detailed vehicle listing.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Status Summary</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Vehicles</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="3">Loading report...</td></tr>
                    }
                    else if (_summary.Count == 0)
                    {
                        <tr><td colspan="3">No status records found for the current filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _summary)
                        {
                            <tr>
                                <td>@item.Status</td>
                                <td>@item.Count</td>
                                <td>@item.Percentage.ToString("0.0")%</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Vehicle Status Detail</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card fis-mb-075">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Vehicle</th>
                        <th>Status</th>
                        <th>Status Date</th>
                        <th>Site</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="6">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@ValueOrDash(row.fleet_number)</td>
                                <td>@ValueOrDash(row.registration_number)</td>
                                <td>@GetVehicleLabel(row)</td>
                                <td>@ValueOrDash(row.status_description)</td>
                                <td>@(row.vehicle_status_date?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@GetSiteLabel(row.site_code)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private bool _showFieldSelector;
    private List<VehicleDto> _rows = new();
    private List<StatusSummaryRow> _summary = new();
    private List<SiteResponseDto> _sites = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private readonly List<ExportField> _exportFields =
    [
        new("gg_number", "GG Number", true),
        new("gp_number", "GP Number", true),
        new("vehicle", "Vehicle", true),
        new("status", "Status", true),
        new("status_date", "Status Date", true),
        new("site", "Site", true)
    ];

    private List<VehicleDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            _sites = await SiteService.GetAllAsync();
            var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _rows = page.Data
                .OrderBy(v => v.status_description)
                .ThenBy(v => v.fleet_number)
                .ToList();

            var total = Math.Max(1, _rows.Count);
            _summary = _rows
                .GroupBy(v => string.IsNullOrWhiteSpace(v.status_description) ? "Unknown" : v.status_description!.Trim())
                .OrderBy(g => g.Key)
                .Select(g => new StatusSummaryRow(
                    g.Key,
                    g.Count(),
                    g.Count() * 100d / total))
                .ToList();

            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading all vehicle status report: {ex.Message}");
            _rows = new();
            _summary = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private string GetSiteLabel(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? siteCode.Value.ToString() : $"{ValueOrDash(site.Description)} ({site.SiteCode})";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "gg_number" => ValueOrDash(row.fleet_number),
                "gp_number" => ValueOrDash(row.registration_number),
                "vehicle" => GetVehicleLabel(row),
                "status" => ValueOrDash(row.status_description),
                "status_date" => row.vehicle_status_date?.ToString("yyyy-MM-dd") ?? "-",
                "site" => GetSiteLabel(row.site_code),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"vehicle_status_all_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }

    private sealed record StatusSummaryRow(string Status, int Count, double Percentage);
}
