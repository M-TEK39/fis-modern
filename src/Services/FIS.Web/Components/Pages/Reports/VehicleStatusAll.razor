@page "/reports/vehicle-status-all"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>All Vehicle Status - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-category"></i>
            All Vehicle Status
        </h1>
        <p class="page-description">Legacy generated report for all vehicle statuses across departments and sites.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <LegacyDynamicReportGrid ReportKey="vehicle-status-all" FiltersUrl="/reports/vehicle-status-all" />
</div>
