@page "/reports/users"
@page "/Users/Users.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>User Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user"></i>
            User Reports
        </h1>
        <p class="page-description">Legacy user report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/users">Users Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Users Report Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-user")'>1) Information On One User</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-users")'>2) Information On All Users</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("users-added")'>3) Information On All Users Accounts Added On The System</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/users">Back to Users Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/users" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/users", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-user" => "users-one",
        "all-users" => "users",
        "users-added" => "users-added",
        _ => "users"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-user" => "Information On One User",
        "all-users" => "Information On All Users",
        "users-added" => "Information On All Users Accounts Added On The System",
        _ => "User Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-user" => "one-user",
            "all-users" => "all-users",
            "users-added" => "users-added",
            _ => "all-users"
        };
}
