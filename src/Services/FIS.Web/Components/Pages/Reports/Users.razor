@page "/reports/users"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject UserApiService UserService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>User Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user"></i>
            User Reports
        </h1>
        <p class="page-description">User profile and access-level report.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/users">Users Module</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">User Profiles</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Telephone</th>
                        <th>Site</th>
                        <th>User Active</th>
                        <th>Access Level</th>
                        <th>Last Log On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="8">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.UserAccessCode</td>
                                <td>@($"{ValueOrDash(row.FirstName)} {ValueOrDash(row.LastName)}")</td>
                                <td>@ValueOrDash(row.Email)</td>
                                <td>@ValueOrDash(row.Telephone)</td>
                                <td>@GetSiteLabel(row.SiteCode)</td>
                                <td>@(row.UserActive ? "Yes" : "No")</td>
                                <td>@row.AccessLevel</td>
                                <td>@(row.LastLogOn?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private bool _showFieldSelector;
    private List<UserProfileDto> _rows = new();
    private Dictionary<short, string> _siteLabels = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private readonly List<ExportField> _exportFields =
    [
        new("user_id", "User ID", true),
        new("name", "Name", true),
        new("email", "Email", true),
        new("telephone", "Telephone", true),
        new("site", "Site", true),
        new("active", "User Active", true),
        new("access_level", "Access Level", true),
        new("last_log_on", "Last Log On", true)
    ];

    private List<UserProfileDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var sites = await SiteService.GetAllAsync();
            _siteLabels = sites
                .GroupBy(s => s.SiteCode)
                .ToDictionary(
                    g => g.Key,
                    g => $"{ValueOrDash(g.First().Description)} ({g.Key})");

            _rows = (await UserService.GetAllProfilesAsync())
                .OrderBy(u => u.FirstName)
                .ThenBy(u => u.LastName)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading user report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string GetSiteLabel(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        return _siteLabels.TryGetValue(siteCode.Value, out var label)
            ? label
            : siteCode.Value.ToString();
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "user_id" => row.UserAccessCode.ToString(),
                "name" => $"{ValueOrDash(row.FirstName)} {ValueOrDash(row.LastName)}",
                "email" => ValueOrDash(row.Email),
                "telephone" => ValueOrDash(row.Telephone),
                "site" => GetSiteLabel(row.SiteCode),
                "active" => row.UserActive ? "Yes" : "No",
                "access_level" => row.AccessLevel.ToString(),
                "last_log_on" => row.LastLogOn?.ToString("yyyy-MM-dd HH:mm") ?? "-",
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"users_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
