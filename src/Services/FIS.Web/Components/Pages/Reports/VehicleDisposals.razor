@page "/reports/vehicle-disposals"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Vehicle Disposals - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-minus-circle"></i>
            All Vehicle Disposals in a Date Range
        </h1>
        <p class="page-description">Legacy date-range disposals flow with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">From Date</label>
                        <InputDate class="form-input" @bind-Value="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">To Date</label>
                        <InputDate class="form-input" @bind-Value="_endDate" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResults">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">All Vehicle DISPOSALS in a date range</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/vehicle-disposals">Back to Date Filters</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="vehicle-disposals" FiltersUrl="/reports/vehicle-disposals" />
    }
</div>

@code {
    private DateTime? _startDate = DateTime.Today.AddYears(-1);
    private DateTime? _endDate = DateTime.Today;

    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? QFrom { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "to")]
    public string? QTo { get; set; }

    protected override Task OnParametersSetAsync()
    {
        _startDate = ReportFilterHelper.ParseDate(QFrom) ?? _startDate;
        _endDate = ReportFilterHelper.ParseDate(QTo) ?? _endDate;
        return Task.CompletedTask;
    }

    private void NavigateToResults()
    {
        var filters = new Dictionary<string, string?>
        {
            ["from"] = ReportFilterHelper.FormatDate(_startDate),
            ["to"] = ReportFilterHelper.FormatDate(_endDate)
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/vehicle-disposals", filters));
    }

    private void ResetFilters()
    {
        _startDate = DateTime.Today.AddYears(-1);
        _endDate = DateTime.Today;
    }
}
