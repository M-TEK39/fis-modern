@page "/reports/incorrect-quantities"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Incorrect Calculated Quantities - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-error-circle"></i>
            Report to Show Incorrect Calculated Quantities
        </h1>
        <p class="page-description">Legacy generated report for incorrect calculated vehicle quantities.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <LegacyDynamicReportGrid ReportKey="incorrect-quantities" FiltersUrl="/reports/incorrect-quantities" />
</div>
