@page "/reports/tariffs-class-2007"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Tariffs by Class Groupings (2007 and Earlier) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-grid-alt"></i>
            Tariffs by Class Groupings (2007 and Earlier)
        </h1>
        <p class="page-description">Legacy tariff report flow for 2007 and earlier with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/reports/tariffs-fin-year">Tariffs Fin Year</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">List of Tariffs by Class groupings: All vehicles with year model 2007 and Earlier</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="tariffs-class-2007" FiltersUrl="/reports/tariffs-class-2007" />
</div>
