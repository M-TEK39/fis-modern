@page "/reports/auction"
@page "/Auction/RPTAuction.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Auction Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-hammer"></i>
            Auction Reports
        </h1>
        <p class="page-description">Legacy auction report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/auction">Auction Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Auction Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Auction Report on ONE Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-vehicles")'>2) Auction Report on ALL Vehicle's</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("sale-to-name")'>3) Auction Report on Sale to Name</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-auction-sort-gg")'>4) Auction Report of ONE Auction - Sort by GG Number</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-auction-sort-lot")'>5) Auction Report of ONE Auction - Sort by LOT Number</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/auction">Back to Auction Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/auction" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/auction", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "auction-one-vehicle",
        "all-vehicles" => "auction",
        "sale-to-name" => "auction-sale-to-name",
        "one-auction-sort-gg" => "auction-one-sort-gg",
        "one-auction-sort-lot" => "auction-one-sort-lot",
        _ => "auction"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Auction Report on ONE Vehicle",
        "all-vehicles" => "Auction Report on ALL Vehicle's",
        "sale-to-name" => "Auction Report on Sale to Name",
        "one-auction-sort-gg" => "Auction Report of ONE Auction - Sort by GG Number",
        "one-auction-sort-lot" => "Auction Report of ONE Auction - Sort by LOT Number",
        _ => "Auction Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "all-vehicles" => "all-vehicles",
            "sale-to-name" => "sale-to-name",
            "one-auction-sort-gg" => "one-auction-sort-gg",
            "one-auction-sort-lot" => "one-auction-sort-lot",
            _ => "all-vehicles"
        };
}
