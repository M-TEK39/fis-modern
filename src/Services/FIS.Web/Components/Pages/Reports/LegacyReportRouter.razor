@page "/FISReports/ShowReport.aspx"
@page "/FISReports/DownloadReport.aspx"
@page "/DownloadReport.aspx"
@page "/OpenReport.aspx"
@page "/OpenReport_4.aspx"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Redirecting Report...</PageTitle>

<div class="page-content">
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Redirecting to report...</p>
    </div>
</div>

@code {
    private bool _redirected;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _redirected)
        {
            return;
        }

        _redirected = true;
        var target = ResolveTargetUrl();
        Navigation.NavigateTo(target, replace: true);
    }

    private string ResolveTargetUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = uri.AbsolutePath.Trim('/').ToLowerInvariant();
        var query = QueryHelpers.ParseQuery(uri.Query);

        static string Read(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> values, string key)
            => values.TryGetValue(key, out var result) ? result.ToString() : string.Empty;

        var item = Read(query, "Item").Trim().ToLowerInvariant();
        var report = Read(query, "Report").Trim().ToLowerInvariant();

        if (path == "openreport_4.aspx")
        {
            return report switch
            {
                "summaryreportperprovince" => "/finance/regional/summary-per-province",
                "summaryreport" => "/finance/regional/summary-all",
                _ => "/reports"
            };
        }

        if (path == "openreport.aspx")
        {
            return item switch
            {
                "vehiclebillinghistory" => "/finance/reports/vehicle-billing-history",
                "summaryincomesplit" => "/finance/reports/income-split-summary",
                "detailedincomesplit" => "/finance/reports/income-split-detailed",
                "kilogaps" => "/finance/missing-kilometres/kilo-gaps-pdf",
                _ => "/reports"
            };
        }

        return item switch
        {
            "journalswithinvalidbascodes" => "/finance/financial-allocation/invalid-journals",
            "departmentswithnobascodes" => "/finance/financial-allocation/departments-no-bas",
            "departmentswithmissingfinancialsystem" => "/finance/financial-allocation/departments-missing-financial-system",
            "alloutstandingamountsperdepartment" => "/finance/outstanding/department",
            "alloutstandingamountsperdepartmentandsite" => "/finance/outstanding/department-site",
            "alloutstandingamountsatmonthendpervehicle" => "/finance/outstanding/month-end-vehicle",
            "allocationexception" => "/finance/outstanding/allocation-exception",
            "comparebilledkilosandfuelconsumption" => "/finance/missing-kilometres/fuel-consumption",
            "vehicleswithnokilosconsumingfuel" => "/finance/missing-kilometres/no-kilos-consuming-fuel",
            "invoicedamountspermonth" => path.Contains("downloadreport", StringComparison.OrdinalIgnoreCase)
                ? "/finance/reports/download-income-department"
                : "/finance/reports/income-department",
            "invoicedamountspermonthpersite" => path.Contains("downloadreport", StringComparison.OrdinalIgnoreCase)
                ? "/finance/reports/download-income-department-site"
                : "/finance/reports/income-department-site",
            "invoicedamountspermonthpersitepervehicle" => "/finance/reports/download-income-department-site-vehicle",
            "exportpastelcsv" => "/finance/interface/pastel-csv",
            "exportpastelcsvwithclient" => "/finance/interface/pastel-csv-customer",
            _ => "/reports"
        };
    }
}
