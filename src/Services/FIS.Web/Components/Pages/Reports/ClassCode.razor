@page "/reports/class-code"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ClassApiService ClassService
@inject IJSRuntime JSRuntime

<PageTitle>Class Code Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-category-alt"></i>
            Class Code Reports
        </h1>
        <p class="page-description">Vehicle class code master list for reporting and reconciliation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/reference-data">Reference Data</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Class Codes</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Class ID</th>
                        <th>Class Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="2">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="2">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.class_code</td>
                                <td>@ValueOrDash(row.class_description)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private List<ClassDto> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private List<ClassDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            _rows = (await ClassService.GetClassesAsync())
                .OrderBy(c => c.class_code)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading class code report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
