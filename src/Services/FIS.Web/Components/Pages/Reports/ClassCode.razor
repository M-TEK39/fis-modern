@page "/reports/class-code"
@page "/Class_Code/Class_Code.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Class Code Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-category-alt"></i>
            Class Code Reports
        </h1>
        <p class="page-description">Legacy class code report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/reference-data">Reference Data</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Class Code Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("class-codes-make-model")'>1) Report A Table Of Class Codes, Make &amp; Model</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("class-codes-totals")'>2) Report A Table Of Class Codes &amp; Totals</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/class-code">Back to Class Code Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/class-code" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/class-code", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "class-codes-make-model" => "class-code",
        "class-codes-totals" => "class-code-totals",
        _ => "class-code"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "class-codes-make-model" => "Report A Table Of Class Codes, Make & Model",
        "class-codes-totals" => "Report A Table Of Class Codes & Totals",
        _ => "Class Code Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "class-codes-make-model" => "class-codes-make-model",
            "class-codes-totals" => "class-codes-totals",
            _ => "class-codes-make-model"
        };
}
