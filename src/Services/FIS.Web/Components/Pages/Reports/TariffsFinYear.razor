@page "/reports/tariffs-fin-year"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Published Tariffs in a Financial Year - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-spreadsheet"></i>
            Published Tariffs in a Financial Year
        </h1>
        <p class="page-description">Legacy financial-year tariff report flow with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year Start</label>
                        <InputDate class="form-input" @bind-Value="_fyStart" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Financial Year End</label>
                        <InputDate class="form-input" @bind-Value="_fyEnd" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResults">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Published Tariffs in a Financial Year</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/tariffs-fin-year">Back to Financial Year Filters</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="tariffs-fin-year" FiltersUrl="/reports/tariffs-fin-year" />
    }
</div>

@code {
    private DateTime? _fyStart = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year : DateTime.Today.Year - 1, 4, 1);
    private DateTime? _fyEnd = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year + 1 : DateTime.Today.Year, 3, 31);

    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? QFrom { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "to")]
    public string? QTo { get; set; }

    protected override Task OnParametersSetAsync()
    {
        _fyStart = ReportFilterHelper.ParseDate(QFrom) ?? _fyStart;
        _fyEnd = ReportFilterHelper.ParseDate(QTo) ?? _fyEnd;
        return Task.CompletedTask;
    }

    private void NavigateToResults()
    {
        var filters = new Dictionary<string, string?>
        {
            ["from"] = ReportFilterHelper.FormatDate(_fyStart),
            ["to"] = ReportFilterHelper.FormatDate(_fyEnd)
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/tariffs-fin-year", filters));
    }

    private void ResetFilters()
    {
        _fyStart = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year : DateTime.Today.Year - 1, 4, 1);
        _fyEnd = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year + 1 : DateTime.Today.Year, 3, 31);
    }
}
