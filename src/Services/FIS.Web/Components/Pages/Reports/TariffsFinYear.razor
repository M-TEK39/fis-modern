@page "/reports/tariffs-fin-year"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject VehicleApiService VehicleService
@inject TariffApiService TariffService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Published Tariffs in a Financial Year - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-spreadsheet"></i>
            Published Tariffs in a Financial Year
        </h1>
        <p class="page-description">Vehicle tariff preview snapshot filtered by financial year.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year Start</label>
                        <InputDate class="form-input" @bind-Value="_fyStart" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Financial Year End</label>
                        <InputDate class="form-input" @bind-Value="_fyEnd" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Max Vehicles To Evaluate</label>
                        <input class="form-input" type="number" min="1" max="2000" @bind="_maxProbeCount" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResultsAsync">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadReportAsync" disabled="@_loading">Preview Modern Table</button>
                </div>
            </div>
        </div>
    }
    @if (_isResultView)
    {
        <LegacyDynamicReportGrid ReportKey="tariffs-fin-year" FiltersUrl="@_pageRoute" />
    }
    else
    {

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Tariffs in Financial Year</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Vehicle</th>
                        <th>Tariff ID</th>
                        <th>Monthly Fixed (R)</th>
                        <th>Effective Start</th>
                        <th>Effective End</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="7">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@ValueOrDash(row.Vehicle.fleet_number)</td>
                                <td>@ValueOrDash(row.Vehicle.registration_number)</td>
                                <td>@GetVehicleLabel(row.Vehicle)</td>
                                <td>@(row.Tariff.TariffCode?.ToString() ?? "-")</td>
                                <td>@(row.Tariff.MonthlyFixedAmount?.ToString("N2") ?? "-")</td>
                                <td>@ValueOrDash(row.Tariff.EffectiveStartDate)</td>
                                <td>@ValueOrDash(row.Tariff.EffectiveEndDate)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
    }
</div>

@code {
    private bool _loading;
    private DateTime? _fyStart = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year : DateTime.Today.Year - 1, 4, 1);
    private DateTime? _fyEnd = new DateTime(DateTime.Today.Month >= 4 ? DateTime.Today.Year + 1 : DateTime.Today.Year, 3, 31);
    private int _maxProbeCount = 300;
    private List<TariffFinYearRow> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private bool _showFieldSelector;
    private readonly List<ExportField> _exportFields =
    [
        new("gg_number", "GG Number", true),
        new("gp_number", "GP Number", true),
        new("vehicle", "Vehicle", true),
        new("tariff_id", "Tariff ID", true),
        new("monthly_fixed", "Monthly Fixed (R)", true),
        new("effective_start", "Effective Start", true),
        new("effective_end", "Effective End", true)
    ];

    private List<TariffFinYearRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));


    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);
    private const string _pageRoute = "/reports/tariffs-fin-year";
    private string? _lastAutoLoadUri;

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? QFrom { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "to")]
    public string? QTo { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "max")]
    public string? QMax { get; set; }

    protected override Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        if (_isResultView && uri != _lastAutoLoadUri)
        {
            _lastAutoLoadUri = uri;
            ApplyQueryFilters();
        }

        return Task.CompletedTask;
    }

    private Dictionary<string, string?> BuildQueryFilters() => new()
    {
        { "from", ReportFilterHelper.FormatDate(_fyStart) },
        { "to", ReportFilterHelper.FormatDate(_fyEnd) },
        { "max", _maxProbeCount.ToString() },
    };

    private void ApplyQueryFilters()
    {
        _fyStart = ReportFilterHelper.ParseDate(QFrom) ?? DateTime.Today.AddYears(-1);
        _fyEnd = ReportFilterHelper.ParseDate(QTo) ?? DateTime.Today;
        _maxProbeCount = ReportFilterHelper.ParseInt(QMax, 300);
    }

    private void NavigateToResultsAsync()
    {
        _lastAutoLoadUri = null;
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl(_pageRoute, BuildQueryFilters()));
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var start = _fyStart ?? DateTime.Today;
            var end = _fyEnd ?? DateTime.Today;
            if (end < start)
            {
                (start, end) = (end, start);
            }

            var vehicles = (await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000)).Data
                .Take(Math.Clamp(_maxProbeCount, 1, 2000))
                .ToList();

            var rows = new List<TariffFinYearRow>();
            foreach (var vehicle in vehicles)
            {
                var preview = await TariffService.GetPreviewForVehicleAsync(vehicle.vmf_code);
                if (preview?.Tariff == null)
                {
                    continue;
                }

                var tariff = preview.Tariff;
                if (!DateTime.TryParse(tariff.EffectiveStartDate, out var effectiveStart))
                {
                    continue;
                }

                DateTime? effectiveEnd = null;
                if (DateTime.TryParse(tariff.EffectiveEndDate, out var parsedEnd))
                {
                    effectiveEnd = parsedEnd;
                }

                var overlapsFinYear = effectiveStart.Date <= end.Date
                    && (!effectiveEnd.HasValue || effectiveEnd.Value.Date >= start.Date);
                if (!overlapsFinYear)
                {
                    continue;
                }

                rows.Add(new TariffFinYearRow(vehicle, tariff));
            }

            _rows = rows
                .OrderBy(r => r.Vehicle.fleet_number)
                .ThenBy(r => r.Vehicle.registration_number)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading tariffs financial year report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "gg_number" => ValueOrDash(row.Vehicle.fleet_number),
                "gp_number" => ValueOrDash(row.Vehicle.registration_number),
                "vehicle" => GetVehicleLabel(row.Vehicle),
                "tariff_id" => row.Tariff.TariffCode?.ToString() ?? "-",
                "monthly_fixed" => row.Tariff.MonthlyFixedAmount?.ToString("N2") ?? "-",
                "effective_start" => ValueOrDash(row.Tariff.EffectiveStartDate),
                "effective_end" => ValueOrDash(row.Tariff.EffectiveEndDate),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"tariffs_fin_year_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }

    private sealed record TariffFinYearRow(VehicleDto Vehicle, VehicleTariffPreviewDto Tariff);
}
