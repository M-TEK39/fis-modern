@page "/reports/asset-list"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Asset List - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            Asset List: New &amp; In-Service Vehicles
        </h1>
        <p class="page-description">Legacy asset list submenu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Asset List: All Vehicles Reports New & In-Service</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-departments")'>i) Asset List: All Vehicles in FIS with status New &amp; In-Service (All Departments)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("by-province")'>ii) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by PROVINCE)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("by-department")'>iii) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by DEPARTMENT)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("by-site")'>iv) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by SITE)</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/asset-list">Back to Asset List Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/asset-list" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/asset-list", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "all-departments" => "asset-list",
        "by-province" => "asset-list-by-province",
        "by-department" => "asset-list-by-department",
        "by-site" => "asset-list-by-site",
        _ => "asset-list"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "all-departments" => "Asset List: All Vehicles in FIS with status New & In-Service (All Departments)",
        "by-province" => "Asset List: All Vehicles in FIS with status New & In-Service (View by PROVINCE)",
        "by-department" => "Asset List: All Vehicles in FIS with status New & In-Service (View by DEPARTMENT)",
        "by-site" => "Asset List: All Vehicles in FIS with status New & In-Service (View by SITE)",
        _ => "Asset List: All Vehicles Reports New & In-Service"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "all-departments" => "all-departments",
            "by-province" => "by-province",
            "by-department" => "by-department",
            "by-site" => "by-site",
            _ => "all-departments"
        };
}
