@page "/reports/fines"
@page "/Fines/RPTFines.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Fines Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fines Reports
        </h1>
        <p class="page-description">Legacy fines report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/fines">Fines Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Fines Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Fines Report on ONE Vehicle</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("dept-site-period")'>2) Fines Report, for a Dept / Site, for a period</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("appear-date")'>3) Fines Report on Appear Date</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("reissue-submission")'>4) Submission to Re-Issue Fine in Transport Officer's Name</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("traffic-dept-detail")'>5) Traffic Dept Detail</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/fines">Back to Fines Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/fines" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/fines", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "fines-one-vehicle",
        "dept-site-period" => "fines",
        "appear-date" => "fines-appear-date",
        "reissue-submission" => "fines-reissue-submission",
        "traffic-dept-detail" => "fines-traffic-dept-detail",
        _ => "fines"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Fines Report on ONE Vehicle",
        "dept-site-period" => "Fines Report, for a Dept / Site, for a period",
        "appear-date" => "Fines Report on Appear Date",
        "reissue-submission" => "Submission to Re-Issue Fine in Transport Officer's Name",
        "traffic-dept-detail" => "Traffic Dept Detail",
        _ => "Fines Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "dept-site-period" => "dept-site-period",
            "appear-date" => "appear-date",
            "reissue-submission" => "reissue-submission",
            "traffic-dept-detail" => "traffic-dept-detail",
            _ => "dept-site-period"
        };
}
