@page "/reports/manuals"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>Manuals Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-book"></i>
            Manuals Reports
        </h1>
        <p class="page-description">Manual library and report guidance documents.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/manuals">Manuals Module</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">@_manuals.Count Manual(s)</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_manuals.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card fis-mb-075">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Link</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var manual in PagedRows)
                    {
                        <tr>
                            <td>@manual.Title</td>
                            <td>@manual.Description</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <a class="btn-icon btn-icon-view" href="@manual.Path" target="_blank" rel="noopener noreferrer" title="Open manual">
                                        <i class="bx bx-link-external"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_manuals.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_manuals.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private readonly List<ManualItem> _manuals =
    [
        new("Electronic Logsheet and Trip Authority Training Manual", "/Docs/Electronic Log Sheet and Trip Authority Training Manual.doc", "Step-by-step user training for the electronic logsheet workflow."),
        new("Manual: Updating Trip Authorities", "/Docs/doc/Updating Trip Authorities Manual2.htm", "Procedural guide for updating existing trip authority records."),
        new("Procedures Manual (Chauffeur Driven Service)", "/private_hire/Procedures_manual.htm", "Procedures governing the chauffeur driven service."),
        new("Manuals Library", "/Manuals/Allmanuals.htm", "Consolidated library of system manuals and references."),
        new("Manual for Changing Password", "/Docs/Implementation of User Admin on GGMT system.doc", "Guidance on rotating passwords inside the User Admin module.")
    ];

    private int _page = 1;
    private const int _pageSize = 12;
    private bool _showFieldSelector;
    private readonly List<ExportField> _exportFields =
    [
        new("title", "Title", true),
        new("description", "Description", true),
        new("link", "Link", true)
    ];

    private IEnumerable<ManualItem> PagedRows => _manuals.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_manuals.Count / (double)_pageSize));

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        foreach (var row in _manuals)
        {
            var values = selected.Select(field => field.Key switch
            {
                "title" => row.Title,
                "description" => row.Description,
                "link" => row.Path,
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"manuals_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed record ManualItem(string Title, string Path, string Description);

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
