@page "/reports/departments-sites"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Department &amp; Site Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-buildings"></i>
            Department &amp; Site Reports
        </h1>
        <p class="page-description">Legacy department and site report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/departments">Departments Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Department Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-department")'>1) One Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-site")'>2) One Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-dept-site-count")'>3) All Departments &amp; Site with number vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-dept-site-contact")'>4) All Departments &amp; Sites with contact details</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-on-els")'>5) List of Vehicles on ELS</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-on-manual-logs")'>6) List of Vehicles on Manual LOGSHEETS</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("outstanding-logs-combined")'>7) Outstanding Logs per Dept : ELS and Manual Logs Combined</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/departments-sites">Back to Department &amp; Site Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/departments-sites" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?> { ["rtype"] = reportType };
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/departments-sites", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-department" => "departments-one-department",
        "one-site" => "departments-one-site",
        "all-dept-site-count" => "departments-sites",
        "all-dept-site-contact" => "departments-sites-contact",
        "vehicles-on-els" => "departments-vehicles-els",
        "vehicles-on-manual-logs" => "departments-vehicles-manual-logs",
        "outstanding-logs-combined" => "departments-outstanding-logs-combined",
        _ => "departments-sites"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-department" => "One Department",
        "one-site" => "One Site",
        "all-dept-site-count" => "All Departments & Site with number vehicles",
        "all-dept-site-contact" => "All Departments & Sites with contact details",
        "vehicles-on-els" => "List of Vehicles on ELS",
        "vehicles-on-manual-logs" => "List of Vehicles on Manual LOGSHEETS",
        "outstanding-logs-combined" => "Outstanding Logs per Dept : ELS and Manual Logs Combined",
        _ => "Department & Site Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-department" => "one-department",
            "one-site" => "one-site",
            "all-dept-site-count" => "all-dept-site-count",
            "all-dept-site-contact" => "all-dept-site-contact",
            "vehicles-on-els" => "vehicles-on-els",
            "vehicles-on-manual-logs" => "vehicles-on-manual-logs",
            "outstanding-logs-combined" => "outstanding-logs-combined",
            _ => "all-dept-site-count"
        };
}
