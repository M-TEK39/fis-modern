@page "/reports/registration-certificates"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Registration Certificates - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Registration Certificates
        </h1>
        <p class="page-description">Legacy registration certificate menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Registration Certificate Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-vehicles")'>1) Registration Certificates for All Vehicles</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>2) Registration Certificate for One Vehicle</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">3) Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/registration-certificates">Back to Registration Certificate Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/registration-certificates" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/registration-certificates", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "all-vehicles" => "registration-certificates",
        "one-vehicle" => "registration-certificate-one-vehicle",
        _ => "registration-certificates"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "all-vehicles" => "Registration Certificates for All Vehicles",
        "one-vehicle" => "Registration Certificate for One Vehicle",
        _ => "Registration Certificates"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "all-vehicles" => "all-vehicles",
            "one-vehicle" => "one-vehicle",
            _ => "all-vehicles"
        };
}
