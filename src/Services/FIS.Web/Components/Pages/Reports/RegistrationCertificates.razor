@page "/reports/registration-certificates"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Registration Certificates - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Registration Certificates
        </h1>
        <p class="page-description">Vehicle registration and licensing certificate tracking report.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
                <div class="form-field">
                    <label class="form-label">Only Due / Expired</label>
                    <select class="form-select" @bind="_dueMode">
                        <option value="all">All</option>
                        <option value="due">Due in next 30 days</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="_loading">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFiltersAsync">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Registration Certificates Report</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Licence Register Number</th>
                        <th>Licence Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="4">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="4">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@GetVehicleLabel(row)</td>
                                <td>@ValueOrDash(row.lic_register_number)</td>
                                <td>@FormatDate(row.licence_due_date)</td>
                                <td>@GetCertificateStatus(row.licence_due_date)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private string _dueMode = "all";
    private List<VehicleDto> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private List<VehicleDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var search = _searchTerm.Trim();
            var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000, search: string.IsNullOrWhiteSpace(search) ? null : search);
            var today = DateTime.Today;
            var dueLimit = today.AddDays(30);

            var filtered = page.Data.Where(v =>
                !string.IsNullOrWhiteSpace(v.registration_number)
                || !string.IsNullOrWhiteSpace(v.lic_register_number)
                || v.licence_due_date.HasValue);

            if (!string.IsNullOrWhiteSpace(search))
            {
                filtered = filtered.Where(v =>
                    (_searchMode == "GG"
                        ? Contains(v.fleet_number, search)
                        : Contains(v.registration_number, search))
                    || Contains(v.lic_register_number, search));
            }

            filtered = _dueMode switch
            {
                "expired" => filtered.Where(v => v.licence_due_date.HasValue && v.licence_due_date.Value.Date < today),
                "due" => filtered.Where(v => v.licence_due_date.HasValue && v.licence_due_date.Value.Date >= today && v.licence_due_date.Value.Date <= dueLimit),
                _ => filtered
            };

            _rows = filtered
                .OrderBy(v => v.licence_due_date ?? DateTime.MaxValue)
                .ThenBy(v => v.registration_number)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading registration certificates report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = string.Empty;
        _dueMode = "all";
        _searchMode = "GG";
        await LoadReportAsync();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
    }

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto row)
        => $"{ValueOrDash(row.fleet_number)} / {ValueOrDash(row.registration_number)} ({row.vmf_code})";

    private static string GetCertificateStatus(DateTime? dueDate)
    {
        if (!dueDate.HasValue)
        {
            return "No due date";
        }

        var today = DateTime.Today;
        if (dueDate.Value.Date < today)
        {
            return "Expired";
        }

        if (dueDate.Value.Date <= today.AddDays(30))
        {
            return "Due soon";
        }

        return "Valid";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
