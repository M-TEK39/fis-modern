@page "/reports/registration-certificates"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>Registration Certificates - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Registration Certificates
        </h1>
        <p class="page-description">Vehicle registration and licensing certificate tracking report.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
                <div class="form-field">
                    <label class="form-label">Only Due / Expired</label>
                    <select class="form-select" @bind="_dueMode">
                        <option value="all">All</option>
                        <option value="due">Due in next 30 days</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="@_loading">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFiltersAsync">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Registration Certificates Report</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Licence Register Number</th>
                        <th>Licence Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="4">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="4">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@GetVehicleLabel(row)</td>
                                <td>@ValueOrDash(row.lic_register_number)</td>
                                <td>@FormatDate(row.licence_due_date)</td>
                                <td>@GetCertificateStatus(row)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private string _dueMode = "all";
    private List<RegistrationCertificateRow> _rows = new();
    private Dictionary<int, VehicleDto> _vehicleLookup = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private bool _showFieldSelector;
    private readonly List<ExportField> _exportFields =
    [
        new("vehicle", "Vehicle", true),
        new("licence_register_number", "Licence Register Number", true),
        new("licence_due_date", "Licence Due Date", true),
        new("status", "Status", true)
    ];

    private List<RegistrationCertificateRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var search = _searchTerm.Trim();
            var report = await ReportService.GetRegistrationCertificatesAsync();

            if (_vehicleLookup.Count == 0)
            {
                var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _vehicleLookup = page.Data.ToDictionary(v => v.vmf_code);
            }

            var rows = report.Certificates.Select(c =>
            {
                _vehicleLookup.TryGetValue(c.VmfCode, out var vehicle);
                return new RegistrationCertificateRow
                {
                    vmf_code = c.VmfCode,
                    fleet_number = vehicle?.fleet_number,
                    registration_number = string.IsNullOrWhiteSpace(c.RegistrationNumber)
                        ? vehicle?.registration_number
                        : c.RegistrationNumber,
                    lic_register_number = vehicle?.lic_register_number,
                    licence_due_date = c.ExpiryDate,
                    status = c.Status
                };
            });

            if (!string.IsNullOrWhiteSpace(search))
            {
                rows = _searchMode == "GG"
                    ? rows.Where(r => Contains(r.fleet_number, search))
                    : rows.Where(r => Contains(r.registration_number, search) || Contains(r.lic_register_number, search));
            }

            var today = DateTime.Today;
            var dueLimit = today.AddDays(30);
            rows = _dueMode switch
            {
                "expired" => rows.Where(r => r.licence_due_date.HasValue && r.licence_due_date.Value.Date < today),
                "due" => rows.Where(r => r.licence_due_date.HasValue && r.licence_due_date.Value.Date >= today && r.licence_due_date.Value.Date <= dueLimit),
                _ => rows
            };

            _rows = rows
                .OrderBy(v => v.licence_due_date ?? DateTime.MaxValue)
                .ThenBy(v => v.registration_number)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading registration certificates report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = string.Empty;
        _dueMode = "all";
        _searchMode = "GG";
        await LoadReportAsync();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
    }

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(RegistrationCertificateRow row)
        => $"{ValueOrDash(row.fleet_number)} / {ValueOrDash(row.registration_number)} ({row.vmf_code})";

    private static string GetCertificateStatus(RegistrationCertificateRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.status))
        {
            return row.status;
        }

        return GetCertificateStatus(row.licence_due_date);
    }

    private static string GetCertificateStatus(DateTime? dueDate)
    {
        if (!dueDate.HasValue)
        {
            return "No due date";
        }

        var today = DateTime.Today;
        if (dueDate.Value.Date < today)
        {
            return "Expired";
        }

        if (dueDate.Value.Date <= today.AddDays(30))
        {
            return "Due soon";
        }

        return "Valid";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string> { string.Join(",", selected.Select(f => CsvCell(f.Label))) };
        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "vehicle" => GetVehicleLabel(row),
                "licence_register_number" => ValueOrDash(row.lic_register_number),
                "licence_due_date" => FormatDate(row.licence_due_date),
                "status" => GetCertificateStatus(row.licence_due_date),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"registration_certificates_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }

    private sealed class RegistrationCertificateRow
    {
        public int vmf_code { get; set; }
        public string? fleet_number { get; set; }
        public string? registration_number { get; set; }
        public string? lic_register_number { get; set; }
        public DateTime? licence_due_date { get; set; }
        public string? status { get; set; }
    }
}
