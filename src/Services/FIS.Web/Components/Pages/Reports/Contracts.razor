@page "/reports/contracts"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Contract Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Contract Reports
        </h1>
        <p class="page-description">Legacy contracts report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Contract Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-contract-single")'>1) Information On A Vehicle Contracts</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-contract-multiple")'>2) Information On Multiple Vehicle Contracts</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-contract-universal")'>3) Information On All Vehicles Contracts(Universal Report)</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contracts-expiring-by-date")'>4) Information On All Contracts That Will Expire By a Specified Date</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contract-summary")'>5) Contract summarized report</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-authorities-single")'>6) Vehicle Trip Authorities per GG or GP Number</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-authorities-multiple")'>7) Multiple Vehicle Trip Authorities per GG or GP Number</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-authorities-by-dept-site-date")'>8) Vehicle Trip Authorities per Dept, Site or Date</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contracts-checklist")'>9) Daily &amp; Monthly Contract check list report</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contracts-no-distance")'>10) Vehicle Contracts with NO distance traveled</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contracts-per-dept-period")'>11) Contracts for a Department for period</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("contracts-fleet-reports")'>12) Permanent Section - Contracts Fleet Reports</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                </div>
            </div>

            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Lease (NOM) Vehicle Contract Report</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("lease-nom-split")'>1) Lease Vehicles Split Report for Vehicles not on Contract and those on Contract</a>
                        <span class="menu-item-badge">Report</span>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a>
                        <span class="menu-item-badge">Menu</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/contracts">Back to Contract Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/contracts" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/contracts", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "vehicle-contract-single" => "contract-vehicle-single",
        "vehicle-contract-multiple" => "contract-vehicle-multiple",
        "vehicle-contract-universal" => "contracts",
        "contracts-expiring-by-date" => "contracts-expiring-by-date",
        "contract-summary" => "contract-summary",
        "trip-authorities-single" => "contract-trip-authority-single",
        "trip-authorities-multiple" => "contract-trip-authority-multiple",
        "trip-authorities-by-dept-site-date" => "contract-trip-authority-dept-site-date",
        "contracts-checklist" => "contracts-checklist",
        "contracts-no-distance" => "contracts-no-distance",
        "contracts-per-dept-period" => "contracts-per-dept-period",
        "contracts-fleet-reports" => "contracts-fleet-reports",
        "lease-nom-split" => "lease-nom-contract-split",
        _ => "contracts"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "vehicle-contract-single" => "Information On A Vehicle Contracts",
        "vehicle-contract-multiple" => "Information On Multiple Vehicle Contracts",
        "vehicle-contract-universal" => "Information On All Vehicles Contracts(Universal Report)",
        "contracts-expiring-by-date" => "Information On All Contracts That Will Expire By a Specified Date",
        "contract-summary" => "Contract summarized report",
        "trip-authorities-single" => "Vehicle Trip Authorities per GG or GP Number",
        "trip-authorities-multiple" => "Multiple Vehicle Trip Authorities per GG or GP Number",
        "trip-authorities-by-dept-site-date" => "Vehicle Trip Authorities per Dept, Site or Date",
        "contracts-checklist" => "Daily & Monthly Contract check list report",
        "contracts-no-distance" => "Vehicle Contracts with NO distance traveled",
        "contracts-per-dept-period" => "Contracts for a Department for period",
        "contracts-fleet-reports" => "Permanent Section - Contracts Fleet Reports",
        "lease-nom-split" => "Lease Vehicles Split Report for Vehicles not on Contract and those on Contract",
        _ => "Contract Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "vehicle-contract-single" => "vehicle-contract-single",
            "vehicle-contract-multiple" => "vehicle-contract-multiple",
            "vehicle-contract-universal" => "vehicle-contract-universal",
            "contracts-expiring-by-date" => "contracts-expiring-by-date",
            "contract-summary" => "contract-summary",
            "trip-authorities-single" => "trip-authorities-single",
            "trip-authorities-multiple" => "trip-authorities-multiple",
            "trip-authorities-by-dept-site-date" => "trip-authorities-by-dept-site-date",
            "contracts-checklist" => "contracts-checklist",
            "contracts-no-distance" => "contracts-no-distance",
            "contracts-per-dept-period" => "contracts-per-dept-period",
            "contracts-fleet-reports" => "contracts-fleet-reports",
            "lease-nom-split" => "lease-nom-split",
            _ => "vehicle-contract-universal"
        };
}
