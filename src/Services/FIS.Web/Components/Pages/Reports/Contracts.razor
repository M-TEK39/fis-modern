@page "/reports/contracts"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ContractApiService ContractService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Contract Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Contract Reports
        </h1>
        <p class="page-description">Contract report by status/current flag/site and date range.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/contracts">Contracts Module</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="_statusCode">
                        <option value="">All</option>
                        <option value="0">Draft</option>
                        <option value="1">Pending Approval</option>
                        <option value="2">Approved</option>
                        <option value="3">Active</option>
                        <option value="4">Declined for Correction</option>
                        <option value="5">Declined</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Current</label>
                    <select class="form-select" @bind="_stillCurrent">
                        <option value="">All</option>
                        <option value="Y">Y</option>
                        <option value="N">N</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_siteCode">
                        <option value="">All</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Start From</label>
                    <InputDate class="form-input" @bind-Value="_startFrom" />
                </div>
                <div class="form-field">
                    <label class="form-label">Start To</label>
                    <InputDate class="form-input" @bind-Value="_startTo" />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadContractsAsync" disabled="_loading">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Contract Report</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _contracts.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Contract ID</th>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Status</th>
                        <th>Current</th>
                        <th>Start Date</th>
                        <th>Site</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7">Loading report...</td></tr>
                    }
                    else if (_contracts.Count == 0)
                    {
                        <tr><td colspan="7">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _contracts)
                        {
                            <tr>
                                <td>@row.contract_id</td>
                                <td>@ValueOrDash(row.fleet_number)</td>
                                <td>@ValueOrDash(row.vehicle_registration)</td>
                                <td>@ValueOrDash(row.status)</td>
                                <td>@ValueOrDash(row.still_current)</td>
                                <td>@row.start_date.ToString("yyyy-MM-dd")</td>
                                <td>@ValueOrDash(GetSiteName(row.site_code))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private bool _loading;
    private bool _showFieldSelector;
    private List<ContractDto> _contracts = new();
    private List<SiteResponseDto> _sites = new();
    private string _statusCode = string.Empty;
    private string _stillCurrent = string.Empty;
    private string _siteCode = string.Empty;
    private DateTime? _startFrom;
    private DateTime? _startTo;
    private readonly List<ExportField> _exportFields =
    [
        new("contract_id", "Contract ID", true),
        new("fleet_number", "GG Number", true),
        new("vehicle_registration", "GP Number", true),
        new("status", "Status", true),
        new("still_current", "Current", true),
        new("start_date", "Start Date", true),
        new("site", "Site", true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        _loading = true;
        try
        {
            var query = new ContractsPageQuery
            {
                Page = 1,
                PageSize = 200,
                StatusCode = int.TryParse(_statusCode, out var status) ? (short?)status : null,
                SiteCode = short.TryParse(_siteCode, out var site) ? site : null,
                StillCurrent = string.IsNullOrWhiteSpace(_stillCurrent) ? null : _stillCurrent,
                StartDateFrom = _startFrom,
                StartDateTo = _startTo
            };

            var page = await ContractService.GetContractsPageAsync(query);
            _contracts = page.Data;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading contract report: {ex.Message}");
            _contracts = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _statusCode = string.Empty;
        _stillCurrent = string.Empty;
        _siteCode = string.Empty;
        _startFrom = null;
        _startTo = null;
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _contracts)
        {
            var values = selected.Select(field => field.Key switch
            {
                "contract_id" => row.contract_id.ToString(),
                "fleet_number" => ValueOrDash(row.fleet_number),
                "vehicle_registration" => ValueOrDash(row.vehicle_registration),
                "status" => ValueOrDash(row.status),
                "still_current" => ValueOrDash(row.still_current),
                "start_date" => row.start_date.ToString("yyyy-MM-dd"),
                "site" => ValueOrDash(GetSiteName(row.site_code)),
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"contracts_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private string GetSiteName(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? siteCode.Value.ToString() : $"{site.DepartmentNumber} - {site.Description}";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
