@page "/reports/vehicle-info"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>General Vehicle Information Report - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            General Vehicle Information Report
        </h1>
        <p class="page-description">Legacy one-vehicle detail search by GG, GP, engine, VIN/chassis, or invoice number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Number Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                GP
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "ENGINE")" @onchange='() => SetSearchMode("ENGINE")' />
                                Engine
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "VIN")" @onchange='() => SetSearchMode("VIN")' />
                                VIN / Chassis
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "INVOICE")" @onchange='() => SetSearchMode("INVOICE")' />
                                Invoice
                            </label>
                        </div>
                        <input class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@VehicleSearchHelper.GetSearchPlaceholder(_searchMode)" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResultsAsync">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadReportAsync" disabled="@_loading">Preview Modern Table</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    @if (_isResultView)
    {
        <LegacyDynamicReportGrid ReportKey="vehicle-info" FiltersUrl="@_pageRoute" />
    }
    else
    {

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Vehicle Information</span>
            <div class="table-controls">
                <button class="btn btn-secondary btn-sm" @onclick="ToggleFieldSelector">Select Fields</button>
                <button class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_loading || _rows.Count == 0)">Download CSV</button>
            </div>
        </div>
        @if (_showFieldSelector)
        {
            <div class="form-card" style="margin:0 0 0.75rem 0;">
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var field in _exportFields)
                        {
                            <div class="form-field">
                                <label class="form-label">
                                    <input type="checkbox" @bind="field.Selected" />
                                    @field.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>GP Number</th>
                        <th>Model</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Site</th>
                        <th>Colour</th>
                        <th>Licence Register No</th>
                        <th>Licence Due Date</th>
                        <th>Current ODO</th>
                        <th>Service Last Done</th>
                        <th>Purchase Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="12">Loading report...</td></tr>
                    }
                    else if (PagedRows.Count == 0)
                    {
                        <tr><td colspan="12">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@ValueOrDash(row.fleet_number)</td>
                                <td>@ValueOrDash(row.registration_number)</td>
                                <td>@ValueOrDash(row.model_name)</td>
                                <td>@ValueOrDash(row.type_name)</td>
                                <td>@ValueOrDash(row.status_description)</td>
                                <td>@ValueOrDash(row.location_description)</td>
                                <td>@ValueOrDash(row.colour)</td>
                                <td>@ValueOrDash(row.lic_register_number)</td>
                                <td>@(row.licence_due_date?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(row.current_odo?.ToString("N0") ?? "-")</td>
                                <td>@(row.service_last_done?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>@(row.purchase_amount?.ToString("N2") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showFieldSelector;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private List<VehicleDto> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private readonly List<ExportField> _exportFields =
    [
        new("gg_number", "GG Number", true),
        new("gp_number", "GP Number", true),
        new("model", "Model", true),
        new("type", "Type", true),
        new("status", "Status", true),
        new("site", "Site", true),
        new("colour", "Colour", true),
        new("lic_register_number", "Licence Register No", true),
        new("licence_due_date", "Licence Due Date", true),
        new("current_odo", "Current ODO", true),
        new("service_last_done", "Service Last Done", true),
        new("purchase_amount", "Purchase Amount", true),
    ];

    private List<VehicleDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));


    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);
    private const string _pageRoute = "/reports/vehicle-info";
    private string? _lastAutoLoadUri;

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "mode")]
    public string? QMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? QSearch { get; set; }

    protected override Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        if (_isResultView && uri != _lastAutoLoadUri)
        {
            _lastAutoLoadUri = uri;
            ApplyQueryFilters();
        }

        return Task.CompletedTask;
    }

    private Dictionary<string, string?> BuildQueryFilters() => new()
    {
        { "mode", _searchMode },
        { "search", _searchTerm },
    };

    private void ApplyQueryFilters()
    {
        _searchMode = QMode ?? "GG";
        _searchTerm = QSearch ?? string.Empty;
    }

    private void NavigateToResultsAsync()
    {
        _lastAutoLoadUri = null;
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl(_pageRoute, BuildQueryFilters()));
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var search = _searchTerm.Trim();
            if (string.IsNullOrWhiteSpace(search))
            {
                var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _rows = page.Data.OrderBy(v => v.fleet_number).ToList();
            }
            else
            {
                var matches = await VehicleService.SearchVehiclesAsync(search);
                _rows = VehicleSearchHelper.RankVehicleMatches(matches, search, _searchMode);
            }
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicle info report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _rows = new();
        _page = 1;
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ToggleFieldSelector()
    {
        _showFieldSelector = !_showFieldSelector;
    }

    private async Task DownloadCsvAsync()
    {
        var selected = _exportFields.Where(f => f.Selected).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", selected.Select(f => CsvCell(f.Label)))
        };

        foreach (var row in _rows)
        {
            var values = selected.Select(field => field.Key switch
            {
                "gg_number" => ValueOrDash(row.fleet_number),
                "gp_number" => ValueOrDash(row.registration_number),
                "model" => ValueOrDash(row.model_name),
                "type" => ValueOrDash(row.type_name),
                "status" => ValueOrDash(row.status_description),
                "site" => ValueOrDash(row.location_description),
                "colour" => ValueOrDash(row.colour),
                "lic_register_number" => ValueOrDash(row.lic_register_number),
                "licence_due_date" => row.licence_due_date?.ToString("yyyy-MM-dd") ?? "-",
                "current_odo" => row.current_odo?.ToString("N0") ?? "-",
                "service_last_done" => row.service_last_done?.ToString("yyyy-MM-dd") ?? "-",
                "purchase_amount" => row.purchase_amount?.ToString("N2") ?? "-",
                _ => "-"
            });
            lines.Add(string.Join(",", values.Select(CsvCell)));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var fileName = $"vehicle_information_report_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

    private sealed class ExportField
    {
        public ExportField(string key, string label, bool selected)
        {
            Key = key;
            Label = label;
            Selected = selected;
        }

        public string Key { get; }
        public string Label { get; }
        public bool Selected { get; set; }
    }
}
