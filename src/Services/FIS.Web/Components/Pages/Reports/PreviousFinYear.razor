@page "/reports/previous-fin-year"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Previous Fin Year Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-history"></i>
            Previous Fin Year Reports
        </h1>
        <p class="page-description">Legacy report set for previous financial-year transactions captured in the current financial year.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Previous Fin Year Reports</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <button type="button" class="btn btn-primary btn-sm" @onclick='() => NavigateToResults("manual")'>
                            i) Manual Logsheet Kilos captured in current Fin Year
                        </button>
                    </div>
                    <div class="menu-item fis-mt-075">
                        <button type="button" class="btn btn-primary btn-sm" @onclick='() => NavigateToResults("vip-taxi")'>
                            ii) VIP &amp; Taxi requisitions captured in current Fin Year
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="@_pageRoute" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);
    private const string _pageRoute = "/reports/previous-fin-year";

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    private void NavigateToResults(string kind)
    {
        var filters = new Dictionary<string, string?>
        {
            { "kind", kind }
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl(_pageRoute, filters));
    }

    private string GetReportKey()
        => string.Equals(Kind, "vip-taxi", StringComparison.OrdinalIgnoreCase)
            ? "previous-fin-year-vip-taxi"
            : "previous-fin-year-manual-logs";
}
