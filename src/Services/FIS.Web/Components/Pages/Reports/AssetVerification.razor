@page "/reports/asset-verification"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Asset Verification Report - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-check-shield"></i>
            Asset Verification Report
        </h1>
        <p class="page-description">Legacy asset verification report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/asset-verification">Asset Verification</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Asset Verification Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-section-title">Asset Verification Reports</div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("per-site-province-date")'>1) Report Per Site / Province / Verification Date</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("not-verified")'>2) Vehicles Not Verified</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("verified-by-date-range")'>3) Vehicles Verified By Date Range - Excel Report</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/asset-verification">Back to Asset Verification Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/asset-verification" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/asset-verification", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "per-site-province-date" => "asset-verification-per-site-province-date",
        "not-verified" => "asset-verification-not-verified",
        "verified-by-date-range" => "asset-verification-verified-by-date-range",
        _ => "asset-verification"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "per-site-province-date" => "Report Per Site / Province / Verification Date",
        "not-verified" => "Vehicles Not Verified",
        "verified-by-date-range" => "Vehicles Verified By Date Range - Excel Report",
        _ => "Asset Verification Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "per-site-province-date" => "per-site-province-date",
            "not-verified" => "not-verified",
            "verified-by-date-range" => "verified-by-date-range",
            _ => "per-site-province-date"
        };
}
