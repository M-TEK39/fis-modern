@page "/reports/taxis"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Taxis Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-taxi"></i>
            Taxis Reports
        </h1>
        <p class="page-description">Legacy taxis report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/taxis">Taxis Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Taxi Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("future-bookings-my-dept")'>1) Future booking made for my department.</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("history-bookings-period")'>2) History bookings for period</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("requisition-numbers-period")'>3) List of Requisition Numbers for a period</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("taxis-per-hire-company")'>4) Taxis Per Hire Company</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("list-inservice")'>5) List Of all Taxis in service in various departments</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("list-all")'>6) List Of all Taxis in various departments</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("reprint-requisition")'>7) Reprint A Requisition</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("reprint-taxi-log")'>8) Reprint A Taxi Log</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/taxis">Back to Taxis Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/taxis" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/taxis", filters));
    }

    private string GetReportKey()
        => NormalizeReportType(QReportType) switch
        {
            "future-bookings-my-dept" => "taxis-future-bookings-my-dept",
            "history-bookings-period" => "taxis-history-bookings-period",
            "requisition-numbers-period" => "taxis-requisition-numbers-period",
            "taxis-per-hire-company" => "taxis-per-hire-company",
            "list-inservice" => "taxis-list-inservice-per-department",
            "list-all" => "taxis-list-per-department",
            "reprint-requisition" => "taxis-reprint-requisition",
            "reprint-taxi-log" => "taxis-reprint-taxi-log",
            _ => "taxis"
        };

    private string GetSelectedCaption()
        => NormalizeReportType(QReportType) switch
        {
            "future-bookings-my-dept" => "Future booking made for my department.",
            "history-bookings-period" => "History bookings for period",
            "requisition-numbers-period" => "List of Requisition Numbers for a period",
            "taxis-per-hire-company" => "Taxis Per Hire Company",
            "list-inservice" => "List Of all Taxis in service in various departments",
            "list-all" => "List Of all Taxis in various departments",
            "reprint-requisition" => "Reprint A Requisition",
            "reprint-taxi-log" => "Reprint A Taxi Log",
            _ => "Taxi Reports Menu"
        };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "future-bookings-my-dept" => "future-bookings-my-dept",
            "history-bookings-period" => "history-bookings-period",
            "requisition-numbers-period" => "requisition-numbers-period",
            "taxis-per-hire-company" => "taxis-per-hire-company",
            "list-inservice" => "list-inservice",
            "list-all" => "list-all",
            "reprint-requisition" => "reprint-requisition",
            "reprint-taxi-log" => "reprint-taxi-log",
            _ => "future-bookings-my-dept"
        };
}
