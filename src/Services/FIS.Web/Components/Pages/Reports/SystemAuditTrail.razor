@page "/reports/system-audit-trail"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject AuditApiService AuditService
@inject IJSRuntime JSRuntime

<PageTitle>System Audit Trail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield-quarter"></i>
            System Audit Trail
        </h1>
        <p class="page-description">
            Every INSERT, UPDATE and DELETE across all system entities is automatically recorded here.
            Sensitive fields (passwords, tokens) are never stored. Filter by table, action, user, or date range.
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
    </div>
</div>

<div class="page-content">

    <div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">
        <button class="btn @(_tab=="changes"  ? "btn-primary":"btn-secondary") btn-sm" @onclick='()=>_tab="changes"'>Entity Changes</button>
        <button class="btn @(_tab=="users"    ? "btn-primary":"btn-secondary") btn-sm" @onclick='()=>_tab="users"'>User Status History</button>
        <button class="btn @(_tab=="password" ? "btn-primary":"btn-secondary") btn-sm" @onclick='()=>_tab="password"'>Password Expiry</button>
    </div>

    @* ══ TAB 1 — Entity changes ══════════════════════════════════════════════ *@
    @if (_tab == "changes")
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Table Name</label>
                        <input class="form-input" @bind="_fTable" placeholder="e.g. vehicle_master" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Action</label>
                        <select class="form-input" @bind="_fAction">
                            <option value="">All</option>
                            <option value="INSERT">INSERT</option>
                            <option value="UPDATE">UPDATE</option>
                            <option value="DELETE">DELETE</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">From Date</label>
                        <InputDate class="form-input" @bind-Value="_fFrom" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">To Date</label>
                        <InputDate class="form-input" @bind-Value="_fTo" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">User Code</label>
                        <input class="form-input" type="number" @bind="_fUserId" placeholder="user_access_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Record PK</label>
                        <input class="form-input" @bind="_fPK" placeholder="Primary key" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm"   @onclick="SearchChangesAsync"  disabled="@_loadC">@(_loadC?"Searching...":"Search")</button>
                    <button class="btn btn-secondary btn-sm" @onclick="ResetChanges">Reset</button>
                    <button class="btn btn-secondary btn-sm" @onclick="ExportCsvAsync"       disabled="@(_changes.Count==0)">Export CSV</button>
                </div>
            </div>
        </div>

        <div class="table-container fis-mt-15">
            <div class="table-header">
                <span class="table-title">Entity Changes — @_cTotal records found</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Action</th>
                            <th>Table</th>
                            <th>Record PK</th>
                            <th>Changed By</th>
                            <th>User Code</th>
                            <th>Old / New Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loadC) { <tr><td colspan="7">Searching...</td></tr> }
                        else if (_changes.Count == 0) { <tr><td colspan="7">No records found. Apply filters and click Search.</td></tr> }
                        else
                        {
                            @foreach (var r in _changes)
                            {
                                <tr>
                                    <td style="white-space:nowrap;">@r.ChangedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="status-badge @ActionClass(r.Action)">@r.Action</span></td>
                                    <td>@r.TableName</td>
                                    <td>@r.PrimaryKey</td>
                                    <td>@(r.ActionedBy ?? "-")</td>
                                    <td>@(r.created_by_user_code?.ToString() ?? "-")</td>
                                    <td>
                                        <details>
                                            <summary style="cursor:pointer;font-size:0.8rem;color:var(--color-primary,#3b82f6);">View diff</summary>
                                            <pre style="font-size:0.72rem;max-width:420px;white-space:pre-wrap;word-break:break-all;background:#f8f8f8;padding:0.5rem;border-radius:4px;margin-top:0.25rem;">@r.Changes</pre>
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_cPages > 1)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevC" disabled="@(_cPage<=1)">Previous</button>
                    <div class="pagination-info">Page @_cPage of @_cPages</div>
                    <button class="pagination-btn" @onclick="NextC" disabled="@(_cPage>=_cPages)">Next</button>
                </div>
            }
        </div>
    }

    @* ══ TAB 2 — User status history ════════════════════════════════════════ *@
    @if (_tab == "users")
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">User Code</label>
                        <input class="form-input" type="number" @bind="_fSUser" placeholder="user_access_code" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">From Date</label>
                        <InputDate class="form-input" @bind-Value="_fSFrom" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">To Date</label>
                        <InputDate class="form-input" @bind-Value="_fSTo" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchStatusAsync" disabled="@_loadS">@(_loadS?"Searching...":"Search")</button>
                </div>
            </div>
        </div>

        <div class="table-container fis-mt-15">
            <div class="table-header">
                <span class="table-title">User Enable / Disable / Lock History — @_sTotal records</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>User Code</th>
                            <th>New Status</th>
                            <th>Previous Status</th>
                            <th>Changed By</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loadS) { <tr><td colspan="6">Searching...</td></tr> }
                        else if (_status.Count == 0) { <tr><td colspan="6">No records found.</td></tr> }
                        else
                        {
                            @foreach (var r in _status)
                            {
                                <tr>
                                    <td>@r.changed_at.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@r.user_access_code</td>
                                    <td><span class="status-badge @StatusClass(r.new_status)">@r.new_status</span></td>
                                    <td>@(r.previous_status ?? "-")</td>
                                    <td>@(r.changed_by_user_code?.ToString() ?? "-")</td>
                                    <td>@(r.reason ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ══ TAB 3 — Password expiry ════════════════════════════════════════════ *@
    @if (_tab == "password")
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">User Code (blank = all)</label>
                        <input class="form-input" type="number" @bind="_fPUser" placeholder="user_access_code" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchPwdAsync" disabled="@_loadP">@(_loadP?"Searching...":"Search")</button>
                </div>
            </div>
        </div>

        <div class="table-container fis-mt-15">
            <div class="table-header">
                <span class="table-title">Password Change &amp; Expiry Status</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User Code</th>
                            <th>Last Changed (UTC)</th>
                            <th>Expires On</th>
                            <th>Status</th>
                            <th>Changed By</th>
                            <th>Failed Logins</th>
                            <th>Locked Until</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loadP) { <tr><td colspan="7">Searching...</td></tr> }
                        else if (_pwd.Count == 0) { <tr><td colspan="7">No records found.</td></tr> }
                        else
                        {
                            @foreach (var r in _pwd)
                            {
                                <tr>
                                    <td>@r.user_access_code</td>
                                    <td>@r.last_password_change.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(r.password_expiry_date?.ToString("yyyy-MM-dd") ?? "Legacy (calc. 90-day)")</td>
                                    <td>
                                        @if (r.IsExpired)
                                        { <span class="status-badge status-badge-danger">EXPIRED</span> }
                                        else
                                        { <span class="status-badge status-badge-success">Active</span> }
                                    </td>
                                    <td>@(r.changed_by_user_code?.ToString() ?? "Self / Unknown")</td>
                                    <td>@r.failed_login_attempts</td>
                                    <td>@(r.account_locked_until?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private string _tab = "changes";

    // Tab 1
    private bool      _loadC;
    private string?   _fTable;
    private string?   _fAction;
    private DateTime? _fFrom   = DateTime.Today.AddDays(-7);
    private DateTime? _fTo     = DateTime.Today;
    private int?      _fUserId;
    private string?   _fPK;
    private int       _cPage  = 1;
    private int       _cPages = 1;
    private int       _cTotal;
    private List<AuditItemDto> _changes = new();

    // Tab 2
    private bool      _loadS;
    private int?      _fSUser;
    private DateTime? _fSFrom = DateTime.Today.AddMonths(-3);
    private DateTime? _fSTo   = DateTime.Today;
    private int       _sTotal;
    private List<UserStatusItemDto> _status = new();

    // Tab 3
    private bool _loadP;
    private int? _fPUser;
    private List<PasswordHistoryItemDto> _pwd = new();

    // ── Tab 1 ─────────────────────────────────────────────────────────────────

    private async Task SearchChangesAsync()
    {
        _loadC = true;
        try
        {
            var r = await AuditService.GetAuditTrailAsync(
                tableName:  _fTable,
                action:     _fAction,
                fromDate:   _fFrom,
                toDate:     _fTo,
                userId:     _fUserId,
                primaryKey: _fPK,
                pageNumber: _cPage,
                pageSize:   50);
            _changes = r.Items;
            _cTotal  = r.TotalCount;
            _cPages  = r.TotalPages;
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("console.error", ex.Message); }
        finally { _loadC = false; }
    }

    private void ResetChanges()
    {
        _fTable = null; _fAction = null; _fPK = null; _fUserId = null;
        _fFrom = DateTime.Today.AddDays(-7); _fTo = DateTime.Today;
        _cPage = 1; _changes = new(); _cTotal = 0;
    }

    private void PrevC() { if (_cPage > 1) { _cPage--; _ = SearchChangesAsync(); } }
    private void NextC() { if (_cPage < _cPages) { _cPage++; _ = SearchChangesAsync(); } }

    private async Task ExportCsvAsync()
    {
        var lines = new List<string>
            { "\"Timestamp\",\"Action\",\"Table\",\"PK\",\"Changed By\",\"User Code\",\"Changes\"" };
        foreach (var r in _changes)
            lines.Add(string.Join(",",
                Csv(r.ChangedAt.ToString("yyyy-MM-dd HH:mm:ss")),
                Csv(r.Action), Csv(r.TableName), Csv(r.PrimaryKey),
                Csv(r.ActionedBy), Csv(r.created_by_user_code?.ToString()), Csv(r.Changes)));
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText",
            $"system_audit_{DateTime.Now:yyyyMMdd_HHmm}.csv",
            string.Join(Environment.NewLine, lines), "text/csv;charset=utf-8");
    }

    // ── Tab 2 ─────────────────────────────────────────────────────────────────

    private async Task SearchStatusAsync()
    {
        _loadS = true;
        try
        {
            var r = await AuditService.GetUserStatusHistoryAsync(_fSUser, _fSFrom, _fSTo);
            _status = r.Items; _sTotal = r.TotalCount;
        }
        finally { _loadS = false; }
    }

    // ── Tab 3 ─────────────────────────────────────────────────────────────────

    private async Task SearchPwdAsync()
    {
        _loadP = true;
        try
        {
            var r = await AuditService.GetPasswordHistoryAsync(_fPUser);
            _pwd = r.Items;
        }
        finally { _loadP = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string ActionClass(string? a) => a switch
    {
        "INSERT" => "status-badge-success",
        "UPDATE" => "status-badge-warning",
        "DELETE" => "status-badge-danger",
        _        => ""
    };

    private static string StatusClass(string? s) => s switch
    {
        "enabled" or "unlocked"   => "status-badge-success",
        "disabled" or "locked"    => "status-badge-danger",
        "password_reset"          => "status-badge-warning",
        _                         => ""
    };

    private static string Csv(string? v)
    {
        var s = (v ?? "").Replace("\"", "\"\"");
        return $"\"{s}\"";
    }
}
