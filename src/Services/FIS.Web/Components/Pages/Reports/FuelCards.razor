@page "/reports/fuel-cards"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Fuel Card Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-credit-card"></i>
            Fuel Card Reports
        </h1>
        <p class="page-description">Legacy fuel card report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/fuelcards">Fuel Card Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>FuelCard Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Fuelcard Report for a Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-pan")'>2) Fuelcard Report for a PAN Number</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle-handout")'>3) Fuelcard Handout Report</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("all-vehicles")'>4) Fuelcard Report for ALL Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("expire-date")'>5) Fuelcard Report for an Expire Date</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("replace-reason")'>6) Fuelcard Report for a Replace Reason</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("dept-site-expire-period")'>7) Fuelcard Report, for a Department / Site, for an Expire Period</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("dept-site")'>8) Fuelcard Report for a Department / Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-site-expire-date")'>9) Fuelcard Report for a Dept Site and Expire Date</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("pool-vehicles")'>10) Fuelcard Report for POOL Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vip-vehicles")'>11) Fuelcard Report for VIP Vehicles</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("wesbank-new-cards")'>12) Wesbank Application for New FuelCards</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/fuel-cards">Back to Fuel Card Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/fuel-cards" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/fuel-cards", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "fuelcards-one-vehicle",
        "one-pan" => "fuelcards-one-pan",
        "one-vehicle-handout" => "fuelcards-one-vehicle-handout",
        "all-vehicles" => "fuel-cards",
        "expire-date" => "fuelcards-expire-date",
        "replace-reason" => "fuelcards-replace-reason",
        "dept-site-expire-period" => "fuelcards-dept-site-expire-period",
        "dept-site" => "fuelcards-dept-site",
        "one-site-expire-date" => "fuelcards-one-site-expire-date",
        "pool-vehicles" => "fuelcards-pool-vehicles",
        "vip-vehicles" => "fuelcards-vip-vehicles",
        "wesbank-new-cards" => "fuelcards-wesbank-new-cards",
        _ => "fuel-cards"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Fuelcard Report for a Vehicle",
        "one-pan" => "Fuelcard Report for a PAN Number",
        "one-vehicle-handout" => "Fuelcard Handout Report",
        "all-vehicles" => "Fuelcard Report for ALL Vehicles",
        "expire-date" => "Fuelcard Report for an Expire Date",
        "replace-reason" => "Fuelcard Report for a Replace Reason",
        "dept-site-expire-period" => "Fuelcard Report, for a Department / Site, for an Expire Period",
        "dept-site" => "Fuelcard Report for a Department / Site",
        "one-site-expire-date" => "Fuelcard Report for a Dept Site and Expire Date",
        "pool-vehicles" => "Fuelcard Report for POOL Vehicles",
        "vip-vehicles" => "Fuelcard Report for VIP Vehicles",
        "wesbank-new-cards" => "Wesbank Application for New FuelCards",
        _ => "Fuel Card Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "one-pan" => "one-pan",
            "one-vehicle-handout" => "one-vehicle-handout",
            "all-vehicles" => "all-vehicles",
            "expire-date" => "expire-date",
            "replace-reason" => "replace-reason",
            "dept-site-expire-period" => "dept-site-expire-period",
            "dept-site" => "dept-site",
            "one-site-expire-date" => "one-site-expire-date",
            "pool-vehicles" => "pool-vehicles",
            "vip-vehicles" => "vip-vehicles",
            "wesbank-new-cards" => "wesbank-new-cards",
            _ => "all-vehicles"
        };
}
