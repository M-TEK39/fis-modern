@page "/reports/fuel-cards"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FleetManagementApiService FleetService
@inject SiteApiService SiteService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>Fuel Card Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Fuel Card Reports
        </h1>
        <p class="page-description">Fuel card allocation summary and recent activity.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card" style="margin-bottom: 1.5rem;">
        <div class="form-card-header">
            <h2>Fuel Card Allocation Summary</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Site (optional)</label>
                    <select class="form-select" @bind="_siteCodeInput">
                        <option value="">All sites</option>
                        @foreach (var site in _sites.OrderBy(s => s.Description))
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="LoadReport" disabled="@_loading">
                    @(_loading ? "Loading..." : "Load Report")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-error" style="margin-top: 1rem;">@_errorMessage</div>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading fuel card allocation...</p>
        </div>
    }
    else if (_report?.Report is null)
    {
        <div class="empty-state">
            <i class="bx bx-file"></i>
            <h3>Fuel Card Reports</h3>
            <p>Load a report to view allocation details.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Allocation Summary</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <tbody>
                        <tr>
                            <th>Total Cards</th>
                            <td>@_report.Report.TotalCards</td>
                            <th>Active Cards</th>
                            <td>@_report.Report.ActiveCards</td>
                        </tr>
                        <tr>
                            <th>Returned Cards</th>
                            <td>@_report.Report.ReturnedCards</td>
                            <th>Expiring (90 days)</th>
                            <td>@_report.Report.ExpiringCards</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-container" style="margin-top: 1.5rem;">
            <div class="table-header">
                <span class="table-title">Recent Activity</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Card Number</th>
                            <th>Vehicle</th>
                            <th>Action</th>
                            <th>Date</th>
                            <th>Receiver</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_report.Report.RecentActivity.Count == 0)
                        {
                            <tr>
                                <td colspan="5">No recent activity.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var activity in PagedActivity)
                            {
                                <tr>
                                    <td>@activity.CardNumber</td>
                                    <td>@GetVehicleLabel(activity.VmfCode)</td>
                                    <td>@activity.Action</td>
                                    <td>@activity.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@activity.Receiver</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private FuelCardReportResponse? _report;
    private bool _loading;
    private string? _errorMessage;
    private int? _siteCodeInput;
    private List<SiteResponseDto> _sites = new();
    private Dictionary<int, string> _vehicleLabels = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<FuelCardActivityDto> PagedActivity =>
        (_report?.Report?.RecentActivity ?? new List<FuelCardActivityDto>())
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    private int TotalPages
    {
        get
        {
            var total = _report?.Report?.RecentActivity.Count ?? 0;
            return Math.Max(1, (int)Math.Ceiling(total / (double)_pageSize));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabels = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(g => g.Key, g => $"{ValueOrDash(g.First().fleet_number)} / {ValueOrDash(g.First().registration_number)} ({g.Key})");
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _report = await FleetService.GetFuelCardAllocationAsync(_siteCodeInput);
            if (_report is null || !_report.Success)
            {
                _errorMessage = _report?.Message ?? "Unable to load fuel card report.";
            }
            _page = 1;
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load fuel card report.";
            await JS.InvokeVoidAsync("console.error", $"Fuel card report error: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabels.TryGetValue(vmfCode.Value, out var label)
            ? label
            : $"- / - ({vmfCode.Value})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
