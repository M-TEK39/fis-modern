@page "/reports/wesbank"
@page "/Transaction/RPTTransaction.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Wesbank Transaction Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Wesbank Transaction Reports
        </h1>
        <p class="page-description">Legacy Wesbank transaction report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/finance">Finance Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Wesbank Transaction Reports Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-section-title">One Vehicle Report</div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle")'>1) Wesbank Transaction Report for ONE Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-vehicle-period")'>2) Wesbank Transaction Report for ONE Vehicle, for a Period</a><span class="menu-item-badge">Report</span></div>

                    <div class="menu-section-title">Wesbank Transactions Report for ALL Vehicles</div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("one-dept-site")'>3) Wesbank Transaction Report for ONE Dept Site</a><span class="menu-item-badge">Report</span></div>

                    <div class="menu-section-title">Other Wesbank Transaction Reports</div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("overfills")'>4) Exeption Report Overfills</a><span class="menu-item-badge">Exception</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("multiple-daily-fuels")'>5) Exeption Multiple Daily Fuel Transactions</a><span class="menu-item-badge">Exception</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/wesbank">Back to Wesbank Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/wesbank" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/wesbank", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "wesbank-one-vehicle",
        "one-vehicle-period" => "wesbank-one-vehicle-period",
        "one-dept-site" => "wesbank-one-dept-site",
        "overfills" => "wesbank-overfills",
        "multiple-daily-fuels" => "wesbank-multiple-daily-fuels",
        _ => "wesbank"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "one-vehicle" => "Wesbank Transaction Report for ONE Vehicle",
        "one-vehicle-period" => "Wesbank Transaction Report for ONE Vehicle, for a Period",
        "one-dept-site" => "Wesbank Transaction Report for ONE Dept Site",
        "overfills" => "Exeption Report Overfills",
        "multiple-daily-fuels" => "Exeption Multiple Daily Fuel Transactions",
        _ => "Wesbank Transaction Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "one-vehicle" => "one-vehicle",
            "one-vehicle-period" => "one-vehicle-period",
            "one-dept-site" => "one-dept-site",
            "overfills" => "overfills",
            "multiple-daily-fuels" => "multiple-daily-fuels",
            _ => "one-vehicle"
        };
}
