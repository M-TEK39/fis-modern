@page "/reports/vip-pool-utilization-current"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>VIP/Pool Utilization (Current Month) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar-star"></i>
            VIP and Pool Utilization (Current Month)
        </h1>
        <p class="page-description">Legacy generated utilization report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/trip-authorities">Trip Authorities</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Utilization of VIP and Pool vehicles (H.O.D. report - current month)</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="vip-pool-utilization-current" FiltersUrl="/reports/vip-pool-utilization-current" />
</div>
