@page "/reports/trip-authority"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Trip Authority Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map"></i>
            Trip Authority Reports
        </h1>
        <p class="page-description">Legacy trip authority report menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/trip-authorities">Trip Authorities</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header"><span>1) Vehicle Reports</span></div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-per-site")'>1.1) Registered Vehicles in Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-per-department")'>1.2) Registered Vehicles in Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-contract-type-site")'>1.3) Number of Vehicles per Contract Type (Site)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-contract-type-department")'>1.4) Number of Vehicles per Contract Type (Department)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-contract-type-department-site")'>1.5) Number of Vehicles per Contract Type per Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("available-vehicles-site")'>1.6) Available Vehicles in Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("unavailable-vehicles-site")'>1.7) Unavailable Vehicles in Site</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>

            <div class="menu-tile">
                <div class="menu-tile-header"><span>2) Personnel Reports</span></div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("users-per-site")'>2.1) Registered Users in Site</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("users-per-department")'>2.2) Registered Users in Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("users-all-departments")'>2.3) Registered Users in all Departments</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trips-per-user-all")'>2.4) Trips Issued Per User (All Users)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trips-per-user-department")'>2.5) Trips Issued Per User in Department</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>

            <div class="menu-tile">
                <div class="menu-tile-header"><span>3) Vehicle Trip Reports</span></div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trips-for-vehicle")'>3.1) Trips Issued for a Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("drivers-for-vehicle")'>3.2) All Drivers For a Vehicle</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-utilisation-driver")'>3.3) Vehicle Utilisation by a Driver</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicle-utilisation")'>3.4) Vehicle Utilisation</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-no-trips")'>3.5) Vehicles with no trips (Any Department)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("vehicles-no-trips-daterange")'>3.6) Vehicles with no trips between start/end date</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("high-distance-department")'>3.7) Vehicles with high distances in Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("high-distance-all")'>3.8) Vehicles with high distances in all departments</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-count-last-3-months")'>3.9) Number of Trips issued in last 3 months</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trips-open-over-31")'>3.10) Trips open for over 31 days</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-authorities-over-25000")'>3.11) Trip Authorities Exceeding 25000 per Trip</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("trip-authorities-over-3500-per-day")'>3.12) Trip Authorities Exceeding 3500 per Day per Route</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>

            <div class="menu-tile">
                <div class="menu-tile-header"><span>4) Vehicle Kilo Reports</span></div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("els-manual-kilo")'>4.1) Electronic Logsheet and Manual Logsheet kilo Report</a><span class="menu-item-badge">Report</span></div>
                </div>
            </div>

            <div class="menu-tile">
                <div class="menu-tile-header"><span>5) Driver Information Reports</span></div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("driver-information-finyear")'>5.1) Driver Information over Financial Year Selection</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports">Return to Main Report Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/trip-authority">Back to Trip Authority Reports Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/trip-authority" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?> { ["rtype"] = reportType };
        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/trip-authority", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType);

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "vehicles-per-site" => "Registered Vehicles in Site",
        "vehicles-per-department" => "Registered Vehicles in Department",
        "vehicles-contract-type-site" => "Number of Vehicles in Site Per Contract Type",
        "vehicles-contract-type-department" => "Number of Vehicles in Department Per Contract Type",
        "vehicles-contract-type-department-site" => "Number of Vehicles in Department Per Contract Type Per Site",
        "available-vehicles-site" => "Available Vehicles in Site",
        "unavailable-vehicles-site" => "Unavailable Vehicles in Site",
        "users-per-site" => "Registered Users in Site",
        "users-per-department" => "Registered Users in Department",
        "users-all-departments" => "Registered Users in all Departments",
        "trips-per-user-all" => "Trips Issued Per User (All Users)",
        "trips-per-user-department" => "Trips Issued Per User in Department",
        "trips-for-vehicle" => "Trips Issued for a Vehicle",
        "drivers-for-vehicle" => "All Drivers For a Vehicle",
        "vehicle-utilisation-driver" => "Vehicle Utilisation by a Driver",
        "vehicle-utilisation" => "Vehicle Utilisation",
        "vehicles-no-trips" => "Vehicles with no trips (Any Department)",
        "vehicles-no-trips-daterange" => "Vehicles with no trips between start and end date",
        "high-distance-department" => "Vehicles with high distances in Department",
        "high-distance-all" => "Vehicles with high distances in all departments",
        "trip-count-last-3-months" => "Number of Trips issued in last 3 months",
        "trips-open-over-31" => "Trips open for over 31 days",
        "trip-authorities-over-25000" => "Trip Authorities Exceeding 25000 per Trip",
        "trip-authorities-over-3500-per-day" => "Trip Authorities Exceeding 3500 per Day per Route",
        "els-manual-kilo" => "Electronic Logsheet and Manual Logsheet kilo Report",
        "driver-information-finyear" => "Driver Information over Financial Year Selection",
        _ => "Trip Authority Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "vehicles-per-site" => "vehicles-per-site",
            "vehicles-per-department" => "vehicles-per-department",
            "vehicles-contract-type-site" => "vehicles-contract-type-site",
            "vehicles-contract-type-department" => "vehicles-contract-type-department",
            "vehicles-contract-type-department-site" => "vehicles-contract-type-department-site",
            "available-vehicles-site" => "available-vehicles-site",
            "unavailable-vehicles-site" => "unavailable-vehicles-site",
            "users-per-site" => "users-per-site",
            "users-per-department" => "users-per-department",
            "users-all-departments" => "users-all-departments",
            "trips-per-user-all" => "trips-per-user-all",
            "trips-per-user-department" => "trips-per-user-department",
            "trips-for-vehicle" => "trips-for-vehicle",
            "drivers-for-vehicle" => "drivers-for-vehicle",
            "vehicle-utilisation-driver" => "vehicle-utilisation-driver",
            "vehicle-utilisation" => "vehicle-utilisation",
            "vehicles-no-trips" => "vehicles-no-trips",
            "vehicles-no-trips-daterange" => "vehicles-no-trips-daterange",
            "high-distance-department" => "high-distance-department",
            "high-distance-all" => "high-distance-all",
            "trip-count-last-3-months" => "trip-count-last-3-months",
            "trips-open-over-31" => "trips-open-over-31",
            "trip-authorities-over-25000" => "trip-authorities-over-25000",
            "trip-authorities-over-3500-per-day" => "trip-authorities-over-3500-per-day",
            "els-manual-kilo" => "els-manual-kilo",
            "driver-information-finyear" => "driver-information-finyear",
            _ => "vehicles-per-site"
        };
}
