@page "/reports/trip-authority"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject TripApiService TripService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Trip Authority Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map"></i>
            Trip Authority Reports
        </h1>
        <p class="page-description">Report by date range for trip authority activity.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/trip-authorities">Trip Authorities</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <InputDate class="form-input" @bind-Value="_startDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <InputDate class="form-input" @bind-Value="_endDate" />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="_loading">Submit</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Trip Authority Report</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Trip ID</th>
                        <th>Vehicle</th>
                        <th>Trip Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="5">Loading report...</td></tr>
                    }
                    else if (_rows.Count == 0)
                    {
                        <tr><td colspan="5">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.TripId</td>
                                <td>@GetVehicleLabel(row.VmfCode)</td>
                                <td>@(row.TripDate == DateTime.MinValue ? "-" : row.TripDate.ToString("yyyy-MM-dd"))</td>
                                <td>@ValueOrDash(row.Status)</td>
                                <td>@ValueOrDash(row.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_rows.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? _endDate = DateTime.Today;
    private bool _loading;
    private List<TripDto> _rows = new();
    private Dictionary<int, string> _vehicleLabels = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TripDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await BuildVehicleLabelCacheAsync();
        await LoadReportAsync();
    }

    private async Task BuildVehicleLabelCacheAsync()
    {
        try
        {
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _vehicleLabels = vehicles.Data
                .GroupBy(v => v.vmf_code)
                .ToDictionary(g => g.Key, g => $"{ValueOrDash(g.First().fleet_number)} / {ValueOrDash(g.First().registration_number)} ({g.Key})");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicles cache: {ex.Message}");
        }
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var startDate = _startDate ?? DateTime.Today.AddDays(-30);
            var endDate = _endDate ?? DateTime.Today;

            if (endDate < startDate)
            {
                (startDate, endDate) = (endDate, startDate);
            }

            _rows = await TripService.GetDateRangeAsync(startDate, endDate);
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading trip authority report: {ex.Message}");
            _rows = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _startDate = DateTime.Today.AddDays(-30);
        _endDate = DateTime.Today;
    }

    private string GetVehicleLabel(int vmfCode)
        => _vehicleLabels.TryGetValue(vmfCode, out var label) ? label : vmfCode.ToString();

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
