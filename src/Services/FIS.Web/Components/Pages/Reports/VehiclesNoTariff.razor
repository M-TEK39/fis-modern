@page "/reports/vehicles-no-tariff"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Vehicles with Expired or No Tariff - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Vehicles with Expired or No Tariff Loaded
        </h1>
        <p class="page-description">Legacy no/expired tariff report with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">List of Vehicles with Expired or No Tariff Loaded (New and In Service)</span>
            <div class="table-controls">
                <a class="btn btn-secondary btn-sm" href="/reports">Back to Reports Menu</a>
            </div>
        </div>
    </div>

    <LegacyDynamicReportGrid ReportKey="vehicles-no-tariff" FiltersUrl="/reports/vehicles-no-tariff" />
</div>
