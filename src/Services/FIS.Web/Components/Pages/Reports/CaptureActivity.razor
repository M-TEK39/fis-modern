@page "/reports/capture-activity"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Capture Activity Report - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-check"></i>
            Capture Activity Report
        </h1>
        <p class="page-description">Legacy-style capture activity filter flow with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Date From</label>
                        <InputDate class="form-input" @bind-Value="_dateFrom" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Date To</label>
                        <InputDate class="form-input" @bind-Value="_dateTo" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Module</label>
                        <select class="form-select" @bind="_module">
                            @foreach (var module in _modules)
                            {
                                <option value="@module">@module</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site</label>
                        <input class="form-input" @bind="_siteCodeText" placeholder="All sites" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Number or VMF</label>
                        <input class="form-input" @bind="_vehicleSearch" placeholder="GG123 or 14028" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Captured By</label>
                        <input class="form-input" @bind="_capturedByText" placeholder="User code" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResults">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Capture Activity Report</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/capture-activity">Back to Filters</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="capture-activity" FiltersUrl="/reports/capture-activity" />
    }
</div>

@code {
    private DateTime _dateFrom = DateTime.Today.AddDays(-7);
    private DateTime _dateTo = DateTime.Today;
    private string _module = "All";
    private string _siteCodeText = string.Empty;
    private string _vehicleSearch = string.Empty;
    private string _capturedByText = string.Empty;

    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? QFrom { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "to")]
    public string? QTo { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "module")]
    public string? QModule { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "site")]
    public string? QSite { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "vehicle")]
    public string? QVehicle { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "capturedby")]
    public string? QCapturedBy { get; set; }

    protected override Task OnParametersSetAsync()
    {
        _dateFrom = ReportFilterHelper.ParseDate(QFrom) ?? _dateFrom;
        _dateTo = ReportFilterHelper.ParseDate(QTo) ?? _dateTo;
        _module = QModule ?? _module;
        _siteCodeText = QSite ?? _siteCodeText;
        _vehicleSearch = QVehicle ?? _vehicleSearch;
        _capturedByText = QCapturedBy ?? _capturedByText;
        return Task.CompletedTask;
    }

    private void NavigateToResults()
    {
        var filters = new Dictionary<string, string?>
        {
            ["from"] = ReportFilterHelper.FormatDate(_dateFrom),
            ["to"] = ReportFilterHelper.FormatDate(_dateTo),
            ["module"] = _module,
            ["site"] = _siteCodeText,
            ["vehicle"] = _vehicleSearch,
            ["capturedby"] = _capturedByText,
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/capture-activity", filters));
    }

    private void ResetFilters()
    {
        _dateFrom = DateTime.Today.AddDays(-7);
        _dateTo = DateTime.Today;
        _module = "All";
        _siteCodeText = string.Empty;
        _vehicleSearch = string.Empty;
        _capturedByText = string.Empty;
    }

    private static readonly List<string> _modules =
    [
        "All",
        "Vehicles",
        "Contracts",
        "Accidents",
        "Fines",
        "JobCards",
        "Logbooks",
        "Trips",
        "Taxis",
        "FuelCards"
    ];
}
