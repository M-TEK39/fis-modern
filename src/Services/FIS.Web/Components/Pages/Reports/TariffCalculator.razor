@page "/tariff-calculator"
@page "/tariff-calculator/index"
@rendermode InteractiveServer

<PageTitle>Tariff Calculator - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calculator"></i>
            Tariff Calculator
        </h1>
        <p class="page-description">Legacy tariff calculator entry point routed to the modern tariff workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/home">Main Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p>Use the modern tariff screens below:</p>
            <div class="form-actions">
                <a class="btn btn-primary btn-sm" href="/full-maintenance-lease/tariffs">Tariff Capture</a>
                <a class="btn btn-secondary btn-sm" href="/reports/tariffs">Tariff Reports</a>
            </div>
        </div>
    </div>
</div>
