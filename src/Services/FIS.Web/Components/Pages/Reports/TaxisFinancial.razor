@page "/reports/taxis-financial"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Financial Reports: Taxis - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-money"></i>
            Financial Reports: Taxis
        </h1>
        <p class="page-description">Legacy taxi financial reports menu with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
        <a class="btn btn-primary btn-sm" href="/taxis">Taxi Module</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Taxi Reports</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("general-requisitions")'>1) General Reports: Requisitions</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("requisitions-per-department")'>2) Requisitions per Department</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("outstanding-logsheets")'>3) All Outstanding Log sheets</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("log-odometer-gg")'>4) Log Odometer (GG Vehicles)</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("cancellations")'>5) Cancellations</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="javascript:void(0)" @onclick='() => NavigateToReport("no-objective-or-responsibility")'>6) Taxi log sheets with no Objective or Responsibility codes</a><span class="menu-item-badge">Report</span></div>
                    <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a><span class="menu-item-badge">Menu</span></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@GetSelectedCaption()</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/taxis-financial">Back to Financial Reports: Taxis Menu</a>
                    <a class="btn btn-secondary btn-sm" href="/reports/fis-report">FIS Report Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="@GetReportKey()" FiltersUrl="/reports/taxis-financial" />
    }
</div>

@code {
    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "rtype")]
    public string? QReportType { get; set; }

    private void NavigateToReport(string reportType)
    {
        var filters = new Dictionary<string, string?>
        {
            ["rtype"] = reportType
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/taxis-financial", filters));
    }

    private string GetReportKey() => NormalizeReportType(QReportType) switch
    {
        "general-requisitions" => "taxis-fin-general-requisitions",
        "requisitions-per-department" => "taxis-fin-requisitions-per-department",
        "outstanding-logsheets" => "taxis-fin-outstanding-logsheets",
        "log-odometer-gg" => "taxis-fin-log-odometer-gg",
        "cancellations" => "taxis-fin-cancellations",
        "no-objective-or-responsibility" => "taxis-fin-no-objective-or-responsibility",
        _ => "taxis-financial"
    };

    private string GetSelectedCaption() => NormalizeReportType(QReportType) switch
    {
        "general-requisitions" => "General Reports: Requisitions",
        "requisitions-per-department" => "Requisitions per Department",
        "outstanding-logsheets" => "All Outstanding Log sheets",
        "log-odometer-gg" => "Log Odometer (GG Vehicles)",
        "cancellations" => "Cancellations",
        "no-objective-or-responsibility" => "Taxi log sheets with no Objective or Responsibility codes",
        _ => "Taxi Reports"
    };

    private static string NormalizeReportType(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "general-requisitions" => "general-requisitions",
            "requisitions-per-department" => "requisitions-per-department",
            "outstanding-logsheets" => "outstanding-logsheets",
            "log-odometer-gg" => "log-odometer-gg",
            "cancellations" => "cancellations",
            "no-objective-or-responsibility" => "no-objective-or-responsibility",
            _ => "general-requisitions"
        };
}
