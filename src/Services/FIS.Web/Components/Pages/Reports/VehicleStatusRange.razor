@page "/reports/vehicle-status-range"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject NavigationManager Navigation

<PageTitle>Vehicle Status in Date Range - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar-check"></i>
            Vehicle Status in Date Range
        </h1>
        <p class="page-description">Legacy vehicle status filter flow with modern UI presentation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
        <a class="btn btn-primary btn-sm" href="/vehicles">Vehicle Master</a>
    </div>
</div>

<div class="page-content">
    @if (!_isResultView)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Vehicle Status</label>
                        <select class="form-select" @bind="_selectedStatus">
                            <option value="">View All</option>
                            @foreach (var status in _availableStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <InputDate class="form-input" @bind-Value="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <InputDate class="form-input" @bind-Value="_endDate" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="NavigateToResults">Submit</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">List of vehicles by selected status in a date range</span>
                <div class="table-controls">
                    <a class="btn btn-secondary btn-sm" href="/reports/vehicle-status-range">Back to Vehicle Status Filters</a>
                    <a class="btn btn-secondary btn-sm" href="/reports">Reports Menu</a>
                </div>
            </div>
        </div>

        <LegacyDynamicReportGrid ReportKey="vehicle-status-range" FiltersUrl="/reports/vehicle-status-range" />
    }
</div>

@code {
    private string _selectedStatus = string.Empty;
    private DateTime? _startDate = DateTime.Today.AddMonths(-6);
    private DateTime? _endDate = DateTime.Today;
    private List<string> _availableStatuses = new();

    private bool _isResultView => ReportFilterHelper.IsResultView(ViewMode);

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "status")]
    public string? QStatus { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? QFrom { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "to")]
    public string? QTo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _availableStatuses = vehicles.Data
            .Select(v => v.status_description)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList()!;
    }

    protected override Task OnParametersSetAsync()
    {
        _selectedStatus = QStatus ?? _selectedStatus;
        _startDate = ReportFilterHelper.ParseDate(QFrom) ?? _startDate;
        _endDate = ReportFilterHelper.ParseDate(QTo) ?? _endDate;
        return Task.CompletedTask;
    }

    private void NavigateToResults()
    {
        var filters = new Dictionary<string, string?>
        {
            ["status"] = _selectedStatus,
            ["from"] = ReportFilterHelper.FormatDate(_startDate),
            ["to"] = ReportFilterHelper.FormatDate(_endDate)
        };

        Navigation.NavigateTo(ReportFilterHelper.BuildResultUrl("/reports/vehicle-status-range", filters));
    }

    private void ResetFilters()
    {
        _selectedStatus = string.Empty;
        _startDate = DateTime.Today.AddMonths(-6);
        _endDate = DateTime.Today;
    }
}
