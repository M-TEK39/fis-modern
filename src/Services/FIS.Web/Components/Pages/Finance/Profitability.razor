@page "/finance/profitability"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>Vehicles Profitability Report</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-line-chart"></i>
            Vehicles Profitability Report
        </h1>
        <p class="page-description">VIP and Pool vehicles profitability reporting aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>VIP and Pool Vehicles Profitability Report</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Financial Year</label>
                    <select class="form-select" @bind="_selectedYear">
                        <option value="">Select Year</option>
                        @foreach (var year in _financialYears)
                        {
                            <option value="@year.Value">@year.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="RunReportAsync" disabled="@_submitting">Generate Report</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FinanceOptionDto> _financialYears = new();
    private string _selectedYear = string.Empty;
    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _financialYears = await FinanceService.GetFinancialYearsAsync();
    }

    private async Task RunReportAsync()
    {
        _submitting = true;
        var result = await FinanceService.PostActionAsync("api/Report/universal", new
        {
            reportType = "financial",
            parameters = new Dictionary<string, object?>
            {
                ["mode"] = "profitability",
                ["financialYear"] = _selectedYear
            }
        });

        _statusError = !result.Success;
        _statusMessage = result.Message;
        _submitting = false;
    }
}
