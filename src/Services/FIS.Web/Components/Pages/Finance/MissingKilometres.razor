@page "/finance/missing-kilometres/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map-alt"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Missing kilometres reporting aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
        </div>
        <div class="form-card-body">
            @if (Action == "close-gaps")
            {
                <p>Automatically capture missing kilometres for the selected financial year.</p>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year</label>
                        <select class="form-select">
                            <option value="">Select Year</option>
                        </select>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Run Process</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (Action == "kilo-gaps-pdf" || Action == "kilo-gaps-xls")
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year</label>
                        <select class="form-select">
                            <option value="">Select Year</option>
                        </select>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (Action == "fuel-consumption")
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department (optional)</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Province (optional)</label>
                        <select class="form-select">
                            <option value="">Select Province</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input class="form-input" placeholder="Start Date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input class="form-input" placeholder="End Date" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">
                            <input type="checkbox" />
                            Exclude Unposted
                        </label>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (Action == "no-kilos-consuming-fuel")
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <select class="form-select">
                            <option value="">Select Start Date</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <select class="form-select">
                            <option value="">Select End Date</option>
                        </select>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <select class="form-select">
                            <option value="">Select Start Date</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <select class="form-select">
                            <option value="">Select End Date</option>
                        </select>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private string PageTitleText => Action switch
    {
        "fuel-consumption" => "Missing Kilometres from Fuel Consumption",
        "no-kilos-consuming-fuel" => "Vehicles with No Kilos but Consumed Fuel",
        "kilo-gaps-pdf" => "Missing Kilometres Report (PDF)",
        "kilo-gaps-xls" => "Missing Kilometres Report (Excel)",
        "close-gaps" => "Automatically Capture Missing Kilometres",
        _ => "Missing Kilometres"
    };

    private string SectionTitle => PageTitleText;
}
