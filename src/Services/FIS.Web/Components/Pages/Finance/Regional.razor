@page "/finance/regional/{Action?}"
@page "/Finance/FinanceRegionMenu.aspx"
@page "/Finance/FinanceRegionAssetMenu.aspx"
@page "/Finance/GetTotalCostReportsDateRangeProvince.aspx"
@page "/Finance/GetTotalCostReportsDateRange.aspx"
@page "/Finance/AssetVehicleReports.aspx"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using FIS.Web.Models
@using FIS.Web.Services
@using System.Text.Json
@using Microsoft.JSInterop
@inject FinanceApiService FinanceService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Regional finance module.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    @if (Action == "assets")
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Asset List: Vehicles in FIS (New & In-Service)</h2>
            </div>
            <div class="form-card-body">
                <div class="menu-tiles">
                    <div class="menu-tile">
                        <button class="menu-tile-header">
                            <span>Regional Asset Menu</span>
                            <i class="bx bx-chevron-down"></i>
                        </button>
                        <div class="menu-tile-body">
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/assets-all">i) Asset List: All Vehicles in FIS with status New &amp; In-Service (All Departments)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/assets-province">ii) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by PROVINCE)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/assets-department">iii) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by DEPARTMENT)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/assets-site">iv) Asset List: All Vehicles in FIS with status New &amp; In-Service (View by SITE)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/vehicles/status">b) View list of vehicles of a selected Vehicle Status in a Date Range</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Action == "assets-all" || Action == "assets-province" || Action == "assets-department" || Action == "assets-site")
    {
        <div class="form-card">
            <div class="form-card-header"><h2>Asset List: All Vehicles in FIS with status New &amp; In-Service</h2></div>
            <div class="form-card-body">
                <div class="form-grid">
                    @if (Action == "assets-province")
                    {
                        <div class="form-field">
                            <label class="form-label">Province</label>
                            <select class="form-select" @bind="_selectedProvince">
                                <option value="">Select Province</option>
                                @foreach (var province in _provinces)
                                {
                                    <option value="@province.Value">@province.Label</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Action == "assets-department" || Action == "assets-site")
                    {
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_selectedDepartment" @bind:after="OnDepartmentChangedAsync">
                                <option value="">Select Department</option>
                                @foreach (var department in _departments)
                                {
                                    <option value="@department.Value">@department.Label</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Action == "assets-site")
                    {
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_selectedSite">
                                <option value="">Select Site</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Value">@site.Label</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunAssetReportAsync" disabled="@_submitting">View Report</button>
                    <a class="btn btn-secondary btn-sm" href="/finance/regional/assets">Back</a>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Notes: The detailed reports are big. You may have to wait a few minutes before the report is displayed.
                </div>
            </div>
        </div>
    }
    else if (Action == "summary-per-province" || Action == "summary-all")
    {
        <div class="form-card">
            <div class="form-card-header"><h2>Summary Invoice Reports</h2></div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Posting Start Date</label>
                        <input type="date" class="form-input" @bind="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Posting End Date</label>
                        <input type="date" class="form-input" @bind="_endDate" />
                    </div>
                    @if (Action == "summary-per-province")
                    {
                        <div class="form-field">
                            <label class="form-label">Province</label>
                            <select class="form-select" @bind="_selectedProvince">
                                <option value="">Select Province</option>
                                @foreach (var province in _provinces)
                                {
                                    <option value="@province.Value">@province.Label</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Show Reports</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("summary")'>Show Summary Invoice Report</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("department-cost-type")'>Show Summary Invoice Report Per Department By Cost Type</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("site-cost-type")'>Show Summary Invoice Report Per Department Per Site By Cost Type</button>
                </div>
                <div class="form-section">
                    <h3 class="form-section-title">Download Reports</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("summary-download")'>Download Summary Invoice Report</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("department-cost-type-download")'>Download Summary Invoice Report Per Department By Cost Type</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => RunSummaryReportAsync("site-cost-type-download")'>Download Summary Invoice Report Per Department Per Site By Cost Type</button>
                </div>
                <div class="contract-action-group"><a class="btn btn-secondary btn-sm" href="/finance">Back</a></div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Notes: Detailed reports may take a few minutes to display. For Excel, save to disk before opening.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header"><h2>Regional Module: Finance</h2></div>
            <div class="form-card-body">
                <div class="menu-tiles">
                    <div class="menu-tile">
                        <button class="menu-tile-header"><span>Regional Module: Finance</span><i class="bx bx-chevron-down"></i></button>
                        <div class="menu-tile-body">
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/summary-per-province">a) Summary Invoice Reports (Per Province)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/regional/summary-all">b) Summary Invoice Reports (All)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/reports/department">c) Print Financial Reports by (Department)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/reports/site">d) Print Financial Reports by (Site)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/reports/vehicle-billing-history">e) Vehicle Billing History (i.e. vehicle Income)</a></div>
                            <div class="menu-item"><a class="menu-item-link" href="/finance/wesbank/summary-all">f) Wesbank Expenses Reports</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-1">
            @_statusMessage
        </div>
    }

    @if (_reportRows.Count > 0)
    {
        <div class="table-container fis-mt-1">
            <div class="table-header">
                <span class="table-title">Regional Report Results (@_reportRows.Count row(s))</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            @foreach (var column in _reportColumns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedReportRows)
                        {
                            <tr>
                                @foreach (var column in _reportColumns)
                                {
                                    <td>@GetRowValue(row, column)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevReportPage" disabled="@(_reportPage <= 1)">Previous</button>
                <div class="pagination-info">Page @_reportPage of @ReportTotalPages</div>
                <button class="pagination-btn" @onclick="NextReportPage" disabled="@(_reportPage >= ReportTotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_reportRows.Count | Page size: @_reportPageSize</div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private List<FinanceOptionDto> _departments = new();
    private List<FinanceOptionDto> _sites = new();
    private List<FinanceOptionDto> _provinces = new();

    private string _selectedDepartment = string.Empty;
    private string _selectedSite = string.Empty;
    private string _selectedProvince = string.Empty;
    private DateTime? _startDate;
    private DateTime? _endDate;

    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;
    private readonly int _reportPageSize = 12;
    private int _reportPage = 1;
    private List<string> _reportColumns = new();
    private List<Dictionary<string, string>> _reportRows = new();
    private int ReportTotalPages => Math.Max(1, (int)Math.Ceiling(_reportRows.Count / (double)_reportPageSize));
    private IEnumerable<Dictionary<string, string>> PagedReportRows => _reportRows
        .Skip((_reportPage - 1) * _reportPageSize)
        .Take(_reportPageSize);

    protected override async Task OnInitializedAsync()
    {
        _departments = await FinanceService.GetDepartmentsAsync();
        _sites = await FinanceService.GetSitesAsync();
        _provinces = await FinanceService.GetProvincesAsync();
    }

    protected override void OnParametersSet()
    {
        Action = ResolveLegacyAction();
    }

    private async Task OnDepartmentChangedAsync()
    {
        _sites = await FinanceService.GetSitesAsync(_selectedDepartment);
    }

    private async Task RunAssetReportAsync()
    {
        _submitting = true;
        _reportRows = new();
        _reportColumns = new();
        _reportPage = 1;

        var result = await FinanceService.PostRegionalReportAsync(
            "summary",
            Action,
            _selectedDepartment,
            _selectedSite,
            _selectedProvince,
            null,
            null,
            null);

        _statusError = !result.Success;
        _statusMessage = result.Message;
        if (result.Success)
        {
            ParseRows(result.ResponseBody);
        }

        _submitting = false;
    }

    private async Task RunSummaryReportAsync(string reportType)
    {
        _submitting = true;
        _reportRows = new();
        _reportColumns = new();
        _reportPage = 1;

        var result = await FinanceService.PostRegionalReportAsync(
            "financial",
            Action,
            null,
            null,
            _selectedProvince,
            reportType,
            _startDate,
            _endDate);

        _statusError = !result.Success;
        _statusMessage = result.Message;

        if (result.Success)
        {
            ParseRows(result.ResponseBody);

            if (reportType.Contains("download", StringComparison.OrdinalIgnoreCase) && _reportRows.Count > 0)
            {
                await DownloadExcelAsync(reportType);
            }
        }

        _submitting = false;
    }

    private async Task DownloadExcelAsync(string reportType)
    {
        var filename = $"regional-{reportType}-{DateTime.UtcNow:yyyyMMddHHmmss}.xlsx";
        var payload = new { data = _reportRows.Cast<object>().ToList(), filename };
        var fileResult = await FinanceService.PostFileAsync("api/Report/export/excel", payload, filename);
        if (!fileResult.Success || fileResult.Content.Length == 0)
        {
            _statusError = true;
            _statusMessage = fileResult.Message;
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "fisDownload.downloadBase64",
            fileResult.Filename,
            Convert.ToBase64String(fileResult.Content),
            fileResult.ContentType);
    }

    private void PrevReportPage()
    {
        if (_reportPage > 1)
        {
            _reportPage--;
        }
    }

    private void NextReportPage()
    {
        if (_reportPage < ReportTotalPages)
        {
            _reportPage++;
        }
    }

    private static string GetRowValue(Dictionary<string, string> row, string column)
        => row.TryGetValue(column, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-";

    private void ParseRows(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(responseBody);
            var root = document.RootElement;
            JsonElement rowsElement;

            if (root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("dataRows", out var dataRows)
                && dataRows.ValueKind == JsonValueKind.Array)
            {
                rowsElement = dataRows;
            }
            else if (root.ValueKind == JsonValueKind.Array)
            {
                rowsElement = root;
            }
            else
            {
                return;
            }

            _reportRows = ParseObjectRows(rowsElement);
            _reportColumns = ExtractColumns(_reportRows);
            _reportPage = 1;
        }
        catch
        {
            // Keep status feedback if parsing fails.
        }
    }

    private static List<Dictionary<string, string>> ParseObjectRows(JsonElement arrayElement)
    {
        var rows = new List<Dictionary<string, string>>();

        foreach (var item in arrayElement.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var property in item.EnumerateObject())
            {
                row[property.Name] = property.Value.ValueKind switch
                {
                    JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                    JsonValueKind.Number => property.Value.GetRawText(),
                    JsonValueKind.True => "true",
                    JsonValueKind.False => "false",
                    JsonValueKind.Null => string.Empty,
                    _ => property.Value.GetRawText()
                };
            }

            rows.Add(row);
        }

        return rows;
    }

    private static List<string> ExtractColumns(List<Dictionary<string, string>> rows)
    {
        var columns = new List<string>();
        foreach (var row in rows)
        {
            foreach (var key in row.Keys)
            {
                if (!columns.Any(existing => string.Equals(existing, key, StringComparison.OrdinalIgnoreCase)))
                {
                    columns.Add(key);
                }
            }
        }

        return columns;
    }

    private string PageTitleText => Action switch
    {
        "menu" => "Regional Module: Finance",
        "assets" => "Asset List: Vehicles in FIS",
        "assets-all" => "Asset List: Vehicles in FIS",
        "assets-province" => "Asset List: Vehicles in FIS",
        "assets-department" => "Asset List: Vehicles in FIS",
        "assets-site" => "Asset List: Vehicles in FIS",
        _ => "Regional Module: Finance"
    };

    private string ResolveLegacyAction()
    {
        var normalizedAction = (Action ?? string.Empty).Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(normalizedAction))
        {
            return normalizedAction;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = uri.AbsolutePath.Trim('/').ToLowerInvariant();
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (path == "finance/financeregionmenu.aspx")
        {
            return "menu";
        }

        if (path == "finance/financeregionassetmenu.aspx")
        {
            return "assets";
        }

        if (path == "finance/assetvehiclereports.aspx")
        {
            return "assets";
        }

        if (path == "finance/gettotalcostreportsdaterangeprovince.aspx")
        {
            return "summary-per-province";
        }

        if (path == "finance/gettotalcostreportsdaterange.aspx")
        {
            return "summary-all";
        }

        if (path == "openreport_4.aspx" && query.TryGetValue("Report", out var report))
        {
            var value = report.ToString().Trim().ToLowerInvariant();
            return value == "summaryreportperprovince" ? "summary-per-province" : "summary-all";
        }

        return "menu";
    }
}
