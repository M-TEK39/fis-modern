@page "/finance/reports/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@using System.Text.Json
@using Microsoft.JSInterop
@inject FinanceApiService FinanceService
@inject IJSRuntime JSRuntime

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-square"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Financial reporting and invoice output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
            <p>@SectionDescription</p>
        </div>
        <div class="form-card-body">
            <div class="contract-banner contract-banner-info contract-banner-inline">
                Billing policy: contracts with <strong>still_current = Y</strong> must continue billing even when end date has passed, until contract close/reassign/extend.
            </div>
            @if (IsFinancialYear)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year</label>
                        <select class="form-select" @bind="_selectedFinancialYear">
                            <option value="">Select Financial Year</option>
                            @foreach (var year in _financialYears)
                            {
                                <option value="@year.Value">@year.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action == "vehicle-billing-history")
                    {
                        <div class="form-field">
                            <label class="form-label">Vehicle Registration Number</label>
                            <input class="form-input" @bind="_vehicleSearch" @oninput="OnVehicleSearchChanged" />
                            @if (_vehicleMatches.Count > 0)
                            {
                                <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode">
                                    <option value="">Select Vehicle</option>
                                    @foreach (var vehicle in _vehicleMatches)
                                    {
                                        <option value="@vehicle.Value">@vehicle.Label</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("financial-year")' disabled="@_submitting">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (IsDateRange)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-input" @bind="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-input" @bind="_endDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action is "income-department-site" or "download-income-department-site" or "download-income-department-site-vehicle")
                    {
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_selectedSite">
                                <option value="">Select Site</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Value">@site.Label</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("date-range")' disabled="@_submitting">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (IsJournal)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Reversal Journal Number</label>
                        <input class="form-input" @bind="_journalNumber" />
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("journal")' disabled="@_submitting">Submit Details</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment" @bind:after="OnDepartmentChangedAsync">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action == "site")
                    {
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_selectedSite">
                                <option value="">Select Site</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Value">@site.Label</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Action == "province")
                    {
                        <div class="form-field">
                            <label class="form-label">Province</label>
                            <select class="form-select" @bind="_selectedProvince">
                                <option value="">Select Province</option>
                                @foreach (var province in _provinces)
                                {
                                    <option value="@province.Value">@province.Label</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-field">
                        <label class="form-label">Posting Date</label>
                        <select class="form-select" @bind="_selectedBatchDate" disabled="@IsPostingMonthFilterDisabled">
                            <option value="">Select Posting Month</option>
                            @foreach (var batchDate in _batchDates)
                            {
                                <option value="@batchDate.Value">@batchDate.Label</option>
                            }
                        </select>
                        @if (_supportsDateFilter == false)
                        {
                            <small class="form-hint">Posting month filtering is not available for the current report output.</small>
                        }
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Summary Report</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-by-cost-type")'>Show Summarised Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-by-cost-type-journal")'>Show Invoice by Cost Type, Site Name &amp; Journal</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-html")'>Show HTML invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-pdf")'>Show PDF invoice</button>
                </div>
                <div class="form-section">
                    <h3 class="form-section-title">Detailed Report</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-html")'>Show HTML invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-pdf")'>Show PDF invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-table")'>Show Invoice in a Table</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-excel")'>Download Excel invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-vip-taxi")'>Show TAXI &amp; VIP transactions</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-vip-taxi-pdf")'>TAXI &amp; VIP PDF</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-fuel-pdf")'>Show detailed FUEL Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-fuel-excel")'>Download detailed FUEL invoice in Excel</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-toll-oil-pdf")'>Show detailed TOLL &amp; OIL Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-toll-oil-excel")'>Download detailed TOLL &amp; OIL invoice in Excel</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-surcharge-pdf")'>Show Surcharge Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-surcharge-excel")'>Surcharge invoice in Excel</button>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Notes: The detailed reports are big. You may have to wait a few minutes before the report is displayed.
                    Excel Note: Please save the file to disk before opening.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-1">
                    @_statusMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_filterNotice))
            {
                <div class="alert alert-success fis-mt-075">
                    @_filterNotice
                </div>
            }

            @if (_reportRows.Count > 0)
            {
                <div class="table-container fis-mt-1">
                    <div class="table-header">
                        <span class="table-title">@_resultTitle (@_reportRows.Count row(s))</span>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    @foreach (var column in _reportColumns)
                                    {
                                        <th>@column</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedReportRows)
                                {
                                    <tr>
                                        @foreach (var column in _reportColumns)
                                        {
                                            <td>@GetRowValue(row, column)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination">
                        <button class="pagination-btn" @onclick="PrevReportPage" disabled="@(_reportPage <= 1)">Previous</button>
                        <div class="pagination-info">Page @_reportPage of @ReportTotalPages</div>
                        <button class="pagination-btn" @onclick="NextReportPage" disabled="@(_reportPage >= ReportTotalPages)">Next</button>
                    </div>
                    <div class="pagination-meta">Total filtered records: @_reportRows.Count | Page size: @_reportPageSize</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private List<FinanceOptionDto> _departments = new();
    private List<FinanceOptionDto> _sites = new();
    private List<FinanceOptionDto> _provinces = new();
    private List<FinanceOptionDto> _financialYears = new();
    private List<FinanceOptionDto> _batchDates = new();
    private List<FinanceOptionDto> _vehicleMatches = new();

    private string _selectedDepartment = string.Empty;
    private string _selectedSite = string.Empty;
    private string _selectedProvince = string.Empty;
    private string _selectedFinancialYear = string.Empty;
    private string _selectedBatchDate = string.Empty;
    private string _selectedVehicleVmfCode = string.Empty;
    private string _vehicleSearch = string.Empty;
    private string _journalNumber = string.Empty;
    private DateTime? _startDate;
    private DateTime? _endDate;

    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;
    private string _filterNotice = string.Empty;
    private string _resultTitle = "Report Results";
    private List<string> _reportColumns = new();
    private List<Dictionary<string, string>> _allReportRows = new();
    private List<Dictionary<string, string>> _reportRows = new();
    private bool? _supportsDateFilter;
    private readonly int _reportPageSize = 12;
    private int _reportPage = 1;

    private bool IsFinancialYear => Action is "vehicle-billing-history" or "income-split-summary" or "income-split-detailed";
    private bool IsDateRange => Action is "income-department" or "income-department-site" or "download-income-department" or "download-income-department-site" or "download-income-department-site-vehicle";
    private bool IsJournal => Action == "reversals-tree";
    private bool IsPostingMonthFilterDisabled => !IsDedicatedFinanceMode && _supportsDateFilter == false;
    private bool IsDedicatedFinanceMode => Action is "department" or "site";
    private int ReportTotalPages => Math.Max(1, (int)Math.Ceiling(_reportRows.Count / (double)_reportPageSize));
    private IEnumerable<Dictionary<string, string>> PagedReportRows => _reportRows
        .Skip((_reportPage - 1) * _reportPageSize)
        .Take(_reportPageSize);

    protected override async Task OnInitializedAsync()
    {
        _departments = await FinanceService.GetDepartmentsAsync();
        _provinces = await FinanceService.GetProvincesAsync();
        _financialYears = await FinanceService.GetFinancialYearsAsync();
        _batchDates = IsDedicatedFinanceMode
            ? await FinanceService.GetFinanceReportPostingMonthsAsync(Action == "site" ? "Site" : "Department")
            : await FinanceService.GetBatchDatesAsync();
        _sites = await FinanceService.GetSitesAsync();

        EnsurePostingMonthSelected();
    }

    private async Task OnDepartmentChangedAsync()
    {
        _sites = await FinanceService.GetSitesAsync(_selectedDepartment);

        if (IsDedicatedFinanceMode)
        {
            _batchDates = await FinanceService.GetFinanceReportPostingMonthsAsync(Action == "site" ? "Site" : "Department");
            EnsurePostingMonthSelected();
        }
    }

    private async Task OnVehicleSearchChanged(ChangeEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_vehicleSearch) || _vehicleSearch.Length < 2)
        {
            _vehicleMatches.Clear();
            return;
        }

        _vehicleMatches = await FinanceService.SearchVehiclesAsync(_vehicleSearch);
    }

    private async Task SubmitReportAsync(string reportAction)
    {
        _submitting = true;
        _statusMessage = string.Empty;
        _filterNotice = string.Empty;
        _resultTitle = "Report Results";
        _reportColumns = new List<string>();
        _allReportRows = new List<Dictionary<string, string>>();
        _reportRows = new List<Dictionary<string, string>>();
        _supportsDateFilter = null;
        _reportPage = 1;
        var suppressEmptyTableNotice = false;

        FinanceApiResult result;

        if (reportAction == "journal")
        {
            var endpoint = $"api/finance/reports/reversals-tree/{Uri.EscapeDataString(_journalNumber)}";
            result = await FinanceService.GetActionAsync(endpoint);
        }
        else if (Action == "vehicle-billing-history")
        {
            if (!int.TryParse(_selectedVehicleVmfCode, out var vmfCode) || vmfCode <= 0)
            {
                SetValidationError("Select a vehicle before running the billing history report.");
                return;
            }

            if (!int.TryParse(_selectedFinancialYear, out var financialYear) || financialYear <= 0)
            {
                SetValidationError("Select a financial year before running the billing history report.");
                return;
            }

            var endpoint = $"api/Report/billing/history/{vmfCode}?financialYear={financialYear}";
            result = await FinanceService.GetActionAsync(endpoint);
        }
        else
        {
            if (TryGetDedicatedReportConfig(reportAction, out var dedicatedConfig) && IsDedicatedFinanceMode)
            {
                suppressEmptyTableNotice = dedicatedConfig!.Format != "json";
                result = await RunDedicatedFinanceReportAsync(dedicatedConfig!);
            }
            else
            {
                result = await RunUniversalReportAsync(reportAction, GetUniversalReportType(reportAction));
            }

            if (result.Success)
            {
                ParseReportResult(result.ResponseBody, reportAction);

                if (!TryGetDedicatedReportConfig(reportAction, out _)
                    && IsDetailedAction(reportAction)
                    && _reportRows.Count == 0)
                {
                    // Backend detailed mode is not fully implemented yet; fallback keeps the UI usable.
                    var fallback = await RunUniversalReportAsync(reportAction, "summary");
                    if (fallback.Success)
                    {
                        ParseReportResult(fallback.ResponseBody, reportAction);
                        _statusMessage = "Detailed report output is not available yet. Showing summary data fallback.";
                    }
                }

                if (result.Success && !IsDedicatedFinanceMode && IsExcelAction(reportAction) && _reportRows.Count > 0)
                {
                    await DownloadExcelAsync(reportAction);
                }

                if (result.Success && !IsDedicatedFinanceMode && IsPdfAction(reportAction) && _reportRows.Count > 0)
                {
                    await PrintResultsAsync(reportAction);
                }
            }
        }

        _statusError = !result.Success;
        if (string.IsNullOrWhiteSpace(_statusMessage))
        {
            _statusMessage = result.Message;
        }

        if (result.Success && !IsDateRange && !IsFinancialYear && !IsJournal && !suppressEmptyTableNotice)
        {
            if (_reportRows.Count == 0)
            {
                _statusMessage = _allReportRows.Count > 0
                    ? "Request completed, but no rows matched the selected department/posting month filters."
                    : "Request completed, but no rows were returned for the selected parameters.";
            }
        }

        _submitting = false;
    }

    private async Task<FinanceApiResult> RunDedicatedFinanceReportAsync(DedicatedReportConfig config)
    {
        if (!TryResolvePostingMonthCode(out var postingMonthCode))
        {
            SetValidationError("Posting month codes are currently unavailable from the API, so this HTML/PDF invoice can\'t be generated accurately right now.");
            return new FinanceApiResult
            {
                Success = false,
                Message = "Posting month code lookup failed. This report requires the exact posting_month_code from api/finance/reports/posting-months."
            };
        }

        var filterBy = Action == "site" ? "Site" : "Department";
        var selectedId = Action == "site" ? _selectedSite : _selectedDepartment;

        if (!short.TryParse(selectedId, out var id) || id <= 0)
        {
            SetValidationError(Action == "site"
                ? "Select a site before running the report."
                : "Select a department before running the report.");
            return new FinanceApiResult { Success = false, Message = "Report filter is required." };
        }

        var endpoint = $"api/finance/reports/{config.EndpointName}?id={id}&postingMonthCode={postingMonthCode}&filterBy={Uri.EscapeDataString(filterBy)}&format={config.Format}";

        if (config.Format == "csv")
        {
            var defaultFilename = $"{config.EndpointName}-{DateTime.UtcNow:yyyyMMddHHmmss}.csv";
            var fileResult = await FinanceService.GetFileAsync(endpoint, defaultFilename);
            if (!fileResult.Success || fileResult.Content.Length == 0)
            {
                return new FinanceApiResult
                {
                    Success = false,
                    Endpoint = endpoint,
                    Message = fileResult.Message
                };
            }

            await JSRuntime.InvokeVoidAsync(
                "fisDownload.downloadBase64",
                fileResult.Filename,
                Convert.ToBase64String(fileResult.Content),
                fileResult.ContentType);

            return new FinanceApiResult
            {
                Success = true,
                Endpoint = endpoint,
                Message = "CSV downloaded successfully."
            };
        }

        var result = await FinanceService.GetActionAsync(endpoint);
        if (!result.Success)
        {
            return result;
        }

        if (config.Format == "html")
        {
            if (string.IsNullOrWhiteSpace(result.ResponseBody))
            {
                return new FinanceApiResult
                {
                    Success = false,
                    Endpoint = endpoint,
                    Message = "The report returned empty HTML output."
                };
            }

            if (config.AutoPrint)
            {
                await JSRuntime.InvokeVoidAsync("fisPrint.printHtml", result.ResponseBody, BuildResultTitle(Action ?? "report", default));
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("fisPrint.openHtml", result.ResponseBody, BuildResultTitle(Action ?? "report", default));
            }

            _reportRows = new List<Dictionary<string, string>>();
            _allReportRows = new List<Dictionary<string, string>>();
            _reportColumns = new List<string>();

            return new FinanceApiResult
            {
                Success = true,
                Endpoint = endpoint,
                Message = config.AutoPrint
                    ? "Printable report opened. Use the browser print dialog to save as PDF."
                    : "HTML report opened in a new browser window."
            };
        }

        return result;
    }

    private void EnsurePostingMonthSelected()
    {
        if (!IsDedicatedFinanceMode || !string.IsNullOrWhiteSpace(_selectedBatchDate))
        {
            return;
        }

        var first = _batchDates.FirstOrDefault();
        if (first is not null)
        {
            _selectedBatchDate = first.Value;
        }
    }

    private bool TryResolvePostingMonthCode(out short postingMonthCode)
    {
        postingMonthCode = 0;

        if (short.TryParse(_selectedBatchDate, out postingMonthCode) && postingMonthCode > 0)
        {
            return true;
        }

        return false;
    }

    private async Task<FinanceApiResult> RunUniversalReportAsync(string reportAction, string reportType)
    {
        return await FinanceService.PostActionAsync("api/Report/universal", new
        {
            reportType,
            parameters = new Dictionary<string, object?>
            {
                ["mode"] = Action,
                ["action"] = reportAction,
                ["departmentCode"] = _selectedDepartment,
                ["siteCode"] = _selectedSite,
                ["province"] = _selectedProvince,
                ["financialYear"] = _selectedFinancialYear,
                ["batchDate"] = _selectedBatchDate
            },
            vmfCode = int.TryParse(_selectedVehicleVmfCode, out var vmfCode) ? vmfCode : (int?)null,
            startDate = _startDate,
            endDate = _endDate
        });
    }

    private async Task DownloadExcelAsync(string reportAction)
    {
        var filename = $"finance-{Action ?? "report"}-{reportAction}-{DateTime.UtcNow:yyyyMMddHHmmss}.xlsx";
        var payload = new
        {
            data = _reportRows.Cast<object>().ToList(),
            filename
        };

        var fileResult = await FinanceService.PostFileAsync("api/Report/export/excel", payload, filename);
        if (!fileResult.Success || fileResult.Content.Length == 0)
        {
            _statusError = true;
            _statusMessage = fileResult.Message;
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "fisDownload.downloadBase64",
            fileResult.Filename,
            Convert.ToBase64String(fileResult.Content),
            fileResult.ContentType);
    }

    private async Task PrintResultsAsync(string reportAction)
    {
        var html = BuildPrintableTableHtml(reportAction);
        await JSRuntime.InvokeVoidAsync("fisPrint.printHtml", html, BuildResultTitle(reportAction, default));
    }

    private string BuildPrintableTableHtml(string reportAction)
    {
        var safeColumns = _reportColumns.Select(HtmlEncode).ToList();
        var rows = _reportRows.Select(row => _reportColumns.Select(column => HtmlEncode(GetRowValue(row, column))).ToList()).ToList();

        var header = string.Join(string.Empty, safeColumns.Select(column => $"<th style='text-align:left;padding:8px;border:1px solid #d9d9d9'>{column}</th>"));
        var body = string.Join(string.Empty,
            rows.Select(cells => "<tr>" + string.Join(string.Empty, cells.Select(cell => $"<td style='padding:8px;border:1px solid #d9d9d9'>{cell}</td>")) + "</tr>"));

        return $@"<h2>{HtmlEncode(PageTitleText)} - {HtmlEncode(reportAction)}</h2>
<table style='border-collapse:collapse;width:100%;font-family:Segoe UI,Arial,sans-serif;font-size:12px'>
<thead><tr>{header}</tr></thead>
<tbody>{body}</tbody>
</table>";
    }

    private static string HtmlEncode(string value)
        => System.Net.WebUtility.HtmlEncode(value ?? string.Empty);

    private static bool IsDetailedAction(string reportAction)
        => reportAction.Contains("detailed", StringComparison.OrdinalIgnoreCase);

    private static bool IsExcelAction(string reportAction)
        => reportAction.Contains("excel", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdfAction(string reportAction)
        => reportAction.Contains("pdf", StringComparison.OrdinalIgnoreCase);

    private void ParseReportResult(string? responseBody, string reportAction)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(responseBody);
            var root = document.RootElement;

            if (root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("dataRows", out var dataRowsElement)
                && dataRowsElement.ValueKind == JsonValueKind.Array)
            {
                _resultTitle = BuildResultTitle(reportAction, root);
                _supportsDateFilter = ReadSupportsDateFilter(root);
                _allReportRows = ParseObjectRows(dataRowsElement);
                _reportRows = ApplyClientSideFilters(_allReportRows);
                _reportColumns = ExtractColumns(_reportRows);
                _reportPage = 1;
                return;
            }

            if (root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("rows", out var rowsElement)
                && rowsElement.ValueKind == JsonValueKind.Array)
            {
                _resultTitle = BuildResultTitle(reportAction, root);
                _supportsDateFilter = null;
                _allReportRows = ParseObjectRows(rowsElement);
                _reportRows = _allReportRows;
                _reportColumns = ExtractColumns(_reportRows);
                _reportPage = 1;
                return;
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                _resultTitle = BuildResultTitle(reportAction, root);
                _supportsDateFilter = null;
                _allReportRows = ParseObjectRows(root);
                _reportRows = ApplyClientSideFilters(_allReportRows);
                _reportColumns = ExtractColumns(_reportRows);
                _reportPage = 1;
            }
        }
        catch
        {
            // Keep the success/error banner as the primary feedback if parsing fails.
        }
    }

    private List<Dictionary<string, string>> ApplyClientSideFilters(List<Dictionary<string, string>> rows)
    {
        var filtered = rows.ToList();

        if (!string.IsNullOrWhiteSpace(_selectedDepartment) && filtered.Count > 0)
        {
            var departmentColumn = FindColumnName(filtered, "department");
            if (!string.IsNullOrWhiteSpace(departmentColumn))
            {
                var selectedOption = _departments.FirstOrDefault(option => option.Value == _selectedDepartment);
                var selectedCode = _selectedDepartment.Trim();
                var selectedLabel = selectedOption?.Label?.Trim() ?? selectedCode;
                var selectedName = selectedLabel.Contains(" - ", StringComparison.Ordinal)
                    ? selectedLabel.Split(" - ", 2, StringSplitOptions.TrimEntries)[1]
                    : selectedLabel;

                filtered = filtered
                    .Where(row => RowContains(row, departmentColumn!, selectedCode)
                        || RowContains(row, departmentColumn!, selectedName)
                        || RowContains(row, departmentColumn!, selectedLabel))
                    .ToList();
            }
        }

        if (!string.IsNullOrWhiteSpace(_selectedBatchDate) && filtered.Count > 0)
        {
            if (_supportsDateFilter == false)
            {
                _filterNotice = "Posting month was selected, but this report does not support per-row date filtering.";
                return filtered;
            }

            var postingColumn = FindColumnName(filtered, "posting", "month", "batch", "date");
            if (!string.IsNullOrWhiteSpace(postingColumn))
            {
                var tokens = BuildPostingMonthTokens();
                if (tokens.Count > 0)
                {
                    filtered = filtered
                        .Where(row => tokens.Any(token => RowContains(row, postingColumn!, token)))
                        .ToList();
                }
            }
            else
            {
                _filterNotice = "Posting month was selected, but the returned rows do not contain a posting date/month column; month filtering could not be applied to this result set.";
            }
        }

        return filtered;
    }

    private List<string> BuildPostingMonthTokens()
    {
        var tokens = new List<string>();

        if (!string.IsNullOrWhiteSpace(_selectedBatchDate))
        {
            tokens.Add(_selectedBatchDate.Trim());

            if (DateTime.TryParse(_selectedBatchDate, out var parsedFromValue))
            {
                tokens.Add(parsedFromValue.ToString("MMM yyyy"));
                tokens.Add(parsedFromValue.ToString("yyyy-MM"));
                tokens.Add(parsedFromValue.ToString("yyyy/MM"));
            }
        }

        var selectedOption = _batchDates.FirstOrDefault(option => option.Value == _selectedBatchDate);
        if (!string.IsNullOrWhiteSpace(selectedOption?.Label))
        {
            tokens.Add(selectedOption.Label.Trim());
            if (DateTime.TryParse(selectedOption.Label, out var parsedFromLabel))
            {
                tokens.Add(parsedFromLabel.ToString("MMM yyyy"));
                tokens.Add(parsedFromLabel.ToString("yyyy-MM"));
            }
        }

        return tokens
            .Where(token => !string.IsNullOrWhiteSpace(token))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string? FindColumnName(List<Dictionary<string, string>> rows, params string[] hints)
    {
        if (rows.Count == 0)
        {
            return null;
        }

        var headers = rows
            .SelectMany(row => row.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var hint in hints)
        {
            var exact = headers.FirstOrDefault(header => string.Equals(header, hint, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(exact))
            {
                return exact;
            }

            var contains = headers.FirstOrDefault(header => header.Contains(hint, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(contains))
            {
                return contains;
            }
        }

        return null;
    }

    private static bool RowContains(Dictionary<string, string> row, string column, string token)
    {
        return !string.IsNullOrWhiteSpace(token)
            && row.TryGetValue(column, out var value)
            && !string.IsNullOrWhiteSpace(value)
            && value.Contains(token, StringComparison.OrdinalIgnoreCase);
    }

    private void PrevReportPage()
    {
        if (_reportPage > 1)
        {
            _reportPage--;
        }
    }

    private void NextReportPage()
    {
        if (_reportPage < ReportTotalPages)
        {
            _reportPage++;
        }
    }

    private static string BuildResultTitle(string reportAction, JsonElement root)
    {
        if (root.ValueKind == JsonValueKind.Object
            && root.TryGetProperty("title", out var title)
            && title.ValueKind == JsonValueKind.String
            && !string.IsNullOrWhiteSpace(title.GetString()))
        {
            return title.GetString()!;
        }

        return $"{reportAction} results";
    }

    private static bool? ReadSupportsDateFilter(JsonElement root)
    {
        if (root.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        foreach (var property in root.EnumerateObject())
        {
            if (!string.Equals(property.Name, "supportsDateFilter", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return property.Value.ValueKind switch
            {
                JsonValueKind.True => true,
                JsonValueKind.False => false,
                _ => null
            };
        }

        return null;
    }

    private static List<Dictionary<string, string>> ParseObjectRows(JsonElement arrayElement)
    {
        var rows = new List<Dictionary<string, string>>();

        foreach (var item in arrayElement.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var property in item.EnumerateObject())
            {
                row[property.Name] = JsonValueToString(property.Value);
            }

            rows.Add(row);
        }

        return rows;
    }

    private static List<string> ExtractColumns(List<Dictionary<string, string>> rows)
    {
        var columns = new List<string>();
        foreach (var row in rows)
        {
            foreach (var key in row.Keys)
            {
                if (!columns.Any(existing => string.Equals(existing, key, StringComparison.OrdinalIgnoreCase)))
                {
                    columns.Add(key);
                }
            }
        }

        return columns;
    }

    private static string GetRowValue(Dictionary<string, string> row, string column)
        => row.TryGetValue(column, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-";

    private static string JsonValueToString(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString() ?? string.Empty,
            JsonValueKind.Number => value.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            JsonValueKind.Null => string.Empty,
            _ => value.GetRawText()
        };
    }

    private void SetValidationError(string message)
    {
        _statusError = true;
        _statusMessage = message;
        _submitting = false;
    }

    private string GetUniversalReportType(string reportAction)
    {
        if (reportAction.Contains("detailed", StringComparison.OrdinalIgnoreCase))
        {
            return "detailed";
        }

        if (reportAction.Contains("summary", StringComparison.OrdinalIgnoreCase))
        {
            return "summary";
        }

        return "financial";
    }

