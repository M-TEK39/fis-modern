@page "/finance/reports/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-square"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Financial reporting aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
            <p>@SectionDescription</p>
        </div>
        <div class="form-card-body">
            @if (IsFinancialYear)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Financial Year</label>
                        <select class="form-select" @bind="_selectedFinancialYear">
                            <option value="">Select Financial Year</option>
                            @foreach (var year in _financialYears)
                            {
                                <option value="@year.Value">@year.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action == "vehicle-billing-history")
                    {
                        <div class="form-field">
                            <label class="form-label">Vehicle Registration Number</label>
                            <input class="form-input" @bind="_vehicleSearch" @oninput="OnVehicleSearchChanged" />
                            @if (_vehicleMatches.Count > 0)
                            {
                                <select class="form-select" style="margin-top:0.5rem;" @bind="_selectedVehicleVmfCode">
                                    <option value="">Select Vehicle</option>
                                    @foreach (var vehicle in _vehicleMatches)
                                    {
                                        <option value="@vehicle.Value">@vehicle.Label</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("financial-year")' disabled="@_submitting">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (IsDateRange)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-input" @bind="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-input" @bind="_endDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action is "income-department-site" or "download-income-department-site" or "download-income-department-site-vehicle")
                    {
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_selectedSite">
                                <option value="">Select Site</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Value">@site.Label</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("date-range")' disabled="@_submitting">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else if (IsJournal)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Reversal Journal Number</label>
                        <input class="form-input" @bind="_journalNumber" />
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick='() => SubmitReportAsync("journal")' disabled="@_submitting">Submit Details</button>
                    <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
                </div>
            }
            else
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment" @bind:after="OnDepartmentChangedAsync">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    @if (Action == "site")
                    {
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_selectedSite">
                                <option value="">Select Site</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Value">@site.Label</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Action == "province")
                    {
                        <div class="form-field">
                            <label class="form-label">Province</label>
                            <select class="form-select" @bind="_selectedProvince">
                                <option value="">Select Province</option>
                                @foreach (var province in _provinces)
                                {
                                    <option value="@province.Value">@province.Label</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-field">
                        <label class="form-label">Posting Date</label>
                        <select class="form-select" @bind="_selectedBatchDate">
                            <option value="">Select Posting Month</option>
                            @foreach (var batchDate in _batchDates)
                            {
                                <option value="@batchDate.Value">@batchDate.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Summary Report</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-by-cost-type")'>Show Summarised Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-by-cost-type-journal")'>Show Invoice by Cost Type, Site Name &amp; Journal</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-html")'>Show HTML invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("summary-pdf")'>Show PDF invoice</button>
                </div>
                <div class="form-section">
                    <h3 class="form-section-title">Detailed Report</h3>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-html")'>Show HTML invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-pdf")'>Show PDF invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-table")'>Show Invoice in a Table</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-excel")'>Download Excel invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-vip-taxi")'>Show TAXI &amp; VIP transactions</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-fuel-pdf")'>Show detailed FUEL Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-fuel-excel")'>Download detailed FUEL invoice in Excel</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-toll-oil-pdf")'>Show detailed TOLL &amp; OIL Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-toll-oil-excel")'>Download detailed TOLL &amp; OIL invoice in Excel</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-surcharge-pdf")'>Show Surcharge Invoice</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SubmitReportAsync("detailed-surcharge-excel")'>Surcharge invoice in Excel</button>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Notes: The detailed reports are big. You may have to wait a few minutes before the report is displayed.
                    Excel Note: Please save the file to disk before opening.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private List<FinanceOptionDto> _departments = new();
    private List<FinanceOptionDto> _sites = new();
    private List<FinanceOptionDto> _provinces = new();
    private List<FinanceOptionDto> _financialYears = new();
    private List<FinanceOptionDto> _batchDates = new();
    private List<FinanceOptionDto> _vehicleMatches = new();

    private string _selectedDepartment = string.Empty;
    private string _selectedSite = string.Empty;
    private string _selectedProvince = string.Empty;
    private string _selectedFinancialYear = string.Empty;
    private string _selectedBatchDate = string.Empty;
    private string _selectedVehicleVmfCode = string.Empty;
    private string _vehicleSearch = string.Empty;
    private string _journalNumber = string.Empty;
    private DateTime? _startDate;
    private DateTime? _endDate;

    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    private bool IsFinancialYear => Action is "vehicle-billing-history" or "income-split-summary" or "income-split-detailed";
    private bool IsDateRange => Action is "income-department" or "income-department-site" or "download-income-department" or "download-income-department-site" or "download-income-department-site-vehicle";
    private bool IsJournal => Action == "reversals-tree";

    protected override async Task OnInitializedAsync()
    {
        _departments = await FinanceService.GetDepartmentsAsync();
        _provinces = await FinanceService.GetProvincesAsync();
        _financialYears = await FinanceService.GetFinancialYearsAsync();
        _batchDates = await FinanceService.GetBatchDatesAsync();
        _sites = await FinanceService.GetSitesAsync();
    }

    private async Task OnDepartmentChangedAsync()
    {
        _sites = await FinanceService.GetSitesAsync(_selectedDepartment);
    }

    private async Task OnVehicleSearchChanged(ChangeEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_vehicleSearch) || _vehicleSearch.Length < 2)
        {
            _vehicleMatches.Clear();
            return;
        }

        _vehicleMatches = await FinanceService.SearchVehiclesAsync(_vehicleSearch);
    }

    private async Task SubmitReportAsync(string reportAction)
    {
        _submitting = true;
        _statusMessage = string.Empty;

        FinanceApiResult result;

        if (reportAction == "journal")
        {
            var endpoint = $"api/finance/reports/reversals-tree/{Uri.EscapeDataString(_journalNumber)}";
            result = await FinanceService.GetActionAsync(endpoint);
        }
        else if (Action == "vehicle-billing-history")
        {
            if (!int.TryParse(_selectedVehicleVmfCode, out var vmfCode) || vmfCode <= 0)
            {
                SetValidationError("Select a vehicle before running the billing history report.");
                return;
            }

            if (!int.TryParse(_selectedFinancialYear, out var financialYear) || financialYear <= 0)
            {
                SetValidationError("Select a financial year before running the billing history report.");
                return;
            }

            var endpoint = $"api/Report/billing/history/{vmfCode}?financialYear={financialYear}";
            result = await FinanceService.GetActionAsync(endpoint);
        }
        else
        {
            result = await FinanceService.PostActionAsync("api/Report/universal", new
            {
                reportType = GetUniversalReportType(reportAction),
                parameters = new Dictionary<string, object?>
                {
                    ["mode"] = Action,
                    ["action"] = reportAction,
                    ["departmentCode"] = _selectedDepartment,
                    ["siteCode"] = _selectedSite,
                    ["province"] = _selectedProvince,
                    ["financialYear"] = _selectedFinancialYear,
                    ["batchDate"] = _selectedBatchDate
                },
                vmfCode = int.TryParse(_selectedVehicleVmfCode, out var vmfCode) ? vmfCode : (int?)null,
                startDate = _startDate,
                endDate = _endDate
            });
        }

        _statusError = !result.Success;
        _statusMessage = $"{result.Message} Endpoint: {result.Endpoint}";
        _submitting = false;
    }

    private void SetValidationError(string message)
    {
        _statusError = true;
        _statusMessage = message;
        _submitting = false;
    }

    private string GetUniversalReportType(string reportAction)
    {
        if (reportAction.Contains("detailed", StringComparison.OrdinalIgnoreCase))
        {
            return "detailed";
        }

        if (reportAction.Contains("summary", StringComparison.OrdinalIgnoreCase))
        {
            return "summary";
        }

        return "financial";
    }

    private string PageTitleText => Action switch
    {
        "department" => "Print Financial Reports by Department",
        "province" => "Print Financial Reports by Province",
        "site" => "Print Financial Reports by Site",
        "vehicle-billing-history" => "Vehicle Billing History Report by Financial Year",
        "reversals-tree" => "Reversals Tree Report from Journal Number",
        "income-department" => "Income Report by Department",
        "income-split-summary" => "Summary Income Split Report",
        "income-split-detailed" => "Detailed Income Split Report",
        "income-department-site" => "Income Report by Department & Site",
        "download-income-department" => "Download Income Report by Department",
        "download-income-department-site" => "Download Income Report by Department & Site",
        "download-income-department-site-vehicle" => "Download Income Report by Department, Site & Vehicle",
        _ => "Financial Reports"
    };

    private string SectionTitle => PageTitleText;

    private string SectionDescription => "Select parameters to generate the report.";
}
