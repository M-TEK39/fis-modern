@page "/finance/audit-trail/{Mode}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@using System.Text.Json
@using Microsoft.JSInterop
@inject FinanceApiService FinanceService
@inject IJSRuntime JSRuntime

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield-quarter"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Audit trail parameters.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance/audit-trail">Audit Trail Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@PageTitleText</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                @if (Mode != "vehicle")
                {
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment" @bind:after="OnDepartmentChangedAsync">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                }
                @if (Mode == "site")
                {
                    <div class="form-field">
                        <label class="form-label">Site</label>
                        <select class="form-select" @bind="_selectedSite">
                            <option value="">Select Site</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.Value">@site.Label</option>
                            }
                        </select>
                    </div>
                }
                @if (Mode == "vehicle")
                {
                    <div class="form-field">
                        <label class="form-label">Vehicle Number</label>
                        <input class="form-input" @bind="_vehicleSearch" @oninput="OnVehicleSearchChanged" />
                        @if (_vehicleMatches.Count > 0)
                        {
                            <select class="form-select" style="margin-top:0.5rem;" @bind="_selectedVehicle">
                                <option value="">Select Vehicle</option>
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <option value="@vehicle.Value">@vehicle.Label</option>
                                }
                            </select>
                        }
                    </div>
                }
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-input" @bind="_startDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-input" @bind="_endDate" />
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Audit Trail PDF Reports</h3>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("els", "pdf")'>Show ELS Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("manual-kilos", "pdf")'>Show Manual Kilo's Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("contracts", "pdf")'>Show Vehicle Contracts Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("vip-taxi", "pdf")'>Show VIP &amp; TAXI Audit Trail</button>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Audit Trail Excel Reports</h3>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("els", "excel")'>Download Show ELS Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("manual-kilos", "excel")'>Download Manual Kilo's Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("contracts", "excel")'>Download Vehicle Contracts Audit Trail</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => RunAuditAsync("vip-taxi", "excel")'>Download VIP &amp; TAXI Audit Trail</button>
            </div>

            <div class="contract-action-group">
                <a class="btn btn-secondary btn-sm" href="/finance/audit-trail">Back</a>
            </div>

            <div class="contract-banner contract-banner-info contract-banner-inline">
                Notes: The detailed reports are big. You may have to wait a few minutes before the report is displayed.
                Excel Note: Please save the file to disk before opening.
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }

            @if (_reportRows.Count > 0)
            {
                <div class="table-container" style="margin-top:1rem;">
                    <div class="table-header">
                        <span class="table-title">Audit Trail Results (@_reportRows.Count row(s))</span>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    @foreach (var column in _reportColumns)
                                    {
                                        <th>@column</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _reportRows)
                                {
                                    <tr>
                                        @foreach (var column in _reportColumns)
                                        {
                                            <td>@GetRowValue(row, column)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Mode { get; set; }

    private List<FinanceOptionDto> _departments = new();
    private List<FinanceOptionDto> _sites = new();
    private List<FinanceOptionDto> _vehicleMatches = new();

    private string _selectedDepartment = string.Empty;
    private string _selectedSite = string.Empty;
    private string _vehicleSearch = string.Empty;
    private string _selectedVehicle = string.Empty;
    private DateTime? _startDate;
    private DateTime? _endDate;

    private bool _statusError;
    private string _statusMessage = string.Empty;
    private List<string> _reportColumns = new();
    private List<Dictionary<string, string>> _reportRows = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await FinanceService.GetDepartmentsAsync();
        _sites = await FinanceService.GetSitesAsync();
    }

    private async Task OnDepartmentChangedAsync()
    {
        _sites = await FinanceService.GetSitesAsync(_selectedDepartment);
    }

    private async Task OnVehicleSearchChanged(ChangeEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_vehicleSearch) || _vehicleSearch.Length < 2)
        {
            _vehicleMatches.Clear();
            return;
        }

        _vehicleMatches = await FinanceService.SearchVehiclesAsync(_vehicleSearch);
    }

    private async Task RunAuditAsync(string reportType, string outputFormat)
    {
        _reportRows = new();
        _reportColumns = new();

        var result = await FinanceService.PostActionAsync("api/Report/universal", new
        {
            reportType = "financial",
            parameters = new Dictionary<string, object?>
            {
                ["mode"] = Mode,
                ["auditType"] = reportType,
                ["outputFormat"] = outputFormat,
                ["departmentCode"] = _selectedDepartment,
                ["siteCode"] = _selectedSite
            },
            vmfCode = int.TryParse(_selectedVehicle, out var vmfCode) ? vmfCode : (int?)null,
            startDate = _startDate,
            endDate = _endDate
        });

        _statusError = !result.Success;
        _statusMessage = result.Message;

        if (!result.Success)
        {
            return;
        }

        ParseRows(result.ResponseBody);

        if (outputFormat.Equals("excel", StringComparison.OrdinalIgnoreCase) && _reportRows.Count > 0)
        {
            await DownloadExcelAsync(reportType);
        }

        if (outputFormat.Equals("pdf", StringComparison.OrdinalIgnoreCase) && _reportRows.Count > 0)
        {
            await PrintRowsAsync(reportType);
        }
    }

    private async Task DownloadExcelAsync(string reportType)
    {
        var filename = $"audit-{Mode ?? "mode"}-{reportType}-{DateTime.UtcNow:yyyyMMddHHmmss}.xlsx";
        var payload = new { data = _reportRows.Cast<object>().ToList(), filename };
        var fileResult = await FinanceService.PostFileAsync("api/Report/export/excel", payload, filename);
        if (!fileResult.Success || fileResult.Content.Length == 0)
        {
            _statusError = true;
            _statusMessage = fileResult.Message;
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "fisDownload.downloadBase64",
            fileResult.Filename,
            Convert.ToBase64String(fileResult.Content),
            fileResult.ContentType);
    }

    private async Task PrintRowsAsync(string reportType)
    {
        var safeColumns = _reportColumns.Select(HtmlEncode).ToList();
        var rows = _reportRows.Select(row => _reportColumns.Select(column => HtmlEncode(GetRowValue(row, column))).ToList()).ToList();

        var header = string.Join(string.Empty, safeColumns.Select(column => $"<th style='text-align:left;padding:8px;border:1px solid #d9d9d9'>{column}</th>"));
        var body = string.Join(string.Empty,
            rows.Select(cells => "<tr>" + string.Join(string.Empty, cells.Select(cell => $"<td style='padding:8px;border:1px solid #d9d9d9'>{cell}</td>")) + "</tr>"));

        var html = $@"<h2>{HtmlEncode(PageTitleText)} - {HtmlEncode(reportType)}</h2>
<table style='border-collapse:collapse;width:100%;font-family:Segoe UI,Arial,sans-serif;font-size:12px'>
<thead><tr>{header}</tr></thead>
<tbody>{body}</tbody>
</table>";

        await JSRuntime.InvokeVoidAsync("fisPrint.printHtml", html, $"{PageTitleText} - {reportType}");
    }

    private static string HtmlEncode(string value)
        => System.Net.WebUtility.HtmlEncode(value ?? string.Empty);

    private static string GetRowValue(Dictionary<string, string> row, string column)
        => row.TryGetValue(column, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-";

    private void ParseRows(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(responseBody);
            var root = document.RootElement;
            JsonElement rowsElement;

            if (root.ValueKind == JsonValueKind.Object
                && root.TryGetProperty("dataRows", out var dataRows)
                && dataRows.ValueKind == JsonValueKind.Array)
            {
                rowsElement = dataRows;
            }
            else if (root.ValueKind == JsonValueKind.Array)
            {
                rowsElement = root;
            }
            else
            {
                return;
            }

            _reportRows = ParseObjectRows(rowsElement);
            _reportColumns = ExtractColumns(_reportRows);
        }
        catch
        {
            // Keep status feedback if parsing fails.
        }
    }

    private static List<Dictionary<string, string>> ParseObjectRows(JsonElement arrayElement)
    {
        var rows = new List<Dictionary<string, string>>();

        foreach (var item in arrayElement.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            var row = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var property in item.EnumerateObject())
            {
                row[property.Name] = property.Value.ValueKind switch
                {
                    JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                    JsonValueKind.Number => property.Value.GetRawText(),
                    JsonValueKind.True => "true",
                    JsonValueKind.False => "false",
                    JsonValueKind.Null => string.Empty,
                    _ => property.Value.GetRawText()
                };
            }

            rows.Add(row);
        }

        return rows;
    }

    private static List<string> ExtractColumns(List<Dictionary<string, string>> rows)
    {
        var columns = new List<string>();
        foreach (var row in rows)
        {
            foreach (var key in row.Keys)
            {
                if (!columns.Any(existing => string.Equals(existing, key, StringComparison.OrdinalIgnoreCase)))
                {
                    columns.Add(key);
                }
            }
        }

        return columns;
    }

    private string PageTitleText => Mode switch
    {
        "site" => "Audit Trail grouped by Site",
        "vehicle" => "Audit Trail grouped per Vehicle",
        _ => "Audit Trail grouped by Department"
    };
}
