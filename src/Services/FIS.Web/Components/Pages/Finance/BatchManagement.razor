@page "/finance/batch-management"
@page "/finance/batch-management/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>Batch Management</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-layer"></i>
            Batch Management
        </h1>
        <p class="page-description">Batch processing management aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Batch Management</h2>
        </div>
        <div class="form-card-body">
            @if (_batchStatus is not null)
            {
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Batch status: @(_batchStatus.BatchIsRunning ? "Running" : "Not running")
                </div>
            }

            <div class="menu-tiles">
                <div class="menu-tile">
                    <button class="menu-tile-header">
                        <span>Batch Management</span>
                        <i class="bx bx-chevron-down"></i>
                    </button>
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/batch-management/start">Start batch process and take site offline</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance">Access Finance menu</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/batch-management/check-scoa">Check the SCOA version and update where needed</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/batch-management/rollback">Roll back batch</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/batch-management/finish">Finish batch process and bring site back online</a>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private FinanceBatchStatusDto? _batchStatus;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _batchStatus = await FinanceService.GetBatchStatusAsync();

        if (string.IsNullOrWhiteSpace(Action))
        {
            return;
        }

        var endpoint = Action switch
        {
            "start" => "api/finance/batch/start",
            "check-scoa" => "api/finance/batch/check-scoa",
            "rollback" => "api/finance/batch/rollback",
            "finish" => "api/finance/batch/finish",
            _ => string.Empty
        };

        if (string.IsNullOrWhiteSpace(endpoint))
        {
            return;
        }

        var result = await FinanceService.PostActionAsync(endpoint, new { });
        _statusError = !result.Success;
        _statusMessage = $"{result.Message} Endpoint: {result.Endpoint}";
        _batchStatus = await FinanceService.GetBatchStatusAsync();
    }
}
