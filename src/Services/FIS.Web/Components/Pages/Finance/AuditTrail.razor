@page "/finance/audit-trail"
@rendermode InteractiveServer

<PageTitle>Audit Trail Reports</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield-quarter"></i>
            Audit Trail Reports
        </h1>
        <p class="page-description">Audit trail reporting.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Audit Trail Report Menu</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/finance/audit-trail/department">1) Audit Trail grouped by Department in a date range</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/finance/audit-trail/site">2) Audit Trail grouped by Site in a date range</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/finance/audit-trail/vehicle">3) Audit Trail grouped per Vehicle in a date range</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/finance">4) Return To Main Page</a>
                </div>
            </div>
        </div>
    </div>
</div>
