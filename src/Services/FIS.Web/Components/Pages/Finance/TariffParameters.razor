@page "/finance/tariff-parameters"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>Tariff Parameter Management</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Tariff Parameter Management
        </h1>
        <p class="page-description">Annual tariff parameter maintenance.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Tariff Parameters</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Tariff Parameter Year</label>
                    <select class="form-select" @bind="_selectedYear" @bind:after="LoadYearAsync">
                        <option value="">Select Year</option>
                        @foreach (var year in _years)
                        {
                            <option value="@year.Value">@year.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-banner contract-banner-info contract-banner-inline">
                Tariff Parameter Year Approval
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="ApproveYearAsync" disabled="@_submitting">Approve Year</button>
                <button class="btn btn-secondary btn-sm" @onclick="RejectYearAsync" disabled="@_submitting">Reject Year</button>
            </div>
            <h3 class="fis-mt-15">Global Parameters</h3>
            <div class="table-container fis-mt-075">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Value</th>
                                <th>Unit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_tariffParameters?.Parameters.Count > 0)
                            {
                                @foreach (var item in _tariffParameters.Parameters)
                                {
                                    <tr>
                                        <td>@item.ParameterName</td>
                                        <td>@FormatDecimal(item.Value)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Unit) ? "-" : item.Unit)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">Select a tariff year to load parameter values.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <h3 class="fis-mt-15">Fixed Tariffs</h3>
            <div class="table-container fis-mt-075">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Class Code</th>
                                <th>Class Description</th>
                                <th>Amount</th>
                                <th>Unit</th>
                                <th>Effective Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_tariffParameters?.FixedTariffs.Count > 0)
                            {
                                @foreach (var item in _tariffParameters.FixedTariffs)
                                {
                                    <tr>
                                        <td>@(item.ClassCode?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.ClassDescription) ? "-" : item.ClassDescription)</td>
                                        <td>@FormatDecimal(item.Amount)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Unit) ? "-" : item.Unit)</td>
                                        <td>@FormatDate(item.EffectiveDate)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">Select a tariff year to load fixed tariff records.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <h3 class="fis-mt-15">Kilometre Tariffs</h3>
            <div class="table-container fis-mt-075">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Class Code</th>
                                <th>Class Description</th>
                                <th>Amount</th>
                                <th>Unit</th>
                                <th>Effective Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_tariffParameters?.KiloTariffs.Count > 0)
                            {
                                @foreach (var item in _tariffParameters.KiloTariffs)
                                {
                                    <tr>
                                        <td>@(item.ClassCode?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.ClassDescription) ? "-" : item.ClassDescription)</td>
                                        <td>@FormatDecimal(item.Amount)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Unit) ? "-" : item.Unit)</td>
                                        <td>@FormatDate(item.EffectiveDate)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">Select a tariff year to load kilometre tariff records.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <h3 class="fis-mt-15">Maintenance Values</h3>
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Months Age</th>
                                <th>KM Age</th>
                                <th>Maintenance Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_tariffParameters?.MaintenanceValues.Count > 0)
                            {
                                @foreach (var item in _tariffParameters.MaintenanceValues)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(item.ClassDescription) ? item.ClassCode?.ToString() ?? "-" : item.ClassDescription)</td>
                                        <td>@(item.MonthsAge?.ToString() ?? "-")</td>
                                        <td>@(item.KilometerAge?.ToString() ?? "-")</td>
                                        <td>@FormatDecimal(item.Amount)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">Select a tariff year to load maintenance values.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (_tariffParameters is not null)
            {
                <div class="alert alert-success fis-mt-075">
                    Approval status: @(_tariffParameters.IsApproved ? "Approved" : "Pending")
                    | Approved by: @(string.IsNullOrWhiteSpace(_tariffParameters.ApprovedBy) ? "-" : _tariffParameters.ApprovedBy)
                    | Effective date: @FormatDate(_tariffParameters.EffectiveDate)
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-1">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FinanceOptionDto> _years = new();
    private FinanceTariffParametersDto? _tariffParameters;
    private string _selectedYear = string.Empty;
    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _years = await FinanceService.GetTariffYearsAsync();
    }

    private async Task LoadYearAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedYear))
        {
            _tariffParameters = null;
            return;
        }

        var data = await FinanceService.GetTariffParametersAsync(_selectedYear);
        if (data is null)
        {
            _tariffParameters = null;
            _statusError = true;
            _statusMessage = "Could not load tariff parameters for the selected year.";
            return;
        }

        _tariffParameters = data;
        _statusError = false;
        _statusMessage = "Tariff parameters loaded successfully.";
    }

    private async Task ApproveYearAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedYear))
        {
            _statusError = true;
            _statusMessage = "Select a tariff year before approving.";
            return;
        }

        _submitting = true;
        var result = await FinanceService.PostActionAsync($"api/finance/tariff-parameters/{Uri.EscapeDataString(_selectedYear)}/approve", new { });
        _statusError = !result.Success;
        _statusMessage = result.Message;

        if (result.Success)
        {
            await LoadYearAsync();
        }

        _submitting = false;
    }

    private async Task RejectYearAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedYear))
        {
            _statusError = true;
            _statusMessage = "Select a tariff year before rejecting.";
            return;
        }

        _submitting = true;
        var result = await FinanceService.PostActionAsync($"api/finance/tariff-parameters/{Uri.EscapeDataString(_selectedYear)}/reject", new { });
        _statusError = !result.Success;
        _statusMessage = result.Message;

        if (result.Success)
        {
            await LoadYearAsync();
        }

        _submitting = false;
    }

    private static string FormatDecimal(decimal? value)
        => value.HasValue ? value.Value.ToString("N2") : "-";

    private static string FormatDate(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed.ToString("yyyy-MM-dd") : "-";
}
