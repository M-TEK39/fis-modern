@page "/finance/tariff-parameters"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>Tariff Parameter Management</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Tariff Parameter Management
        </h1>
        <p class="page-description">Annual tariff parameter maintenance.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Tariff Parameters</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Tariff Parameter Year</label>
                    <select class="form-select" @bind="_selectedYear" @bind:after="LoadYearAsync">
                        <option value="">Select Year</option>
                        @foreach (var year in _years)
                        {
                            <option value="@year.Value">@year.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-banner contract-banner-info contract-banner-inline">
                Tariff Parameter Year Approval
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="ApproveYearAsync" disabled="@_submitting">Approve Year</button>
                <button class="btn btn-secondary btn-sm" @onclick="RejectYearAsync" disabled="@_submitting">Reject Year</button>
            </div>
            <h3 style="margin-top: 1.5rem;">Tariff Parameters &amp; Overhead Values</h3>
            <div class="table-container" style="margin-top: 0.75rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Fixed Tariff</th>
                                <th>Value</th>
                                <th>Overhead</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4">Select a tariff year to load fixed tariff records.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="table-container" style="margin-top: 0.75rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Kilo Tariff</th>
                                <th>Value</th>
                                <th>Overhead</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4">Select a tariff year to load kilometre tariff records.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <h3 style="margin-top: 1.5rem;">Maintenance Values</h3>
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Months Age</th>
                                <th>KM Age</th>
                                <th>Maintenance Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4">Select a tariff year to load maintenance values.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FinanceOptionDto> _years = new();
    private string _selectedYear = string.Empty;
    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _years = await FinanceService.GetTariffYearsAsync();
    }

    private async Task LoadYearAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedYear))
        {
            return;
        }

        var result = await FinanceService.GetActionAsync($"api/finance/tariff-parameters/{Uri.EscapeDataString(_selectedYear)}");
        _statusError = !result.Success;
        _statusMessage = result.Message;
    }

    private async Task ApproveYearAsync()
    {
        _submitting = true;
        var result = await FinanceService.PostActionAsync($"api/finance/tariff-parameters/{Uri.EscapeDataString(_selectedYear)}/approve", new { });
        _statusError = !result.Success;
        _statusMessage = result.Message;
        _submitting = false;
    }

    private async Task RejectYearAsync()
    {
        _submitting = true;
        var result = await FinanceService.PostActionAsync($"api/finance/tariff-parameters/{Uri.EscapeDataString(_selectedYear)}/reject", new { });
        _statusError = !result.Success;
        _statusMessage = result.Message;
        _submitting = false;
    }
}
