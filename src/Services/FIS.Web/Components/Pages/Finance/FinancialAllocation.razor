@page "/finance/financial-allocation/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-spreadsheet"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Financial allocation maintenance aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
            <p>@SectionDescription</p>
        </div>
        <div class="form-card-body">
            @if (IsImport)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-input" @bind="_startDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-input" @bind="_endDate" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Upload File</label>
                        <InputFile OnChange="OnImportFileSelected" />
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="ImportBasAsync" disabled="@_submitting">Submit</button>
            }
            else if (IsActivate)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-secondary btn-sm" @onclick="LoadSegmentsAsync" disabled="@_submitting">Load Segment Codes</button>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Segment Code</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_segmentRows.Count == 0)
                                {
                                    <tr><td colspan="2">No BAS segment codes loaded.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _segmentRows)
                                    {
                                        <tr>
                                            <td>@(row.Data.TryGetValue("segmentCode", out var code) ? code : "")</td>
                                            <td>@(row.Data.TryGetValue("description", out var description) ? description : "")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="ActivateSegmentsAsync" disabled="@_submitting">Update List</button>
            }
            else if (IsView)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Segment Type</label>
                        <select class="form-select" @bind="_selectedSegmentType">
                            <option value="">Select Type</option>
                            @foreach (var segmentType in _segmentTypes)
                            {
                                <option value="@segmentType.Value">@segmentType.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="LoadSegmentsAsync" disabled="@_submitting">View</button>
            }
            else if (IsFixInvalid)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-secondary btn-sm" @onclick="LoadInvalidJournalsAsync" disabled="@_submitting">Load Invalid Journals</button>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Journal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_journalRows.Count == 0)
                                {
                                    <tr><td colspan="2">No journals found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _journalRows)
                                    {
                                        <tr>
                                            <td>@(row.Data.TryGetValue("journalNumber", out var journal) ? journal : "")</td>
                                            <td>@(row.Data.TryGetValue("status", out var status) ? status : "")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (IsAllocateFund)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.Value">@department.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-secondary btn-sm" @onclick="LoadFundAllocationJournalsAsync" disabled="@_submitting">Load Journals</button>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Journal</th>
                                    <th>Vehicle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_journalRows.Count == 0)
                                {
                                    <tr><td colspan="2">No journals found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _journalRows)
                                    {
                                        <tr>
                                            <td>@(row.Data.TryGetValue("journalNumber", out var journal) ? journal : "")</td>
                                            <td>@(row.Data.TryGetValue("registrationNumber", out var reg) ? reg : "")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunListingAsync" disabled="@_submitting">Load</button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private List<FinanceOptionDto> _departments = new();
    private List<FinanceOptionDto> _segmentTypes = new();

    private string _selectedDepartment = string.Empty;
    private string _selectedSegmentType = string.Empty;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private IBrowserFile? _importFile;

    private List<FinanceGridRowDto> _segmentRows = new();
    private List<FinanceGridRowDto> _journalRows = new();

    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    private bool IsImport => Action == "import-bas";
    private bool IsActivate => Action == "activate-bas";
    private bool IsView => Action == "view-bas";
    private bool IsFixInvalid => Action == "fix-invalid-journals";
    private bool IsAllocateFund => Action == "allocate-fund-codes";

    protected override async Task OnInitializedAsync()
    {
        _departments = await FinanceService.GetDepartmentsAsync();
        _segmentTypes = await FinanceService.GetSegmentTypesAsync();
    }

    private void OnImportFileSelected(InputFileChangeEventArgs args)
    {
        _importFile = args.File;
    }

    private async Task ImportBasAsync()
    {
        if (_importFile == null)
        {
            SetStatus(false, "Please select a file before submitting.", "");
            return;
        }

        _submitting = true;
        var result = await FinanceService.UploadFileAsync("api/finance/bas/import", _importFile, new Dictionary<string, string>
        {
            ["departmentCode"] = _selectedDepartment,
            ["startDate"] = _startDate?.ToString("yyyy-MM-dd") ?? string.Empty,
            ["endDate"] = _endDate?.ToString("yyyy-MM-dd") ?? string.Empty
        });
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private async Task LoadSegmentsAsync()
    {
        _submitting = true;
        var endpoint = $"api/finance/bas/segments?departmentCode={Uri.EscapeDataString(_selectedDepartment)}&segmentType={Uri.EscapeDataString(_selectedSegmentType)}";
        var result = await FinanceService.GetActionAsync(endpoint);
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private async Task ActivateSegmentsAsync()
    {
        _submitting = true;
        var result = await FinanceService.PostActionAsync("api/finance/bas/segments/activate", new
        {
            departmentCode = _selectedDepartment,
            segmentType = _selectedSegmentType
        });
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private async Task LoadInvalidJournalsAsync()
    {
        _submitting = true;
        var endpoint = $"api/finance/bas/journals/invalid?departmentCode={Uri.EscapeDataString(_selectedDepartment)}";
        var result = await FinanceService.GetActionAsync(endpoint);
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private async Task LoadFundAllocationJournalsAsync()
    {
        _submitting = true;
        var endpoint = $"api/finance/bas/journals/uninvoiced?departmentCode={Uri.EscapeDataString(_selectedDepartment)}";
        var result = await FinanceService.GetActionAsync(endpoint);
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private async Task RunListingAsync()
    {
        _submitting = true;
        var endpoint = Action switch
        {
            "invalid-journals" => $"api/finance/bas/journals/invalid?departmentCode={Uri.EscapeDataString(_selectedDepartment)}",
            "departments-no-bas" => "api/finance/bas/departments-without-bas",
            "departments-missing-financial-system" => "api/finance/bas/departments-missing-financial-system",
            _ => "api/finance/bas"
        };

        var result = await FinanceService.GetActionAsync(endpoint);
        SetStatus(result.Success, result.Message, result.Endpoint);
        _submitting = false;
    }

    private void SetStatus(bool success, string message, string endpoint)
    {
        _statusError = !success;
        _statusMessage = string.IsNullOrWhiteSpace(endpoint)
            ? message
            : $"{message} Endpoint: {endpoint}";
    }

    private string PageTitleText => Action switch
    {
        "import-bas" => "Import BAS Segment Codes",
        "activate-bas" => "Activate / De-activate BAS Segment Codes",
        "view-bas" => "View BAS Segment Codes",
        "invalid-journals" => "Un-Invoiced Journals with Invalid BAS Codes",
        "fix-invalid-journals" => "Fix Invalid BAS Codes",
        "allocate-fund-codes" => "Allocate Fund Codes to Vehicle Journals",
        "departments-no-bas" => "Departments with No BAS Codes",
        "departments-missing-financial-system" => "Departments with Missing Financial System",
        _ => "Financial Allocation Codes"
    };

    private string SectionTitle => PageTitleText;

    private string SectionDescription => Action switch
    {
        "import-bas" => "Import BAS segment codes for your department.",
        "activate-bas" => "Activate or de-activate imported BAS codes.",
        "view-bas" => "View activated, de-activated, and expired BAS codes.",
        "invalid-journals" => "List un-invoiced journals with invalid BAS allocation codes.",
        "fix-invalid-journals" => "Correct invalid BAS codes in un-invoiced journals.",
        "allocate-fund-codes" => "Allocate BAS fund codes to vehicle journals.",
        "departments-no-bas" => "List departments with no BAS codes imported.",
        "departments-missing-financial-system" => "List departments with missing financial system settings.",
        _ => "Select a finance allocation function from the menu."
    };
}
