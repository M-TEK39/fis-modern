@page "/finance/financial-allocation/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-spreadsheet"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Financial allocation maintenance aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
            <p>@SectionDescription</p>
        </div>
        <div class="form-card-body">
            @if (IsImport)
            {
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <div class="contract-banner contract-banner-info contract-banner-inline">
                            The requested reports for importer can be obtained by following the procedure
                            [click here to view details].
                        </div>
                        <div class="contract-banner contract-banner-warning contract-banner-inline">
                            NOTE: You can zip files and upload them together; if files are large, zip one by one.
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date (Year / Month / Day)</label>
                        <div class="contract-search-inputs">
                            <select class="form-select">
                                <option>Year</option>
                            </select>
                            <select class="form-select">
                                <option>Month</option>
                            </select>
                            <input class="form-input" placeholder="Day" />
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date (Year / Month / Day)</label>
                        <div class="contract-search-inputs">
                            <select class="form-select">
                                <option>Year</option>
                            </select>
                            <select class="form-select">
                                <option>Month</option>
                            </select>
                            <input class="form-input" placeholder="Day" />
                        </div>
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Upload File</label>
                        <input type="file" class="form-input" />
                    </div>
                </div>
                <button class="btn btn-primary">Submit</button>
            }
            else if (IsActivate)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Select Objectives, Responsibilities, Projects, and Fund codes to show in the list.
                </div>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Segment Code</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Activate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4">No BAS segment codes loaded.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <button class="btn btn-primary">Update List</button>
            }
            else if (IsView)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Segment Type</label>
                        <select class="form-select">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary">View</button>
            }
            else if (IsFixInvalid)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Make corrections to journals with invalid BAS codes.
                </div>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Journal</th>
                                    <th>Responsibility</th>
                                    <th>Objective</th>
                                    <th>Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5">No journals found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (IsAllocateFund)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>
                <div class="contract-banner contract-banner-info contract-banner-inline">
                    Allocate FUND codes to un-invoiced vehicle journals.
                </div>
                <div class="table-container" style="margin-top: 1rem;">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Row</th>
                                    <th>Vehicle</th>
                                    <th>Journal</th>
                                    <th>Fund</th>
                                    <th>Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5">No journals found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>Segment</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4">No data available.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private bool IsImport => Action == "import-bas";
    private bool IsActivate => Action == "activate-bas";
    private bool IsView => Action == "view-bas";
    private bool IsFixInvalid => Action == "fix-invalid-journals";
    private bool IsAllocateFund => Action == "allocate-fund-codes";

    private string PageTitleText => Action switch
    {
        "import-bas" => "Import BAS Segment Codes",
        "activate-bas" => "Activate / De-activate BAS Segment Codes",
        "view-bas" => "View BAS Segment Codes",
        "invalid-journals" => "Un-Invoiced Journals with Invalid BAS Codes",
        "fix-invalid-journals" => "Fix Invalid BAS Codes",
        "allocate-fund-codes" => "Allocate Fund Codes to Vehicle Journals",
        "departments-no-bas" => "Departments with No BAS Codes",
        "departments-missing-financial-system" => "Departments with Missing Financial System",
        _ => "Financial Allocation Codes"
    };

    private string SectionTitle => PageTitleText;

    private string SectionDescription => Action switch
    {
        "import-bas" => "Import BAS segment codes for your department.",
        "activate-bas" => "Activate or de-activate imported BAS codes.",
        "view-bas" => "View activated, de-activated, and expired BAS codes.",
        "invalid-journals" => "List un-invoiced journals with invalid BAS allocation codes.",
        "fix-invalid-journals" => "Correct invalid BAS codes in un-invoiced journals.",
        "allocate-fund-codes" => "Allocate BAS fund codes to vehicle journals.",
        "departments-no-bas" => "List departments with no BAS codes imported.",
        "departments-missing-financial-system" => "List departments with missing financial system settings.",
        _ => "Select a finance allocation function from the menu."
    };
}
