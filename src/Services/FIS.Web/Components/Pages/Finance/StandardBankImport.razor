@page "/finance/standard-bank-import"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using FIS.Web.Services
@inject FinanceApiService FinanceService

<PageTitle>Import Standard Bank Transactions</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-upload"></i>
            Import Standard Bank Transactions
        </h1>
        <p class="page-description">Import monthly Standard Bank transaction files.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Upload Standard Bank Transactions File</h2>
        </div>
        <div class="form-card-body">
            <div class="contract-banner contract-banner-info contract-banner-inline">
                Instructions: Download the latest DBF file from Wesbank, save as CSV, then upload the CSV file.
            </div>
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <label class="form-label">Select File</label>
                    <InputFile OnChange="OnFileSelected" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="UploadAsync" disabled="@_submitting">Upload File</button>
                <a class="btn btn-secondary btn-sm" href="/finance">Close</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IBrowserFile? _selectedFile;
    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile == null)
        {
            _statusError = true;
            _statusMessage = "Please select a file before uploading.";
            return;
        }

        _submitting = true;
        var result = await FinanceService.UploadFileAsync("api/finance/standard-bank/import", _selectedFile);
        _statusError = !result.Success;
        _statusMessage = $"{result.Message} Endpoint: {result.Endpoint}";
        _submitting = false;
    }
}
