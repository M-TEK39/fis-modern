@page "/finance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject FinanceApiService FinanceService
@inject UserProfileApiService UserProfileApiService
@inject SiteApiService SiteApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject IJSRuntime JSRuntime

<PageTitle>Finance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wallet"></i>
            Finance Menu
        </h1>
        <p class="page-description">Finance functions and reports.</p>
    </div>
</div>

<div class="page-content">
    @if (_isBatchRunning)
    {
        <div class="alert alert-warning fis-mb-1">
            Batch is currently running. Legacy parity: finance functions are restricted while batch is active.
            <a class="btn btn-secondary btn-sm fis-ml-1" href="/finance/batch-management">Back to batch management screen</a>
        </div>
    }

    <div class="menu-tiles">
        @if (_canViewFinancialAllocation)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleFinancialAllocation">
                <span>1) Financial Allocation Codes</span>
                <i class="bx @(_showFinancialAllocation ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showFinancialAllocation)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/import-bas">a) Import BAS Segment Codes</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/activate-bas">b) Activate / De-activate BAS Segment Codes</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/view-bas">c) View BAS Segment Codes</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/invalid-journals">d) Un-Invoiced Journals with Invalid BAS Codes</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/fix-invalid-journals">e) Fix Invalid BAS Codes</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/allocate-fund-codes">f) Allocate Fund Codes to Vehicle Journals</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/financial-allocation/departments-no-bas">g) Departments with No BAS Codes</a>
                    </div>
                    @if (_isDept147OrCois)
                    {
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/financial-allocation/departments-missing-financial-system">h) Departments with Missing Financial System</a>
                        </div>
                    }
                </div>
            }
            </div>
        }

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleFinancialReports">
                <span>2) Financial Reports</span>
                <i class="bx @(_showFinancialReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showFinancialReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/reports/department">a) Print Financial Reports by Department</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/reports/province">b) Print Financial Reports by Province</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/reports/site">b) Print Financial Reports by Site</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/reports/vehicle-billing-history">c) Vehicle Billing History report by financial year</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/reports/reversals-tree">d) Reversals Tree Report</a>
                    </div>
                    @if (_isFinanceHeadOfficeOrCois && !_isBatchRunning)
                    {
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/income-department">e) Income Report by Department (date range)</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/income-split-summary">f) Summary Income Split Report</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/income-split-detailed">g) Detailed Income Split Report</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/income-department-site">h) Income Report by Department & Site</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/download-income-department">i) Download Income Report by Department</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/download-income-department-site">j) Download Income Report by Department & Site</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/reports/download-income-department-site-vehicle">k) Download Income Report by Department, Site & Vehicle</a>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_isFinanceHeadOfficeOrCois && !_isBatchRunning)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleInterface">
                <span>2.1) Interface with GPG-SAP System</span>
                <i class="bx @(_showInterface ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showInterface)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/interface/pastel-csv">a) Download Pastel CSV Interface File</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/interface/pastel-csv-customer">b) Download Pastel CSV Interface File with Customer column</a>
                    </div>
                </div>
            }
            </div>
        }

        @if (_hasFinancialReportsRole)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleOutstandingReports">
                <span>2.2) Outstanding Amounts Reports</span>
                <i class="bx @(_showOutstandingReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showOutstandingReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/outstanding/department-site-vehicle">a) Outstanding Amounts per Department, Site & Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/outstanding/department">b) Outstanding Amounts per Department</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/outstanding/department-site">c) Outstanding Amounts per Department & Site</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/outstanding/month-end-vehicle">d) Outstanding Amounts at Month End per Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/outstanding/allocation-exception">e) Allocation Exceptions (Un-Interfaced)</a>
                    </div>
                </div>
            }
            </div>
        }

        @if (_hasFinancialReportsRole && _isDept147OrCois)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleMissingKilometres">
                <span>3) Missing Kilometres</span>
                <i class="bx @(_showMissingKilometres ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showMissingKilometres)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/missing-kilometres/fuel-consumption">a.1) Missing Kilometres from Fuel Consumption (Date Range)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/missing-kilometres/no-kilos-consuming-fuel">a.2) Vehicles with No Kilos but Consumed Fuel</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/missing-kilometres/kilo-gaps-pdf">b.1) Missing Kilometres Report (PDF)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/missing-kilometres/kilo-gaps-xls">b.2) Missing Kilometres Report (Excel)</a>
                    </div>
                    @if (_isCois && !_isBatchRunning)
                    {
                        <div class="menu-item">
                            <a class="menu-item-link" href="/finance/missing-kilometres/close-gaps">c) Automatically Capture Missing Kilos</a>
                        </div>
                    }
                </div>
            }
            </div>
        }

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleAuditTrail">
                <span>5) Audit Trail Reports</span>
                <i class="bx @(_showAuditTrail ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showAuditTrail)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/audit-trail">a) Audit Trail Reports</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleTariffParameters">
                <span>6) Annual Tariff Parameters</span>
                <i class="bx @(_showTariffParameters ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showTariffParameters)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/tariff-parameters">a) Tariff Parameter Management</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleWesbankReports">
                <span>7) Wesbank Expenses Reports</span>
                <i class="bx @(_showWesbankReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showWesbankReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/wesbank/summary-all">a) Summary Expenses Reports (All Inclusive)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/wesbank/summary-selection">b) Summary Expenses Reports (Selection)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/wesbank/detailed-all">c) Detailed Expenses Reports (All Inclusive)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/wesbank/detailed-selection">d) Detailed Expenses Reports (Selection)</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleRegionalModule">
                <span>8) Regional Module: Finance</span>
                <i class="bx @(_showRegionalModule ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showRegionalModule)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/regional/menu">a) Regional Module: Finance</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/regional/assets">b) Asset List: Vehicles in FIS (New & In-Service)</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleProfitability">
                <span>9) Vehicles Profitability Report</span>
                <i class="bx @(_showProfitability ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showProfitability)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/profitability">a) VIP & Pool Vehicles Profitability Report</a>
                    </div>
                </div>
            }
        </div>

        @if (_isFinanceHeadOfficeOrCois && !_isBatchRunning)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleStandardBankImport">
                <span>10) Import Standard Bank Transactions</span>
                <i class="bx @(_showStandardBankImport ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showStandardBankImport)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/standard-bank-import">a) Import monthly Standard Bank Transactions File</a>
                    </div>
                </div>
            }
            </div>
        }

        @if (!_isBatchRunning)
        {
            <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleBatchManagement">
                <span>11) Batch Management</span>
                <i class="bx @(_showBatchManagement ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showBatchManagement)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/finance/batch-management">Batch management</a>
                    </div>
                </div>
            }
            </div>
        }
    </div>

    <DataPreviewTable Title="Finance Reference Preview"
                      SearchPlaceholder="Search departments, sites, financial years, batch dates..."
                      EmptyMessage="No finance reference records match the current search or filter."
                      EmptyIcon="bx bx-wallet"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _showFinancialAllocation = true;
    private bool _showFinancialReports = true;
    private bool _showInterface = true;
    private bool _showOutstandingReports = true;
    private bool _showMissingKilometres = true;
    private bool _showAuditTrail = true;
    private bool _showTariffParameters = true;
    private bool _showWesbankReports = true;
    private bool _showRegionalModule = true;
    private bool _showProfitability = true;
    private bool _showStandardBankImport = true;
    private bool _showBatchManagement = true;
    private bool _loading = true;
    private bool _isBatchRunning;
    private bool _hasFinancialDataOwnDepartmentRole;
    private bool _hasFinancialReportsRole;
    private bool _isFinanceHeadOfficeOrCois;
    private bool _isDept147OrCois;
    private bool _isCois;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("type", "Type"),
        new("code", "Code"),
        new("description", "Description")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Departments", "type", "Department"),
        new("Sites", "type", "Site"),
        new("Financial years", "type", "Financial Year"),
        new("Batch dates", "type", "Batch Date")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadPreviewAsync();
    }

    private void ToggleFinancialAllocation() => _showFinancialAllocation = !_showFinancialAllocation;
    private void ToggleFinancialReports() => _showFinancialReports = !_showFinancialReports;
    private void ToggleInterface() => _showInterface = !_showInterface;
    private void ToggleOutstandingReports() => _showOutstandingReports = !_showOutstandingReports;
    private void ToggleMissingKilometres() => _showMissingKilometres = !_showMissingKilometres;
    private void ToggleAuditTrail() => _showAuditTrail = !_showAuditTrail;
    private void ToggleTariffParameters() => _showTariffParameters = !_showTariffParameters;
    private void ToggleWesbankReports() => _showWesbankReports = !_showWesbankReports;
    private void ToggleRegionalModule() => _showRegionalModule = !_showRegionalModule;
    private void ToggleProfitability() => _showProfitability = !_showProfitability;
    private void ToggleStandardBankImport() => _showStandardBankImport = !_showStandardBankImport;
    private void ToggleBatchManagement() => _showBatchManagement = !_showBatchManagement;

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var departmentsTask = FinanceService.GetDepartmentsAsync();
            var sitesTask = FinanceService.GetSitesAsync();
            var yearsTask = FinanceService.GetFinancialYearsAsync();
            var batchesTask = FinanceService.GetBatchDatesAsync();
            await Task.WhenAll(departmentsTask, sitesTask, yearsTask, batchesTask);

            _rows = BuildRows("Department", departmentsTask.Result)
                .Concat(BuildRows("Site", sitesTask.Result))
                .Concat(BuildRows("Financial Year", yearsTask.Result))
                .Concat(BuildRows("Batch Date", batchesTask.Result))
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading finance preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static IEnumerable<Dictionary<string, string?>> BuildRows(string type, IEnumerable<FinanceOptionDto> items)
    {
        return items.Select(item => new Dictionary<string, string?>
        {
            ["type"] = type,
            ["code"] = item.Value,
            ["description"] = item.Label,
            ["_href"] = FinancePreviewHref(type)
        });
    }

    private static string FinancePreviewHref(string type) =>
        type switch
        {
            "Department" => "/finance/reports/department",
            "Site" => "/finance/reports/site",
            "Financial Year" => "/finance/tariff-parameters",
            "Batch Date" => "/finance/batch-management",
            _ => "/finance"
        };

    private bool _canViewFinancialAllocation => _hasFinancialDataOwnDepartmentRole && !_isBatchRunning;

    private async Task ResolveCurrentUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var username = ResolveUsername(user);
        _isCois = string.Equals(username, "cois", StringComparison.OrdinalIgnoreCase);

        _hasFinancialDataOwnDepartmentRole = HasRole(user, "Financial Data (Own Department)");
        _hasFinancialReportsRole = HasRole(user, "Financial Reports");

        var userAccessCodeClaim = user.FindFirst("user_access_code")?.Value;
        int.TryParse(userAccessCodeClaim, out var userAccessCode);

        var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
        var accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode > 0 ? userAccessCode : null, firstName);
        if (!_hasFinancialDataOwnDepartmentRole && (accessLevel & LegacyPermissionBits.Financial) == LegacyPermissionBits.Financial)
        {
            _hasFinancialDataOwnDepartmentRole = true;
        }

        if (!_hasFinancialReportsRole && (accessLevel & LegacyPermissionBits.Financial) == LegacyPermissionBits.Financial)
        {
            _hasFinancialReportsRole = true;
        }

        var profile = userAccessCode > 0
            ? await UserProfileApiService.GetByUserAccessCodeAsync(userAccessCode)
            : await UserProfileApiService.GetByFirstNameAsync(firstName ?? string.Empty);

        if (profile?.SiteCode is > 0)
        {
            _isFinanceHeadOfficeOrCois = profile.SiteCode.Value == 1598 || _isCois;
            var site = await SiteApiService.GetByIdAsync(profile.SiteCode.Value);
            _isDept147OrCois = site?.DepartmentCode == 147 || _isCois;
        }
        else
        {
            _isFinanceHeadOfficeOrCois = _isCois;
            _isDept147OrCois = _isCois;
        }

        var batchStatus = await FinanceService.GetBatchStatusAsync();
        _isBatchRunning = batchStatus?.BatchIsRunning == true;
    }

    private static string ResolveUsername(ClaimsPrincipal user)
    {
        return user.Identity?.Name
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? string.Empty;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
