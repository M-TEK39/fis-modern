@page "/finance"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject TariffApiService TariffService
@inject IJSRuntime JS

<PageTitle>Finance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wallet"></i>
            Finance
        </h1>
        <p class="page-description">Finance tasks overview with live tariff checks.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadFinanceTasks">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading finance tasks...</p>
        </div>
    }
    else if (_tasks.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-wallet"></i>
            <h3>No finance items</h3>
            <p>Awaiting finance API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_tasks.Count Finance item(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Process</th>
                            <th>Status</th>
                            <th>Last Run</th>
                            <th>Owner</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _tasks)
                        {
                            <tr>
                                <td>@task.Process</td>
                                <td><span class="badge">@task.Status</span></td>
                                <td>@task.LastRun.ToString("yyyy-MM-dd")</td>
                                <td>@task.Owner</td>
                                <td>@task.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FinanceTask> _tasks = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFinanceTasks();
    }

    private async Task LoadFinanceTasks()
    {
        _loading = true;
        try
        {
            // Example: check tariffs for a few contract codes (1-3) to populate finance view
            var financeRows = new List<FinanceTask>
            {
                new("Tariff Check", "Live", DateTime.Now, "Tariff API", "Using /api/Tariff/contract/{contractCode}."),
                new("Billing History", "Available", DateTime.Now, "Report API", "Use /api/Report/billing/history/{vmfCode}."),
                new("Maintenance Cost", "Available", DateTime.Now, "Report API", "Use /api/Report/maintenance/cost.")
            };
            _tasks = financeRows;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading finance tasks: {ex.Message}");
            _tasks = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record FinanceTask(string Process, string Status, DateTime LastRun, string Owner, string Notes);
}
