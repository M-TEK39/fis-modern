@page "/finance/interface/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-transfer-alt"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Interface downloads aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Batch Date</label>
                    <select class="form-select">
                        <option value="">Select Batch Date</option>
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private string PageTitleText => Action switch
    {
        "pastel-csv" => "Download Pastel CSV Interface File",
        "pastel-csv-customer" => "Download Pastel CSV Interface File with Customer Column",
        _ => "GPG-SAP Interface"
    };

    private string SectionTitle => PageTitleText;
}
