@page "/finance/interface/{Action?}"
@page "/Finance/SelectBatchDate.aspx"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.JSInterop
@inject FinanceApiService FinanceService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-transfer-alt"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Interface file generation and downloads.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Batch Date</label>
                    <select class="form-select" @bind="_selectedBatchDate">
                        <option value="">Select Batch Date</option>
                        @foreach (var batchDate in _batchDates)
                        {
                            <option value="@batchDate.Value">@batchDate.Label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="SubmitAsync" disabled="@_submitting">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-1">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private List<FinanceOptionDto> _batchDates = new();
    private string _selectedBatchDate = string.Empty;
    private bool _submitting;
    private bool _statusError;
    private string _statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _batchDates = await FinanceService.GetBatchDatesAsync();
    }

    protected override void OnParametersSet()
    {
        Action = ResolveLegacyAction();
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _statusMessage = string.Empty;

        var endpoint = Action == "pastel-csv-customer"
            ? "api/finance/interface/pastel-csv-customer"
            : "api/finance/interface/pastel-csv";

        var filename = Action == "pastel-csv-customer"
            ? $"pastel-customers-{DateTime.UtcNow:yyyyMMddHHmmss}.csv"
            : $"pastel-export-{DateTime.UtcNow:yyyyMMddHHmmss}.csv";

        var fileResult = await FinanceService.PostFileAsync(endpoint, new
        {
            batchDate = _selectedBatchDate
        }, filename);

        _statusError = !fileResult.Success;
        _statusMessage = fileResult.Message;

        if (fileResult.Success && fileResult.Content.Length > 0)
        {
            await JSRuntime.InvokeVoidAsync(
                "fisDownload.downloadBase64",
                fileResult.Filename,
                Convert.ToBase64String(fileResult.Content),
                fileResult.ContentType);
        }

        _submitting = false;
    }

    private string PageTitleText => Action switch
    {
        "pastel-csv" => "Download Pastel CSV Interface File",
        "pastel-csv-customer" => "Download Pastel CSV Interface File with Customer Column",
        _ => "GPG-SAP Interface"
    };

    private string SectionTitle => PageTitleText;

    private string ResolveLegacyAction()
    {
        var normalizedAction = (Action ?? string.Empty).Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(normalizedAction))
        {
            return normalizedAction;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = uri.AbsolutePath.Trim('/').ToLowerInvariant();
        if (path != "finance/selectbatchdate.aspx")
        {
            return "pastel-csv";
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        var followPage = query.TryGetValue("FollowPage", out var follow) ? follow.ToString().Trim().ToLowerInvariant() : string.Empty;

        return followPage.Contains("item=exportpastelcsvwithclient", StringComparison.OrdinalIgnoreCase)
            ? "pastel-csv-customer"
            : "pastel-csv";
    }
}
