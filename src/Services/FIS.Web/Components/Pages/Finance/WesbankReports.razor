@page "/finance/wesbank/{Action?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Wesbank expenses reporting aligned to the legacy workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/finance">Finance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@SectionTitle</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-input" />
                </div>
                @if (RequiresProvince)
                {
                    <div class="form-field">
                        <label class="form-label">Province</label>
                        <select class="form-select">
                            <option value="">Select Province</option>
                        </select>
                    </div>
                }
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/finance">Back</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    private string PageTitleText => Action switch
    {
        "summary-all" => "Summary Wesbank Expenses Reports (All Inclusive)",
        "summary-selection" => "Summary Wesbank Expenses Reports (Selection)",
        "detailed-all" => "Detailed Wesbank Expenses Reports (All Inclusive)",
        "detailed-selection" => "Detailed Wesbank Expenses Reports (Selection)",
        _ => "Wesbank Expenses Reports"
    };

    private string SectionTitle => PageTitleText;

    private bool RequiresProvince => Action is "summary-selection" or "detailed-selection";
}
