@page "/trip-authorities"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@using FIS.Web.Models
@inject TripApiService TripService
@inject TripDriverApiService TripDriverService
@inject IJSRuntime JS

<PageTitle>Trip Authorities - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Trip Authorities
        </h1>
        <p class="page-description">Trip authority summary from Trip and TripDriver APIs.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadTripAuthorities">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trip authorities...</p>
        </div>
    }
    else if (_authorities.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-clipboard"></i>
            <h3>No trip authorities</h3>
            <p>Awaiting trip authority API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_authorities.Count Authority record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Authority #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th>Expiry</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var auth in _authorities)
                        {
                            <tr>
                                <td>@auth.Number</td>
                                <td>@auth.Vehicle</td>
                                <td><span class="badge">@auth.Status</span></td>
                                <td>@auth.Issued.ToString("yyyy-MM-dd")</td>
                                <td>@auth.Expiry.ToString("yyyy-MM-dd")</td>
                                <td>@auth.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<TripAuthorityItem> _authorities = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTripAuthorities();
    }

    private async Task LoadTripAuthorities()
    {
        _loading = true;
        try
        {
            var trips = await TripService.GetAllAsync();
            var drivers = await TripDriverService.GetAllAsync();

            _authorities = trips.Select(t =>
            {
                var driverName = drivers.FirstOrDefault(d => d.DriverCode == t.DriverId)?.Notes ?? "N/A";
                return new TripAuthorityItem(
                    Number: t.TripId.ToString(),
                    Vehicle: t.VmfCode.ToString(),
                    Status: t.Status ?? "Unknown",
                    Issued: t.TripDate,
                    Expiry: t.TripDate.AddMonths(1),
                    Notes: driverName ?? t.Notes ?? string.Empty
                );
            }).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading trip authorities: {ex.Message}");
            _authorities = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record TripAuthorityItem(string Number, string Vehicle, string Status, DateTime Issued, DateTime Expiry, string Notes);
}
