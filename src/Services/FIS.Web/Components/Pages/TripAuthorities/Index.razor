@page "/trip-authorities"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Trip Authorities - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Trip Authorities
        </h1>
        <p class="page-description">Trip authority summary. Static entries until trip authority API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadTripAuthorities">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trip authorities...</p>
        </div>
    }
    else if (_authorities.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-clipboard"></i>
            <h3>No trip authorities</h3>
            <p>Awaiting trip authority API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_authorities.Count Authority record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Authority #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th>Expiry</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var auth in _authorities)
                        {
                            <tr>
                                <td>@auth.Number</td>
                                <td>@auth.Vehicle</td>
                                <td><span class="badge">@auth.Status</span></td>
                                <td>@auth.Issued.ToString("yyyy-MM-dd")</td>
                                <td>@auth.Expiry.ToString("yyyy-MM-dd")</td>
                                <td>@auth.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<TripAuthorityItem> _authorities = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTripAuthorities();
    }

    private Task LoadTripAuthorities()
    {
        _loading = true;

        _authorities =
        [
            new("TA-2401-001", "ABC123GP", "Active", new DateTime(2025, 01, 12), new DateTime(2025, 02, 12), "Issued for monthly trips."),
            new("TA-2401-002", "JKL456GP", "Pending", new DateTime(2025, 01, 10), new DateTime(2025, 02, 10), "Awaiting approval."),
            new("TA-2312-010", "MNO789GP", "Expired", new DateTime(2024, 12, 05), new DateTime(2025, 01, 05), "Expired; renewal needed."),
            new("TA-2311-006", "PQR321GP", "Closed", new DateTime(2024, 11, 18), new DateTime(2024, 12, 18), "Closed; archived.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record TripAuthorityItem(string Number, string Vehicle, string Status, DateTime Issued, DateTime Expiry, string Notes);
}
