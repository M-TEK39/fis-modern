@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Models
@using FIS.Web.Services
@inject TripApiService TripService
@inject VehicleApiService VehicleService
@inject DepartmentApiService DepartmentService
@inject SiteApiService SiteService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Trip Authority - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Trip Authority
        </h1>
        <p class="page-description">Select a tab below to change filtering from GG Number to Department &amp; Site to Trip Authority Number.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasTripAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>@_accessMessage</p>
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Select Location</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <span class="menu-item-link">My Site (@_currentSiteCodeDisplay)</span>
                </div>
                <div class="menu-item">
                    <span class="menu-item-link">My Department (@_currentDepartmentCodeDisplay)</span>
                </div>
                <div class="menu-item">
                    <span class="menu-item-link">Access Mode: @_mode</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Trip Tools</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/trips/create">Create Trip Authority</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/trips/show">View / Close Trip Authority</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/trips/driver-maintenance">Maintain Drivers</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/trips/driver-info">Driver Information (Financial Year)</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/trips/remove-without-routes">Remove Trips Without Routes</a>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h2>Trip Authority</h2>
            <p>Select a tab to filter by GG Number, Department/Site, or Trip Authority Number.</p>
        </div>
        <div class="form-card-body">
            <div class="tabs">
                <button class="tab @(_activeTab == "gg" ? "active" : "")" @onclick='() => SetActiveTab("gg")'>
                    <i class="bx bx-car"></i>
                    GG Number
                </button>
                <button class="tab @(_activeTab == "department" ? "active" : "")" @onclick='() => SetActiveTab("department")'>
                    <i class="bx bx-buildings"></i>
                    Department / Site
                </button>
                <button class="tab @(_activeTab == "authority" ? "active" : "")" @onclick='() => SetActiveTab("authority")'>
                    <i class="bx bx-id-card"></i>
                    Trip Authority Number
                </button>
            </div>

            <div class="tab-content">
                @if (_activeTab == "gg")
                {
                    <div class="form-grid">
                        <div class="form-field form-group-full">
                            <label class="form-label">Number Type</label>
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                    GG
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                    GP
                                </label>
                            </div>
                            <div class="contract-search-radio">
                                <input class="form-input compact-search-input" placeholder="@(_searchMode == "GG" ? "Search by GG number" : "Search by GP number")" @bind="_ggSearch" @bind:event="oninput" />
                                <button class="btn btn-secondary btn-sm" @onclick="SearchByVehicle">Go</button>
                            </div>
                        </div>
                    </div>
                    @TripTables
                }
                else if (_activeTab == "department")
                {
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartment" @bind:after="ApplyFiltersAfterBind" disabled="@(_mode == "SITE" || _mode == "DEP")">
                            <option value="">Select Department</option>
                            @foreach (var department in _departments)
                            {
                                <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                            }
                        </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Site</label>
                        <select class="form-select" @bind="_selectedSite" @bind:after="ApplyFiltersAfterBind" disabled="@(_mode == "SITE")">
                            <option value="">Select Site</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                        </div>
                    </div>
                    @TripTables
                }
                else
                {
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Trip Authority Number</label>
                        <div class="contract-search-radio">
                            <input class="form-input compact-search-input-sm" placeholder="Numbers only" @bind="_authoritySearch" @bind:event="oninput" />
                            <button class="btn btn-secondary btn-sm" @onclick="SearchByAuthority">Go</button>
                        </div>
                        </div>
                    </div>
                    @TripTables
                }
            </div>
        </div>
    </div>
    }
</div>

@code {
    private string _activeTab = "gg";
    private string _searchMode = "GG";
    private string _ggSearch = "";
    private string _authoritySearch = "";
    private string? _selectedDepartment;
    private string? _selectedSite;
    private bool _loading;
    private bool _hasTripAccess;
    private List<TripRow> _vehiclesOut = new();
    private List<VehicleRow> _vehiclesIn = new();
    private List<TripRow> _allTrips = new();
    private List<VehicleRow> _allVehicles = new();
    private List<DepartmentDto> _departments = new();
    private List<SiteResponseDto> _sites = new();
    private Dictionary<short, short?> _siteDepartmentMap = new();
    private int? _currentUserAccessCode;
    private short? _currentDepartmentCode;
    private short? _currentSiteCode;
    private long _currentAccessLevel;
    private string _mode = "SITE";
    private string _accessMessage = "You do not have sufficient access to use this page.";
    private string _currentDepartmentCodeDisplay => _currentDepartmentCode?.ToString() ?? "-";
    private string _currentSiteCodeDisplay => _currentSiteCode?.ToString() ?? "-";
    private readonly int _pageSize = 12;
    private int _inPage = 1;
    private int _outPage = 1;

    private IEnumerable<VehicleRow> PagedVehiclesIn
        => _vehiclesIn.Skip((_inPage - 1) * _pageSize).Take(_pageSize);

    private IEnumerable<TripRow> PagedVehiclesOut
        => _vehiclesOut.Skip((_outPage - 1) * _pageSize).Take(_pageSize);

    private int TotalInPages => Math.Max(1, (int)Math.Ceiling(_vehiclesIn.Count / (double)_pageSize));
    private int TotalOutPages => Math.Max(1, (int)Math.Ceiling(_vehiclesOut.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_hasTripAccess)
        {
            return;
        }

        await LoadReferenceData();
        await LoadTripsAndVehicles();
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        ResetPaging();
    }

    private RenderFragment TripTables => @<div>
        <div class="form-section">
            <h3 class="form-section-title">(IN) Vehicles available for a trip.</h3>
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Fleet Number</th>
                                <th>Registration Number</th>
                                <th>License Disk Expires</th>
                                <th>Make Description</th>
                                <th>Model Description</th>
                                <th>Contract Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="7">Loading vehicles...</td>
                                </tr>
                            }
                            else if (_vehiclesIn.Count == 0)
                            {
                                <tr><td colspan="7">No in-service vehicles available for trip assignment.</td></tr>
                            }
                            else
                            {
                                @foreach (var vehicle in PagedVehiclesIn)
                                {
                                    <tr>
                                        <td>@ValueOrDash(vehicle.FleetNumber)</td>
                                        <td>@ValueOrDash(vehicle.RegistrationNumber)</td>
                                        <td>@FormatDate(vehicle.LicenceDueDate)</td>
                                        <td>@ValueOrDash(vehicle.Make)</td>
                                        <td>@ValueOrDash(vehicle.Model)</td>
                                        <td>@ValueOrDash(vehicle.ContractType)</td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm" href="@BuildCreateTripLink(vehicle)">Select</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (_vehiclesIn.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevInPage" disabled="@(_inPage <= 1)">Previous</button>
                    <div class="pagination-info">Page @_inPage of @TotalInPages</div>
                    <button class="pagination-btn" @onclick="NextInPage" disabled="@(_inPage >= TotalInPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_vehiclesIn.Count | Page size: @_pageSize</div>
            }
        </div>

        <div class="form-section">
            <h3 class="form-section-title">(OUT) Vehicles allocated to a trip.</h3>
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Fleet Number</th>
                                <th>Registration Number</th>
                                <th>License Disk Expires</th>
                                <th>Make Description</th>
                                <th>Model Description</th>
                                <th>Contract Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="7">Loading vehicles...</td>
                                </tr>
                            }
                            else if (_vehiclesOut.Count == 0)
                            {
                                <tr>
                                    <td colspan="7">No vehicles were found that are currently OUT on a trip.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var trip in PagedVehiclesOut)
                                {
                                    <tr>
                                        <td>@ValueOrDash(trip.FleetNumber)</td>
                                        <td>@ValueOrDash(trip.RegistrationNumber)</td>
                                        <td>@FormatDate(trip.LicenceDueDate)</td>
                                        <td>@ValueOrDash(trip.Make)</td>
                                        <td>@ValueOrDash(trip.Model)</td>
                                        <td>@ValueOrDash(trip.ContractType)</td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm" href="@BuildShowTripLink(trip)">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (_vehiclesOut.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevOutPage" disabled="@(_outPage <= 1)">Previous</button>
                    <div class="pagination-info">Page @_outPage of @TotalOutPages</div>
                    <button class="pagination-btn" @onclick="NextOutPage" disabled="@(_outPage >= TotalOutPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_vehiclesOut.Count | Page size: @_pageSize</div>
            }
        </div>
    </div>;

    private async Task LoadReferenceData()
    {
        _departments = await DepartmentService.GetDepartmentsAsync();
        _sites = await SiteService.GetAllAsync();
        _siteDepartmentMap = _sites
            .ToDictionary(s => s.SiteCode, s => s.DepartmentCode);

        if (_mode == "SITE")
        {
            _selectedSite = _currentSiteCode?.ToString();
            _selectedDepartment = _currentDepartmentCode?.ToString();
        }
        else if (_mode == "DEP")
        {
            _selectedDepartment = _currentDepartmentCode?.ToString();
            if (_currentSiteCode.HasValue)
            {
                _selectedSite = _currentSiteCode.Value.ToString();
            }
        }
    }

    private async Task LoadTripsAndVehicles()
    {
        _loading = true;
        try
        {
            var trips = await TripService.GetAllAsync();
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 200);
            var vehicleList = vehicles.Data;
            var vehicleMap = vehicleList.ToDictionary(v => v.vmf_code, v => v);

            _allTrips = trips.Select(t => BuildTripRow(t, vehicleMap)).ToList();
            _allVehicles = vehicleList.Select(BuildVehicleRow).ToList();

            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchByVehicle()
    {
        var filteredVehicles = FilterVehiclesByMode(_allVehicles);
        var filteredTrips = FilterTripsByMode(_allTrips);

        if (string.IsNullOrWhiteSpace(_ggSearch))
        {
            ApplyFilters();
            return;
        }

        var searchTerm = _ggSearch.Trim();
        var matches = await VehicleService.SearchVehiclesAsync(searchTerm);
        matches = RankVehicleMatches(matches, searchTerm, _searchMode);
        if (matches.Count == 0)
        {
            _vehiclesIn = new();
            _vehiclesOut = new();
            ResetPaging();
            return;
        }

        var vmfCodes = matches.Select(v => v.vmf_code).ToHashSet();
        _vehiclesIn = filteredVehicles.Where(v => v.VmfCode.HasValue && vmfCodes.Contains(v.VmfCode.Value)).ToList();
        _vehiclesOut = filteredTrips.Where(t => t.VmfCode.HasValue && vmfCodes.Contains(t.VmfCode.Value)).ToList();
        ResetPaging();
    }

    private void SearchByAuthority()
    {
        if (!int.TryParse(_authoritySearch, out var tripId))
        {
            ApplyFilters();
            return;
        }

        _vehiclesOut = FilterTripsByMode(_allTrips).Where(t => t.TripId == tripId).ToList();
        _vehiclesIn = new();
        ResetPaging();
    }

    private void ApplyFilters()
    {
        var outList = FilterTripsByMode(_allTrips);
        var inList = FilterVehiclesByMode(_allVehicles);

        if (short.TryParse(_selectedSite, out var siteCode))
        {
            outList = outList.Where(t => t.SiteCode == siteCode).ToList();
            inList = inList.Where(v => v.SiteCode == siteCode).ToList();
        }

        if (short.TryParse(_selectedDepartment, out var departmentCode))
        {
            outList = outList.Where(t => IsInDepartment(t.SiteCode, departmentCode)).ToList();
            inList = inList.Where(v => IsInDepartment(v.SiteCode, departmentCode)).ToList();
        }

        _vehiclesOut = outList;
        _vehiclesIn = inList.Where(v => !_vehiclesOut.Any(t => t.VmfCode == v.VmfCode)).ToList();
        ResetPaging();
    }

    private Task ApplyFiltersAfterBind()
    {
        ApplyFilters();
        return Task.CompletedTask;
    }

    private List<TripRow> FilterTripsByMode(IEnumerable<TripRow> source)
    {
        var outTrips = source.Where(IsTripOpen).ToList();

        if (_mode == "SITE" && _currentSiteCode.HasValue)
        {
            return outTrips.Where(t => t.SiteCode == _currentSiteCode.Value).ToList();
        }

        if (_mode == "DEP" && _currentDepartmentCode.HasValue)
        {
            return outTrips.Where(t => IsInDepartment(t.SiteCode, _currentDepartmentCode.Value)).ToList();
        }

        return outTrips;
    }

    private List<VehicleRow> FilterVehiclesByMode(IEnumerable<VehicleRow> source)
    {
        if (_mode == "SITE" && _currentSiteCode.HasValue)
        {
            return source.Where(v => v.SiteCode == _currentSiteCode.Value).ToList();
        }

        if (_mode == "DEP" && _currentDepartmentCode.HasValue)
        {
            return source.Where(v => IsInDepartment(v.SiteCode, _currentDepartmentCode.Value)).ToList();
        }

        return source.ToList();
    }

    private bool IsInDepartment(short? siteCode, short departmentCode)
    {
        return siteCode.HasValue
            && _siteDepartmentMap.TryGetValue(siteCode.Value, out var dep)
            && dep.HasValue
            && dep.Value == departmentCode;
    }

    private static bool IsTripOpen(TripRow trip)
    {
        var status = trip.ContractType ?? string.Empty;
        return !status.Contains("closed", StringComparison.OrdinalIgnoreCase)
            && !status.Contains("close", StringComparison.OrdinalIgnoreCase);
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _ggSearch = string.Empty;
        ApplyFilters();
    }

    private void PrevInPage()
    {
        if (_inPage > 1)
        {
            _inPage--;
        }
    }

    private void NextInPage()
    {
        if (_inPage < TotalInPages)
        {
            _inPage++;
        }
    }

    private void PrevOutPage()
    {
        if (_outPage > 1)
        {
            _outPage--;
        }
    }

    private void NextOutPage()
    {
        if (_outPage < TotalOutPages)
        {
            _outPage++;
        }
    }

    private void ResetPaging()
    {
        _inPage = 1;
        _outPage = 1;
    }

    private string BuildCreateTripLink(VehicleRow vehicle)
    {
        var vmf = vehicle.VmfCode ?? 0;
        var siteCode = vehicle.SiteCode ?? _currentSiteCode ?? 0;
        var departmentCode = _siteDepartmentMap.TryGetValue(siteCode, out var dep)
            ? dep ?? _currentDepartmentCode ?? 0
            : _currentDepartmentCode ?? 0;

        return $"/trips/create?mode=New&vmfCode={vmf}&site={siteCode}&department={departmentCode}";
    }

    private string BuildShowTripLink(TripRow trip)
    {
        var vmf = trip.VmfCode ?? 0;
        var siteCode = trip.SiteCode ?? _currentSiteCode ?? 0;
        var departmentCode = _siteDepartmentMap.TryGetValue(siteCode, out var dep)
            ? dep ?? _currentDepartmentCode ?? 0
            : _currentDepartmentCode ?? 0;

        return $"/trips/show?tripId={trip.TripId}&vmfCode={vmf}&site={siteCode}&department={departmentCode}";
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _hasTripAccess = false;
            _accessMessage = "You must sign in to access Trip Authorities.";
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        _currentDepartmentCode = TryParseShort(
            user.FindFirst("department_code")?.Value
            ?? user.FindFirst("department")?.Value);
        _currentSiteCode = TryParseShort(
            user.FindFirst("site_code")?.Value
            ?? user.FindFirst("site")?.Value);

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        var hasTripRole = HasRole(user, "TripAuthorities") || HasRole(user, "Trip Authorities");
        var hasVehiclePermission =
            (_currentAccessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _hasTripAccess = hasTripRole || hasVehiclePermission;

        if (!_hasTripAccess)
        {
            _accessMessage = "You do not have sufficient access to use this page.";
            return;
        }

        _mode = "SITE";
        if (HasRole(user, "VehicleListForAllSitesInDepartment"))
        {
            _mode = "DEP";
        }

        if (HasRole(user, "VehicleListForAllDepartmentsInProvince"))
        {
            _mode = "ALL";
        }
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private static short? TryParseShort(string? value)
        => short.TryParse(value, out var parsed) ? parsed : null;

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c =>
                c.Type == ClaimTypes.Role
                || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase)
                || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private TripRow BuildTripRow(TripDto trip, Dictionary<int, VehicleDto> vehicleMap)
    {
        vehicleMap.TryGetValue(trip.VmfCode, out var vehicle);
        var status = trip.Status ?? "Open";
        if (status.Contains("close", StringComparison.OrdinalIgnoreCase))
        {
            status = "Closed";
        }

        return new TripRow(
            TripId: trip.TripId,
            VmfCode: trip.VmfCode,
            FleetNumber: vehicle?.fleet_number,
            RegistrationNumber: vehicle?.registration_number,
            LicenceDueDate: vehicle?.licence_due_date,
            Make: vehicle?.type_name,
            Model: vehicle?.model_name,
            ContractType: status,
            SiteCode: vehicle?.site_code
        );
    }

    private VehicleRow BuildVehicleRow(VehicleDto vehicle)
        => new(
            VmfCode: vehicle.vmf_code,
            FleetNumber: vehicle.fleet_number,
            RegistrationNumber: vehicle.registration_number,
            LicenceDueDate: vehicle.licence_due_date,
            Make: vehicle.type_name,
            Model: vehicle.model_name,
            ContractType: vehicle.status_description,
            SiteCode: vehicle.site_code
        );

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record TripRow(
        int TripId,
        int? VmfCode,
        string? FleetNumber,
        string? RegistrationNumber,
        DateTime? LicenceDueDate,
        string? Make,
        string? Model,
        string? ContractType,
        short? SiteCode
    );

    private sealed record VehicleRow(
        int? VmfCode,
        string? FleetNumber,
        string? RegistrationNumber,
        DateTime? LicenceDueDate,
        string? Make,
        string? Model,
        string? ContractType,
        short? SiteCode
    );
}
