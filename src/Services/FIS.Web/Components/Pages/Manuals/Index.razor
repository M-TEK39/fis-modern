@page "/manuals"
@rendermode InteractiveServer

<PageTitle>Manuals - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-book"></i>
            Manuals
        </h1>
        <p class="page-description">Manuals library.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadManuals">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading manuals...</p>
        </div>
    }
    else if (_manuals.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-book-open"></i>
            <h3>No manuals found</h3>
            <p>Manual library is currently empty.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_manuals.Count Manual(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var manual in PagedManuals)
                        {
                            <tr>
                                <td>@manual.Title</td>
                                <td>@manual.Description</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn-icon btn-icon-view" href="@manual.Path" target="_blank" rel="noopener noreferrer" title="Open manual">
                                            <i class="bx bx-link-external"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<ManualItem> _manuals = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<ManualItem> PagedManuals => _manuals.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_manuals.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadManuals();
    }

    private Task LoadManuals()
    {
        _loading = true;

        _manuals =
        [
            new("Electronic Logsheet and Trip Authority Training Manual", "/Docs/Electronic Log Sheet and Trip Authority Training Manual.doc", "Step-by-step user training for the electronic logsheet workflow."),
            new("Manual: Updating Trip Authorities", "/Docs/doc/Updating Trip Authorities Manual2.htm", "Procedural guide for updating existing trip authority records."),
            new("Procedures Manual (Chauffeur Driven Service)", "/private_hire/Procedures_manual.htm", "Procedures governing the chauffeur driven service."),
            new("Manuals Library", "/Manuals/Allmanuals.htm", "Consolidated library of system manuals and references."),
            new("Manual for Changing Password", "/Docs/Implementation of User Admin on GGMT system.doc", "Guidance on rotating passwords inside the User Admin module.")
        ];

        _page = Math.Min(_page, TotalPages);
        _loading = false;
        return Task.CompletedTask;
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed record ManualItem(string Title, string Path, string Description);
}
