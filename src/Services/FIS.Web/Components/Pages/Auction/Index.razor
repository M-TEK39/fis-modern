@page "/auction"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Auction - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-dollar"></i>
            Auction
        </h1>
        <p class="page-description">Auction maintenance and reporting aligned to the legacy workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Auction Maintenance Menu</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/auction/help">Auction Maintenance Information / Help</a>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Auction Maintenance for Johannesburg Garage</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/auction/maintenance">1) Auction Maintenance</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/auction/delete-vehicle">2) Delete a Vehicle on Auction</a>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Auction Reports Menu</span>
                <i class="bx bx-chevron-down"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/auction/reports">Open Auction Reports Menu</a>
                </div>
            </div>
        </div>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="Auction/MNTAuction.aspx"
        Endpoint="api/auction/menu"
        HttpMethod="GET"
        ButtonText="Test Auction Menu Endpoint"
        ReportType="auction-menu" />
</div>
