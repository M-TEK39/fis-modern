@page "/auction/delete-vehicle"
@rendermode InteractiveServer

<PageTitle>Delete Auction Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Auction
        </h1>
        <p class="page-description">Find a vehicle by GG number to delete auction entries.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/auction">Auction Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Delete Auction</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" placeholder="GG Number" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/auction">Menu</a>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Auction Entries</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Auction Number</th>
                        <th>Auction Garage</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4">No records found.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
