@page "/auction/delete-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AuctionApiService AuctionService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>Delete Auction Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Auction
        </h1>
        <p class="page-description">Find a vehicle by GG number to delete auction entries.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/auction">Auction Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Delete Auction</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" placeholder="GG Number" @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="SearchAuctions" disabled="@_loading">
                    @(_loading ? "Loading..." : "Submit")
                </button>
                <a class="btn btn-secondary btn-sm" href="/auction">Menu</a>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Auction Entries</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Auction Number</th>
                        <th>Auction Garage</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="4">Loading auctions...</td>
                        </tr>
                    }
                    else if (_auctions.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _auctions)
                        {
                            <tr>
                                <td>@item.VehicleNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(item.AuctionNumber) ? "-" : item.AuctionNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.AuctionGarage) ? "-" : item.AuctionGarage)</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteAuction(item)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _searchQuery = "";
    private bool _loading;
    private List<AuctionRow> _auctions = new();
    private List<AuctionRow> _allAuctions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAuctions();
    }

    private async Task LoadAuctions()
    {
        _loading = true;
        try
        {
            var apiItems = await AuctionService.GetAllAsync<AuctionDto>();
            _allAuctions = apiItems.Select(a => new AuctionRow(
                AuctionCode: a.auction_code,
                VmfCode: a.vmf_code,
                AuctionNumber: a.auction_number,
                AuctionGarage: a.camp ?? a.auction_garage?.ToString(),
                VehicleNumber: a.vmf_code.ToString()
            )).ToList();
            _auctions = new List<AuctionRow>(_allAuctions);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading auctions: {ex.Message}");
            _auctions = new();
            _allAuctions = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAuctions()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _auctions = new List<AuctionRow>(_allAuctions);
            return;
        }

        var matches = await VehicleService.SearchVehiclesAsync(_searchQuery.Trim());
        if (matches.Count == 0)
        {
            _auctions = new();
            return;
        }

        var vmfCodes = matches.Select(v => v.vmf_code).ToHashSet();
        _auctions = _allAuctions.Where(a => vmfCodes.Contains(a.VmfCode)).ToList();
    }

    private async Task DeleteAuction(AuctionRow item)
    {
        _loading = true;
        try
        {
            await AuctionService.DeleteAsync(item.AuctionCode);
            _allAuctions.RemoveAll(a => a.AuctionCode == item.AuctionCode);
            _auctions.RemoveAll(a => a.AuctionCode == item.AuctionCode);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error deleting auction: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record AuctionRow(
        short AuctionCode,
        int VmfCode,
        string? AuctionNumber,
        string? AuctionGarage,
        string VehicleNumber
    );
}
