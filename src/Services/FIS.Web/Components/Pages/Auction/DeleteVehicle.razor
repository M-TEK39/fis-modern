@page "/auction/delete-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AuctionApiService AuctionService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>Delete Auction Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Auction
        </h1>
        <p class="page-description">Find a vehicle by GG number to delete auction entries.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/auction">Auction Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Delete Auction</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="auctionNumberType" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="auctionNumberType" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" placeholder="@(_searchType == "GG" ? "GG Number" : "GP Number")" @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="SearchAuctions" disabled="@_loading">
                    @(_loading ? "Loading..." : "Submit")
                </button>
                <a class="btn btn-secondary btn-sm" href="/auction">Menu</a>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Auction Entries</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Auction Number</th>
                        <th>Auction Garage</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="4">Loading auctions...</td>
                        </tr>
                    }
                    else if (_auctions.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedAuctions)
                        {
                            <tr>
                                <td>@item.VehicleNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(item.AuctionNumber) ? "-" : item.AuctionNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.AuctionGarage) ? "-" : item.AuctionGarage)</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteAuction(item)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_auctions.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_auctions.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private string _searchQuery = "";
    private string _searchType = "GG";
    private bool _loading;
    private List<AuctionRow> _auctions = new();
    private List<AuctionRow> _allAuctions = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<AuctionRow> PagedAuctions => _auctions.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_auctions.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadAuctions();
    }

    private async Task LoadAuctions()
    {
        _loading = true;
        try
        {
            var apiItems = await AuctionService.GetAllAsync<AuctionDto>();
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            var vehicleMap = vehicles.Data
                .GroupBy(v => v.vmf_code)
                .ToDictionary(g => g.Key, g => g.First());
            _allAuctions = apiItems.Select(a => new AuctionRow(
                AuctionCode: a.auction_code,
                VmfCode: a.vmf_code,
                AuctionNumber: a.auction_number,
                AuctionGarage: a.camp ?? a.auction_garage?.ToString(),
                FleetNumber: vehicleMap.TryGetValue(a.vmf_code, out var vehicle) ? vehicle.fleet_number : null,
                RegistrationNumber: vehicleMap.TryGetValue(a.vmf_code, out vehicle) ? vehicle.registration_number : null,
                VehicleNumber: vehicleMap.TryGetValue(a.vmf_code, out vehicle) ? FormatVehicleLabel(vehicle) : a.vmf_code.ToString()
            )).ToList();
            _auctions = new List<AuctionRow>(_allAuctions);
            _page = 1;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading auctions: {ex.Message}");
            _auctions = new();
            _allAuctions = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAuctions()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _auctions = new List<AuctionRow>(_allAuctions);
            _page = 1;
            return;
        }

        var searchTerm = _searchQuery.Trim();
        var matches = await VehicleService.SearchVehiclesAsync(searchTerm);
        matches = RankVehicleMatches(matches, searchTerm, _searchType);
        if (matches.Count == 0)
        {
            _auctions = new();
            _page = 1;
            return;
        }

        var vmfCodes = matches.Select(v => v.vmf_code).ToHashSet();
        _auctions = _allAuctions.Where(a => vmfCodes.Contains(a.VmfCode)).ToList();
        _page = 1;
    }

    private async Task DeleteAuction(AuctionRow item)
    {
        _loading = true;
        try
        {
            await AuctionService.DeleteAsync(item.AuctionCode);
            _allAuctions.RemoveAll(a => a.AuctionCode == item.AuctionCode);
            _auctions.RemoveAll(a => a.AuctionCode == item.AuctionCode);
            if (_page > TotalPages)
            {
                _page = TotalPages;
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error deleting auction: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string searchTerm, string searchType)
    {
        var isGp = string.Equals(searchType, "GP", StringComparison.OrdinalIgnoreCase);
        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), searchTerm, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), searchTerm, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchType(string value)
    {
        _searchType = value;
        _auctions = new List<AuctionRow>(_allAuctions);
        _page = 1;
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record AuctionRow(
        short AuctionCode,
        int VmfCode,
        string? AuctionNumber,
        string? AuctionGarage,
        string? FleetNumber,
        string? RegistrationNumber,
        string VehicleNumber
    );
}
