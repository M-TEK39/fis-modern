@page "/auction/help"
@rendermode InteractiveServer

<PageTitle>Auction Help - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Auction Maintenance Information
        </h1>
        <p class="page-description">Legacy auction maintenance help content.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/auction">Auction Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Help Document</h2>
            <p>Open the legacy auction maintenance help document.</p>
        </div>
        <div class="form-card-body">
            <a class="btn btn-primary" href="/legacy/auction/Doc_Auctions.htm">
                <i class="bx bx-file"></i>
                Open Auction Help
            </a>
        </div>
    </div>
</div>
