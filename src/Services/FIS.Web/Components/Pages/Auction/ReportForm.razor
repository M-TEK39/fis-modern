@page "/auction/reports/{Mode}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@inject FinanceApiService FinanceService
@inject VehicleApiService VehicleService

<PageTitle>@PageTitleText - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file-blank"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Auction report parameters and output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/auction/reports">Reports Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@PageTitleText</h2>
        </div>
        <div class="form-card-body">
            @if (Mode == "one-vehicle")
            {
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Number Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="auctionNumberType" checked="@(_numberType == "GP")" @onchange='() => SetNumberType("GP")' />
                                GP
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="auctionNumberType" checked="@(_numberType == "GG")" @onchange='() => SetNumberType("GG")' />
                                GG
                            </label>
                            <div class="fis-input-group-compact">
                                <input class="form-input compact-search-input-sm" @bind="_vehicleSearchTerm" placeholder="@(_numberType == "GG" ? "Enter GG number" : "Enter GP number")" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync" disabled="@_running">Find</button>
                            </div>
                            <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunReportAsync" disabled="@_running">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/auction/reports">Menu</a>
                </div>
            }
            else if (Mode == "all-vehicles")
            {
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Garage</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" checked />
                                JHB
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" />
                                PTA
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" />
                                ALL
                            </label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Auction Number</label>
                        <input class="form-input" placeholder="e.g. 2003/03" />
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunReportAsync" disabled="@_running">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/auction/reports">Menu</a>
                </div>
            }
            else if (Mode == "sale-to-name")
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Buyer Name</label>
                        <input class="form-input" placeholder="Buyer Name" />
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunReportAsync" disabled="@_running">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/auction/reports">Menu</a>
                </div>
            }
            else if (Mode == "auction-gg" || Mode == "auction-lot")
            {
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Garage</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" checked />
                                JHB
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" />
                                PTA
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="auctionGarage" />
                                ALL
                            </label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Auction Number</label>
                        <input class="form-input" placeholder="e.g. 2003/03" />
                    </div>
                </div>
                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm" @onclick="RunReportAsync" disabled="@_running">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/auction/reports">Menu</a>
                </div>
            }
            else
            {
                <p>Invalid report mode.</p>
            }

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert @(_statusError ? "alert-error" : "alert-success") fis-mt-1">
                    @_statusMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Mode { get; set; } = string.Empty;
    private bool _running;
    private bool _statusError;
    private string _statusMessage = string.Empty;
    private string _numberType = "GG";
    private string _vehicleSearchTerm = string.Empty;
    private List<VehicleDto> _vehicleMatches = new();
    private int? _selectedVehicleVmfCode;

    private void SetNumberType(string value)
    {
        _numberType = value;
        _vehicleSearchTerm = string.Empty;
        _vehicleMatches = new();
        _selectedVehicleVmfCode = null;
    }

    private async Task RunReportAsync()
    {
        _running = true;
        _statusMessage = string.Empty;

        var endpoint = Mode switch
        {
            "one-vehicle" => "api/auction/reports/one-vehicle",
            "all-vehicles" => "api/auction/reports/all-vehicles",
            "sale-to-name" => "api/auction/reports/sale-to-name",
            "auction-gg" => "api/auction/reports/auction-gg",
            "auction-lot" => "api/auction/reports/auction-lot",
            _ => "api/auction/reports"
        };

        var result = await FinanceService.PostActionAsync(endpoint, new
        {
            mode = Mode,
            numberType = _numberType,
            vehicleIdentifier = string.IsNullOrWhiteSpace(_vehicleSearchTerm) ? null : _vehicleSearchTerm.Trim(),
            vmfCode = _selectedVehicleVmfCode,
            legacyPath = LegacyPathText
        });

        _statusError = !result.Success;
        _statusMessage = result.Message;
        _running = false;
    }

    private async Task SearchVehiclesAsync()
    {
        if (Mode != "one-vehicle")
        {
            return;
        }

        var query = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = RankVehicleMatches(matches, query, _numberType);
            if (_vehicleMatches.All(v => v.vmf_code != _selectedVehicleVmfCode))
            {
                _selectedVehicleVmfCode = null;
            }
        }
        catch (Exception)
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _statusError = true;
            _statusMessage = "Unable to search vehicles.";
        }
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string PageTitleText => Mode switch
    {
        "one-vehicle" => "Auction Report on ONE Vehicle",
        "all-vehicles" => "Auction Report on ALL Vehicles",
        "sale-to-name" => "Auction Report on Sale to Name",
        "auction-gg" => "Auction Report - Sort by GG Number",
        "auction-lot" => "Auction Report - Sort by LOT Number",
        _ => "Auction Report"
    };

    private string LegacyPathText => Mode switch
    {
        "one-vehicle" => "Auction/RPT_one_num_main_auction.htm",
        "all-vehicles" => "Auction all vehicles report workflow",
        "sale-to-name" => "Auction sale-to-name report workflow",
        "auction-gg" => "Auction GG-sorted report workflow",
        "auction-lot" => "Auction lot-sorted report workflow",
        _ => "Auction report workflow"
    };
}
