@page "/reference-data"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Pages.ReferenceData

<PageTitle>Reference Data Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-data"></i>
            Reference Data Management
        </h1>
        <p class="page-description">Manage vehicle makes, types, and fuel types</p>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "types" ? "active" : "")" @onclick='() => SetActiveTab("types")'>
            <i class="bx bx-category"></i>
            Vehicle Types
        </button>
        <button class="tab @(_activeTab == "fueltypes" ? "active" : "")" @onclick='() => SetActiveTab("fueltypes")'>
            <i class="bx bx-gas-pump"></i>
            Fuel Types
        </button>
        <button class="tab @(_activeTab == "units" ? "active" : "")" @onclick='() => SetActiveTab("units")'>
            <i class="bx bx-ruler"></i>
            Units of Measure
        </button>
        <button class="tab @(_activeTab == "licenses" ? "active" : "")" @onclick='() => SetActiveTab("licenses")'>
            <i class="bx bx-id-card"></i>
            License Types
        </button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "types")
        {
            <TypesTab />
        }
        else if (_activeTab == "fueltypes")
        {
            <FuelTypesTab />
        }
        else if (_activeTab == "units")
        {
            <UnitOfMeasureTab />
        }
        else if (_activeTab == "licenses")
        {
            <LicenseTypesTab />
        }
    </div>

    <DataPreviewTable Title="Validation Data Preview"
                      SearchPlaceholder="Search validation area, category, route..."
                      EmptyMessage="No validation data categories match the current search or filter."
                      EmptyIcon="bx bx-check-shield"
                      IsLoading="false"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>
@code {
    private string _activeTab = "types";
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("category", "Category"),
        new("area", "Validation Area"),
        new("route", "Route")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Vehicle validation", "category", "Vehicle"),
        new("Organisation validation", "category", "Organisation"),
        new("Licence validation", "category", "Licence"),
        new("Operational validation", "category", "Operational")
    ];

    private readonly IReadOnlyList<Dictionary<string, string?>> _rows =
    [
        Row("Vehicle", "Vehicle Types", "/reference-data?tab=types"),
        Row("Vehicle", "Fuel Types", "/reference-data?tab=fueltypes"),
        Row("Operational", "Units of Measure", "/reference-data?tab=units"),
        Row("Licence", "License Types", "/reference-data?tab=licenses"),
    ];

    protected override void OnParametersSet()
    {
        var requested = string.IsNullOrWhiteSpace(Tab)
            ? ""
            : Tab.Trim().ToLowerInvariant();

        var allowed = new HashSet<string>
        {
            "types", "fueltypes", "units", "licenses"
        };

        if (allowed.Contains(requested))
        {
            _activeTab = requested;
        }
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private static Dictionary<string, string?> Row(string category, string area, string route)
    {
        return new Dictionary<string, string?>
        {
            ["category"] = category,
            ["area"] = area,
            ["route"] = route,
            ["_href"] = route
        };
    }
}
