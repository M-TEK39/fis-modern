@page "/reference-data"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Components.Shared
@inject ReferenceDataApiService RefDataService
@inject DepartmentApiService DepartmentService

<PageTitle>Reference Data Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-data"></i>
            Reference Data Management
        </h1>
        <p class="page-description">Manage vehicle makes, models, types, and fuel types</p>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "makes" ? "active" : "")" @onclick='() => SetActiveTab("makes")'>
            <i class="bx bx-car"></i>
            Vehicle Makes
        </button>
        <button class="tab @(_activeTab == "types" ? "active" : "")" @onclick='() => SetActiveTab("types")'>
            <i class="bx bx-category"></i>
            Vehicle Types
        </button>
        <button class="tab @(_activeTab == "fueltypes" ? "active" : "")" @onclick='() => SetActiveTab("fueltypes")'>
            <i class="bx bx-gas-pump"></i>
            Fuel Types
        </button>
        <button class="tab @(_activeTab == "classes" ? "active" : "")" @onclick='() => SetActiveTab("classes")'>
            <i class="bx bx-layer"></i>
            Vehicle Classes
        </button>
        <button class="tab @(_activeTab == "units" ? "active" : "")" @onclick='() => SetActiveTab("units")'>
            <i class="bx bx-ruler"></i>
            Units of Measure
        </button>
        <button class="tab @(_activeTab == "licenses" ? "active" : "")" @onclick='() => SetActiveTab("licenses")'>
            <i class="bx bx-id-card"></i>
            License Types
        </button>
        <button class="tab @(_activeTab == "models" ? "active" : "")" @onclick='() => SetActiveTab("models")'>
            <i class="bx bx-cog"></i>
            Vehicle Models
        </button>
        <button class="tab @(_activeTab == "departments" ? "active" : "")" @onclick='() => SetActiveTab("departments")'>
            <i class="bx bx-buildings"></i>
            Departments
        </button>
        <button class="tab @(_activeTab == "sites" ? "active" : "")" @onclick='() => SetActiveTab("sites")'>
            <i class="bx bx-map-pin"></i>
            Sites
        </button>
        <button class="tab @(_activeTab == "licensefees" ? "active" : "")" @onclick='() => SetActiveTab("licensefees")'>
            <i class="bx bx-dollar-circle"></i>
            License Fees
        </button>
        <button class="tab @(_activeTab == "driverlicenses" ? "active" : "")" @onclick='() => SetActiveTab("driverlicenses")'>
            <i class="bx bx-id-card"></i>
            Drivers Licenses
        </button>
        <button class="tab @(_activeTab == "extras" ? "active" : "")" @onclick='() => SetActiveTab("extras")'>
            <i class="bx bx-plus-circle"></i>
            Extras
        </button>
        <button class="tab @(_activeTab == "losstypes" ? "active" : "")" @onclick='() => SetActiveTab("losstypes")'>
            <i class="bx bx-error-circle"></i>
            Loss Types
        </button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "makes")
        {
            <MakesTab />
        }
        else if (_activeTab == "types")
        {
            <TypesTab />
        }
        else if (_activeTab == "fueltypes")
        {
            <FuelTypesTab />
        }
        else if (_activeTab == "classes")
        {
            <ClassesTab />
        }
        else if (_activeTab == "units")
        {
            <UnitOfMeasureTab />
        }
        else if (_activeTab == "licenses")
        {
            <LicenseTypesTab />
        }
        else if (_activeTab == "models")
        {
            <ModelsTab />
        }
        else if (_activeTab == "departments")
        {
            <DepartmentsTab />
        }
        else if (_activeTab == "sites")
        {
            <SitesTab />
        }
        else if (_activeTab == "licensefees")
        {
            <LicenseFeesTab />
        }
        else if (_activeTab == "driverlicenses")
        {
            <DriverLicensesTab />
        }
        else if (_activeTab == "extras")
        {
            <ExtrasTab />
        }
        else if (_activeTab == "losstypes")
        {
            <LossTypesTab />
        }
    </div>
</div>


    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNTValidation.aspx"
        Endpoint="api/validation/menu"
        HttpMethod="GET"
        ButtonText="Test Validation Menu Endpoint"
        ReportType="validation-menu" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/Doc/Doc_ValidationData.htm"
        Endpoint="api/validation/help"
        HttpMethod="GET"
        ButtonText="Test Validation Help Endpoint"
        ReportType="validation-help" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNT_Make.aspx"
        Endpoint="api/make"
        HttpMethod="GET"
        ButtonText="Test Make Reference Endpoint"
        ReportType="validation-make" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNT_Model.aspx"
        Endpoint="api/model"
        HttpMethod="GET"
        ButtonText="Test Model Reference Endpoint"
        ReportType="validation-model" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNT_Site.aspx"
        Endpoint="api/site"
        HttpMethod="GET"
        ButtonText="Test Site Reference Endpoint"
        ReportType="validation-site" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNT_Class.aspx"
        Endpoint="api/class"
        HttpMethod="GET"
        ButtonText="Test Class Reference Endpoint"
        ReportType="validation-class" />

    <LegacyEndpointActionPanel
        LegacyPath="Validation/MNT_DriversLicence.aspx"
        Endpoint="api/driverlicence"
        HttpMethod="GET"
        ButtonText="Test Driver Licence Reference Endpoint"
        ReportType="validation-driver-licence" />

@code {
    private string _activeTab = "makes";

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }
}
