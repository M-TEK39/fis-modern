@page "/reference-data"
@page "/Validation/MNT_Licence_Fees.aspx"
@page "/Validation/MNT_Licence_Fee_Add.aspx"
@page "/Validation/MNT_Licence_Fee_Edit.aspx"
@page "/Validation/MNT_Licence_Fee_Update.aspx"
@page "/Validation/MNT_DriversLicence.aspx"
@page "/Validation/MNT_Driverslicence_Add.aspx"
@page "/Validation/MNT_DriversLicence_Edit.aspx"
@page "/Validation/MNT_DriverLicence_Update.aspx"
@page "/Validation/MNT_extras.aspx"
@page "/Validation/MNT_Loss_Type.aspx"
@page "/Validation/MNT_Loss_Type_Add.aspx"
@page "/Validation/MNT_Loss_Type_Edit.aspx"
@page "/Validation/MNT_Loss_Type_Update.aspx"
@page "/Validation/MNT_Loss_Type_Del.aspx"
@page "/Validation/MNT_Loss_Type_Del_Check.aspx"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Pages.ReferenceData
@inject NavigationManager Navigation

<PageTitle>Reference Data Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-data"></i>
            Reference Data Management
        </h1>
        <p class="page-description">Manage vehicle makes, types, and fuel types</p>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "types" ? "active" : "")" @onclick='() => SetActiveTab("types")'>
            <i class="bx bx-category"></i>
            Vehicle Types
        </button>
        <button class="tab @(_activeTab == "fueltypes" ? "active" : "")" @onclick='() => SetActiveTab("fueltypes")'>
            <i class="bx bx-gas-pump"></i>
            Fuel Types
        </button>
        <button class="tab @(_activeTab == "units" ? "active" : "")" @onclick='() => SetActiveTab("units")'>
            <i class="bx bx-ruler"></i>
            Units of Measure
        </button>
        <button class="tab @(_activeTab == "licenses" ? "active" : "")" @onclick='() => SetActiveTab("licenses")'>
            <i class="bx bx-id-card"></i>
            License Types
        </button>
        <button class="tab @(_activeTab == "licensefees" ? "active" : "")" @onclick='() => SetActiveTab("licensefees")'>
            <i class="bx bx-dollar-circle"></i>
            License Fees
        </button>
        <button class="tab @(_activeTab == "driverlicenses" ? "active" : "")" @onclick='() => SetActiveTab("driverlicenses")'>
            <i class="bx bx-id-card"></i>
            Drivers Licenses
        </button>
        <button class="tab @(_activeTab == "extras" ? "active" : "")" @onclick='() => SetActiveTab("extras")'>
            <i class="bx bx-plus-circle"></i>
            Extras
        </button>
        <button class="tab @(_activeTab == "losstypes" ? "active" : "")" @onclick='() => SetActiveTab("losstypes")'>
            <i class="bx bx-error-circle"></i>
            Loss Types
        </button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "types")
        {
            <TypesTab />
        }
        else if (_activeTab == "fueltypes")
        {
            <FuelTypesTab />
        }
        else if (_activeTab == "units")
        {
            <UnitOfMeasureTab />
        }
        else if (_activeTab == "licenses")
        {
            <LicenseTypesTab />
        }
        else if (_activeTab == "licensefees")
        {
            <LicenseFeesTab />
        }
        else if (_activeTab == "driverlicenses")
        {
            <DriverLicensesTab />
        }
        else if (_activeTab == "extras")
        {
            <ExtrasTab />
        }
        else if (_activeTab == "losstypes")
        {
            <LossTypesTab />
        }
    </div>

    <DataPreviewTable Title="Validation Data Preview"
                      SearchPlaceholder="Search validation area, category, route..."
                      EmptyMessage="No validation data categories match the current search or filter."
                      EmptyIcon="bx bx-check-shield"
                      IsLoading="false"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>
@code {
    private string _activeTab = "types";
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("category", "Category"),
        new("area", "Validation Area"),
        new("route", "Route")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Vehicle validation", "category", "Vehicle"),
        new("Organisation validation", "category", "Organisation"),
        new("Licence validation", "category", "Licence"),
        new("Operational validation", "category", "Operational")
    ];

    private readonly IReadOnlyList<Dictionary<string, string?>> _rows =
    [
        Row("Vehicle", "Vehicle Types", "/reference-data?tab=types"),
        Row("Vehicle", "Fuel Types", "/reference-data?tab=fueltypes"),
        Row("Operational", "Units of Measure", "/reference-data?tab=units"),
        Row("Licence", "License Types", "/reference-data?tab=licenses"),
        Row("Licence", "License Fees", "/reference-data?tab=licensefees"),
        Row("Licence", "Drivers Licenses", "/reference-data?tab=driverlicenses"),
        Row("Vehicle", "Extras", "/reference-data?tab=extras"),
        Row("Operational", "Loss Types", "/reference-data?tab=losstypes")
    ];

    protected override void OnParametersSet()
    {
        var requested = string.IsNullOrWhiteSpace(Tab)
            ? ResolveLegacyTabFromPath()
            : Tab.Trim().ToLowerInvariant();

        var allowed = new HashSet<string>
        {
            "types", "fueltypes", "units", "licenses",
            "licensefees", "driverlicenses", "extras", "losstypes"
        };

        if (allowed.Contains(requested))
        {
            _activeTab = requested;
        }
    }

    private string ResolveLegacyTabFromPath()
    {
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "validation/mnt_licence_fees.aspx" => "licensefees",
            "validation/mnt_licence_fee_add.aspx" => "licensefees",
            "validation/mnt_licence_fee_edit.aspx" => "licensefees",
            "validation/mnt_licence_fee_update.aspx" => "licensefees",
            "validation/mnt_driverslicence.aspx" => "driverlicenses",
            "validation/mnt_driverslicence_add.aspx" => "driverlicenses",
            "validation/mnt_driverslicence_edit.aspx" => "driverlicenses",
            "validation/mnt_driverlicence_update.aspx" => "driverlicenses",
            "validation/mnt_extras.aspx" => "extras",
            "validation/mnt_loss_type.aspx" => "losstypes",
            "validation/mnt_loss_type_add.aspx" => "losstypes",
            "validation/mnt_loss_type_edit.aspx" => "losstypes",
            "validation/mnt_loss_type_update.aspx" => "losstypes",
            "validation/mnt_loss_type_del.aspx" => "losstypes",
            "validation/mnt_loss_type_del_check.aspx" => "losstypes",
            _ => string.Empty
        };
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private static Dictionary<string, string?> Row(string category, string area, string route)
    {
        return new Dictionary<string, string?>
        {
            ["category"] = category,
            ["area"] = area,
            ["route"] = route,
            ["_href"] = route
        };
    }
}
