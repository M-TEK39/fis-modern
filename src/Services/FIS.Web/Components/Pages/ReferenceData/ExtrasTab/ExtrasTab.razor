@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject ExtraCodeApiService ExtraService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading extras...</p>
    </div>
}
else if (_extras.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-plus-circle"></i>
        <h3>No extras found</h3>
        <p>Get started by adding your first extra</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Extra
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add Extra
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Extra Description</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var extra in _extras)
                    {
                        <tr>
                            <td>@extra.extra_description</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(extra)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showDialog)
{
    <Modal IsVisible="_showDialog"
           Title="Add Extra"
           OnCancel="HideDialog"
           OnSubmit="SaveExtra"
           SubmitText="Create"
           IsSaving="_saving"
           Model="_currentExtra">
        <div class="form-field">
            <label class="form-label">Extra Description <span class="required">*</span></label>
            <input type="text" class="form-input" @bind="_currentExtra.extra_description" />
            <ValidationMessage For="() => _currentExtra.extra_description" />
        </div>
    </Modal>
}

@if (_showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Confirm Delete</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@_currentExtra.extra_description</strong>?</p>
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideDeleteDialog" disabled="@_deleting">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteExtra" disabled="@_deleting">
                    @if (_deleting)
                    {
                        <span class="spinner-sm"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <i class="bx bx-trash"></i>
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ExtraCodeDto> _extras = new();
    private ExtraCodeDto _currentExtra = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _saving = false;
    private bool _deleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadExtras();
    }

    private async Task LoadExtras()
    {
        _loading = true;
        _extras = await ExtraService.GetAllAsync();
        _loading = false;
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentExtra = new ExtraCodeDto();
        _showDialog = true;
    }

    private void ShowDeleteDialog(ExtraCodeDto extra)
    {
        _currentExtra = extra;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentExtra = new ExtraCodeDto();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveExtra()
    {
        _saving = true;
        var success = await ExtraService.CreateAsync(_currentExtra);
        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadExtras();
        }
    }

    private async Task DeleteExtra()
    {
        _deleting = true;
        var success = await ExtraService.DeleteAsync(_currentExtra.extra_code);
        _deleting = false;

        if (success)
        {
            HideDeleteDialog();
            await LoadExtras();
        }
    }
}
