@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject DepartmentApiService DepartmentService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading departments...</p>
    </div>
}
else if (_departments.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-buildings"></i>
        <h3>No departments found</h3>
        <p>Get started by adding your first department</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Department
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add Department
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Contact</th>
                        <th>Telephone</th>
                        <th>Email</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in _departments)
                    {
                        <tr>
                            <td>@dept.department_description</td>
                            <td>@(dept.contact_person ?? "-")</td>
                            <td>@(dept.telephone ?? "-")</td>
                            <td>@(dept.net_address ?? "-")</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(dept)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(dept)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showDialog)
{
    <Modal IsVisible="_showDialog"
           Title="@(_isEdit ? "Edit Department" : "Add Department")"
           OnCancel="HideDialog"
           OnSubmit="SaveDepartment"
           SubmitText="@(_isEdit ? "Update" : "Create")"
           IsSaving="_saving"
           Size="Modal.ModalSize.Large"
           Model="_currentDept">
        <div class="form-section">
            <h4 class="form-section-title"><i class="bx bx-buildings"></i> Department Details</h4>
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <label class="form-label">Department Description <span class="required">*</span></label>
                    <input type="text" @bind="_currentDept.department_description" class="form-input" />
                    <ValidationMessage For="() => _currentDept.department_description" />
                </div>
                <div class="form-field">
                    <label class="form-label">Contact Person</label>
                    <input type="text" @bind="_currentDept.contact_person" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Department Number</label>
                    <input type="text" @bind="_currentDept.department_number" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Department Active</label>
                    <select class="form-input" @bind="_currentDept.dept_active">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Cell Number</label>
                    <input type="text" @bind="_currentDept.cell_number" class="form-input" />
                </div>
            </div>
        </div>
        <div class="form-section">
            <h4 class="form-section-title"><i class="bx bx-map"></i> Address</h4>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Address Line 1</label>
                    <input type="text" @bind="_currentDept.physical_address" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Address Line 2</label>
                    <input type="text" @bind="_currentDept.physical_address_line2" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Address Line 3</label>
                    <input type="text" @bind="_currentDept.physical_address_line3" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Code</label>
                    <input type="text" @bind="_currentDept.postal_code" class="form-input" />
                </div>
            </div>
        </div>
        <div class="form-section">
            <h4 class="form-section-title"><i class="bx bx-phone"></i> Contact</h4>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Telephone</label>
                    <input type="text" @bind="_currentDept.telephone" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Fax</label>
                    <input type="text" @bind="_currentDept.fax" class="form-input" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Email</label>
                    <input type="email" @bind="_currentDept.net_address" class="form-input" />
                </div>
            </div>
        </div>
        <div class="form-section">
            <h4 class="form-section-title"><i class="bx bx-note"></i> Notes</h4>
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <label class="form-label">Notes</label>
                    <textarea class="form-input" @bind="_currentDept.notes"></textarea>
                </div>
            </div>
        </div>
    </Modal>
}

@if (_showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Confirm Delete</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@_currentDept.department_description</strong>?</p>
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideDeleteDialog" disabled="@_deleting">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteDepartment" disabled="@_deleting">
                    @if (_deleting)
                    {
                        <span class="spinner-sm"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <i class="bx bx-trash"></i>
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartmentDto> _departments = new();
    private DepartmentDto _currentDept = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private bool _deleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
    }

    private async Task LoadDepartments()
    {
        _loading = true;
        _departments = await DepartmentService.GetDepartmentsAsync();
        _loading = false;
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentDept = new DepartmentDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(DepartmentDto dept)
    {
        _currentDept = dept with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(DepartmentDto dept)
    {
        _currentDept = dept;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentDept = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveDepartment()
    {
        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await DepartmentService.UpdateDepartmentAsync(_currentDept.department_code, _currentDept);
        }
        else
        {
            success = await DepartmentService.CreateDepartmentAsync(_currentDept);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadDepartments();
        }
    }

    private async Task DeleteDepartment()
    {
        _deleting = true;
        var success = await DepartmentService.DeleteDepartmentAsync(_currentDept.department_code);
        _deleting = false;

        if (success)
        {
            HideDeleteDialog();
            await LoadDepartments();
        }
    }
}
