@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject UnitOfMeasureApiService UnitService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading units of measure...</p>
    </div>
}
else if (_units.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-ruler"></i>
        <h3>No units found</h3>
        <p>Get started by adding your first unit of measure</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Unit
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add Unit
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Abbreviation</th>
                        <th>Category</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in PagedUnits)
                    {
                        <tr>
                            <td>@unit.unit_description</td>
                            <td>@(string.IsNullOrWhiteSpace(unit.unit_abbreviation) ? "-" : unit.unit_abbreviation)</td>
                            <td>@(string.IsNullOrWhiteSpace(unit.unit_category) ? "-" : unit.unit_category)</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(unit)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(unit)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-controls" style="margin-top: 1rem;">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    </div>
}

<Modal IsVisible="_showDialog"
       Title="@(_isEdit ? "Edit Unit of Measure" : "Add Unit of Measure")"
       OnCancel="HideDialog"
       OnSubmit="SaveUnit"
       IsSaving="_saving"
       Model="_currentUnit">
    <div class="form-field">
        <label class="form-label">Description <span class="required">*</span></label>
        <input type="text" class="form-input" @bind="_currentUnit.unit_description" placeholder="e.g., Kilometers" />
        <ValidationMessage For="() => _currentUnit.unit_description" />
    </div>
    <div class="form-field">
        <label class="form-label">Abbreviation</label>
        <input type="text" class="form-input" @bind="_currentUnit.unit_abbreviation" placeholder="e.g., km" />
    </div>
    <div class="form-field">
        <label class="form-label">Category</label>
        <input type="text" class="form-input" @bind="_currentUnit.unit_category" placeholder="e.g., Distance" />
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm"
                  Title="Confirm Delete"
                  OnCancel="HideDeleteDialog"
                  OnConfirm="DeleteUnit"
                  IsDeleting="false">
    <p>Are you sure you want to delete <strong>@_currentUnit.unit_description</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<UnitOfMeasureDto> _units = new();
    private UnitOfMeasureDto _currentUnit = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<UnitOfMeasureDto> PagedUnits => _units.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_units.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadUnits();
    }

    private async Task LoadUnits()
    {
        _loading = true;
        _units = await UnitService.GetAllAsync();
        _loading = false;
        _page = Math.Min(_page, TotalPages);
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentUnit = new UnitOfMeasureDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(UnitOfMeasureDto unit)
    {
        _currentUnit = unit with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(UnitOfMeasureDto unit)
    {
        _currentUnit = unit;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentUnit = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveUnit()
    {
        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await UnitService.UpdateAsync(_currentUnit.unit_of_measure_code, _currentUnit);
        }
        else
        {
            success = await UnitService.CreateAsync(_currentUnit);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadUnits();
        }
    }

    private async Task DeleteUnit()
    {
        var success = await UnitService.DeleteAsync(_currentUnit.unit_of_measure_code);

        if (success)
        {
            HideDeleteDialog();
            await LoadUnits();
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
