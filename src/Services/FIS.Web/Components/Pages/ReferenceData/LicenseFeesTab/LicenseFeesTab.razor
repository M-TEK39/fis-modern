@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject LicenseFeeApiService LicenseFeeService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading license fees...</p>
    </div>
}
else if (_fees.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-dollar-circle"></i>
        <h3>No license fees found</h3>
        <p>Get started by adding your first license fee</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add License Fee
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add License Fee
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>License Description</th>
                        <th>Yearly Tariff</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fee in PagedFees)
                    {
                        <tr>
                            <td>@fee.licence_description</td>
                            <td>@(fee.licence_fee?.ToString("0.00") ?? "-")</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(fee)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(fee)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-controls fis-mt-1">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    </div>
}

@if (_showDialog)
{
    <Modal IsVisible="_showDialog"
           Title="@(_isEdit ? "Edit License Fee" : "Add License Fee")"
           OnCancel="HideDialog"
           OnSubmit="SaveFee"
           SubmitText="@(_isEdit ? "Update" : "Create")"
           IsSaving="_saving"
           Model="_currentFee">
        <div class="form-field">
            <label class="form-label">License Description <span class="required">*</span></label>
            <input type="text" class="form-input" @bind="_currentFee.licence_description" />
            <ValidationMessage For="() => _currentFee.licence_description" />
        </div>
        <div class="form-field">
            <label class="form-label">Yearly Tariff</label>
            <input type="number" step="0.01" class="form-input" @bind="_currentFee.licence_fee" />
        </div>
    </Modal>
}

@if (_showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>Confirm Delete</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@_currentFee.licence_description</strong>?</p>
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideDeleteDialog" disabled="@_deleting">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteFee" disabled="@_deleting">
                    @if (_deleting)
                    {
                        <span class="spinner-sm"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <i class="bx bx-trash"></i>
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<LicenseFeeDto> _fees = new();
    private LicenseFeeDto _currentFee = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private bool _deleting = false;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<LicenseFeeDto> PagedFees => _fees.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_fees.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadFees();
    }

    private async Task LoadFees()
    {
        _loading = true;
        _fees = await LicenseFeeService.GetAllAsync();
        _loading = false;
        _page = Math.Min(_page, TotalPages);
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentFee = new LicenseFeeDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(LicenseFeeDto fee)
    {
        _currentFee = fee with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(LicenseFeeDto fee)
    {
        _currentFee = fee;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentFee = new LicenseFeeDto();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveFee()
    {
        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await LicenseFeeService.UpdateAsync(_currentFee.licence_fee_code, _currentFee);
        }
        else
        {
            success = await LicenseFeeService.CreateAsync(_currentFee);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadFees();
        }
    }

    private async Task DeleteFee()
    {
        _deleting = true;
        var success = await LicenseFeeService.DeleteAsync(_currentFee.licence_fee_code);
        _deleting = false;

        if (success)
        {
            HideDeleteDialog();
            await LoadFees();
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
