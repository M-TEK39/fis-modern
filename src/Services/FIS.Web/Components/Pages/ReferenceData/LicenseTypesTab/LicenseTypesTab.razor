@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject LicenseApiService LicenseService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading license types...</p>
    </div>
}
else if (_licenses.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-id-card"></i>
        <h3>No license types found</h3>
        <p>Get started by adding your first license type</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add License Type
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add License Type
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Category</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var license in PagedLicenses)
                    {
                        <tr>
                            <td>@license.licence_description</td>
                            <td>@(string.IsNullOrWhiteSpace(license.licence_category) ? "-" : license.licence_category)</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(license)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(license)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-controls fis-mt-1">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    </div>
}

<Modal IsVisible="_showDialog"
       Title="@(_isEdit ? "Edit License Type" : "Add License Type")"
       OnCancel="HideDialog"
       OnSubmit="SaveLicense"
       IsSaving="_saving"
       Model="_currentLicense">
    <div class="form-field">
        <label class="form-label">Description <span class="required">*</span></label>
        <input type="text" class="form-input" @bind="_currentLicense.licence_description" placeholder="e.g., Commercial License" />
        <ValidationMessage For="() => _currentLicense.licence_description" />
    </div>
    <div class="form-field">
        <label class="form-label">Category</label>
        <input type="text" class="form-input" @bind="_currentLicense.licence_category" placeholder="e.g., Code 10" />
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm"
                  Title="Confirm Delete"
                  OnCancel="HideDeleteDialog"
                  OnConfirm="DeleteLicense"
                  IsDeleting="false">
    <p>Are you sure you want to delete <strong>@_currentLicense.licence_description</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<LicenseTypeDto> _licenses = new();
    private LicenseTypeDto _currentLicense = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<LicenseTypeDto> PagedLicenses => _licenses.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_licenses.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLicenses();
    }

    private async Task LoadLicenses()
    {
        _loading = true;
        _licenses = await LicenseService.GetAllAsync();
        _loading = false;
        _page = Math.Min(_page, TotalPages);
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentLicense = new LicenseTypeDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(LicenseTypeDto license)
    {
        _currentLicense = license with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(LicenseTypeDto license)
    {
        _currentLicense = license;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentLicense = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveLicense()
    {
        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await LicenseService.UpdateAsync(_currentLicense.licence_code, _currentLicense);
        }
        else
        {
            success = await LicenseService.CreateAsync(_currentLicense);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadLicenses();
        }
    }

    private async Task DeleteLicense()
    {
        var success = await LicenseService.DeleteAsync(_currentLicense.licence_code);

        if (success)
        {
            HideDeleteDialog();
            await LoadLicenses();
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
