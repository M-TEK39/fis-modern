@page "/Validation/ValidationMain.htm"
@page "/Validation/Doc/Doc_ValidationData.htm"
@page "/validation"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject ValidationApiService ValidationService
@inject IJSRuntime JSRuntime

<PageTitle>Validation Data - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-data"></i>
            Validation Data
        </h1>
        <p class="page-description">@(_help?.description ?? "Manage validation and reference data used across the system.")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/reference-data">Open Full Reference Data</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading validation menu...</p>
        </div>
    }
    else
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <button class="menu-tile-header">
                    <span>@(_help?.title ?? "Validation Data Management")</span>
                    <i class="bx bx-chevron-down"></i>
                </button>
                <div class="menu-tile-body">
                    @foreach (var option in _options)
                    {
                        <div class="menu-item">
                            <a class="menu-item-link" href="@GetRouteForOption(option)">@option</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_help?.sections?.Count > 0)
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Module Notes</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-grid">
                        @foreach (var helpSection in _help.sections)
                        {
                            <div class="form-field form-group-full">
                                <label class="form-label">@helpSection.title</label>
                                <p class="page-description">@helpSection.content</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private List<string> _options = new();
    private ValidationHelpResponse? _help;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var menu = await ValidationService.GetMenuAsync();
            _options = menu?.options ?? new List<string>();
            _help = await ValidationService.GetHelpAsync();
        }
        catch (Exception ex)
        {
            _options = new();
            _help = null;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading validation data menu: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetRouteForOption(string option)
    {
        return option.Trim().ToLowerInvariant() switch
        {
            "driver licence types" => "/reference-data?tab=driverlicenses",
            "licence fees" => "/reference-data?tab=licensefees",
            "extra codes" => "/reference-data?tab=extras",
            "loss types" => "/reference-data?tab=losstypes",
            "vehicle classes" => "/validation-data/classes",
            "fuel types" => "/reference-data?tab=fueltypes",
            "maintenance triggers" => "/validation-data/models",
            "sites" => "/validation-data/sites",
            _ => "/reference-data"
        };
    }
}
