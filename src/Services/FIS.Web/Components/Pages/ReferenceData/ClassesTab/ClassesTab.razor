@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject ClassApiService ClassService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading classes...</p>
    </div>
}
else if (_classes.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-layer"></i>
        <h3>No classes found</h3>
        <p>Get started by adding your first vehicle class</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Class
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add Class
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PagedClasses)
                    {
                        <tr>
                            <td>@item.class_description</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(item)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(item)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-controls fis-mt-1">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    </div>
}

<Modal IsVisible="_showDialog"
       Title="@(_isEdit ? "Edit Class" : "Add Class")"
       OnCancel="HideDialog"
       OnSubmit="SaveClass"
       IsSaving="_saving"
       Model="_currentClass">
    <div class="form-field">
        <label class="form-label">Class Name <span class="required">*</span></label>
        <input type="text" class="form-input" @bind="_currentClass.class_description" placeholder="e.g., Light Vehicle" />
        <ValidationMessage For="() => _currentClass.class_description" />
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm"
                  Title="Confirm Delete"
                  OnCancel="HideDeleteDialog"
                  OnConfirm="DeleteClass"
                  IsDeleting="false">
    <p>Are you sure you want to delete <strong>@_currentClass.class_description</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<ClassDto> _classes = new();
    private ClassDto _currentClass = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<ClassDto> PagedClasses => _classes.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_classes.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadClasses();
    }

    private async Task LoadClasses()
    {
        _loading = true;
        _classes = await ClassService.GetClassesAsync();
        _loading = false;
        _page = Math.Min(_page, TotalPages);
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _currentClass = new ClassDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(ClassDto item)
    {
        _currentClass = item with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(ClassDto item)
    {
        _currentClass = item;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentClass = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveClass()
    {
        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await ClassService.UpdateClassAsync(_currentClass.class_code, _currentClass);
        }
        else
        {
            success = await ClassService.CreateClassAsync(_currentClass);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadClasses();
        }
    }

    private async Task DeleteClass()
    {
        var success = await ClassService.DeleteClassAsync(_currentClass.class_code);

        if (success)
        {
            HideDeleteDialog();
            await LoadClasses();
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
