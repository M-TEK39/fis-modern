@namespace FIS.Web.Components.Pages.ReferenceData
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject ReferenceDataApiService RefDataService
@inject ClassApiService ClassService
@inject UnitOfMeasureApiService UnitOfMeasureService
@inject MaintenanceTriggerApiService MaintenanceTriggerService
@inject LicenseFeeApiService LicenseFeeService
@inject DriverLicenceApiService DriverLicenceService

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading models...</p>
    </div>
}
else if (_models.Count == 0)
{
    <div class="empty-state">
        <i class="bx bx-cog"></i>
        <h3>No models found</h3>
        <p>Get started by adding your first vehicle model</p>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Model
        </button>
    </div>
}
else
{
    <div class="table-container">
        <div class="table-header">
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus"></i>
                Add Model
            </button>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Model Name</th>
                        <th>Make</th>
                        <th>Type</th>
                        <th>Fuel Type</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var model in PagedModels)
                    {
                        <tr>
                            <td>@model.model_name</td>
                            <td>@GetMakeName(model)</td>
                            <td>@GetTypeName(model)</td>
                            <td>@GetFuelTypeName(model)</td>
                            <td class="actions-column">
                                <div class="table-actions">
                                    <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(model)" title="Edit">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(model)" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-controls fis-mt-1">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    </div>
}

<Modal IsVisible="_showDialog"
       Title="@(_isEdit ? "Edit Model" : "Add Model")"
       OnCancel="HideDialog"
       OnSubmit="SaveModel"
       IsSaving="_saving"
       DisableSubmit="@_modelPrereqsMissing"
       Model="_currentModel">
    @if (_modelPrereqsMissing)
    {
        <div class="warning-text fis-mb-1">
            Add at least one Make, Type, Fuel Type, Class, Unit of Measure, License Fee, and Driver License before creating a model.
        </div>
    }
    <div class="form-section">
        <h4 class="form-section-title"><i class="bx bx-car"></i> Core Details</h4>
        <div class="form-grid">
            <div class="form-field form-group-full">
                <label class="form-label">Model Description <span class="required">*</span></label>
                <input type="text" class="form-input" @bind="_currentModel.model_name" placeholder="e.g., Corolla" />
                <ValidationMessage For="() => _currentModel.model_name" />
            </div>
            <div class="form-field">
                <label class="form-label">Make <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.make_code">
                    <option value="">Select make</option>
                    @foreach (var make in _makes)
                    {
                        <option value="@make.make_code">@($"{make.make_name} ({make.make_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.make_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Vehicle Type <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.type_code">
                    <option value="">Select type</option>
                    @foreach (var type in _vehicleTypes)
                    {
                        <option value="@type.type_code">@($"{type.type_name} ({type.type_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.type_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Fuel Type <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.fuel_type_code">
                    <option value="">Select fuel type</option>
                    @foreach (var fuelType in _fuelTypes)
                    {
                        <option value="@fuelType.fuel_type_code">@($"{fuelType.fuel_type_name} ({fuelType.fuel_type_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.fuel_type_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Vehicle Class <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.class_code">
                    <option value="">Select class</option>
                    @foreach (var item in _classes)
                    {
                        <option value="@item.class_code">@($"{item.class_description} ({item.class_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.class_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Unit of Measure <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.unit_of_measure_code">
                    <option value="">Select unit</option>
                    @foreach (var item in _unitMeasures)
                    {
                        <option value="@item.unit_of_measure_code">@($"{item.unit_description} ({item.unit_of_measure_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.unit_of_measure_code" />
            </div>
            <div class="form-field">
                <label class="form-label">License Fee (Cost) <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.licence_fee_code">
                    <option value="">Select license fee</option>
                    @foreach (var item in _licenseFees)
                    {
                        <option value="@item.licence_fee_code">@($"{item.licence_description} ({item.licence_fee_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.licence_fee_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Driver License <span class="required">*</span></label>
                <select class="form-select" @bind="_currentModel.licence_code">
                    <option value="">Select license</option>
                    @foreach (var item in _driverLicences)
                    {
                        <option value="@item.licence_code">@($"{item.description} ({item.licence_code})")</option>
                    }
                </select>
                <ValidationMessage For="() => _currentModel.licence_code" />
            </div>
            <div class="form-field">
                <label class="form-label">Maintenance Trigger</label>
                <select class="form-select" @bind="_currentModel.maint_trigger_code">
                    <option value="">Select trigger</option>
                    @foreach (var trigger in _maintenanceTriggers)
                    {
                        <option value="@trigger.Id">@trigger.Description</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="form-section">
        <h4 class="form-section-title"><i class="bx bx-cog"></i> Engine & Performance</h4>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Engine Type</label>
                <input type="text" class="form-input" @bind="_currentModel.engine_type" />
            </div>
            <div class="form-field">
                <label class="form-label">Engine Capacity</label>
                <input type="number" class="form-input" @bind="_currentModel.engine_capacity" />
            </div>
            <div class="form-field">
                <label class="form-label">Rated Power (kW)</label>
                <input type="number" class="form-input" @bind="_currentModel.rated_power" />
            </div>
            <div class="form-field">
                <label class="form-label">Fuel Tank Capacity</label>
                <input type="number" class="form-input" @bind="_currentModel.fuel_tank_capacity" />
            </div>
            <div class="form-field">
                <label class="form-label">Target Consumption</label>
                <input type="number" step="0.01" class="form-input" @bind="_currentModel.target_consumption" />
            </div>
            <div class="form-field">
                <label class="form-label">Target Tyre Life</label>
                <input type="number" class="form-input" @bind="_currentModel.target_tyre_life" />
            </div>
            <div class="form-field">
                <label class="form-label">Service Interval</label>
                <input type="number" class="form-input" @bind="_currentModel.service_interval" />
            </div>
            <div class="form-field">
                <label class="form-label">VEMM ID</label>
                <input type="text" class="form-input" @bind="_currentModel.vemm_code" />
            </div>
            <div class="form-field">
                <label class="form-label">GVM</label>
                <input type="number" class="form-input" @bind="_currentModel.gvm" />
            </div>
            <div class="form-field">
                <label class="form-label">Transmission</label>
                <select class="form-select" @bind="_currentModel.transmission">
                    <option value="">Select</option>
                    <option value="M">Manual</option>
                    <option value="A">Automatic</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">Wesbank Kilos/Litre</label>
                <input type="number" step="0.01" class="form-input" @bind="_currentModel.wesbank_kilos_per_litre" />
            </div>
        </div>
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm"
                  Title="Confirm Delete"
                  OnCancel="HideDeleteDialog"
                  OnConfirm="DeleteModel"
                  IsDeleting="false">
    <p>Are you sure you want to delete <strong>@_currentModel.model_name</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<ModelDto> _models = new();
    private List<MakeDto> _makes = new();
    private List<VehicleTypeDto> _vehicleTypes = new();
    private List<FuelTypeDto> _fuelTypes = new();
    private List<ClassDto> _classes = new();
    private List<UnitOfMeasureDto> _unitMeasures = new();
    private List<MaintenanceTriggerDto> _maintenanceTriggers = new();
    private List<LicenseFeeDto> _licenseFees = new();
    private List<DriverLicenceDto> _driverLicences = new();
    private ModelDto _currentModel = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private bool _modelPrereqsMissing = false;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<ModelDto> PagedModels => _models.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_models.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadModels();
        await LoadReferenceData();
        UpdateModelPrereqs();
    }

    private async Task LoadModels()
    {
        _loading = true;
        _models = await RefDataService.GetModelsAsync();
        _loading = false;
        _page = Math.Min(_page, TotalPages);
        StateHasChanged();
    }

    private async Task LoadReferenceData()
    {
        _makes = await RefDataService.GetMakesAsync();
        _vehicleTypes = await RefDataService.GetTypesAsync();
        _fuelTypes = await RefDataService.GetFuelTypesAsync();
        _classes = await ClassService.GetClassesAsync();
        _unitMeasures = await UnitOfMeasureService.GetAllAsync();
        _maintenanceTriggers = await MaintenanceTriggerService.GetAllAsync();
        _licenseFees = await LicenseFeeService.GetAllAsync();
        _driverLicences = await DriverLicenceService.GetAllAsync();
        UpdateModelPrereqs();
        StateHasChanged();
    }

    private void UpdateModelPrereqs()
    {
        _modelPrereqsMissing = _makes.Count == 0
            || _vehicleTypes.Count == 0
            || _fuelTypes.Count == 0
            || _classes.Count == 0
            || _unitMeasures.Count == 0
            || _licenseFees.Count == 0
            || _driverLicences.Count == 0;
    }

    private void ShowAddDialog()
    {
        _currentModel = new ModelDto();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(ModelDto model)
    {
        _currentModel = model with { };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(ModelDto model)
    {
        _currentModel = model;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentModel = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveModel()
    {
        if (_modelPrereqsMissing)
        {
            return;
        }

        _saving = true;
        bool success;

        if (_isEdit)
        {
            success = await RefDataService.UpdateModelAsync(_currentModel.model_code, _currentModel);
        }
        else
        {
            success = await RefDataService.CreateModelAsync(_currentModel);
        }

        _saving = false;

        if (success)
        {
            HideDialog();
            await LoadModels();
        }
    }

    private async Task DeleteModel()
    {
        var success = await RefDataService.DeleteModelAsync(_currentModel.model_code);

        if (success)
        {
            HideDeleteDialog();
            await LoadModels();
        }
    }

    private string GetMakeName(ModelDto model)
    {
        if (!string.IsNullOrWhiteSpace(model.make_name))
        {
            return model.make_name;
        }

        var make = _makes.FirstOrDefault(m => m.make_code == model.make_code);
        return make?.make_name ?? "N/A";
    }

    private string GetTypeName(ModelDto model)
    {
        if (model.type_code == null)
        {
            return "N/A";
        }

        var type = _vehicleTypes.FirstOrDefault(t => t.type_code == model.type_code);
        return type?.type_name ?? "N/A";
    }

    private string GetFuelTypeName(ModelDto model)
    {
        if (model.fuel_type_code == null)
        {
            return "N/A";
        }

        var fuelType = _fuelTypes.FirstOrDefault(f => f.fuel_type_code == model.fuel_type_code);
        return fuelType?.fuel_type_name ?? "N/A";
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
