@page "/full-maintenance-lease/tariffs/details"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Lease Vehicle Capturing and Approval</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Lease Vehicle Capturing and Approval
        </h1>
        <p class="page-description">Lease vehicle tariff capture and approval details.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Vehicle Master Info</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Current GG Number</label>
                    <input class="form-input" type="text" value="@GG" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Current GP Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.CurrentGpNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Replaced GG Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.ReplacedGgNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Model</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Model" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Follow-up GG Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.FollowupGgNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Class</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Class" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Extended Service</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.ExtendedService" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Class Code</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.ClassCode" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Renumbered to GG Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.RenumberedTo" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Color</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Color" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Recovered (Stolen) GG Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.RecoveredGgNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Year Manufactured</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.YearManufactured" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Garage Location</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Location" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Date First Registered</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.FirstRegistered" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Hire Type</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.HireType" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Barcode</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Barcode" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Engine No</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.EngineNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Chassis No</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.ChassisNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Status</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.Status" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Tracker Number</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.TrackerNumber" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Status Date</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.StatusDate" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Installation Date</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.InstallationDate" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Hire From</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.HireFrom" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Captured By</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.CapturedBy" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Purchase From</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.PurchaseFrom" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Purchase Date</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.PurchaseDate" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Purchase Amount</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.PurchaseAmount" readonly />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Optional Extra's</label>
                    <input class="form-input" type="text" value="@_vehicleInfo.OptionalExtras" readonly />
                </div>
            </div>

            <div class="table-container" style="margin-top: 1.5rem;">
                <div class="table-header">
                    <span class="table-title">Notes</span>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date Updated</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_notes.Count == 0)
                            {
                                <tr>
                                    <td colspan="2">No notes found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var note in _notes)
                                {
                                    <tr>
                                        <td>@note.DateUpdated</td>
                                        <td>@note.Note</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card" style="margin-top: 1.5rem;">
        <div class="form-card-header">
            <h2>Terms and Tariffs for review (All fields marked with * are compulsory.)</h2>
        </div>
        <div class="form-card-body">
            <EditForm Model="_terms" OnValidSubmit="HandleSave">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Site <span class="required">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_terms.Site">
                            @foreach (var option in SiteOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date for Tariff <span class="required">*</span></label>
                        <InputDate class="form-input" @bind-Value="_terms.StartDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date for Tariff <span class="required">*</span></label>
                        <InputDate class="form-input" @bind-Value="_terms.EndDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Agreed Overall Kilo Term <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_terms.AgreedOverallKilo" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Agreed Term (months) <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_terms.AgreedTerms" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Agreed Kilo Terms (km/month)</label>
                        <div class="form-grid">
                            <div class="form-field">
                                <InputText class="form-input" @bind-Value="_terms.AgreedKilos" readonly />
                            </div>
                            <div class="form-field">
                                <button type="button" class="btn btn-secondary" @onclick="CalculateKilos">Calculate</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Applied Interest Rate (%)</label>
                        <InputText class="form-input" @bind-Value="_terms.AppliedInterest" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Fixed Monthly Tariff (R) <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_terms.FixedMonthlyAmount" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Excess Kilo Tariff (R) <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_terms.ExcessKiloTariff" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Relieve Vehicle</label>
                        <InputCheckbox class="form-input" @bind-Value="_terms.RelieveVehicle" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Comments</label>
                        <InputTextArea class="form-input" rows="3" @bind-Value="_terms.Comments" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="GoBack">Back</button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="form-card" style="margin-top: 1.5rem;">
        <div class="form-card-header">
            <h2>Authoriser Review</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <input class="form-input" type="text" value="@_terms.StartDate?.ToString("yyyy/MM/dd")" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <input class="form-input" type="text" value="@_terms.EndDate?.ToString("yyyy/MM/dd")" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Agreed Overall Kilo Term</label>
                    <input class="form-input" type="text" value="@_terms.AgreedOverallKilo" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Agreed Term</label>
                    <input class="form-input" type="text" value="@_terms.AgreedTerms" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Agreed Kilo Terms</label>
                    <input class="form-input" type="text" value="@_terms.AgreedKilos" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Applied Interest Rate</label>
                    <input class="form-input" type="text" value="@_terms.AppliedInterest" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Fixed Monthly Tariff</label>
                    <input class="form-input" type="text" value="@_terms.FixedMonthlyAmount" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Excess Kilo Tariff</label>
                    <input class="form-input" type="text" value="@_terms.ExcessKiloTariff" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Relieve Vehicle</label>
                    <input class="form-input" type="text" value="@(_terms.RelieveVehicle ? "Yes" : "No")" readonly />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Comments</label>
                    <textarea class="form-input" rows="3" readonly>@_terms.Comments</textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Accept">Accept</button>
                <button class="btn btn-secondary" @onclick="Reject">Reject</button>
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </div>
    </div>

    <div class="table-container" style="margin-top: 1.5rem;">
        <div class="table-header">
            <span class="table-title">Comment History</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Date Updated</th>
                        <th>Status</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_commentHistory.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No comments recorded.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _commentHistory)
                        {
                            <tr>
                                <td>@item.User</td>
                                <td>@item.DateUpdated</td>
                                <td>@item.Status</td>
                                <td>@item.Comment</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "gg")]
    public string? GG { get; set; }

    private readonly VehicleInfo _vehicleInfo = new();
    private readonly List<NoteItem> _notes = new();
    private readonly List<CommentHistoryItem> _commentHistory = new();
    private readonly TermsForm _terms = new();

    private readonly List<string> SiteOptions = new()
    {
        "Select...",
        "Site A",
        "Site B"
    };

    private void CalculateKilos()
    {
        if (decimal.TryParse(_terms.AgreedOverallKilo, out var overall) &&
            decimal.TryParse(_terms.AgreedTerms, out var terms) &&
            terms > 0)
        {
            var result = overall / terms;
            _terms.AgreedKilos = Math.Round(result, 2).ToString("0.##");
        }
    }

    private void HandleSave()
    {
        // Placeholder for save.
    }

    private void Accept()
    {
        // Placeholder for accept.
    }

    private void Reject()
    {
        // Placeholder for reject.
    }

    private void Cancel()
    {
        GoBack();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/full-maintenance-lease/tariffs");
    }

    private sealed class VehicleInfo
    {
        public string CurrentGpNumber { get; set; } = "";
        public string ReplacedGgNumber { get; set; } = "";
        public string Model { get; set; } = "";
        public string FollowupGgNumber { get; set; } = "";
        public string Class { get; set; } = "";
        public string ExtendedService { get; set; } = "";
        public string ClassCode { get; set; } = "";
        public string RenumberedTo { get; set; } = "";
        public string Color { get; set; } = "";
        public string RecoveredGgNumber { get; set; } = "";
        public string YearManufactured { get; set; } = "";
        public string Location { get; set; } = "";
        public string FirstRegistered { get; set; } = "";
        public string HireType { get; set; } = "";
        public string Barcode { get; set; } = "";
        public string EngineNumber { get; set; } = "";
        public string ChassisNumber { get; set; } = "";
        public string Status { get; set; } = "";
        public string TrackerNumber { get; set; } = "";
        public string StatusDate { get; set; } = "";
        public string InstallationDate { get; set; } = "";
        public string HireFrom { get; set; } = "";
        public string CapturedBy { get; set; } = "";
        public string PurchaseFrom { get; set; } = "";
        public string PurchaseDate { get; set; } = "";
        public string PurchaseAmount { get; set; } = "";
        public string OptionalExtras { get; set; } = "";
    }

    private sealed class NoteItem
    {
        public string DateUpdated { get; set; } = "";
        public string Note { get; set; } = "";
    }

    private sealed class CommentHistoryItem
    {
        public string User { get; set; } = "";
        public string DateUpdated { get; set; } = "";
        public string Status { get; set; } = "";
        public string Comment { get; set; } = "";
    }

    private sealed class TermsForm
    {
        public string Site { get; set; } = "Select...";
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? AgreedOverallKilo { get; set; }
        public string? AgreedTerms { get; set; }
        public string? AgreedKilos { get; set; }
        public string? AppliedInterest { get; set; }
        public string? FixedMonthlyAmount { get; set; }
        public string? ExcessKiloTariff { get; set; }
        public bool RelieveVehicle { get; set; }
        public string? Comments { get; set; }
    }
}
