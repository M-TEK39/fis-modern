@page "/full-maintenance-lease/add-lease"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject LeaseContractTermsApiService LeaseService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Add Lease Tariff for In Service Vehicles</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Add Lease Tariff for In Service Vehicles
        </h1>
        <p class="page-description">Capture a new lease tariff term for an in-service vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="alert alert-info fis-alert-tight">
        <i class="bx bx-info-circle"></i>
        <span>Search for an in-service vehicle first, then capture the tariff details. New entries are created as pending for the approval workflow.</span>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h2>Vehicle lookup</h2>
            <p>Locate the vehicle by GG or GP number before capturing the tariff details.</p>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Vehicle Search</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                    <div class="form-actions" style="margin-top: 0.5rem;">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadVehicleMatchesAsync" disabled="@_saving">Search vehicle</button>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_item.vmf_Code" disabled="@(_vehicleMatches.Count == 0)">
                        <option value="">Select vehicle</option>
                        @foreach (var vehicle in _vehicleMatches)
                        {
                            <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                        }
                    </select>
                    @if (_vehicleMatches.Count > 0)
                    {
                        <p class="form-hint">@_vehicleMatches.Count vehicle match(es) found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_item.vmf_Code > 0)
    {
        <div class="alert alert-info fis-alert-tight">
            <i class="bx bx-car"></i>
            <span>Selected vehicle: @SelectedVehicleLabel</span>
        </div>
    }

    <div class="form-card">
        <div class="form-card-header">
            <h2>Tariff details</h2>
            <p>Capture the lease period, kilometers, and financial values for the selected vehicle.</p>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <InputDate @bind-Value="_item.StartDate" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <InputDate @bind-Value="_item.EndDate" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Agreed Terms (months)</label>
                    <InputNumber @bind-Value="_item.AgreedTerms" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Agreed Kilos</label>
                    <InputNumber @bind-Value="_item.AgreedKilos" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Applied Interest</label>
                    <InputNumber @bind-Value="_item.AppliedInterest" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Fixed Monthly Amount</label>
                    <InputNumber @bind-Value="_item.FixedMonthlyAmount" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Authority Status</label>
                    <input class="form-input" value="Pending" readonly />
                    <p class="form-hint">New tariffs enter the approval queue as pending.</p>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_saving">Submit</button>
                <button class="btn btn-secondary" @onclick="ClearForm" disabled="@_saving">Clear</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private bool _saving;
    private bool _error;
    private string _searchMode = "GG";
    private string _message = string.Empty;
    private string _vehicleSearchTerm = string.Empty;
    private List<VehicleDto> _vehicleMatches = new();
    private FullMaintenanceLeaseTermDto _item = NewItem();
    private string SelectedVehicleLabel
        => _vehicleMatches.FirstOrDefault(vehicle => vehicle.vmf_code == _item.vmf_Code) is { } vehicle
            ? GetVehicleLabel(vehicle)
            : _item.vmf_Code > 0 ? _item.vmf_Code.GetValueOrDefault().ToString() : "-";

    private async Task CreateAsync()
    {
        if (_item.vmf_Code <= 0)
        {
            _error = true;
            _message = "Select a vehicle before submitting the tariff.";
            return;
        }

        if (_item.StartDate.HasValue && _item.EndDate.HasValue && _item.EndDate.Value.Date < _item.StartDate.Value.Date)
        {
            _error = true;
            _message = "End date cannot be earlier than the start date.";
            return;
        }

        _saving = true;
        _error = false;
        _message = string.Empty;
        try
        {
            _item.AuthorityStatus = 1;
            var created = await LeaseService.CreateAsync(_item);
            _error = created == null;
            _message = _error
                ? "Failed to create lease tariff."
                : $"Lease tariff created (ID: {created?.TermId}).";
            if (!_error)
            {
                _item = NewItem();
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Failed to create lease tariff.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error creating lease tariff: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ClearForm()
    {
        _item = NewItem();
        _vehicleSearchTerm = string.Empty;
        _vehicleMatches = new();
        _message = string.Empty;
        _error = false;
    }

    private static FullMaintenanceLeaseTermDto NewItem()
        => new()
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddYears(1),
            AuthorityStatus = 1
        };

    private async Task LoadVehicleMatchesAsync()
    {
        if (string.IsNullOrWhiteSpace(_vehicleSearchTerm))
        {
            _vehicleMatches = new();
            _item.vmf_Code = 0;
            return;
        }

        try
        {
            var keyword = _vehicleSearchTerm.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FullMaintenanceLeaseUi.FilterVehicleMatches(matches, keyword, _searchMode);

            if (_vehicleMatches.All(v => v.vmf_code != _item.vmf_Code))
            {
                _item.vmf_Code = 0;
            }
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            await JSRuntime.InvokeVoidAsync("console.error", $"Error searching vehicles: {ex.Message}");
        }
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => FullMaintenanceLeaseUi.FormatVehicleLabel(vehicle);

    private static string ValueOrDash(string? value)
        => FullMaintenanceLeaseUi.ValueOrDash(value);

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _item.vmf_Code = 0;
    }
}
