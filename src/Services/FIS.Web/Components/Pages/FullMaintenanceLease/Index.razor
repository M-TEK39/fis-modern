@page "/full-maintenance-lease"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Full Maintenance Lease - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Full Maintenance Lease
        </h1>
        <p class="page-description">Maintenance lease summary. Static entries until FML API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadLeases">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading leases...</p>
        </div>
    }
    else if (_leases.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-cog"></i>
            <h3>No lease records</h3>
            <p>Awaiting full maintenance lease API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_leases.Count Lease record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Lease #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lease in _leases)
                        {
                            <tr>
                                <td>@lease.Number</td>
                                <td>@lease.Vehicle</td>
                                <td><span class="badge">@lease.Status</span></td>
                                <td>@lease.Start.ToString("yyyy-MM-dd")</td>
                                <td>@lease.End.ToString("yyyy-MM-dd")</td>
                                <td>@lease.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FmlItem> _leases = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLeases();
    }

    private Task LoadLeases()
    {
        _loading = true;

        _leases =
        [
            new("FML-2401-001", "ABC123GP", "Active", new DateTime(2025, 01, 01), new DateTime(2026, 01, 01), "Yearly lease cycle."),
            new("FML-2401-002", "JKL456GP", "Pending", new DateTime(2025, 02, 01), new DateTime(2026, 02, 01), "Pending activation."),
            new("FML-2312-006", "MNO789GP", "Closed", new DateTime(2024, 01, 01), new DateTime(2024, 12, 31), "Completed cycle."),
            new("FML-2311-004", "PQR321GP", "Closed", new DateTime(2024, 03, 01), new DateTime(2025, 02, 28), "Legacy reference.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record FmlItem(string Number, string Vehicle, string Status, DateTime Start, DateTime End, string Notes);
}
