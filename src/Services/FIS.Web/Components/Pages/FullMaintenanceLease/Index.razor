@page "/full-maintenance-lease"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject LeaseContractTermsApiService LeaseService
@inject IJSRuntime JS

<PageTitle>Full Maintenance Lease - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Full Maintenance Lease
        </h1>
        <p class="page-description">Full Maintenance Lease (FML) Menu</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles fis-mb-15">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleLeaseInfo">
                <span>Full Maintenance Lease Information / Help</span>
                <i class="bx @(_showLeaseInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showLeaseInfo)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <span class="menu-item-link">Use Lease Vehicle Section below to capture and manage tariffs.</span>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleLeaseMaintenance">
                <span>Lease Vehicle Section</span>
                <i class="bx @(_showLeaseMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showLeaseMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/tariffs">1) Capturing of Tariffs for Lease Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/upload">2) Import the Tariff File</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/extend">3) Extend Latest Lease Tariff Period</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/add-lease">4) Add Lease Tariff for In Service Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/reports">5) FML Reports</a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="alert alert-info fis-alert-tight">
        <i class="bx bx-info-circle"></i>
        <span>Use quick lookup to isolate a vehicle, then continue into capture, extension, add-tariff, upload, or reporting workflows from the menu above.</span>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h2>Quick contract lookup</h2>
            <p>Search by GG or GP number, choose a matched vehicle, and review current lease records in one place.</p>
        </div>
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Number Type</label>
                <div class="contract-search-radio">
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                        GG
                    </label>
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                        GP
                    </label>
                </div>
                <input class="form-input" @bind="_searchQuery" placeholder="@(_searchMode == "GG" ? "Search by GG number" : "Search by GP number")" />
                <select class="form-select fis-mt-05" @bind="_selectedVmfCode" @bind:after="ApplySelectedVehicleFilterAsync" disabled="@(_vehicleMatches.Count == 0)">
                    <option value="">Select vehicle...</option>
                    @foreach (var vehicle in _vehicleMatches)
                    {
                        <option value="@vehicle.vmf_code">@FormatVehicleLabel(vehicle)</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchLeases" disabled="@_searching">Search</button>
                <button class="btn btn-secondary" @onclick="ClearSearch" disabled="@_searching">Clear</button>
            </div>
        </div>
    </div>

    @if (_vehicleMatches.Count > 0 && !_selectedVmfCode.HasValue && string.IsNullOrWhiteSpace(_searchError) && !_searching)
    {
        <div class="alert alert-info fis-alert-tight">
            <i class="bx bx-list-ul"></i>
            <span>@_vehicleMatches.Count vehicle match(es) found. Select one from the list to load its lease contracts.</span>
        </div>
    }

    @if (_loading || _searching)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>@(_loading ? "Loading leases..." : "Searching leases...")</p>
        </div>
    }
    else if (_leases.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-cog"></i>
            <h3>No lease records</h3>
            <p>No lease records match the current filter selection.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_leases.Count lease record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Lease #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lease in PagedLeases)
                        {
                            <tr>
                                <td>@lease.Number</td>
                                <td>@lease.Vehicle</td>
                                <td><span class="@lease.BadgeClass">@lease.Status</span></td>
                                <td>@FormatDate(lease.Start)</td>
                                <td>@FormatDate(lease.End)</td>
                                <td>@ValueOrDash(lease.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_searchError))
    {
        <div class="alert alert-error fis-alert-tight">
            <i class="bx bx-error-circle"></i>
            <span>@_searchError</span>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FmlItem> _leases = new();
    private List<FmlItem> _allLeases = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private List<VehicleDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private string _searchMode = "GG";
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private bool _showLeaseInfo = true;
    private bool _showLeaseMaintenance = true;
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<FmlItem> PagedLeases => _leases.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_leases.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLeases();
    }

    private async Task LoadLeases()
    {
        _loading = true;
        try
        {
            if (_vehicleLabelByVmf.Count == 0)
            {
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _vehicleLabelByVmf = vehicles.Data
                    .GroupBy(v => v.vmf_code)
                    .ToDictionary(
                        g => g.Key,
                        g => FormatVehicleLabel(g.First()));
            }

            var leases = await LeaseService.GetAllAsync<FullMaintenanceLeaseTermDto>();
            _allLeases = leases.Select(l => new FmlItem(
                VmfCode: l.VmfCode,
                Number: l.TermId.ToString(),
                Vehicle: GetVehicleLabel(l.VmfCode),
                Status: FullMaintenanceLeaseUi.MapAuthorityStatus(l.AuthorityStatus),
                BadgeClass: FullMaintenanceLeaseUi.GetAuthorityBadgeClass(l.AuthorityStatus),
                Start: l.EffectiveStartDate,
                End: l.EffectiveEndDate,
                Notes: l.lease_notes ?? l.lease_status ?? string.Empty
            )).ToList();
            _leases = new List<FmlItem>(_allLeases);
            _page = 1;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading leases: {ex.Message}");
            _leases = new();
            _allLeases = new();
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record FmlItem(int? VmfCode, string Number, string Vehicle, string Status, string BadgeClass, DateTime? Start, DateTime? End, string Notes);

    private void ToggleLeaseInfo()
    {
        _showLeaseInfo = !_showLeaseInfo;
    }

    private void ToggleLeaseMaintenance()
    {
        _showLeaseMaintenance = !_showLeaseMaintenance;
    }

    private async Task SearchLeases()
    {
        _searchError = null;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _leases = new List<FmlItem>(_allLeases);
            _page = 1;
            return;
        }

        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = FullMaintenanceLeaseUi.FilterVehicleMatches(matches, query, _searchMode);

            if (_vehicleMatches.Count == 0)
            {
                _leases = new List<FmlItem>();
                _searchError = "Vehicle not found.";
                _selectedVmfCode = null;
                _page = 1;
                return;
            }

            if (_vehicleMatches.All(v => v.vmf_code != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            _leases = new List<FmlItem>();
            _searchError = "Select a vehicle from the list to load its contracts.";
            _page = 1;
        }
        catch (Exception ex)
        {
            _searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _searchError = null;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _leases = new List<FmlItem>(_allLeases);
        _page = 1;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchError = null;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _leases = new List<FmlItem>(_allLeases);
        _page = 1;
    }

    private Task ApplySelectedVehicleFilterAsync()
    {
        _searchError = null;
        if (!_selectedVmfCode.HasValue)
        {
            _leases = new();
            _page = 1;
            return Task.CompletedTask;
        }

        _leases = _allLeases.Where(l => l.VmfCode == _selectedVmfCode.Value).ToList();
        _page = 1;
        if (_leases.Count == 0)
        {
            _searchError = "No lease records found for this vehicle.";
        }

        return Task.CompletedTask;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => FullMaintenanceLeaseUi.ValueOrDash(value);
    private static string FormatVehicleLabel(VehicleDto vehicle)
        => FullMaintenanceLeaseUi.FormatVehicleLabel(vehicle);

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "Unknown";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
