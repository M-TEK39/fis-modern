@page "/full-maintenance-lease"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject LeaseContractTermsApiService LeaseService
@inject IJSRuntime JS

<PageTitle>Full Maintenance Lease - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Full Maintenance Lease
        </h1>
        <p class="page-description">Full Maintenance Lease (FML) Menu</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles fis-mb-15">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleLeaseInfo">
                <span>Full Maintenance Lease Information / Help</span>
                <i class="bx @(_showLeaseInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showLeaseInfo)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <span class="menu-item-link">Use Lease Vehicle Section below to capture and manage tariffs.</span>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleLeaseMaintenance">
                <span>Lease Vehicle Section</span>
                <i class="bx @(_showLeaseMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showLeaseMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/tariffs">1) Capturing of Tariffs for Lease Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/upload">2) Import the Tariff File</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/extend">3) Extend Latest Lease Tariff Period</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/add-lease">4) Add Lease Tariff for In Service Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/full-maintenance-lease/reports">4) FML Reports</a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">GG / GP Number</label>
                <input class="form-input" @bind="_searchQuery" placeholder="Search lease records by vehicle" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchLeases" disabled="@_searching">Search</button>
                <button class="btn btn-secondary" @onclick="ClearSearch" disabled="@_searching">Clear</button>
            </div>
        </div>
    </div>

    @if (_loading || _searching)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>@(_loading ? "Loading leases..." : "Searching leases...")</p>
        </div>
    }
    else if (_leases.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-cog"></i>
            <h3>No lease records</h3>
            <p>No lease records are available.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_leases.Count Lease record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Lease #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lease in _leases)
                        {
                            <tr>
                                <td>@lease.Number</td>
                                <td>@lease.Vehicle</td>
                                <td><span class="badge">@lease.Status</span></td>
                                <td>@FormatDate(lease.Start)</td>
                                <td>@FormatDate(lease.End)</td>
                                <td>@ValueOrDash(lease.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_searchError))
    {
        <div class="alert alert-error fis-alert-tight">
            <i class="bx bx-error-circle"></i>
            <span>@_searchError</span>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FmlItem> _leases = new();
    private List<FmlItem> _allLeases = new();
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private bool _showLeaseInfo = true;
    private bool _showLeaseMaintenance = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeases();
    }

    private async Task LoadLeases()
    {
        _loading = true;
        try
        {
            var leases = await LeaseService.GetAllAsync<LeaseContractTermsDto>();
            _allLeases = leases.Select(l => new FmlItem(
                VmfCode: l.vmf_code,
                Number: l.leasecontract_code.ToString(),
                Vehicle: l.vmf_code?.ToString() ?? "Unknown",
                Status: l.lease_status ?? "Unknown",
                Start: l.lease_startdate,
                End: l.lease_enddate,
                Notes: l.lease_notes ?? string.Empty
            )).ToList();
            _leases = new List<FmlItem>(_allLeases);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading leases: {ex.Message}");
            _leases = new();
            _allLeases = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record FmlItem(int? VmfCode, string Number, string Vehicle, string Status, DateTime? Start, DateTime? End, string Notes);

    private sealed class LeaseContractTermsDto
    {
        public int leasecontract_code { get; set; }
        public int? vmf_code { get; set; }
        public string? lease_status { get; set; }
        public DateTime? lease_startdate { get; set; }
        public DateTime? lease_enddate { get; set; }
        public string? lease_notes { get; set; }
    }

    private void ToggleLeaseInfo()
    {
        _showLeaseInfo = !_showLeaseInfo;
    }

    private void ToggleLeaseMaintenance()
    {
        _showLeaseMaintenance = !_showLeaseMaintenance;
    }

    private async Task SearchLeases()
    {
        _searchError = null;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _leases = new List<FmlItem>(_allLeases);
            return;
        }

        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 200, search: query);
            var match = vehicles.Data.FirstOrDefault(v =>
                string.Equals(v.fleet_number, query, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(v.registration_number, query, StringComparison.OrdinalIgnoreCase));

            if (match == null)
            {
                _leases = new List<FmlItem>();
                _searchError = "Vehicle not found.";
                return;
            }

            _leases = _allLeases.Where(l => l.VmfCode == match.vmf_code).ToList();
            if (_leases.Count == 0)
            {
                _searchError = "No lease records found for this vehicle.";
            }
        }
        catch (Exception ex)
        {
            _searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _searchError = null;
        _leases = new List<FmlItem>(_allLeases);
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
