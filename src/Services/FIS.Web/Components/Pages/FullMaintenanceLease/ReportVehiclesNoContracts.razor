@page "/full-maintenance-lease/reports/vehicles-no-contracts"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>FML Vehicles With No Contracts</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            List of FML vehicles that do not have contract with Clients
        </h1>
    </div>
</div>

<div class="page-content">
    <div class="form-actions" style="margin-bottom: 1rem;">
        <button class="btn btn-primary" @onclick="Download">Download to Excel</button>
        <button class="btn btn-secondary" @onclick="GoBack">&lt;&lt; Back to Reports selection screen</button>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Click on the table headers to sort</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vehicle Counter</th>
                        <th>GG Number</th>
                        <th>Registration Number</th>
                        <th>Hired From</th>
                        <th>Vehicle Status</th>
                        <th>Location</th>
                        <th>Year Model</th>
                        <th>Model Description</th>
                        <th>Class Description</th>
                        <th>Purchase Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr>
                            <td colspan="10">No records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.VehicleCounter</td>
                                <td>@row.GgNumber</td>
                                <td>@row.RegistrationNumber</td>
                                <td>@row.HiredFrom</td>
                                <td>@row.VehicleStatus</td>
                                <td>@row.Location</td>
                                <td>@row.YearModel</td>
                                <td>@row.ModelDescription</td>
                                <td>@row.ClassDescription</td>
                                <td>@row.PurchaseAmount</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly List<VehiclesNoContractsRow> _rows = new();

    private void Download() { }

    private void GoBack()
    {
        Navigation.NavigateTo("/full-maintenance-lease/reports");
    }

    private sealed class VehiclesNoContractsRow
    {
        public string VehicleCounter { get; set; } = "";
        public string GgNumber { get; set; } = "";
        public string RegistrationNumber { get; set; } = "";
        public string HiredFrom { get; set; } = "";
        public string VehicleStatus { get; set; } = "";
        public string Location { get; set; } = "";
        public string YearModel { get; set; } = "";
        public string ModelDescription { get; set; } = "";
        public string ClassDescription { get; set; } = "";
        public string PurchaseAmount { get; set; } = "";
    }
}
