@page "/full-maintenance-lease/reports/vehicles-no-contracts"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>List of FML vehicles that do not have contracts with Clients</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-car"></i>FML Vehicles with No Contracts</h1>
        <p class="page-description">Vehicles with no matching lease term records.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-check-circle"></i><h3>No records</h3><p>No vehicles without lease contracts found.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_rows.Count vehicle(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle Counter</th>
                            <th>GG Number</th>
                            <th>Registration Number</th>
                            <th>Hired From</th>
                            <th>Vehicle Status</th>
                            <th>Location</th>
                            <th>Year Model</th>
                            <th>Model Description</th>
                            <th>Class Description</th>
                            <th>Purchase Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@(row.VehicleCounter?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.GgNumber)</td>
                                <td>@ValueOrDash(row.RegistrationNumber)</td>
                                <td>@ValueOrDash(row.HiredFrom)</td>
                                <td>@ValueOrDash(row.VehicleStatus)</td>
                                <td>@ValueOrDash(row.Location)</td>
                                <td>@(row.YearModel?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.ModelDescription)</td>
                                <td>@ValueOrDash(row.ClassDescription)</td>
                                <td>@FormatCurrency(row.PurchaseAmount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FmlVehicleNoContractRow> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<FmlVehicleNoContractRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var report = await ReportService.GetFmlVehiclesNoContractsAsync();
            _rows = report.Vehicles;
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _rows = new List<FmlVehicleNoContractRow>();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicles-no-contracts report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatCurrency(decimal? value) => value.HasValue ? $"R {value.Value:N2}" : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

}
