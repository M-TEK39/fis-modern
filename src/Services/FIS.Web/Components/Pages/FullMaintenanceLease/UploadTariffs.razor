@page "/full-maintenance-lease/upload"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Import the Tariff File</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-upload"></i>
            Upload the Lease Tariff File
        </h1>
        <p class="page-description">Import the lease tariff file with the legacy format.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Instructions</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <p>1) Upload Lease Tariff file - Please ensure that first row in file is the header row.</p>
                    <p>2) The Sheet Name needs to be Data.</p>
                    <p>3) Column Headers needs to be as follows:</p>
                    <p>No, VMF_Code, GGNumber, GPNumber, Start_Date, End_Date, Fixed_Tariff, Excess_Kilo_Tariff</p>
                    <p>4) Save the file as a .csv file and import.</p>
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Select Tariff File</label>
                    <input class="form-input" type="file" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="UploadFile">Upload File</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Close</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="alert alert-info">
                    <i class="bx bx-info-circle"></i>
                    <span>@_statusMessage</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? _statusMessage;

    private void UploadFile()
    {
        _statusMessage = "Upload pending API integration.";
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/full-maintenance-lease");
    }
}
