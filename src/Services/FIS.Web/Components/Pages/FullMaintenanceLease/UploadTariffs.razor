@page "/full-maintenance-lease/upload"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LeaseContractTermsApiService LeaseService
@inject IJSRuntime JSRuntime

<PageTitle>Upload the Lease Tariff File</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-upload"></i>
            Upload the Lease Tariff File
        </h1>
        <p class="page-description">Paste CSV rows and import lease tariff records.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="alert alert-info fis-alert-tight">
        <i class="bx bx-info-circle"></i>
        <span>Use the legacy tariff layout when preparing the CSV. Extra legacy columns are accepted and ignored when they are not required by the API.</span>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h2>Upload instructions</h2>
            <p>Prepare the tariff file as CSV with the legacy column names, then paste the contents below for import.</p>
        </div>
        <div class="form-card-body">
            <p class="form-hint">Supported headers: <code>No</code>, <code>VMF_Code</code>, <code>GGNumber</code>, <code>GPNumber</code>, <code>Start_Date</code>, <code>End_Date</code>, <code>Fixed_Tariff</code>, <code>Excess_Kilo_Tariff</code>, <code>AgreedTerms</code>, <code>AgreedKilos</code>, <code>AppliedInterest</code>.</p>
            <textarea class="form-input" rows="12" @bind="_csvText" placeholder="No,VMF_Code,GGNumber,GPNumber,Start_Date,End_Date,Fixed_Tariff,Excess_Kilo_Tariff,AgreedTerms,AgreedKilos,AppliedInterest"></textarea>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ImportAsync" disabled="@_importing">Import</button>
                <button class="btn btn-secondary" @onclick="ClearAsync" disabled="@_importing">Clear</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private string _csvText = string.Empty;
    private bool _importing;
    private bool _error;
    private string _message = string.Empty;

    private async Task ImportAsync()
    {
        _error = false;
        _message = string.Empty;

        var lines = _csvText
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        if (lines.Count <= 1)
        {
            _error = true;
            _message = "Provide CSV header and at least one data row.";
            return;
        }

        _importing = true;
        var created = 0;
        var failed = 0;
        try
        {
            var headers = ParseHeaders(lines[0]);
            if (!headers.ContainsKey("vmf_code"))
            {
                _error = true;
                _message = "CSV header must include VMF_Code.";
                return;
            }

            foreach (var row in lines.Skip(1))
            {
                var cols = row.Split(',').Select(value => value.Trim()).ToArray();
                if (cols.Length == 0)
                {
                    failed++;
                    continue;
                }

                var vmfText = GetColumnValue(cols, headers, "vmf_code");
                if (!int.TryParse(vmfText, out var vmfCode))
                {
                    failed++;
                    continue;
                }

                var payload = new FullMaintenanceLeaseTermDto
                {
                    vmf_Code = vmfCode,
                    StartDate = ParseDate(GetColumnValue(cols, headers, "start_date")),
                    EndDate = ParseDate(GetColumnValue(cols, headers, "end_date")),
                    FixedMonthlyAmount = ParseDecimal(GetColumnValue(cols, headers, "fixed_tariff")),
                    AgreedTerms = ParseInt(GetColumnValue(cols, headers, "agreedterms")),
                    AgreedKilos = ParseLong(GetColumnValue(cols, headers, "agreedkilos")),
                    AppliedInterest = ParseDecimal(GetColumnValue(cols, headers, "appliedinterest")),
                    AuthorityStatus = 1
                };

                var result = await LeaseService.CreateAsync(payload);
                if (result == null)
                {
                    failed++;
                }
                else
                {
                    created++;
                }
            }

            _error = failed > 0;
            _message = $"Import completed. Created: {created}, Failed: {failed}.";
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Import failed.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error importing lease tariff file: {ex.Message}");
        }
        finally
        {
            _importing = false;
        }
    }

    private Task ClearAsync()
    {
        _csvText = string.Empty;
        _message = string.Empty;
        _error = false;
        return Task.CompletedTask;
    }

    private static DateTime? ParseDate(string? text)
        => DateTime.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static decimal? ParseDecimal(string? text)
        => decimal.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static int? ParseInt(string? text)
        => int.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static long? ParseLong(string? text)
        => long.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static Dictionary<string, int> ParseHeaders(string headerRow)
        => headerRow
            .Split(',')
            .Select((value, index) => new { Key = NormalizeHeader(value), index })
            .Where(item => !string.IsNullOrWhiteSpace(item.Key))
            .GroupBy(item => item.Key)
            .ToDictionary(group => group.Key, group => group.First().index);

    private static string? GetColumnValue(IReadOnlyList<string> columns, IReadOnlyDictionary<string, int> headers, string key)
        => headers.TryGetValue(key, out var index) && index >= 0 && index < columns.Count
            ? columns[index]
            : null;

    private static string NormalizeHeader(string? header)
        => (header ?? string.Empty).Trim().Replace(" ", string.Empty).ToLowerInvariant();
}
