@page "/full-maintenance-lease/upload"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject LeaseContractTermsApiService LeaseService
@inject IJSRuntime JSRuntime

<PageTitle>Upload the Lease Tariff File</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-upload"></i>
            Upload the Lease Tariff File
        </h1>
        <p class="page-description">Paste CSV rows and import lease tariff records.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Expected CSV headers: `VMF_Code,Start_Date,End_Date,Fixed_Tariff,AgreedTerms,AgreedKilos,AppliedInterest`</p>
            <textarea class="form-input" rows="12" @bind="_csvText" placeholder="VMF_Code,Start_Date,End_Date,Fixed_Tariff,AgreedTerms,AgreedKilos,AppliedInterest"></textarea>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ImportAsync" disabled="@_importing">Import</button>
                <button class="btn btn-secondary" @onclick="ClearAsync" disabled="@_importing">Clear</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private string _csvText = string.Empty;
    private bool _importing;
    private bool _error;
    private string _message = string.Empty;

    private async Task ImportAsync()
    {
        _error = false;
        _message = string.Empty;

        var lines = _csvText
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        if (lines.Count <= 1)
        {
            _error = true;
            _message = "Provide CSV header and at least one data row.";
            return;
        }

        _importing = true;
        var created = 0;
        var failed = 0;
        try
        {
            foreach (var row in lines.Skip(1))
            {
                var cols = row.Split(',');
                if (cols.Length < 4)
                {
                    failed++;
                    continue;
                }

                if (!int.TryParse(cols[0].Trim(), out var vmfCode))
                {
                    failed++;
                    continue;
                }

                var payload = new LeaseTermDto
                {
                    vmf_Code = vmfCode,
                    StartDate = ParseDate(cols.ElementAtOrDefault(1)),
                    EndDate = ParseDate(cols.ElementAtOrDefault(2)),
                    FixedMonthlyAmount = ParseDecimal(cols.ElementAtOrDefault(3)),
                    AgreedTerms = ParseInt(cols.ElementAtOrDefault(4)),
                    AgreedKilos = ParseLong(cols.ElementAtOrDefault(5)),
                    AppliedInterest = ParseDecimal(cols.ElementAtOrDefault(6)),
                    AuthorityStatus = 1
                };

                var result = await LeaseService.CreateAsync(payload);
                if (result == null)
                {
                    failed++;
                }
                else
                {
                    created++;
                }
            }

            _error = failed > 0;
            _message = $"Import completed. Created: {created}, Failed: {failed}.";
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Import failed.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error importing lease tariff file: {ex.Message}");
        }
        finally
        {
            _importing = false;
        }
    }

    private Task ClearAsync()
    {
        _csvText = string.Empty;
        _message = string.Empty;
        _error = false;
        return Task.CompletedTask;
    }

    private static DateTime? ParseDate(string? text)
        => DateTime.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static decimal? ParseDecimal(string? text)
        => decimal.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static int? ParseInt(string? text)
        => int.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private static long? ParseLong(string? text)
        => long.TryParse(text?.Trim(), out var parsed) ? parsed : null;

    private sealed class LeaseTermDto
    {
        public int VehicleContractTermID { get; set; }
        public int vmf_Code { get; set; }
        public int? AgreedTerms { get; set; }
        public long? AgreedKilos { get; set; }
        public decimal? AppliedInterest { get; set; }
        public decimal? FixedMonthlyAmount { get; set; }
        public int? AuthorityStatus { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
    }
}
