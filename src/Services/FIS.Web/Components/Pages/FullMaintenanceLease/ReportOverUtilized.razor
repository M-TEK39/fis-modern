@page "/full-maintenance-lease/reports/over-utilized"
@page "/NOMPending/Rpt_OverUtilizedFMLVehiclesOnKm.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>List of over utilized FML vehicles (based on km's)</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-line-chart"></i>Over Utilized FML Vehicles</h1>
        <p class="page-description">Vehicles where current odometer is above agreed lease kilometers.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-check-circle"></i><h3>No records</h3><p>No over-utilized FML vehicles found.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_rows.Count vehicle(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle Counter</th>
                            <th>GG Number</th>
                            <th>GP Number</th>
                            <th>Hired From</th>
                            <th>Month</th>
                            <th>Max Odo Meter</th>
                            <th>Min Odo Meter</th>
                            <th>Actual Kilos</th>
                            <th>Agreed Kilos</th>
                            <th>Excess Kilos</th>
                            <th>Agreed Overall Kilo</th>
                            <th>Agreed Terms</th>
                            <th>Actual Term</th>
                            <th>Total Kilos</th>
                            <th>Total Excess Kilos</th>
                            <th>Average Monthly Kilos</th>
                            <th>Projected End Month</th>
                            <th>Projected End Date</th>
                            <th>Year Model</th>
                            <th>Model Description</th>
                            <th>Purchase Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@(row.VehicleCounter?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.GgNumber)</td>
                                <td>@ValueOrDash(row.GpNumber)</td>
                                <td>@ValueOrDash(row.HiredFrom)</td>
                                <td>@ValueOrDash(row.Month)</td>
                                <td>@FormatNumber(row.MaxOdoMeter)</td>
                                <td>@FormatNumber(row.MinOdoMeter)</td>
                                <td>@FormatNumber(row.ActualKilos)</td>
                                <td>@FormatNumber(row.AgreedKilos)</td>
                                <td>@FormatNumber(row.ExcessKilos)</td>
                                <td>@FormatNumber(row.AgreedOverallKilo)</td>
                                <td>@FormatNumber(row.AgreedTerms)</td>
                                <td>@FormatNumber(row.ActualTerm)</td>
                                <td>@FormatNumber(row.TotalKilos)</td>
                                <td>@FormatNumber(row.TotalExcessKilos)</td>
                                <td>@FormatNumber(row.AverageMonthlyKilos)</td>
                                <td>@ValueOrDash(row.ProjectedEndMonth)</td>
                                <td>@FormatDate(row.ProjectedEndDate)</td>
                                <td>@(row.YearModel?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.ModelDescription)</td>
                                <td>@FormatCurrency(row.PurchaseAmount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "startDate")]
    public DateTime? StartDate { get; set; }

    [SupplyParameterFromQuery(Name = "endDate")]
    public DateTime? EndDate { get; set; }

    private bool _loading = true;
    private List<FmlOverUtilizedRow> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<FmlOverUtilizedRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var report = await ReportService.GetFmlOverUtilizedAsync(StartDate, EndDate);
            _rows = report.Vehicles;
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _rows = new List<FmlOverUtilizedRow>();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading over-utilized report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatNumber(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "-";
    private static string FormatCurrency(decimal? value) => value.HasValue ? $"R {value.Value:N2}" : "-";
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

}
