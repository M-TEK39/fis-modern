@page "/full-maintenance-lease/reports/contracts-expiring"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject LeaseContractTermsApiService LeaseService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>FML Contracts Expire In Next Three Months Report</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-timer"></i>FML Contracts Expiring</h1>
        <p class="page-description">Contracts with end dates in the next 3 months.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-info-circle"></i><h3>No records</h3><p>No contracts expiring in the next 3 months.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_rows.Count contract(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Lease ID</th><th>Vehicle</th><th>Start Date</th><th>End Date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@row.VehicleContractTermID</td>
                                <td>@GetVehicleLabel(row.vmf_Code)</td>
                                <td>@FormatDate(row.StartDate)</td>
                                <td>@FormatDate(row.EndDate)</td>
                                <td>@MapStatus(row.AuthorityStatus)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<LeaseTermDto> _rows = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<LeaseTermDto> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await LeaseService.GetAllAsync<LeaseTermDto>();
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _vehicleLabelByVmf = vehicles.Data
                .GroupBy(v => v.vmf_code)
                .ToDictionary(
                    g => g.Key,
                    g => FormatVehicleLabel(g.First()));
            var today = DateTime.Today;
            var end = today.AddMonths(3);
            _rows = all
                .Where(x => x.EndDate.HasValue && x.EndDate.Value.Date >= today && x.EndDate.Value.Date <= end)
                .OrderBy(x => x.EndDate)
                .ToList();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _rows = new List<LeaseTermDto>();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading contracts-expiring report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string MapStatus(int? status) => status switch
    {
        1 => "Pending",
        2 => "Approved",
        4 => "Rejected",
        _ => "Unknown"
    };

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private string GetVehicleLabel(int vmfCode) =>
        _vehicleLabelByVmf.TryGetValue(vmfCode, out var label) ? label : $"- / - ({vmfCode})";
    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed class LeaseTermDto
    {
        public int VehicleContractTermID { get; set; }
        public int vmf_Code { get; set; }
        public int? AuthorityStatus { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
    }
}
