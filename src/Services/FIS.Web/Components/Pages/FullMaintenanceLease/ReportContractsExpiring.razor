@page "/full-maintenance-lease/reports/contracts-expiring"
@page "/NOMPending/Rpt_FMLContractsExpireInThreeMonths.aspx"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>FML Contracts Expire In Next Three Months Report</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-timer"></i>FML Contracts Expiring</h1>
        <p class="page-description">Contracts with end dates in the next 3 months.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-info-circle"></i><h3>No records</h3><p>No contracts expiring in the next 3 months.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_rows.Count contract(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>GG Number</th>
                            <th>GP Number</th>
                            <th>Model</th>
                            <th>Year Model</th>
                            <th>Hired From</th>
                            <th>Hire Type</th>
                            <th>Still Current</th>
                            <th>Contract Start Date</th>
                            <th>Target Return Date</th>
                            <th>Contract Type</th>
                            <th>Site Name</th>
                            <th>Fixed Tariff</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@(row.RowNumber?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.GgNumber)</td>
                                <td>@ValueOrDash(row.GpNumber)</td>
                                <td>@ValueOrDash(row.Model)</td>
                                <td>@(row.YearModel?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.HiredFrom)</td>
                                <td>@ValueOrDash(row.HireType)</td>
                                <td>@ValueOrDash(row.StillCurrent)</td>
                                <td>@FormatDate(row.ContractStartDate)</td>
                                <td>@FormatDate(row.TargetReturnDate)</td>
                                <td>@ValueOrDash(row.ContractType)</td>
                                <td>@ValueOrDash(row.SiteName)</td>
                                <td>@FormatCurrency(row.FixedTariff)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<FmlContractRow> _rows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<FmlContractRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var report = await ReportService.GetFmlContractsExpiringAsync();
            _rows = report.Contracts;
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _rows = new List<FmlContractRow>();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading contracts-expiring report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private static string FormatCurrency(decimal? value) => value.HasValue ? $"R {value.Value:N2}" : "-";
    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

}
