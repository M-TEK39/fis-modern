@page "/full-maintenance-lease/reports/maintenance-history"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject ReportApiService ReportService
@inject IJSRuntime JSRuntime

<PageTitle>FML Vehicle Maintenance History</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-history"></i>FML Vehicle Maintenance History</h1>
        <p class="page-description">Lease term lifecycle history by vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-info-circle"></i><h3>No records</h3><p>No lease maintenance history found.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_rows.Count record(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Year Model</th>
                            <th>Model Description</th>
                            <th>Current Status</th>
                            <th>Current Status Date</th>
                            <th>Hired From</th>
                            <th>Maintenance Expense Type</th>
                            <th>Total Cost Over Date Range</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                <td>@ValueOrDash(row.GgNumber)</td>
                                <td>@(row.YearManufactured?.ToString() ?? "-")</td>
                                <td>@ValueOrDash(row.ModelDescription)</td>
                                <td>@ValueOrDash(row.CurrentStatus)</td>
                                <td>@FormatDate(row.CurrentStatusDate)</td>
                                <td>@ValueOrDash(row.HiredFrom)</td>
                                <td>@ValueOrDash(row.MaintenanceExpenseType)</td>
                                <td>@FormatCurrency(row.TotalCostOverDateRange)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="fis-text-right fis-mt-075">
                <strong>Grand Total:</strong> @FormatCurrency(_grandTotal)
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "startDate")]
    public DateTime? StartDate { get; set; }

    [SupplyParameterFromQuery(Name = "endDate")]
    public DateTime? EndDate { get; set; }

    [SupplyParameterFromQuery(Name = "finYear")]
    public string? FinYear { get; set; }

    [SupplyParameterFromQuery(Name = "ggNum")]
    public string? GgNum { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? SearchMode { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchValue { get; set; }

    private bool _loading = true;
    private List<FmlMaintenanceHistoryRow> _rows = new();
    private decimal? _grandTotal;
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<FmlMaintenanceHistoryRow> PagedRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var report = await ReportService.GetFmlMaintenanceHistoryAsync(
                StartDate,
                EndDate,
                NormalizeFinYear(FinYear),
                NormalizeGgNum(GgNum),
                VehicleSearchHelper.NormalizeMode(SearchMode),
                NormalizeSearchValue(SearchValue, GgNum));
            _rows = report.Records;
            if (_rows.Count > 0)
            {
                _grandTotal = report.GrandTotal ?? _rows.Sum(row => row.TotalCostOverDateRange ?? 0m);
            }
            else
            {
                _grandTotal = report.GrandTotal;
            }
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _rows = new();
            _grandTotal = null;
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading maintenance-history report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? NormalizeFinYear(string? finYear)
        => string.IsNullOrWhiteSpace(finYear) || finYear == "Select..." ? null : finYear;

    private static string? NormalizeGgNum(string? ggNum)
        => string.IsNullOrWhiteSpace(ggNum) ? null : ggNum.Trim();

    private static string? NormalizeSearchValue(string? searchValue, string? ggNum)
        => string.IsNullOrWhiteSpace(searchValue)
            ? NormalizeGgNum(ggNum)
            : searchValue.Trim();

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private static string FormatCurrency(decimal? value) => value.HasValue ? $"R {value.Value:N2}" : "-";
    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
