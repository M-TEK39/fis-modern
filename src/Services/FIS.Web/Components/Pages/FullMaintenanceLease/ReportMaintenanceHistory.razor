@page "/full-maintenance-lease/reports/maintenance-history"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject LeaseContractTermsApiService LeaseService
@inject IJSRuntime JSRuntime

<PageTitle>FML Vehicle Maintenance History</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-history"></i>FML Vehicle Maintenance History</h1>
        <p class="page-description">Lease term lifecycle history by vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease/reports">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">VMF Code Filter</label>
                <InputNumber @bind-Value="_vmfFilter" class="form-input" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ApplyFilter">Apply</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="empty-state"><i class="bx bx-info-circle"></i><h3>No records</h3><p>No lease maintenance history found.</p></div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header"><span class="table-title">@_filtered.Count record(s)</span></div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Lease ID</th><th>VMF</th><th>Start</th><th>End</th><th>Terms</th><th>Kilos</th><th>Fixed Amount</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _filtered)
                        {
                            <tr>
                                <td>@row.VehicleContractTermID</td>
                                <td>@row.vmf_Code</td>
                                <td>@FormatDate(row.StartDate)</td>
                                <td>@FormatDate(row.EndDate)</td>
                                <td>@(row.AgreedTerms?.ToString() ?? "-")</td>
                                <td>@(row.AgreedKilos?.ToString("N0") ?? "-")</td>
                                <td>@FormatCurrency(row.FixedMonthlyAmount)</td>
                                <td>@MapStatus(row.AuthorityStatus)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private int? _vmfFilter;
    private List<LeaseTermDto> _all = new();
    private List<LeaseTermDto> _filtered = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await LeaseService.GetAllAsync<LeaseTermDto>();
            _filtered = new List<LeaseTermDto>(_all.OrderByDescending(x => x.StartDate));
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading maintenance-history report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        if (_vmfFilter.HasValue && _vmfFilter.Value > 0)
        {
            _filtered = _all.Where(x => x.vmf_Code == _vmfFilter.Value).OrderByDescending(x => x.StartDate).ToList();
            return;
        }

        _filtered = new List<LeaseTermDto>(_all.OrderByDescending(x => x.StartDate));
    }

    private static string MapStatus(int? status) => status switch
    {
        1 => "Pending",
        2 => "Approved",
        4 => "Rejected",
        _ => "Unknown"
    };

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private static string FormatCurrency(decimal? value) => value.HasValue ? $"R {value.Value:N2}" : "-";

    private sealed class LeaseTermDto
    {
        public int VehicleContractTermID { get; set; }
        public int vmf_Code { get; set; }
        public int? AgreedTerms { get; set; }
        public long? AgreedKilos { get; set; }
        public decimal? FixedMonthlyAmount { get; set; }
        public int? AuthorityStatus { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
    }
}
