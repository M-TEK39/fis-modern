@page "/full-maintenance-lease/extend"
@page "/NOMPending/VehicleLease_TariffExtension.aspx"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject LeaseContractTermsApiService LeaseService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Extend Latest Lease Tariff Period</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-calendar-edit"></i>
            Extend Latest Lease Tariff Period
        </h1>
        <p class="page-description">Select a lease term and update the end date.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="alert alert-info fis-alert-tight">
        <i class="bx bx-info-circle"></i>
        <span>Select the latest tariff period for a vehicle, then provide the new end date to extend that tariff record.</span>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading lease tariffs...</p>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-calendar-x"></i>
            <h3>No lease tariffs available</h3>
            <p>There are no tariff periods available to extend.</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Lease tariff extension</h2>
                <p>Choose a tariff period and update the end date for the selected lease record.</p>
            </div>
            <div class="form-card-body">
                <div class="form-row">
                    <label class="form-label">Select Lease Term</label>
                    <select class="form-select" @bind="_selectedId">
                        <option value="0">Select...</option>
                        @foreach (var item in _items.OrderByDescending(x => x.EffectiveEndDate ?? DateTime.MinValue))
                        {
                            <option value="@item.TermId">
                                @($"ID {item.TermId} | {GetVehicleLabel(item.VmfCode)} | End {FormatDate(item.EffectiveEndDate)}")
                            </option>
                        }
                    </select>
                </div>
                <div class="form-row">
                    <label class="form-label">New End Date</label>
                    <InputDate @bind-Value="_newEndDate" class="form-input" />
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="ExtendAsync" disabled="@_saving">Submit</button>
                    <button class="btn btn-secondary" @onclick="ResetSelection" disabled="@_saving">Clear</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _error;
    private string _message = string.Empty;
    private int _selectedId;
    private DateTime? _newEndDate = DateTime.Today.AddMonths(1);
    private List<FullMaintenanceLeaseTermDto> _items = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await LeaseService.GetAllAsync<FullMaintenanceLeaseTermDto>();
            if (_vehicleLabelByVmf.Count == 0)
            {
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _vehicleLabelByVmf = vehicles.Data
                    .GroupBy(v => v.vmf_code)
                    .ToDictionary(
                        g => g.Key,
                        g => FormatVehicleLabel(g.First()));
            }
        }
        catch (Exception ex)
        {
            _items = new List<FullMaintenanceLeaseTermDto>();
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading lease terms for extension: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExtendAsync()
    {
        _error = false;
        _message = string.Empty;

        if (_selectedId <= 0 || !_newEndDate.HasValue)
        {
            _error = true;
            _message = "Select a lease term and provide a valid end date.";
            return;
        }

        var selected = _items.FirstOrDefault(x => x.TermId == _selectedId);
        if (selected == null)
        {
            _error = true;
            _message = "Selected lease term not found.";
            return;
        }

        _saving = true;
        try
        {
            selected.EndDate = _newEndDate;
            var updated = await LeaseService.UpdateAsync(selected.TermId, selected);
            _error = updated == null;
            _message = _error ? "Failed to extend lease tariff period." : "Lease tariff period extended.";
            if (!_error)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Failed to extend lease tariff period.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error extending lease tariff period: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => FullMaintenanceLeaseUi.ValueOrDash(value);
    private static string FormatVehicleLabel(VehicleDto vehicle)
        => FullMaintenanceLeaseUi.FormatVehicleLabel(vehicle);

    private string GetVehicleLabel(int vmfCode)
        => _vehicleLabelByVmf.TryGetValue(vmfCode, out var label) ? label : vmfCode.ToString();

    private void ResetSelection()
    {
        _selectedId = 0;
        _newEndDate = DateTime.Today.AddMonths(1);
        _message = string.Empty;
        _error = false;
    }
}
