@page "/full-maintenance-lease/tariffs"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject LeaseContractTermsApiService LeaseService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Capturing of Tariffs for Lease Vehicles</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-check"></i>
            Capturing of Tariffs for Lease Vehicles
        </h1>
        <p class="page-description">Review captured lease tariffs and open a record for approval/edit.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/full-maintenance-lease">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="alert alert-info fis-alert-tight">
        <i class="bx bx-info-circle"></i>
        <span>This screen supports the lease tariff approval workflow. Capturers edit pending or rejected items; financial authorisers review pending items captured by other users.</span>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h2>Workflow queue</h2>
            <p>Filter the queue by authority status, then open a record for review, edit, or view-only access.</p>
        </div>
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Authority Status</label>
                <select class="form-select" @bind="_statusFilter" @bind:after="OnStatusFilterChanged">
                    <option value="all">All</option>
                    <option value="pending">Pending</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading lease tariff records...</p>
        </div>
    }
    else if (FilteredItemsList.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No records found</h3>
            <p>No lease tariff records match the selected filter.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@FilteredItemsList.Count record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Fixed Amount</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedFilteredItems)
                        {
                            <tr>
                                <td>@item.TermId</td>
                                <td>@GetVehicleLabel(item.VmfCode)</td>
                                <td><span class="@GetStatusBadgeClass(item.AuthorityStatus)">@MapStatus(item.AuthorityStatus)</span></td>
                                <td>@FormatDate(item.EffectiveStartDate)</td>
                                <td>@FormatDate(item.EffectiveEndDate)</td>
                                <td>@FormatCurrency(item.FixedMonthlyAmount)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn btn-secondary btn-sm" href="@BuildDetailsLink(item)">@GetActionLabel(item)</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string _statusFilter = "all";
    private List<FullMaintenanceLeaseTermDto> _items = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private int? _currentUserAccessCode;
    private long _currentAccessLevel;
    private bool _hasFinancialAccess;
    private Dictionary<int, string> _vehicleLabelByVmf = new();

    private List<FullMaintenanceLeaseTermDto> FilteredItemsList =>
        _statusFilter switch
        {
            "pending" => _items.Where(x => (x.AuthorityStatus ?? 0) == 1).ToList(),
            "approved" => _items.Where(x => (x.AuthorityStatus ?? 0) == 2).ToList(),
            "rejected" => _items.Where(x => (x.AuthorityStatus ?? 0) == 4).ToList(),
            _ => _items
        };
    private IEnumerable<FullMaintenanceLeaseTermDto> PagedFilteredItems => FilteredItemsList.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItemsList.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await LeaseService.GetAllAsync<FullMaintenanceLeaseTermDto>();
            if (_vehicleLabelByVmf.Count == 0)
            {
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _vehicleLabelByVmf = vehicles.Data
                    .GroupBy(v => v.vmf_code)
                    .ToDictionary(
                        g => g.Key,
                        g => FormatVehicleLabel(g.First()));
            }
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _items = new List<FullMaintenanceLeaseTermDto>();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading lease tariff capture list: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string MapStatus(int? status) => FullMaintenanceLeaseUi.MapAuthorityStatus(status);
    private static string GetStatusBadgeClass(int? status) => FullMaintenanceLeaseUi.GetAuthorityBadgeClass(status);

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string FormatCurrency(decimal? value)
        => value.HasValue ? $"R {value.Value:N2}" : "-";

    private static string ValueOrDash(string? value)
        => FullMaintenanceLeaseUi.ValueOrDash(value);
    private static string FormatVehicleLabel(VehicleDto vehicle)
        => FullMaintenanceLeaseUi.FormatVehicleLabel(vehicle);

    private string GetVehicleLabel(int vmfCode)
        => _vehicleLabelByVmf.TryGetValue(vmfCode, out var label) ? label : $"- / - ({vmfCode})";

    private string BuildDetailsLink(FullMaintenanceLeaseTermDto item)
    {
        var mode = GetWorkflowMode(item);
        return $"/full-maintenance-lease/tariffs/details?id={item.TermId}&mode={mode}";
    }

    private string GetActionLabel(FullMaintenanceLeaseTermDto item)
    {
        return GetWorkflowMode(item) switch
        {
            "review" => "Review",
            "edit" => "Edit",
            _ => "View"
        };
    }

    private string GetWorkflowMode(FullMaintenanceLeaseTermDto item)
    {
        var status = item.AuthorityStatus ?? 0;
        var isCapturer = IsCurrentUserCapturer(item);
        var pendingOrRejected = status == 1 || status == 4;

        if (status == 1 && _hasFinancialAccess && !isCapturer)
        {
            return "review";
        }

        if (pendingOrRejected && isCapturer)
        {
            return "edit";
        }

        return "view";
    }

    private bool IsCurrentUserCapturer(FullMaintenanceLeaseTermDto item)
    {
        return _currentUserAccessCode is > 0
            && item.created_by_user_code is > 0
            && item.created_by_user_code.Value == _currentUserAccessCode.Value;
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _hasFinancialAccess = false;
            return;
        }

        _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (!long.TryParse(accessLevelClaim, out _currentAccessLevel))
        {
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            _currentAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(_currentUserAccessCode, firstName);
        }

        _hasFinancialAccess =
            (_currentAccessLevel & LegacyPermissionBits.Financial) == LegacyPermissionBits.Financial;
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private void OnStatusFilterChanged()
    {
        _page = 1;
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

}
