@page "/full-maintenance-lease/reports/filter"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Report Filter</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-filter"></i>
            Report Filter
        </h1>
        <p class="page-description">Select report date range or financial year.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@_reportCaption</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <InputDate class="form-input" @bind-Value="_filter.StartDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <InputDate class="form-input" @bind-Value="_filter.EndDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">Financial Year</label>
                    <InputSelect class="form-select" @bind-Value="_filter.FinancialYear">
                        @foreach (var year in FinancialYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label class="form-label">GG / GP Number Filter</label>
                    <InputText class="form-input" @bind-Value="_filter.GgNumber" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ViewReport">View Report</button>
                <button class="btn btn-secondary" @onclick="GoBack">&lt;&lt; Back</button>
                <button class="btn btn-secondary" @onclick="Clear">Clear</button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "report")]
    public string? ReportKey { get; set; }

    private readonly ReportFilterModel _filter = new();

    private readonly List<string> FinancialYears = new()
    {
        "Select...",
        "2023/2024",
        "2024/2025",
        "2025/2026"
    };

    private string _reportCaption = "Report Filter";

    protected override void OnInitialized()
    {
        _reportCaption = ReportKey switch
        {
            "maintenance-history" => "FML Vehicle Maintenance History",
            "over-utilized" => "List of over utilized FML vehicles (based on km's)",
            _ => "Report Filter"
        };
    }

    private void ViewReport()
    {
        var target = ReportKey switch
        {
            "maintenance-history" => "/full-maintenance-lease/reports/maintenance-history",
            "over-utilized" => "/full-maintenance-lease/reports/over-utilized",
            _ => "/full-maintenance-lease/reports"
        };

        Navigation.NavigateTo(target);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/full-maintenance-lease/reports");
    }

    private void Clear()
    {
        _filter.StartDate = null;
        _filter.EndDate = null;
        _filter.FinancialYear = "Select...";
        _filter.GgNumber = "";
    }

    private sealed class ReportFilterModel
    {
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string FinancialYear { get; set; } = "Select...";
        public string? GgNumber { get; set; }
    }
}
