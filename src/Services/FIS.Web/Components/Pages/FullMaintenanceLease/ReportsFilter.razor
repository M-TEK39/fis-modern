@page "/full-maintenance-lease/reports/filter"
@page "/NOMPending/NOMRpt_SelectDatesOrFinYear.aspx"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Report Filter</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-filter"></i>
            Report Filter
        </h1>
        <p class="page-description">Select report date range or financial year.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>@_reportCaption</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Start Date</label>
                    <InputDate class="form-input" @bind-Value="_filter.StartDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">End Date</label>
                    <InputDate class="form-input" @bind-Value="_filter.EndDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">Financial Year</label>
                    <InputSelect class="form-select" @bind-Value="_filter.FinancialYear">
                        @foreach (var year in FinancialYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_filter.SearchMode == VehicleSearchHelper.GgMode)" @onchange='() => SetSearchMode(VehicleSearchHelper.GgMode)' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_filter.SearchMode == VehicleSearchHelper.GpMode)" @onchange='() => SetSearchMode(VehicleSearchHelper.GpMode)' />
                            GP
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_filter.SearchMode == VehicleSearchHelper.EngineMode)" @onchange='() => SetSearchMode(VehicleSearchHelper.EngineMode)' />
                            Engine
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_filter.SearchMode == VehicleSearchHelper.VinMode)" @onchange='() => SetSearchMode(VehicleSearchHelper.VinMode)' />
                            VIN / Chassis
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_filter.SearchMode == VehicleSearchHelper.InvoiceMode)" @onchange='() => SetSearchMode(VehicleSearchHelper.InvoiceMode)' />
                            Invoice
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@VehicleSearchHelper.GetSearchLabel(_filter.SearchMode)</label>
                    <InputText class="form-input" @bind-Value="_filter.SearchValue" placeholder="@VehicleSearchHelper.GetSearchPlaceholder(_filter.SearchMode)" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ViewReport">View Report</button>
                <button class="btn btn-secondary" @onclick="GoBack">&lt;&lt; Back</button>
                <button class="btn btn-secondary" @onclick="Clear">Clear</button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "report")]
    public string? ReportKey { get; set; }

    [SupplyParameterFromQuery(Name = "Follow_Page")]
    public string? LegacyFollowPage { get; set; }

    [SupplyParameterFromQuery(Name = "caption")]
    public string? LegacyCaption { get; set; }

    private readonly ReportFilterModel _filter = new();

    private readonly List<string> FinancialYears = new()
    {
        "Select...",
        "2023/2024",
        "2024/2025",
        "2025/2026"
    };

    private string _reportCaption = "Report Filter";

    protected override void OnInitialized()
    {
        var reportKey = ResolveReportKey();
        _reportCaption = !string.IsNullOrWhiteSpace(LegacyCaption)
            ? LegacyCaption
            : reportKey switch
        {
            "maintenance-history" => "FML Vehicle Maintenance History",
            "over-utilized" => "List of over utilized FML vehicles (based on km's)",
            _ => "Report Filter"
        };
    }

    private void ViewReport()
    {
        var target = ResolveReportKey() switch
        {
            "maintenance-history" => "/full-maintenance-lease/reports/maintenance-history",
            "over-utilized" => "/full-maintenance-lease/reports/over-utilized",
            _ => "/full-maintenance-lease/reports"
        };

        var query = BuildQueryString();
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(query) ? target : $"{target}{query}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/full-maintenance-lease/reports");
    }

    private string? ResolveReportKey()
    {
        if (!string.IsNullOrWhiteSpace(ReportKey))
        {
            return ReportKey;
        }

        return LegacyFollowPage switch
        {
            "Rpt_FMLVehicleMaintenanceHistory" => "maintenance-history",
            "Rpt_OverUtilizedFMLVehiclesOnKm" => "over-utilized",
            _ => null
        };
    }

    private void Clear()
    {
        _filter.StartDate = null;
        _filter.EndDate = null;
        _filter.FinancialYear = "Select...";
        _filter.SearchMode = VehicleSearchHelper.GgMode;
        _filter.SearchValue = "";
    }

    private string BuildQueryString()
    {
        var queryParts = new List<string>();
        if (_filter.StartDate.HasValue)
        {
            queryParts.Add($"startDate={Uri.EscapeDataString(_filter.StartDate.Value.ToString("yyyy-MM-dd"))}");
        }

        if (_filter.EndDate.HasValue)
        {
            queryParts.Add($"endDate={Uri.EscapeDataString(_filter.EndDate.Value.ToString("yyyy-MM-dd"))}");
        }

        if (!string.IsNullOrWhiteSpace(_filter.FinancialYear) && _filter.FinancialYear != "Select...")
        {
            queryParts.Add($"finYear={Uri.EscapeDataString(_filter.FinancialYear)}");
        }

        if (!string.IsNullOrWhiteSpace(_filter.SearchValue))
        {
            queryParts.Add($"mode={Uri.EscapeDataString(_filter.SearchMode)}");
            queryParts.Add($"search={Uri.EscapeDataString(_filter.SearchValue.Trim())}");
            if (_filter.SearchMode == VehicleSearchHelper.GgMode)
            {
                queryParts.Add($"ggNum={Uri.EscapeDataString(_filter.SearchValue.Trim())}");
            }
        }

        return queryParts.Count > 0 ? "?" + string.Join("&", queryParts) : string.Empty;
    }

    private void SetSearchMode(string mode)
    {
        _filter.SearchMode = VehicleSearchHelper.NormalizeMode(mode);
    }

    private sealed class ReportFilterModel
    {
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string FinancialYear { get; set; } = "Select...";
        public string SearchMode { get; set; } = VehicleSearchHelper.GgMode;
        public string? SearchValue { get; set; }
    }
}
