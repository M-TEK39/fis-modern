@page "/clearance/entry"
@page "/clearance/MNT_Clear_Getreg.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using System.Linq
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject ClearanceApiService ClearanceService
@inject MerchantApiService MerchantService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>Clearance Entry - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield"></i>
            Clearance Entry
        </h1>
        <p class="page-description">Clearance entry screen that captures number, merchant, amount, and kilos.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/clearance")'>
            <i class="bx bx-arrow-back"></i>
            Back to Clearance Menu
        </button>
    </div>
</div>

<div class="page-content">
    <EditForm Model="_form" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Vehicle</label>
                <div class="contract-search-radio">
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                        GG
                    </label>
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                        GP
                    </label>
                </div>
                <div class="fis-input-group-compact">
                    <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                </div>
                <select class="form-select fis-mt-05" @bind="_form.VmfCode" disabled="@(_vehicleMatches.Count == 0)">
                    <option value="">Select vehicle...</option>
                    @foreach (var vehicle in _vehicleMatches)
                    {
                        <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">Clearance Number</label>
                <InputNumber class="form-input" @bind-Value="_form.ClearanceNumber" />
            </div>
            <div class="form-field">
                <label class="form-label">Clearance Date</label>
                <InputDate class="form-input" @bind-Value="_form.ClearanceDate" />
            </div>
            <div class="form-field">
                <label class="form-label">Merchant</label>
                <select class="form-select" @bind="_form.MerchantCode">
                    <option value="">Select...</option>
                    @foreach (var merchant in _merchants)
                    {
                        <option value="@merchant.Merchant_code">@($"{merchant.Merchant_Name} ({merchant.Merchant_code})")</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">Clearance Amount</label>
                <InputNumber class="form-input" @bind-Value="_form.Amount" />
            </div>
            <div class="form-field">
                <label class="form-label">Clearance Kilos</label>
                <InputNumber class="form-input" @bind-Value="_form.Kilos" />
            </div>
            <div class="form-field">
                <label class="form-label">Comments</label>
                <InputTextArea class="form-input" rows="3" @bind-Value="_form.Comment" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary">
                <i class="bx bx-save"></i>
                Save
            </button>
            <button class="btn btn-secondary" type="button" @onclick="ResetForm">
                Reset
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">
                @_error
            </div>
        }
        @if (_saved)
        {
            <div class="alert alert-success">
                Clearance saved for @(_form.ClearanceNumber).
            </div>
        }
    </EditForm>
</div>

@code {
    private readonly ClearanceForm _form = new();
    private bool _saved;
    private string? _error;
    private string _searchMode = "GG";
    private List<MerchantDto> _merchants = new();
    private string _vehicleSearchTerm = string.Empty;
    private List<VehicleDto> _vehicleMatches = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMerchants();
        _form.VmfCode = GetQueryInt("vmf");
        if (_form.VmfCode.HasValue)
        {
            _vehicleSearchTerm = _form.VmfCode.Value.ToString();
        }
    }

    private async Task LoadMerchants()
    {
        try
        {
            _merchants = await MerchantService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = "Failed to load merchants.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
        finally { }
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _saved = false;
        if (_form.VmfCode is null or <= 0)
        {
            _error = "Vehicle is required.";
            return;
        }

        var payload = new ClearanceCreateDto
        {
            vmf_code = _form.VmfCode.Value,
            clearance_number = _form.ClearanceNumber,
            Clearance_date = _form.ClearanceDate,
            Merchant_code = _form.MerchantCode,
            Clearance_amount = _form.Amount,
            clearance_kilo = _form.Kilos.HasValue ? (int?)Convert.ToInt32(_form.Kilos.Value) : null,
            clearance_comment = _form.Comment
        };

        try
        {
            var result = await ClearanceService.CreateAsync(payload);
            _saved = result != null;
        }
        catch (Exception ex)
        {
            _error = "Failed to save clearance.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void ResetForm()
    {
        _form.Reset();
        _vehicleSearchTerm = string.Empty;
        _vehicleMatches = new();
        _saved = false;
    }

    private async Task SearchVehiclesAsync()
    {
        _error = null;
        var keyword = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            _vehicleMatches = new();
            _form.VmfCode = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);

            if (_vehicleMatches.All(v => v.vmf_code != _form.VmfCode))
            {
                _form.VmfCode = null;
            }
        }
        catch (Exception ex)
        {
            _error = "Failed to search vehicles.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private int? GetQueryInt(string name)
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue(name, out var values) && int.TryParse(values.FirstOrDefault(), out var value))
        {
            return value;
        }

        return null;
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _form.VmfCode = null;
    }

    private sealed class ClearanceForm
    {
        public int? VmfCode { get; set; }
        public int? ClearanceNumber { get; set; }
        public DateTime ClearanceDate { get; set; } = DateTime.Today;
        public int? MerchantCode { get; set; }
        public decimal? Amount { get; set; }
        public decimal? Kilos { get; set; }
        [MaxLength(80)]
        public string Comment { get; set; } = string.Empty;

        public void Reset()
        {
            VmfCode = null;
            ClearanceNumber = null;
            ClearanceDate = DateTime.Today;
            MerchantCode = null;
            Amount = null;
            Kilos = null;
            Comment = string.Empty;
        }
    }
}
