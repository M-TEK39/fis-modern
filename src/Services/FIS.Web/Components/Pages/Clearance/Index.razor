@page "/clearance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject ClearanceApiService ClearanceService
@inject IJSRuntime JSRuntime

<PageTitle>Clearance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield-quarter"></i>
            Clearance
        </h1>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleEntry">
                <span>Clearance Maintenance Menu:</span>
                <i class="bx @(_showEntry ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showEntry)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/clearance/entry">1) Enter Clearance</a>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleMerchants">
                <span>Merchants</span>
                <i class="bx @(_showMerchants ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showMerchants)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/clearance/merchant">1) Merchant Maintenance</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <DataPreviewTable Title="Clearance Preview"
                      SearchPlaceholder="Search clearance number, GG code, merchant, comments..."
                      EmptyMessage="No clearance records match the current search or filter."
                      EmptyIcon="bx bx-shield-quarter"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _showEntry = true;
    private bool _showMerchants = true;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("clearanceNumber", "Clearance No."),
        new("vmfCode", "GG Code"),
        new("date", "Date"),
        new("merchant", "Merchant"),
        new("amount", "Amount"),
        new("kilometres", "Km"),
        new("comment", "Comment")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Records with merchant", "merchantStatus", "Merchant Linked"),
        new("Records without merchant", "merchantStatus", "No Merchant"),
        new("Records with amount", "amountStatus", "Amount Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private void ToggleEntry() => _showEntry = !_showEntry;
    private void ToggleMerchants() => _showMerchants = !_showMerchants;

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var clearances = await ClearanceService.GetAllAsync();
            _rows = clearances
                .OrderByDescending(item => item.Clearance_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["clearanceNumber"] = item.clearance_number?.ToString(),
                    ["vmfCode"] = item.vmf_code.ToString(),
                    ["date"] = FormatDate(item.Clearance_date),
                    ["merchant"] = item.Merchant_code?.ToString(),
                    ["amount"] = item.Clearance_amount?.ToString("C0"),
                    ["kilometres"] = item.clearance_kilo?.ToString(),
                    ["comment"] = item.clearance_comment,
                    ["merchantStatus"] = item.Merchant_code.HasValue ? "Merchant Linked" : "No Merchant",
                    ["amountStatus"] = item.Clearance_amount.HasValue ? "Amount Captured" : "No Amount"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading clearance preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
