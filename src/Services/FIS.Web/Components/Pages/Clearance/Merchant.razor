@page "/clearance/merchant"
@page "/clearance/MNT_Merchant.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject MerchantApiService MerchantService
@inject IJSRuntime JS

<PageTitle>Merchant Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-store"></i>
            Merchant Maintenance
        </h1>
        <p class="page-description">Merchant lookup, add, edit, and delete workflow.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/clearance")'>
            <i class="bx bx-arrow-back"></i>
            Back to Clearance Menu
        </button>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Select Merchant to Edit or Delete</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Merchant</label>
                        <select class="form-select" @bind="_selectedMerchantId">
                            <option value="">Select...</option>
                            @foreach (var merchant in _merchants)
                            {
                                <option value="@merchant.Merchant_code">@($"{merchant.Merchant_Name} ({merchant.Merchant_code})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">&nbsp;</label>
                        <div class="form-actions">
                            <button class="btn btn-primary btn-sm" @onclick="EditMerchant">
                                <i class="bx bx-edit"></i>
                                Edit
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="DeleteMerchant">
                                <i class="bx bx-trash"></i>
                                Delete
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick="AddMerchant">
                                <i class="bx bx-plus"></i>
                                Add New
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-section">
                <h2 class="form-section-title">Add Merchant</h2>
                <EditForm Model="_form" OnValidSubmit="HandleAdd">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Merchant Name</label>
                            <InputText class="form-input" @bind-Value="_form.Name" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">
                            <i class="bx bx-save"></i>
                            Save Merchant
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="alert alert-danger">
                            @_error
                        </div>
                    }
                    @if (_merchantSaved)
                    {
                        <div class="alert alert-success">
                            Merchant @_form.Name saved.
                        </div>
                    }
                </EditForm>
            </div>
        </div>
    </div>
    <div class="table-container mt-4">
        <div class="table-header">
            <span class="table-title">Existing Merchants</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Merchant ID</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Last Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var merchant in PagedMerchants)
                    {
                        <tr>
                            <td>@merchant.Merchant_code</td>
                            <td>@merchant.Merchant_Name</td>
                            <td>-</td>
                            <td>-</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_merchants.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_merchants.Count | Page size: @_pageSize</div>
        }
    </div>
</div>

@code {
    private int? _selectedMerchantId;
    private readonly MerchantForm _form = new();
    private bool _merchantSaved;
    private string? _error;
    private List<MerchantDto> _merchants = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<MerchantDto> PagedMerchants => _merchants.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_merchants.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadMerchants();
    }

    private async Task LoadMerchants()
    {
        try
        {
            _merchants = await MerchantService.GetAllAsync();
            if (_page > TotalPages)
            {
                _page = TotalPages;
            }
        }
        catch (Exception ex)
        {
            _error = "Failed to load merchants.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
        finally { }
    }

    private async Task EditMerchant()
    {
        if (_selectedMerchantId is null)
        {
            _error = "Select a merchant to edit.";
            return;
        }

        var selected = _merchants.FirstOrDefault(m => m.Merchant_code == _selectedMerchantId);
        if (selected == null)
        {
            _error = "Selected merchant not found.";
            return;
        }

        _form.Name = selected.Merchant_Name ?? string.Empty;
        _merchantSaved = false;
        _error = null;
        await JS.InvokeVoidAsync("console.info", $"Editing merchant {selected.Merchant_code}");
    }

    private async Task DeleteMerchant()
    {
        if (_selectedMerchantId is null)
        {
            _error = "Select a merchant to delete.";
            return;
        }

        try
        {
            await MerchantService.DeleteAsync(_selectedMerchantId.Value);
            await LoadMerchants();
            _merchantSaved = false;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = "Failed to delete merchant.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void AddMerchant()
    {
        _form.Reset();
        _merchantSaved = false;
        _error = null;
        _selectedMerchantId = null;
    }

    private async Task HandleAdd()
    {
        _merchantSaved = false;
        _error = null;
        var payload = new MerchantCreateDto
        {
            Merchant_Name = _form.Name
        };

        try
        {
            if (_selectedMerchantId.HasValue)
            {
                await MerchantService.UpdateAsync(_selectedMerchantId.Value, payload);
            }
            else
            {
                await MerchantService.CreateAsync(payload);
            }

            await LoadMerchants();
            _merchantSaved = true;
            _page = 1;
        }
        catch (Exception ex)
        {
            _error = "Failed to save merchant.";
            await JS.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed class MerchantForm
    {
        [Required]
        [MaxLength(30)]
        public string Name { get; set; } = string.Empty;

        public void Reset()
        {
            Name = string.Empty;
        }
    }
}
