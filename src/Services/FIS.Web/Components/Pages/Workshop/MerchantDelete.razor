@page "/workshop/merchant/delete"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Delete Merchant</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Merchant
        </h1>
        <p class="page-description">Delete workflow placeholder.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p>Merchant deletion will be wired once backend endpoints are available.</p>
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="GoBack">Back</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Menu</button>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/workshop/merchant");
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/workshop");
    }
}
