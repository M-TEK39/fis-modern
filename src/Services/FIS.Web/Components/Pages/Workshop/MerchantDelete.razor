@page "/workshop/merchant/delete"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject MerchantApiService MerchantService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Delete Merchant</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-trash"></i>Delete Merchant</h1>
        <p class="page-description">Delete a merchant record.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/workshop/merchant">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Merchant</label>
                <select class="form-select" @bind="Id">
                    <option value="">Select merchant...</option>
                    @foreach (var merchant in _merchants)
                    {
                        <option value="@merchant.Merchant_code">@($"{merchant.Merchant_Name} ({merchant.Merchant_code})")</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@_running">Delete</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? Id { get; set; }

    private bool _running;
    private bool _error;
    private string _message = string.Empty;
    private List<MerchantDto> _merchants = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _merchants = await MerchantService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Unable to load merchants.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading merchants: {ex.Message}");
        }
    }

    private async Task DeleteAsync()
    {
        _error = false;
        _message = string.Empty;
        if (!Id.HasValue || Id.Value <= 0)
        {
            _error = true;
            _message = "Select a valid merchant.";
            return;
        }

        _running = true;
        try
        {
            await MerchantService.DeleteAsync(Id.Value);
            _message = "Merchant deleted.";
            Navigation.NavigateTo("/workshop/merchant");
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Failed to delete merchant.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error deleting merchant: {ex.Message}");
        }
        finally
        {
            _running = false;
        }
    }
}
