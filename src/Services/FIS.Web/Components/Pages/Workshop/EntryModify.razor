@page "/workshop/entry/modify"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Modify Workshop Entry</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit"></i>
            Modify Workshop Entry
        </h1>
        <p class="page-description">Edit existing workshop entry (placeholder).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p>Modify workflow will be wired once workshop entry endpoints are available.</p>
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="GoBack">Back</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Menu</button>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/workshop/entry");
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/workshop");
    }
}
