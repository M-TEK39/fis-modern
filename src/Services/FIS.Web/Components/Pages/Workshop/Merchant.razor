@page "/workshop/merchant"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Merchant Info Maintenance</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-store"></i>
            Merchant Info Maintenance
        </h1>
        <p class="page-description">Search and update workshop merchants.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Name</label>
                    <InputText class="form-input" @bind-Value="_merchantName" maxlength="30" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Submit">Submit</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Menu</button>
            </div>
        </div>
    </div>

    <div class="table-container" style="margin-top: 1.5rem;">
        <div class="table-header">
            <span class="table-title">Merchants</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Merchant Name</th>
                        <th>Area Operate</th>
                        <th>Tel</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_merchants.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No merchants found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var merchant in _merchants)
                        {
                            <tr>
                                <td>@merchant.Name</td>
                                <td>@merchant.Area</td>
                                <td>@merchant.Tel</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn-icon btn-icon-edit" href="/workshop/merchant/edit">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <a class="btn-icon btn-icon-delete" href="/workshop/merchant/delete">
                                            <i class="bx bx-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 1rem;">
        <strong>Date Last Modified: @DateTime.Now.ToString("yyyy-MM-dd")</strong>
    </div>
</div>

@code {
    private string _merchantName = "";
    private readonly List<MerchantRow> _merchants = new();

    private void Submit()
    {
        // Placeholder for merchant search.
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/workshop");
    }

    private sealed class MerchantRow
    {
        public string Name { get; set; } = "";
        public string Area { get; set; } = "";
        public string Tel { get; set; } = "";
    }
}
