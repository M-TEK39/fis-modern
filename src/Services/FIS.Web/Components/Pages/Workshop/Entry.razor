@page "/workshop/entry"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject WorkshopApiService WorkshopService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>WorkShop Entry</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            WorkShop Entry
        </h1>
        <p class="page-description">Search for a vehicle to capture or update a workshop entry.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">@(_lookupType == "GP" ? "GP Number" : "GG Number")</label>
                    <InputText class="form-input" @bind-Value="_vehicleNumber" />
                    <div class="form-actions" style="margin-top: 0.5rem;">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Search vehicle</button>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_selectedVehicleVmfCode" @bind:after="ApplySelectedVehicle">
                        <option value="">Select vehicle</option>
                        @foreach (var vehicle in _vehicleMatches)
                        {
                            <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Lookup Type</label>
                    <div class="form-grid">
                        <label class="form-label">
                            <input type="radio" name="lookup" checked="@(_lookupType == "GG")" @onchange='() => SetLookupType("GG")' />
                            GG
                        </label>
                        <label class="form-label">
                            <input type="radio" name="lookup" checked="@(_lookupType == "GP")" @onchange='() => SetLookupType("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Show Dept By</label>
                    <div class="form-grid">
                        <label class="form-label">
                            <input type="radio" name="dept" checked="@(_deptBy == "Code")" @onchange='() => SetDeptBy("Code")' />
                            Code
                        </label>
                        <label class="form-label">
                            <input type="radio" name="dept" checked="@(_deptBy == "Name")" @onchange='() => SetDeptBy("Name")' />
                            Name (Description)
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Submit">Submit</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Menu</button>
            </div>
        </div>
    </div>

    <div class="table-container fis-mt-15">
        <div class="table-header">
            <span class="table-title">Previous Workshop Entries</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vehicle Number</th>
                        <th>Department</th>
                        <th>Date Received</th>
                        <th>Inquiry Refer</th>
                        <th>Workshop</th>
                        <th>Job Card CLOSED?</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="7">Loading entries...</td>
                        </tr>
                    }
                    else if (_entries.Count == 0)
                    {
                        <tr>
                            <td colspan="7">No previous records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entry in PagedEntries)
                        {
                            <tr>
                                <td>@entry.VehicleNumber</td>
                                <td>@GetDepartmentDisplay(entry)</td>
                                <td>@entry.DateReceived</td>
                                <td>@entry.InquiryRefer</td>
                                <td>@entry.WorkshopType</td>
                                <td>@entry.JobClosed</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn-icon btn-icon-edit" href="@($"/workshop/entry/modify?id={entry.InquiryRefer}")">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <a class="btn-icon btn-icon-delete" href="@($"/workshop/entry/delete?id={entry.InquiryRefer}")">
                                            <i class="bx bx-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_entries.Count > _pageSize)
        {
            <div class="pagination">
                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_entryPage <= 1)">Previous</button>
                <div class="pagination-info">Page @_entryPage of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_entryPage >= TotalPages)">Next</button>
            </div>
            <div class="pagination-meta">Total records: @_entries.Count | Page size: @_pageSize</div>
        }
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="AddEntry">Add</button>
        </div>
    </div>
</div>

@code {
    private string _vehicleNumber = "";
    private string _lookupType = "GG";
    private string _deptBy = "Code";

    private readonly List<WorkshopEntryRow> _entries = new();
    private List<WorkshopEntryRow> _allEntries = new();
    private List<FIS.Web.Models.VehicleDto> _vehicleMatches = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int? _selectedVehicleVmfCode;
    private bool _loading = true;
    private FIS.Web.Models.VehicleDto? _selectedVehicle;
    private readonly int _pageSize = 12;
    private int _entryPage = 1;

    private IEnumerable<WorkshopEntryRow> PagedEntries
        => _entries
            .Skip((_entryPage - 1) * _pageSize)
            .Take(_pageSize);

    private int TotalPages
        => Math.Max(1, (int)Math.Ceiling(_entries.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _loading = true;
        try
        {
            if (_vehicleLabelByVmf.Count == 0)
            {
                var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
                _vehicleLabelByVmf = vehicles.Data
                    .GroupBy(v => v.vmf_code)
                    .ToDictionary(
                        g => g.Key,
                        g => GetVehicleLabel(g.First()));
            }

            var items = await WorkshopService.GetAllAsync<WorkshopDto>();
            _allEntries = items.Select(item => new WorkshopEntryRow
            {
                VmfCode = item.vmf_code,
                VehicleNumber = GetVehicleLabel(item.vmf_code),
                DateReceived = FormatDate(item.receive_date),
                DateReceivedSort = item.receive_date,
                InquiryRefer = item.ww_code.ToString(),
                WorkshopType = "Workshop",
                JobClosed = item.complete_time.HasValue ? "Yes" : "No"
            }).ToList();
            _entries.Clear();
            _entries.AddRange(_allEntries);
            ResetPagination();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading workshop entries: {ex.Message}");
            _entries.Clear();
            _allEntries = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_vehicleNumber))
        {
            _selectedVehicle = null;
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _entries.Clear();
            _entries.AddRange(OrderEntries(_allEntries));
            ResetPagination();
            return;
        }

        try
        {
            await SearchVehiclesAsync();
            var match = _selectedVehicle;

            if (match == null)
            {
                _selectedVehicle = null;
                _entries.Clear();
                return;
            }

            _selectedVehicle = match;

            var filtered = _allEntries.Where(e => e.VmfCode == match.vmf_code).ToList();
            _entries.Clear();

            if (filtered.Count == 0)
            {
                _entries.Add(new WorkshopEntryRow
                {
                    VmfCode = match.vmf_code,
                    VehicleNumber = GetVehicleLabel(match),
                    DepartmentCode = ValueOrDash(match.location_code.ToString()),
                    DepartmentName = ValueOrDash(match.location_description),
                    DateReceived = "-",
                    DateReceivedSort = null,
                    InquiryRefer = "-",
                    WorkshopType = "Workshop",
                    JobClosed = "No entries yet"
                });
                ResetPagination();
            }
            else
            {
                foreach (var row in filtered)
                {
                    row.VehicleNumber = GetVehicleLabel(match);
                    row.DepartmentCode = ValueOrDash(match.location_code.ToString());
                    row.DepartmentName = ValueOrDash(match.location_description);
                }

                _entries.AddRange(OrderEntries(filtered));
                ResetPagination();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error searching vehicle: {ex.Message}");
            _entries.Clear();
            ResetPagination();
        }
    }

    private async Task SearchVehiclesAsync()
    {
        var query = _vehicleNumber.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _selectedVehicle = null;
            return;
        }

        var matches = await VehicleService.SearchVehiclesAsync(query);
        _vehicleMatches = FilterVehicleMatches(matches, query, _lookupType);

        if (_vehicleMatches.All(vehicle => vehicle.vmf_code != _selectedVehicleVmfCode))
        {
            _selectedVehicleVmfCode = null;
            _selectedVehicle = null;
        }
    }

    private void ApplySelectedVehicle()
    {
        if (!_selectedVehicleVmfCode.HasValue)
        {
            _selectedVehicle = null;
            return;
        }

        _selectedVehicle = _vehicleMatches.FirstOrDefault(vehicle => vehicle.vmf_code == _selectedVehicleVmfCode.Value);
    }

    private void SetLookupType(string value)
    {
        _lookupType = value;
        _vehicleMatches = new();
        _selectedVehicleVmfCode = null;
        _selectedVehicle = null;
        if (!string.IsNullOrWhiteSpace(_vehicleNumber))
        {
            _ = SearchVehiclesAsync();
        }
    }

    private void SetDeptBy(string value)
    {
        _deptBy = value;
        if (_entries.Count > 0)
        {
            var current = _entries.ToList();
            _entries.Clear();
            _entries.AddRange(OrderEntries(current));
            ResetPagination();
        }
    }

    private void AddEntry()
    {
        Navigation.NavigateTo("/workshop/entry/details");
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/workshop");
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private IEnumerable<WorkshopEntryRow> OrderEntries(List<WorkshopEntryRow> source)
    {
        return _deptBy == "Name"
            ? source.OrderBy(x => x.DepartmentName)
            : source.OrderByDescending(x => x.DateReceivedSort);
    }

    private static string Normalize(string? value)
        => (value ?? string.Empty).Replace(" ", string.Empty).ToUpperInvariant();

    private static List<FIS.Web.Models.VehicleDto> FilterVehicleMatches(List<FIS.Web.Models.VehicleDto> matches, string query, string lookupType)
    {
        var keyword = query.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return new List<FIS.Web.Models.VehicleDto>();
        }

        return (lookupType == "GP"
            ? matches.Where(vehicle =>
                !string.IsNullOrWhiteSpace(vehicle.registration_number) &&
                vehicle.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            : matches.Where(vehicle =>
                !string.IsNullOrWhiteSpace(vehicle.fleet_number) &&
                vehicle.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(vehicle => lookupType == "GP"
                ? string.Equals(vehicle.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(vehicle.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string GetVehicleLabel(FIS.Web.Models.VehicleDto? vehicle)
        => vehicle == null
            ? "-"
            : $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "Unknown";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private string GetDepartmentDisplay(WorkshopEntryRow row)
        => _deptBy == "Name" ? row.DepartmentName : row.DepartmentCode;

    private void PrevPage()
    {
        if (_entryPage > 1)
        {
            _entryPage--;
        }
    }

    private void NextPage()
    {
        if (_entryPage < TotalPages)
        {
            _entryPage++;
        }
    }

    private void ResetPagination()
    {
        _entryPage = 1;
    }

    private sealed class WorkshopEntryRow
    {
        public int? VmfCode { get; set; }
        public string VehicleNumber { get; set; } = "";
        public string DepartmentCode { get; set; } = "-";
        public string DepartmentName { get; set; } = "-";
        public string DateReceived { get; set; } = "";
        public DateTime? DateReceivedSort { get; set; }
        public string InquiryRefer { get; set; } = "";
        public string WorkshopType { get; set; } = "";
        public string JobClosed { get; set; } = "";
    }

    private sealed class WorkshopDto
    {
        public short ww_code { get; set; }
        public int? vmf_code { get; set; }
        public DateTime? receive_date { get; set; }
        public DateTime? complete_time { get; set; }
    }
}
