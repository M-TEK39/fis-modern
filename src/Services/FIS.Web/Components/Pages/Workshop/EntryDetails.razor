@page "/workshop/entry/details"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Workshop Entry Details</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Workshop Entry Details
        </h1>
        <p class="page-description">Legacy workshop entry capture (details pending API wiring).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p>Workshop entry details will be captured here once the API fields are confirmed.</p>
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="GoBack">Back</button>
                <button class="btn btn-secondary" @onclick="GoMenu">Menu</button>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/workshop/entry");
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/workshop");
    }
}
