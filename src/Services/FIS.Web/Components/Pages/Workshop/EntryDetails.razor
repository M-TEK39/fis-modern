@page "/workshop/entry/details"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject WorkshopApiService WorkshopService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Workshop Entry Details</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-plus-circle"></i>Workshop Entry Details</h1>
        <p class="page-description">Capture a new workshop entry.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/workshop/entry">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">VMF Code</label>
                    <InputNumber @bind-Value="_item.vmf_code" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Receive Date</label>
                    <InputDate @bind-Value="_item.receive_date" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Receive Time</label>
                    <InputDate @bind-Value="_item.receive_time" class="form-input" />
                </div>
                <div class="form-field">
                    <label class="form-label">Complete Time</label>
                    <InputDate @bind-Value="_item.complete_time" class="form-input" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Submit</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private WorkshopDto _item = new() { receive_date = DateTime.Today };
    private bool _saving;
    private bool _error;
    private string _message = string.Empty;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = false;
        _message = string.Empty;
        try
        {
            var created = await WorkshopService.CreateAsync<WorkshopDto>(_item);
            _error = created == null;
            _message = _error ? "Failed to create workshop entry." : "Workshop entry created.";
            if (!_error)
            {
                Navigation.NavigateTo("/workshop/entry");
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Failed to create workshop entry.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error creating workshop entry: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class WorkshopDto
    {
        public short ww_code { get; set; }
        public int? vmf_code { get; set; }
        public DateTime? receive_time { get; set; }
        public DateTime? receive_date { get; set; }
        public DateTime? complete_time { get; set; }
    }
}
