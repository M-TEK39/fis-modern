@page "/workshop/entry/delete"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject WorkshopApiService WorkshopService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Delete Workshop Entry</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-trash"></i>Delete Workshop Entry</h1>
        <p class="page-description">Delete a workshop entry by ID.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/workshop/entry">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Number Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="lookupType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="lookupType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                    <div class="fis-input-group-compact">
                        <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchEntriesAsync" disabled="@_running">Find</button>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Workshop Entry</label>
                    <select class="form-select" @bind="_selectedEntryId" disabled="@(_entryMatches.Count == 0)">
                        <option value="">Select workshop entry...</option>
                        @foreach (var entry in _entryMatches)
                        {
                            <option value="@entry.ww_code">@GetEntryLabel(entry)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@_running">Delete</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success") fis-alert-tight">
            <i class="bx @(_error ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    private string _searchMode = "GG";
    private string _vehicleSearchTerm = string.Empty;
    private int? _selectedEntryId;
    private List<WorkshopDto> _allEntries = new();
    private List<WorkshopDto> _entryMatches = new();
    private List<FIS.Web.Models.VehicleDto> _vehicleMatches = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private bool _running;
    private bool _error;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        if (_vehicleLabelByVmf.Count == 0)
        {
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _vehicleLabelByVmf = vehicles.Data
                .GroupBy(v => v.vmf_code)
                .ToDictionary(g => g.Key, g => GetVehicleLabel(g.First()));
        }

        _allEntries = await WorkshopService.GetAllAsync<WorkshopDto>();
        _entryMatches = new(_allEntries.OrderByDescending(x => x.receive_date).ThenByDescending(x => x.ww_code));
    }

    private async Task SearchEntriesAsync()
    {
        _error = false;
        _message = string.Empty;
        _selectedEntryId = null;

        var query = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _entryMatches = new(_allEntries.OrderByDescending(x => x.receive_date).ThenByDescending(x => x.ww_code));
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = FilterVehicleMatches(matches, query, _searchMode);
            var matchedVmfCodes = _vehicleMatches.Select(x => x.vmf_code).ToHashSet();
            _entryMatches = _allEntries
                .Where(entry => entry.vmf_code.HasValue && matchedVmfCodes.Contains(entry.vmf_code.Value))
                .OrderByDescending(entry => entry.receive_date)
                .ThenByDescending(entry => entry.ww_code)
                .ToList();

        }
        catch (Exception ex)
        {
            _entryMatches = new();
            _error = true;
            _message = "Unable to search workshop entries.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error searching workshop entries: {ex.Message}");
        }
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _selectedEntryId = null;
        _entryMatches = new();
        _vehicleMatches = new();
    }

    private async Task DeleteAsync()
    {
        _message = string.Empty;
        _error = false;
        if (!_selectedEntryId.HasValue || _selectedEntryId.Value <= 0)
        {
            _error = true;
            _message = "Select a workshop entry.";
            return;
        }

        _running = true;
        try
        {
            await WorkshopService.DeleteAsync(_selectedEntryId.Value);
            _message = "Workshop entry deleted.";
            _selectedEntryId = null;
            await LoadEntriesAsync();
            await SearchEntriesAsync();
        }
        catch (Exception ex)
        {
            _error = true;
            _message = "Failed to delete workshop entry.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error deleting workshop entry: {ex.Message}");
        }
        finally
        {
            _running = false;
        }
    }

    private string GetEntryLabel(WorkshopDto entry)
    {
        var vehicleLabel = entry.vmf_code.HasValue && _vehicleLabelByVmf.TryGetValue(entry.vmf_code.Value, out var label)
            ? label
            : $"VMF {entry.vmf_code?.ToString() ?? "-"}";
        return $"{vehicleLabel} | Entry #{entry.ww_code} | Received {FormatDate(entry.receive_date)}";
    }

    private static string GetVehicleLabel(FIS.Web.Models.VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<FIS.Web.Models.VehicleDto> FilterVehicleMatches(List<FIS.Web.Models.VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private sealed class WorkshopDto
    {
        public short ww_code { get; set; }
        public int? vmf_code { get; set; }
        public DateTime? receive_date { get; set; }
    }
}
