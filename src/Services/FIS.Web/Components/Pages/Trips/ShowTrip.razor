@page "/trips/show"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components
@inject TripApiService TripService
@inject TripDriverApiService TripDriverService
@inject ContractApiService ContractService
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject UserApiService UserService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Show Trip Authority - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Trip Authority No: <span class="contract-muted">@GetTripAuthorityNumber()</span>
        </h1>
        <p class="page-description">Trip Status: <strong>@ValueOrDash(_trip?.Status ?? "Open")</strong></p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">&lt; Back to Trips</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_workflowNote))
    {
        <div class="alert alert-info">@_workflowNote</div>
    }

    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section fis-mb-1">
                <div class="form-hint">Trip Authority No : <strong>@GetTripAuthorityNumber()</strong> has the following information:</div>
            </div>

            <div class="tabs">
                <button class="tab @(_activeTab == "vehicle" ? "active" : "")" @onclick='() => SetActiveTab("vehicle")'>
                    Vehicle Information
                </button>
                <button class="tab @(_activeTab == "trip" ? "active" : "")" @onclick='() => SetActiveTab("trip")'>
                    Trip Information
                </button>
                <button class="tab @(_activeTab == "drivers" ? "active" : "")" @onclick='() => SetActiveTab("drivers")'>
                    Driver Information
                </button>
                <button class="tab @(_activeTab == "passengers" ? "active" : "")" @onclick='() => SetActiveTab("passengers")'>
                    Passenger Information
                </button>
                <button class="tab @(_activeTab == "routes" ? "active" : "")" @onclick='() => SetActiveTab("routes")'>
                    Route Information
                </button>
            </div>

            <div class="tab-content">
                @if (_activeTab == "vehicle")
                {
                    <div class="form-section">
                        <h3 class="form-section-title">Vehicle Information</h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><th>Department Name</th><td>@ValueOrDash(_department?.department_description)</td></tr>
                                        <tr><th>Site</th><td>@FormatSite(_site)</td></tr>
                                        <tr><th>Contract ID</th><td>@ValueOrDash(_trip?.ContractCode.ToString())</td></tr>
                                        <tr><th>Vehicle</th><td>@TripVehicleLabel()</td></tr>
                                        <tr><th>Fleet Number</th><td>@ValueOrDash(_vehicle?.fleet_number)</td></tr>
                                        <tr><th>Make</th><td>@ValueOrDash(_vehicle?.type_name)</td></tr>
                                        <tr><th>Model</th><td>@ValueOrDash(_vehicle?.model_name)</td></tr>
                                        <tr><th>Registration Number</th><td>@ValueOrDash(_vehicle?.registration_number)</td></tr>
                                        <tr><th>Start ODO Meter</th><td>@ValueOrDash(_contractStartOdometer?.ToString())</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeTab == "trip")
                {
                    <div class="form-section">
                        <h3 class="form-section-title">Trip Information</h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><th>Approver Name</th><td>@ValueOrDash(_trip?.ApproverName)</td></tr>
                                        <tr><th>Approver Rank</th><td>@ValueOrDash(_trip?.ApproverRank)</td></tr>
                                        <tr><th>Approver Telephone</th><td>@ValueOrDash(_trip?.ApproverTelephone)</td></tr>
                                        <tr><th>Expiry Date</th><td>@ValueOrDash(_trip?.ExpiryDate?.ToString("yyyy-MM-dd"))</td></tr>
                                        <tr><th>End ODO Meter</th><td>@ValueOrDash(_trip?.EndOdometer?.ToString())</td></tr>
                                        <tr><th>Trip Reason</th><td>@ValueOrDash(_trip?.Notes)</td></tr>
                                        <tr><th>Trip Type</th><td>@TripTypeLabel(_trip?.TripTypeCode)</td></tr>
                                        <tr><th>Trip Captured by</th><td>@FormatUser(_trip?.UserAccessCode)</td></tr>
                                        <tr><th>Contract Driver ID</th><td>@ValueOrDash(_contractDriverId)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeTab == "drivers")
                {
                    <div class="form-section">
                        <h3 class="form-section-title">Driver Information</h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        @if (_drivers.Count == 0)
                                        {
                                            <tr><td>No driver records found for this trip.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var driver in PagedDrivers)
                                            {
                                                <tr><td>@ValueOrDash(driver.driver_firstname) @ValueOrDash(driver.driver_surname)</td></tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (DriverTotalPages > 1)
                            {
                                <div class="pagination-controls">
                                    <button class="btn btn-secondary btn-sm" @onclick="PreviousDriverPage" disabled="@(_driverPage <= 1)">Previous</button>
                                    <span>Page @_driverPage of @DriverTotalPages</span>
                                    <button class="btn btn-secondary btn-sm" @onclick="NextDriverPage" disabled="@(_driverPage >= DriverTotalPages)">Next</button>
                                </div>
                            }
                        </div>
                        <div class="form-section fis-mt-1">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><th>Driver Name</th><td>@ValueOrDash(_drivers.FirstOrDefault()?.driver_firstname) @ValueOrDash(_drivers.FirstOrDefault()?.driver_surname)</td></tr>
                                        <tr><th>Driver ID</th><td>@ValueOrDash(_drivers.FirstOrDefault()?.driver_SA_id)</td></tr>
                                        <tr><th>Driver Passport</th><td>@ValueOrDash(_drivers.FirstOrDefault()?.driver_passportnumber)</td></tr>
                                        <tr><th>Primary</th><td>@ValueOrDash(_primaryDriver)</td></tr>
                                        <tr><th>Contract Driver ID</th><td>@ValueOrDash(_contractDriverId)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeTab == "passengers")
                {
                    <div class="form-section">
                        <h3 class="form-section-title">Passenger Information</h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><td>No passenger records found for this trip.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-section">
                        <h3 class="form-section-title">Route Information</h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><td>No route records found for this trip.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="form-section fis-mt-1">
                            <div class="form-row">
                                <label class="form-label">End ODO Meter</label>
                                <input class="form-input" type="number" @bind="_endOdometerInput" placeholder="Enter End ODO" />
                            </div>
                            <div class="form-hint">Only end odometer update is available on this screen with current APIs.</div>
                        </div>
                    </div>
                }
            </div>

            <div class="contract-action-group">
                <a class="btn btn-secondary" href="/trips">&lt; Back to Trips</a>
                <button class="btn btn-primary" @onclick="SaveAndCloseAsync" disabled="@_saving">Save and Close</button>
                <button class="btn btn-secondary" @onclick="SaveAndRenewAsync" disabled="@_saving">Save and Renew</button>
                <button class="btn btn-secondary" @onclick="PrintAuthorityAsync">Print Trip Authority</button>
                <button class="btn btn-secondary" @onclick="PrintInvoiceAsync">Print Invoice</button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tripId")] public string? TripId { get; set; }

    private string _activeTab = "vehicle";
    private TripDto? _trip;
    private VehicleDto? _vehicle;
    private SiteResponseDto? _site;
    private DepartmentDto? _department;
    private List<DriverDto> _drivers = new();
    private int _driverPage = 1;
    private const int _driverPageSize = 12;
    private string? _primaryDriver;
    private int? _contractStartOdometer;
    private string? _contractDriverId;
    private string _workflowNote = string.Empty;
    private bool _saving;
    private bool _isError;
    private string _message = string.Empty;
    private int? _endOdometerInput;
    private Dictionary<short, UserProfileDto> _userProfilesByCode = new();
    private IEnumerable<DriverDto> PagedDrivers => _drivers.Skip((_driverPage - 1) * _driverPageSize).Take(_driverPageSize);
    private int DriverTotalPages => Math.Max(1, (int)Math.Ceiling(_drivers.Count / (double)_driverPageSize));

    protected override async Task OnInitializedAsync()
    {
        var profiles = await UserService.GetAllProfilesAsync();
        _userProfilesByCode = profiles
            .Where(x => x.UserAccessCode > 0)
            .GroupBy(x => x.UserAccessCode)
            .ToDictionary(g => g.Key, g => g.First());

        if (!int.TryParse(TripId, out var tripId))
        {
            return;
        }

        _trip = await TripService.GetAsync(tripId);
        if (_trip == null)
        {
            return;
        }

        // Trip API returns contract_code; resolve VMF/site from contract for accurate view details.
        var vmfCode = _trip.VmfCode;
        int? siteCode = null;
        if (_trip.ContractCode > 0)
        {
            var contract = await ContractService.GetContractAsync(_trip.ContractCode);
            if (contract != null)
            {
                vmfCode = contract.vmf_code ?? vmfCode;
                siteCode = contract.site_code;
                _trip.VmfCode = vmfCode;
                _contractStartOdometer = contract.start_odometer;
                _contractDriverId = contract.driver_id;
            }
        }

        _vehicle = vmfCode > 0 ? await VehicleService.GetVehicleAsync(vmfCode) : null;
        siteCode ??= _vehicle?.site_code;
        if (siteCode != null)
        {
            _site = await SiteService.GetByIdAsync((short)siteCode.Value);
            if (_site?.DepartmentCode != null)
            {
                _department = await DepartmentService.GetDepartmentAsync(_site.DepartmentCode.Value);
            }
        }

        _endOdometerInput = _trip.EndOdometer;

        await LoadTripDriversAsync();

        _workflowNote = "Route and passenger maintenance will be enabled when those APIs are available. This page currently supports trip review and end-odometer update.";
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private void PreviousDriverPage()
    {
        if (_driverPage > 1)
        {
            _driverPage--;
        }
    }

    private void NextDriverPage()
    {
        if (_driverPage < DriverTotalPages)
        {
            _driverPage++;
        }
    }

    private async Task SaveAndCloseAsync()
    {
        var updated = await SaveTripAsync();
        if (!updated)
        {
            return;
        }

        Navigation.NavigateTo("/trips");
    }

    private async Task SaveAndRenewAsync()
    {
        var updated = await SaveTripAsync();
        if (!updated || _trip == null)
        {
            return;
        }

        Navigation.NavigateTo($"/trips/create?vmfCode={_trip.VmfCode}&contractCode={_trip.ContractCode}");
    }

    private async Task<bool> SaveTripAsync()
    {
        if (_trip == null)
        {
            return false;
        }

        _saving = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var request = new UpdateTripRequest
            {
                ContractCode = _trip.ContractCode,
                ApproverName = _trip.ApproverName,
                ApproverRank = _trip.ApproverRank,
                ApproverTelephone = _trip.ApproverTelephone,
                EndOdometer = _endOdometerInput,
                ExpiryDate = _trip.ExpiryDate,
                TripReason = _trip.Notes,
                TripRequestNumber = _trip.TripRequestNumber,
                IssueDate = _trip.TripDate,
                TripTypeCode = _trip.TripTypeCode,
                TripIncidentTypeCode = _trip.TripIncidentTypeCode,
                UserAccessCode = _trip.UserAccessCode,
                LockedForTransfer = _trip.LockedForTransfer,
                TripIsMonthly = _trip.TripIsMonthly
            };

            var updated = await TripService.UpdateAsync(_trip.TripId, request);
            if (updated == null)
            {
                _isError = true;
                _message = "Unable to save trip authority.";
                return false;
            }

            _trip = updated;
            _endOdometerInput = updated.EndOdometer;
            _message = "Request completed successfully.";
            return true;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Unable to save trip authority.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PrintAuthorityAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task PrintInvoiceAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private string GetTripAuthorityNumber()
        => _trip?.TripId is > 0 ? _trip.TripId.ToString() : ValueOrDash(TripId);

    private string TripVehicleLabel()
    {
        var gg = ValueOrDash(_vehicle?.fleet_number);
        var reg = ValueOrDash(_vehicle?.registration_number);
        var vmf = _trip?.VmfCode is > 0 ? _trip.VmfCode.ToString() : "-";
        return $"{gg} / {reg} ({vmf})";
    }

    private static string FormatSite(SiteResponseDto? site)
    {
        if (site == null)
        {
            return "-";
        }

        return $"{ValueOrDash(site.Description)} ({site.SiteCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string FormatUser(int? userCode)
    {
        if (!userCode.HasValue || userCode.Value <= 0)
        {
            return "-";
        }

        if (!_userProfilesByCode.TryGetValue((short)userCode.Value, out var user))
        {
            return $"User {userCode.Value}";
        }

        var fullName = $"{user.FirstName} {user.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return !string.IsNullOrWhiteSpace(user.Email)
                ? $"{user.Email} ({userCode.Value})"
                : $"User {userCode.Value}";
        }

        return !string.IsNullOrWhiteSpace(user.Email)
            ? $"{fullName} ({user.Email})"
            : $"{fullName} ({userCode.Value})";
    }

    private static string TripTypeLabel(short? tripTypeCode)
        => tripTypeCode switch
        {
            1 => "Normal (Official Business)",
            2 => "Emergency",
            3 => "Standby",
            _ => "-"
        };

    private async Task LoadTripDriversAsync()
    {
        _drivers = new List<DriverDto>();
        _driverPage = 1;
        _primaryDriver = null;

        if (_trip == null || _trip.TripId <= 0)
        {
            return;
        }

        var tripDrivers = await TripDriverService.GetAllAsync();
        var linkedDrivers = tripDrivers
            .Where(driver => driver.trip_authority_code == _trip.TripId)
            .ToList();

        if (linkedDrivers.Count == 0)
        {
            return;
        }

        _drivers = linkedDrivers.Select(driver => new DriverDto
        {
            site_driver_code = driver.trip_driver_code,
            driver_firstname = driver.trip_driver_name,
            driver_surname = string.Empty,
            driver_SA_id = driver.trip_driver_id,
            driver_passportnumber = driver.driver_passportnumber,
            driver_licence_number = driver.driver_licence_number
        }).ToList();

        _primaryDriver = linkedDrivers.Any(driver => driver.trip_driver_primary) ? "Yes" : "No";
    }
}
