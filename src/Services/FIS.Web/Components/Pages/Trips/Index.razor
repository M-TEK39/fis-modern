@page "/trips"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject TripApiService TripService
@inject IJSRuntime JS

<PageTitle>Trip Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trip"></i>
            Trip Management
        </h1>
        <p class="page-description">Manage vehicle trips, assignments, and trip records</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="RefreshData">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    <div class="search-bar">
        <div class="search-input-wrapper">
            <i class="bx bx-search"></i>
            <input 
                type="text" 
                class="search-input" 
                placeholder="Search trips by destination, vehicle, or driver..." 
                @bind="_searchTerm" 
                @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button class="search-clear" @onclick="ClearSearch" aria-label="Clear search">
                    <i class="bx bx-x"></i>
                </button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trips...</p>
        </div>
    }
    else if (_filteredTrips.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-trip"></i>
            <h3>No trips found</h3>
            <p>@(_searchTerm?.Length > 0 ? "No trips match your search criteria" : "Get started by creating your first trip")</p>
            @if (_searchTerm?.Length == 0)
            {
                <button class="btn btn-secondary" @onclick="RefreshData">
                    <i class="bx bx-refresh"></i>
                    Refresh
                </button>
            }
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_filteredTrips.Count Trip(s)</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="RefreshData" title="Refresh">
                        <i class="bx bx-refresh"></i>
                    </button>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Trip ID</th>
                            <th>Contract</th>
                            <th>Vehicle</th>
                            <th>Driver</th>
                            <th>Trip Date</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in _filteredTrips)
                        {
                            <tr>
                                <td class="trip-id">@trip.TripId</td>
                                <td>@trip.ContractCode</td>
                                <td>@trip.VmfCode</td>
                                <td>@trip.DriverId</td>
                                <td class="trip-date">@trip.TripDate.ToString("yyyy-MM-dd")</td>
                                <td class="status">
                                    <span class="status-badge @GetStatusClass(trip.Status ?? "")">
                                        @trip.Status
                                    </span>
                                </td>
                                <td>@trip.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<FIS.Web.Services.TripDto> _trips = new();
    private List<FIS.Web.Services.TripDto> _filteredTrips = new();
    private bool _loading = true;
    private string _searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _trips = await TripService.GetRecentAsync();
            ApplySearchFilter();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading trip data: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplySearchFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredTrips = _trips.ToList();
        }
        else
        {
            var searchLower = _searchTerm.ToLower();
            _filteredTrips = _trips.Where(t =>
                (t.Status ?? "").ToLower().Contains(searchLower) ||
                (t.Notes ?? "").ToLower().Contains(searchLower) ||
                t.TripId.ToString().Contains(searchLower) ||
                t.ContractCode.ToString().Contains(searchLower) ||
                t.VmfCode.ToString().Contains(searchLower) ||
                (t.DriverId?.ToString() ?? "").Contains(searchLower)
            ).ToList();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        ApplySearchFilter();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = "";
        ApplySearchFilter();
        StateHasChanged();
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" => "status-success",
            "in progress" => "status-warning",
            "planned" => "status-info",
            "cancelled" => "status-danger",
            _ => "status-default"
        };
    }
}
