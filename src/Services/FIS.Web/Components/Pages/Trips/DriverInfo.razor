@page "/trips/driver-info"
@rendermode InteractiveServer
<PageTitle>Driver Information - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user"></i>
            Driver Information
        </h1>
        <p class="page-description">Driver information over a financial year selection.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back to Trips</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Select the Financial Year</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Financial Year</label>
                    <select class="form-select" @bind="_selectedFinancialYear">
                        <option value="">Select Financial Year</option>
                        @foreach (var year in _financialYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="SubmitAsync">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/trips">Back</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-error" : "alert-success") fis-mt-1">
                    @_message
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<string> _financialYears = new();
    private string _selectedFinancialYear = string.Empty;
    private bool _isError;
    private string _message = string.Empty;

    protected override void OnInitialized()
    {
        var currentYear = DateTime.Today.Year;
        for (var year = currentYear + 1; year >= currentYear - 9; year--)
        {
            _financialYears.Add($"{year - 1}/{year}");
        }
    }

    private Task SubmitAsync()
    {
        _isError = string.IsNullOrWhiteSpace(_selectedFinancialYear);
        _message = _isError
            ? "Select a financial year."
            : "Request completed successfully.";
        return Task.CompletedTask;
    }
}
