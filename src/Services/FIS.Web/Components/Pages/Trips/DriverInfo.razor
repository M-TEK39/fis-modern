@page "/trips/driver-info"
@rendermode InteractiveServer

<PageTitle>Driver Information - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user"></i>
            Driver Information
        </h1>
        <p class="page-description">Driver information over a financial year selection.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back to Trips</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Select the Financial Year</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Financial Year</label>
                    <select class="form-select">
                        <option value="">Select Financial Year</option>
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/trips">Back</a>
            </div>
        </div>
    </div>
</div>
