@page "/trips/driver-licence-details"
@rendermode InteractiveServer

<PageTitle>Driver Licence Details - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Driver Licence Details
        </h1>
        <p class="page-description">View driver licence details by site driver code.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back to Trips</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Search Driver Licence Details</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Site Driver Code</label>
                    <input class="form-input" placeholder="Enter Site Driver Code" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Fetch Details</button>
                <a class="btn btn-secondary btn-sm" href="/trips">Back</a>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Driver Licence Details</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="2">No records found.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
