@page "/trips/driver-licence-details"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject DriverApiService DriverService
@inject SiteApiService SiteService
@inject DriverLicenceApiService DriverLicenceService
@inject IJSRuntime JS

<PageTitle>Driver Licence Details - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Driver Licence Details
        </h1>
        <p class="page-description">View driver licence details by site driver ID.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back to Trips</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Search Driver Licence Details</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Site Driver ID</label>
                    <select class="form-select" @bind="_driverCode">
                        <option value="">Select driver</option>
                        @foreach (var driver in _drivers.OrderBy(d => d.driver_surname).ThenBy(d => d.driver_firstname))
                        {
                            <option value="@driver.site_driver_code">@($"{BuildDriverLabel(driver)} ({driver.site_driver_code})")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="LoadDriver" disabled="@_loading">
                    @(_loading ? "Loading..." : "Fetch Details")
                </button>
                <a class="btn btn-secondary btn-sm" href="/trips">Back</a>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Driver Licence Details</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_driver == null)
                    {
                        <tr>
                            <td colspan="2">No records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedDetails)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td>@row.Value</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <div class="pagination-controls">
                <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <span>Page @_page of @TotalPages</span>
                <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        }
    </div>
</div>

@code {
    private string _driverCode = string.Empty;
    private bool _loading;
    private int _page = 1;
    private const int _pageSize = 12;
    private DriverDto? _driver;
    private List<DriverDto> _drivers = new();
    private List<SiteResponseDto> _sites = new();
    private List<DriverLicenceDto> _driverLicences = new();
    private List<(string Label, string Value)> _details = new();
    private IEnumerable<(string Label, string Value)> PagedDetails => _details.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_details.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _drivers = await DriverService.GetDriversAsync();
        _sites = await SiteService.GetAllAsync();
        _driverLicences = await DriverLicenceService.GetAllAsync();
    }

    private async Task LoadDriver()
    {
        if (!int.TryParse(_driverCode, out var code))
        {
            _driver = null;
            _details = new();
            return;
        }

        _loading = true;
        try
        {
            _driver = await DriverService.GetDriverAsync(code);
            if (_driver == null)
            {
                _details = new();
                return;
            }

            _details = new List<(string Label, string Value)>
            {
                ("Site Driver ID", _driver.site_driver_code.ToString()),
                ("Site", GetSiteDisplay(_driver.site_code)),
                ("Licence Type", GetLicenceTypeDisplay(_driver.driver_licence_type_id)),
                ("Licence Number", _driver.driver_licence_number ?? "-"),
                ("Licence Issue Date", _driver.driver_licence_issuedate?.ToString("yyyy-MM-dd") ?? "-"),
                ("Licence Expiry Date", _driver.driver_licence_ExpiryDate?.ToString("yyyy-MM-dd") ?? "-"),
                ("Last Verified", _driver.driver_licence_lastVerifiedDate?.ToString("yyyy-MM-dd") ?? "-"),
                ("PDP", _driver.driver_hasPDP ? "Yes" : "No"),
                ("PDP Expiry", _driver.driver_PDP_ExpiryDate?.ToString("yyyy-MM-dd") ?? "-"),
                ("Driver Active", _driver.driver_active ? "Yes" : "No")
            };
            _page = 1;
        }
        catch (Exception ex)
        {
            _driver = null;
            _details = new();
            await JS.InvokeVoidAsync("console.error", $"Error loading driver licence details: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string BuildDriverLabel(DriverDto driver)
    {
        var name = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Unnamed Driver";
        }

        return name;
    }

    private string GetSiteDisplay(int siteCode)
    {
        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode);
        return site is null ? siteCode.ToString() : $"{site.Description} ({siteCode})";
    }

    private string GetLicenceTypeDisplay(int licenceCode)
    {
        var licence = _driverLicences.FirstOrDefault(l => l.licence_code == licenceCode);
        return licence is null ? licenceCode.ToString() : $"{licence.description} ({licenceCode})";
    }
}
