@page "/trips/remove-without-routes"
@rendermode InteractiveServer
<PageTitle>Remove Trips Without Routes - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Remove All Trips that have No routes
        </h1>
        <p class="page-description">Delete all trips without routes.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Remove All Trips that have No routes</th>
                            </tr>
                            <tr>
                                <th>Report Results</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>No Records Found!</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="contract-action-group fis-mt-1">
                <button class="btn btn-danger">DELETE all Trips without routes</button>
                <a class="btn btn-secondary" href="/trips">Back</a>
            </div>
        </div>
    </div>
</div>
