@page "/trips/create"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TripApiService TripService
@inject TripDriverApiService TripDriverService
@inject VehicleApiService VehicleService
@inject DriverApiService DriverService
@inject ContractApiService ContractService
@inject UserApiService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Create Trip Authority - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Create Trip Authority
        </h1>
        <p class="page-description">Trip authority creation workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">&lt; Back to Trips</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trip context...</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Trip Authority # <span class="contract-muted">@(_createdTrip?.TripId.ToString() ?? "<Number to be assigned>")</span></h2>
            </div>
            <div class="form-card-body">
                <div class="form-section">
                    <div class="form-section-title">Selected Vehicle: <span class="contract-muted">@VehicleLabel()</span></div>
                    <div class="form-hint">* BOLD fields are REQUIRED</div>
                    @if (_vehicle is null)
                    {
                        <div class="form-grid" style="margin-top: 0.75rem;">
                            <div class="form-field">
                                <label class="form-label"><strong>Vehicle Search:</strong></label>
                                <div class="contract-search-radio">
                                    <label class="form-radio-label">
                                        <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                        GG
                                    </label>
                                    <label class="form-radio-label">
                                        <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                        GP
                                    </label>
                                </div>
                                <div class="fis-input-group-compact">
                                    <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                                </div>
                                <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode" @bind:after="ApplySelectedVehicleAsync" disabled="@(_vehicleMatches.Count == 0)">
                                    <option value="">Select vehicle...</option>
                                    @foreach (var vehicle in _vehicleMatches)
                                    {
                                        <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                                    }
                                </select>
                                <div class="form-hint">Select a vehicle to load odometer and contract context.</div>
                            </div>
                        </div>
                    }
                    <div class="form-grid" style="margin-top: 0.75rem;">
                        <div class="form-field">
                            <label class="form-label"><strong>Start ODO Meter Reading:</strong></label>
                            <input class="form-input" type="number" @bind="_startOdometer" />
                        </div>
                        <div class="form-field">
                            <label class="form-label"><strong>Expected Return Date:</strong></label>
                            <input class="form-input" type="date" @bind-value="_expiryDate" @bind-value:format="yyyy-MM-dd" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">General Information</h3>
                    <div class="form-grid">
                        <div class="form-field form-group-full">
                            <label class="form-label"><strong>Reason for trip:</strong></label>
                            <textarea class="form-textarea" rows="3" @bind="_tripReason"></textarea>
                        </div>
                        <div class="form-field">
                            <label class="form-label"><strong>Trip Type:</strong></label>
                            <select class="form-select" @bind="_tripTypeCode">
                                <option value="1">Normal (Official Business)</option>
                                <option value="2">Emergency</option>
                                <option value="3">Standby</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Approval Information</h3>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label"><strong>Select the trip Approver:</strong></label>
                            <select class="form-select" @bind="_selectedApproverUserCode">
                                <option value="">-- Please Select Approver --</option>
                                @foreach (var approver in _approvers)
                                {
                                    <option value="@approver.UserAccessCode">@ApproverLabel(approver)</option>
                                }
                            </select>
                            @if (_approvers.Count == 0)
                            {
                                <div class="form-hint">No eligible approvers are configured for your account.</div>
                            }
                        </div>
                        <div class="form-field">
                            <label class="form-label">Request Number</label>
                            <input class="form-input" @bind="_tripRequestNumber" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Trip Driver(s) Information</h3>
                    <div class="form-grid" style="margin-bottom: 0.75rem;">
                        <div class="form-field">
                            <label class="form-label">Select Driver</label>
                            <select class="form-select" @bind="_selectedTripDriverCode">
                                <option value="">-- Select driver --</option>
                                @foreach (var driver in _availableDrivers.OrderBy(d => d.driver_surname).ThenBy(d => d.driver_firstname))
                                {
                                    <option value="@driver.site_driver_code">@DriverLabel(driver)</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Primary Driver</label>
                            <label class="form-label form-checkbox">
                                <input type="checkbox" @bind="_selectedTripDriverPrimary" />
                                Yes
                            </label>
                        </div>
                    </div>
                    <div class="contract-action-group" style="margin-bottom:0.75rem;">
                        <button class="btn btn-secondary btn-sm" @onclick="AddTripDriverAsync" disabled="@(_createdTrip is null || !_selectedTripDriverCode.HasValue)">Add Driver to Trip</button>
                    </div>
                    @if (_createdTrip is null)
                    {
                        <div class="form-hint">Save trip authority first, then add trip driver(s).</div>
                    }
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Driver Detail</th>
                                        <th>Primary Driver</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_tripDrivers.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="3">No Drivers Added</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in _tripDrivers)
                                        {
                                            <tr>
                                                <td>@ValueOrDash(item.trip_driver_name) | @ValueOrDash(item.trip_driver_id)</td>
                                                <td>@(item.trip_driver_primary ? "YES" : "NO")</td>
                                                <td>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveTripDriverAsync(item.trip_driver_code)">Remove</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Passenger Information</h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Passenger details</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="2">No Passengers Added</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Route Information</h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Departure Location</th>
                                        <th>Departure Date</th>
                                        <th>Arrival Location</th>
                                        <th>Arrival Date</th>
                                        <th>Estimated distance</th>
                                        <th>Responsibility</th>
                                        <th>Objective</th>
                                        <th>Project</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="9">No Routes Currently</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="contract-action-group">
                    <a class="btn btn-secondary" href="/trips">&lt; Back to Trips</a>
                    <button class="btn btn-primary" @onclick="SaveTripAsync" disabled="@_saving">Save Trip Authority</button>
                    <button class="btn btn-secondary" @onclick="PrintTripAsync" disabled="@(_createdTrip is null)">Print Trip Authority</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "vmfCode")] public int? VmfCode { get; set; }
    [SupplyParameterFromQuery(Name = "contractCode")] public int? ContractCode { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _isError;
    private string _message = string.Empty;

    private VehicleDto? _vehicle;
    private TripDto? _createdTrip;
    private List<UserSummaryDto> _approvers = new();
    private List<DriverDto> _availableDrivers = new();
    private List<TripDriverDto> _tripDrivers = new();
    private string _searchMode = "GG";
    private string _vehicleSearchTerm = string.Empty;
    private List<VehicleDto> _vehicleMatches = new();
    private int? _selectedVehicleVmfCode;
    private int? _selectedTripDriverCode;
    private bool _selectedTripDriverPrimary = true;

    private int _startOdometer;
    private string _tripReason = string.Empty;
    private short _tripTypeCode = 1;
    private short _tripIncidentTypeCode = 1;
    private string _tripRequestNumber = string.Empty;
    private string? _selectedApproverUserCode;
    private DateTime? _expiryDate;
    private short? _currentUserAccessCode;
    private int _resolvedContractCode;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            if (VmfCode is > 0)
            {
                await LoadVehicleContextAsync(VmfCode.Value);
            }

            await ResolveCurrentUserAsync();
            _approvers = FilterApprovers(await UserService.GetAllSummariesAsync());
            RemoveCurrentUserFromApprovers();
            _availableDrivers = await DriverService.GetDriversAsync();

            if (ContractCode is > 0)
            {
                _resolvedContractCode = ContractCode.Value;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveTripAsync()
    {
        _saving = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            if (_vehicle == null)
            {
                _isError = true;
                _message = "Select a vehicle before creating a trip authority.";
                return;
            }

            if (_resolvedContractCode <= 0)
            {
                _isError = true;
                _message = "No active contract found for the selected vehicle.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_selectedApproverUserCode))
            {
                _isError = true;
                _message = "Please select Approver.";
                return;
            }

            if (IsSelfApproverSelection())
            {
                _isError = true;
                _message = "You cannot select yourself as the trip approver.";
                return;
            }

            var selectedApprover = _approvers.FirstOrDefault(x =>
                x.UserAccessCode.ToString() == _selectedApproverUserCode);

            var request = new CreateTripRequest
            {
                ContractCode = _resolvedContractCode,
                ApproverName = selectedApprover?.UserName,
                ApproverRank = "Approver",
                ApproverTelephone = selectedApprover?.Telephone,
                EndOdometer = _startOdometer,
                ExpiryDate = _expiryDate,
                TripReason = _tripReason,
                TripRequestNumber = _tripRequestNumber,
                IssueDate = DateTime.Now,
                TripTypeCode = _tripTypeCode,
                TripIncidentTypeCode = _tripIncidentTypeCode,
                UserAccessCode = _currentUserAccessCode,
                LockedForTransfer = false,
                TripIsMonthly = false
            };

            var created = await TripService.CreateAsync(request);
            if (created == null)
            {
                _isError = true;
                _message = "Unable to create trip authority.";
                return;
            }

            _createdTrip = created;
            _message = "Request completed successfully.";
            await LoadTripDriversAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Unable to create trip authority.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PrintTripAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private string VehicleLabel()
    {
        if (_vehicle == null)
        {
            return "No vehicle selected";
        }

        return $"{GetVehicleLabel(_vehicle)} | {ValueOrDash(_vehicle.model_name)}";
    }

    private async Task SearchVehiclesAsync()
    {
        _isError = false;
        _message = string.Empty;
        var keyword = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);
            if (_vehicleMatches.All(v => v.vmf_code != _selectedVehicleVmfCode))
            {
                _selectedVehicleVmfCode = null;
                _vehicle = null;
                _resolvedContractCode = 0;
            }
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _isError = true;
            _message = "Unable to search vehicles.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task ApplySelectedVehicleAsync()
    {
        if (!_selectedVehicleVmfCode.HasValue || _selectedVehicleVmfCode.Value <= 0)
        {
            _vehicle = null;
            _resolvedContractCode = 0;
            return;
        }

        await LoadVehicleContextAsync(_selectedVehicleVmfCode.Value);
    }

    private async Task LoadVehicleContextAsync(int vmfCode)
    {
        _vehicle = await VehicleService.GetVehicleAsync(vmfCode);
        _startOdometer = _vehicle?.current_odo ?? 0;
        var latestContract = await ContractService.GetLatestContractForVehicleAsync(vmfCode);
        _resolvedContractCode = ContractCode is > 0 ? ContractCode.Value : (latestContract?.contract_id ?? 0);
    }

    private async Task AddTripDriverAsync()
    {
        if (_createdTrip is null || !_selectedTripDriverCode.HasValue)
        {
            return;
        }

        var selected = _availableDrivers.FirstOrDefault(d => d.site_driver_code == _selectedTripDriverCode.Value);
        if (selected == null)
        {
            _isError = true;
            _message = "Selected driver could not be loaded.";
            return;
        }

        var payload = new TripDriverDto
        {
            trip_authority_code = _createdTrip.TripId,
            trip_driver_primary = _selectedTripDriverPrimary,
            trip_driver_name = $"{selected.driver_firstname} {selected.driver_surname}".Trim(),
            trip_driver_id = selected.driver_SA_id,
            site_code = selected.site_code,
            driver_licence_type_id = selected.driver_licence_type_id,
            driver_passportnumber = selected.driver_passportnumber,
            driver_persalnumber = selected.driver_persalnumber,
            driver_contractnumber = selected.driver_contractnumber,
            driver_licence_number = selected.driver_licence_number,
            driver_licence_issuedate = selected.driver_licence_issuedate,
            driver_licence_lastVerifiedDate = selected.driver_licence_lastVerifiedDate,
            driver_hasPDP = selected.driver_hasPDP,
            driver_PDP_ExpiryDate = selected.driver_PDP_ExpiryDate,
            driver_licence_ExpiryDate = selected.driver_licence_ExpiryDate,
            driver_active = selected.driver_active
        };

        var created = await TripDriverService.CreateAsync(payload);
        if (created == null)
        {
            _isError = true;
            _message = "Unable to add driver to trip.";
            return;
        }

        _isError = false;
        _message = "Request completed successfully.";
        await LoadTripDriversAsync();
    }

    private async Task RemoveTripDriverAsync(int tripDriverCode)
    {
        if (tripDriverCode <= 0)
        {
            return;
        }

        var success = await TripDriverService.DeleteAsync(tripDriverCode);
        if (!success)
        {
            _isError = true;
            _message = "Unable to remove driver from trip.";
            return;
        }

        _isError = false;
        _message = "Request completed successfully.";
        await LoadTripDriversAsync();
    }

    private async Task LoadTripDriversAsync()
    {
        if (_createdTrip is null)
        {
            _tripDrivers = new();
            return;
        }

        var all = await TripDriverService.GetAllAsync();
        _tripDrivers = all
            .Where(driver => driver.trip_authority_code == _createdTrip.TripId)
            .OrderByDescending(driver => driver.trip_driver_primary)
            .ThenBy(driver => driver.trip_driver_name)
            .ToList();
    }

    private static string ApproverLabel(UserSummaryDto user)
        => string.IsNullOrWhiteSpace(user.UserName)
            ? $"User {user.UserAccessCode}"
            : $"{user.UserName} ({user.UserAccessCode})";

    private static string DriverLabel(DriverDto driver)
    {
        var name = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            name = "Unnamed Driver";
        }

        return $"{name} ({driver.site_driver_code})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVehicleVmfCode = null;
    }

    private static List<UserSummaryDto> FilterApprovers(List<UserSummaryDto> users)
    {
        if (users.Count == 0)
        {
            return users;
        }

        var contractApprovers = users
            .Where(user => (user.AccessLevel & LegacyPermissionBits.ContractManagement) == LegacyPermissionBits.ContractManagement)
            .ToList();

        return contractApprovers.Count > 0 ? contractApprovers : users;
    }

    private void RemoveCurrentUserFromApprovers()
    {
        if (_currentUserAccessCode is not > 0)
        {
            return;
        }

        _approvers = _approvers
            .Where(x => x.UserAccessCode != _currentUserAccessCode.Value)
            .ToList();
    }

    private bool IsSelfApproverSelection()
    {
        if (_currentUserAccessCode is not > 0 || string.IsNullOrWhiteSpace(_selectedApproverUserCode))
        {
            return false;
        }

        return short.TryParse(_selectedApproverUserCode, out var selectedUserCode)
            && selectedUserCode == _currentUserAccessCode.Value;
    }

    private async Task ResolveCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (short.TryParse(user.FindFirst("user_access_code")?.Value, out var userCode))
        {
            _currentUserAccessCode = userCode;
            return;
        }

        var fromClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (short.TryParse(fromClaim, out var nameIdCode))
        {
            _currentUserAccessCode = nameIdCode;
        }
    }
}
