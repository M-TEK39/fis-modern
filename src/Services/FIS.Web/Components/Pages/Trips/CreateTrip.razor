@page "/trips/create"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TripApiService TripService
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject UserApiService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Create Trip Authority - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Create Trip Authority
        </h1>
        <p class="page-description">Legacy trip authority creation workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">&lt; Back to Trips</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading trip context...</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Trip Authority # <span class="contract-muted">@(_createdTrip?.TripId.ToString() ?? "<Number to be assigned>")</span></h2>
            </div>
            <div class="form-card-body">
                <div class="form-section">
                    <div class="form-section-title">Selected Vehicle: <span class="contract-muted">@VehicleLabel()</span></div>
                    <div class="form-hint">* BOLD fields are REQUIRED</div>
                    <div class="form-grid" style="margin-top: 0.75rem;">
                        <div class="form-field">
                            <label class="form-label"><strong>Start ODO Meter Reading:</strong></label>
                            <input class="form-input" type="number" @bind="_startOdometer" />
                        </div>
                        <div class="form-field">
                            <label class="form-label"><strong>Expected Return Date:</strong></label>
                            <input class="form-input" type="date" @bind-value="_expiryDate" @bind-value:format="yyyy-MM-dd" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">General Information</h3>
                    <div class="form-grid">
                        <div class="form-field form-group-full">
                            <label class="form-label"><strong>Reason for trip:</strong></label>
                            <textarea class="form-textarea" rows="3" @bind="_tripReason"></textarea>
                        </div>
                        <div class="form-field">
                            <label class="form-label"><strong>Trip Type:</strong></label>
                            <select class="form-select" @bind="_tripTypeCode">
                                <option value="1">Normal (Official Business)</option>
                                <option value="2">Emergency</option>
                                <option value="3">Standby</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Approval Information</h3>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label"><strong>Select the trip Approver:</strong></label>
                            <select class="form-select" @bind="_selectedApproverUserCode">
                                <option value="">-- Please Select Approver --</option>
                                @foreach (var approver in _approvers)
                                {
                                    <option value="@approver.UserAccessCode">@ApproverLabel(approver)</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Request Number</label>
                            <input class="form-input" @bind="_tripRequestNumber" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Trip Driver(s) Information</h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Driver Detail</th>
                                        <th>Primary Driver</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="3">No Drivers Added</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Passenger Information</h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Passenger details</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="2">No Passengers Added</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Route Information</h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Departure Location</th>
                                        <th>Departure Date</th>
                                        <th>Arrival Location</th>
                                        <th>Arrival Date</th>
                                        <th>Estimated distance</th>
                                        <th>Responsibility</th>
                                        <th>Objective</th>
                                        <th>Project</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="9">No Routes Currently</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="contract-action-group">
                    <a class="btn btn-secondary" href="/trips">&lt; Back to Trips</a>
                    <button class="btn btn-primary" @onclick="SaveTripAsync" disabled="@_saving">Save Trip Authority</button>
                    <button class="btn btn-secondary" @onclick="PrintTripAsync" disabled="@(_createdTrip is null)">Print Trip Authority</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "vmfCode")] public int? VmfCode { get; set; }
    [SupplyParameterFromQuery(Name = "contractCode")] public int? ContractCode { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _isError;
    private string _message = string.Empty;

    private VehicleDto? _vehicle;
    private TripDto? _createdTrip;
    private List<UserSummaryDto> _approvers = new();

    private int _startOdometer;
    private string _tripReason = string.Empty;
    private short _tripTypeCode = 1;
    private short _tripIncidentTypeCode = 1;
    private string _tripRequestNumber = string.Empty;
    private string? _selectedApproverUserCode;
    private DateTime? _expiryDate;
    private short? _currentUserAccessCode;
    private int _resolvedContractCode;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            if (VmfCode is > 0)
            {
                _vehicle = await VehicleService.GetVehicleAsync(VmfCode.Value);
                _startOdometer = _vehicle?.current_odo ?? 0;
            }

            _approvers = await UserService.GetAllSummariesAsync();
            await ResolveCurrentUserAsync();

            _resolvedContractCode = ContractCode ?? 0;
            if (_resolvedContractCode <= 0 && VmfCode is > 0)
            {
                var latestContract = await ContractService.GetLatestContractForVehicleAsync(VmfCode.Value);
                _resolvedContractCode = latestContract?.contract_id ?? 0;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveTripAsync()
    {
        _saving = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            if (_resolvedContractCode <= 0)
            {
                _isError = true;
                _message = "No active contract found for the selected vehicle.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_selectedApproverUserCode))
            {
                _isError = true;
                _message = "Please select Approver.";
                return;
            }

            var selectedApprover = _approvers.FirstOrDefault(x =>
                x.UserAccessCode.ToString() == _selectedApproverUserCode);

            var request = new CreateTripRequest
            {
                ContractCode = _resolvedContractCode,
                ApproverName = selectedApprover?.UserName,
                ApproverRank = "Approver",
                ApproverTelephone = selectedApprover?.Telephone,
                EndOdometer = _startOdometer,
                ExpiryDate = _expiryDate,
                TripReason = _tripReason,
                TripRequestNumber = _tripRequestNumber,
                IssueDate = DateTime.Now,
                TripTypeCode = _tripTypeCode,
                TripIncidentTypeCode = _tripIncidentTypeCode,
                UserAccessCode = _currentUserAccessCode,
                LockedForTransfer = false,
                TripIsMonthly = false
            };

            var created = await TripService.CreateAsync(request);
            if (created == null)
            {
                _isError = true;
                _message = "Unable to create trip authority.";
                return;
            }

            _createdTrip = created;
            _message = "Request completed successfully.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Unable to create trip authority.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PrintTripAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private string VehicleLabel()
    {
        if (_vehicle == null)
        {
            return "[Vehicle]";
        }

        return $"{_vehicle.fleet_number} | {_vehicle.registration_number} | {_vehicle.model_name}";
    }

    private static string ApproverLabel(UserSummaryDto user)
        => string.IsNullOrWhiteSpace(user.UserName)
            ? $"User {user.UserAccessCode}"
            : $"{user.UserName} ({user.UserAccessCode})";

    private async Task ResolveCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (short.TryParse(user.FindFirst("user_access_code")?.Value, out var userCode))
        {
            _currentUserAccessCode = userCode;
            return;
        }

        var fromClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (short.TryParse(fromClaim, out var nameIdCode))
        {
            _currentUserAccessCode = nameIdCode;
        }
    }
}
