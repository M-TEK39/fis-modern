@page "/trips/driver-maintenance"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Maintain Driver Information - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-detail"></i>
            Maintain Driver Information
        </h1>
        <p class="page-description">Legacy driver maintenance workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/trips">Back to Trips</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Maintain Driver Information</h2>
        </div>
        <div class="form-card-body">
            @if (_activeTab == "view")
            {
                <div class="contract-action-group">
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("add")'>Add Driver</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("update")'>Update Driver</button>
                    <button class="btn btn-danger btn-sm">Delete Driver</button>
                    <button class="btn btn-secondary btn-sm">Back</button>
                </div>

                <div class="form-grid" style="margin-top: 1rem;">
                    <div class="form-field form-group-full">
                        <label class="form-label">Driver(s):</label>
                        <select class="form-select">
                            <option value="">- Choose a Driver -</option>
                        </select>
                    </div>
                </div>
            }
            else if (_activeTab == "add")
            {
                <div class="contract-action-group">
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("view")'>View Driver(s)</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("update")'>Update Driver</button>
                    <button class="btn btn-danger btn-sm">Delete Driver</button>
                    <button class="btn btn-secondary btn-sm">Back</button>
                </div>

                <div class="form-grid" style="margin-top: 1rem;">
                    <div class="form-field">
                        <label class="form-label">Surname:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Firstname:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">SA ID Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site:</label>
                        <select class="form-select">
                            <option value="">- Choose a Site -</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contract Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Type Code:</label>
                        <select class="form-select">
                            <option value="">- Not Applicable (Does not have licence) -</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">PDP Expiry Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Number</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Issue Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Last Verified Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Expiry Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Active:</label>
                        <label class="form-label form-checkbox">
                            <input type="checkbox" />
                            Active
                        </label>
                    </div>
                </div>

                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Save</button>
                </div>
            }
            else
            {
                <div class="contract-action-group">
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("view")'>View Driver(s)</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => SetActiveTab("add")'>Add Driver</button>
                    <button class="btn btn-danger btn-sm">Delete Driver</button>
                    <button class="btn btn-secondary btn-sm">Back</button>
                </div>

                <div class="form-grid" style="margin-top: 1rem;">
                    <div class="form-field form-group-full">
                        <label class="form-label">Driver(s):</label>
                        <select class="form-select">
                            <option value="">- Choose a Driver -</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Surname:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Firstname:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">SA ID Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site:</label>
                        <select class="form-select">
                            <option value="">- Choose a Site -</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contract Number:</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Type Code:</label>
                        <select class="form-select">
                            <option value="">- Not Applicable (Does not have licence) -</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">PDP Expiry Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Number</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Issue Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Last Verified Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Expiry Date:</label>
                        <input class="form-input" placeholder="Select date" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Active:</label>
                        <label class="form-label form-checkbox">
                            <input type="checkbox" />
                            Active
                        </label>
                    </div>
                </div>

                <div class="contract-action-group">
                    <button class="btn btn-primary btn-sm">Save</button>
                </div>
            }

            <LegacyEndpointActionPanel
                LegacyPath="Trips/MaintainDriver.aspx"
                Endpoint="@GetEndpointForMode()"
                HttpMethod="@GetHttpMethodForMode()"
                ButtonText="Run Driver Maintenance API"
                ReportType="trips-driver-maintenance" />
        </div>
    </div>
</div>

@code {
    private string _activeTab = "view";

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private string GetEndpointForMode()
        => _activeTab switch
        {
            "add" => "api/driver",
            "update" => "api/driver/1",
            _ => "api/driver"
        };

    private string GetHttpMethodForMode()
        => _activeTab switch
        {
            "add" => "POST",
            "update" => "PUT",
            _ => "GET"
        };
}
