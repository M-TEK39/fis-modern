@page "/vehicle-photos"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject VehiclePhotoApiService VehiclePhotoService
@inject IJSRuntime JS

<PageTitle>Vehicle Photos - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-image"></i>
            Vehicle Photos
        </h1>
        <p class="page-description">Photo references from /api/vehiclephoto.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadPhotos">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    <div class="search-bar">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem; flex-wrap:wrap;">
            <label class="form-label" style="margin:0;">
                <input type="radio" name="searchType" value="GG" checked="@(_searchType == "GG")"
                       @onchange='() => SetSearchType("GG")' />
                GG
            </label>
            <label class="form-label" style="margin:0;">
                <input type="radio" name="searchType" value="GP" checked="@(_searchType == "GP")"
                       @onchange='() => SetSearchType("GP")' />
                GP Number
            </label>
        </div>
        <div class="search-input-wrapper" style="gap:0.75rem;">
            <i class="bx bx-search"></i>
            <input
                type="text"
                class="search-input"
                placeholder="@(_searchType == "GG" ? "Enter GG Number" : "Enter GP Number")"
                @bind="_searchQuery"
                @bind:event="oninput" />
            <button class="btn btn-primary btn-sm" type="button" @onclick="SearchPhotos" disabled="@_searching">
                @if (_searching)
                {
                    <span class="spinner-sm"></span>
                    <span>Searching...</span>
                }
                else
                {
                    <span>Submit</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_searchError))
        {
            <span class="form-error">@_searchError</span>
        }
    </div>

    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePhotosInfo">
                <span>Vehicle Photos Information / Help</span>
                <i class="bx @(_showPhotosInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPhotosInfo)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <span class="menu-item-disabled">Vehicle Photos Information / Help</span>
                        <span class="menu-item-badge">Coming soon</span>
                    </div>
                </div>
            }
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePhotosMaintenance">
                <span>Vehicle Photos Maintenance</span>
                <i class="bx @(_showPhotosMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPhotosMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/vehicle-photos">1) Vehicle Photos</a>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading vehicle photos...</p>
        </div>
    }
    else if (_photos.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-image"></i>
            <h3>No vehicle photos</h3>
            <p>Awaiting vehicle photos API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_photos.Count Photo reference(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var photo in _photos)
                        {
                            <tr>
                                <td>@photo.Vehicle</td>
                                <td>@photo.Type</td>
                                <td><span class="badge">@photo.Status</span></td>
                                <td>@photo.Date.ToString("yyyy-MM-dd")</td>
                                <td>@photo.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<PhotoItem> _photos = new();
    private List<PhotoItem> _allPhotos = new();
    private string _searchType = "GG";
    private string _searchQuery = "";
    private bool _searching;
    private string? _searchError;
    private bool _showPhotosInfo = true;
    private bool _showPhotosMaintenance = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotos();
    }

    private async Task LoadPhotos()
    {
        _loading = true;
        try
        {
            var apiItems = await VehiclePhotoService.GetAllAsync<VehiclePhotoDto>();
            _allPhotos = apiItems.Select(p => new PhotoItem(
                VmfCode: p.VehicleMasterCode,
                Vehicle: p.VehicleMasterCode.ToString(),
                Type: p.Orientation?.ToString() ?? "N/A",
                Status: string.IsNullOrWhiteSpace(p.FileUrl) ? "Pending" : "Available",
                Date: DateTime.MinValue,
                Notes: p.Description ?? string.Empty
            )).ToList();
            _photos = new List<PhotoItem>(_allPhotos);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading vehicle photos: {ex.Message}");
            _photos = new();
            _allPhotos = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record PhotoItem(int VmfCode, string Vehicle, string Type, string Status, DateTime Date, string Notes);

    private sealed class VehiclePhotoDto
    {
        public int VehiclePhotoInfoCode { get; set; }
        public int VehicleMasterCode { get; set; }
        public string? FileUrl { get; set; }
        public int? Orientation { get; set; }
        public string? Description { get; set; }
    }

    private void TogglePhotosInfo()
    {
        _showPhotosInfo = !_showPhotosInfo;
    }

    private void TogglePhotosMaintenance()
    {
        _showPhotosMaintenance = !_showPhotosMaintenance;
    }

    private void SetSearchType(string type)
    {
        _searchType = type;
    }

    private async Task SearchPhotos()
    {
        _searchError = null;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _photos = new List<PhotoItem>(_allPhotos);
            return;
        }

        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 200, search: query);
            var match = _searchType == "GG"
                ? vehicles.Data.FirstOrDefault(v => string.Equals(v.fleet_number, query, StringComparison.OrdinalIgnoreCase))
                : vehicles.Data.FirstOrDefault(v => string.Equals(v.registration_number, query, StringComparison.OrdinalIgnoreCase));

            if (match == null)
            {
                _photos = new List<PhotoItem>();
                _searchError = "Vehicle not found.";
                return;
            }

            _photos = _allPhotos.Where(p => p.VmfCode == match.vmf_code).ToList();
            if (_photos.Count == 0)
            {
                _searchError = "No vehicle photos found for this vehicle.";
            }
        }
        catch (Exception ex)
        {
            _searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }
}
