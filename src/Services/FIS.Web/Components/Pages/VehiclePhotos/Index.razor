@page "/vehicle-photos"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject VehicleLookupApiService VehicleLookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Vehicle Photo Upload - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-image"></i>
            Vehicle Photo Upload
        </h1>
        <p class="page-description">Search for vehicles by GG or registration number</p>
    </div>
</div>

<div class="page-content">
    <form class="search-bar" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
        <div class="form-grid fis-mb-05">
            <div class="form-field">
                <div class="contract-search-radio">
                    <label class="form-radio-label">
                        <input type="radio" name="photoSearchType" checked="@(_searchMode == "gg")" @onchange='() => SetSearchMode("gg")' />
                        GG
                    </label>
                    <label class="form-radio-label">
                        <input type="radio" name="photoSearchType" checked="@(_searchMode == "gp")" @onchange='() => SetSearchMode("gp")' />
                        GP
                    </label>
                </div>
            </div>
        </div>
        <div class="search-input-wrapper vehicle-photo-search">
            <i class="bx bx-search"></i>
            <input
                id="keyword"
                type="text"
                class="search-input"
                placeholder="@(_searchMode == "gg" ? "GG number" : "Registration number")"
                @bind="_searchQuery"
                @bind:event="oninput"
                autocomplete="off"
                @onfocus="OnSearchFocus"
                @onblur="OnSearchBlur" />
            @if (_showSuggestions && FilteredKeywords.Count > 0)
            {
                <div class="search-suggestions" role="listbox" aria-label="Vehicle suggestions">
                    @foreach (var keyword in FilteredKeywords)
                    {
                        <button type="button"
                                class="search-suggestion-item"
                                @onmousedown:preventDefault="true"
                                @onclick="() => SelectSuggestion(keyword)">
                            @keyword
                        </button>
                    }
                </div>
            }
        </div>
        <div class="fis-mt-075">
            <button class="btn btn-primary btn-sm" type="submit" disabled="@(!_isLoaded || _searching)">
                @if (_searching)
                {
                    <span class="spinner-sm"></span>
                    <span>Searching...</span>
                }
                else
                {
                    <span>Submit</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_searchError))
        {
            <span class="form-error">@_searchError</span>
        }
        @if (!_isLoaded)
        {
            <span class="form-hint">Loading search criteria...</span>
        }
    </form>

    @if (_searchResults.Count > 0)
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_searchResults.Count Vehicle(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Registration Number</th>
                            <th>Make and Model</th>
                            <th>Year Manufactured</th>
                            <th>Colour</th>
                            <th>Hire Type</th>
                            <th>Status</th>
                            <th>Hired From</th>
                            <th>Status Date</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in PagedSearchResults)
                        {
                            <tr>
                                <td>@(GetGGNumber(vehicle) ?? "-")</td>
                                <td>@vehicle.RegistrationNumber</td>
                                <td>@vehicle.MakeAndModel</td>
                                <td>@(vehicle.YearManufactured?.ToString() ?? "N/A")</td>
                                <td>@vehicle.Colour</td>
                                <td>@vehicle.HireType</td>
                                <td>@vehicle.Status</td>
                                <td>@vehicle.HiredFrom</td>
                                <td>@(vehicle.StatusDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-view" @onclick="() => ManagePhotos(vehicle)">
                                            <i class="bx bx-image"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private bool _isLoaded;
    private string _searchQuery = "";
    private bool _searching;
    private bool _showSuggestions;
    private string? _searchError;
    private List<string> _keywords = new();
    private List<VehicleLookupDto> _searchResults = new();
    private string _searchMode = "gg";
    private int _page = 1;
    private const int _pageSize = 12;
    private const int SuggestionLimit = 20;

    private IEnumerable<VehicleLookupDto> PagedSearchResults => _searchResults.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_searchResults.Count / (double)_pageSize));
    private List<string> FilteredKeywords => _keywords
        .Where(keyword => MatchesKeyword(keyword))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(SuggestionLimit)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Query))
        {
            _searchQuery = Query.Trim();
        }

        await LoadSearchCriteria();
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            await HandleSubmit();
        }
    }

    private async Task LoadSearchCriteria()
    {
        _isLoaded = false;
        try
        {
            _keywords = await VehicleLookupService.GetSearchCriteriaAsync();
            _isLoaded = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading vehicle search criteria: {ex.Message}");
            _keywords = new();
            _isLoaded = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (_searching)
        {
            return;
        }

        _searchError = null;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchError = "Please enter a search keyword.";
            return;
        }

        _showSuggestions = false;
        _searching = true;
        try
        {
            var query = _searchQuery.Trim();
            var matches = await VehicleLookupService.SearchAsync(query);
            _searchResults = RankVehicleMatches(matches, query, _searchMode == "gg");
            _page = 1;
        }
        catch (Exception ex)
        {
            _searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private void SetSearchMode(string mode)
    {
        if (_searchMode == mode)
        {
            return;
        }

        _searchMode = mode;
        _searchQuery = string.Empty;
        _searchResults = new();
        _searchError = null;
        _showSuggestions = false;
        _page = 1;
    }

    private bool MatchesKeyword(string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return false;
        }

        var query = _searchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return keyword.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearchFocus(FocusEventArgs _)
    {
        _showSuggestions = true;
    }

    private async Task OnSearchBlur(FocusEventArgs _)
    {
        // Allow suggestion click to run before closing menu.
        await Task.Delay(120);
        _showSuggestions = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectSuggestion(string keyword)
    {
        _searchQuery = keyword;
        _showSuggestions = false;
    }

    private static List<VehicleLookupDto> RankVehicleMatches(List<VehicleLookupDto> matches, string query, bool preferGg)
    {
        return (preferGg
                ? matches.Where(v => !string.IsNullOrWhiteSpace(GetGGNumber(v)) && GetGGNumber(v)!.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                preferGg
                    ? string.Equals(GetGGNumber(v)?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => preferGg ? GetGGNumber(v) : v.RegistrationNumber)
            .ToList();
    }

    private static string? GetGGNumber(VehicleLookupDto vehicle)
        => string.IsNullOrWhiteSpace(vehicle.GGNumber) ? vehicle.FleetNumber : vehicle.GGNumber;

    private void ManagePhotos(VehicleLookupDto vehicle)
    {
        Navigation.NavigateTo($"/vehicle-photos/manage/{vehicle.VmfCode}?keyword={Uri.EscapeDataString(_searchQuery)}");
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
