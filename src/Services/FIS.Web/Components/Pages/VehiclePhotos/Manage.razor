@page "/vehicle-photos/manage/{VmfCode:int}"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject VehiclePhotoApiService VehiclePhotoService
@inject IJSRuntime JS

<PageTitle>Manage Vehicle Photos - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-image"></i>
            Manage Vehicle Photos
        </h1>
        <p class="page-description">Vehicle photo maintenance (UI-only until full upload workflow is wired).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Vehicle Code</label>
                    <input class="form-input" type="text" value="@VmfCode" readonly />
                </div>
                @if (!string.IsNullOrWhiteSpace(Keyword))
                {
                    <div class="form-field">
                        <label class="form-label">Search Keyword</label>
                        <input class="form-input" type="text" value="@Keyword" readonly />
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="table-container" style="margin-top:1.5rem;">
        <div class="table-header">
            <span class="table-title">Photo References</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Status</th>
                        <th>File</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="4">Loading photos...</td>
                        </tr>
                    }
                    else if (_photos.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No photos found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var photo in _photos)
                        {
                            <tr>
                                <td>@ValueOrDash(photo.Orientation?.ToString())</td>
                                <td>@ValueOrDash(photo.VehiclePhotoInfoCode.ToString())</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(photo.FileUrl))
                                    {
                                        <a href="@photo.FileUrl" target="_blank" rel="noopener noreferrer">View</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>@ValueOrDash(photo.Description)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int VmfCode { get; set; }

    [SupplyParameterFromQuery(Name = "keyword")]
    public string? Keyword { get; set; }

    private bool _loading = true;
    private List<VehiclePhotoDto> _photos = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotos();
    }

    private async Task LoadPhotos()
    {
        _loading = true;
        try
        {
            _photos = await VehiclePhotoService.GetByVehicleAsync<VehiclePhotoDto>(VmfCode);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading vehicle photos: {ex.Message}");
            _photos = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
