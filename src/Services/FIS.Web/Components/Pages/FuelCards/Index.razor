@page "/fuel-cards"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject FleetManagementApiService FleetService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Fuelcard Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-credit-card"></i>
            Fuelcard Maintenance Menu
        </h1>
        <p class="page-description">Fuelcard maintenance and reporting.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasFuelcardsRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Fuelcards</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleHelp">
                <span>Fuelcard Maintenance Information / Help</span>
                <i class="bx @(_showHelp ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showHelp)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/help">Fuelcard Maintenance Information / Help</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleMaintenance">
                <span>Fuelcard Maintenance</span>
                <i class="bx @(_showMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/vehicle">1) Fuelcard Maintenance for a Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/collection-multiple">2) Collection for TWO or MORE Fuelcards</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/delete">3) Delete a Fuelcard</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleReports">
                <span>Fuelcards Report</span>
                <i class="bx @(_showReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/report/latest">1) Latest Fuelcard Report for a GG Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=one-vehicle">2) Fuelcard Report for a Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=one-pan">3) Fuelcard Report for a PAN Number</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=one-vehicle-handout">4) Fuelcard Handout Report</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=all-vehicles">5) Fuelcard Report for ALL Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=expire-date">6) Fuelcard Report for an Expire Date</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=replace-reason">7) Fuelcard Report for a Replace Reason</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=dept-site-expire-period">8) Fuelcard Report, for a Department / Site, for an Expire Period</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=dept-site">9) Fuelcard Report for a Department / Site</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=one-site-expire-date">10) Fuelcard Report for a Dept Site and Expire Date</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=pool-vehicles">11) Fuelcard Report for POOL Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=vip-vehicles">12) Fuelcard Report for VIP Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/reports/fuel-cards?view=result&rtype=wesbank-new-cards">13) Wesbank Application for New FuelCards</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePrivateHireMaintenance">
                <span>Private Hire Vehicle Fuelcards - Maintenance</span>
                <i class="bx @(_showPrivateHireMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPrivateHireMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/vehicle">1) Private Hire Vehicle Fuelcards for a Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/collection-multiple">2) Collection for TWO or MORE Fuelcards (Private Hire)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/delete">3) Delete a Fuelcard (Private Hire)</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePrivateHireReports">
                <span>Private Hire Vehicle Fuelcards - Reports</span>
                <i class="bx @(_showPrivateHireReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPrivateHireReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/report-all">1) Report for ALL Private Hire Vehicle Fuelcards</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <DataPreviewTable Title="Fuelcard Activity Preview"
                      SearchPlaceholder="Search card number, GG code, action, receiver..."
                      EmptyMessage="No fuelcard activity matches the current search or filter."
                      EmptyIcon="bx bx-credit-card"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
    }
</div>

@code {
    private bool _hasFuelcardsRole;
    private bool _showHelp = true;
    private bool _showMaintenance = true;
    private bool _showReports = true;
    private bool _showPrivateHireMaintenance = true;
    private bool _showPrivateHireReports = true;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("cardNumber", "Card No."),
        new("vmfCode", "GG Code"),
        new("action", "Action"),
        new("date", "Date"),
        new("receiver", "Receiver")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Issued cards", "actionGroup", "Issued"),
        new("Returned cards", "actionGroup", "Returned"),
        new("Other activity", "actionGroup", "Other")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasFuelcardsRole = HasRole(authState.User, "Fuelcards");
        if (!_hasFuelcardsRole)
        {
            _loading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private void ToggleHelp() => _showHelp = !_showHelp;
    private void ToggleMaintenance() => _showMaintenance = !_showMaintenance;
    private void ToggleReports() => _showReports = !_showReports;
    private void TogglePrivateHireMaintenance() => _showPrivateHireMaintenance = !_showPrivateHireMaintenance;
    private void TogglePrivateHireReports() => _showPrivateHireReports = !_showPrivateHireReports;

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var response = await FleetService.GetFuelCardAllocationAsync();
            _rows = response?.Report?.RecentActivity
                .OrderByDescending(item => item.Date)
                .Select(item => new Dictionary<string, string?>
                {
                    ["cardNumber"] = item.CardNumber,
                    ["vmfCode"] = item.VmfCode.ToString(),
                    ["action"] = item.Action,
                    ["date"] = item.Date.ToString("yyyy-MM-dd"),
                    ["receiver"] = item.Receiver,
                    ["actionGroup"] = GetActionGroup(item.Action),
                    ["_href"] = $"/fuel-cards/vehicle?vmfCode={item.VmfCode}&cardNumber={Uri.EscapeDataString(item.CardNumber ?? string.Empty)}"
                })
                .ToList() ?? new();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading fuelcard preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetActionGroup(string? action)
    {
        if (action?.Contains("issue", StringComparison.OrdinalIgnoreCase) == true)
        {
            return "Issued";
        }

        if (action?.Contains("return", StringComparison.OrdinalIgnoreCase) == true)
        {
            return "Returned";
        }

        return "Other";
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
