@page "/fuel-cards"
@rendermode InteractiveServer

<PageTitle>Fuelcard Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-credit-card"></i>
            Fuelcard Maintenance Menu
        </h1>
        <p class="page-description">Fuelcard maintenance aligned to the legacy workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleHelp">
                <span>Fuelcard Maintenance Information / Help</span>
                <i class="bx @(_showHelp ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showHelp)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/help">Fuelcard Maintenance Information / Help</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleMaintenance">
                <span>Fuelcard Maintenance</span>
                <i class="bx @(_showMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/vehicle">1) Fuelcard Maintenance for a Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/collection-multiple">2) Collection for TWO or MORE Fuelcards</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/delete">3) Delete a Fuelcard</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleReports">
                <span>Fuelcards Report</span>
                <i class="bx @(_showReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/report/latest">1) Latest Fuelcard Report for a GG Vehicle</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePrivateHireMaintenance">
                <span>Private Hire Vehicle Fuelcards - Maintenance</span>
                <i class="bx @(_showPrivateHireMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPrivateHireMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/vehicle">1) Private Hire Vehicle Fuelcards for a Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/collection-multiple">2) Collection for TWO or MORE Fuelcards (Private Hire)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/delete">3) Delete a Fuelcard (Private Hire)</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="TogglePrivateHireReports">
                <span>Private Hire Vehicle Fuelcards - Reports</span>
                <i class="bx @(_showPrivateHireReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showPrivateHireReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/fuel-cards/private-hire/report-all">1) Report for ALL Private Hire Vehicle Fuelcards</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _showHelp = true;
    private bool _showMaintenance = true;
    private bool _showReports = true;
    private bool _showPrivateHireMaintenance = true;
    private bool _showPrivateHireReports = true;

    private void ToggleHelp() => _showHelp = !_showHelp;
    private void ToggleMaintenance() => _showMaintenance = !_showMaintenance;
    private void ToggleReports() => _showReports = !_showReports;
    private void TogglePrivateHireMaintenance() => _showPrivateHireMaintenance = !_showPrivateHireMaintenance;
    private void TogglePrivateHireReports() => _showPrivateHireReports = !_showPrivateHireReports;
}
