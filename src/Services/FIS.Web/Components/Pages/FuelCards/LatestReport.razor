@page "/fuel-cards/report/latest"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Latest Fuelcard Report for a GG Vehicle</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-report"></i>
            Latest Fuelcard Report for a GG Vehicle
        </h1>
        <p class="page-description">View the latest fuelcard information for a GG vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fuel-cards">Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" placeholder="Enter GG number" />
                </div>
            </div>
            <button class="btn btn-primary btn-sm">Generate</button>
            <div class="table-container" style="margin-top: 1rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Vehicle</th>
                                <th>Card Number</th>
                                <th>Status</th>
                                <th>Issued</th>
                                <th>Returned</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5">No report data available.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="fuelcard/RPT_all_vehicle_main.aspx"
        Endpoint="api/fuelcard/reports/latest"
        HttpMethod="POST"
        ButtonText="Test Latest Fuelcard Report Endpoint"
        ReportType="fuelcard-report-latest" />
</div>
