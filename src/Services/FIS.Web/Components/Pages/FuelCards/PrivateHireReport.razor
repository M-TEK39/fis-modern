@page "/fuel-cards/private-hire/report-all"
@rendermode InteractiveServer

<PageTitle>Report for ALL Private Hire Vehicle Fuelcards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-report"></i>
            Report for ALL Private Hire Vehicle Fuelcards
        </h1>
        <p class="page-description">Generate reports for all private hire fuelcards.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fuel-cards">Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <button class="btn btn-primary btn-sm">Generate Report</button>
            <div class="table-container" style="margin-top: 1rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Vehicle</th>
                                <th>Card Number</th>
                                <th>Status</th>
                                <th>Issued</th>
                                <th>Returned</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5">No report data available.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
