@page "/fuel-cards/private-hire/report-all"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FleetManagementApiService FleetService
@inject IJSRuntime JSRuntime

<PageTitle>Report for ALL Private Hire Vehicle Fuelcards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-report"></i>
            Report for ALL Private Hire Vehicle Fuelcards
        </h1>
        <p class="page-description">Generate reports for all private hire fuelcards.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fuel-cards">Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <button class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="@_loading">
                @(_loading ? "Generating..." : "Generate Report")
            </button>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert alert-info" style="margin-top: 1rem;">@_message</div>
            }
            <div class="table-container" style="margin-top: 1rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Vehicle</th>
                                <th>Card Number</th>
                                <th>Action</th>
                                <th>Receiver</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedActivity.Any())
                            {
                                @foreach (var item in PagedActivity)
                                {
                                    <tr>
                                        <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@item.VmfCode</td>
                                        <td>@item.CardNumber</td>
                                        <td>@item.Action</td>
                                        <td>@item.Receiver</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">No report rows found for the current filters.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (_activity.Count > 0)
            {
                <div class="pagination-controls" style="margin-top: 1rem;">
                    <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FuelCardActivityDto> _activity = new();
    private bool _loading;
    private string _message = string.Empty;
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<FuelCardActivityDto> PagedActivity => _activity.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_activity.Count / (double)_pageSize));

    private async Task LoadReportAsync()
    {
        _loading = true;
        _message = string.Empty;
        try
        {
            var response = await FleetService.GetFuelCardAllocationAsync();
            if (response is null || !response.Success || response.Report is null)
            {
                _activity = new();
                _message = response?.Message ?? "No report rows found for the current filters.";
                return;
            }

            _activity = response.Report.RecentActivity
                .OrderByDescending(a => a.Date)
                .ToList();

            _page = 1;
            _message = "Request completed successfully.";
        }
        catch (Exception ex)
        {
            _activity = new();
            _message = "Failed to load report.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
