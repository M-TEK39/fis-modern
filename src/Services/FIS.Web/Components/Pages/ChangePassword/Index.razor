@page "/change-password"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Change Password - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-lock"></i>
            Change Password
        </h1>
        <p class="page-description">Legacy password change placeholder. Static entries until API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadEntries">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading password change records...</p>
        </div>
    }
    else if (_entries.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-lock-open"></i>
            <h3>No password updates</h3>
            <p>Awaiting password API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_entries.Count Entry(ies)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Status</th>
                            <th>Last Changed</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr>
                                <td>@entry.User</td>
                                <td><span class="badge">@entry.Status</span></td>
                                <td>@entry.LastChanged.ToString("yyyy-MM-dd")</td>
                                <td>@entry.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<PasswordEntry> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private Task LoadEntries()
    {
        _loading = true;

        _entries =
        [
            new("admin", "Active", new DateTime(2025, 01, 12), "Password rotated."),
            new("support", "Pending", new DateTime(2025, 01, 10), "Awaiting confirmation."),
            new("driver_mgr", "Expired", new DateTime(2024, 12, 15), "Prompt for reset."),
            new("audit", "Active", new DateTime(2024, 11, 28), "Recent change.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record PasswordEntry(string User, string Status, DateTime LastChanged, string Notes);
}
