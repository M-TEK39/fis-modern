@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Models
@using FIS.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthApiService AuthApiService
@inject NavigationManager Navigation

<div class="card">
    <div class="card-header">
        <div>
            <h3>Change Password</h3>
            <p class="text-muted">Password change flow.</p>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted">
            You have the option to change your password whenever you have the need but the password must be changed at least every month.
        </p>
        @if (_isForcedPasswordChange)
        {
            <div class="alert alert-info">
                Your password has expired. You must change it before continuing.
            </div>
        }
        <div class="card fis-card-muted">
            <strong>Passwords have the following requirements:</strong>
            <ol class="fis-list-top-05-pad12">
                <li>It should never be shared with anyone!</li>
                <li>The length must be at least 8 characters</li>
                <li>It must contain at least 1 number</li>
                <li>It must contain at least 1 upper case letter</li>
                <li>It must contain at least 1 lower case letter</li>
                <li>It must contain at least 1 non alphanumeric character</li>
                <li>It cannot be the same as the previous 3 passwords</li>
            </ol>
        </div>
        <p class="text-muted">
            NOTE : After three incorrect password entries your username will be disabled for 60 minutes, before you may try again.
        </p>
        <p class="text-muted">
            You can use the Password reset function on the login page, should you forget your password.
        </p>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Old Password</label>
                <input class="form-input" type="password" @bind="_oldPassword" />
            </div>
            <div class="form-field">
                <label class="form-label">New Password</label>
                <input class="form-input" type="password" @bind="_newPassword" />
            </div>
            <div class="form-field">
                <label class="form-label">Confirm New Password</label>
                <input class="form-input" type="password" @bind="_confirmNewPassword" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" type="button" @onclick="HandleChangePassword" disabled="@_submitting">
            @(_submitting ? "Updating..." : "Change Password")
        </button>
        @if (!_isForcedPasswordChange)
        {
            <a class="btn btn-secondary" href="/login">Cancel</a>
            <a class="btn btn-secondary" href="/home">Home</a>
        }
    </div>
</div>

@code {
    private string _username = "authenticated@local";
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _submitting;
    private bool _isForcedPasswordChange;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _username = ResolveUsername(authState.User);
        _isForcedPasswordChange = RequiresPasswordChange(authState.User);
    }

    private async Task HandleChangePassword()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_newPassword != _confirmNewPassword)
        {
            _errorMessage = "The Confirm New Password must match the New Password entry.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ChangePasswordAsync(new ChangePasswordRequest
            {
                Username = _username,
                OldPassword = _oldPassword,
                NewPassword = _newPassword,
                ConfirmNewPassword = _confirmNewPassword
            });

            if (response.Success)
            {
                _successMessage = response.Message ?? "Password successfully changed.";
                _oldPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmNewPassword = string.Empty;

                if (_isForcedPasswordChange)
                {
                    await AuthApiService.LogoutAsync();
                    Navigation.NavigateTo("/login/legacy", forceLoad: true);
                    return;
                }
            }
            else
            {
                _errorMessage = response.Message ?? "Password change failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Password change failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string ResolveUsername(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? "authenticated@local" : email;
    }

    private static bool RequiresPasswordChange(ClaimsPrincipal user)
    {
        var value = user.FindFirst("password_change_required")?.Value;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return value.Equals("true", StringComparison.OrdinalIgnoreCase)
            || value.Equals("1", StringComparison.OrdinalIgnoreCase)
            || value.Equals("y", StringComparison.OrdinalIgnoreCase)
            || value.Equals("yes", StringComparison.OrdinalIgnoreCase);
    }
}
