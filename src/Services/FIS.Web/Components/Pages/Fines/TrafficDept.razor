@page "/fines/traffic-dept"
@rendermode InteractiveServer

<PageTitle>Traffic Dept Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building"></i>
            Traffic Dept Info Maintenance
        </h1>
        <p class="page-description">Search traffic departments by name.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Traffic Dept Name</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Traffic Dept Name</label>
                        <input class="form-input" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Traffic Depts Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Traffic Dept Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Johannesburg Metro Police</td>
                                    <td>
                                        <a href="/fines/traffic-dept/detail">Mod</a>
                                        &nbsp;|&nbsp;
                                        <a href="/fines/traffic-dept/detail">Del</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-actions">
                    <a class="btn btn-primary btn-sm" href="/fines/traffic-dept/detail">Add</a>
                </div>
            </div>
        </div>
    </div>
</div>
