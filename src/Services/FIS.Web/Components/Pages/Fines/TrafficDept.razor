@page "/fines/traffic-dept"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrafficDeptApiService TrafficDeptService

<PageTitle>Traffic Dept Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building"></i>
            Traffic Dept Info Maintenance
        </h1>
        <p class="page-description">Search traffic departments by name.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Traffic Dept Name</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Traffic Dept Name</label>
                        <input class="form-input" @bind="_searchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchTrafficDepts">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Traffic Depts Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Traffic Dept Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_loading)
                                {
                                    <tr>
                                        <td colspan="2">Loading traffic departments...</td>
                                    </tr>
                                }
                                else if (_trafficDepts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="2">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var dept in PagedTrafficDepts)
                                    {
                                        <tr>
                                            <td>@ValueOrDash(dept.Name)</td>
                                            <td>
                                                <a href="@($"/fines/traffic-dept/detail?trafficDeptId={dept.TrafficDeptId}")">Mod</a>
                                                &nbsp;|&nbsp;
                                                <a href="@($"/fines/traffic-dept/detail?trafficDeptId={dept.TrafficDeptId}")">Del</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_trafficDepts.Count > _pageSize)
                    {
                        <div class="pagination">
                            <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                            <div class="pagination-info">Page @_page of @TotalPages</div>
                            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                        </div>
                        <div class="pagination-meta">Total records: @_trafficDepts.Count | Page size: @_pageSize</div>
                    }
                </div>
                <div class="form-actions">
                    <a class="btn btn-primary btn-sm" href="/fines/traffic-dept/detail">Add</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _searchQuery = "";
    private bool _loading;
    private List<TrafficDeptRow> _trafficDepts = new();
    private List<TrafficDeptRow> _allTrafficDepts = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<TrafficDeptRow> PagedTrafficDepts => _trafficDepts.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_trafficDepts.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadTrafficDepts();
    }

    private async Task LoadTrafficDepts()
    {
        _loading = true;
        try
        {
            var apiItems = await TrafficDeptService.GetAllAsync<TrafficDeptDto>();
            _allTrafficDepts = apiItems.Select(t => new TrafficDeptRow(
                TrafficDeptId: t.Traffic_dept_code,
                Name: t.Traf_name
            )).ToList();
            _trafficDepts = new List<TrafficDeptRow>(_allTrafficDepts);
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SearchTrafficDepts()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _trafficDepts = new List<TrafficDeptRow>(_allTrafficDepts);
            _page = 1;
            return Task.CompletedTask;
        }

        var term = _searchQuery.Trim();
        _trafficDepts = _allTrafficDepts
            .Where(t => t.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
            .ToList();
        _page = 1;
        return Task.CompletedTask;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record TrafficDeptRow(
        short TrafficDeptId,
        string? Name
    );
}
