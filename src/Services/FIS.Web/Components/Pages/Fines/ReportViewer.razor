@page "/fines/reports/{Mode}"
@rendermode InteractiveServer

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Legacy fines report parameters and output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines/reports">Back to Fines Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "one-vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Vehicle Number</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="oneVehicleType" checked />
                                GP
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="oneVehicleType" />
                                GG
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Fines Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in FineDetailFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetFineSampleValue(field)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "dept-period")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Fines Report for a Department/Site</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Site list by</label>
                            <div class="form-grid">
                                <label class="form-label"><input type="radio" name="deptListBy" /> Name</label>
                                <label class="form-label"><input type="radio" name="deptListBy" checked /> Code</label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Dept/Site</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports/select">Fines Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in DeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-101</td>
                                        <td>GG10991</td>
                                        <td>2024/02/01</td>
                                        <td>REF-223</td>
                                        <td>Metro Police</td>
                                        <td>750</td>
                                        <td>FIN-01</td>
                                        <td>Finance</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "appear-date")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Appear Date</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Appear Date (e.g. 2003/05/25)</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Fines Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in FineDetailFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetFineSampleValue(field)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "letter")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Submission to Re-Issue a Traffic Fine</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="letterType" />
                                GG
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="letterType" checked />
                                GP
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Fines Found</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Offence Date</th>
                                        <th>Doc Type</th>
                                        <th>Date at GMT</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>2024/01/15</td>
                                        <td>Notice of Traffic Offence</td>
                                        <td>2024/01/18</td>
                                        <td><a href="#">Show</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Letter Preview</h2>
                    <div class="form-card" style="padding: 1rem;">
                        <p><strong>Traffic Dept:</strong> Johannesburg Metro Police</p>
                        <p><strong>Transport Manager:</strong> N.L. Matlala (011) 372 9020</p>
                        <p><strong>Re-issue the traffic fine/summons with the following information:</strong></p>
                        <p><strong>Name &amp; Surname:</strong> S. Molefe</p>
                        <p><strong>ID Number:</strong> 8001015009087</p>
                        <p><strong>Dept:</strong> Finance</p>
                        <p><strong>Postal Address:</strong> 1 Main St, Johannesburg, 2001</p>
                        <p><strong>Contact Number:</strong> 011-555-1234</p>
                    </div>
                </div>
            }
            else if (Mode == "traffic-dept")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Traffic Dept Detail</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in TrafficDeptColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Johannesburg Metro Police</td>
                                        <td>K. Radebe</td>
                                        <td>PO Box 10</td>
                                        <td>Johannesburg</td>
                                        <td>2001</td>
                                        <td>011-555-4000</td>
                                        <td>011-555-4010</td>
                                        <td>082-555-7777</td>
                                        <td>metro@example.com</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "metro")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Select Metro</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Offence Issuer (Metro)</label>
                            <select class="form-select">
                                <option>Select Metro</option>
                                <option>Johannesburg Metro</option>
                                <option>Tshwane Metro</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <a class="btn btn-primary btn-sm" href="/fines/reports/metro-period">Accept your selection</a>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports/select">Fines Menu</a>
                    </div>
                </div>
            }
            else if (Mode == "metro-period")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Metro Report Dates</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports/select">Fines Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Metro Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in MetroColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>GG20220</td>
                                        <td>2024/02/02</td>
                                        <td>REF-120</td>
                                        <td>Johannesburg Metro</td>
                                        <td>900</td>
                                        <td>OPS-02</td>
                                        <td>Operations</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Fines per Vehicle</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Registration Number</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/fines/reports/select">Fines Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in MetroColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>GG31110</td>
                                        <td>2024/02/15</td>
                                        <td>REF-343</td>
                                        <td>Metro Police</td>
                                        <td>650</td>
                                        <td>FIN-02</td>
                                        <td>Finance</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "all")
            {
                <div class="form-section">
                    <h2 class="form-section-title">All Fines</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in MetroColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>GG90001</td>
                                        <td>2024/01/10</td>
                                        <td>REF-001</td>
                                        <td>Metro Police</td>
                                        <td>500</td>
                                        <td>INF-01</td>
                                        <td>Infrastructure</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="form-actions">
                        <a class="btn btn-secondary btn-sm" href="/fines/reports/select">Fines Menu</a>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">This report screen will be aligned to the legacy report parameters and output tables.</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Fines Report";

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "one-vehicle" => "Fines Report on ONE Vehicle",
            "dept-period" => "Fines Report for a Dept / Site, for a period",
            "appear-date" => "Fines Report on Appear Date",
            "letter" => "Submission to Re-Issue Fine",
            "traffic-dept" => "Traffic Dept Detail",
            "select" => "Fines Report Selection",
            "metro" => "Fines Report per Metro",
            "metro-period" => "Fines Report per Metro",
            "vehicle" => "Fines Report per Vehicle",
            "all" => "A List of all Fines",
            _ => "Fines Report"
        };
    }

    private static readonly string[] FineDetailFields =
    {
        "GG Number",
        "Prov Reg Number",
        "Hire Type",
        "Date of Offence",
        "Reference Number",
        "Issued By",
        "Traffic Dept",
        "Amount of Fine",
        "Due Date of Payment",
        "Due Date to Appear in Court",
        "Document Type",
        "Date Received at GMT",
        "Date of Notification to Issuer",
        "Date of Notification to Dept",
        "Dept",
        "Dept Code",
        "Name of Responsable Person at Dept",
        "ID of Responsable Person at Dept"
    };

    private static readonly string[] DeptPeriodColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Offence Date",
        "Reference",
        "Issuer",
        "Fine Amount",
        "Dept / Site Number",
        "Dept / Site"
    };

    private static readonly string[] TrafficDeptColumns =
    {
        "Traffic Dept Name",
        "Responsable Person",
        "Postal Address1",
        "Postal Address2",
        "Postal Code",
        "Telephone",
        "Fax",
        "Cell",
        "eMail"
    };

    private static readonly string[] MetroColumns =
    {
        "No.",
        "Fleet Number",
        "Offence Date",
        "Offence Reference",
        "Offence Issuer",
        "Fine Amount",
        "Department Number",
        "Description"
    };

    private static string GetFineSampleValue(string field) =>
        field switch
        {
            "GG Number" => "GG12345",
            "Prov Reg Number" => "GPA-0001",
            "Hire Type" => "Pool",
            "Date of Offence" => "2024/01/15",
            "Reference Number" => "REF-889",
            "Issued By" => "Metro Police",
            "Traffic Dept" => "Johannesburg Metro",
            "Amount of Fine" => "750",
            "Due Date of Payment" => "2024/02/15",
            "Due Date to Appear in Court" => "2024/02/20",
            "Document Type" => "Notice of Traffic Offence",
            "Date Received at GMT" => "2024/01/18",
            "Date of Notification to Issuer" => "2024/01/19",
            "Date of Notification to Dept" => "2024/01/20",
            "Dept" => "Finance",
            "Dept Code" => "FIN-01",
            "Name of Responsable Person at Dept" => "S. Molefe",
            "ID of Responsable Person at Dept" => "8001015009087",
            _ => "-"
        };
}
