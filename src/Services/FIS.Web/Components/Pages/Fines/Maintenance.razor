@page "/fines/maintenance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FineApiService FineService
@inject RegistrationApiService RegistrationService
@inject VehicleApiService VehicleService

<PageTitle>Fine Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fine Maintenance
        </h1>
        <p class="page-description">Search fines by GG or current/historical GP number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Vehicle Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                            GG
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                            GP
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">@(_searchType == "GG" ? "GG Number" : "GP Number")</label>
                        <input class="form-input" @bind="_searchQuery" @bind:event="oninput" placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchFines">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
                @if (SearchResolutionLines.Count > 0)
                {
                    <div class="form-card" style="margin-top: 1rem;">
                        <div class="form-card-body">
                            <h3 class="form-section-title">Vehicle resolution</h3>
                            <ul class="form-hint" style="margin: 0; padding-left: 1.25rem;">
                                @foreach (var line in SearchResolutionLines)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Fines Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Offence Date</th>
                                    <th>Doc Type</th>
                                    <th>Date at GMT</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_loading)
                                {
                                    <tr>
                                        <td colspan="4">Loading fines...</td>
                                    </tr>
                                }
                                else if (_fines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var fine in PagedFines)
                                    {
                                        <tr>
                                            <td>@FormatDate(fine.OffenceDate)</td>
                                            <td>@ValueOrDash(fine.DocumentType)</td>
                                            <td>@FormatDate(fine.GmtDate)</td>
                                            <td><a href="@($"/fines/maintenance/detail?fineId={fine.FineId}")">Mod</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_fines.Count > _pageSize)
                    {
                        <div class="pagination">
                            <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                            <div class="pagination-info">Page @_page of @TotalPages</div>
                            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                        </div>
                        <div class="pagination-meta">Total records: @_fines.Count | Page size: @_pageSize</div>
                    }
                </div>
                <div class="form-actions">
                    <a class="btn btn-primary btn-sm" href="@GetAddFineUrl()">Add</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _searchType = "GP";
    private string _searchQuery = "";
    private bool _loading;
    private List<FineRow> _fines = new();
    private List<FineRow> _allFines = new();
    private List<VehicleDto> _vehicleMatches = new();
    private List<RegistrationSearchResultDto> _registrationMatches = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<FineRow> PagedFines => _fines.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_fines.Count / (double)_pageSize));
    private List<string> SearchResolutionLines => BuildSearchResolutionLines();

    protected override async Task OnInitializedAsync()
    {
        await LoadFines();
    }

    private async Task LoadFines()
    {
        _loading = true;
        try
        {
            var apiItems = await FineService.GetAllAsync<FineDto>();
            _allFines = apiItems.Select(f => new FineRow(
                FineId: f.Fine_code,
                VehicleId: f.vmf_code,
                OffenceDate: f.Offence_date,
                DocumentType: f.Offence_name,
                GmtDate: f.Receive_gg_date
            )).ToList();
            _fines = new List<FineRow>(_allFines);
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchFines()
    {
        _loading = true;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _vehicleMatches = new();
            _registrationMatches = new();
            _fines = new List<FineRow>(_allFines);
            _page = 1;
            _loading = false;
            return;
        }

        try
        {
            var searchTerm = _searchQuery.Trim();
            HashSet<int> vmfCodes;

            if (_searchType == "GG")
            {
                _vehicleMatches = VehicleSearchHelper.RankVehicleMatches(
                    await VehicleService.SearchVehiclesAsync(searchTerm),
                    searchTerm,
                    VehicleSearchHelper.GgMode);
                _registrationMatches = new();
                vmfCodes = _vehicleMatches.Select(v => v.vmf_code).ToHashSet();
            }
            else
            {
                var registrationResponse = await RegistrationService.SearchAsync(searchTerm);
                _registrationMatches = registrationResponse.results
                    .OrderBy(match => match.is_historical_match)
                    .ThenBy(match => match.fleet_number)
                    .ToList();
                _vehicleMatches = new();
                vmfCodes = _registrationMatches.Select(match => match.vmf_code).ToHashSet();
            }

            _fines = vmfCodes.Count == 0
                ? new()
                : _allFines.Where(f => f.VehicleId.HasValue && vmfCodes.Contains(f.VehicleId.Value)).ToList();
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetSearchType(string value)
    {
        _searchType = value;
        _searchQuery = string.Empty;
        _vehicleMatches = new();
        _registrationMatches = new();
        _fines = new List<FineRow>(_allFines);
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string GetAddFineUrl()
    {
        var suggestedVmfCodes = (_searchType == "GP"
                ? _registrationMatches.Select(match => match.vmf_code)
                : _vehicleMatches.Select(match => match.vmf_code))
            .Distinct()
            .ToList();

        var suggestedVmfCode = suggestedVmfCodes.Count == 1
            ? suggestedVmfCodes[0]
            : 0;

        if (suggestedVmfCode <= 0)
        {
            return "/fines/maintenance/detail";
        }

        return $"/fines/maintenance/detail?vmfCode={suggestedVmfCode}&searchType={_searchType}&searchQuery={Uri.EscapeDataString(_searchQuery.Trim())}";
    }

    private List<string> BuildSearchResolutionLines()
    {
        if (_searchType == "GP")
        {
            return _registrationMatches
                .Take(5)
                .Select(match => match.is_historical_match
                    ? $"Historical GP {ValueOrDash(match.matched_registration)} now belongs to {ValueOrDash(match.fleet_number)} / current GP {ValueOrDash(match.current_registration)}."
                    : $"Current GP {ValueOrDash(match.current_registration)} belongs to {ValueOrDash(match.fleet_number)}.")
                .ToList();
        }

        return _vehicleMatches
            .Take(5)
            .Select(vehicle => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})")
            .ToList();
    }

    private sealed record FineRow(
        int FineId,
        int? VehicleId,
        DateTime? OffenceDate,
        string? DocumentType,
        DateTime? GmtDate
    );
}
