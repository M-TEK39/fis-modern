@page "/fines/maintenance"
@rendermode InteractiveServer

<PageTitle>Fine Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fine Maintenance
        </h1>
        <p class="page-description">Search fines by GP or GG number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Vehicle Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" />
                            GG
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" checked />
                            GP
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Number</label>
                        <input class="form-input" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Fines Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Offence Date</th>
                                    <th>Doc Type</th>
                                    <th>Date at GMT</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2024/01/15</td>
                                    <td>Notice of Traffic Offence</td>
                                    <td>2024/01/18</td>
                                    <td><a href="/fines/maintenance/detail">Mod</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-actions">
                    <a class="btn btn-primary btn-sm" href="/fines/maintenance/detail">Add</a>
                </div>
            </div>
        </div>
    </div>
</div>
