@page "/fines"
@rendermode InteractiveServer

<PageTitle>Fines - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fines Maintenance Menu
        </h1>
        <p class="page-description">Legacy maintenance and report workflows.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Fines Maintenance</span>
                <i class="bx bx-wrench"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><span class="menu-item-link">Fines Maintenance Information / Help</span></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/maintenance">1) Fine Maintenance</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/delete">2) Delete a Fine</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/traffic-dept">3) Add / Update &amp; Delete Traffic Dept</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Fines Reports</span>
                <i class="bx bx-file"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/fines/reports">Fines Reports Menu</a></div>
            </div>
        </div>
    </div>
</div>
