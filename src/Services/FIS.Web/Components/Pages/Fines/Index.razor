@page "/fines"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FineApiService FineService
@inject IJSRuntime JSRuntime

<PageTitle>Fines - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fines Maintenance Menu
        </h1>
        <p class="page-description">Maintenance and report workflows.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Fines Maintenance</span>
                <i class="bx bx-wrench"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><span class="menu-item-link">Fines Maintenance Information / Help</span></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/maintenance">1) Fine Maintenance</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/delete">2) Delete a Fine</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/fines/traffic-dept">3) Add / Update &amp; Delete Traffic Dept</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Fines Reports</span>
                <i class="bx bx-file"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/fines/reports">Fines Reports Menu</a></div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Fine Preview"
                      SearchPlaceholder="Search fine reference, issuer, offence, GG code..."
                      EmptyMessage="No fines match the current search or filter."
                      EmptyIcon="bx bx-receipt"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("reference", "Reference"),
        new("vmfCode", "GG Code"),
        new("offenceDate", "Offence Date"),
        new("issuer", "Issuer"),
        new("amount", "Amount"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Open fines", "status", "Open"),
        new("Paid fines", "status", "Paid"),
        new("Withdrawn fines", "status", "Withdrawn"),
        new("Court appearance set", "appearanceStatus", "Appearance Set")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var fines = await FineService.GetAllAsync<FineDto>();
            _rows = fines
                .OrderByDescending(item => item.Offence_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["reference"] = item.Offence_reference,
                    ["vmfCode"] = item.vmf_code?.ToString(),
                    ["offenceDate"] = FormatDate(item.Offence_date),
                    ["issuer"] = item.Offence_issuer,
                    ["amount"] = item.Fine_amount?.ToString("C0"),
                    ["status"] = GetFineStatus(item),
                    ["appearanceStatus"] = item.Appear_date.HasValue ? "Appearance Set" : "No Appearance",
                    ["_href"] = $"/fines/maintenance/detail?fineId={item.Fine_code}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading fines preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetFineStatus(FineDto item)
    {
        if (item.Withdraw_date.HasValue)
        {
            return "Withdrawn";
        }

        return item.Fine_pay_date.HasValue ? "Paid" : "Open";
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
