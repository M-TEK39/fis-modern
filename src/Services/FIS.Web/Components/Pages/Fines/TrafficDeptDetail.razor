@page "/fines/traffic-dept/detail"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrafficDeptApiService TrafficDeptService

<PageTitle>Traffic Dept Detail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building"></i>
            Traffic Dept Detail
        </h1>
        <p class="page-description">Add or update traffic department information.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines/traffic-dept">Back to Traffic Dept</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Traffic Dept Name</label>
                    <input class="form-input" @bind="_trafficDept.Traf_name" />
                </div>
                <div class="form-field">
                    <label class="form-label">Responsible Person</label>
                    <input class="form-input" @bind="_trafficDept.Traf_res_person" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Address1</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_address1" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Address2</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_address2" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Code</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_code" />
                </div>
                <div class="form-field">
                    <label class="form-label">Tel</label>
                    <input class="form-input" @bind="_trafficDept.Traf_telephone" />
                </div>
                <div class="form-field">
                    <label class="form-label">Fax</label>
                    <input class="form-input" @bind="_trafficDept.Traf_fax" />
                </div>
                <div class="form-field">
                    <label class="form-label">Cell</label>
                    <input class="form-input" @bind="_trafficDept.Traf_telephone" />
                </div>
                <div class="form-field">
                    <label class="form-label">eMail</label>
                    <input class="form-input" @bind="_trafficDept.Traf_email" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary btn-sm" @onclick="SaveTrafficDept">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/fines/traffic-dept">Menu</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "trafficDeptId")]
    public int? TrafficDeptId { get; set; }

    private TrafficDeptDto _trafficDept = new();

    protected override async Task OnInitializedAsync()
    {
        if (TrafficDeptId.HasValue)
        {
            var existing = await TrafficDeptService.GetByIdAsync<TrafficDeptDto>(TrafficDeptId.Value);
            if (existing is not null)
            {
                _trafficDept = existing;
            }
        }
    }

    private async Task SaveTrafficDept()
    {
        if (TrafficDeptId.HasValue)
        {
            await TrafficDeptService.UpdateAsync(TrafficDeptId.Value, _trafficDept);
        }
        else
        {
            await TrafficDeptService.CreateAsync(_trafficDept);
        }
    }
}
