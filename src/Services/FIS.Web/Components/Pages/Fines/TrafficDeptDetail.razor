@page "/fines/traffic-dept/detail"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TrafficDeptApiService TrafficDeptService
@inject NavigationManager Navigation

<PageTitle>Traffic Dept Detail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building"></i>
            Traffic Dept Detail
        </h1>
        <p class="page-description">Add, update, or delete traffic department information.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines/traffic-dept">Back to Traffic Dept</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Traffic Dept Name</label>
                    <input class="form-input" @bind="_trafficDept.Traf_name" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Responsible Person</label>
                    <input class="form-input" @bind="_trafficDept.Traf_res_person" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Address1</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_address1" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal Address2</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_address2" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Postal / ZIP</label>
                    <input class="form-input" @bind="_trafficDept.Traf_post_code" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Tel</label>
                    <input class="form-input" @bind="_trafficDept.Traf_telephone" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Fax</label>
                    <input class="form-input" @bind="_trafficDept.Traf_fax" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">Cell</label>
                    <input class="form-input" @bind="_trafficDept.Traf_cell" disabled="@IsDeleteMode" />
                </div>
                <div class="form-field">
                    <label class="form-label">eMail</label>
                    <input class="form-input" @bind="_trafficDept.Traf_email" disabled="@IsDeleteMode" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn @(IsDeleteMode ? "btn-danger" : "btn-primary") btn-sm" @onclick="SaveTrafficDept">
                    @(IsDeleteMode ? "Delete" : "Submit")
                </button>
                <a class="btn btn-secondary btn-sm" href="/fines/traffic-dept">Menu</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "trafficDeptId")]
    public int? TrafficDeptId { get; set; }

    [SupplyParameterFromQuery(Name = "action")]
    public string? Action { get; set; }

    private TrafficDeptDto _trafficDept = new();
    private bool IsDeleteMode => string.Equals(Action, "delete", StringComparison.OrdinalIgnoreCase);
    private bool IsEditMode => !IsDeleteMode;

    protected override async Task OnInitializedAsync()
    {
        if (TrafficDeptId.HasValue)
        {
            var existing = await TrafficDeptService.GetByIdAsync<TrafficDeptDto>(TrafficDeptId.Value);
            if (existing is not null)
            {
                _trafficDept = existing;
            }
        }
    }

    private async Task SaveTrafficDept()
    {
        if (IsDeleteMode)
        {
            await DeleteTrafficDept();
            return;
        }

        if (TrafficDeptId.HasValue)
        {
            await TrafficDeptService.UpdateAsync(TrafficDeptId.Value, _trafficDept);
        }
        else
        {
            await TrafficDeptService.CreateAsync(_trafficDept);
        }

        Navigation.NavigateTo("/fines/traffic-dept");
    }

    private async Task DeleteTrafficDept()
    {
        if (!TrafficDeptId.HasValue)
        {
            return;
        }

        await TrafficDeptService.DeleteAsync(TrafficDeptId.Value);
        Navigation.NavigateTo("/fines/traffic-dept");
    }
}
