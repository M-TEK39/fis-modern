@page "/fines/delete"
@rendermode InteractiveServer

<PageTitle>Delete Fines - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Fines
        </h1>
        <p class="page-description">Lookup fines by registration number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Registration Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">REG Number</label>
                        <input class="form-input" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Fines Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Offence Date</th>
                                    <th>Doc Type</th>
                                    <th>Date at GMT</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2024/01/22</td>
                                    <td>Notice of Summons to be Issued</td>
                                    <td>2024/01/25</td>
                                    <td><a href="/fines/delete/detail">DELETE</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
