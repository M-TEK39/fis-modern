@page "/fines/delete"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FineApiService FineService
@inject VehicleApiService VehicleService

<PageTitle>Delete Fines - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Fines
        </h1>
        <p class="page-description">Lookup fines by registration number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines">Back to Fines Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Vehicle Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                            GG
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="fineNumberType" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                            GP
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">@(_searchType == "GG" ? "GG Number" : "GP Number")</label>
                        <input class="form-input" @bind="_searchQuery" @bind:event="oninput" placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchFines">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/fines">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Fines Found</h2>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Offence Date</th>
                                    <th>Doc Type</th>
                                    <th>Date at GMT</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_loading)
                                {
                                    <tr>
                                        <td colspan="4">Loading fines...</td>
                                    </tr>
                                }
                                else if (_fines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var fine in PagedFines)
                                    {
                                        <tr>
                                            <td>@FormatDate(fine.OffenceDate)</td>
                                            <td>@ValueOrDash(fine.DocumentType)</td>
                                            <td>@FormatDate(fine.GmtDate)</td>
                                            <td><a href="@($"/fines/delete/detail?fineId={fine.FineId}")">DELETE</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_fines.Count > _pageSize)
                    {
                        <div class="pagination">
                            <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                            <div class="pagination-info">Page @_page of @TotalPages</div>
                            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                        </div>
                        <div class="pagination-meta">Total records: @_fines.Count | Page size: @_pageSize</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _searchQuery = "";
    private string _searchType = "GP";
    private bool _loading;
    private List<FineRow> _fines = new();
    private List<FineRow> _allFines = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<FineRow> PagedFines => _fines.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_fines.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadFines();
    }

    private async Task LoadFines()
    {
        _loading = true;
        try
        {
            var apiItems = await FineService.GetAllAsync<FineDto>();
            _allFines = apiItems.Select(f => new FineRow(
                FineId: f.Fine_code,
                VehicleId: f.vmf_code,
                OffenceDate: f.Offence_date,
                DocumentType: f.Offence_name,
                GmtDate: f.Receive_gg_date
            )).ToList();
            _fines = new List<FineRow>(_allFines);
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchFines()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _fines = new List<FineRow>(_allFines);
            _page = 1;
            return;
        }

        var searchTerm = _searchQuery.Trim();
        var matches = await VehicleService.SearchVehiclesAsync(searchTerm);
        matches = FilterVehicleMatchesByNumberType(matches, searchTerm, _searchType);
        if (matches.Count == 0)
        {
            _fines = new();
            _page = 1;
            return;
        }

        var vmfCodes = matches.Select(v => v.vmf_code).ToHashSet();
        _fines = _allFines.Where(f => f.VehicleId.HasValue && vmfCodes.Contains(f.VehicleId.Value)).ToList();
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void SetSearchType(string value)
    {
        _searchType = value;
        _searchQuery = string.Empty;
        _fines = new List<FineRow>(_allFines);
        _page = 1;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatchesByNumberType(List<VehicleDto> matches, string searchTerm, string searchType)
    {
        return searchType == "GG"
            ? matches
                .Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(v => string.Equals(v.fleet_number?.Trim(), searchTerm, StringComparison.OrdinalIgnoreCase))
                .ThenBy(v => v.vmf_code)
                .ToList()
            : matches
                .Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(v => string.Equals(v.registration_number?.Trim(), searchTerm, StringComparison.OrdinalIgnoreCase))
                .ThenBy(v => v.vmf_code)
                .ToList();
    }

    private sealed record FineRow(
        int FineId,
        int? VehicleId,
        DateTime? OffenceDate,
        string? DocumentType,
        DateTime? GmtDate
    );
}
