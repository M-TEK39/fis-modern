@page "/fines/maintenance/detail"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject FineApiService FineService
@inject RegistrationApiService RegistrationService
@inject TrafficDeptApiService TrafficDeptService
@inject SiteApiService SiteService
@inject VehicleApiService VehicleService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Fine Maintenance Detail - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Fine Maintenance Detail
        </h1>
        <p class="page-description">Add or update a fine record against the correct vehicle, including historical GP matches.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines/maintenance">Back to Fine Maintenance</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_messageIsError ? "alert-error" : "alert-success")">@_message</div>
            }

            <div class="form-section">
                <h2 class="form-section-title">Vehicle</h2>
                @if (FineId.HasValue)
                {
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Vehicle</label>
                            <input class="form-input" value="@_selectedVehicleLabel" readonly />
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Number Type</label>
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="fineVehicleMode" checked="@(_vehicleSearchMode == "GG")" @onchange='() => SetVehicleSearchMode("GG")' />
                                    GG
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="fineVehicleMode" checked="@(_vehicleSearchMode == "GP")" @onchange='() => SetVehicleSearchMode("GP")' />
                                    GP
                                </label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">@(_vehicleSearchMode == "GG" ? "GG Number" : "GP Number")</label>
                            <div class="fis-input-group-compact">
                                <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_vehicleSearchMode == "GG" ? "Enter GG number" : "Enter current or old GP number")" />
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="SearchVehicleAsync">Find</button>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Vehicle Match</label>
                            <select class="form-select" @bind="_selectedVehicleVmfCode" disabled="@(_vehicleOptions.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var option in _vehicleOptions)
                                {
                                    <option value="@option.VmfCode">@option.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (_selectedVehicleOption?.IsHistoricalMatch == true)
                    {
                        <div class="alert alert-success">
                            Historical GP @ValueOrDash(_selectedVehicleOption.MatchedRegistration) resolved to current vehicle @ValueOrDash(_selectedVehicleOption.FleetNumber) / @ValueOrDash(_selectedVehicleOption.CurrentRegistration).
                        </div>
                    }
                }
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Date of Offence</label>
                    <input class="form-input" type="date" @bind="_fine.Offence_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Reference Number</label>
                    <input class="form-input" @bind="_fine.Offence_reference" />
                </div>
                <div class="form-field">
                    <label class="form-label">Issued by</label>
                    <input class="form-input" @bind="_fine.Offence_issuer" />
                </div>
                <div class="form-field">
                    <label class="form-label">Traffic Dept</label>
                    <select class="form-select" @bind="_selectedTrafficDept">
                        <option value="">Select Traffic Dept</option>
                        @foreach (var dept in _trafficDepts)
                        {
                            <option value="@dept.Traffic_dept_code">@($"{dept.Traf_name} ({dept.Traffic_dept_code})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Amount of Fine</label>
                    <input class="form-input" type="number" step="0.01" @bind="_fine.Fine_amount" />
                </div>
                <div class="form-field">
                    <label class="form-label">Due Date of Payment</label>
                    <input class="form-input" type="date" @bind="_fine.Pay_due_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Due Date to Appear in Court</label>
                    <input class="form-input" type="date" @bind="_fine.Appear_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Document Type</label>
                    <select class="form-select" @bind="_fine.Offence_name">
                        <option value="">Select Document Type</option>
                        <option value="Notice of Traffic Offence">Notice of Traffic Offence</option>
                        <option value="Notice of Summons to be Issued">Notice of Summons to be Issued</option>
                        <option value="Summons in Criminal Case">Summons in Criminal Case</option>
                        <option value="Warrant for Arrest">Warrant for Arrest</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Date Received at GMT</label>
                    <input class="form-input" type="date" @bind="_fine.Receive_gg_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Date of Notification to Issuer</label>
                    <input class="form-input" type="date" @bind="_fine.Issuer_notify_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Date of Notification to Dept</label>
                    <input class="form-input" type="date" @bind="_fine.Notify_dept_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_fine.Site_code">
                        <option value="">Select Dept/Site</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Name Responsible person at Dept</label>
                    <input class="form-input" @bind="_deptResponsibleName" />
                </div>
                <div class="form-field">
                    <label class="form-label">ID Responsible person at Dept</label>
                    <input class="form-input" @bind="_deptResponsibleId" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary btn-sm" @onclick="SaveFine">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/fines/maintenance">Menu</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "fineId")]
    public int? FineId { get; set; }

    [SupplyParameterFromQuery(Name = "vmfCode")]
    public int? VmfCode { get; set; }

    [SupplyParameterFromQuery(Name = "searchType")]
    public string? SearchType { get; set; }

    [SupplyParameterFromQuery(Name = "searchQuery")]
    public string? SearchQuery { get; set; }

    private FineDto _fine = new();
    private short? _selectedTrafficDept;
    private string _deptResponsibleName = "";
    private string _deptResponsibleId = "";
    private List<TrafficDeptDto> _trafficDepts = new();
    private List<SiteResponseDto> _sites = new();
    private string _vehicleSearchMode = "GP";
    private string _vehicleSearchTerm = string.Empty;
    private int? _selectedVehicleVmfCode;
    private string _selectedVehicleLabel = "-";
    private string _message = string.Empty;
    private bool _messageIsError;
    private List<VehicleOption> _vehicleOptions = new();
    private VehicleOption? _selectedVehicleOption => _vehicleOptions.FirstOrDefault(option => option.VmfCode == _selectedVehicleVmfCode);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadLookups();

            if (FineId.HasValue)
            {
                var existing = await FineService.GetByIdAsync<FineDto>(FineId.Value);
                if (existing is not null)
                {
                    _fine = existing;
                    _selectedVehicleVmfCode = _fine.vmf_code;
                }
            }
            else
            {
                _vehicleSearchMode = string.Equals(SearchType, "GG", StringComparison.OrdinalIgnoreCase) ? "GG" : "GP";
                _vehicleSearchTerm = SearchQuery?.Trim() ?? string.Empty;
                _selectedVehicleVmfCode = VmfCode;

                if (!string.IsNullOrWhiteSpace(_vehicleSearchTerm))
                {
                    await SearchVehicleAsync();
                }
                else if (_selectedVehicleVmfCode.HasValue)
                {
                    await EnsureVehicleOptionAsync(_selectedVehicleVmfCode.Value);
                }
            }

            if (_selectedVehicleVmfCode.HasValue)
            {
                await LoadSelectedVehicleLabelAsync(_selectedVehicleVmfCode.Value);
            }
        }
        catch (Exception ex)
        {
            _message = "Failed to load fine details.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task LoadLookups()
    {
        _trafficDepts = await TrafficDeptService.GetAllAsync<TrafficDeptDto>();
        _sites = await SiteService.GetAllAsync();
    }

    private async Task SearchVehicleAsync()
    {
        _message = string.Empty;

        if (string.IsNullOrWhiteSpace(_vehicleSearchTerm))
        {
            _vehicleOptions = new();
            _selectedVehicleVmfCode = null;
            _selectedVehicleLabel = "-";
            return;
        }

        try
        {
            var searchTerm = _vehicleSearchTerm.Trim();

            if (_vehicleSearchMode == "GG")
            {
                _vehicleOptions = VehicleSearchHelper.RankVehicleLookupMatches(
                        await VehicleLookupService.SearchAsync(searchTerm),
                        searchTerm,
                        VehicleSearchHelper.GgMode)
                    .Select(vehicle => new VehicleOption(
                        vehicle.VmfCode,
                        $"{ValueOrDash(vehicle.GGNumber)} / {ValueOrDash(vehicle.RegistrationNumber)} ({vehicle.VmfCode})",
                        ValueOrDash(vehicle.GGNumber),
                        vehicle.RegistrationNumber,
                        vehicle.RegistrationNumber,
                        false,
                        null))
                    .ToList();
            }
            else
            {
                var response = await RegistrationService.SearchAsync(searchTerm);
                _vehicleOptions = response.results
                    .GroupBy(result => result.vmf_code)
                    .Select(group => group
                        .OrderBy(result => result.is_historical_match)
                        .ThenByDescending(result => result.recorded_date)
                        .First())
                    .Select(result => new VehicleOption(
                        result.vmf_code,
                        $"{ValueOrDash(result.fleet_number)} / {ValueOrDash(result.current_registration)} ({result.vmf_code})",
                        ValueOrDash(result.fleet_number),
                        result.current_registration,
                        result.matched_registration,
                        result.is_historical_match,
                        result.recorded_date))
                    .ToList();
            }

            if (_vehicleOptions.All(option => option.VmfCode != _selectedVehicleVmfCode))
            {
                _selectedVehicleVmfCode = _vehicleOptions.Count == 1 ? _vehicleOptions[0].VmfCode : null;
            }

            if (_selectedVehicleVmfCode.HasValue)
            {
                await LoadSelectedVehicleLabelAsync(_selectedVehicleVmfCode.Value);
            }
        }
        catch (Exception ex)
        {
            _vehicleOptions = new();
            _selectedVehicleVmfCode = null;
            _message = "Failed to search for the vehicle.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task SaveFine()
    {
        _message = string.Empty;

        if (!_selectedVehicleVmfCode.HasValue)
        {
            _message = "Select the vehicle before saving the fine.";
            _messageIsError = true;
            return;
        }

        try
        {
            _fine.vmf_code = _selectedVehicleVmfCode;

            if (FineId.HasValue)
            {
                await FineService.UpdateAsync(FineId.Value, _fine);
                _message = "Fine updated.";
            }
            else
            {
                await FineService.CreateAsync(_fine);
                _message = "Fine captured.";
            }

            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = "Failed to save the fine.";
            _messageIsError = true;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void SetVehicleSearchMode(string mode)
    {
        if (_vehicleSearchMode == mode)
        {
            return;
        }

        _vehicleSearchMode = mode;
        _vehicleSearchTerm = string.Empty;
        _vehicleOptions = new();
        _selectedVehicleVmfCode = null;
        _selectedVehicleLabel = "-";
        _message = string.Empty;
    }

    private async Task EnsureVehicleOptionAsync(int vmfCode)
    {
        if (_vehicleOptions.Any(option => option.VmfCode == vmfCode))
        {
            return;
        }

        var vehicle = await VehicleService.GetVehicleAsync(vmfCode);
        if (vehicle == null)
        {
            return;
        }

        _vehicleOptions.Add(new VehicleOption(
            vmfCode,
            $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vmfCode})",
            ValueOrDash(vehicle.fleet_number),
            vehicle.registration_number,
            vehicle.registration_number,
            false,
            null));
    }

    private async Task LoadSelectedVehicleLabelAsync(int vmfCode)
    {
        await EnsureVehicleOptionAsync(vmfCode);

        var selectedOption = _vehicleOptions.FirstOrDefault(option => option.VmfCode == vmfCode);
        _selectedVehicleLabel = selectedOption?.Label ?? $"- ({vmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private sealed record VehicleOption(
        int VmfCode,
        string Label,
        string FleetNumber,
        string? CurrentRegistration,
        string? MatchedRegistration,
        bool IsHistoricalMatch,
        DateTime? RecordedDate);
}
