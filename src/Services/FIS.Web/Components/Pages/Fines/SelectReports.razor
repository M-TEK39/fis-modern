@page "/fines/reports/select"
@rendermode InteractiveServer

<PageTitle>Fines Report Selection - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-filter"></i>
            Fines Report Selection
        </h1>
        <p class="page-description">Select an option below and proceed.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/fines/reports">Back to Fines Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Report Type</label>
                    <select class="form-select" @bind="_selected">
                        <option value="dept-period">Department/Site</option>
                        <option value="metro">Metro (Municipality)</option>
                        <option value="vehicle">Vehicle</option>
                        <option value="all">A List of all Fines</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-primary btn-sm" href="/fines/reports/@_selected">Click to continue</a>
                <a class="btn btn-secondary btn-sm" href="/fines/reports">Menu</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string _selected = "dept-period";
}
