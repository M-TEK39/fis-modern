@page "/home"
@rendermode InteractiveServer
@using System.Linq

<PageTitle>Fleet Information System</PageTitle>

<article class="legacy-home">
    <section class="legacy-heading">
        <h2>Gauteng Provincial Government</h2>
        <h3>g-FleeT Management<br />Fleet Information System</h3>
    </section>

    <hr />

    <p>
        Welcome to the Fleet Information System Web Site of the Gauteng Provincial Government.<br />
        This site controls the issuing of Trip Authorities used by the Provincial Government.
        These Authorities can be issued and printed from this site for free.
    </p>

    <hr />

    <section>
        <p>Please click on the links below to download pertinent information:</p>

        <div class="doc-grid">
            @foreach (var doc in VisibleDocuments)
            {
                <article class="doc-card">
                    <header>
                        <h4>@doc.Title</h4>
                    </header>
                    <p>@doc.Description</p>
                    <a href="@doc.Href">Download</a>
                </article>
            }
        </div>

        <div class="paginator" role="navigation" aria-label="Document pagination">
            <button type="button" @onclick="PreviousPage" disabled="@IsFirstPage">Previous</button>
            <span>Page @(CurrentPage + 1) of @TotalPages</span>
            <button type="button" @onclick="NextPage" disabled="@IsLastPage">Next</button>
        </div>
    </section>

    <hr />

    <p>
        Please note that all actions on this site are logged and will be audited from time to time.
    </p>

    <hr />

    <p>
        ADOBE ACROBAT might be required to view some of the files on this site.
        Please click below to download the latest version for free from Adobe.
    </p>

    <p class="acrobat-link">
        <a href="http://www.adobe.com/products/acrobat/readstep2.html">
            <img
                alt="Get Adobe Acrobat Reader"
                src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS_DYgKcoBKX3I4tNr5qigAUGIx5LCEipaAZg&s" />
        </a>
    </p>
</article>

@code {
    private sealed record DocumentLink(string Title, string Href, string Description);

    private static readonly DocumentLink[] DocumentLinks =
    [
        new("Trip Request Form", "/Docs/TRIP REQUEST FORM.doc", "Standard template required for issuing a Trip Authority."),
        new("Electronic Logsheet and Trip Authority Training Manual", "/Docs/Electronic Log Sheet and Trip Authority Training Manual.doc", "Step-by-step user training for the electronic logsheet workflow."),
        new("Transport Circular No. 4 of 2000", "/Docs/Policy4 of 2000.doc", "Official transport policy adopted by the Gauteng Provincial Government."),
        new("Manual: Updating Trip Authorities", "/Docs/doc/Updating Trip Authorities Manual2.htm", "Procedural guide for updating existing trip authority records."),
        new("Trip Request Form (Chauffeur Driven Service)", "/private_hire/trip_request_form.htm", "Chauffeur-driven service requisition for private hire vehicles."),
        new("Procedures Manual (Chauffeur Driven Service)", "/private_hire/Procedures_manual.htm", "Detailed procedures governing the chauffeur driven service."),
        new("State Driver Accident Review Form", "/Docs/State_Driver_Accident_Review.doc", "Incident form for state driver accident review panels."),
        new("Accident Sketch Document", "/Docs/Accident_Sketch.doc", "Blank sketch template to accompany accident submissions."),
        new("Accident Form – Page 1 of 4", "/Docs/Accident form Z181 page 1 of 4.pdf", "Official Z181 form: incident details."),
        new("Accident Form – Page 2 of 4", "/Docs/Accident form Z181 page 2 of 4.pdf", "Official Z181 form: vehicle particulars."),
        new("Accident Form – Page 3 of 4", "/Docs/Accident form Z181 page 3 of 4.pdf", "Official Z181 form: witness and statement capture."),
        new("Accident Form – Page 4 of 4", "/Docs/Accident form Z181 page 4 of 4.pdf", "Official Z181 form: declaration and approvals."),
        new("Application for Safe Keeping Vehicle", "/Docs/Aplication form for safe keeping of vehicles.pdf", "Application to store vehicles securely under custodianship."),
        new("Standard Bank Lost Fuel Card Form", "/Docs/Lost fuel Card.pdf", "Notification form for lost Standard Bank fleet cards."),
        new("Standard Bank Damaged Fuel Card Form", "/Docs/Damaged fuel Card.pdf", "Replacement request for damaged Standard Bank fleet cards."),
        new("Manuals", "/Manuals/Allmanuals.htm", "Consolidated library of system manuals and references."),
        new("RFC Form", "/Docs/DPTRW_RFC.pdf", "Request for change (RFC) template used by departmental admins."),
        new("DITC Form", "/Docs/DITC Form.pdf", "Driver Information and Trip Confirmation document."),
        new("FIS Staff Registration and Review Form", "/Docs/Staff Registration and Review form.pdf", "Internal form for onboarding and reviewing staff access."),
        new("FIS User Registration and Review Form", "/Docs/Client user Registration and Review form.pdf", "Client user on-boarding and annual review artefact."),
        new("Manual for Changing Password", "/Docs/Implementation of User Admin on GGMT system.doc", "Guidance on rotating passwords inside the legacy User Admin module.")
    ];

    private const int PageSize = 9;
    private int CurrentPage { get; set; } = 0;
    private int TotalPages => (int)Math.Ceiling(DocumentLinks.Length / (double)PageSize);
    private bool IsFirstPage => CurrentPage == 0;
    private bool IsLastPage => CurrentPage >= TotalPages - 1;
    private IEnumerable<DocumentLink> VisibleDocuments => DocumentLinks.Skip(CurrentPage * PageSize).Take(PageSize);

    private void NextPage()
    {
        if (!IsLastPage)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }

    private void PreviousPage()
    {
        if (!IsFirstPage)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }
}
