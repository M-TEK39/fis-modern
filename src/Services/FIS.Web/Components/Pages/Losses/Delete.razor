@page "/losses/delete"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using FIS.Web.Services
@using FIS.Web.Models
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LossApiService LossService
@inject DepartmentApiService DepartmentService

<PageTitle>Delete Loss - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Loss
        </h1>
        <p class="page-description">Delete flow with confirmation of reference and department.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses")'>
            <i class="bx bx-arrow-back"></i>
            Back to Losses Menu
        </button>
    </div>
</div>

<div class="page-content">
    <EditForm Model="_deleteModel" OnValidSubmit="HandleDelete">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Loss Reference</label>
                <InputText class="form-input" @bind-Value="_deleteModel.LossReference" />
            </div>
            <div class="form-field">
                <label class="form-label">Department</label>
                <select class="form-select" @bind="_deleteModel.Department">
                    <option value="">Select Department</option>
                    @foreach (var department in _departments.OrderBy(d => d.department_description))
                    {
                        <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">Loss Date</label>
                <InputDate class="form-input" @bind-Value="_deleteModel.LossDate" />
            </div>
            <div class="form-field">
                <label class="form-label">Reason for Delete</label>
                <InputTextArea class="form-input" rows="3" @bind-Value="_deleteModel.Reason" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-danger" type="submit" disabled="@_deleting">
                <i class="bx bx-trash"></i>
                @(_deleting ? "Deleting..." : "Confirm Delete")
            </button>
        </div>
        @if (_deleted)
        {
            <div class="alert alert-warning">
                Loss reference @_deleteModel.LossReference has been marked for deletion.
            </div>
        }
    </EditForm>
</div>

@code {
    private readonly DeleteModel _deleteModel = new();
    private bool _deleted;
    private bool _deleting;
    private List<DepartmentDto> _departments = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await DepartmentService.GetDepartmentsAsync();
    }

    private async Task HandleDelete()
    {
        if (!int.TryParse(_deleteModel.LossReference, out var lossId))
        {
            _deleted = false;
            return;
        }

        _deleting = true;
        try
        {
            await LossService.DeleteAsync(lossId);
            _deleted = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error deleting loss: {ex.Message}");
            _deleted = false;
        }
        finally
        {
            _deleting = false;
        }
    }

    private sealed class DeleteModel
    {
        public string LossReference { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public DateTime LossDate { get; set; } = DateTime.Today;
        public string Reason { get; set; } = string.Empty;
    }
}
