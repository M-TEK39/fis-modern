@page "/losses/delete"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Delete Loss - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Loss
        </h1>
        <p class="page-description">Legacy delete flow with confirmation of reference and department.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses")'>
            <i class="bx bx-arrow-back"></i>
            Back to Losses Menu
        </button>
    </div>
</div>

<div class="page-content">
    <EditForm Model="_deleteModel" OnValidSubmit="HandleDelete">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Loss Reference</label>
                <InputText class="form-input" @bind-Value="_deleteModel.LossReference" />
            </div>
            <div class="form-field">
                <label class="form-label">Department</label>
                <InputText class="form-input" @bind-Value="_deleteModel.Department" />
            </div>
            <div class="form-field">
                <label class="form-label">Loss Date</label>
                <InputDate class="form-input" @bind-Value="_deleteModel.LossDate" />
            </div>
            <div class="form-field">
                <label class="form-label">Reason for Delete</label>
                <InputTextArea class="form-input" rows="3" @bind-Value="_deleteModel.Reason" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-danger" type="submit">
                <i class="bx bx-trash"></i>
                Confirm Delete (mock)
            </button>
        </div>
        @if (_deleted)
        {
            <div class="alert alert-warning">
                Loss reference @_deleteModel.LossReference marked for delete (UI placeholder).
            </div>
        }
    </EditForm>
</div>

@code {
    private readonly DeleteModel _deleteModel = new();
    private bool _deleted;

    private Task HandleDelete()
    {
        _deleted = true;
        return Task.CompletedTask;
    }

    private sealed class DeleteModel
    {
        public string LossReference { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public DateTime LossDate { get; set; } = DateTime.Today;
        public string Reason { get; set; } = string.Empty;
    }
}
