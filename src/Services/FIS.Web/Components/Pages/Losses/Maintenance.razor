@page "/losses/maintenance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LossApiService LossService
@inject IJSRuntime JS

<PageTitle>Vehicle Losses Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-x-circle"></i>
            Vehicle Losses Maintenance
        </h1>
        <p class="page-description">Search by GG or GP number, then add or edit losses.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/losses">Back to Losses Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">GG / GP Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Number Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="lossNumberType" value="GG" @onchange="OnNumberTypeChanged" checked="@(_numberType == "GG")" />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="lossNumberType" value="GP" @onchange="OnNumberTypeChanged" checked="@(_numberType == "GP")" />
                                GP Number
                            </label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">@(_numberType == "GG" ? "GG Number" : "GP Number")</label>
                        <input class="form-input" @bind="_vehicleNumber" placeholder="@(_numberType == "GG" ? "Enter GG number" : "Enter GP number")" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SearchLosses" disabled="@_loading">
                        @(_loading ? "Loading..." : "Submit")
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/losses">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Losses Found (Sorted by Loss Date)</h2>
                @if (_loading)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Loading losses...</p>
                    </div>
                }
                else if (_losses.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bx bx-x-circle"></i>
                        <h3>No losses found</h3>
                        <p>Search by GG/GP number to see loss records.</p>
                    </div>
                }
                else
                {
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Loss Date</th>
                                        <th>Reference</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>Dept Claim</th>
                                        <th>SAPD</th>
                                        <th>Remarks</th>
                                        <th>HQ Reference</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loss in PagedLosses)
                                    {
                                        <tr>
                                            <td>@loss.loss_date?.ToString("yyyy/MM/dd")</td>
                                            <td>@loss.loss_reference</td>
                                            <td>@loss.loss_type_description</td>
                                            <td>@(loss.loss_amount?.ToString("0.00") ?? "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(loss.dept_claim) ? "-" : loss.dept_claim)</td>
                                            <td>@(string.IsNullOrWhiteSpace(loss.sapd_station) ? "-" : loss.sapd_station)</td>
                                            <td>@(string.IsNullOrWhiteSpace(loss.remarks) ? "-" : loss.remarks)</td>
                                            <td>@(string.IsNullOrWhiteSpace(loss.hq_reference) ? "-" : loss.hq_reference)</td>
                                            <td>
                                                <a href="/losses/edit">Mod</a>
                                                &nbsp;/&nbsp;
                                                <a href="/losses/delete">Del</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_losses.Count > _pageSize)
                        {
                            <div class="pagination">
                                <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                                <div class="pagination-info">Page @_page of @TotalPages</div>
                                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                            </div>
                            <div class="pagination-meta">Total records: @_losses.Count | Page size: @_pageSize</div>
                        }
                    </div>
                }
                <div class="form-actions">
                    <a class="btn btn-primary btn-sm" href="/losses/add">Add Losses</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _numberType = "GG";
    private string _vehicleNumber = string.Empty;
    private bool _loading;
    private List<LossDto> _losses = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<LossDto> PagedLosses => _losses.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_losses.Count / (double)_pageSize));

    private async Task SearchLosses()
    {
        if (string.IsNullOrWhiteSpace(_vehicleNumber))
        {
            _losses = new();
            return;
        }

        _loading = true;
        try
        {
            _losses = await LossService.GetByVehicleAsync<LossDto>(_vehicleNumber.Trim());
            _page = 1;
        }
        catch (Exception ex)
        {
            _losses = new();
            await JS.InvokeVoidAsync("console.error", $"Error loading losses: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnNumberTypeChanged(ChangeEventArgs args)
    {
        _numberType = args.Value?.ToString() ?? "GG";
        _vehicleNumber = string.Empty;
        _losses = new();
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
