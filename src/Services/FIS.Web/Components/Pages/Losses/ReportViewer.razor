@page "/losses/reports/{Mode}"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject NavigationManager Navigation
@inject LossReportApiService ReportService
@inject LossTypeApiService LossTypeService
@inject DepartmentApiService DepartmentService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Report parameters and output for losses.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses/reports")'>
            <i class="bx bx-arrow-back"></i>
            Back to Reports Menu
        </button>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Losses per Vehicle</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Fleet or Registration</label>
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                    GG
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                    GP
                                </label>
                            </div>
                            <div class="fis-input-group-compact">
                                <input type="text" class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                            </div>
                            <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode" @bind:after="ApplyVehicleSelection" disabled="@(_vehicleMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input type="date" class="form-input" @bind="_filter.BeginDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" @bind="_filter.EndDate" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadVehicleReport" disabled="@_loading">
                            @(_loading ? "Loading..." : "Generate")
                        </button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _vehicleColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@_vehicleColumns.Length">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedResults)
                                        {
                                            <tr>
                                                @foreach (var column in _vehicleColumns)
                                                {
                                                    <td>@GetValue(row, column)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "all")
            {
                <div class="form-section">
                    <h2 class="form-section-title">All Losses</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Loss Type</label>
                            <select class="form-select" @bind="_filter.LossTypeCode">
                                <option value="">Choose Type</option>
                                @foreach (var type in _lossTypes)
                                {
                                    <option value="@type.loss_code">@($"{type.loss_description} ({type.loss_code})")</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_filter.Department">
                                <option value="">All Departments</option>
                                @foreach (var department in _departments.OrderBy(d => d.department_description))
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadAllReport" disabled="@_loading">
                            @(_loading ? "Loading..." : "Generate")
                        </button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _allLossColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@_allLossColumns.Length">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedResults)
                                        {
                                            <tr>
                                                @foreach (var column in _allLossColumns)
                                                {
                                                    <td>@GetValue(row, column)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "no-report")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Outstanding Department Reports</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_filter.Department">
                                <option value="">All Departments</option>
                                @foreach (var department in _departments.OrderBy(d => d.department_description))
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Loss Date</label>
                            <input type="date" class="form-input" @bind="_filter.BeginDate" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadNoReport" disabled="@_loading">
                            @(_loading ? "Loading..." : "Generate")
                        </button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Loss Reference</th>
                                        <th>Department</th>
                                        <th>Loss Date</th>
                                        <th>Called Refer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedResults)
                                        {
                                            <tr>
                                                <td>@GetValue(row, "Loss Reference")</td>
                                                <td>@GetValue(row, "Department")</td>
                                                <td>@GetValue(row, "Loss Date")</td>
                                                <td>@GetValue(row, "Called Refer")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "with-report")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Departments That Submitted Reports</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Report Status</label>
                            <select class="form-select" @bind="_filter.ReportStatus">
                                <option>Submitted</option>
                                <option>Verified</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Reported Date</label>
                            <input type="date" class="form-input" @bind="_filter.BeginDate" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadWithReport" disabled="@_loading">
                            @(_loading ? "Loading..." : "Generate")
                        </button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Site</th>
                                        <th>Reported On</th>
                                        <th>Officer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedResults)
                                        {
                                            <tr>
                                                <td>@GetValue(row, "Reference")</td>
                                                <td>@GetValue(row, "Site")</td>
                                                <td>@GetValue(row, "Reported On")</td>
                                                <td>@GetValue(row, "Officer")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "dept-period")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Department Period Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_filter.Department">
                                <option value="">All Departments</option>
                                @foreach (var department in _departments.OrderBy(d => d.department_description))
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input type="date" class="form-input" @bind="_filter.BeginDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" @bind="_filter.EndDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Hire Type</label>
                            <select class="form-select" @bind="_filter.HireType">
                                <option>VIP</option>
                                <option>GG</option>
                                <option>Permanent</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadDeptPeriod" disabled="@_loading">
                            @(_loading ? "Loading..." : "Generate")
                        </button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _deptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@_deptPeriodColumns.Length">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedResults)
                                        {
                                            <tr>
                                                @foreach (var column in _deptPeriodColumns)
                                                {
                                                    <td>@GetValue(row, column)</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">Select a report from the menu to see parameters and layout.</p>
            }
        </div>
    </div>
    @if (_results.Count > 0 && TotalPages > 1)
    {
        <div class="pagination-controls">
            <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <span>Page @_page of @TotalPages</span>
            <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Loss Report";
    private bool _loading;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<LossTypeDto> _lossTypes = new();
    private List<DepartmentDto> _departments = new();
    private List<VehicleDto> _vehicleMatches = new();
    private string _searchMode = "GG";
    private string _vehicleSearchTerm = string.Empty;
    private int? _selectedVehicleVmfCode;
    private List<Dictionary<string, object>> _results = new();
    private IEnumerable<Dictionary<string, object>> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));
    private LossReportFilter _filter = new();

    protected override async Task OnInitializedAsync()
    {
        _lossTypes = await LossTypeService.GetAllAsync();
        _departments = await DepartmentService.GetDepartmentsAsync();
    }

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "vehicle" => "Losses for One Vehicle",
            "all" => "All Losses Report",
            "no-report" => "Losses Without Department Report",
            "with-report" => "Losses With Department Report",
            "dept-period" => "Losses Report by Department Period",
            _ => "Loss Report"
        };
        _vehicleMatches = new();
        _vehicleSearchTerm = string.Empty;
        _selectedVehicleVmfCode = null;
    }

    private static readonly string[] _vehicleColumns =
    {
        "Loss Date",
        "Garage",
        "Loss Reference",
        "Case Number",
        "Site",
        "SAPD",
        "Loss Type",
        "Loss Amount",
        "Remarks"
    };

    private static readonly string[] _allLossColumns =
    {
        "Reference",
        "Loss Date",
        "GG Number",
        "Hire Type",
        "Loss Type",
        "Department",
        "Status"
    };

    private static readonly string[] _deptPeriodColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Loss Date",
        "Dept Code",
        "Site",
        "Hire Type",
        "Loss Type",
        "Department Contact",
        "Loss Amount"
    };

    private async Task LoadVehicleReport() =>
        await LoadReport(() => ReportService.GetVehicleAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadAllReport() =>
        await LoadReport(() => ReportService.GetAllAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadNoReport() =>
        await LoadReport(() => ReportService.GetNoReportAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadWithReport() =>
        await LoadReport(() => ReportService.GetWithReportAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadDeptPeriod() =>
        await LoadReport(() => ReportService.GetDeptPeriodAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadReport(Func<Task<List<Dictionary<string, object>>>> loader)
    {
        _loading = true;
        try
        {
            _results = await loader();
            _page = 1;
        }
        catch (Exception ex)
        {
            _results = new();
            await JS.InvokeVoidAsync("console.error", $"Error loading loss report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string GetValue(Dictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var value) && value != null)
        {
            return value.ToString() ?? "-";
        }

        return "-";
    }

    private async Task SearchVehiclesAsync()
    {
        var query = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _filter.VehicleNumber = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = FilterVehicleMatches(matches, query, _searchMode);
            if (_vehicleMatches.All(x => x.vmf_code != _selectedVehicleVmfCode))
            {
                _selectedVehicleVmfCode = null;
                _filter.VehicleNumber = null;
            }
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _filter.VehicleNumber = null;
            await JS.InvokeVoidAsync("console.error", $"Error searching vehicles: {ex.Message}");
        }
    }

    private void ApplyVehicleSelection()
    {
        var selected = _vehicleMatches.FirstOrDefault(x => x.vmf_code == _selectedVehicleVmfCode);
        _filter.VehicleNumber = selected?.fleet_number ?? selected?.registration_number;
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVehicleVmfCode = null;
        _filter.VehicleNumber = null;
    }

    private sealed class LossReportFilter
    {
        public string? VehicleNumber { get; set; }
        public DateTime? BeginDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? Department { get; set; }
        public int? LossTypeCode { get; set; }
        public string? ReportStatus { get; set; }
        public string? HireType { get; set; }

        public object ToPayload() => new
        {
            vehicle_number = VehicleNumber,
            begin_date = BeginDate,
            end_date = EndDate,
            department = Department,
            loss_type_code = LossTypeCode,
            report_status = ReportStatus,
            hire_type = HireType
        };
    }
}
