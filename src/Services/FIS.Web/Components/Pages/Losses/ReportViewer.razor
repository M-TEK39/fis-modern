@page "/losses/reports/{Mode}"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Legacy report parameters and output for losses.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses/reports")'>
            <i class="bx bx-arrow-back"></i>
            Back to Reports Menu
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Loss Report";

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "vehicle" => "Losses for One Vehicle",
            "all" => "All Losses Report",
            "no-report" => "Losses Without Department Report",
            "with-report" => "Losses With Department Report",
            "dept-period" => "Losses Report by Department Period",
            _ => "Loss Report"
        };
    }

    private static readonly string[] _vehicleColumns =
    {
        "Loss Date",
        "Garage",
        "Loss Reference",
        "Case Number",
        "Site",
        "SAPD",
        "Loss Type",
        "Loss Amount",
        "Remarks"
    };

    private static readonly string[] _allLossColumns =
    {
        "Reference",
        "Loss Date",
        "GG Number",
        "Hire Type",
        "Loss Type",
        "Department",
        "Status"
    };

    private static readonly string[] _deptPeriodColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Loss Date",
        "Dept Code",
        "Site",
        "Hire Type",
        "Loss Type",
        "Department Contact",
        "Loss Amount"
    };
}

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Losses per Vehicle</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Fleet or Registration</label>
                            <input type="text" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input type="date" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Generate</button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _vehicleColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>2025-01-12</td>
                                        <td>Garage North</td>
                                        <td>LR-12345</td>
                                        <td>CN-456</td>
                                        <td>Site A</td>
                                        <td>Central SAPD</td>
                                        <td>Theft</td>
                                        <td>25,000</td>
                                        <td>Key stolen</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "all")
            {
                <div class="form-section">
                    <h2 class="form-section-title">All Losses</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Loss Type</label>
                            <select class="form-select">
                                <option>Choose Type</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _allLossColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>LR-12345</td>
                                        <td>2025-01-12</td>
                                        <td>GG10001</td>
                                        <td>Pool</td>
                                        <td>Theft</td>
                                        <td>Finance</td>
                                        <td>Open</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "no-report")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Outstanding Department Reports</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Loss Date</label>
                            <input type="date" class="form-input" />
                        </div>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Loss Reference</th>
                                        <th>Department</th>
                                        <th>Loss Date</th>
                                        <th>Called Refer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>LR-67890</td>
                                        <td>Operations</td>
                                        <td>2025-01-09</td>
                                        <td>CALL-201</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "with-report")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Departments That Submitted Reports</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Report Status</label>
                            <select class="form-select">
                                <option>Submitted</option>
                                <option>Verified</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Reported Date</label>
                            <input type="date" class="form-input" />
                        </div>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Site</th>
                                        <th>Reported On</th>
                                        <th>Officer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>LR-12345</td>
                                        <td>Site B</td>
                                        <td>2025-01-10</td>
                                        <td>Officer Mokoena</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "dept-period")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Department Period Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department Code</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input type="date" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Hire Type</label>
                            <select class="form-select">
                                <option>VIP</option>
                                <option>GG</option>
                                <option>Permanent</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in _deptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>REG-222</td>
                                        <td>GG10002</td>
                                        <td>2025-01-02</td>
                                        <td>Finance</td>
                                        <td>VIP</td>
                                        <td>Theft</td>
                                        <td>H. Nkosi</td>
                                        <td>CALL-501</td>
                                        <td>25,000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">Select a report from the menu to see parameters and layout.</p>
            }
        </div>
    </div>
</div>
