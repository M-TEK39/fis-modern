@page "/losses/reports"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Losses Reports Menu</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Losses Reports Menu
        </h1>
        <p class="page-description">Loss reports grouped by category and period.</p>
    </div>
        <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses")'>
            <i class="bx bx-arrow-back"></i>
            Back to Losses
        </button>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick='() => Navigation.NavigateTo("/losses/reports/vehicle")'>
                <span>Losses for One Vehicle</span>
                <i class="bx bx-target-lock"></i>
            </button>
            <div class="menu-tile-body">
                <p class="menu-item-text">Show all loss entries for a single fleet/reg number sorted by loss date.</p>
            </div>
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick='() => Navigation.NavigateTo("/losses/reports/all")'>
                <span>All Losses</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <p class="menu-item-text">View all losses sorted by type, date, and department.</p>
            </div>
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick='() => Navigation.NavigateTo("/losses/reports/no-report")'>
                <span>Losses Without Department Reports</span>
                <i class="bx bx-hourglass"></i>
            </button>
            <div class="menu-tile-body">
                <p class="menu-item-text">List entries where departmental report documentation is still pending.</p>
            </div>
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick='() => Navigation.NavigateTo("/losses/reports/with-report")'>
                <span>Losses With Reports</span>
                <i class="bx bx-check-circle"></i>
            </button>
            <div class="menu-tile-body">
                <p class="menu-item-text">Reports that have departmental documentation already provided.</p>
            </div>
        </div>
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick='() => Navigation.NavigateTo("/losses/reports/dept-period")'>
                <span>Suffix Department Period</span>
                <i class="bx bx-calendar"></i>
            </button>
            <div class="menu-tile-body">
                <p class="menu-item-text">Filter losses for a department/site between two dates and by hire type (VIP/GG/Perm).</p>
            </div>
        </div>
    </div>
</div>
