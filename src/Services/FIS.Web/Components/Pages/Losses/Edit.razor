@page "/losses/edit"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using FIS.Web.Models
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LossApiService LossService
@inject LossTypeApiService LossTypeService

<PageTitle>Edit Loss - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit"></i>
            Edit Loss
        </h1>
        <p class="page-description">Locate an existing loss by reference or GG number and update its critical metadata.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/losses")'>
            <i class="bx bx-arrow-back"></i>
            Back to Losses Menu
        </button>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <h2 class="form-section-title">Lookup</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Loss Reference</label>
                    <InputText class="form-input" @bind-Value="_searchReference" />
                </div>
                <div class="form-field">
                    <label class="form-label">GG/Registration</label>
                    <InputText class="form-input" @bind-Value="_searchVehicle" />
                </div>
                <div class="form-field">
                    <label class="form-label">Loss Match</label>
                    <select class="form-select" @bind="_selectedLossCode" disabled="@(_vehicleLossMatches.Count == 0)">
                        <option value="">Select loss...</option>
                        @foreach (var item in _vehicleLossMatches)
                        {
                            <option value="@item.loss_code">@GetLossOptionLabel(item)</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">&nbsp;</label>
                    <button class="btn btn-primary btn-sm" @onclick="LoadLoss" disabled="@_loading">
                        <i class="bx bx-search"></i>
                        @(_loading ? "Loading..." : "Find")
                    </button>
                </div>
                <div class="form-field">
                    <label class="form-label">&nbsp;</label>
                    <button class="btn btn-secondary btn-sm" @onclick="LoadSelectedLoss" disabled="@(!_selectedLossCode.HasValue || _loading)">
                        Load Selected
                    </button>
                </div>
            </div>
            @if (_loaded)
            {
                <div class="form-section">
                    <h2 class="form-section-title">Loss Details</h2>
                    <EditForm Model="_form" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="form-grid">
                            <div class="form-field">
                                <label class="form-label">Loss Reference</label>
                                <InputText class="form-input" @bind-Value="_form.LossReference" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Loss Status</label>
                            <select class="form-select" @bind="_form.LossStatus">
                                @foreach (var status in _lossStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            </div>
                            <div class="form-field">
                                <label class="form-label">Loss Type</label>
                            <select class="form-select" @bind="_form.LossTypeCode">
                                @foreach (var type in _lossTypes)
                                {
                                    <option value="@type.loss_code">@($"{type.loss_description} ({type.loss_code})")</option>
                                }
                            </select>
                            </div>
                            <div class="form-field">
                                <label class="form-label">Dept Contact</label>
                                <InputText class="form-input" @bind-Value="_form.DeptContact" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Call Reference</label>
                                <InputText class="form-input" @bind-Value="_form.CallReference" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Remarks</label>
                                <InputTextArea class="form-input" rows="3" @bind-Value="_form.Remarks" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" type="submit" disabled="@_saving">
                                <i class="bx bx-save"></i>
                                @(_saving ? "Saving..." : "Update")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _searchReference = string.Empty;
    private string _searchVehicle = string.Empty;
    private bool _loaded;
    private bool _loading;
    private bool _saving;
    private int? _selectedLossCode;
    private List<LossDto> _vehicleLossMatches = new();
    private readonly LossFormModel _form = new();
    private List<LossTypeDto> _lossTypes = new();

    private static readonly string[] _lossStatuses =
    {
        "Open",
        "Reported to SAPD",
        "Closed"
    };

    protected override async Task OnInitializedAsync()
    {
        _lossTypes = await LossTypeService.GetAllAsync();
    }

    private async Task HandleSubmit()
    {
        if (!_loaded || _form.LossCode == null)
        {
            return;
        }

        _saving = true;
        try
        {
            await LossService.UpdateAsync(_form.LossCode.Value, _form.ToDto());
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error updating loss: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LoadLoss()
    {
        _loading = true;
        try
        {
            _loaded = false;
            _vehicleLossMatches = new();
            _selectedLossCode = null;
            LossDto? loss = null;
            if (int.TryParse(_searchReference, out var referenceId))
            {
                loss = await LossService.GetByIdAsync<LossDto>(referenceId);
            }

            if (loss == null && !string.IsNullOrWhiteSpace(_searchVehicle))
            {
                var matches = await LossService.GetByVehicleAsync<LossDto>(_searchVehicle.Trim());
                _vehicleLossMatches = matches
                    .OrderByDescending(x => x.loss_code)
                    .ToList();
            }

            if (loss == null)
            {
                return;
            }

            _form.LoadFrom(loss);
            _loaded = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading loss: {ex.Message}");
            _loaded = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSelectedLoss()
    {
        if (!_selectedLossCode.HasValue)
        {
            return;
        }

        var selected = _vehicleLossMatches.FirstOrDefault(x => x.loss_code == _selectedLossCode.Value)
            ?? await LossService.GetByIdAsync<LossDto>(_selectedLossCode.Value);
        if (selected == null)
        {
            _loaded = false;
            return;
        }

        _form.LoadFrom(selected);
        _loaded = true;
    }

    private static string GetLossOptionLabel(LossDto loss)
    {
        var reference = string.IsNullOrWhiteSpace(loss.loss_reference) ? "-" : loss.loss_reference.Trim();
        var status = string.IsNullOrWhiteSpace(loss.loss_status) ? "-" : loss.loss_status.Trim();
        return $"#{loss.loss_code} | {reference} | {status}";
    }

    private sealed class LossFormModel
    {
        public int? LossCode { get; set; }
        public string LossReference { get; set; } = string.Empty;
        public string LossStatus { get; set; } = "Open";
        public int? LossTypeCode { get; set; }
        public string DeptContact { get; set; } = string.Empty;
        public string CallReference { get; set; } = string.Empty;
        public string Remarks { get; set; } = string.Empty;

        public void LoadFrom(LossDto loss)
        {
            LossCode = loss.loss_code;
            LossReference = loss.loss_reference ?? string.Empty;
            LossStatus = loss.loss_status ?? "Open";
            LossTypeCode = loss.loss_type_code;
            DeptContact = loss.dept_contact ?? string.Empty;
            CallReference = loss.call_reference ?? string.Empty;
            Remarks = loss.remarks ?? string.Empty;
        }

        public LossDto ToDto() =>
            new()
            {
                loss_code = LossCode ?? 0,
                loss_reference = LossReference,
                loss_status = LossStatus,
                loss_type_code = LossTypeCode,
                dept_contact = DeptContact,
                call_reference = CallReference,
                remarks = Remarks
            };
    }
}
