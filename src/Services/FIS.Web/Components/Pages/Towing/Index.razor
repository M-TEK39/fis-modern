@page "/towing"
@page "/Towing/MNTTowing.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TowingApiService TowingService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Road Side Assistance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-anchor"></i>
            Road Side Assistance Menu
        </h1>
        <p class="page-description">Towing and road side assistance menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasTowingRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Towing</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Road Side Assistance Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/request">1) Capture a New Request</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/request">2) Edit / Update / Delete a Existing Request</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/reports">3) Road Side Request Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Tow Truck Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/tow-truck-data">4) Capture / Edit / Update Road Assistance Data</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/tow-truck-data/report">5) Show All Road Assistance Data</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Road Side Assistance Preview"
                      SearchPlaceholder="Search call reference, GG code, location, problem..."
                      EmptyMessage="No towing requests match the current search or filter."
                      EmptyIcon="bx bx-anchor"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
    }
</div>

@code {
    private bool _hasTowingRole;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("callReference", "Call Ref."),
        new("vmfCode", "GG Code"),
        new("requestDate", "Request Date"),
        new("location", "Start Location"),
        new("problem", "Problem"),
        new("keys", "Keys")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Requests with keys", "keyStatus", "Keys Available"),
        new("Requests without keys", "keyStatus", "No Keys"),
        new("Site-linked requests", "siteStatus", "Site Linked")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasTowingRole = HasRole(authState.User, "Towing");
        if (!_hasTowingRole)
        {
            _loading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var requests = await TowingService.GetAllAsync<TowingDto>();
            _rows = requests
                .OrderByDescending(item => item.Tow_request_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["callReference"] = item.Call_refer?.ToString("0.##"),
                    ["vmfCode"] = item.vmf_code.ToString(),
                    ["requestDate"] = FormatDate(item.Tow_request_date),
                    ["location"] = item.Tow_location_start,
                    ["problem"] = item.Vehicle_problem,
                    ["keys"] = item.Keys,
                    ["keyStatus"] = string.IsNullOrWhiteSpace(item.Keys) ? "No Keys" : "Keys Available",
                    ["siteStatus"] = item.Site_code.HasValue ? "Site Linked" : "No Site",
                    ["_href"] = $"/towing/request?towingCode={item.Towing_code}&vmfCode={item.vmf_code}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading towing preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
