@page "/towing/request"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TowingApiService TowingService
@inject VehicleLookupApiService VehicleLookupService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Road Side Assistance Request - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Road Side Assistance Request
        </h1>
        <p class="page-description">Roadside assistance request workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Lookup Type</label>
            <div class="form-grid">
                <label class="form-label">
                    <input type="radio" name="lookupType" checked="@(_lookupType == "GG")" @onchange='() => SetLookupType("GG")' />
                    GG
                </label>
                <label class="form-label">
                    <input type="radio" name="lookupType" checked="@(_lookupType == "GP")" @onchange='() => SetLookupType("GP")' />
                    Reg Number
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_lookupType == "GP" ? "Reg Number" : "GG Number")</label>
            <input class="form-input" @bind="_searchTerm" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadVehicle">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }

    @if (_showForm)
    {
        <div class="form-card">
            <div class="form-row">
                <label class="form-label">Call Reference</label>
                <input type="number" class="form-input" @bind="_form.Call_refer" />
            </div>
            <div class="form-row">
                <label class="form-label">Request Date</label>
                <input type="date" class="form-input" @bind="_form.Tow_request_date" />
            </div>
            <div class="form-row">
                <label class="form-label">Request Time</label>
                <input type="time" class="form-input" @bind="_requestTime" />
            </div>
            <div class="form-row">
                <label class="form-label">Tow Location</label>
                <input class="form-input" @bind="_form.Tow_location_start" />
            </div>
            <div class="form-row">
                <label class="form-label">Vehicle Problem</label>
                <input class="form-input" @bind="_form.Vehicle_problem" />
            </div>
            <div class="form-row">
                <label class="form-label">Keys</label>
                <input class="form-input" @bind="_form.Keys" />
            </div>
            <div class="form-row">
                <label class="form-label">Site</label>
                <select class="form-select" @bind="_form.Site_code">
                    <option value="">Select site</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveRequest">Submit</button>
                <button class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showForm;
    private string _searchTerm = string.Empty;
    private string _lookupType = "GG";
    private TimeOnly? _requestTime;
    private TowingDto _form = new();
    private TowingDto? _editing;
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<SiteResponseDto> _sites = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task LoadVehicle()
    {
        _loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                _vehicleMatches = new();
                _selectedVmfCode = null;
                _showForm = false;
                return;
            }

            var searchTerm = _searchTerm.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _lookupType);
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            if (!_selectedVmfCode.HasValue)
            {
                _showForm = false;
                return;
            }

            _form = new TowingDto
            {
                vmf_code = _selectedVmfCode.Value,
                Tow_request_date = DateTime.Today
            };
            _showForm = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveRequest()
    {
        _loading = true;
        try
        {
            if (_requestTime.HasValue)
            {
                _form.Tow_request_time = DateTime.Today.Add(_requestTime.Value.ToTimeSpan());
            }

            if (_editing == null)
            {
                await TowingService.CreateAsync(_form);
            }
            else
            {
                await TowingService.UpdateAsync(_form.Towing_code, _form);
            }

            ResetForm();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetForm()
    {
        _form = new TowingDto();
        _editing = null;
        _showForm = false;
        _requestTime = null;
        _searchTerm = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string lookupType)
    {
        var query = keyword.Trim();
        var isGpLookup = string.Equals(lookupType, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGpLookup
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGpLookup
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetLookupType(string lookupType)
    {
        _lookupType = lookupType;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _showForm = false;
    }
}
