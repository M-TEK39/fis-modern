@page "/towing/tow-truck-data/report"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TowingApiService TowingService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>All Assistance Firm General Data - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            All Assistance Firm General Data
        </h1>
        <p class="page-description">View all captured assistance firm general data.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadReport">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-list-ul"></i>
            <h3>No assistance data</h3>
            <p>Load report to view data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Vehicle</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedResults)
                        {
                            <tr>
                                <td>@item.Call_refer</td>
                                <td>@GetVehicleLabel(item.vmf_code)</td>
                                <td>@item.Tow_location_start</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="pagination-controls fis-mt-1">
            <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    }
</div>

@code {
    private bool _loading;
    private List<TowingDto> _results = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<TowingDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicleLookupAsync();
    }

    private async Task LoadReport()
    {
        _loading = true;
        _results = new List<TowingDto>();
        try
        {
            var report = await TowingService.GetAllTowtrucksReportAsync();
            _results = report.Data;
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private async Task LoadVehicleLookupAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabelByVmf = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(
                g => g.Key,
                g => FormatVehicleLabel(g.First()));
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
}
