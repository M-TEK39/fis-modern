@page "/towing/reports"
@rendermode InteractiveServer

<PageTitle>Road Side Assistance Report Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Road Side Assistance Report Menu
        </h1>
        <p class="page-description">Legacy reports menu for road side assistance.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Road Side Assistance Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/reports/request">1) Road Side Assistance Request Report</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Road Side Assistance DATA Section</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/tow-truck-data/report">1) All Assistance Firm General Data</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/towing/reports/firm-date">2) Road Side Call's for a Firm</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>
    </div>
</div>
