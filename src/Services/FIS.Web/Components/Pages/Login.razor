@page "/login-old"
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Legacy Auth Shortcut - FIS</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <h1>Legacy JWT Access</h1>
        <p>Use the legacy login form to request a JWT token.</p>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="auth-error">
                <i class="bx bx-check-circle"></i>
                <span>You're already signed in as <strong>@context.User.Identity?.Name</strong></span>
            </div>
            <a href="/home" class="btn btn-primary auth-btn">Go to Dashboard</a>
        </Authorized>
        <NotAuthorized>
            <div class="auth-actions">
                <a href="/login/legacy" class="btn btn-primary auth-btn">
                    Continue to Legacy Login
                </a>
                <a href="/login" class="btn btn-secondary auth-btn auth-outline">
                    Back to Sign In Options
                </a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
