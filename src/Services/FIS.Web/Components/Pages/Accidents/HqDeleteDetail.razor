@page "/accidents/hq/delete/detail"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AccidentApiService AccidentService
@inject SiteApiService SiteService

<PageTitle>Delete Accident Detail (HQ) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete Accident - Details (HQ)
        </h1>
        <p class="page-description">Review the accident details before deletion.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents/hq/delete">Back to Search</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Delete an Accident</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Accident Date</label>
                    <input class="form-input" maxlength="10" @bind="_accident.accident_date" />
                </div>
                <div class="form-field">
                    <label class="form-label">Accident Time</label>
                    <input class="form-input" maxlength="12" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Description</label>
                    <input class="form-input" maxlength="60" @bind="_accident.accident_description" />
                </div>
                <div class="form-field">
                    <label class="form-label">Driver Name</label>
                    <input class="form-input" maxlength="25" @bind="_accident.driver_name" />
                </div>
                <div class="form-field">
                    <label class="form-label">Emp Number</label>
                    <input class="form-input" maxlength="10" />
                </div>
                <div class="form-field">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_accident.vehicle_id">
                        <option value="">Select site...</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Tel Number</label>
                    <input class="form-input" maxlength="18" />
                </div>
                <div class="form-field">
                    <label class="form-label">HQ Ref</label>
                    <input class="form-input" maxlength="20" @bind="_accident.accident_reference" />
                </div>
                <div class="form-field">
                    <label class="form-label">GG Ref</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">SA Ref</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Report Date</label>
                    <input class="form-input" maxlength="10" @bind="_accident.date_reported" />
                </div>
                <div class="form-field">
                    <label class="form-label">Case Number</label>
                    <input class="form-input" maxlength="15" @bind="_accident.police_case_number" />
                </div>
                <div class="form-field">
                    <label class="form-label">Auth Report</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Auth Tel</label>
                    <input class="form-input" maxlength="17" />
                </div>
                <div class="form-field">
                    <label class="form-label">Liability</label>
                    <input class="form-input" maxlength="20" @bind="_accident.insurance_claim_number" />
                </div>
                <div class="form-field">
                    <label class="form-label">Claim</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Third Party Name</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Third Party Address 1</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Third Party Address 2</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Third Party Address 3</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Third Party Tel</label>
                    <input class="form-input" maxlength="20" />
                </div>
                <div class="form-field">
                    <label class="form-label">Cost Repair</label>
                    <input class="form-input" maxlength="10" @bind="_accident.cost_of_repair" />
                </div>
                <div class="form-field">
                    <label class="form-label">Date Updated</label>
                    <input class="form-input" maxlength="10" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Notes</label>
                    <input class="form-input" maxlength="60" @bind="_accident.notes" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-danger" @onclick="DeleteAccident">DELETE</button>
                <a class="btn btn-secondary" href="/accidents/hq/delete">Back</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "accidentId")]
    public int? AccidentId { get; set; }

    private AccidentDto _accident = new();
    private List<SiteResponseDto> _sites = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        if (AccidentId.HasValue)
        {
            var existing = await AccidentService.GetAccidentAsync(AccidentId.Value);
            if (existing is not null)
            {
                _accident = existing;
            }
        }
    }

    private async Task DeleteAccident()
    {
        if (AccidentId.HasValue)
        {
            await AccidentService.DeleteAccidentAsync(AccidentId.Value);
        }
    }
}
