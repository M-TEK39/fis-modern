@using FIS.Web.Models

<div class="reports-tab">
    <div class="reports-header">
        <h3>Accident Reports</h3>
        <div class="reports-actions">
            <button class="btn btn-secondary btn-sm" @onclick="OnRefreshReports" title="Refresh Reports">
                <i class="bx bx-refresh"></i>
                Refresh
            </button>
        </div>
    </div>

    <div class="reports-grid">
        <!-- Accident Summary Report -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-file-blank"></i>
            </div>
            <div class="report-content">
                <h4>Accident Summary Report</h4>
                <p>Comprehensive overview of all accidents with key statistics and trends</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-calendar"></i>
                        Date range: Configurable
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.AccidentSummary)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.AccidentSummary)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.AccidentSummary)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>

        <!-- Vehicle Incident History -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-car"></i>
            </div>
            <div class="report-content">
                <h4>Vehicle Incident History</h4>
                <p>Detailed accident history for specific vehicles or vehicle types</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-filter"></i>
                        Filter: By vehicle, make, model
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.VehicleHistory)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.VehicleHistory)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.VehicleHistory)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>

        <!-- Cost Analysis Report -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-money"></i>
            </div>
            <div class="report-content">
                <h4>Cost Analysis Report</h4>
                <p>Financial impact analysis including repair costs and third-party claims</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-trending-up"></i>
                        Analysis: Trends, forecasts
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.CostAnalysis)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.CostAnalysis)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.CostAnalysis)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>

        <!-- Driver Performance Report -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-user"></i>
            </div>
            <div class="report-content">
                <h4>Driver Performance Report</h4>
                <p>Accident frequency and severity analysis by driver</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-group"></i>
                        Scope: Individual/Department
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.DriverPerformance)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.DriverPerformance)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.DriverPerformance)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>

        <!-- Insurance Claims Report -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-shield"></i>
            </div>
            <div class="report-content">
                <h4>Insurance Claims Report</h4>
                <p>Insurance claim status and processing analysis</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-time"></i>
                        Status: Pending, approved, settled
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.InsuranceClaims)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.InsuranceClaims)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.InsuranceClaims)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>

        <!-- Location Risk Assessment -->
        <div class="report-card">
            <div class="report-icon">
                <i class="bx bx-map"></i>
            </div>
            <div class="report-content">
                <h4>Location Risk Assessment</h4>
                <p>Accident hotspots and location-based risk analysis</p>
                <div class="report-meta">
                    <span class="meta-item">
                        <i class="bx bx-target"></i>
                        Analysis: Hotspots, risk levels
                    </span>
                    <span class="meta-item">
                        <i class="bx bx-file"></i>
                        Format: PDF, Excel
                    </span>
                </div>
            </div>
            <div class="report-actions">
                <button class="btn-report btn-report-primary" @onclick="() => HandleGenerateReport(ReportType.LocationRisk)" disabled="@GeneratingReport">
                    @if (GeneratingReport && CurrentReportType == ReportType.LocationRisk)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-download"></i>
                    }
                    Generate
                </button>
                <button class="btn-report btn-report-secondary" @onclick="() => OnConfigureReport.InvokeAsync(ReportType.LocationRisk)">
                    <i class="bx bx-cog"></i>
                </button>
            </div>
        </div>
    </div>

    @if (RecentReports.Any())
    {
        <div class="recent-reports-section">
            <h4>Recent Reports</h4>
            <div class="recent-reports-list">
                @foreach (var report in RecentReports.Take(5))
                {
                    <div class="recent-report-item">
                        <div class="report-info">
                            <span class="report-name">@report.Name</span>
                            <span class="report-details">Generated on @report.GeneratedDate.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="report-size">@report.FileSize</div>
                        <div class="report-actions-recent">
                            <button class="btn-icon-sm" @onclick="() => OnDownloadReport.InvokeAsync(report)" title="Download">
                                <i class="bx bx-download"></i>
                            </button>
                            <button class="btn-icon-sm" @onclick="() => OnDeleteReport.InvokeAsync(report)" title="Delete">
                                <i class="bx bx-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<ReportDto> RecentReports { get; set; } = new();
    [Parameter] public bool GeneratingReport { get; set; }
    [Parameter] public EventCallback OnRefreshReports { get; set; }
    [Parameter] public EventCallback<ReportType> OnGenerateReport { get; set; }
    [Parameter] public EventCallback<ReportType> OnConfigureReport { get; set; }
    [Parameter] public EventCallback<ReportDto> OnDownloadReport { get; set; }
    [Parameter] public EventCallback<ReportDto> OnDeleteReport { get; set; }

    private ReportType? CurrentReportType { get; set; }

    public enum ReportType
    {
        AccidentSummary,
        VehicleHistory,
        CostAnalysis,
        DriverPerformance,
        InsuranceClaims,
        LocationRisk
    }

    private async Task HandleGenerateReport(ReportType reportType)
    {
        CurrentReportType = reportType;
        await OnGenerateReport.InvokeAsync(reportType);
        CurrentReportType = null;
    }
}