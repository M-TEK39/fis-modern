@using FIS.Web.Models

<div class="claims-tab">
    <div class="claims-header">
        <h3>Claims and Costs Summary</h3>
        <div class="filter-controls">
            <select class="form-select" @bind="SelectedPeriod" @oninput="OnPeriodChange">
                <option value="current-month">Current Month</option>
                <option value="last-month">Last Month</option>
                <option value="current-quarter">Current Quarter</option>
                <option value="current-year">Current Year</option>
                <option value="custom">Custom Range</option>
            </select>
            <button class="btn btn-secondary btn-sm" @onclick="OnRefresh" title="Refresh">
                <i class="bx bx-refresh"></i>
                Refresh
            </button>
        </div>
    </div>

    @if (Loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading claims data...</p>
        </div>
    }
    else
    {
        <div class="summary-grid">
            <div class="summary-card total-claims">
                <div class="card-icon">
                    <i class="bx bx-file-blank"></i>
                </div>
                <div class="card-content">
                    <h4>Total Claims</h4>
                    <p class="card-value">@ClaimsSummary.TotalClaims</p>
                    <span class="card-subtitle">All reported incidents</span>
                </div>
            </div>

            <div class="summary-card repair-costs">
                <div class="card-icon">
                    <i class="bx bx-wrench"></i>
                </div>
                <div class="card-content">
                    <h4>Repair Costs</h4>
                    <p class="card-value">R @ClaimsSummary.TotalRepairCosts.ToString("N2")</p>
                    <span class="card-subtitle">Fleet vehicle repairs</span>
                </div>
            </div>

            <div class="summary-card third-party">
                <div class="card-icon">
                    <i class="bx bx-group"></i>
                </div>
                <div class="card-content">
                    <h4>Third Party Claims</h4>
                    <p class="card-value">R @ClaimsSummary.TotalThirdPartyClaims.ToString("N2")</p>
                    <span class="card-subtitle">External damage claims</span>
                </div>
            </div>

            <div class="summary-card pending">
                <div class="card-icon">
                    <i class="bx bx-time"></i>
                </div>
                <div class="card-content">
                    <h4>Pending Claims</h4>
                    <p class="card-value">@ClaimsSummary.PendingClaims</p>
                    <span class="card-subtitle">Awaiting resolution</span>
                </div>
            </div>
        </div>

        <div class="claims-breakdown">
            <div class="breakdown-section">
                <h4>Cost Breakdown by Category</h4>
                <div class="breakdown-chart">
                    @foreach (var category in ClaimsSummary.CostByCategory)
                    {
                        <div class="breakdown-item">
                            <div class="breakdown-bar">
                                <div class="breakdown-fill" style="width: @(GetPercentage(category.Value, ClaimsSummary.TotalRepairCosts + ClaimsSummary.TotalThirdPartyClaims))%"></div>
                            </div>
                            <div class="breakdown-details">
                                <span class="breakdown-label">@category.Key</span>
                                <span class="breakdown-value">R @category.Value.ToString("N2")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="breakdown-section">
                <h4>Monthly Trend</h4>
                <div class="trend-chart">
                    @foreach (var month in ClaimsSummary.MonthlyTrend.TakeLast(6))
                    {
                        <div class="trend-item">
                            <div class="trend-bar">
                                <div class="trend-fill" style="height: @(GetTrendHeight(month.Value))%"></div>
                            </div>
                            <span class="trend-label">@month.Key</span>
                            <span class="trend-value">R @month.Value.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="recent-claims">
            <h4>Recent High-Value Claims</h4>
            @if (RecentHighValueClaims.Any())
            {
                <div class="claims-list">
                    @foreach (var claim in RecentHighValueClaims.Take(5))
                    {
                        <div class="claim-item">
                            <div class="claim-info">
                                <div class="claim-header">
                                    <span class="claim-ref">@claim.accident_reference</span>
                                    <span class="claim-date">@claim.accident_date.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="claim-details">
                                    <span class="claim-vehicle">@claim.vehicle_registration</span>
                                    <span class="claim-location">@claim.accident_location</span>
                                </div>
                            </div>
                            <div class="claim-costs">
                                <div class="cost-item">
                                    <span class="cost-label">Repair</span>
                                    <span class="cost-value">R @(claim.cost_of_repair?.ToString("N2") ?? "0.00")</span>
                                </div>
                                <div class="cost-item">
                                    <span class="cost-label">Third Party</span>
                                    <span class="cost-value">R @(claim.third_party_claim?.ToString("N2") ?? "0.00")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-claims">
                    <p>No high-value claims in selected period</p>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public ClaimsSummaryDto ClaimsSummary { get; set; } = new();
    [Parameter] public List<AccidentDto> RecentHighValueClaims { get; set; } = new();
    [Parameter] public EventCallback OnRefresh { get; set; }

    private string SelectedPeriod = "current-month";

    private async Task OnPeriodChange(ChangeEventArgs e)
    {
        SelectedPeriod = e.Value?.ToString() ?? "current-month";
        await OnRefresh.InvokeAsync();
    }

    private double GetPercentage(decimal value, decimal total)
    {
        return total > 0 ? (double)(value / total * 100) : 0;
    }

    private double GetTrendHeight(decimal value)
    {
        if (ClaimsSummary.MonthlyTrend.Count == 0) return 0;
        var max = ClaimsSummary.MonthlyTrend.Values.Max();
        return max > 0 ? (double)(value / max * 100) : 0;
    }
}