@page "/accidents/garage/add"
@rendermode InteractiveServer

<PageTitle>Add Accident (Garage) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Accident Maintenance (Garage) - Add
        </h1>
        <p class="page-description">Capture a new accident for a garage vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents/garage">Back to Search</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Accident Maintenance</h2>
            <p>All required fields should match the legacy capture form.</p>
        </div>
        <div class="form-card-body">
            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-calendar"></i>
                    Dates & Time
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Date Reported</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Date</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Time</label>
                        <input class="form-input" maxlength="5" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Car KM</label>
                        <input class="form-input" value="0" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-note"></i>
                    Accident Details
                </h3>
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Accident Description</label>
                        <input class="form-input" maxlength="60" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Category</label>
                        <select class="form-select">
                            <option value="">Select...</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Notify HQ</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                            <option value="X">X</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Notify HQ Date</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">File Close Date</label>
                        <input class="form-input" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-user"></i>
                    Driver & Site
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Driver Name</label>
                        <input class="form-input" maxlength="25" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver ID Number</label>
                        <input class="form-input" maxlength="13" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site</label>
                        <select class="form-select">
                            <option value="">Select site...</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Transport Officer</label>
                        <input class="form-input" maxlength="30" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Trans Officer Tel</label>
                        <input class="form-input" maxlength="20" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-id-card"></i>
                    References
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Reference (Do not edit)</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Case Number</label>
                        <input class="form-input" maxlength="15" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Authority</label>
                        <input class="form-input" maxlength="60" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-car"></i>
                    Damage & Claims
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Car Damage</label>
                        <input class="form-input" value="0" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Damage Desc</label>
                        <input class="form-input" maxlength="60" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Death</label>
                        <select class="form-select">
                            <option value="?">?</option>
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Injured</label>
                        <select class="form-select">
                            <option value="?">?</option>
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Party Regno</label>
                        <input class="form-input" maxlength="8" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Party Name</label>
                        <input class="form-input" maxlength="30" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Car Damage</label>
                        <input class="form-input" value="0" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">2nd Third Party Reg No</label>
                        <input class="form-input" maxlength="8" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Claim Received</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Claim Amount</label>
                        <input class="form-input" value="0" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-file"></i>
                    Documents & Authority
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Letterhead</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Z181</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">PART III</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Statement</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Sketch</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Trip/Garage Authority</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID Doc</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Drive Lic</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Case Number</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Receive docs for Relieve</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-note"></i>
                    Notes
                </h3>
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Notes</label>
                        <input class="form-input" maxlength="80" />
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary">Submit</button>
                <a class="btn btn-secondary" href="/accidents/garage">Back</a>
            </div>
        </div>
    </div>
</div>
