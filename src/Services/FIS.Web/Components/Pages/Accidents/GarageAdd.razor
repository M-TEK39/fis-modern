@page "/accidents/garage/add"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject SiteApiService SiteService
@inject DriverApiService DriverService
@inject AccidentApiService AccidentService
@inject NavigationManager Navigation

<PageTitle>Add Accident (Garage) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Accident Maintenance (Garage) - Add
        </h1>
        <p class="page-description">Capture a new accident for a garage vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents/garage">Back to Search</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Accident Maintenance</h2>
            <p>All required fields should match the capture form.</p>
        </div>
        <div class="form-card-body">
            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-calendar"></i>
                    Dates & Time
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Date Reported</label>
                    <input class="form-input" value="@_accidentDateText" @oninput="OnAccidentDateInput" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Date</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Time</label>
                        <input class="form-input" maxlength="5" value="@_accidentTimeText" @oninput="OnAccidentTimeInput" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Car KM</label>
                        <input class="form-input" value="0" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-note"></i>
                    Accident Details
                </h3>
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Accident Description</label>
                        <input class="form-input" maxlength="60" @bind="_accidentDescription" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Accident Category</label>
                        <select class="form-select" @bind="_severity">
                            <option value="">Select...</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Notify HQ</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                            <option value="X">X</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Notify HQ Date</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">File Close Date</label>
                        <input class="form-input" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-user"></i>
                    Driver & Site
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Driver</label>
                        <select class="form-select" @bind="_selectedDriverCode" @bind:after="OnDriverChangedAsync">
                            <option value="">Select driver...</option>
                            @foreach (var driver in _drivers)
                            {
                                <option value="@driver.site_driver_code">@DriverOptionLabel(driver)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Driver Name</label>
                        <input class="form-input" maxlength="25" @bind="_driverName" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver ID Number</label>
                        <input class="form-input" maxlength="13" @bind="_driverIdNumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site</label>
                        <select class="form-select" @bind="_selectedSiteCode">
                            <option value="">Select site...</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.SiteCode">@SiteOptionLabel(site)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Transport Officer</label>
                        <input class="form-input" maxlength="30" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Trans Officer Tel</label>
                        <input class="form-input" maxlength="20" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-id-card"></i>
                    References
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Reference (Do not edit)</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Case Number</label>
                        <input class="form-input" maxlength="15" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Authority</label>
                        <input class="form-input" maxlength="60" @bind="_accidentLocation" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-car"></i>
                    Damage & Claims
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Car Damage</label>
                        <input class="form-input" value="0" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">GG Damage Desc</label>
                        <input class="form-input" maxlength="60" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Death</label>
                        <select class="form-select">
                            <option value="?">?</option>
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Injured</label>
                        <select class="form-select">
                            <option value="?">?</option>
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Party Regno</label>
                        <input class="form-input" maxlength="8" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Party Name</label>
                        <input class="form-input" maxlength="30" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Private Car Damage</label>
                        <input class="form-input" value="0" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">2nd Third Party Reg No</label>
                        <input class="form-input" maxlength="8" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Claim Received</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Claim Amount</label>
                        <input class="form-input" value="0" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-file"></i>
                    Documents & Authority
                </h3>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Letterhead</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Z181</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">PART III</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Statement</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Sketch</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Trip/Garage Authority</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID Doc</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Drive Lic</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Case Number</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Receive docs for Relieve</label>
                        <select class="form-select">
                            <option value="N">N</option>
                            <option value="Y">Y</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">
                    <i class="bx bx-note"></i>
                    Notes
                </h3>
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Notes</label>
                        <input class="form-input" maxlength="80" />
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="button" @onclick="HandleSubmit" disabled="@_submitting">@( _submitting ? "Submitting..." : "Submit")</button>
                <a class="btn btn-secondary" href="/accidents/garage">Back</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(_submitMessage))
            {
                <div class="alert alert-info fis-mt-1">@_submitMessage</div>
            }
        </div>
    </div>
</div>

@code {
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();
    private int? _selectedDriverCode;
    private short? _selectedSiteCode;
    private string _driverName = string.Empty;
    private string _driverIdNumber = string.Empty;
    private string? _submitMessage;
    private string _accidentDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _accidentTimeText = string.Empty;
    private string _accidentDescription = string.Empty;
    private string _accidentLocation = string.Empty;
    private string _severity = "Low";
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();
    }

    private Task OnDriverChangedAsync()
    {
        if (!_selectedDriverCode.HasValue)
        {
            _driverName = string.Empty;
            _driverIdNumber = string.Empty;
            return Task.CompletedTask;
        }

        var selected = _drivers.FirstOrDefault(d => d.site_driver_code == _selectedDriverCode.Value);
        if (selected == null)
        {
            return Task.CompletedTask;
        }

        _driverName = $"{selected.driver_firstname} {selected.driver_surname}".Trim();
        _driverIdNumber = selected.driver_SA_id ?? string.Empty;
        _selectedSiteCode = (short?)selected.site_code;
        return Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        _submitMessage = null;
        if (!DateTime.TryParse(_accidentDateText, out var accidentDate))
        {
            _submitMessage = "Please provide a valid accident date.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_accidentDescription))
        {
            _submitMessage = "Accident description is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_accidentLocation))
        {
            _submitMessage = "Accident location is required.";
            return;
        }

        _submitting = true;
        try
        {
            var payload = new AccidentDto
            {
                accident_date = accidentDate,
                date_reported = DateTime.Now,
                accident_description = _accidentDescription.Trim(),
                accident_location = _accidentLocation.Trim(),
                severity = string.IsNullOrWhiteSpace(_severity) ? "Low" : _severity,
                driver_id = _selectedDriverCode,
                driver_name = _driverName,
                police_case_number = _driverIdNumber,
                notes = string.IsNullOrWhiteSpace(_accidentTimeText) ? null : $"Accident Time: {_accidentTimeText.Trim()}"
            };

            await AccidentService.CreateAccidentAsync(payload);
            Navigation.NavigateTo("/accidents/garage");
        }
        catch (Exception ex)
        {
            _submitMessage = $"Submit failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string SiteOptionLabel(SiteResponseDto site)
        => $"{site.Description} ({site.SiteCode})";

    private void OnAccidentDateInput(ChangeEventArgs e)
    {
        _accidentDateText = e.Value?.ToString() ?? string.Empty;
    }

    private void OnAccidentTimeInput(ChangeEventArgs e)
    {
        _accidentTimeText = e.Value?.ToString() ?? string.Empty;
    }

    private static string DriverOptionLabel(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code})";
    }
}
