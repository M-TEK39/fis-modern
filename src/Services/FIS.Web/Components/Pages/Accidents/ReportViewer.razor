@page "/accidents/reports/{Mode}"
@page "/Accident/RPT_one_num_main_accident.htm"
@page "/Accident/RPT_one_prnum_main_accident.htm"
@page "/Accident/RPT_one_prnumc_main_accident.htm"
@page "/Accident/RPT_all_main_Accident.htm"
@page "/Accident/RPT_allgar_main_Accident.htm"
@page "/Accident/RPT_flagnew_main_Accident.htm"
@page "/Accident/RPT_flagnew_report_Accident.aspx"
@page "/Accident/RPT_period_report1.aspx"
@page "/Accident/RPT_period_report2.aspx"
@page "/Accident/RPT_accident_driver_main.aspx"
@page "/Accident/RPT_F_dup_main_Accident.htm"
@page "/Accident/RPT_F_dup_report_Accident.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject AccidentApiService AccidentService
@inject SiteApiService SiteService
@inject VehicleLookupApiService VehicleLookupService
@inject DriverApiService DriverService
@inject IJSRuntime JSRuntime

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Accident report parameters and output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Back to Accident Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (CurrentMode == "one-vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Search Parameters</h2>
                    <div class="form-grid">
                        <div class="form-field form-group-full">
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="oneVehicleType" checked="@(_oneVehicleSearchMode == "gp")" @onchange='() => SetOneVehicleSearchMode("gp")' />
                                    GP
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="oneVehicleType" checked="@(_oneVehicleSearchMode == "gg")" @onchange='() => SetOneVehicleSearchMode("gg")' />
                                    GG
                                </label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">@(_oneVehicleSearchMode == "gg" ? "GG Number" : "GP Number")</label>
                            <div class="fis-input-group-compact">
                                <input class="form-input" @bind="_oneVehicleSearchTerm" placeholder="@(_oneVehicleSearchMode == "gg" ? "GG number" : "Registration number")" />
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="SearchOneVehicleAsync">Find</button>
                            </div>
                            <select class="form-select fis-mt-05" @bind="_oneVehicleSelectedVmfCode" disabled="@(_oneVehicleMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _oneVehicleMatches)
                                {
                                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in OneVehicleFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetSampleValue(field)</td>
                                        </tr>
                                    }
                                    @if (_recentReports.Count > 0)
                                    {
                                        <tr>
                                            <td colspan="2"><strong>Recent Reports</strong></td>
                                        </tr>
                                        @foreach (var report in PagedRecentReports)
                                        {
                                            <tr>
                                                <td>@report.Name</td>
                                                <td>@FormatDate(report.GeneratedDate)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "private-vehicle" || CurrentMode == "private-vehicle-capture-desc")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Search Parameters</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Private Vehicle Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in PrivateVehicleFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetSampleValue(field)</td>
                                        </tr>
                                    }
                                    @if (_recentReports.Count > 0)
                                    {
                                        <tr>
                                            <td colspan="2"><strong>Recent Reports</strong></td>
                                        </tr>
                                        @foreach (var report in PagedRecentReports)
                                        {
                                            <tr>
                                                <td>@report.Name</td>
                                                <td>@FormatDate(report.GeneratedDate)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "all-detail")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Accident Date Range</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allDetailPeriod" checked />
                                2002 - Current
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allDetailPeriod" />
                                1999 - 2001
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allDetailPeriod" />
                                Before 1999
                            </label>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in AllDetailColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0001</td>
                                        <td>GG12345</td>
                                        <td>JHB</td>
                                        <td>2024/01/15</td>
                                        <td>Johannesburg</td>
                                        <td>2023/24</td>
                                        <td>Rear-end collision</td>
                                        <td>Minor</td>
                                        <td>TA-447</td>
                                        <td>J. Dlamini</td>
                                        <td>8001015009087</td>
                                        <td>SITE-01</td>
                                        <td>M. Nkosi</td>
                                        <td>011-555-1234</td>
                                        <td>HQ-9021</td>
                                        <td>GG-4589</td>
                                        <td>SA-110</td>
                                        <td>CASE-334</td>
                                        <td>12500</td>
                                        <td>Front bumper</td>
                                        <td>TP-9912</td>
                                    </tr>
                                    @foreach (var report in PagedRecentReports)
                                    {
                                        <tr>
                                            <td>@report.ReportType</td>
                                            <td>@report.Name</td>
                                            <td></td>
                                            <td>@FormatDate(report.GeneratedDate)</td>
                                            <td>@report.Description</td>
                                            <td colspan="14"></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "all-garage-detail")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Garage</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allGarage" checked />
                                JHB
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allGarage" />
                                PTA
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="allGarage" />
                                ALL
                            </label>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in AllGarageColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0002</td>
                                        <td>GG45678</td>
                                        <td>PTA</td>
                                        <td>2024/02/10</td>
                                        <td>08:30</td>
                                        <td>Pretoria</td>
                                        <td>2023/24</td>
                                        <td>2024/02/12</td>
                                        <td>Yes</td>
                                        <td>2024/02/12</td>
                                        <td>Side impact</td>
                                        <td>Moderate</td>
                                        <td>TA-889</td>
                                        <td>S. Mokoena</td>
                                        <td>8205056009082</td>
                                        <td>SITE-02</td>
                                        <td>P. Williams</td>
                                        <td>012-555-0101</td>
                                        <td>HQ-9981</td>
                                        <td>GG-8890</td>
                                        <td>CASE-662</td>
                                        <td>22000</td>
                                        <td>Door panel</td>
                                        <td>No</td>
                                        <td>No</td>
                                        <td>0</td>
                                        <td>TP-4521</td>
                                        <td>Mr. Smith</td>
                                        <td>35000</td>
                                        <td>2024/03/15</td>
                                        <td>Under assessment</td>
                                    </tr>
                                    @foreach (var report in PagedRecentReports)
                                    {
                                        <tr>
                                            <td>@report.ReportType</td>
                                            <td>@report.Name</td>
                                            <td></td>
                                            <td>@FormatDate(report.GeneratedDate)</td>
                                            <td colspan="22"></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "new-accidents")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Report On</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="newAccidents" checked="@(_newAccidentReportMode == "call")" @onchange='() => _newAccidentReportMode = "call"' />
                                New Accident's Reported by Call Centre
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="newAccidents" checked="@(_newAccidentReportMode == "garage")" @onchange='() => _newAccidentReportMode = "garage"' />
                                New Accident's Reported to HQ, by Garage
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="newAccidents" checked="@(_newAccidentReportMode == "confirm")" @onchange='() => _newAccidentReportMode = "confirm"' />
                                Conformation of receipt by HQ
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="newAccidents" checked="@(_newAccidentReportMode == "all")" @onchange='() => _newAccidentReportMode = "all"' />
                                Both
                            </label>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in NewAccidentsColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_customReportRows.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@NewAccidentsColumns.Length">No report rows returned for the selected mode.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _customReportRows)
                                        {
                                            <tr>
                                                <td>@GetReportValue(row, "registration_number")</td>
                                                <td>@GetReportValue(row, "fleet_number")</td>
                                                <td>@GetReportValue(row, "garage")</td>
                                                <td>@GetReportValue(row, "occurence_date")</td>
                                                <td>@GetReportValue(row, "occurence_time")</td>
                                                <td>@GetReportValue(row, "occurence_place")</td>
                                                <td>@GetReportValue(row, "fin_year")</td>
                                                <td>@GetReportValue(row, "date_updated")</td>
                                                <td>@GetReportValue(row, "flag_gg_hq")</td>
                                                <td>@GetReportValue(row, "flag_gg_hq_date")</td>
                                                <td>@GetReportValue(row, "description")</td>
                                                <td>@GetReportValue(row, "trip_author")</td>
                                                <td>@GetReportValue(row, "driver_name")</td>
                                                <td>@GetReportValue(row, "driver_employ_number")</td>
                                                <td>@GetReportValue(row, "department_number")</td>
                                                <td>@GetReportValue(row, "transoffic_name")</td>
                                                <td>@GetReportValue(row, "transoffic_tel")</td>
                                                <td>@GetReportValue(row, "hq_reference")</td>
                                                <td>@GetReportValue(row, "gg_reference")</td>
                                                <td>@GetReportValue(row, "case_number")</td>
                                                <td>@GetReportValue(row, "cost_of_repair")</td>
                                                <td>@GetReportValue(row, "damage_description")</td>
                                                <td>@GetReportValue(row, "driver_fault")</td>
                                                <td>@GetReportValue(row, "death")</td>
                                                <td>@GetReportValue(row, "injured")</td>
                                                <td>@GetReportValue(row, "third_party_regno")</td>
                                                <td>@GetReportValue(row, "third_party_owner")</td>
                                                <td>@GetReportValue(row, "third_party_claim")</td>
                                                <td>@GetReportValue(row, "file_close_date")</td>
                                                <td>@GetReportValue(row, "notes")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "weekly-quarterly-yearly")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Accident Period Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Site list by</label>
                            <div class="form-grid">
                                <label class="form-label">
                                    <input type="radio" name="periodSiteListBy" />
                                    Name
                                </label>
                                <label class="form-label">
                                    <input type="radio" name="periodSiteListBy" checked />
                                    Code
                                </label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Site</label>
                            <select class="form-select" @bind="_weeklyPeriodSiteCode">
                                <option value="">Select site...</option>
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.SiteCode">@SiteOptionLabel(site)</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Accidents</label>
                            <div class="form-grid">
                                <label class="form-label">
                                    <input type="radio" name="accidentStatus" checked />
                                    Open
                                </label>
                                <label class="form-label">
                                    <input type="radio" name="accidentStatus" />
                                    Closed
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in PeriodReportColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0221</td>
                                        <td>GG45454</td>
                                        <td>2024/02/05</td>
                                        <td>SITE-06</td>
                                        <td>Regional Ops</td>
                                        <td>Pool</td>
                                        <td>Skid in rain</td>
                                        <td>L. Moyo</td>
                                        <td>T. Jacobs</td>
                                        <td>CALL-901</td>
                                        <td>6500</td>
                                        <td>2024/03/20</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (CurrentMode == "period-open-close")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report For A Period</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department/Site Code (optional)</label>
                            <input class="form-input" @bind="_periodDepartmentNumber" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Begin Date</label>
                            <input type="date" class="form-input" @bind="_periodBeginDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" @bind="_periodEndDate" />
                        </div>
                        <div class="form-field form-group-full">
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="periodStatus" checked="@(_periodStatus == "open")" @onchange='() => _periodStatus = "open"' />
                                    Open Accidents
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="periodStatus" checked="@(_periodStatus == "close")" @onchange='() => _periodStatus = "close"' />
                                    Closed Accidents
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                @if (_customReportRows.Count > 0)
                {
                    <div class="form-section">
                        <h2 class="form-section-title">Period Report Output</h2>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Reg Number</th>
                                            <th>GG Number</th>
                                            <th>Accident Date</th>
                                            <th>Dept/Site Code</th>
                                            <th>Dept/Site</th>
                                            <th>Hire Type</th>
                                            <th>Accident Description</th>
                                            <th>Driver</th>
                                            <th>Transport Officer</th>
                                            <th>Call Refer</th>
                                            <th>GG Car Damage</th>
                                            <th>File Close Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _customReportRows)
                                        {
                                            <tr>
                                                <td>@GetReportValue(row, "registration_number")</td>
                                                <td>@GetReportValue(row, "fleet_number")</td>
                                                <td>@GetReportValue(row, "occurence_date")</td>
                                                <td>@GetReportValue(row, "department_number")</td>
                                                <td>@GetReportValue(row, "site_description")</td>
                                                <td>@GetReportValue(row, "hire_type")</td>
                                                <td>@GetReportValue(row, "accident_type_description")</td>
                                                <td>@GetReportValue(row, "driver_name")</td>
                                                <td>@GetReportValue(row, "transoffic_name")</td>
                                                <td>@GetReportValue(row, "call_refer")</td>
                                                <td>@GetReportValue(row, "cost_of_repair")</td>
                                                <td>@GetReportValue(row, "file_close_date")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (CurrentMode == "duplicate-accidents")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Duplicate Accidents</h2>
                    <div class="form-grid">
                        <div class="form-field form-group-full">
                            <div class="contract-search-radio">
                                <label class="form-radio-label">
                                    <input type="radio" name="dupGarage" checked="@(_duplicateGarage == "jhb")" @onchange='() => _duplicateGarage = "jhb"' />
                                    JHB
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="dupGarage" checked="@(_duplicateGarage == "pta")" @onchange='() => _duplicateGarage = "pta"' />
                                    PTA
                                </label>
                                <label class="form-radio-label">
                                    <input type="radio" name="dupGarage" checked="@(_duplicateGarage == "all")" @onchange='() => _duplicateGarage = "all"' />
                                    ALL
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Report Menu</a>
                    </div>
                </div>
                @if (_customReportRows.Count > 0)
                {
                    <div class="form-section">
                        <h2 class="form-section-title">Duplicate Accidents Output</h2>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>GG Number</th>
                                            <th>Reg Number</th>
                                            <th>Accident Date</th>
                                            <th>Accident Time</th>
                                            <th>Accident Place</th>
                                            <th>Driver</th>
                                            <th>Case Number</th>
                                            <th>Cost of Repair</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _customReportRows)
                                        {
                                            <tr>
                                                <td>@GetReportValue(row, "fleet_number")</td>
                                                <td>@GetReportValue(row, "registration_number")</td>
                                                <td>@GetReportValue(row, "occurence_date")</td>
                                                <td>@GetReportValue(row, "occurence_time")</td>
                                                <td>@GetReportValue(row, "occurence_place")</td>
                                                <td>@GetReportValue(row, "driver_name")</td>
                                                <td>@GetReportValue(row, "case_number")</td>
                                                <td>@GetReportValue(row, "cost_of_repair")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (CurrentMode == "driver-report")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Driver Search</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="driverSearchType" checked />
                                Driver Name
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="driverSearchType" />
                                ID Number
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Driver Name or ID Number</label>
                            <select class="form-select" @bind="_selectedDriverCode">
                                <option value="">Select driver...</option>
                                @foreach (var driver in _drivers)
                                {
                                    <option value="@driver.site_driver_code">@DriverOptionLabel(driver)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in DriverReportColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0402</td>
                                        <td>GG12121</td>
                                        <td>P. Dube</td>
                                        <td>7901015009088</td>
                                        <td>2024/02/27</td>
                                        <td>SITE-11</td>
                                        <td>Facilities</td>
                                        <td>9000</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">Use the filters above to run and review accident report output.</p>
            }
        </div>
    </div>
    @if (_recentReports.Count > 0 && TotalPages > 1)
    {
        <div class="pagination-controls">
            <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <span>Page @_page of @TotalPages</span>
            <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    }
</div>

@code {
    private List<ReportDto> _recentReports = new();
    private List<SiteResponseDto> _sites = new();
    private List<DriverDto> _drivers = new();
    private string _oneVehicleSearchMode = "gp";
    private string _oneVehicleSearchTerm = string.Empty;
    private List<VehicleLookupDto> _oneVehicleMatches = new();
    private int? _oneVehicleSelectedVmfCode;
    private int? _selectedDriverCode;
    private short? _weeklyPeriodSiteCode;
    private string _newAccidentReportMode = "call";
    private string _duplicateGarage = "all";
    private string _periodStatus = "open";
    private string _periodDepartmentNumber = string.Empty;
    private DateTime _periodBeginDate = DateTime.Today.AddMonths(-1);
    private DateTime _periodEndDate = DateTime.Today;
    private List<Dictionary<string, string>> _customReportRows = new();
    private int _page = 1;
    private const int _pageSize = 12;
    private IEnumerable<ReportDto> PagedRecentReports => _recentReports.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_recentReports.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _drivers = await DriverService.GetDriversAsync();
    }

    private async Task LoadReports()
    {
        _customReportRows = new();
        if (CurrentMode == "one-vehicle")
        {
            await SearchOneVehicleAsync();
        }
        else if (CurrentMode == "duplicate-accidents")
        {
            _customReportRows = await AccidentService.GetDuplicateAccidentReportAsync(_duplicateGarage);
        }
        else if (CurrentMode == "new-accidents")
        {
            _customReportRows = await AccidentService.GetNewAccidentsReportAsync(_newAccidentReportMode);
        }
        else if (CurrentMode == "period-open-close")
        {
            _customReportRows = await AccidentService.GetPeriodStatusReportAsync(_periodDepartmentNumber, _periodBeginDate, _periodEndDate, _periodStatus);
        }
        _recentReports = await AccidentService.GetRecentReportsAsync();
        _page = 1;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string SiteOptionLabel(SiteResponseDto site)
        => $"{site.Description} ({site.SiteCode})";

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DriverOptionLabel(DriverDto driver)
    {
        var fullName = $"{driver.driver_firstname} {driver.driver_surname}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            fullName = "Unknown Driver";
        }

        return $"{fullName} ({driver.site_driver_code}) [{ValueOrDash(driver.driver_SA_id)}]";
    }

    private async Task SearchOneVehicleAsync()
    {
        _oneVehicleMatches = new();
        _oneVehicleSelectedVmfCode = null;
        var keyword = _oneVehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return;
        }

        try
        {
            var matches = await VehicleLookupService.SearchAsync(keyword);
            _oneVehicleMatches = RankVehicleMatches(matches, keyword, _oneVehicleSearchMode == "gg");
            if (_oneVehicleMatches.All(vehicle => vehicle.VmfCode != _oneVehicleSelectedVmfCode))
            {
                _oneVehicleSelectedVmfCode = null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void SetOneVehicleSearchMode(string mode)
    {
        if (_oneVehicleSearchMode == mode)
        {
            return;
        }

        _oneVehicleSearchMode = mode;
        _oneVehicleSearchTerm = string.Empty;
        _oneVehicleMatches = new();
        _oneVehicleSelectedVmfCode = null;
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static List<VehicleLookupDto> RankVehicleMatches(List<VehicleLookupDto> matches, string query, bool preferGg)
    {
        return (preferGg
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v => !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v =>
                preferGg
                    ? string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => preferGg ? v.GGNumber : v.RegistrationNumber)
            .ToList();
    }

    [Parameter]
    public string? Mode { get; set; }

    private string CurrentMode => ResolveMode();

    private string _pageTitle = "Accident Report";

    protected override void OnParametersSet()
    {
        _pageTitle = CurrentMode switch
        {
            "one-vehicle" => "One Vehicle Accidents",
            "private-vehicle" => "Private Vehicle Accidents",
            "private-vehicle-capture-desc" => "Private Vehicle Accidents (Capture under Description of Accident)",
            "all-detail" => "All Accidents - ALL DETAIL",
            "all-garage-detail" => "All Accidents - GARAGE DETAIL",
            "new-accidents" => "Report on New Accident's",
            "weekly-quarterly-yearly" => "Weekly, Quarterly And Yearly Report - Opened And Closed Accidents",
            "period-open-close" => "Accident Report For A Period",
            "duplicate-accidents" => "Report on ALL Duplicate Accidents",
            "driver-report" => "Report By Driver Name Or ID Number",
            _ => "Accident Report"
        };
    }

    private string ResolveMode()
    {
        var normalized = (Mode ?? string.Empty).Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(normalized))
        {
            return normalized;
        }

        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "accident/rpt_one_num_main_accident.htm" => "one-vehicle",
            "accident/rpt_one_prnum_main_accident.htm" => "private-vehicle",
            "accident/rpt_one_prnumc_main_accident.htm" => "private-vehicle-capture-desc",
            "accident/rpt_all_main_accident.htm" => "all-detail",
            "accident/rpt_allgar_main_accident.htm" => "all-garage-detail",
            "accident/rpt_flagnew_main_accident.htm" => "new-accidents",
            "accident/rpt_flagnew_report_accident.aspx" => "new-accidents",
            "accident/rpt_period_report1.aspx" => "weekly-quarterly-yearly",
            "accident/rpt_period_report2.aspx" => "period-open-close",
            "accident/rpt_accident_driver_main.aspx" => "driver-report",
            "accident/rpt_f_dup_main_accident.htm" => "duplicate-accidents",
            "accident/rpt_f_dup_report_accident.aspx" => "duplicate-accidents",
            _ => string.Empty
        };
    }

