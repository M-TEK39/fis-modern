@page "/accidents/reports/{Mode}"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AccidentApiService AccidentService

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Legacy accident report parameters will be aligned here.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Back to Accident Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "one-vehicle")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Search Parameters</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="oneVehicleType" checked />
                                GP
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">
                                <input type="radio" name="oneVehicleType" />
                                GG
                            </label>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadReports">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/accidents/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Accident Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in OneVehicleFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetSampleValue(field)</td>
                                        </tr>
                                    }
                                    @if (_recentReports.Count > 0)
                                    {
                                        <tr>
                                            <td colspan="2"><strong>Recent Reports</strong></td>
                                        </tr>
                                        @foreach (var report in _recentReports)
                                        {
                                            <tr>
                                                <td>@report.Name</td>
                                                <td>@FormatDate(report.GeneratedDate)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
