@page "/accidents/garage"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AccidentApiService AccidentService
@inject VehicleApiService VehicleService

<PageTitle>Accident Maintenance (Garage) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-crash"></i>
            Accident Maintenance (Garage)
        </h1>
        <p class="page-description">Search by GG or GP number, then edit or add accidents.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents">Back to Accident Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Accident Maintenance</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="GarageSearchType" checked="@(_searchType == "GG")" @onchange='() => SetSearchType("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="GarageSearchType" checked="@(_searchType == "GP")" @onchange='() => SetSearchType("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_searchType == "GG" ? "GG Number" : "GP Number")</label>
                    <input class="form-input" maxlength="8" @bind="_searchQuery" @bind:event="oninput" placeholder="@(_searchType == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchAccidents">Submit</button>
                <a class="btn btn-secondary" href="/accidents">Menu</a>
            </div>

            <div class="table-container fis-mt-15">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Vehicle Number</th>
                                <th>Hire Type</th>
                                <th>Accident Date</th>
                                <th>GG Reference</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="5">Loading accidents...</td>
                                </tr>
                            }
                            else if (_accidents.Count == 0)
                            {
                                <tr>
                                    <td colspan="5">No records found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in PagedAccidents)
                                {
                                    <tr>
                                        <td>@ValueOrDash(item.VehicleNumber)</td>
                                        <td>@ValueOrDash(item.HireType)</td>
                                        <td>@FormatDate(item.AccidentDate)</td>
                                        <td>@ValueOrDash(item.Reference)</td>
                                        <td>
                                            <a class="btn btn-secondary btn-sm" href="@($"/accidents/garage/edit?accidentId={item.AccidentId}")">Edit</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (_accidents.Count > _pageSize)
                {
                    <div class="pagination">
                        <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                        <div class="pagination-info">Page @_page of @TotalPages</div>
                        <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                    </div>
                    <div class="pagination-meta">Total records: @_accidents.Count | Page size: @_pageSize</div>
                }
            </div>

            <div class="form-actions fis-mt-1">
                <a class="btn btn-primary" href="/accidents/garage/add">Add New</a>
                <a class="btn btn-secondary" href="/accidents">Menu</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string _searchType = "GP";
    private string _searchQuery = "";
    private bool _loading;
    private List<AccidentRow> _accidents = new();
    private List<AccidentRow> _allAccidents = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<AccidentRow> PagedAccidents => _accidents.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_accidents.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadAccidents();
    }

    private async Task LoadAccidents()
    {
        _loading = true;
        try
        {
            var apiItems = await AccidentService.GetAccidentsAsync();
            _allAccidents = apiItems.Select(a => new AccidentRow(
                AccidentId: a.accident_code,
                VehicleId: a.vehicle_id,
                VehicleNumber: a.vehicle_registration,
                HireType: string.IsNullOrWhiteSpace(a.severity) ? a.status : a.severity,
                AccidentDate: a.accident_date,
                Reference: a.accident_reference
            )).ToList();

            await HydrateVehicleLabelsAsync(_allAccidents);
            _accidents = new List<AccidentRow>(_allAccidents);
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAccidents()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _accidents = new List<AccidentRow>(_allAccidents);
            _page = 1;
            return;
        }

        var searchTerm = _searchQuery.Trim();
        var matches = await VehicleService.SearchVehiclesAsync(searchTerm);
        matches = FilterVehicleMatchesByNumberType(matches, searchTerm, _searchType);
        if (matches.Count == 0)
        {
            _accidents = new();
            _page = 1;
            return;
        }

        var vmfCodes = matches.Select(v => v.vmf_code).ToHashSet();
        _accidents = _allAccidents.Where(a => a.VehicleId.HasValue && vmfCodes.Contains(a.VehicleId.Value)).ToList();
        _page = 1;
    }

    private void SetSearchType(string value)
    {
        if (_searchType == value)
        {
            return;
        }

        _searchType = value;
        _searchQuery = string.Empty;
        _accidents = new List<AccidentRow>(_allAccidents);
        _page = 1;
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatchesByNumberType(List<VehicleDto> matches, string term, string searchType)
    {
        return searchType == "GG"
            ? matches
                .Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(term, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(v => string.Equals(v.fleet_number?.Trim(), term, StringComparison.OrdinalIgnoreCase))
                .ThenBy(v => v.vmf_code)
                .ToList()
            : matches
                .Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(term, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(v => string.Equals(v.registration_number?.Trim(), term, StringComparison.OrdinalIgnoreCase))
                .ThenBy(v => v.vmf_code)
                .ToList();
    }

    private sealed record AccidentRow(
        int AccidentId,
        int? VehicleId,
        string VehicleNumber,
        string? HireType,
        DateTime? AccidentDate,
        string? Reference
    );

    private async Task HydrateVehicleLabelsAsync(List<AccidentRow> rows)
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        var vehicleMap = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(g => g.Key, g => g.First());

        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            if (row.VehicleId.HasValue && vehicleMap.TryGetValue(row.VehicleId.Value, out var vehicle))
            {
                rows[i] = row with { VehicleNumber = $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})" };
            }
            else
            {
                rows[i] = row with { VehicleNumber = ValueOrDash(row.VehicleNumber) };
            }
        }
    }
}
