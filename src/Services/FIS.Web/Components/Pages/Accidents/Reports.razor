@page "/accidents/reports"
@page "/Accident/RPTAccident.aspx"
@rendermode InteractiveServer
<PageTitle>Accident Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Accident Reports Menu
        </h1>
        <p class="page-description">Accident reports grouped by category.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents">Back to Accident Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>One Accident Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/one-vehicle">1) One Vehicle Accidents</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/private-vehicle">2) Private Vehicle Accidents</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/private-vehicle-capture-desc">3) Private Vehicle Accidents (Capture under Description of Accident)</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>All Accidents Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/all-detail">4) All Accidents - ALL DETAIL</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/all-garage-detail">5) All Accidents - GARAGE DETAIL</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Other Accident Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/new-accidents">6) Report on New Accident's</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/department-finyear">10) Report for a Department/Site, for a Book / Financial Year</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/accident-costs-finyear">11) Report on Accident Costs for a Financial Year</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/letter-outstanding-docs">12) LETTER for Outstanding Accident documents</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/letter-inspection">13) LETTER for Inspection</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/categories">14) List of Accident Categories</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/last-gg-reference">15) Last GG Reference Number Used</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/weekly-quarterly-yearly">16) Weekly, Quarterly And Yearly Report - Opened And Closed Accidents</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/driver-report">17) Report By Driver Name Or ID Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/accidents/reports/duplicate-accidents">18) Report on ALL Duplicate Accidents</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/reports/fis-report">Return To Main Page</a></div>
            </div>
        </div>
    </div>
</div>
