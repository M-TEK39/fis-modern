@page "/accidents"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject AccidentApiService AccidentService
@inject IJSRuntime JSRuntime

<PageTitle>Accidents - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-crash"></i>
            Accident Maintenance Menu
        </h1>
        <p class="page-description">Accident maintenance workflows and reports.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleHelp">
                <span>Accident Maintenance Information / Help</span>
                <i class="bx @(_showHelp ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showHelp)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/help">Help / Documentation</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleGarage">
                <span>Accident Maintenance for Garage</span>
                <i class="bx @(_showGarage ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showGarage)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/garage">1) Accident Maintenance</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/garage/delete">2) Delete an Accident</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleHq">
                <span>Accident Maintenance for HQ</span>
                <i class="bx @(_showHq ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showHq)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/hq">3) Accident Maintenance</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/hq/delete">4) Delete an Accident</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleReports">
                <span>Accident Reports</span>
                <i class="bx @(_showReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/accidents/reports">1) Accidents Reports</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <DataPreviewTable Title="Accident Preview"
                      SearchPlaceholder="Search accident reference, vehicle, driver, location, status..."
                      EmptyMessage="No accidents match the current search or filter."
                      EmptyIcon="bx bxs-car-crash"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _showHelp = true;
    private bool _showGarage = true;
    private bool _showHq = true;
    private bool _showReports = true;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("reference", "Reference"),
        new("vehicle", "Vehicle"),
        new("date", "Date"),
        new("driver", "Driver"),
        new("location", "Location"),
        new("severity", "Severity"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Lost vehicles", "vehicleAvailability", "Lost Vehicle"),
        new("Recovered vehicles", "vehicleAvailability", "Recovered Vehicle"),
        new("Available vehicles", "vehicleAvailability", "Available Vehicle"),
        new("Third party involved", "thirdPartyStatus", "Third Party"),
        new("Injuries reported", "injuryStatus", "Injuries")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private void ToggleHelp() => _showHelp = !_showHelp;
    private void ToggleGarage() => _showGarage = !_showGarage;
    private void ToggleHq() => _showHq = !_showHq;
    private void ToggleReports() => _showReports = !_showReports;

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var accidents = await AccidentService.GetAccidentsAsync();
            _rows = accidents
                .OrderByDescending(item => item.accident_date)
                .Select(item => new Dictionary<string, string?>
                {
                    ["reference"] = item.accident_reference,
                    ["vehicle"] = item.vehicle_registration,
                    ["date"] = item.accident_date.ToString("yyyy-MM-dd"),
                    ["driver"] = item.driver_name,
                    ["location"] = item.accident_location,
                    ["severity"] = item.severity,
                    ["status"] = item.status,
                    ["vehicleAvailability"] = GetVehicleAvailability(item),
                    ["thirdPartyStatus"] = item.third_party_involved ? "Third Party" : "No Third Party",
                    ["injuryStatus"] = item.injuries_reported ? "Injuries" : "No Injuries"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading accident preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetVehicleAvailability(AccidentDto item)
    {
        var text = $"{item.status} {item.accident_description} {item.description} {item.notes}";
        if (text.Contains("recover", StringComparison.OrdinalIgnoreCase))
        {
            return "Recovered Vehicle";
        }

        if (text.Contains("lost", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("write", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("stolen", StringComparison.OrdinalIgnoreCase))
        {
            return "Lost Vehicle";
        }

        return "Available Vehicle";
    }
}
