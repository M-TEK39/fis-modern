@page "/accidents"
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@using AccidentDto = FIS.Web.Models.AccidentDto
@inject AccidentApiService AccidentApiService
@inject VehicleApiService VehicleApiService
@inject DriverApiService DriverApiService
@inject DepartmentApiService DepartmentApiService
@inject IJSRuntime JSRuntime

<PageTitle>Accidents - Fleet Information System</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="page-title-section">
            <h1>
                <i class="bx bx-car-crash"></i>
                Accident Management
            </h1>
            <p>Manage vehicle accidents, track claims, and generate reports</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-primary" @onclick="ShowAddAccidentForm">
                <i class="bx bx-plus"></i>
                Report Accident
            </button>
        </div>
    </div>

    <div class="tab-container">
        <div class="tab-header">
            <button class="tab-button @(ActiveTab == "accidents" ? "active" : "")" @onclick="@(() => SetActiveTab("accidents"))">
                <i class="bx bx-list-ul"></i>
                Accidents
            </button>
            <button class="tab-button @(ActiveTab == "claims" ? "active" : "")" @onclick="@(() => SetActiveTab("claims"))">
                <i class="bx bx-money"></i>
                Claims & Costs
            </button>
            <button class="tab-button @(ActiveTab == "reports" ? "active" : "")" @onclick="@(() => SetActiveTab("reports"))">
                <i class="bx bx-file"></i>
                Reports
            </button>
        </div>

        <div class="tab-content">
            <!-- Debug: Current tab = @ActiveTab -->
            @if (ActiveTab == "accidents")
            {
                <AccidentsTab 
                    FilteredAccidents="FilteredAccidents"
                    Loading="Loading"
                    SearchTerm="SearchTerm"
                    OnSearchChange="HandleSearchChange"
                    OnAddAccident="ShowAddAccidentForm"
                    OnRefresh="LoadAccidents"
                    OnView="ViewAccident"
                    OnEdit="EditAccident"
                    OnDelete="DeleteAccident" />
            }
            else if (ActiveTab == "claims")
            {
                <ClaimsTab 
                    Loading="Loading"
                    ClaimsSummary="ClaimsSummary"
                    RecentHighValueClaims="GetHighValueClaims()"
                    OnRefresh="LoadClaimsData" />
            }
            else if (ActiveTab == "reports")
            {
                <ReportsTab 
                    RecentReports="RecentReports"
                    GeneratingReport="GeneratingReport"
                    OnRefreshReports="LoadRecentReports"
                    OnGenerateReport="GenerateReport"
                    OnConfigureReport="ConfigureReport"
                    OnDownloadReport="DownloadReport"
                    OnDeleteReport="DeleteReport" />
            }
        </div>
    </div>

    @if (ShowAccidentForm)
    {
        <!-- Debug: ShowAccidentForm = @ShowAccidentForm -->
        <Modal IsVisible="ShowAccidentForm" 
               Title="@(SelectedAccident == null ? "Report New Accident" : "Edit Accident")" 
               Size="Modal.ModalSize.Large"
               OnCancel="HideAccidentForm">
            <ChildContent>
                <AccidentForm 
                    Accident="SelectedAccident ?? new AccidentDto()"
                    AvailableVehicles="Vehicles"
                    AvailableDrivers="Drivers"
                    IsEditMode="@(SelectedAccident != null)"
                    IsSaving="false"
                    OnSave="SaveAccidentFromForm"
                    OnCancel="HideAccidentForm" />
            </ChildContent>
        </Modal>
    }

    @if (ShowDeleteConfirmation)
    {
        <ConfirmationModal 
            IsVisible="ShowDeleteConfirmation"
            Title="Delete Accident"
            Message="@($"Are you sure you want to delete accident {AccidentToDelete?.accident_reference}? This action cannot be undone.")"
            ConfirmText="Delete"
            CancelText="Cancel"
            OnConfirm="ConfirmDelete"
            OnCancel="CancelDelete" />
    }
</div>

@code {
    // State management
    private string ActiveTab = "accidents";
    private bool Loading = true;
    private bool GeneratingReport = false;
    private bool ShowAccidentForm = false;
    private bool ShowDeleteConfirmation = false;
    private string SearchTerm = "";

    // Data collections
    private List<AccidentDto> AllAccidents = new();
    private List<AccidentDto> FilteredAccidents = new();
    private List<VehicleDto> Vehicles = new();
    private List<DriverDto> Drivers = new();
    private List<DepartmentDto> Departments = new();
    private List<ReportDto> RecentReports = new();
    private ClaimsSummaryDto ClaimsSummary = new();

    // Selected items
    private AccidentDto? SelectedAccident = null;
    private AccidentDto? AccidentToDelete = null;

    // Component references (not needed for new modal pattern)
    // private Modal? AccidentModal;
    // private ConfirmationModal? DeleteModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        Loading = true;
        try
        {
            await Task.WhenAll(
                LoadAccidents(),
                LoadVehicles(),
                LoadDrivers(),
                LoadDepartments(),
                LoadClaimsData(),
                LoadRecentReports()
            );
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadAccidents()
    {
        try
        {
            // Mock data for now - replace with actual API calls when available
            AllAccidents = new List<AccidentDto>
            {
                new AccidentDto 
                { 
                    accident_reference = "ACC-2024-001", 
                    accident_date = DateTime.Now.AddDays(-5), 
                    vehicle_registration = "GP123ABC",
                    vehicle_description = "Toyota Camry 2020",
                    accident_location = "Main Road, Johannesburg",
                    severity = "Minor",
                    cost_of_repair = 5500,
                    third_party_claim = 0,
                    status = "Completed",
                    description = "Minor fender bender in parking lot"
                },
                new AccidentDto 
                { 
                    accident_reference = "ACC-2024-002", 
                    accident_date = DateTime.Now.AddDays(-12), 
                    vehicle_registration = "GP456DEF",
                    vehicle_description = "Ford Ranger 2019",
                    accident_location = "Highway N1, Pretoria",
                    severity = "Moderate",
                    cost_of_repair = 15000,
                    third_party_claim = 8000,
                    status = "Under Investigation",
                    description = "Collision with another vehicle"
                }
            };
            ApplySearchFilter();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading accidents: {ex.Message}");
        }
    }

    private async Task LoadVehicles()
    {
        try
        {
            // Mock data for now - replace with actual API calls when available
            Vehicles = new List<VehicleDto>
            {
                new VehicleDto { vmf_code = 1, registration_number = "GP123ABC", model_name = "Toyota Camry 2020" },
                new VehicleDto { vmf_code = 2, registration_number = "GP456DEF", model_name = "Ford Ranger 2019" },
                new VehicleDto { vmf_code = 3, registration_number = "GP789GHI", model_name = "Nissan Navara 2021" }
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicles: {ex.Message}");
        }
    }

    private async Task LoadDrivers()
    {
        try
        {
            // Mock data for now - replace with actual API calls when available
            Drivers = new List<DriverDto>
            {
                new DriverDto { site_driver_code = 1, driver_firstname = "John", driver_surname = "Doe", site_name = "Main Office" },
                new DriverDto { site_driver_code = 2, driver_firstname = "Jane", driver_surname = "Smith", site_name = "Regional Office" },
                new DriverDto { site_driver_code = 3, driver_firstname = "Mike", driver_surname = "Johnson", site_name = "Main Office" }
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading drivers: {ex.Message}");
        }
    }

    private async Task LoadDepartments()
    {
        try
        {
            // Mock data for now - replace with actual API calls when available
            Departments = new List<DepartmentDto>
            {
                new DepartmentDto { department_code = 1, department_description = "IT Department" },
                new DepartmentDto { department_code = 2, department_description = "Finance Department" },
                new DepartmentDto { department_code = 3, department_description = "Operations Department" }
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading departments: {ex.Message}");
        }
    }

    private async Task LoadClaimsData()
    {
        try
        {
            // Mock data for now - replace with actual API calls
            ClaimsSummary = new ClaimsSummaryDto
            {
                TotalClaims = AllAccidents.Count,
                TotalRepairCosts = AllAccidents.Sum(a => a.cost_of_repair ?? 0),
                TotalThirdPartyClaims = AllAccidents.Sum(a => a.third_party_claim ?? 0),
                PendingClaims = AllAccidents.Count(a => a.status == "Pending" || a.status == "Under Investigation"),
                CostByCategory = new Dictionary<string, decimal>
                {
                    ["Minor Damage"] = AllAccidents.Where(a => a.severity == "Minor").Sum(a => a.cost_of_repair ?? 0),
                    ["Moderate Damage"] = AllAccidents.Where(a => a.severity == "Moderate").Sum(a => a.cost_of_repair ?? 0),
                    ["Major Damage"] = AllAccidents.Where(a => a.severity == "Major").Sum(a => a.cost_of_repair ?? 0),
                    ["Total Loss"] = AllAccidents.Where(a => a.severity == "Total Loss").Sum(a => a.cost_of_repair ?? 0)
                },
                MonthlyTrend = new Dictionary<string, decimal>
                {
                    ["Jul"] = 25000,
                    ["Aug"] = 32000,
                    ["Sep"] = 18000,
                    ["Oct"] = 45000,
                    ["Nov"] = 28000,
                    ["Dec"] = 0
                }
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading claims data: {ex.Message}");
        }
    }

    private async Task LoadRecentReports()
    {
        try
        {
            // Mock data for now - replace with actual API calls
            RecentReports = new List<ReportDto>
            {
                new() { Name = "Accident Summary - November 2025", GeneratedDate = DateTime.Now.AddDays(-1), FileSize = "2.4 MB" },
                new() { Name = "Cost Analysis - Q4 2025", GeneratedDate = DateTime.Now.AddDays(-3), FileSize = "1.8 MB" },
                new() { Name = "Vehicle History - Fleet Analysis", GeneratedDate = DateTime.Now.AddDays(-7), FileSize = "3.1 MB" }
            };
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading recent reports: {ex.Message}");
        }
    }

    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        await JSRuntime.InvokeVoidAsync("console.log", $"Active tab changed to: {tab}");
        await InvokeAsync(StateHasChanged);
    }

    private void ApplySearchFilter()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            FilteredAccidents = AllAccidents.ToList();
        }
        else
        {
            var searchLower = SearchTerm.ToLower();
            FilteredAccidents = AllAccidents.Where(a =>
                a.accident_reference.ToLower().Contains(searchLower) ||
                a.vehicle_registration.ToLower().Contains(searchLower) ||
                a.accident_location.ToLower().Contains(searchLower) ||
                a.description?.ToLower().Contains(searchLower) == true
            ).ToList();
        }
    }

    private async Task HandleSearchChange(string searchTerm)
    {
        SearchTerm = searchTerm;
        ApplySearchFilter();
        await InvokeAsync(StateHasChanged);
    }

    private List<AccidentDto> GetHighValueClaims()
    {
        return AllAccidents
            .Where(a => (a.cost_of_repair ?? 0) + (a.third_party_claim ?? 0) > 10000)
            .OrderByDescending(a => (a.cost_of_repair ?? 0) + (a.third_party_claim ?? 0))
            .ToList();
    }

    // Accident management
    private async Task ShowAddAccidentForm()
    {
        await JSRuntime.InvokeVoidAsync("console.log", "ShowAddAccidentForm called");
        SelectedAccident = null;
        ShowAccidentForm = true;
        await JSRuntime.InvokeVoidAsync("console.log", $"ShowAccidentForm set to: {ShowAccidentForm}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ViewAccident(AccidentDto accident)
    {
        SelectedAccident = accident;
        ShowAccidentForm = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditAccident(AccidentDto accident)
    {
        SelectedAccident = accident;
        ShowAccidentForm = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAccidentFromForm()
    {
        // This method is called from the form, but we need the accident data
        // For now, we'll handle this in the AccidentForm component itself
        await HideAccidentForm();
    }

    private async Task SaveAccident(AccidentDto accident)
    {
        try
        {
            if (SelectedAccident == null)
            {
                // Mock create - assign a new ID
                accident.accident_code = AllAccidents.Count + 1;
                AllAccidents.Add(accident);
            }
            else
            {
                // Mock update - find and replace
                var index = AllAccidents.FindIndex(a => a.accident_code == accident.accident_code);
                if (index >= 0)
                {
                    AllAccidents[index] = accident;
                }
            }
            
            await HideAccidentForm();
            await LoadAccidents();
            await JSRuntime.InvokeVoidAsync("alert", "Accident saved successfully!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving accident: {ex.Message}");
        }
    }

    private async Task HideAccidentForm()
    {
        ShowAccidentForm = false;
        SelectedAccident = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteAccident(AccidentDto accident)
    {
        AccidentToDelete = accident;
        ShowDeleteConfirmation = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDelete()
    {
        if (AccidentToDelete != null)
        {
            try
            {
                // Mock delete - remove from list
                AllAccidents.RemoveAll(a => a.accident_code == AccidentToDelete.accident_code);
                await CancelDelete();
                await LoadAccidents();
                await JSRuntime.InvokeVoidAsync("alert", "Accident deleted successfully!");
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting accident: {ex.Message}");
            }
        }
    }

    private async Task CancelDelete()
    {
        ShowDeleteConfirmation = false;
        AccidentToDelete = null;
        await InvokeAsync(StateHasChanged);
    }

    // Report management
    private async Task GenerateReport(ReportsTab.ReportType reportType)
    {
        GeneratingReport = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(2000); // Simulate report generation
            await JSRuntime.InvokeVoidAsync("alert", $"Report generated: {reportType}");
            await LoadRecentReports();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error generating report: {ex.Message}");
        }
        finally
        {
            GeneratingReport = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfigureReport(ReportsTab.ReportType reportType)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Configure report: {reportType}");
    }

    private async Task DownloadReport(ReportDto report)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Downloading: {report.Name}");
    }

    private async Task DeleteReport(ReportDto report)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Deleted: {report.Name}");
        await LoadRecentReports();
    }
}
