@using FIS.Web.Models
@using FIS.Web.Services

<EditForm Model="Accident" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />

    <div class="accident-form">
        <div class="form-header">
            <h3>@(IsEditMode ? "Edit Accident Report" : "Report New Accident")</h3>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    <i class="bx bx-x"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <div class="btn-spinner"></div>
                    }
                    else
                    {
                        <i class="bx bx-save"></i>
                    }
                    @(IsEditMode ? "Update" : "Save")
                </button>
            </div>
        </div>

        <div class="form-content">
        <div class="form-section">
            <h4>Accident Details</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="accident-reference">Reference Number</label>
                    <input 
                        type="text" 
                        id="accident-reference"
                        class="form-input" 
                        @bind="Accident.accident_reference" 
                        placeholder="Auto-generated if left blank"
                        readonly="@(!IsEditMode)" />
                </div>

                <div class="form-group">
                    <label class="form-label required" for="accident-date">Accident Date & Time</label>
                    <input 
                        type="datetime-local" 
                        id="accident-date"
                        class="form-input" 
                        @bind="Accident.accident_date" 
                        required />
                    <ValidationMessage For="() => Accident.accident_date" />
                </div>

                <div class="form-group">
                    <label class="form-label required" for="vehicle-registration">Vehicle Registration</label>
                    <select class="form-select" id="vehicle-registration" @bind="Accident.vehicle_id" required>
                        <option value="">Select Vehicle</option>
                        @foreach (var vehicle in AvailableVehicles)
                        {
                            <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                        }
                    </select>
                    <ValidationMessage For="() => Accident.vehicle_id" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="driver-name">Driver at Time of Accident</label>
                    <select class="form-select" id="driver-name" @bind="Accident.driver_id">
                        <option value="">Select Driver (if known)</option>
                        @foreach (var driver in AvailableDrivers)
                        {
                            <option value="@driver.site_driver_code">@($"{driver.driver_firstname} {driver.driver_surname}".Trim()) (@driver.site_driver_code)</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4>Location & Description</h4>
            <div class="form-grid">
                <div class="form-group form-group-full">
                    <label class="form-label required" for="accident-location">Location of Accident</label>
                    <input 
                        type="text" 
                        id="accident-location"
                        class="form-input" 
                        @bind="Accident.accident_location" 
                        placeholder="Street address or description of location"
                        required />
                    <ValidationMessage For="() => Accident.accident_location" />
                </div>

                <div class="form-group form-group-full">
                    <label class="form-label required" for="accident-description">Description of Accident</label>
                    <textarea 
                        id="accident-description"
                        class="form-textarea" 
                        @bind="Accident.accident_description" 
                        rows="4"
                        placeholder="Provide detailed description of how the accident occurred"
                        required></textarea>
                    <ValidationMessage For="() => Accident.accident_description" />
                </div>

                <div class="form-group">
                    <label class="form-label required" for="severity">Accident Severity</label>
                    <select class="form-select" id="severity" @bind="Accident.severity" required>
                        <option value="">Select Severity</option>
                        <option value="Minor">Minor</option>
                        <option value="Moderate">Moderate</option>
                        <option value="Major">Major</option>
                        <option value="Total Loss">Total Loss</option>
                    </select>
                    <ValidationMessage For="() => Accident.severity" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="weather-conditions">Weather Conditions</label>
                    <select class="form-select" id="weather-conditions" @bind="Accident.weather_conditions">
                        <option value="">Select Weather</option>
                        <option value="Clear">Clear</option>
                        <option value="Rainy">Rainy</option>
                        <option value="Foggy">Foggy</option>
                        <option value="Windy">Windy</option>
                        <option value="Snow">Snow</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4>Financial Information</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="estimated-repair-cost">Estimated Repair Cost</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input 
                            type="number" 
                            id="estimated-repair-cost"
                            class="form-input" 
                            @bind="Accident.cost_of_repair" 
                            placeholder="0.00"
                            step="0.01"
                            min="0" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="third-party-claim">Third Party Claim Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input 
                            type="number" 
                            id="third-party-claim"
                            class="form-input" 
                            @bind="Accident.third_party_claim" 
                            placeholder="0.00"
                            step="0.01"
                            min="0" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="insurance-excess">Insurance Excess</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input 
                            type="number" 
                            id="insurance-excess"
                            class="form-input" 
                            @bind="Accident.insurance_excess" 
                            placeholder="0.00"
                            step="0.01"
                            min="0" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="claim-status">Claim Status</label>
                    <select class="form-select" id="claim-status" @bind="Accident.status">
                        <option value="Reported">Reported</option>
                        <option value="Under Investigation">Under Investigation</option>
                        <option value="Repairs in Progress">Repairs in Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4>Additional Information</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="police-case-number">Police Case Number</label>
                    <input 
                        type="text" 
                        id="police-case-number"
                        class="form-input" 
                        @bind="Accident.police_case_number" 
                        placeholder="Enter police case number if applicable" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="insurance-claim-number">Insurance Claim Number</label>
                    <input 
                        type="text" 
                        id="insurance-claim-number"
                        class="form-input" 
                        @bind="Accident.insurance_claim_number" 
                        placeholder="Insurance company claim reference" />
                </div>

                <div class="form-group form-group-full">
                    <label class="form-label" for="notes">Additional Notes</label>
                    <textarea 
                        id="notes"
                        class="form-textarea" 
                        @bind="Accident.notes" 
                        rows="3"
                        placeholder="Any additional information, witness details, etc."></textarea>
                </div>

                <div class="form-group form-group-checkbox">
                    <label class="checkbox-label">
                        <input 
                            type="checkbox" 
                            class="form-checkbox" 
                            @bind="Accident.injuries_reported" />
                        <span class="checkbox-text">Injuries Reported</span>
                    </label>
                </div>

                <div class="form-group form-group-checkbox">
                    <label class="checkbox-label">
                        <input 
                            type="checkbox" 
                            class="form-checkbox" 
                            @bind="Accident.third_party_involved" />
                        <span class="checkbox-text">Third Party Involved</span>
                    </label>
                </div>
            </div>
        </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public AccidentDto Accident { get; set; } = new();
    [Parameter] public List<VehicleDto> AvailableVehicles { get; set; } = new();
    [Parameter] public List<DriverDto> AvailableDrivers { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleValidSubmit()
    {
        await OnSave.InvokeAsync();
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
