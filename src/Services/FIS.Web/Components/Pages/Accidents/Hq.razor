@page "/accidents/hq"
@rendermode InteractiveServer

<PageTitle>Accident Maintenance (HQ) - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-crash"></i>
            Accident Maintenance (HQ)
        </h1>
        <p class="page-description">Search by GG or GP number, then edit or add accidents.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/accidents">Back to Accident Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>HQ Accident Maintenance</h2>
        </div>
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">
                        <input type="radio" name="HqSearchType" />
                        GG
                    </label>
                </div>
                <div class="form-field">
                    <label class="form-label">
                        <input type="radio" name="HqSearchType" checked />
                        GP
                    </label>
                </div>
                <div class="form-field">
                    <label class="form-label">Number</label>
                    <input class="form-input" maxlength="8" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary">Submit</button>
                <a class="btn btn-secondary" href="/accidents">Menu</a>
            </div>

            <div class="table-container" style="margin-top: 1.5rem;">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Vehicle Number</th>
                                <th>Hire Type</th>
                                <th>Accident Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="form-actions" style="margin-top: 1rem;">
                <a class="btn btn-primary" href="/accidents/hq/add">Add New</a>
                <a class="btn btn-secondary" href="/accidents">Menu</a>
            </div>
        </div>
    </div>
</div>
