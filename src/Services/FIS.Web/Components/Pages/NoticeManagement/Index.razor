@page "/notice-management"
@rendermode InteractiveServer

<PageTitle>Notice Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bell"></i>
            Notice Management
        </h1>
        <p class="page-description">Legacy notice schedule management.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/notice-management/detail">
            <i class="bx bx-plus"></i>
            Create new Notice
        </a>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-bell"></i>
        <h3>No notices to display</h3>
        <p>Please click on the Create button to create one.</p>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Notice Schedule List</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Notice title</th>
                        <th>Display start date</th>
                        <th>Display end date</th>
                        <th>Created by</th>
                        <th>Created on</th>
                        <th>Sort order</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="8">There are currently no notices to display. Please click on the Create button to create one.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
