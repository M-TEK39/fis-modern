@page "/notice-management"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject NoticeApiService NoticeService
@inject IJSRuntime JSRuntime

<PageTitle>Notice Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bell"></i>
            Notice Management
        </h1>
        <p class="page-description">Notice schedule management.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/notice-management/detail">
            <i class="bx bx-plus"></i>
            Create new Notice
        </a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading notices...</p>
        </div>
    }
    else if (_schedules.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-bell"></i>
            <h3>No notices to display</h3>
            <p>Please click on the Create button to create one.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">Notice Schedule List (@FilteredSchedules.Count)</span>
                <div class="table-controls">
                    <select class="form-select" @bind="_statusFilter" @bind:after="ResetPaging">
                        <option value="">All notices</option>
                        <option value="active">Currently active</option>
                        <option value="upcoming">Upcoming notices</option>
                        <option value="expired">Expired notices</option>
                        <option value="sorted">Sort order captured</option>
                    </select>
                </div>
            </div>
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input"
                           type="search"
                           placeholder="Search title, created by, dates, sort order..."
                           @bind="_searchTerm"
                           @bind:event="oninput"
                           @bind:after="ResetPaging" />
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <button type="button" class="search-clear" @onclick="ClearSearch" aria-label="Clear search">
                            <i class="bx bx-x"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Notice title</th>
                            <th>Display start date</th>
                            <th>Display end date</th>
                            <th>Created by</th>
                            <th>Created on</th>
                            <th>Sort order</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in PagedSchedules)
                        {
                            <tr>
                                <td>@schedule.TitleField</td>
                                <td>@(schedule.StartDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>@(schedule.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>@(schedule.CreatedBy ?? "-")</td>
                                <td>@(schedule.CreatedDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>@(schedule.SortOrder?.ToString() ?? "-")</td>
                                <td>
                                    <a class="btn btn-secondary btn-sm" href="/notice-management/detail?noticeid=@schedule.NoticeId&scheduleid=@schedule.NoticeScheduleId&createdate=@(schedule.CreatedDate?.ToString("yyyy/MM/dd"))">Edit Notice</a>
                                </td>
                                <td>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteSchedule(schedule.NoticeScheduleId)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>


@code {
    private bool _loading;
    private string? _errorMessage;
    private List<NoticeScheduleDto> _schedules = new();
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<NoticeScheduleDto> FilteredSchedules => _schedules
        .Where(MatchesSearch)
        .Where(MatchesFilter)
        .ToList();
    private IEnumerable<NoticeScheduleDto> PagedSchedules => FilteredSchedules.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredSchedules.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedules();
    }

    private async Task LoadSchedules()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _schedules = await NoticeService.GetSchedulesAsync();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load notice schedules.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            _schedules = new();
            _page = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteSchedule(int scheduleId)
    {
        _errorMessage = null;
        try
        {
            await NoticeService.DeleteScheduleAsync(scheduleId);
            await LoadSchedules();
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to delete notice schedule.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void ResetPaging()
    {
        _page = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _page = 1;
    }

    private bool MatchesSearch(NoticeScheduleDto schedule)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return true;
        }

        var search = _searchTerm.Trim();
        return Contains(schedule.TitleField, search) ||
            Contains(schedule.CreatedBy, search) ||
            Contains(schedule.StartDate?.ToString("yyyy/MM/dd"), search) ||
            Contains(schedule.EndDate?.ToString("yyyy/MM/dd"), search) ||
            Contains(schedule.SortOrder?.ToString(), search);
    }

    private bool MatchesFilter(NoticeScheduleDto schedule)
    {
        var today = DateTime.Today;
        return _statusFilter switch
        {
            "active" => schedule.StartDate.GetValueOrDefault(DateTime.MinValue).Date <= today &&
                (!schedule.EndDate.HasValue || schedule.EndDate.Value.Date >= today),
            "upcoming" => schedule.StartDate.HasValue && schedule.StartDate.Value.Date > today,
            "expired" => schedule.EndDate.HasValue && schedule.EndDate.Value.Date < today,
            "sorted" => schedule.SortOrder.HasValue,
            _ => true
        };
    }

    private static bool Contains(string? value, string search)
        => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
}
