@page "/notice-management"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Notice Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bell"></i>
            Notice Management
        </h1>
        <p class="page-description">Legacy notices. Static entries until notice API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadNotices">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading notices...</p>
        </div>
    }
    else if (_notices.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-bell"></i>
            <h3>No notices</h3>
            <p>Awaiting notice API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_notices.Count Notice(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Notice #</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th>Audience</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notice in _notices)
                        {
                            <tr>
                                <td>@notice.Number</td>
                                <td>@notice.Category</td>
                                <td><span class="badge">@notice.Status</span></td>
                                <td>@notice.Issued.ToString("yyyy-MM-dd")</td>
                                <td>@notice.Audience</td>
                                <td>@notice.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<NoticeItem> _notices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNotices();
    }

    private Task LoadNotices()
    {
        _loading = true;

        _notices =
        [
            new("NT-2401-001", "System", "Active", new DateTime(2025, 01, 12), "All Users", "Planned maintenance window."),
            new("NT-2401-002", "Policy", "Active", new DateTime(2025, 01, 10), "Drivers", "Updated trip authority policy."),
            new("NT-2312-006", "Alert", "Closed", new DateTime(2024, 12, 18), "Admins", "Completed incident review."),
            new("NT-2311-004", "System", "Closed", new DateTime(2024, 11, 25), "All Users", "Legacy notice reference.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record NoticeItem(string Number, string Category, string Status, DateTime Issued, string Audience, string Notes);
}
