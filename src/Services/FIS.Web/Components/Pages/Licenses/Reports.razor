@page "/licenses/reports"
@rendermode InteractiveServer
<PageTitle>Licence Reports - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Licence Reports Menu
        </h1>
        <p class="page-description">Licence reports grouped by category.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses">Back to Licence Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>One Licence Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/gg-number">1) Licence Report for a GG Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/gp-number">2) Licence Report for a Prov Reg Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/register-number">3) Licence Report for a Register Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/engine-number">4) Licence Report for an Engine Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/chassis-number">5) Licence Report for a Chassis Number</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/site">6) Licence Report for a Site</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>All Licence Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/all">7) Licence Report on ALL Vehicles</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Other Licence Reports</span>
                <i class="bx bx-list-ul"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/dept-period">8) Licences, for a Dept, with All Sites, for a period</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/expire-date">9) Report on Licence EXPIRE DATE</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/month-fees">10) Licences fees for a month</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/old-expire">11) Licences of "In Service" Vehicles, with OLD Expire Dates</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/sap">12) SAP Information</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/cof">13) COF Information</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/model-fees">14) table : Make &amp; Model with Licence Fee</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/gg-model-fees">15) All Vehicles with Make &amp; Model &amp; Tare &amp; Licence Fee</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/workgroup">16) Data Workgroup - Report for Each Or Group of Vehicle</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/workgroup-latest">17) Data Workgroup - Only Latest Report for Each Or Group of Vehicle</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/ggmt-received">18) Licence Received by GGMT : Receiver Name and Date</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/reports">Return To Main Page</a></div>
            </div>
        </div>
    </div>
</div>
