    private async Task SearchVehiclesAsync()
    {
        var query = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _filter.Identifier = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(query);
            _vehicleMatches = FilterVehicleMatchesForMode(matches, query, Mode);
            if (_vehicleMatches.All(x => x.vmf_code != _selectedVehicleVmfCode))
            {
                _selectedVehicleVmfCode = null;
                _filter.Identifier = null;
            }
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVehicleVmfCode = null;
            _filter.Identifier = null;
            await JS.InvokeVoidAsync("console.error", $"Error searching vehicles: {ex.Message}");
        }
    }

    private void ApplySelectedVehicleSelection()
    {
        var selected = _vehicleMatches.FirstOrDefault(x => x.vmf_code == _selectedVehicleVmfCode);
        _filter.Identifier = selected == null ? null : ResolveIdentifierForMode(selected);
    }

    private string ResolveIdentifierForMode(VehicleDto vehicle)
    {
        if (Mode == "gp-number" || Mode == "register-number")
        {
            return vehicle.registration_number ?? vehicle.fleet_number ?? vehicle.vmf_code.ToString();
        }

        return vehicle.fleet_number ?? vehicle.registration_number ?? vehicle.vmf_code.ToString();
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatchesForMode(List<VehicleDto> matches, string query, string? mode)
    {
        var normalizedMode = mode ?? string.Empty;
        var useRegistration = normalizedMode == "gp-number" || normalizedMode == "register-number";
        var useFleet = normalizedMode == "gg-number";

        return (useRegistration
            ? matches.Where(v => !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            : useFleet
                ? matches.Where(v => !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                : matches.Where(v =>
                    (!string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase))))
            .OrderByDescending(v => useRegistration
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : useFleet
                    ? string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase) || string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private sealed class LicenseReportFilter
    {
        public string? Identifier { get; set; }
        public string? DepartmentCode { get; set; }
        public DateTime? BeginDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int? Month { get; set; }
        public int? Year { get; set; }
        public DateTime? ExpireCutoff { get; set; }
        public int? ModelCode { get; set; }
        public string? GroupOrVehicle { get; set; }
        public string? DeptScope { get; set; }

        public object ToPayload() => new
        {
            identifier = Identifier,
            department_code = DepartmentCode,
            begin_date = BeginDate,
            end_date = EndDate,
            month = Month,
            year = Year,
            expire_cutoff = ExpireCutoff,
            model_code = ModelCode,
            group_or_vehicle = GroupOrVehicle,
            dept_scope = DeptScope
        };
    }
