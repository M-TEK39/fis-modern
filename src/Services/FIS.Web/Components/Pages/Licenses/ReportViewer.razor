@page "/licenses/reports/{Mode}"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject LicenseReportApiService ReportService
@inject ReferenceDataApiService ReferenceDataService
@inject LicenseFeeApiService LicenseFeeService
@inject DepartmentApiService DepartmentService
@inject VehicleApiService VehicleService
@inject IJSRuntime JS

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Licence report parameters and output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Back to Licence Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "gg-number" || Mode == "gp-number" || Mode == "register-number" || Mode == "engine-number" || Mode == "chassis-number")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Search Parameters</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">@GetLicenseLabel(Mode)</label>
                            @if (UsesVehicleLookupForIdentifier)
                            {
                                <div class="fis-input-group-compact">
                                    <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@GetLookupPlaceholder(Mode)" />
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                                </div>
                                <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode" @bind:after="ApplySelectedVehicleSelection" disabled="@(_vehicleMatches.Count == 0)">
                                    <option value="">Select vehicle...</option>
                                    @foreach (var vehicle in _vehicleMatches)
                                    {
                                        <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="form-input" @bind="_filter.Identifier" />
                            }
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadIdentifierReport" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_results.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="2">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var row = _results.FirstOrDefault() ?? new Dictionary<string, object>();
                                        @foreach (var field in LicenceDetailFields)
                                        {
                                            <tr>
                                                <td>@field</td>
                                                <td>@GetValue(row, field)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "site")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Site Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="_filter.DepartmentCode">
                                <option value="">All Departments</option>
                                @foreach (var department in _departments.OrderBy(d => d.department_description))
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadSiteReport" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceDeptPeriodColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "all")
            {
                <div class="form-section">
                    <h2 class="form-section-title">All Vehicles</h2>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadAllReport" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                    </div>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceAllColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceAllColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "dept-period" || Mode == "expire-date")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Dept Period</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Dept Scope</label>
                            <div class="form-grid">
                                <label class="form-label"><input type="radio" name="deptScope" value="ALL" @onchange="OnDeptScopeChanged" /> ALL Dept</label>
                                <label class="form-label"><input type="radio" name="deptScope" value="ONE" @onchange="OnDeptScopeChanged" checked /> Only ONE Dept</label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Dept</label>
                            <select class="form-select" @bind="_filter.DepartmentCode" disabled="@(_filter.DeptScope == "ALL")">
                                <option value="">All Departments</option>
                                @foreach (var department in _departments.OrderBy(d => d.department_description))
                                {
                                    <option value="@department.department_code">@($"{department.department_description} ({department.department_code})")</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Expire Begin Date</label>
                            <input type="date" class="form-input" @bind="_filter.BeginDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Expire End Date</label>
                            <input type="date" class="form-input" @bind="_filter.EndDate" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadDeptPeriodReport" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceDeptPeriodColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "month-fees")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Licence Fees for a Month</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Month</label>
                            <input class="form-input" @bind="_filter.Month" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Year</label>
                            <input class="form-input" @bind="_filter.Year" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadMonthFees" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Fees Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceMonthFeesColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceMonthFeesColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "old-expire")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Old Expire Dates</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Expire Date Cutoff</label>
                            <input type="date" class="form-input" @bind="_filter.ExpireCutoff" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadOldExpire" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceDeptPeriodColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "sap" || Mode == "cof")
            {
                <div class="form-section">
                    <h2 class="form-section-title">@(_pageTitle)</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">@GetLicenseLabel(Mode)</label>
                            <div class="fis-input-group-compact">
                                <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@GetLookupPlaceholder(Mode)" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                            </div>
                            <select class="form-select fis-mt-05" @bind="_selectedVehicleVmfCode" @bind:after="ApplySelectedVehicleSelection" disabled="@(_vehicleMatches.Count == 0)">
                                <option value="">Select vehicle...</option>
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadSapCof" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>GG Number</th>
                                        <th>Prov Reg Number</th>
                                        <th>Info</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(new[] { "GG Number", "Prov Reg Number", "Info", "Date" })
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "model-fees" || Mode == "gg-model-fees")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Model Fee Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Model</label>
                            <select class="form-select" @bind="_filter.ModelCode">
                                <option value="">Select Model</option>
                                @foreach (var model in _models)
                                {
                                    <option value="@model.model_code">@($"{model.model_name} ({model.model_code})")</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadModelFees" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceModelFeeColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceModelFeeColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "workgroup" || Mode == "workgroup-latest")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Workgroup Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Group or Vehicle</label>
                            <input class="form-input" @bind="_filter.GroupOrVehicle" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadWorkgroup" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceWorkgroupColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(LicenceWorkgroupColumns)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "ggmt-received")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Licence Received by GGMT</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">@GetLicenseLabel(Mode)</label>
                            <input class="form-input" @bind="_filter.Identifier" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="LoadGgmtReceived" disabled="@_loading">@(_loading ? "Loading..." : "Submit")</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>GG Number</th>
                                        <th>Receiver Name</th>
                                        <th>Received Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @RenderRows(new[] { "GG Number", "Receiver Name", "Received Date" })
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">Use the filters above to run and review licence report output.</p>
            }
        </div>
    </div>
    @if (UsesPagedRows && _results.Count > 0 && TotalPages > 1)
    {
        <div class="pagination-controls">
            <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <span>Page @_page of @TotalPages</span>
            <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Licence Report";
    private bool _loading;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<Dictionary<string, object>> _results = new();
    private IEnumerable<Dictionary<string, object>> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));
    private LicenseReportFilter _filter = new();
    private List<ModelDto> _models = new();
    private List<LicenseFeeDto> _licenseFees = new();
    private List<DepartmentDto> _departments = new();
    private List<VehicleDto> _vehicleMatches = new();
    private string _vehicleSearchTerm = string.Empty;
    private int? _selectedVehicleVmfCode;
    private bool UsesPagedRows =>
        Mode is "site" or "all" or "dept-period" or "expire-date" or "month-fees" or "old-expire" or "sap" or "cof" or "model-fees" or "gg-model-fees" or "workgroup" or "workgroup-latest" or "ggmt-received";
    private bool UsesVehicleLookupForIdentifier =>
        Mode is "gg-number" or "gp-number" or "register-number" or "sap" or "cof" or "ggmt-received";

    protected override async Task OnInitializedAsync()
    {
        _models = await ReferenceDataService.GetModelsAsync();
        _licenseFees = await LicenseFeeService.GetAllAsync();
        _departments = await DepartmentService.GetDepartmentsAsync();
    }

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "gg-number" => "Licence Report for a GG Number",
            "gp-number" => "Licence Report for a Prov Reg Number",
            "register-number" => "Licence Report for a Register Number",
            "engine-number" => "Licence Report for an Engine Number",
            "chassis-number" => "Licence Report for a Chassis Number",
            "site" => "Licence Report for a Site",
            "all" => "Licence Report on ALL Vehicles",
            "dept-period" => "Licences, for a Dept, with All Sites, for a period",
            "expire-date" => "Report on Licence EXPIRE DATE",
            "month-fees" => "Licences fees for a month",
            "old-expire" => "Licences of In Service Vehicles, with OLD Expire Dates",
            "sap" => "SAP Information",
            "cof" => "COF Information",
            "model-fees" => "table : Make & Model with Licence Fee",
            "gg-model-fees" => "All Vehicles with Make & Model & Tare & Licence Fee",
            "workgroup" => "Data Workgroup - Report for Each Or Group of Vehicle",
            "workgroup-latest" => "Data Workgroup - Only Latest Report for Each Or Group of Vehicle",
            "ggmt-received" => "Licence Received by GGMT : Receiver Name and Date",
            _ => "Licence Report"
        };
        _results = new();
        _vehicleMatches = new();
        _vehicleSearchTerm = string.Empty;
        _selectedVehicleVmfCode = null;
    }

    private async Task LoadIdentifierReport() =>
        await LoadReport(() => ReportService.GetByIdentifierAsync<Dictionary<string, object>>(Mode ?? string.Empty, _filter.ToPayload()));

    private async Task LoadSiteReport() =>
        await LoadReport(() => ReportService.GetSiteAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadAllReport() =>
        await LoadReport(() => ReportService.GetAllAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadDeptPeriodReport()
    {
        if (Mode == "expire-date")
        {
            await LoadReport(() => ReportService.GetExpireDateAsync<Dictionary<string, object>>(_filter.ToPayload()));
            return;
        }

        await LoadReport(() => ReportService.GetDeptPeriodAsync<Dictionary<string, object>>(_filter.ToPayload()));
    }

    private async Task LoadMonthFees() =>
        await LoadReport(() => ReportService.GetMonthFeesAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadOldExpire() =>
        await LoadReport(() => ReportService.GetOldExpireAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadSapCof()
    {
        if (Mode == "sap")
        {
            await LoadReport(() => ReportService.GetSapAsync<Dictionary<string, object>>(_filter.ToPayload()));
            return;
        }

        await LoadReport(() => ReportService.GetCofAsync<Dictionary<string, object>>(_filter.ToPayload()));
    }

    private async Task LoadModelFees()
    {
        if (Mode == "gg-model-fees")
        {
            await LoadReport(() => ReportService.GetGgModelFeesAsync<Dictionary<string, object>>(_filter.ToPayload()));
            return;
        }

        await LoadReport(() => ReportService.GetModelFeesAsync<Dictionary<string, object>>(_filter.ToPayload()));
    }

    private async Task LoadWorkgroup()
    {
        if (Mode == "workgroup-latest")
        {
            await LoadReport(() => ReportService.GetWorkgroupLatestAsync<Dictionary<string, object>>(_filter.ToPayload()));
            return;
        }

        await LoadReport(() => ReportService.GetWorkgroupAsync<Dictionary<string, object>>(_filter.ToPayload()));
    }

    private async Task LoadGgmtReceived() =>
        await LoadReport(() => ReportService.GetGgmtReceivedAsync<Dictionary<string, object>>(_filter.ToPayload()));

    private async Task LoadReport(Func<Task<List<Dictionary<string, object>>>> loader)
    {
        _loading = true;
        try
        {
            _results = await loader();
            _page = 1;
        }
        catch (Exception ex)
        {
            _results = new();
            await JS.InvokeVoidAsync("console.error", $"Error loading licence report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment RenderRows(string[] columns) => builder =>
    {
        if (_results.Count == 0)
        {
            builder.OpenElement(0, "tr");
            builder.OpenElement(1, "td");
            builder.AddAttribute(2, "colspan", columns.Length.ToString());
            builder.AddContent(3, "No records found.");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        var rowIndex = 0;
        foreach (var row in PagedResults)
        {
            builder.OpenElement(10 + rowIndex, "tr");
            var columnIndex = 0;
            foreach (var column in columns)
            {
                builder.OpenElement(100 + columnIndex, "td");
                builder.AddContent(101 + columnIndex, GetValue(row, column));
                builder.CloseElement();
                columnIndex++;
            }
            builder.CloseElement();
            rowIndex++;
        }
    };

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string GetValue(Dictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var value) && value != null)
        {
            return value.ToString() ?? "-";
        }

        return "-";
    }

    private void OnDeptScopeChanged(ChangeEventArgs args)
    {
        _filter.DeptScope = args.Value?.ToString() ?? "ONE";
    }

    private static readonly string[] LicenceDetailFields =
    {
        "Prov Reg Number",
        "GG Number",
        "Garage",
        "Status",
        "Hire Type",
        "Register Number",
        "Register Doc",
        "Licence Fee",
        "Licence Description",
        "Licence Exp Date",
        "Receiver",
        "Receiver ID",
        "Receiver Tel",
        "Receiver Site",
        "Date Collected",
        "COF Required",
        "COF Last Done",
        "COF Exp Date",
        "COF Amount",
        "Comments"
    };

    private static readonly string[] LicenceDeptPeriodColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Make & Model",
        "Licence Exp Date",
        "Receiver",
        "Receiver ID",
        "Receiver Tel",
        "Date Taken",
        "Dept / Site"
    };

    private static readonly string[] LicenceAllColumns =
    {
        "Counter",
        "GG Number",
        "Prov Reg Number",
