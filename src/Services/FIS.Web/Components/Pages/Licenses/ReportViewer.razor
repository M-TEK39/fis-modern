@page "/licenses/reports/{Mode}"
@rendermode InteractiveServer

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Legacy licence report parameters and output.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Back to Licence Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            @if (Mode == "gg-number" || Mode == "gp-number" || Mode == "register-number" || Mode == "engine-number" || Mode == "chassis-number")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Search Parameters</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">@GetLicenseLabel(Mode)</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in LicenceDetailFields)
                                    {
                                        <tr>
                                            <td>@field</td>
                                            <td>@GetLicenceSampleValue(field)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "site")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Site Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Dept Code</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Report Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0001</td>
                                        <td>GG12345</td>
                                        <td>Make X / Model A</td>
                                        <td>2024/05/31</td>
                                        <td>S. Molefe</td>
                                        <td>8001015009087</td>
                                        <td>011-555-1234</td>
                                        <td>2024/04/15</td>
                                        <td>FIN-01</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "all")
            {
                <div class="form-section">
                    <h2 class="form-section-title">All Vehicles</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceAllColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>GG90001</td>
                                        <td>GPA-0101</td>
                                        <td>Garage Central</td>
                                        <td>Pool</td>
                                        <td>Active</td>
                                        <td>REG-100</td>
                                        <td>REG-100</td>
                                        <td>VIN-123456</td>
                                        <td>ENG-7890</td>
                                        <td>Make Y</td>
                                        <td>Class 01</td>
                                        <td>Class A</td>
                                        <td>VEMM-001</td>
                                        <td>2.4L</td>
                                        <td>1200</td>
                                        <td>4750</td>
                                        <td>2024/06/30</td>
                                        <td>2024</td>
                                        <td>Blue</td>
                                        <td>GovFleet</td>
                                        <td>2023/07/15</td>
                                        <td>1,200,000</td>
                                        <td>Yes</td>
                                        <td>Extra Tank</td>
                                        <td>Notes about vehicle</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "dept-period" || Mode == "expire-date")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Dept Period</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Dept Scope</label>
                            <div class="form-grid">
                                <label class="form-label"><input type="radio" name="deptScope" /> ALL Dept</label>
                                <label class="form-label"><input type="radio" name="deptScope" checked /> Only ONE Dept</label>
                            </div>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Dept</label>
                            <select class="form-select">
                                <option>Select Dept</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Expire Begin Date</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Expire End Date</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Licence Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0505</td>
                                        <td>GG40201</td>
                                        <td>Make Z / Model C</td>
                                        <td>2024/04/30</td>
                                        <td>T. van der Merwe</td>
                                        <td>8010109009088</td>
                                        <td>011-555-3344</td>
                                        <td>2024/04/10</td>
                                        <td>OPS-02</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "month-fees")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Licence Fees for a Month</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Month</label>
                            <input class="form-input" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Year</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                    <div class="form-section">
                        <h2 class="form-section-title">Licence Fees Output</h2>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            @foreach (var column in LicenceMonthFeesColumns)
                                            {
                                                <th>@column</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>GPA-0110</td>
                                            <td>GG77777</td>
                                            <td>REG-123</td>
                                            <td>1500</td>
                                            <td>2024/07/31</td>
                                            <td>011-555-2222</td>
                                            <td>OPS-03</td>
                                            <td>Y</td>
                                            <td>2024/06/15</td>
                                            <td>Active</td>
                                            <td>Garage North</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            }
            else if (Mode == "old-expire")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Old Expire Dates</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Expire Date Cutoff</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceDeptPeriodColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GPA-0333</td>
                                        <td>GG64532</td>
                                        <td>Make A / Model D</td>
                                        <td>2021/12/31</td>
                                        <td>H. Nkosi</td>
                                        <td>8101015009089</td>
                                        <td>011-555-8790</td>
                                        <td>2021/11/10</td>
                                        <td>Region 04</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "sap" || Mode == "cof")
            {
                <div class="form-section">
                    <h2 class="form-section-title">@(_pageTitle)</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">GG Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>GG Number</th>
                                        <th>Prov Reg Number</th>
                                        <th>Info</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GG33445</td>
                                        <td>GPA-0344</td>
                                        <td>@(Mode == "sap" ? "SAP Field" : "COF Field")</td>
                                        <td>2024/03/01</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "model-fees" || Mode == "gg-model-fees")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Model Fee Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Model</label>
                            <select class="form-select">
                                <option>Select Model</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceModelFeeColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Class 01</td>
                                        <td>Make X</td>
                                        <td>Model A</td>
                                        <td>GG12345</td>
                                        <td>1200</td>
                                        <td>Licence Description</td>
                                        <td>1500</td>
                                        <td>.Active</td>
                                        <td>Garage South</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "workgroup" || Mode == "workgroup-latest")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Workgroup Report</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Group or Vehicle</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in LicenceWorkgroupColumns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Fleet Engineer</td>
                                        <td>GG22110</td>
                                        <td>GPA-0221</td>
                                        <td>GG00010</td>
                                        <td>GG99999</td>
                                        <td>Active</td>
                                        <td>2024/02/01</td>
                                        <td>REG-777</td>
                                        <td>REG-777</td>
                                        <td>VIN-555</td>
                                        <td>2024/03/01</td>
                                        <td>GG00001</td>
                                        <td>GG33333</td>
                                        <td>GG44444</td>
                                        <td>2024/01/15</td>
                                        <td>2024/01/20</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (Mode == "ggmt-received")
            {
                <div class="form-section">
                    <h2 class="form-section-title">Licence Received by GGMT</h2>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">GG Number</label>
                            <input class="form-input" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a class="btn btn-secondary btn-sm" href="/licenses/reports">Menu</a>
                    </div>
                </div>
                <div class="form-section">
                    <h2 class="form-section-title">Report Output</h2>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>GG Number</th>
                                        <th>Receiver Name</th>
                                        <th>Received Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>GG10001</td>
                                        <td>J. Dlamini</td>
                                        <td>2024/01/12</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="form-hint">This report screen will be aligned to the legacy report parameters and output tables.</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Licence Report";

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "gg-number" => "Licence Report for a GG Number",
            "gp-number" => "Licence Report for a Prov Reg Number",
            "register-number" => "Licence Report for a Register Number",
            "engine-number" => "Licence Report for an Engine Number",
            "chassis-number" => "Licence Report for a Chassis Number",
            "site" => "Licence Report for a Site",
            "all" => "Licence Report on ALL Vehicles",
            "dept-period" => "Licences, for a Dept, with All Sites, for a period",
            "expire-date" => "Report on Licence EXPIRE DATE",
            "month-fees" => "Licences fees for a month",
            "old-expire" => "Licences of In Service Vehicles, with OLD Expire Dates",
            "sap" => "SAP Information",
            "cof" => "COF Information",
            "model-fees" => "table : Make & Model with Licence Fee",
            "gg-model-fees" => "All Vehicles with Make & Model & Tare & Licence Fee",
            "workgroup" => "Data Workgroup - Report for Each Or Group of Vehicle",
            "workgroup-latest" => "Data Workgroup - Only Latest Report for Each Or Group of Vehicle",
            "ggmt-received" => "Licence Received by GGMT : Receiver Name and Date",
            _ => "Licence Report"
        };
    }

    private static readonly string[] LicenceDetailFields =
    {
        "Prov Reg Number",
        "GG Number",
        "Garage",
        "Status",
        "Hire Type",
        "Register Number",
        "Register Doc",
        "Licence Fee",
        "Licence Description",
        "Licence Exp Date",
        "Receiver",
        "Receiver ID",
        "Receiver Tel",
        "Receiver Site",
        "Date Collected",
        "COF Required",
        "COF Last Done",
        "COF Exp Date",
        "COF Amount",
        "Comments"
    };

    private static readonly string[] LicenceDeptPeriodColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Make & Model",
        "Licence Exp Date",
        "Receiver",
        "Receiver ID",
        "Receiver Tel",
        "Date Taken",
        "Dept / Site"
    };

    private static readonly string[] LicenceAllColumns =
    {
        "Counter",
        "GG Number",
        "Prov Reg Number",
        "Garage",
        "Hire Type",
        "Status",
        "Reg Doc",
        "Register Num",
        "VIN",
        "Engine Num",
        "Make & Serie",
        "Class Code",
        "Class",
        "Vemm Code",
        "Engine Cap",
        "Tare",
        "GVM",
        "Cof Date",
        "Licence Exp Date",
        "Year Model",
        "Color",
        "Purch From",
        "Purch Date",
        "Purch Amount",
        "Canopy",
        "Add Tank",
        "Notes"
    };

    private static readonly string[] LicenceMonthFeesColumns =
    {
        "Prov Reg Number",
        "GG Number",
        "Register Number",
        "Licence Fee",
        "Licence Exp Date",
        "Receiver Tel",
        "Receiver Site",
        "COF",
        "Cof Date",
        "Status",
        "Garage"
    };

    private static readonly string[] LicenceModelFeeColumns =
    {
        "Class Code",
        "Make",
        "Model",
        "GG Num",
        "Tare",
        "Licence Description",
        "Licence Fee",
        "Status",
        "Garage"
    };

    private static readonly string[] LicenceWorkgroupColumns =
    {
        "Responsible Person",
        "GG Number",
        "Prov Reg Number",
        "Renumbered GG",
        "Recovered GG",
        "Status",
        "Status Date",
        "Register Doc",
        "Vehicle Register Number",
        "VIN (Chassis No)",
        "Update Date",
        "Previous GG",
        "Followup GG",
        "Renumbered To",
        "Date Reported SAPD",
        "Date Reported GGMT"
    };

    private static string GetLicenseLabel(string? mode) =>
        mode switch
        {
            "gg-number" => "GG Number",
            "gp-number" => "Prov Reg Number",
            "register-number" => "Register Number",
            "engine-number" => "Engine Number",
            "chassis-number" => "Chassis Number",
            _ => "Number"
        };

    private static string GetLicenceSampleValue(string field) =>
        field switch
        {
            "Prov Reg Number" => "GPA-0001",
            "GG Number" => "GG12345",
            "Garage" => "Garage Central",
            "Status" => "Active",
            "Hire Type" => "Pool",
            "Register Number" => "REG-889",
            "Register Doc" => "DOC-587",
            "Licence Fee" => "1200",
            "Licence Description" => "Annual Licence",
            "Licence Exp Date" => "2024/05/31",
            "Receiver" => "S. Molefe",
            "Receiver ID" => "8001015009087",
            "Receiver Tel" => "011-555-1234",
            "Receiver Site" => "FIN-01",
            "Date Collected" => "2024/04/15",
            "COF Required" => "Y",
            "COF Last Done" => "2024/02/28",
            "COF Exp Date" => "2024/12/31",
            "COF Amount" => "450",
            "Comments" => "Licence on hand",
            "Tare" => "1200",
            _ => "-"
        };
}
