@page "/licenses"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject IJSRuntime JS

<PageTitle>Licenses - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-user-badge"></i>
            Licenses
        </h1>
        <p class="page-description">Manage license types used for vehicle and driver requirements.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadLicenses">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading licenses...</p>
        </div>
    }
    else if (_licenses.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bxs-user-badge"></i>
            <h3>No licenses found</h3>
            <p>Get started by adding your first license type.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_licenses.Count License(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>License Code</th>
                            <th>Description</th>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var license in _licenses)
                        {
                            <tr>
                                <td>@license.licence_code</td>
                                <td>@license.licence_description</td>
                                <td>@(string.IsNullOrWhiteSpace(license.licence_category) ? "-" : license.licence_category)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@inject LicenseApiService LicenseService

@code {
    private bool _loading = true;
    private List<LicenseTypeDto> _licenses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLicenses();
    }

    private async Task LoadLicenses()
    {
        _loading = true;

        try
        {
            _licenses = await LicenseService.GetAllAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading licenses: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
