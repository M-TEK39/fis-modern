@page "/licenses"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LicenseApiService LicenseService
@inject IJSRuntime JSRuntime

<PageTitle>Licences - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-user-badge"></i>
            Licence Maintenance Menu
        </h1>
        <p class="page-description">Licence maintenance workflows.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Licence Maintenance</span>
                <i class="bx bx-wrench"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><span class="menu-item-link">Licence Maintenance Information / Help</span></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/one-vehicle">1) Licence Maintenance for ONE Vehicle</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/multi-collection">2) Collection for TWO or MORE Licences</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/garage">3) Licence Available at Garage</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Other Licence Options</span>
                <i class="bx bx-layer"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/licenses/model-fees">4) Table : Make &amp; Model with Licence Fees</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/scan-certificate">5) Scan Licence Certificate</a></div>
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports/workgroup-latest">6) Workgroup Report</a></div>
            </div>
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header">
                <span>Licence Reports</span>
                <i class="bx bx-file"></i>
            </button>
            <div class="menu-tile-body">
                <div class="menu-item"><a class="menu-item-link" href="/licenses/reports">Licence Reports Menu</a></div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Licence Type Preview"
                      SearchPlaceholder="Search licence code, description, category..."
                      EmptyMessage="No licence types match the current search or filter."
                      EmptyIcon="bx bxs-user-badge"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("code", "Code"),
        new("description", "Description"),
        new("category", "Category")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Categorised licences", "categoryStatus", "Category Captured"),
        new("Uncategorised licences", "categoryStatus", "No Category")
    ];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var licences = await LicenseService.GetAllAsync();
            _rows = licences
                .OrderBy(item => item.licence_description)
                .Select(item => new Dictionary<string, string?>
                {
                    ["code"] = item.licence_code.ToString(),
                    ["description"] = item.licence_description,
                    ["category"] = item.licence_category,
                    ["categoryStatus"] = string.IsNullOrWhiteSpace(item.licence_category) ? "No Category" : "Category Captured",
                    ["_href"] = "/reference-data?tab=licenses"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading licence preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
