@page "/licenses/scan-certificate"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Scan Licence Certificate</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-scan"></i>
            Scan Licence Certificate
        </h1>
        <p class="page-description">Legacy scan certificate menu.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses">Back to Licence Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Scan licence certificate workflow will be aligned to legacy ScanDocs screens.</p>
            <LegacyEndpointActionPanel
                LegacyPath="ScanDocs/LicCert_Menu.aspx"
                Endpoint="api/license/scan-certificate"
                HttpMethod="POST"
                ButtonText="Run Scan Licence API"
                ReportType="licenses-scan-certificate" />
        </div>
    </div>
</div>
