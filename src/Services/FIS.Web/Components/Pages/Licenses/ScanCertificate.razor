@page "/licenses/scan-certificate"
@rendermode InteractiveServer
<PageTitle>Scan Licence Certificate</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-scan"></i>
            Scan Licence Certificate
        </h1>
        <p class="page-description">Scan certificate menu.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses">Back to Licence Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Use this screen to scan and attach licence certificate documents.</p>
        </div>
    </div>
</div>
