@page "/licenses/model-fees"
@rendermode InteractiveServer

<PageTitle>Licence Fees Maintenance</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            Licence Fees Maintenance
        </h1>
        <p class="page-description">Assign licence fees to make and model.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses">Back to Licence Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Model Selection</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Model Description</label>
                        <select class="form-select">
                            <option>Select Model</option>
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm">Submit</button>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Licence Description</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Make Description</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Model Description</label>
                        <input class="form-input" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Description</label>
                        <select class="form-select">
                            <option>Select Licence Description</option>
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm">Submit</button>
                    <a class="btn btn-secondary btn-sm" href="/licenses">Menu</a>
                </div>
            </div>
        </div>
    </div>
</div>
