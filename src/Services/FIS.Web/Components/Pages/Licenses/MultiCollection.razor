@page "/licenses/multi-collection"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject LicenseMaintenanceApiService LicenseMaintenanceService
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject IJSRuntime JS

<PageTitle>Collection for Two or More Licences</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-group"></i>
            Collection for TWO or MORE Licences
        </h1>
        <p class="page-description">Workflow for bulk licence collection.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/licenses">Back to Licence Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-section">
                <h2 class="form-section-title">Password</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-input" @bind="_password" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SubmitPassword" disabled="@_passwordSubmitting">
                        @(_passwordSubmitting ? "Submitting..." : "Submit")
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/licenses">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Receiver Details</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Receiver Name</label>
                        <input class="form-input" @bind="_receiverName" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID Number</label>
                        <input class="form-input" @bind="_receiverId" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Tel Number</label>
                        <input class="form-input" @bind="_receiverTel" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Date Collected</label>
                        <input type="date" class="form-input" @bind="_dateCollected" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveReceiver" disabled="@_receiverSubmitting">
                        @(_receiverSubmitting ? "Saving..." : "Submit")
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/licenses">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Vehicle Number</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="multiVehicleType" value="GG" @onchange="OnNumberTypeChanged" checked="@(_numberType == "GG")" />
                            GG
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">
                            <input type="radio" name="multiVehicleType" value="GP" @onchange="OnNumberTypeChanged" checked="@(_numberType == "GP")" />
                            GP
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">@(_numberType == "GG" ? "GG Number" : "GP Number")</label>
                        <input class="form-input" @bind="_vehicleNumber" placeholder="@(_numberType == "GG" ? "Enter GG number" : "Enter GP number")" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="LookupVehicle" disabled="@_loading">
                        @(_loading ? "Loading..." : "Submit")
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/licenses">Main Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Licence Details</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Exp Date</label>
                        <input type="date" class="form-input" @bind="_details.ExpDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Register Num</label>
                        <input class="form-input" @bind="_details.RegisterNumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Reg Doc</label>
                        <input class="form-input" @bind="_details.RegDoc" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Tare</label>
                        <input class="form-input" @bind="_details.Tare" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Receiver</label>
                        <input class="form-input" @bind="_details.Receiver" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Rec ID</label>
                        <input class="form-input" @bind="_details.ReceiverId" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Rec Tel</label>
                        <input class="form-input" @bind="_details.ReceiverTel" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Rec Site</label>
                        <select class="form-select" @bind="_details.ReceiverSiteCode">
                            <option value="">Select site</option>
                            @foreach (var site in _sites.OrderBy(s => s.Description))
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Date Taken</label>
                        <input type="date" class="form-input" @bind="_details.DateCollected" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Cof Required</label>
                        <input class="form-input" @bind="_details.CofRequired" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Cof Exp Date</label>
                        <input type="date" class="form-input" @bind="_details.CofExpDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Comments</label>
                        <input class="form-input" @bind="_details.Comments" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveDetails" disabled="@_saving">
                        @(_saving ? "Saving..." : "Submit")
                    </button>
                    <a class="btn btn-secondary btn-sm" href="/licenses">Menu</a>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Licence History</h2>

                @if (_selectedVmfCode is null)
                {
                    <p class="page-description">Search a vehicle first to view historical licence captures.</p>
                }
                else if (_licenceHistory.Count == 0)
                {
                    <p class="page-description">No licence history found for this vehicle yet.</p>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Captured At</th>
                                    <th>Due Date</th>
                                    <th>Register Number</th>
                                    <th>Reg Doc</th>
                                    <th>COF Date</th>
                                    <th>Receiver</th>
                                    <th>Receiver ID</th>
                                    <th>Receiver Tel</th>
                                    <th>Captured By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedHistory)
                                {
                                    <tr>
                                        <td>@FormatDateTime(row.captured_at)</td>
                                        <td>@FormatDate(row.licence_due_date)</td>
                                        <td>@(row.lic_register_number ?? "-")</td>
                                        <td>@(row.lic_registration_doc ?? "-")</td>
                                        <td>@FormatDate(row.cof_last_done)</td>
                                        <td>@(row.Licence_receiver ?? "-")</td>
                                        <td>@(row.Licence_receiver_id ?? "-")</td>
                                        <td>@(row.Licence_receiver_tel ?? "-")</td>
                                        <td>@(row.captured_by_user_email ?? "-")</td>
                                        <td>@(row.update_notes ?? row.licence_comments ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination">
                        <button class="pagination-btn"
                                @onclick="PreviousHistoryPage"
                                disabled="@(_historyPage <= 1)">
                            Previous
                        </button>
                        <span class="pagination-info">Page @_historyPage of @TotalHistoryPages</span>
                        <button class="pagination-btn"
                                @onclick="NextHistoryPage"
                                disabled="@(_historyPage >= TotalHistoryPages)">
                            Next
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _password = string.Empty;
    private bool _passwordSubmitting;
    private bool _receiverSubmitting;
    private string _receiverName = string.Empty;
    private string _receiverId = string.Empty;
    private string _receiverTel = string.Empty;
    private DateTime? _dateCollected;
    private string _numberType = "GG";
    private string _vehicleNumber = string.Empty;
    private bool _loading;
    private bool _saving;
    private List<SiteResponseDto> _sites = new();
    private MultiCollectionDetails _details = new();
    private int? _selectedVmfCode;
    private List<VehicleLicenceHistoryEntryDto> _licenceHistory = new();
    private int _historyPage = 1;
    private const int _historyPageSize = 12;
    private IEnumerable<VehicleLicenceHistoryEntryDto> PagedHistory => _licenceHistory
        .Skip((_historyPage - 1) * _historyPageSize)
        .Take(_historyPageSize);
    private int TotalHistoryPages => Math.Max(1, (int)Math.Ceiling(_licenceHistory.Count / (double)_historyPageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task SubmitPassword()
    {
        _passwordSubmitting = true;
        try
        {
            await LicenseMaintenanceService.SubmitPasswordAsync("api/license/multi-collection/password", _password);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error submitting password: {ex.Message}");
        }
        finally
        {
            _passwordSubmitting = false;
        }
    }

    private async Task SaveReceiver()
    {
        _receiverSubmitting = true;
        try
        {
            var payload = new
            {
                receiver_name = _receiverName,
                receiver_id = _receiverId,
                receiver_tel = _receiverTel,
                date_collected = _dateCollected
            };
            await LicenseMaintenanceService.SubmitAsync<object>("api/license/multi-collection/receiver", payload);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error saving receiver: {ex.Message}");
        }
        finally
        {
            _receiverSubmitting = false;
        }
    }

    private async Task LookupVehicle()
    {
        _loading = true;
        try
        {
            var payload = new
            {
                number_type = _numberType,
                number = _vehicleNumber
            };
            var response = await LicenseMaintenanceService.SubmitAsync<MultiCollectionDetails>("api/license/multi-collection/lookup", payload);
            _details = response ?? new MultiCollectionDetails();
            _selectedVmfCode = await ResolveVehicleVmfCodeAsync();
            await LoadLicenceHistoryAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading licence details: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveDetails()
    {
        _saving = true;
        try
        {
            await LicenseMaintenanceService.SubmitAsync<object>("api/license/multi-collection/save", _details);
            await LoadLicenceHistoryAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error saving licence details: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnNumberTypeChanged(ChangeEventArgs args)
    {
        _numberType = args.Value?.ToString() ?? "GG";
        _vehicleNumber = string.Empty;
        _details = new();
        _selectedVmfCode = null;
        _licenceHistory = new();
        _historyPage = 1;
    }

    private async Task<int?> ResolveVehicleVmfCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_vehicleNumber))
        {
            return null;
        }

        var matches = await VehicleService.SearchVehiclesAsync(_vehicleNumber.Trim());
        if (_numberType == "GG")
        {
            return matches.FirstOrDefault(v =>
                string.Equals(v.fleet_number?.Trim(), _vehicleNumber.Trim(), StringComparison.OrdinalIgnoreCase))?.vmf_code;
        }

        return matches.FirstOrDefault(v =>
            string.Equals(v.registration_number?.Trim(), _vehicleNumber.Trim(), StringComparison.OrdinalIgnoreCase))?.vmf_code;
    }

    private async Task LoadLicenceHistoryAsync()
    {
        if (_selectedVmfCode is null)
        {
            _licenceHistory = new();
            _historyPage = 1;
            return;
        }

        var result = await VehicleService.GetVehicleLicenceHistoryAsync(_selectedVmfCode.Value);
        _licenceHistory = result.history
            .OrderByDescending(h => h.captured_at)
            .ToList();
        _historyPage = 1;
    }

    private void NextHistoryPage()
    {
        if (_historyPage < TotalHistoryPages)
        {
            _historyPage++;
        }
    }

    private void PreviousHistoryPage()
    {
        if (_historyPage > 1)
        {
            _historyPage--;
        }
    }

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string FormatDateTime(DateTime value) =>
        value.ToString("yyyy-MM-dd HH:mm");

    private sealed class MultiCollectionDetails
    {
        public DateTime? ExpDate { get; set; }
        public string? RegisterNumber { get; set; }
        public string? RegDoc { get; set; }
        public string? Tare { get; set; }
        public string? Receiver { get; set; }
        public string? ReceiverId { get; set; }
        public string? ReceiverTel { get; set; }
        public short? ReceiverSiteCode { get; set; }
        public DateTime? DateCollected { get; set; }
        public string? CofRequired { get; set; }
        public DateTime? CofExpDate { get; set; }
        public string? Comments { get; set; }
    }
}
