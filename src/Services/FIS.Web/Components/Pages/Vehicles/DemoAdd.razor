@page "/vehicles/demo/add"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Models
@using FIS.Web.Services
@inject HttpClient Http
@inject SiteApiService SiteService
@inject ReferenceDataApiService ReferenceDataService
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Add Demo Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-plus-circle"></i> Add Demo Vehicle</h1>
        <p class="page-description">Capture new demo vehicle details.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field"><label class="form-label">GG number</label><input class="form-input" @bind="_item.gg_number" /></div>
                <div class="form-field"><label class="form-label">Prov. Registration number</label><input class="form-input" @bind="_item.reg_number" /></div>
                <div class="form-field">
                    <label class="form-label">Make</label>
                    <select class="form-select" @bind="_selectedMakeCode" @bind:after="OnMakeChangedAsync">
                        <option value="">Select make...</option>
                        @foreach (var make in _makes.OrderBy(m => m.make_name))
                        {
                            <option value="@make.make_code">@($"{make.make_name} ({make.make_code})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Model</label>
                    <select class="form-select" @bind="_selectedModelCode" @bind:after="OnModelChanged" disabled="@(_models.Count == 0)">
                        <option value="">Select model...</option>
                        @foreach (var model in _models.OrderBy(m => m.model_name))
                        {
                            <option value="@model.model_code">@($"{model.model_name} ({model.model_code})")</option>
                        }
                    </select>
                </div>
                <div class="form-field"><label class="form-label">Site</label><select class="form-select" @bind="_item.site_code"><option value="">Select...</option>@foreach (var s in _sites){<option value="@s.SiteCode">@($"{s.Description} ({s.SiteCode})")</option>}</select></div>
                <div class="form-field"><label class="form-label">Year Manufactured</label><input class="form-input" @bind="_item.year_mnf" /></div>
                <div class="form-field"><label class="form-label">Bank ID</label><input class="form-input" @bind="_item.bank_code" /></div>
                <div class="form-field"><label class="form-label">Colour</label><input class="form-input" @bind="_item.colour" /></div>
                <div class="form-field"><label class="form-label">Tank Capacity</label><input class="form-input" @bind="_item.tank" /></div>
                <div class="form-field"><label class="form-label">Engine number</label><input class="form-input" @bind="_item.engine_number" /></div>
                <div class="form-field"><label class="form-label">Chassis number</label><input class="form-input" @bind="_item.chassis_number" /></div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_saving">Submit</button>
            </div>
        </div>
    </div>
</div>

@code {
    private DemoVehicleDto _item = new();
    private bool _saving;
    private List<SiteResponseDto> _sites = new();
    private List<MakeDto> _makes = new();
    private List<ModelDto> _models = new();
    private int? _selectedMakeCode;
    private int? _selectedModelCode;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _makes = await ReferenceDataService.GetMakesAsync();
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        try
        {
            AddAuthHeader();
            var response = await Http.PostAsJsonAsync("api/demo-vehicles", _item);
            if (!response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Add demo vehicle failed: {(int)response.StatusCode}");
            }
            else
            {
                _item = new DemoVehicleDto();
                _selectedMakeCode = null;
                _selectedModelCode = null;
                _models = new();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
        {
            return;
        }

        Http.DefaultRequestHeaders.Remove("Cookie");
        Http.DefaultRequestHeaders.TryAddWithoutValidation("Cookie", $"FIS_Access_Token={TokenService.Token}");
    }

    private async Task OnMakeChangedAsync()
    {
        _selectedModelCode = null;
        _item.model_description = string.Empty;
        _models = _selectedMakeCode.HasValue && _selectedMakeCode.Value > 0
            ? await ReferenceDataService.GetModelsByMakeAsync(_selectedMakeCode.Value)
            : new List<ModelDto>();
    }

    private void OnModelChanged()
    {
        var selected = _models.FirstOrDefault(m => m.model_code == _selectedModelCode);
        _item.model_description = selected?.model_name ?? string.Empty;
    }

    private sealed class DemoVehicleDto
    {
        public int demo_vehicle_code { get; set; }
        public string gg_number { get; set; } = string.Empty;
        public string reg_number { get; set; } = string.Empty;
        public string model_description { get; set; } = string.Empty;
        public short? site_code { get; set; }
        public string year_mnf { get; set; } = string.Empty;
        public string bank_code { get; set; } = string.Empty;
        public string colour { get; set; } = string.Empty;
        public string tank { get; set; } = string.Empty;
        public string engine_number { get; set; } = string.Empty;
        public string chassis_number { get; set; } = string.Empty;
    }
}
