@page "/vehicles/demo/delete"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Services
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Delete Demo Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-trash"></i> Delete Demo Vehicle</h1>
        <p class="page-description">Search and delete demo vehicle records.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Lookup Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="demoDeleteSearchType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="demoDeleteSearchType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                    <input class="form-input" @bind="_searchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchAsync">Find</button>
            </div>
        </div>
    </div>

    @if (_matches.Count > 0)
    {
        <div class="table-container fis-mt-1">
            <div class="table-header">
                <span class="table-title">@_matches.Count match(es)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Reg Number</th>
                            <th>Model</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedMatches)
                        {
                            <tr>
                                <td>@item.gg_number</td>
                                <td>@item.reg_number</td>
                                <td>@item.model_description</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-delete" @onclick="() => DeleteAsync(item.demo_vehicle_code)">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                    <span>Page @_page of @TotalPages</span>
                    <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private int _page = 1;
    private const int _pageSize = 12;
    private List<DemoVehicleDto> _matches = new();
    private IEnumerable<DemoVehicleDto> PagedMatches => _matches.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_matches.Count / (double)_pageSize));

    private async Task SearchAsync()
    {
        try
        {
            AddAuthHeader();
            var all = await Http.GetFromJsonAsync<List<DemoVehicleDto>>("api/demo-vehicles") ?? new List<DemoVehicleDto>();
            var term = _searchTerm.Trim();
            _matches = FilterDemoVehicleMatches(all, term, _searchMode);
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task DeleteAsync(int id)
    {
        if (id <= 0)
        {
            return;
        }

        try
        {
            AddAuthHeader();
            var response = await Http.DeleteAsync($"api/demo-vehicles/{id}");
            if (response.IsSuccessStatusCode)
            {
                _matches = _matches.Where(x => x.demo_vehicle_code != id).ToList();
                if (_page > TotalPages)
                {
                    _page = TotalPages;
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Delete failed: {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void AddAuthHeader()
    {
        if (TokenService.IsTokenValid && !string.IsNullOrWhiteSpace(TokenService.Token))
        {
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenService.Token);
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchTerm = string.Empty;
        _matches = new();
        _page = 1;
    }

    private static List<DemoVehicleDto> FilterDemoVehicleMatches(List<DemoVehicleDto> all, string keyword, string searchMode)
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return new();
        }

        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return all
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.reg_number) && v.reg_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.gg_number) && v.gg_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.reg_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.gg_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.demo_vehicle_code)
            .ToList();
    }

    private sealed class DemoVehicleDto
    {
        public int demo_vehicle_code { get; set; }
        public string gg_number { get; set; } = string.Empty;
        public string reg_number { get; set; } = string.Empty;
        public string model_description { get; set; } = string.Empty;
    }
}
