@page "/vehicles/demo/delete"
@rendermode InteractiveServer

<PageTitle>Delete a Demo Vehicle</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete a Demo Vehicle
        </h1>
        <p class="page-description">Legacy demo vehicle delete screen (UI-only until API endpoints are available).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" type="text" placeholder="GG number" />
                </div>
                <div class="form-field">
                    <label class="form-label">Registration Number</label>
                    <input class="form-input" type="text" placeholder="Registration number" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-danger">Delete</button>
                <button class="btn btn-secondary">&lt; Cancel</button>
            </div>
        </div>
    </div>
</div>
