@page "/vehicles/source-maintenance"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Services
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Source Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-store"></i>
            Vehicle Source Maintenance
        </h1>
        <p class="page-description">Add or edit vehicle source records.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Vehicle Source</label>
                <select class="form-select" @bind="_selectedId">
                    <option value="">Select source...</option>
                    @foreach (var source in _sources)
                    {
                        <option value="@source.Id">@source.Name</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="LoadSelectedAsync">Edit Vehicle Source</button>
                <button class="btn btn-secondary" @onclick="PrepareAddAsync">Add New Vehicle Source</button>
            </div>
        </div>
    </div>

    @if (_editing != null)
    {
        <div class="form-card fis-mt-1">
            <div class="form-card-header">
                <h2>@(_editing.Id == 0 ? "Add Vehicle Source" : "Edit Vehicle Source")</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field form-group-full">
                        <label class="form-label">Name</label>
                        <input class="form-input fis-uppercase" @bind="_editing.Name" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Physical Address</label>
                        <input class="form-input" @bind="_editing.PhysicalAddress" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Postal Address</label>
                        <input class="form-input" @bind="_editing.PostalAddress" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Telephone Number</label>
                        <input class="form-input" @bind="_editing.Telephone" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Fax Number</label>
                        <input class="form-input" @bind="_editing.Fax" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">E-mail Address</label>
                        <input class="form-input" @bind="_editing.Email" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contact Person</label>
                        <input class="form-input" @bind="_editing.ContactPerson" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Submit</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _selectedId = string.Empty;
    private bool _saving;
    private List<VehicleSourceRow> _sources = new();
    private VehicleSourceRow? _editing;

    protected override async Task OnInitializedAsync()
    {
        await LoadSourcesAsync();
    }

    private async Task LoadSourcesAsync()
    {
        try
        {
            AddAuthHeader();
            var result = await Http.GetFromJsonAsync<List<VehicleSourceRow>>("api/vehicle-source");
            _sources = result ?? new List<VehicleSourceRow>();
        }
        catch
        {
            _sources = new List<VehicleSourceRow>();
        }
    }

    private Task PrepareAddAsync()
    {
        _editing = new VehicleSourceRow();
        return Task.CompletedTask;
    }

    private Task LoadSelectedAsync()
    {
        if (!int.TryParse(_selectedId, out var id))
        {
            return Task.CompletedTask;
        }

        var source = _sources.FirstOrDefault(s => s.Id == id);
        if (source != null)
        {
            _editing = new VehicleSourceRow
            {
                Id = source.Id,
                Name = source.Name,
                PhysicalAddress = source.PhysicalAddress,
                PostalAddress = source.PostalAddress,
                Telephone = source.Telephone,
                Fax = source.Fax,
                Email = source.Email,
                ContactPerson = source.ContactPerson
            };
        }

        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_editing == null)
        {
            return;
        }

        _saving = true;
        try
        {
            AddAuthHeader();
            HttpResponseMessage response;
            if (_editing.Id == 0)
            {
                response = await Http.PostAsJsonAsync("api/vehicle-source", _editing);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/vehicle-source/{_editing.Id}", _editing);
            }

            if (!response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Vehicle source save failed: {(int)response.StatusCode}");
            }
            else
            {
                await LoadSourcesAsync();
                _editing = null;
                _selectedId = string.Empty;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
        {
            return;
        }

        Http.DefaultRequestHeaders.Remove("Cookie");
        Http.DefaultRequestHeaders.TryAddWithoutValidation("Cookie", $"FIS_Access_Token={TokenService.Token}");
    }

    private sealed class VehicleSourceRow
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhysicalAddress { get; set; } = string.Empty;
        public string PostalAddress { get; set; } = string.Empty;
        public string Telephone { get; set; } = string.Empty;
        public string Fax { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string ContactPerson { get; set; } = string.Empty;
    }
}
