@page "/vehicles/source-maintenance"
@rendermode InteractiveServer

<PageTitle>Vehicle Source Maintenance</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-transfer-alt"></i>
            Vehicle Source Maintenance
        </h1>
        <p class="page-description">Legacy vehicle source maintenance (UI-only until API endpoints are available).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Source Code</label>
                    <input class="form-input" type="text" placeholder="Source code" />
                </div>
                <div class="form-field">
                    <label class="form-label">Source Description</label>
                    <input class="form-input" type="text" placeholder="Source description" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary">Submit</button>
                <button class="btn btn-secondary">&lt; Cancel</button>
            </div>
        </div>
    </div>
</div>
