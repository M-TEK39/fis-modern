@page "/vehicles/demo/report"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Services
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Report All Demo Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-table"></i> Report: All Demo Vehicles</h1>
        <p class="page-description">Report layout with live data loading.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadAsync">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_loaded && _items.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No demo vehicles found</h3>
            <p>No demo vehicles are available for this report.</p>
        </div>
    }
    else if (_items.Count > 0)
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_items.Count demo vehicle(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Reg Number</th>
                            <th>Description</th>
                            <th>Year Model</th>
                            <th>Site</th>
                            <th>Bank ID</th>
                            <th>Tank</th>
                            <th>Engine Number</th>
                            <th>Chassis Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr>
                                <td>@item.gg_number</td>
                                <td>@item.reg_number</td>
                                <td>@item.model_description</td>
                                <td>@item.year_mnf</td>
                                <td>@item.description</td>
                                <td>@item.bank_code</td>
                                <td>@item.tank</td>
                                <td>@item.engine_number</td>
                                <td>@item.chassis_number</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                    <span>Page @_page of @TotalPages</span>
                    <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _loaded;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<DemoVehicleReportRow> _items = new();
    private IEnumerable<DemoVehicleReportRow> PagedItems => _items.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_items.Count / (double)_pageSize));

    private async Task LoadAsync()
    {
        _loading = true;
        _loaded = true;
        try
        {
            AddAuthHeader();
            _items = await Http.GetFromJsonAsync<List<DemoVehicleReportRow>>("api/demo-vehicles/reports/all")
                ?? await Http.GetFromJsonAsync<List<DemoVehicleReportRow>>("api/demo-vehicles")
                ?? new List<DemoVehicleReportRow>();
            _page = 1;
        }
        catch (Exception ex)
        {
            _items = new List<DemoVehicleReportRow>();
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddAuthHeader()
    {
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed class DemoVehicleReportRow
    {
        public string gg_number { get; set; } = string.Empty;
        public string reg_number { get; set; } = string.Empty;
        public string model_description { get; set; } = string.Empty;
        public string year_mnf { get; set; } = string.Empty;
        public string description { get; set; } = string.Empty;
        public string bank_code { get; set; } = string.Empty;
        public string tank { get; set; } = string.Empty;
        public string engine_number { get; set; } = string.Empty;
        public string chassis_number { get; set; } = string.Empty;
    }
}
