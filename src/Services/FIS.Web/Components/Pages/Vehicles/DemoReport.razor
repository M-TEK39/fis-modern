@page "/vehicles/demo/report"
@rendermode InteractiveServer

<PageTitle>Report All Demo Vehicles</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Report All Demo Vehicle
        </h1>
        <p class="page-description">Legacy report placeholder (UI-only until API endpoints are available).</p>
    </div>
</div>

<div class="page-content">
    <div class="table-container">
        <div class="table-header">
            <span class="table-title">Demo Vehicles</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Registration</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4">No demo vehicles found</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
