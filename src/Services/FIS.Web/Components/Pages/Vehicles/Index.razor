@page "/vehicles"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject VehicleApiService VehicleService
@inject ContractApiService ContractService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Master - Fleet Information System</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-mechanic"></i>
            Vehicle Master Menu
        </h1>
        <p class="page-description">Vehicle master navigation and maintenance options.</p>
    </div>
    @* UX enhancement kept for future merge. Do not remove. *@
    @*
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="NavigateToCreate">
            <i class="bx bx-plus"></i>
            Add Vehicle
        </button>
    </div>
    *@
</div>
<a id="PageBottom"></a>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Master.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-top-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVehicleInfo">
                    <span>Vehicle Master Information / Help</span>
                    <i class="bx @(_showVehicleInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVehicleInfo)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicles/help">Vehicle Master Information / Help</a>
                        </div>
                    </div>
                }
            </div>
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVehicleMaintenance">
                    <span>Vehicle Master Maintenance</span>
                    <i class="bx @(_showVehicleMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVehicleMaintenance)
                {
                    <div class="menu-tile-body">
                        @if (_canCaptureInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/create">1) Add New Vehicle</a>
                            </div>
                        }
                        @if (_canAuthorizeInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/authorize">1) Authorize Captured Vehicle Information</a>
                            </div>
                        }
                        @if (_canMaintainVehicleMaster)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/edit">2) Edit A Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/status-maintenance">3) Vehicle Status Maintenance</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/barcode">4) Add/Edit Barcode</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/gg-block-numbers">5) Add GG Block Number(s)</a>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (_canMaintainVehicleMaster)
            {
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleVehicleSource">
                        <span>Vehicle Source Maintenance</span>
                        <i class="bx @(_showVehicleSource ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showVehicleSource)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/source-maintenance">1) Vehicle Source Maintenance</a>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (_canViewDemoVehicles)
            {
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleRecoveredVehicles">
                        <span>Stolen & Recovered Vehicles</span>
                        <i class="bx @(_showRecoveredVehicles ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showRecoveredVehicles)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/recovered">1) Update Recovered GG</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/renumbered-report">2) Report All Renumbered vehicles</a>
                            </div>
                        </div>
                    }
                </div>
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleDemoVehicles">
                        <span>Demo Vehicles</span>
                        <i class="bx @(_showDemoVehicles ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showDemoVehicles)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/add">1) Add a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/edit">2) Edit a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/delete">3) Delete a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/report">4) Report All Demo Vehicle</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="table-container">
            <div class="table-header">
                <span class="table-title">All Vehicles Snapshot</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="RefreshVehicleOverviewAsync" disabled="@_loadingOverview">
                        <i class="bx bx-refresh"></i>
                        Refresh
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_overviewMessage))
            {
                <div class="alert @(_overviewError ? "alert-error" : "alert-success") fis-my-075">@_overviewMessage</div>
            }

            @if (_loadingOverview)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading vehicles...</p>
                </div>
            }
            else if (_vehicleOverview.Count == 0)
            {
                <div class="empty-state">
                    <i class="bx bx-info-circle"></i>
                    <h3>No vehicles found</h3>
                    <p>No vehicles match the current filter selection.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Invoice Number</th>
                                <th>Model</th>
                                <th>Status</th>
                                <th>Contract State</th>
                                <th>Target Return</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in _vehicleOverview)
                            {
                                <tr>
                                    <td>@ValueOrDash(vehicle.fleet_number)</td>
                                    <td>@ValueOrDash(vehicle.registration_number)</td>
                                    <td>@ValueOrDash(vehicle.invoice_number)</td>
                                    <td>@ValueOrDash(vehicle.model_name)</td>
                                    <td>@ValueOrDash(vehicle.status_description)</td>
                                    <td>
                                        <span class="badge @GetContractStateBadgeClass(vehicle.vmf_code)">@GetContractStateLabel(vehicle.vmf_code)</span>
                                    </td>
                                    <td>@FormatDate(GetContractTargetReturn(vehicle.vmf_code))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevOverviewPageAsync" disabled="@(_overviewPage <= 1 || _loadingOverview)">Previous</button>
                    <div class="pagination-info">Page @_overviewPage of @_overviewTotalPages</div>
                    <button class="pagination-btn" @onclick="NextOverviewPageAsync" disabled="@(_overviewPage >= _overviewTotalPages || _loadingOverview)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_overviewTotalRecords | Page size: @_overviewPageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _canCaptureInception;
    private bool _canAuthorizeInception;
    private bool _canMaintainVehicleMaster;
    private bool _canViewDemoVehicles;
    private bool _showVehicleInfo = true;
    private bool _showVehicleMaintenance = true;
    private bool _showVehicleSource = true;
    private bool _showRecoveredVehicles = true;
    private bool _showDemoVehicles = true;
    private bool _loadingOverview;
    private bool _overviewError;
    private string _overviewMessage = string.Empty;
    private int _overviewPage = 1;
    private readonly int _overviewPageSize = 12;
    private int _overviewTotalPages = 1;
    private int _overviewTotalRecords;
    private bool _overviewClientPaging;
    private List<FIS.Web.Models.VehicleDto> _overviewAll = new();
    private List<FIS.Web.Models.VehicleDto> _vehicleOverview = new();
    private readonly Dictionary<int, string> _contractStateByVmf = new();
    private readonly Dictionary<int, short?> _contractStatusCodeByVmf = new();
    private readonly Dictionary<int, DateTime?> _contractReturnByVmf = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (_hasVehicleAccess)
        {
            await LoadVehicleOverviewAsync();
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canMaintainVehicleMaster = _hasVehicleAccess;
        _canCaptureInception = HasRole(user, "vehicle inception capturer");
        _canAuthorizeInception = HasRole(user, "vehicle inception authorizer");
        _canViewDemoVehicles = HasRole(user, "demo vehicles");

        if (_hasVehicleAccess && !_canCaptureInception && !_canAuthorizeInception)
        {
            _canCaptureInception = true;
            _canAuthorizeInception = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private void ToggleVehicleInfo() => _showVehicleInfo = !_showVehicleInfo;
    private void ToggleVehicleMaintenance() => _showVehicleMaintenance = !_showVehicleMaintenance;
    private void ToggleVehicleSource() => _showVehicleSource = !_showVehicleSource;
    private void ToggleDemoVehicles() => _showDemoVehicles = !_showDemoVehicles;
    private void ToggleRecoveredVehicles() => _showRecoveredVehicles = !_showRecoveredVehicles;

    private async Task LoadVehicleOverviewAsync()
    {
        _loadingOverview = true;
        _overviewError = false;
        _overviewMessage = string.Empty;
        try
        {
            var page = await VehicleService.GetVehiclesAsync(_overviewPage, _overviewPageSize);
            var vehicles = page.Data ?? new List<FIS.Web.Models.VehicleDto>();

            // Backend fallback: if pagination metadata is not honored and full data comes back,
            // enforce 12-per-page on the UI to keep a uniform experience.
            if (vehicles.Count > _overviewPageSize && (page.TotalPages <= 1 || page.TotalCount <= vehicles.Count))
            {
                _overviewClientPaging = true;
                _overviewAll = vehicles;
                _overviewTotalRecords = _overviewAll.Count;
                _overviewTotalPages = Math.Max(1, (int)Math.Ceiling(_overviewTotalRecords / (double)_overviewPageSize));
                _overviewPage = Math.Clamp(_overviewPage, 1, _overviewTotalPages);
                _vehicleOverview = _overviewAll
                    .Skip((_overviewPage - 1) * _overviewPageSize)
                    .Take(_overviewPageSize)
                    .ToList();
            }
            else
            {
                _overviewClientPaging = false;
                _overviewAll = new();
                _vehicleOverview = vehicles;
                _overviewTotalRecords = Math.Max(page.TotalCount, _vehicleOverview.Count);
                _overviewTotalPages = page.TotalPages > 0
                    ? page.TotalPages
                    : Math.Max(1, (int)Math.Ceiling(_overviewTotalRecords / (double)_overviewPageSize));
            }

            await LoadContractStatesForCurrentPageAsync();
        }
        catch (Exception ex)
        {
            _overviewError = true;
            _overviewMessage = "Unable to load vehicle overview.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            _vehicleOverview = new();
            _contractStateByVmf.Clear();
            _contractReturnByVmf.Clear();
        }
        finally
        {
            _loadingOverview = false;
        }
    }

    private async Task LoadContractStatesForCurrentPageAsync()
    {
        _contractStateByVmf.Clear();
        _contractStatusCodeByVmf.Clear();
        _contractReturnByVmf.Clear();

        var vmfCodes = _vehicleOverview
            .Select(v => v.vmf_code)
            .Where(code => code > 0)
            .Distinct()
            .ToList();

        if (vmfCodes.Count == 0)
        {
            return;
        }

        var requests = vmfCodes.Select(async vmfCode =>
        {
            var query = new ContractsPageQuery
            {
                Page = 1,
                PageSize = 25,
                VmfCode = vmfCode
            };

            var result = await ContractService.GetContractsPageAsync(query);
            var latest = (result.Data ?? new List<FIS.Web.Models.ContractDto>())
                .OrderByDescending(c => c.contract_id)
                .FirstOrDefault();

            return (vmfCode, latest);
        });

        var responses = await Task.WhenAll(requests);
        foreach (var (vmfCode, latest) in responses)
        {
            if (latest == null)
            {
                _contractStateByVmf[vmfCode] = "No Contract";
                _contractStatusCodeByVmf[vmfCode] = null;
                _contractReturnByVmf[vmfCode] = null;
                continue;
            }

            _contractStateByVmf[vmfCode] = MapContractStatusLabel(latest.contract_status_code, latest.status);
            _contractStatusCodeByVmf[vmfCode] = latest.contract_status_code;
            _contractReturnByVmf[vmfCode] = latest.target_return_date;
        }
    }

    private static string MapContractStatusLabel(short? statusCode, string? statusText)
        => statusCode switch
        {
            0 => "Draft",
            1 => "Pending Review",
            2 => "Approved",
            3 => "Active",
            4 => "Declined for Correction",
            5 => "Declined",
            6 => "Cancelled",
            7 => "Closed",
            _ => string.IsNullOrWhiteSpace(statusText) ? "Unknown" : statusText
        };

    private string GetContractStateLabel(int vmfCode)
        => _contractStateByVmf.TryGetValue(vmfCode, out var label) ? label : "No Contract";

    private DateTime? GetContractTargetReturn(int vmfCode)
        => _contractReturnByVmf.TryGetValue(vmfCode, out var value) ? value : null;

    private string GetContractStateBadgeClass(int vmfCode)
    {
        if (!_contractStatusCodeByVmf.TryGetValue(vmfCode, out var statusCode))
        {
            return "badge";
        }

        return statusCode switch
        {
            1 => "badge-warning",
            2 => "status-info",
            3 => "badge-success",
            4 => "badge-warning",
            5 => "badge-error",
            6 => "badge-error",
            _ => "badge"
        };
    }

    private async Task PrevOverviewPageAsync()
    {
        if (_overviewPage <= 1)
        {
            return;
        }

        _overviewPage--;
        if (_overviewClientPaging)
        {
            _vehicleOverview = _overviewAll
                .Skip((_overviewPage - 1) * _overviewPageSize)
                .Take(_overviewPageSize)
                .ToList();
            await LoadContractStatesForCurrentPageAsync();
            return;
        }

        await LoadVehicleOverviewAsync();
    }

    private async Task NextOverviewPageAsync()
    {
        if (_overviewPage >= _overviewTotalPages)
        {
            return;
        }

        _overviewPage++;
        if (_overviewClientPaging)
        {
            _vehicleOverview = _overviewAll
                .Skip((_overviewPage - 1) * _overviewPageSize)
                .Take(_overviewPageSize)
                .ToList();
            await LoadContractStatesForCurrentPageAsync();
            return;
        }

        await LoadVehicleOverviewAsync();
    }

    private async Task RefreshVehicleOverviewAsync()
    {
        await LoadVehicleOverviewAsync();
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
}
