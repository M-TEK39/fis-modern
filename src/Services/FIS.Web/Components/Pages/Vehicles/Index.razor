@page "/vehicles"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Master - Fleet Information System</PageTitle>
<a id="PageTop"></a>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-mechanic"></i>
            Vehicle Master Menu
        </h1>
        <p class="page-description">Legacy vehicle master navigation and maintenance options</p>
    </div>
    @* UX enhancement kept for future merge. Do not remove. *@
    @*
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="NavigateToCreate">
            <i class="bx bx-plus"></i>
            Add Vehicle
        </button>
    </div>
    *@
</div>
<a id="PageBottom"></a>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Master.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-top-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVehicleInfo">
                    <span>Vehicle Master Information / Help</span>
                    <i class="bx @(_showVehicleInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVehicleInfo)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicles/help">Vehicle Master Information / Help</a>
                        </div>
                    </div>
                }
            </div>
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVehicleMaintenance">
                    <span>Vehicle Master Maintenance</span>
                    <i class="bx @(_showVehicleMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVehicleMaintenance)
                {
                    <div class="menu-tile-body">
                        @if (_canCaptureInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/create">1) Add New Vehicle</a>
                            </div>
                        }
                        @if (_canAuthorizeInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/authorize">1) Authorize Captured Vehicle Information</a>
                            </div>
                        }
                        @if (_canMaintainVehicleMaster)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/edit">2) Edit A Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/status-maintenance">3) Vehicle Status Maintenance</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/barcode">4) Add/Edit Barcode</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/gg-block-numbers">5) Add GG Block Number(s)</a>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (_canMaintainVehicleMaster)
            {
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleVehicleSource">
                        <span>Vehicle Source Maintenance</span>
                        <i class="bx @(_showVehicleSource ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showVehicleSource)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/source-maintenance">1) Vehicle Source Maintenance</a>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (_canViewDemoVehicles)
            {
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleRecoveredVehicles">
                        <span>Stolen & Recovered Vehicles</span>
                        <i class="bx @(_showRecoveredVehicles ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showRecoveredVehicles)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/recovered">1) Update Recovered GG</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/renumbered-report">2) Report All Renumbered vehicles</a>
                            </div>
                        </div>
                    }
                </div>
                <div class="menu-tile">
                    <button class="menu-tile-header" @onclick="ToggleDemoVehicles">
                        <span>Demo Vehicles</span>
                        <i class="bx @(_showDemoVehicles ? "bx-chevron-up" : "bx-chevron-down")"></i>
                    </button>
                    @if (_showDemoVehicles)
                    {
                        <div class="menu-tile-body">
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/add">1) Add a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/edit">2) Edit a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/delete">3) Delete a Demo Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/demo/report">4) Report All Demo Vehicle</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _canCaptureInception;
    private bool _canAuthorizeInception;
    private bool _canMaintainVehicleMaster;
    private bool _canViewDemoVehicles;
    private bool _showVehicleInfo = true;
    private bool _showVehicleMaintenance = true;
    private bool _showVehicleSource = true;
    private bool _showRecoveredVehicles = true;
    private bool _showDemoVehicles = true;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canMaintainVehicleMaster = _hasVehicleAccess;
        _canCaptureInception = HasRole(user, "vehicle inception capturer");
        _canAuthorizeInception = HasRole(user, "vehicle inception authorizer");
        _canViewDemoVehicles = HasRole(user, "demo vehicles");

        if (_hasVehicleAccess && !_canCaptureInception && !_canAuthorizeInception)
        {
            _canCaptureInception = true;
            _canAuthorizeInception = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private void ToggleVehicleInfo() => _showVehicleInfo = !_showVehicleInfo;
    private void ToggleVehicleMaintenance() => _showVehicleMaintenance = !_showVehicleMaintenance;
    private void ToggleVehicleSource() => _showVehicleSource = !_showVehicleSource;
    private void ToggleDemoVehicles() => _showDemoVehicles = !_showDemoVehicles;
    private void ToggleRecoveredVehicles() => _showRecoveredVehicles = !_showRecoveredVehicles;
}
