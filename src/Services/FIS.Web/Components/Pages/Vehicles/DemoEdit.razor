@page "/vehicles/demo/edit"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Models
@using FIS.Web.Services
@inject HttpClient Http
@inject SiteApiService SiteService
@inject ReferenceDataApiService ReferenceDataService
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Edit Demo Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-edit"></i> Edit Demo Vehicle</h1>
        <p class="page-description">Search by GG/GP number and update demo vehicle details.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Lookup Type</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="demoEditSearchType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="demoEditSearchType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                    <input class="form-input" @bind="_searchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_selectedDemoVehicleCode" disabled="@(_matches.Count == 0)">
                        <option value="">Select demo vehicle...</option>
                        @foreach (var match in _matches)
                        {
                            <option value="@match.demo_vehicle_code">@GetDemoVehicleLabel(match)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="SearchAsync">Find</button>
                <button class="btn btn-primary" @onclick="LoadSelectedAsync" disabled="@(!_selectedDemoVehicleCode.HasValue)">Load</button>
            </div>
        </div>
    </div>

    @if (_editing != null)
    {
        <div class="form-card fis-mt-1">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field"><label class="form-label">GG number</label><input class="form-input" @bind="_editing.gg_number" /></div>
                    <div class="form-field"><label class="form-label">Prov. Registration number</label><input class="form-input" @bind="_editing.reg_number" /></div>
                    <div class="form-field">
                        <label class="form-label">Make</label>
                        <select class="form-select" @bind="_selectedMakeCode" @bind:after="OnMakeChangedAsync">
                            <option value="">Select make...</option>
                            @foreach (var make in _makes.OrderBy(m => m.make_name))
                            {
                                <option value="@make.make_code">@($"{make.make_name} ({make.make_code})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Model</label>
                        <select class="form-select" @bind="_selectedModelCode" @bind:after="OnModelChanged" disabled="@(_models.Count == 0)">
                            <option value="">Select model...</option>
                            @foreach (var model in _models.OrderBy(m => m.model_name))
                            {
                                <option value="@model.model_code">@($"{model.model_name} ({model.model_code})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field"><label class="form-label">Site</label><select class="form-select" @bind="_editing.site_code"><option value="">Select...</option>@foreach (var s in _sites){<option value="@s.SiteCode">@($"{s.Description} ({s.SiteCode})")</option>}</select></div>
                    <div class="form-field"><label class="form-label">Year Manufactured</label><input class="form-input" @bind="_editing.year_mnf" /></div>
                    <div class="form-field"><label class="form-label">Bank ID</label><input class="form-input" @bind="_editing.bank_code" /></div>
                    <div class="form-field"><label class="form-label">Colour</label><input class="form-input" @bind="_editing.colour" /></div>
                    <div class="form-field"><label class="form-label">Tank Capacity</label><input class="form-input" @bind="_editing.tank" /></div>
                    <div class="form-field"><label class="form-label">Engine number</label><input class="form-input" @bind="_editing.engine_number" /></div>
                    <div class="form-field"><label class="form-label">Chassis number</label><input class="form-input" @bind="_editing.chassis_number" /></div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Submit</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private bool _saving;
    private DemoVehicleDto? _editing;
    private List<DemoVehicleDto> _matches = new();
    private int? _selectedDemoVehicleCode;
    private List<SiteResponseDto> _sites = new();
    private List<MakeDto> _makes = new();
    private List<ModelDto> _allModels = new();
    private List<ModelDto> _models = new();
    private int? _selectedMakeCode;
    private int? _selectedModelCode;

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        _makes = await ReferenceDataService.GetMakesAsync();
        _allModels = await ReferenceDataService.GetModelsAsync();
    }

    private async Task SearchAsync()
    {
        try
        {
            AddAuthHeader();
            var all = await Http.GetFromJsonAsync<List<DemoVehicleDto>>("api/demo-vehicles") ?? new List<DemoVehicleDto>();
            var query = _searchTerm.Trim();
            _matches = FilterDemoVehicleMatches(all, query, _searchMode);

            _editing = null;
            if (_matches.All(x => x.demo_vehicle_code != _selectedDemoVehicleCode))
            {
                _selectedDemoVehicleCode = null;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task LoadSelectedAsync()
    {
        if (!_selectedDemoVehicleCode.HasValue)
        {
            return;
        }

        _editing = _matches.FirstOrDefault(x => x.demo_vehicle_code == _selectedDemoVehicleCode.Value);
        await InitializeModelSelectionAsync();
    }

    private async Task SaveAsync()
    {
        if (_editing == null || _editing.demo_vehicle_code <= 0)
        {
            return;
        }

        _saving = true;
        try
        {
            AddAuthHeader();
            var response = await Http.PutAsJsonAsync($"api/demo-vehicles/{_editing.demo_vehicle_code}", _editing);
            if (!response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Edit demo vehicle failed: {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
        {
            return;
        }

        Http.DefaultRequestHeaders.Remove("Cookie");
        Http.DefaultRequestHeaders.TryAddWithoutValidation("Cookie", $"FIS_Access_Token={TokenService.Token}");
    }

    private async Task InitializeModelSelectionAsync()
    {
        _selectedMakeCode = null;
        _selectedModelCode = null;
        _models = new();

        if (_editing == null || string.IsNullOrWhiteSpace(_editing.model_description))
        {
            return;
        }

        var model = _allModels.FirstOrDefault(m =>
            string.Equals(m.model_name, _editing.model_description, StringComparison.OrdinalIgnoreCase));
        if (model?.make_code is null || model.make_code.Value <= 0)
        {
            return;
        }

        _selectedMakeCode = model.make_code.Value;
        _models = await ReferenceDataService.GetModelsByMakeAsync(_selectedMakeCode.Value);
        _selectedModelCode = _models.FirstOrDefault(m =>
            string.Equals(m.model_name, _editing.model_description, StringComparison.OrdinalIgnoreCase))?.model_code;
    }

    private async Task OnMakeChangedAsync()
    {
        _selectedModelCode = null;
        _models = _selectedMakeCode.HasValue && _selectedMakeCode.Value > 0
            ? await ReferenceDataService.GetModelsByMakeAsync(_selectedMakeCode.Value)
            : new List<ModelDto>();

        if (_editing != null)
        {
            _editing.model_description = string.Empty;
        }
    }

    private void OnModelChanged()
    {
        if (_editing == null)
        {
            return;
        }

        var selected = _models.FirstOrDefault(m => m.model_code == _selectedModelCode);
        _editing.model_description = selected?.model_name ?? string.Empty;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchTerm = string.Empty;
        _matches = new();
        _selectedDemoVehicleCode = null;
        _editing = null;
    }

    private static List<DemoVehicleDto> FilterDemoVehicleMatches(List<DemoVehicleDto> all, string keyword, string searchMode)
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return new();
        }

        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);
        return all
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.reg_number) && v.reg_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.gg_number) && v.gg_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.reg_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.gg_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.demo_vehicle_code)
            .ToList();
    }

    private static string GetDemoVehicleLabel(DemoVehicleDto vehicle)
    {
        var gg = string.IsNullOrWhiteSpace(vehicle.gg_number) ? "-" : vehicle.gg_number.Trim();
        var reg = string.IsNullOrWhiteSpace(vehicle.reg_number) ? "-" : vehicle.reg_number.Trim();
        return $"{gg} / {reg} ({vehicle.demo_vehicle_code})";
    }

    private sealed class DemoVehicleDto
    {
        public int demo_vehicle_code { get; set; }
        public string gg_number { get; set; } = string.Empty;
        public string reg_number { get; set; } = string.Empty;
        public string model_description { get; set; } = string.Empty;
        public short? site_code { get; set; }
        public string year_mnf { get; set; } = string.Empty;
        public string bank_code { get; set; } = string.Empty;
        public string colour { get; set; } = string.Empty;
        public string tank { get; set; } = string.Empty;
        public string engine_number { get; set; } = string.Empty;
        public string chassis_number { get; set; } = string.Empty;
    }
}
