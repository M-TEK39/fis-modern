@page "/vehicles/barcode"
@rendermode InteractiveServer

<PageTitle>Add/Edit Barcode</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-barcode"></i>
            Add/Edit Barcode
        </h1>
        <p class="page-description">Legacy barcode maintenance screen (UI-only until API endpoints are available).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">GG or GP Number</label>
                    <input class="form-input" type="text" placeholder="Enter GG/GP number" />
                </div>
                <div class="form-field">
                    <label class="form-label">Barcode</label>
                    <input class="form-input" type="text" placeholder="Enter barcode" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary">Submit</button>
                <button class="btn btn-secondary">&lt; Cancel</button>
            </div>
        </div>
    </div>
</div>
