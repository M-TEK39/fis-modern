@page "/vehicles/barcode"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Add/Edit Barcode - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-barcode"></i>
            Add / Edit Vehicle Barcode
        </h1>
        <p class="page-description">Barcode maintenance workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Number Type</label>
                <div class="contract-search-radio">
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                        GG
                    </label>
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                        GP
                    </label>
                </div>
            </div>
            <div class="form-row">
                <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                <div class="fis-input-group-compact">
                    <input class="form-input" @bind="_ggNumber" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="SearchVehicleAsync">Find</button>
                </div>
                <select class="form-select fis-mt-05" @bind="_selectedVmfCode" @bind:after="ApplySelectedVehicle" disabled="@(_vehicleMatches.Count == 0)">
                    <option value="">Select vehicle...</option>
                    @foreach (var vehicle in _vehicleMatches)
                    {
                        <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ApplySelectedVehicle" disabled="@(!_selectedVmfCode.HasValue)">Submit</button>
                <button class="btn btn-secondary" @onclick="ResetAsync">Cancel</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_searched && _vehicle == null)
    {
        <div class="empty-state">
            <i class="bx bx-error-circle"></i>
            <h3>Vehicle not found</h3>
            <p>GG number not found.</p>
        </div>
    }
    else if (_vehicle != null)
    {
        <div class="form-card fis-mt-1">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" value="@(ValueOrDash(_vehicle.fleet_number))" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Barcode</label>
                        <input class="form-input" @bind="_barcode" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="UpdateBarcodeAsync" disabled="@_saving">Update</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _ggNumber = string.Empty;
    private string _searchMode = "GG";
    private string _barcode = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _searched;
    private VehicleDto? _vehicle;
    private int? _selectedVmfCode;
    private List<VehicleDto> _vehicleMatches = new();

    private async Task SearchVehicleAsync()
    {
        _loading = true;
        _searched = true;
        _vehicle = null;
        _barcode = string.Empty;
        _selectedVmfCode = null;
        try
        {
            var keyword = _ggNumber.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplySelectedVehicle()
    {
        if (!_selectedVmfCode.HasValue || _selectedVmfCode.Value <= 0)
        {
            _vehicle = null;
            _barcode = string.Empty;
            return;
        }

        _vehicle = await VehicleService.GetVehicleAsync(_selectedVmfCode.Value);
        _barcode = string.Empty;
    }

    private async Task UpdateBarcodeAsync()
    {
        if (_vehicle == null || string.IsNullOrWhiteSpace(_vehicle.fleet_number))
        {
            return;
        }

        _saving = true;
        try
        {
            AddAuthHeader();

            var payload = new
            {
                ggNumber = _vehicle.fleet_number,
                barcode = _barcode
            };

            var response = await Http.PutAsJsonAsync("api/vehicles/barcode", payload);
            if (!response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Barcode update failed: {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ResetAsync()
    {
        _ggNumber = string.Empty;
        _barcode = string.Empty;
        _searched = false;
        _vehicle = null;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        return Task.CompletedTask;
    }

    private void AddAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
        {
            return;
        }

        Http.DefaultRequestHeaders.Remove("Cookie");
        Http.DefaultRequestHeaders.TryAddWithoutValidation("Cookie", $"FIS_Access_Token={TokenService.Token}");
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searched = false;
        _vehicle = null;
        _barcode = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }
}
