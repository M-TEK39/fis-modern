@page "/vehicles/barcode"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JSRuntime

<PageTitle>Add/Edit Barcode - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-barcode"></i>
            Add / Edit Vehicle Barcode
        </h1>
        <p class="page-description">Legacy barcode maintenance workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">GG Number</label>
                <input class="form-input" @bind="_ggNumber" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchVehicleAsync">Submit</button>
                <button class="btn btn-secondary" @onclick="ResetAsync">Cancel</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_searched && _vehicle == null)
    {
        <div class="empty-state">
            <i class="bx bx-error-circle"></i>
            <h3>Vehicle not found</h3>
            <p>GG number not found.</p>
        </div>
    }
    else if (_vehicle != null)
    {
        <div class="form-card fis-mt-1">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" value="@_vehicle.fleet_number" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Barcode</label>
                        <input class="form-input" @bind="_barcode" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="UpdateBarcodeAsync" disabled="@_saving">Update</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _ggNumber = string.Empty;
    private string _barcode = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _searched;
    private VehicleDto? _vehicle;

    private async Task SearchVehicleAsync()
    {
        _loading = true;
        _searched = true;
        _vehicle = null;
        _barcode = string.Empty;
        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(_ggNumber.Trim());
            var match = matches.FirstOrDefault();
            if (match != null)
            {
                _vehicle = await VehicleService.GetVehicleAsync(match.vmf_code);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateBarcodeAsync()
    {
        if (_vehicle == null || string.IsNullOrWhiteSpace(_vehicle.fleet_number))
        {
            return;
        }

        _saving = true;
        try
        {
            if (TokenService.IsTokenValid && !string.IsNullOrWhiteSpace(TokenService.Token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenService.Token);
            }

            var payload = new
            {
                ggNumber = _vehicle.fleet_number,
                barcode = _barcode
            };

            var response = await Http.PutAsJsonAsync("api/vehicles/barcode", payload);
            if (!response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.error", $"Barcode update failed: {(int)response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ResetAsync()
    {
        _ggNumber = string.Empty;
        _barcode = string.Empty;
        _searched = false;
        _vehicle = null;
        return Task.CompletedTask;
    }
}
