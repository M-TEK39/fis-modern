@page "/vehicles/status-maintenance"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Status Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cog"></i>
            Vehicle Status Maintenance
        </h1>
        <p class="page-description">Select the vehicle for status management and capture the next status.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back to Vehicle Master</a>
    </div>
</div>

<div class="page-content status-maintenance-page">
    <div class="status-search-panel">
        <label class="form-label" for="statusSearchInput">Select the vehicle for status management:</label>
        <div class="contract-search-radio">
            <label class="form-radio-label">
                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                GG
            </label>
            <label class="form-radio-label">
                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                GP
            </label>
        </div>
        <div class="status-search-row">
            <input id="statusSearchInput" class="form-input" @bind="_searchTerm" @bind:event="oninput" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
            <button class="btn btn-primary" @onclick="SearchVehiclesAsync" disabled="@_loading">Submit</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_limitedAccessMessage))
    {
        <div class="status-message status-message-error">@_limitedAccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusValidationIssues))
    {
        <div class="status-message status-message-error">@_statusValidationIssues</div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusUpdateMessage))
    {
        <div class="status-message status-message-success">@_statusUpdateMessage</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading vehicle status data...</p>
        </div>
    }
    else if (_hasSearched && _searchResults.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-search"></i>
            <h3>No vehicles found</h3>
            <p>Check the GG/GP number and search again.</p>
        </div>
    }

    @if (_searchResults.Count > 0)
    {
        <div class="table-container fis-mt-1">
            <div class="table-header">
                <span class="table-title">Select Vehicle (@_searchResults.Count)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Registration</th>
                            <th>Current Status</th>
                            <th>Status Date</th>
                            <th class="actions-column">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in PagedSearchResults)
                        {
                            var selected = _selectedVehicle?.vmf_code == vehicle.vmf_code;
                            <tr class="@(selected ? "status-row-selected" : string.Empty)">
                                <td>@ValueOrDash(vehicle.fleet_number)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@ValueOrDash(vehicle.status_description)</td>
                                <td>@FormatDate(vehicle.vehicle_status_date)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => SelectVehicleAsync(vehicle.vmf_code)" title="Manage status">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousSearchPage" disabled="@(_searchPage <= 1)">Previous</button>
                <div class="pagination-info">Page @_searchPage of @SearchTotalPages</div>
                <button class="pagination-btn" @onclick="NextSearchPage" disabled="@(_searchPage >= SearchTotalPages)">Next</button>
            </div>
        </div>
    }

    @if (_selectedVehicle != null)
    {
        <div class="status-workspace">
            <section class="status-column-left">
                <div class="status-legacy-table">
                    <div class="status-legacy-header">Vehicle Information</div>
                    <table>
                        <tbody>
                            <tr><th>GG Number:</th><td>@ValueOrDash(_selectedVehicle.fleet_number)</td></tr>
                            <tr><th>Registration Number:</th><td>@ValueOrDash(_selectedVehicle.registration_number)</td></tr>
                            <tr><th>Make &amp; Model:</th><td>@ValueOrDash(_selectedVehicle.model_name)</td></tr>
                            <tr><th>Year Manufactured:</th><td>@(_selectedVehicle.year_manufactured?.ToString() ?? "-")</td></tr>
                            <tr><th>Colour:</th><td>@ValueOrDash(_selectedVehicle.colour)</td></tr>
                            <tr><th>VIN/Chassis Number:</th><td>@ValueOrDash(_selectedVehicle.chassis_number)</td></tr>
                            <tr><th>Engine Number:</th><td>@ValueOrDash(_selectedVehicle.engine_number_1)</td></tr>
                            <tr><th>Hired From:</th><td>@ValueOrDash(_selectedVehicle.purchased_from)</td></tr>
                            <tr><th>Hire Type:</th><td>@ValueOrDash(_selectedVehicle.type_name)</td></tr>
                            <tr><th>Location:</th><td>@ValueOrDash(_selectedVehicle.location_description)</td></tr>
                            <tr><th>Current Status:</th><td>@ValueOrDash(_selectedVehicle.status_description)</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="status-legacy-table fis-mt-1">
                    <div class="status-legacy-header">Vehicle Status History</div>
                    <div class="table-wrapper">
                        <table class="data-table status-history-table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Capture Date</th>
                                    <th>Odometer</th>
                                    <th>User Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_statusHistory.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6">No history records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in PagedStatusHistory)
                                    {
                                        <tr>
                                            <td>@row.StatusDescription</td>
                                            <td>@FormatDate(row.StartDate)</td>
                                            <td>@FormatDate(row.EndDate)</td>
                                            <td>@FormatDateTime(row.CaptureDate)</td>
                                            <td>@(row.Odometer?.ToString("N0") ?? "-")</td>
                                            <td>@row.CapturedBy</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-controls fis-mt-1">
                        <button class="pagination-btn" @onclick="PreviousHistoryPage" disabled="@(_historyPage <= 1)">Previous</button>
                        <div class="pagination-info">Page @_historyPage of @HistoryTotalPages</div>
                        <button class="pagination-btn" @onclick="NextHistoryPage" disabled="@(_historyPage >= HistoryTotalPages)">Next</button>
                    </div>
                </div>
            </section>

            <section class="status-column-right">
                <div class="status-legacy-table">
                    <div class="status-legacy-header">Next Statuses Available</div>
                    @if (NextStatuses.Count == 0)
                    {
                        <p class="status-inline-note">No follow-on statuses found in system.</p>
                    }
                    else
                    {
                        <div class="status-radio-list">
                            @foreach (var status in NextStatuses)
                            {
                                <label>
                                    <input type="radio" name="radStatuses" value="@status.Code" checked="@(_selectedStatusCode == status.Code)" @onchange="() => SelectStatus(status.Code)" />
                                    @status.Description
                                </label>
                            }
                        </div>
                    }

                    <div class="status-field-row">
                        <label class="form-label">Effective From:</label>
                        <input type="date" class="form-input status-date-input" @bind="_effectiveDate" />
                    </div>

                    <div class="status-field-row">
                        <label class="form-label">Odometer:</label>
                        <input type="number" class="form-input" @bind="_endOdometer" min="0" />
                    </div>

                    <div class="status-field-row status-comments-row">
                        <label class="form-label">Comments:</label>
                        <textarea class="form-input" rows="3" maxlength="500" @bind="_comments"></textarea>
                    </div>

                    @if (ShowStolenSiteInformation)
                    {
                        <div class="status-field-row">
                            <label class="form-label">Book Under Site:</label>
                            <select class="form-select" @bind="_stolenSiteCode">
                                <option value="">Select site</option>
                                @foreach (var site in _sites.OrderBy(s => s.Description))
                                {
                                    <option value="@site.SiteCode">@($"{ValueOrDash(site.Description)} ({site.SiteCode})")</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                @if (ShowSoldInformation)
                {
                    <div class="status-legacy-table fis-mt-1">
                        <div class="status-legacy-header">Sold Information</div>
                        <div class="status-field-row">
                            <label class="form-label">Sold Amount:</label>
                            <input type="number" class="form-input" @bind="_soldAmount" min="0" step="0.01" />
                        </div>
                        <div class="status-field-row">
                            <label class="form-label">Sold Date:</label>
                            <input type="date" class="form-input status-date-input" @bind="_soldDate" />
                        </div>
                        <div class="status-field-row">
                            <label class="form-label">Sold To:</label>
                            <input class="form-input" @bind="_soldTo" maxlength="60" />
                        </div>
                    </div>
                }

                <div class="status-actions">
                    <button class="btn btn-primary" @onclick="SaveStatusAsync" disabled="@_saving">Update Status</button>
                    <button class="btn btn-secondary" @onclick="ReturnToMenu">Return to Previous Page</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private const short SoldStatusCode = 5;
    private const short StolenStatusCode = 4;

    [SupplyParameterFromQuery(Name = "vmfCode")]
    public int? VmfCode { get; set; }

    private string _searchTerm = string.Empty;
    private bool _loading;
    private string _searchMode = "GG";
    private bool _saving;
    private bool _hasSearched;
    private List<VehicleDto> _searchResults = new();
    private List<StatusOption> _statusCatalog = new();
    private List<SiteResponseDto> _sites = new();
    private VehicleDto? _selectedVehicle;
    private short? _selectedStatusCode;
    private DateTime? _effectiveDate;
    private int? _endOdometer;
    private string _comments = string.Empty;
    private decimal? _soldAmount;
    private DateTime? _soldDate;
    private string _soldTo = string.Empty;
    private short? _stolenSiteCode;
    private string _statusValidationIssues = string.Empty;
    private string _statusUpdateMessage = string.Empty;
    private string _limitedAccessMessage = string.Empty;
    private string _currentUserDisplay = "Current User";
    private List<StatusHistoryRow> _statusHistory = new();
    private int _searchPage = 1;
    private int _historyPage = 1;
    private const int _pageSize = 12;
    private IEnumerable<VehicleDto> PagedSearchResults => _searchResults.Skip((_searchPage - 1) * _pageSize).Take(_pageSize);
    private int SearchTotalPages => Math.Max(1, (int)Math.Ceiling(_searchResults.Count / (double)_pageSize));
    private IEnumerable<StatusHistoryRow> PagedStatusHistory => _statusHistory.Skip((_historyPage - 1) * _pageSize).Take(_pageSize);
    private int HistoryTotalPages => Math.Max(1, (int)Math.Ceiling(_statusHistory.Count / (double)_pageSize));

    private bool ShowSoldInformation => _selectedStatusCode == SoldStatusCode;
    private bool ShowStolenSiteInformation => _selectedStatusCode == StolenStatusCode;

    private IReadOnlyList<StatusOption> NextStatuses
    {
        get
        {
            if (_selectedVehicle == null)
            {
                return Array.Empty<StatusOption>();
            }

            var list = _statusCatalog
                .Where(s => s.Code != _selectedVehicle.vehicle_status_code)
                .OrderBy(s => s.Description)
                .ToList();

            if (list.Count == 0)
            {
                var current = ResolveCurrentStatusOption();
                if (current != null)
                {
                    list.Add(current);
                }
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserAsync();
        _sites = await SiteService.GetAllAsync();
        await LoadStatusCatalogAsync();

        if (VmfCode.HasValue && VmfCode.Value > 0)
        {
            await SelectVehicleAsync(VmfCode.Value);
        }
    }

    private async Task ResolveCurrentUserAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                var fullName = user.FindFirst(ClaimTypes.Name)?.Value;
                var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
                _currentUserDisplay = !string.IsNullOrWhiteSpace(fullName)
                    ? fullName
                    : (!string.IsNullOrWhiteSpace(firstName) ? firstName : "Current User");
            }
        }
        catch
        {
            _currentUserDisplay = "Current User";
        }
    }

    private async Task LoadStatusCatalogAsync()
    {
        try
        {
            var page = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _statusCatalog = page.Data
                .Where(v => v.vehicle_status_code > 0 && !string.IsNullOrWhiteSpace(v.status_description))
                .GroupBy(v => v.vehicle_status_code)
                .Select(group => new StatusOption(group.Key, group.First().status_description ?? $"Status {group.Key}"))
                .OrderBy(s => s.Description)
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading status catalog: {ex.Message}");
            _statusCatalog = new List<StatusOption>();
        }
    }

    private async Task SearchVehiclesAsync()
    {
        _statusValidationIssues = string.Empty;
        _statusUpdateMessage = string.Empty;
        _loading = true;
        _hasSearched = true;
        _searchResults = new();
        try
        {
            var keyword = _searchTerm.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _searchResults = FilterVehicleMatches(matches, keyword, _searchMode);

            _searchPage = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectVehicleAsync(int vmfCode)
    {
        _statusValidationIssues = string.Empty;
        _statusUpdateMessage = string.Empty;
        _loading = true;
        try
        {
            _selectedVehicle = await VehicleService.GetVehicleAsync(vmfCode);
            if (_selectedVehicle == null)
            {
                return;
            }

            _selectedStatusCode = null;
            _effectiveDate = DateTime.Today;
            _endOdometer = _selectedVehicle.current_odo;
            _comments = string.Empty;
            _soldAmount = null;
            _soldDate = null;
            _soldTo = string.Empty;
            _stolenSiteCode = _selectedVehicle.site_code;

            SeedStatusHistoryFromVehicle(_selectedVehicle);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SeedStatusHistoryFromVehicle(VehicleDto vehicle)
    {
        _statusHistory = new List<StatusHistoryRow>
        {
            new(
                vehicle.status_description ?? "Current Status",
                vehicle.vehicle_status_date,
                null,
                vehicle.date_updated ?? vehicle.date_created,
                vehicle.current_odo,
                "System")
        };
        _historyPage = 1;
    }

    private void SelectStatus(short statusCode)
    {
        _selectedStatusCode = statusCode;
        if (!ShowSoldInformation)
        {
            _soldAmount = null;
            _soldDate = null;
            _soldTo = string.Empty;
        }
        if (!ShowStolenSiteInformation)
        {
            _stolenSiteCode = null;
        }
        else if (_selectedVehicle?.site_code is not null && _stolenSiteCode is null)
        {
            _stolenSiteCode = _selectedVehicle.site_code;
        }
    }

    private async Task SaveStatusAsync()
    {
        if (_selectedVehicle == null)
        {
            return;
        }

        _statusValidationIssues = ValidateForm();
        _statusUpdateMessage = string.Empty;
        if (!string.IsNullOrWhiteSpace(_statusValidationIssues))
        {
            return;
        }

        _saving = true;
        try
        {
            var statusCode = _selectedStatusCode!.Value;
            var selectedStatus = _statusCatalog.FirstOrDefault(s => s.Code == statusCode)
                ?? new StatusOption(statusCode, $"Status {statusCode}");

            var statusResult = await VehicleService.ChangeVehicleStatusAsync(
                _selectedVehicle.vmf_code,
                statusCode,
                ShowStolenSiteInformation ? _stolenSiteCode : null,
                _effectiveDate,
                _comments);

            if (!statusResult.Success)
            {
                _statusValidationIssues = string.IsNullOrWhiteSpace(statusResult.Message)
                    ? "Failed to update status. Please try again."
                    : statusResult.Message;
                return;
            }

            _selectedVehicle.vehicle_status_code = statusResult.new_status_code ?? statusCode;
            _selectedVehicle.status_description = statusResult.new_status_description ?? selectedStatus.Description;
            _selectedVehicle.vehicle_status_date = statusResult.effective_date ?? _effectiveDate;
            _selectedVehicle.current_odo = _endOdometer ?? _selectedVehicle.current_odo;

            if (statusResult.location_code.HasValue)
            {
                _selectedVehicle.location_code = statusResult.location_code.Value;
                _selectedVehicle.site_code = statusResult.location_code.Value;
                _selectedVehicle.location_description = ResolveSiteDescription(statusResult.location_code);
            }

            _statusHistory.Insert(0,
                new StatusHistoryRow(
                    _selectedVehicle.status_description ?? selectedStatus.Description,
                    _selectedVehicle.vehicle_status_date,
                    null,
                    DateTime.Now,
                    _endOdometer,
                    _currentUserDisplay));
            _historyPage = 1;

            var actions = statusResult.actions_performed.Where(a => !string.IsNullOrWhiteSpace(a)).ToList();
            _statusUpdateMessage = actions.Count > 0
                ? string.Join(" ", actions)
                : $"Status set as '{_selectedVehicle.status_description}' effective from {FormatDate(_selectedVehicle.vehicle_status_date)}.";

            var idx = _searchResults.FindIndex(v => v.vmf_code == _selectedVehicle.vmf_code);
            if (idx >= 0)
            {
                _searchResults[idx] = _selectedVehicle;
            }

            _selectedStatusCode = null;
            _comments = string.Empty;
            _soldAmount = null;
            _soldDate = null;
            _soldTo = string.Empty;
            _stolenSiteCode = null;
        }
        catch (Exception ex)
        {
            _statusValidationIssues = "An unexpected error occurred while updating the status.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private string ValidateForm()
    {
        var errors = new List<string>();

        if (!_selectedStatusCode.HasValue)
        {
            errors.Add("Please select the next status.");
        }

        if (!_effectiveDate.HasValue)
        {
            errors.Add("Effective From date is required.");
        }
        else if (_effectiveDate.Value.Date > DateTime.Today)
        {
            errors.Add("Effective From date cannot be in the future.");
        }

        if (ShowSoldInformation)
        {
            if (!_soldAmount.HasValue || _soldAmount.Value <= 0)
            {
                errors.Add("Sold Amount is required.");
            }

            if (!_soldDate.HasValue)
            {
                errors.Add("Sold Date is required.");
            }
            else if (_soldDate.Value.Date > DateTime.Today)
            {
                errors.Add("Sold Date cannot be in the future.");
            }

            if (string.IsNullOrWhiteSpace(_soldTo))
            {
                errors.Add("Sold To information is required.");
            }
        }

        if (ShowStolenSiteInformation && !_stolenSiteCode.HasValue)
        {
            errors.Add("Book Under Site is required when marking a vehicle as Stolen.");
        }

        return string.Join(" ", errors);
    }

    private string ResolveSiteDescription(short? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return _selectedVehicle?.location_description ?? "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site == null ? $"Site {siteCode.Value}" : site.Description ?? $"Site {siteCode.Value}";
    }

    private StatusOption? ResolveCurrentStatusOption()
    {
        if (_selectedVehicle == null)
        {
            return null;
        }

        var match = _statusCatalog.FirstOrDefault(s => s.Code == _selectedVehicle.vehicle_status_code);
        if (match != null)
        {
            return match;
        }

        return new StatusOption(
            _selectedVehicle.vehicle_status_code,
            _selectedVehicle.status_description ?? $"Status {_selectedVehicle.vehicle_status_code}");
    }

    private void ReturnToMenu()
    {
        JSRuntime.InvokeVoidAsync("history.back");
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchResults = new();
        _selectedVehicle = null;
        _hasSearched = false;
        _searchPage = 1;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy/MM/dd") : "-";

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy/MM/dd HH:mm") : "-";

    private void PreviousSearchPage()
    {
        if (_searchPage > 1)
        {
            _searchPage--;
        }
    }

    private void NextSearchPage()
    {
        if (_searchPage < SearchTotalPages)
        {
            _searchPage++;
        }
    }

    private void PreviousHistoryPage()
    {
        if (_historyPage > 1)
        {
            _historyPage--;
        }
    }

    private void NextHistoryPage()
    {
        if (_historyPage < HistoryTotalPages)
        {
            _historyPage++;
        }
    }

    private sealed record StatusOption(short Code, string Description);

    private sealed record StatusHistoryRow(
        string StatusDescription,
        DateTime? StartDate,
        DateTime? EndDate,
        DateTime? CaptureDate,
        int? Odometer,
        string CapturedBy);
}
