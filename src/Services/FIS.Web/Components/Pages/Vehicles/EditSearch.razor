@page "/vehicles/edit"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject NavigationManager Navigation

<PageTitle>Vehicle Master - Edit Vehicle Search</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-car-mechanic"></i>
            Vehicle Master
        </h1>
        <p class="page-description">Edit a vehicle</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>GG/GP, Registration, or Invoice Number</h2>
            <p>Enter a GG/GP, registration, or invoice number to open the vehicle record.</p>
        </div>
        <div class="form-card-body">
            <EditForm Model="_form" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Number Type <span class="required">*</span></label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                GP
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "INVOICE")" @onchange='() => SetSearchMode("INVOICE")' />
                                Invoice
                            </label>
                        </div>
                        <label class="form-label">@GetSearchLabel() <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_form.SearchNumber" maxlength="60" />
                        <label class="form-label fis-mt-05">Vehicle Match</label>
                        <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                            <option value="">Select vehicle...</option>
                            @foreach (var vehicle in _vehicleMatches)
                            {
                                <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-error fis-alert-tight">
                        <i class="bx bx-error-circle"></i>
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" @onclick="NavigateToMenu" disabled="@_loading">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="spinner-sm"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private SearchForm _form = new();
    private string _searchMode = "GG";
    private bool _loading;
    private string _errorMessage = string.Empty;
    private List<VehicleDto> _vehicleMatches = new();
    private int? _selectedVmfCode;

    private async Task HandleSubmit()
    {
        _errorMessage = string.Empty;
        var query = (_form.SearchNumber ?? string.Empty).Trim().ToUpperInvariant();

        if (query.Length < 3)
        {
            _errorMessage = "Please enter at least 3 characters.";
            return;
        }

        _loading = true;
        try
        {
            _vehicleMatches = RankVehicleMatches(await VehicleService.SearchVehiclesAsync(query), query, _searchMode);
            if (_vehicleMatches.Count == 0)
            {
                _selectedVmfCode = null;
                _errorMessage = "Number not found.";
                return;
            }

            if (_vehicleMatches.All(v => v.vmf_code != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            if (!_selectedVmfCode.HasValue)
            {
                _errorMessage = "Select a vehicle from the list.";
                return;
            }

            Navigation.NavigateTo($"/vehicles/{_selectedVmfCode.Value}/edit");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Search failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo("/vehicles");
    }

    private static List<VehicleDto> RankVehicleMatches(List<VehicleDto> matches, string query, string searchMode)
    {
        var keyword = query.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);
        var isInvoice = string.Equals(searchMode, "INVOICE", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isInvoice
                ? !string.IsNullOrWhiteSpace(v.invoice_number) && v.invoice_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                : (isGp
                    ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                    : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(v => isInvoice
                ? string.Equals(v.invoice_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                : (isGp
                    ? string.Equals(v.registration_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)
                    : string.Equals(v.fleet_number?.Trim(), keyword, StringComparison.OrdinalIgnoreCase)))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _errorMessage = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} | Inv: {ValueOrDash(vehicle.invoice_number)} ({vehicle.vmf_code})";

    private string GetSearchLabel()
        => _searchMode switch
        {
            "GG" => "GG Number",
            "GP" => "GP/Registration Number",
            "INVOICE" => "Invoice Number",
            _ => "Search Number"
        };

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed class SearchForm
    {
        [Required]
        public string SearchNumber { get; set; } = string.Empty;
    }
}
