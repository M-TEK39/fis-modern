@page "/vehicles/renumbered-report"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Report All Renumbered Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-git-compare"></i>
            Report All Renumbered Vehicles
        </h1>
        <p class="page-description">List of vehicles with recovered or renumbered GG references.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadAsync">Load Report</button>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading report...</p>
        </div>
    }
    else if (_hasLoaded && _results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No renumbered vehicles found</h3>
            <p>No records matched renumbered/recovered filters.</p>
        </div>
    }
    else if (_results.Count > 0)
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_results.Count vehicle(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Registration Number</th>
                            <th>Recovered GG</th>
                            <th>Renumbered To</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in PagedResults)
                        {
                            <tr>
                                <td>@ValueOrDash(vehicle.fleet_number)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@(string.IsNullOrWhiteSpace(vehicle.recovered_gg_number) ? "-" : vehicle.recovered_gg_number)</td>
                                <td>@(string.IsNullOrWhiteSpace(vehicle.renumbered_to) ? "-" : vehicle.renumbered_to)</td>
                                <td>@vehicle.status_description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                    <span>Page @_page of @TotalPages</span>
                    <button class="btn btn-secondary btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _hasLoaded;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<VehicleDto> _results = new();
    private IEnumerable<VehicleDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private async Task LoadAsync()
    {
        _loading = true;
        _hasLoaded = true;
        _results = new();
        try
        {
            var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
            _results = vehicles.Data
                .Where(v => !string.IsNullOrWhiteSpace(v.renumbered_to) || !string.IsNullOrWhiteSpace(v.recovered_gg_number))
                .OrderBy(v => v.fleet_number)
                .ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
