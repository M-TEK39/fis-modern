@page "/vehicles/{VmfCode:int}"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject VehicleApiService VehicleService
@inject VehicleDocumentApiService VehicleDocumentService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Details - Fleet Information System</PageTitle>

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading vehicle details...</p>
    </div>
}
else if (_vehicle == null)
{
    <div class="error-state">
        <i class="bx bx-error-circle"></i>
        <h3>Vehicle not found</h3>
        <p>The vehicle with VMF code @VmfCode could not be found.</p>
        <button class="btn btn-primary" @onclick="NavigateToList">
            <i class="bx bx-arrow-back"></i>
            Back to Vehicles
        </button>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <div class="alert alert-error fis-alert-bottom">
            <i class="bx bx-error-circle"></i>
            <span>@_actionError</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_actionSuccess))
    {
        <div class="alert alert-success fis-alert-bottom">
            <i class="bx bx-check-circle"></i>
            <span>@_actionSuccess</span>
        </div>
    }

    <div class="detail-header">
        <div class="breadcrumb">
            <button class="breadcrumb-link" @onclick="NavigateToList">
                <i class="bx bx-chevron-left"></i>
                Vehicles
            </button>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">@ValueOrDash(_vehicle.registration_number)</span>
        </div>
        
        <div class="detail-actions">
            <button class="btn btn-secondary" @onclick="() => NavigateToEdit(_vehicle.vmf_code)">
                <i class="bx bx-edit"></i>
                Edit Vehicle
            </button>
            <button class="btn btn-danger" @onclick="ShowDeleteConfirmation">
                <i class="bx bx-trash"></i>
                Delete
            </button>
        </div>
    </div>

    <div class="detail-content">
        <div class="detail-card primary-card">
            <div class="card-header">
                <div class="vehicle-title">
                    <h1 class="vehicle-reg">@ValueOrDash(_vehicle.registration_number)</h1>
                    <span class="vehicle-badge">@_vehicle.status_description</span>
                </div>
                <div class="vehicle-subtitle">
                    Vehicle ID: @_vehicle.vmf_code | Fleet Number: @ValueOrDash(_vehicle.fleet_number)
                </div>
            </div>
            
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-info-circle"></i>
                            Identification
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Fleet Number (GG)</span>
                                <span class="field-value">@ValueOrDash(_vehicle.fleet_number)</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Registration (GP)</span>
                                <span class="field-value">@ValueOrDash(_vehicle.registration_number)</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Asset Number</span>
                                <span class="field-value">@(_vehicle.asset_number ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Chassis Number</span>
                                <span class="field-value">@(_vehicle.chassis_number ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Engine Number</span>
                                <span class="field-value">@(_vehicle.engine_number_1 ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-car"></i>
                            Vehicle Specifications
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Model</span>
                                <span class="field-value">@(_vehicle.model_name ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Type</span>
                                <span class="field-value">@(_vehicle.type_name ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Year Manufactured</span>
                                <span class="field-value">@(_vehicle.year_manufactured?.ToString() ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Colour</span>
                                <span class="field-value">@(_vehicle.colour ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Transmission</span>
                                <span class="field-value">@(_vehicle.transmission ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Tare (kg)</span>
                                <span class="field-value">@(_vehicle.tare?.ToString("N0") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">GVM (kg)</span>
                                <span class="field-value">@(_vehicle.gvm?.ToString("N0") ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-tachometer"></i>
                            Odometer & Dates
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Take On Date</span>
                                <span class="field-value">@(_vehicle.take_on_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Take On Odo</span>
                                <span class="field-value">@((_vehicle.take_on_odo ?? 0).ToString("N0")) km</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Current Odo</span>
                                <span class="field-value">@((_vehicle.current_odo ?? 0).ToString("N0")) km</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Odo Last Updated</span>
                                <span class="field-value">@(_vehicle.odo_update_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Status</span>
                                <span class="field-value">@(_vehicle.status_description ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Location</span>
                                <span class="field-value">@(_vehicle.location_description ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-credit-card"></i>
                            Cards & Licensing
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Fuel Card Number</span>
                                <span class="field-value">@(_vehicle.fuel_card_number ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Fuel Card Date</span>
                                <span class="field-value">@(_vehicle.fuel_card_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Maint Card Number</span>
                                <span class="field-value">@(_vehicle.maint_card_number ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Maint Card Expiry</span>
                                <span class="field-value">@(_vehicle.maint_card_exdate?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Licence Due Date</span>
                                <span class="field-value">@(_vehicle.licence_due_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-wallet"></i>
                            Financial Information
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Purchase Date</span>
                                <span class="field-value">@(_vehicle.purchase_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Purchase Amount</span>
                                <span class="field-value">@(_vehicle.purchase_amount?.ToString("C") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Purchased From</span>
                                <span class="field-value">@(_vehicle.purchased_from ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Invoice Number</span>
                                @if (_editingInvoice)
                                {
                                    <div class="invoice-edit-row">
                                        <input class="form-input"
                                               @bind="_invoiceDraft"
                                               maxlength="60"
                                               placeholder="Enter invoice number" />
                                        <button class="btn btn-primary btn-sm"
                                                @onclick="SaveInvoiceNumberAsync"
                                                disabled="@_savingInvoice">
                                            @(_savingInvoice ? "Saving..." : "Save")
                                        </button>
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="CancelInvoiceEdit"
                                                disabled="@_savingInvoice">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="invoice-display-row">
                                        <span class="field-value">@ValueOrDash(_vehicle.invoice_number)</span>
                                        <button class="btn-icon btn-icon-edit"
                                                @onclick="StartInvoiceEdit"
                                                title="Edit invoice number">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="detail-field">
                                <span class="field-label">IFMS Vehicle Register Number</span>
                                <span class="field-value">@ValueOrDash(_vehicle.ifms_vehicle_register_number)</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">NATIS Model Number</span>
                                <span class="field-value">@ValueOrDash(_vehicle.natis_model_number)</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Book Value</span>
                                <span class="field-value">@(_vehicle.book_value?.ToString("C") ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Book Value Date</span>
                                <span class="field-value">@(_vehicle.book_value_date?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 class="section-title">
                            <i class="bx bx-wrench"></i>
                            Additional Details
                        </h3>
                        <div class="detail-fields">
                            <div class="detail-field">
                                <span class="field-label">Optional Extras</span>
                                <span class="field-value">@(_vehicle.optional_extras ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Tow Hitch</span>
                                <span class="field-value">@(_vehicle.tow_hitch ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Canopy</span>
                                <span class="field-value">@(_vehicle.canopy ?? "N/A")</span>
                            </div>
                            <div class="detail-field">
                                <span class="field-label">Additional Fuel Tank</span>
                                <span class="field-value">@(_vehicle.additional_fuel_tank?.ToString() ?? "N/A") L</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="detail-card">
            <div class="card-header">
                <div class="vehicle-title">
                    <h2 class="vehicle-reg" style="font-size:1.35rem;">Vehicle Documents</h2>
                </div>
                <div class="vehicle-subtitle">
                    Upload and view all documents linked to VMF @_vehicle.vmf_code.
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(_documentError))
                {
                    <div class="alert alert-error fis-alert-bottom">
                        <i class="bx bx-error-circle"></i>
                        <span>@_documentError</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_documentSuccess))
                {
                    <div class="alert alert-success fis-alert-bottom">
                        <i class="bx bx-check-circle"></i>
                        <span>@_documentSuccess</span>
                    </div>
                }

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Category Filter</label>
                        <select class="form-select" @bind="_documentCategoryFilter">
                            @foreach (var category in _documentCategories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Upload Category</label>
                        <select class="form-select" @bind="_uploadCategory">
                            @foreach (var category in _documentCategories.Where(c => c != "All"))
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Reference Type (Optional)</label>
                        <select class="form-select" @bind="_uploadReferenceType">
                            @foreach (var referenceType in _referenceTypes)
                            {
                                <option value="@referenceType">@referenceType</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Reference ID (Optional)</label>
                        <input class="form-input" type="number" min="1" @bind="_uploadReferenceIdText" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Document File</label>
                        <InputFile class="form-input"
                                   accept="@AllowedFileTypes"
                                   OnChange="OnDocumentSelected"
                                   @attributes="GetFileInputAttributes()" />
                        @if (_hasRearCamera)
                        {
                            <div class="form-hint">Rear camera detected. Capture is enforced on supported mobile browsers.</div>
                        }
                        else
                        {
                            <div class="form-hint">No rear camera detected. File upload is enabled.</div>
                        }
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary btn-sm" @onclick="LoadDocumentsAsync" disabled="_documentsLoading">Refresh</button>
                    <button class="btn btn-primary btn-sm" @onclick="UploadSelectedDocumentAsync" disabled="@(_selectedUploadFile is null || _documentsLoading)">Upload</button>
                </div>

                <div class="table-container fis-mt-15">
                    <div class="table-header">
                        <span class="table-title">Documents (@_documents.Count)</span>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Category</th>
                                    <th>File</th>
                                    <th>Type</th>
                                    <th>Size</th>
                                    <th>Reference</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_documentsLoading)
                                {
                                    <tr><td colspan="8">Loading documents...</td></tr>
                                }
                                else if (_documents.Count == 0)
                                {
                                    <tr><td colspan="8">No documents found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var document in _documents)
                                    {
                                        <tr>
                                            <td>@GetDocumentId(document)</td>
                                            <td>@ValueOrDash(document.Category)</td>
                                            <td>@ValueOrDash(document.FileName)</td>
                                            <td>@ValueOrDash(document.ContentType)</td>
                                            <td>@FormatFileSize(document.FileSizeBytes)</td>
                                            <td>@FormatReference(document)</td>
                                            <td>@(document.DateCreated?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                            <td class="actions-column">
                                                <div class="table-actions">
                                                    <button class="btn-icon btn-icon-view"
                                                            title="Download"
                                                            @onclick="() => DownloadDocumentAsync(document)">
                                                        <i class="bx bx-download"></i>
                                                    </button>
                                                    <button class="btn-icon btn-icon-delete"
                                                            title="Delete"
                                                            @onclick="() => DeleteDocumentAsync(document)">
                                                        <i class="bx bx-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_showDeleteDialog)
    {
        <div class="modal-overlay" @onclick="HideDeleteConfirmation">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Confirm Delete</h3>
                    <button class="modal-close" @onclick="HideDeleteConfirmation">
                        <i class="bx bx-x"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete vehicle <strong>@ValueOrDash(_vehicle.registration_number)</strong>?</p>
                    <p class="warning-text">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="HideDeleteConfirmation">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteVehicle" disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner-sm"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bx bx-trash"></i>
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int VmfCode { get; set; }

    private VehicleDto? _vehicle;
    private bool _loading = true;
    private bool _showDeleteDialog = false;
    private bool _deleting = false;
    private bool _savingInvoice;
    private bool _editingInvoice;
    private string _invoiceDraft = string.Empty;
    private string? _actionError;
    private string? _actionSuccess;
    private bool _documentsLoading;
    private bool _hasRearCamera;
    private List<VehicleDocumentDto> _documents = new();
    private string _documentCategoryFilter = "All";
    private string _uploadCategory = "General";
    private string _uploadReferenceType = "None";
    private string _uploadReferenceIdText = string.Empty;
    private IBrowserFile? _selectedUploadFile;
    private string? _documentError;
    private string? _documentSuccess;
    private const string AllowedFileTypes = ".jpg,.jpeg,.png,.gif,.webp,.heic,.pdf,.doc,.docx";
    private static readonly List<string> _documentCategories =
    [
        "All",
        "General",
        "Licence",
        "Accident",
        "Fine",
        "JobCard",
        "Contract",
        "TripAuthority",
        "Other"
    ];
    private static readonly List<string> _referenceTypes =
    [
        "None",
        "Accident",
        "Fine",
        "Licence",
        "JobCard",
        "Contract",
        "TripAuthority",
        "Other"
    ];

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicle();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadVehicle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _hasRearCamera = await JSRuntime.InvokeAsync<bool>("fisDevice.hasRearCamera");
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _hasRearCamera = false;
        }
    }

    private async Task LoadVehicle()
    {
        _loading = true;
        _actionError = null;
        _actionSuccess = null;
        _vehicle = await VehicleService.GetVehicleAsync(VmfCode);
        _editingInvoice = false;
        _invoiceDraft = _vehicle?.invoice_number ?? string.Empty;
        await LoadDocumentsAsync();
        _loading = false;
        StateHasChanged();
    }

    private void NavigateToList()
    {
        Navigation.NavigateTo("/vehicles");
    }

    private void NavigateToEdit(int vmfCode)
    {
        Navigation.NavigateTo($"/vehicles/{vmfCode}/edit");
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteDialog = true;
    }

    private void HideDeleteConfirmation()
    {
        _showDeleteDialog = false;
    }

    private async Task DeleteVehicle()
    {
        if (_vehicle == null) return;

        _deleting = true;
        var success = await VehicleService.DeleteVehicleAsync(_vehicle.vmf_code);
        _deleting = false;

        if (success)
        {
            NavigateToList();
        }
        else
        {
            _actionError = "Unable to delete vehicle. Please try again.";
            _showDeleteDialog = false;
        }
    }

    private void StartInvoiceEdit()
    {
        if (_vehicle == null)
        {
            return;
        }

        _actionError = null;
        _actionSuccess = null;
        _invoiceDraft = _vehicle.invoice_number ?? string.Empty;
        _editingInvoice = true;
    }

    private void CancelInvoiceEdit()
    {
        _editingInvoice = false;
        _invoiceDraft = _vehicle?.invoice_number ?? string.Empty;
    }

    private async Task SaveInvoiceNumberAsync()
    {
        if (_vehicle == null)
        {
            return;
        }

        _savingInvoice = true;
        _actionError = null;
        _actionSuccess = null;
        try
        {
            var result = await VehicleService.UpdateInvoiceNumberAsync(_vehicle.vmf_code, _invoiceDraft);
            if (!result.Success)
            {
                _actionError = result.Message;
                return;
            }

            _vehicle.invoice_number = string.IsNullOrWhiteSpace(_invoiceDraft)
                ? null
                : _invoiceDraft.Trim();
            _editingInvoice = false;
            _actionSuccess = "Request completed successfully.";
        }
        finally
        {
            _savingInvoice = false;
        }
    }

    private Dictionary<string, object> GetFileInputAttributes()
    {
        if (_hasRearCamera)
        {
            return new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
            {
                ["capture"] = "environment"
            };
        }

        return new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
    }

    private Task OnDocumentSelected(InputFileChangeEventArgs args)
    {
        _documentError = null;
        _documentSuccess = null;
        _selectedUploadFile = args.FileCount > 0 ? args.File : null;
        return Task.CompletedTask;
    }

    private async Task LoadDocumentsAsync()
    {
        if (_vehicle == null)
        {
            return;
        }

        _documentsLoading = true;
        _documentError = null;
        try
        {
            _documents = _documentCategoryFilter == "All"
                ? await VehicleDocumentService.GetDocumentsAsync(_vehicle.vmf_code)
                : await VehicleDocumentService.GetDocumentsAsync(_vehicle.vmf_code, _documentCategoryFilter);

            _documents = _documents
                .OrderByDescending(d => d.DateCreated ?? DateTime.MinValue)
                .ThenByDescending(d => GetDocumentId(d))
                .ToList();
        }
        finally
        {
            _documentsLoading = false;
        }
    }

    private async Task UploadSelectedDocumentAsync()
    {
        if (_vehicle == null || _selectedUploadFile == null)
        {
            return;
        }

        _documentError = null;
        _documentSuccess = null;

        if (_selectedUploadFile.Size > 20 * 1024 * 1024)
        {
            _documentError = "File exceeds 20 MB limit.";
            return;
        }

        var extension = Path.GetExtension(_selectedUploadFile.Name)?.ToLowerInvariant();
        var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".pdf", ".doc", ".docx"
        };
        if (string.IsNullOrWhiteSpace(extension) || !allowed.Contains(extension))
        {
            _documentError = "Unsupported file type.";
            return;
        }

        if (_hasRearCamera && !IsImageExtension(extension))
        {
            _documentError = "This device has a rear camera. Capture image documents instead of uploading non-image files.";
            return;
        }

        var parsedReferenceId = int.TryParse(_uploadReferenceIdText, out var value) && value > 0 ? value : (int?)null;
        var referenceType = _uploadReferenceType == "None" ? null : _uploadReferenceType;

        _documentsLoading = true;
        var result = await VehicleDocumentService.UploadAsync(
            _vehicle.vmf_code,
            _selectedUploadFile,
            _uploadCategory,
            referenceType,
            parsedReferenceId);
        _documentsLoading = false;

        if (!result.Success)
        {
            _documentError = result.Message;
            return;
        }

        _selectedUploadFile = null;
        _uploadReferenceIdText = string.Empty;
        _documentSuccess = "Request completed successfully.";
        await LoadDocumentsAsync();
    }

    private async Task DownloadDocumentAsync(VehicleDocumentDto document)
    {
        if (_vehicle == null)
        {
            return;
        }

        _documentError = null;
        var id = GetDocumentId(document);
        if (id <= 0)
        {
            _documentError = "Invalid document id.";
            return;
        }

        var file = await VehicleDocumentService.DownloadAsync(_vehicle.vmf_code, id);
        if (file == null)
        {
            _documentError = "Unable to download document.";
            return;
        }

        var base64 = Convert.ToBase64String(file.Content);
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadBase64", file.FileName, base64, file.ContentType);
    }

    private async Task DeleteDocumentAsync(VehicleDocumentDto document)
    {
        if (_vehicle == null)
        {
            return;
        }

        _documentError = null;
        var id = GetDocumentId(document);
        if (id <= 0)
        {
            _documentError = "Invalid document id.";
            return;
        }

        var success = await VehicleDocumentService.DeleteAsync(_vehicle.vmf_code, id);
        if (!success)
        {
            _documentError = "Unable to delete document.";
            return;
        }

        _documentSuccess = "Request completed successfully.";
        await LoadDocumentsAsync();
    }

    private static bool IsImageExtension(string extension)
        => extension is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".heic";

    private static int GetDocumentId(VehicleDocumentDto document)
        => document.Id > 0 ? document.Id : document.DocumentId;

    private static string FormatReference(VehicleDocumentDto document)
    {
        if (string.IsNullOrWhiteSpace(document.ReferenceType) || !document.ReferenceId.HasValue)
        {
            return "-";
        }

        return $"{document.ReferenceType} #{document.ReferenceId.Value}";
    }

    private static string FormatFileSize(long? fileSizeBytes)
    {
        if (!fileSizeBytes.HasValue || fileSizeBytes.Value <= 0)
        {
            return "-";
        }

        var kb = fileSizeBytes.Value / 1024d;
        if (kb < 1024d)
        {
            return $"{kb:N0} KB";
        }

        var mb = kb / 1024d;
        return $"{mb:N2} MB";
    }
}
