@page "/vehicles/recovered"
@rendermode InteractiveServer

<PageTitle>Update Recovered GG</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-refresh"></i>
            Update Recovered GG
        </h1>
        <p class="page-description">Legacy recovered vehicle update (UI-only until API endpoints are available).</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Recovered GG Number</label>
                    <input class="form-input" type="text" placeholder="Recovered GG number" />
                </div>
                <div class="form-field">
                    <label class="form-label">Renumbered To</label>
                    <input class="form-input" type="text" placeholder="New GG number" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary">Submit</button>
                <button class="btn btn-secondary">&lt; Cancel</button>
            </div>
        </div>
    </div>
</div>
