@page "/vehicles/recovered"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Update Recovered GG - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-refresh"></i>
            Update Recovered GG
        </h1>
        <p class="page-description">Search a vehicle and update recovered / renumbering details.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/vehicles">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-row">
                <label class="form-label">Number Type</label>
                <div class="contract-search-radio">
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                        GG
                    </label>
                    <label class="form-radio-label">
                        <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                        GP
                    </label>
                </div>
            </div>
            <div class="form-row">
                <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                <div class="fis-input-group-compact">
                    <input class="form-input" @bind="_searchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="SearchVehicleAsync">Find</button>
                </div>
                <select class="form-select fis-mt-05" @bind="_selectedVmfCode" @bind:after="ApplySelectedVehicle" disabled="@(_vehicleMatches.Count == 0)">
                    <option value="">Select vehicle...</option>
                    @foreach (var vehicle in _vehicleMatches)
                    {
                        <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="ApplySelectedVehicle" disabled="@(!_selectedVmfCode.HasValue)">Search</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _vehicle == null)
    {
        <div class="empty-state">
            <i class="bx bx-error-circle"></i>
            <h3>Vehicle not found</h3>
            <p>No vehicle matched the entered GG/GP number.</p>
        </div>
    }
    else if (_vehicle != null)
    {
        <div class="form-card fis-mt-1">
            <div class="form-card-header">
                <h2>Recovered Vehicle Details</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" value="@(ValueOrDash(_vehicle.fleet_number))" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Registration Number</label>
                        <input class="form-input" value="@(ValueOrDash(_vehicle.registration_number))" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Recovered GG Number</label>
                        <input class="form-input" @bind="_vehicle.recovered_gg_number" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Renumbered To</label>
                        <input class="form-input" @bind="_vehicle.renumbered_to" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Save</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _searchTerm = string.Empty;
    private string _searchMode = "GG";
    private bool _loading;
    private bool _saving;
    private bool _hasSearched;
    private VehicleDto? _vehicle;
    private int? _selectedVmfCode;
    private List<VehicleDto> _vehicleMatches = new();

    private async Task SearchVehicleAsync()
    {
        _loading = true;
        _hasSearched = true;
        _vehicle = null;
        _selectedVmfCode = null;
        try
        {
            var keyword = _searchTerm.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplySelectedVehicle()
    {
        if (!_selectedVmfCode.HasValue || _selectedVmfCode.Value <= 0)
        {
            _vehicle = null;
            return;
        }

        _vehicle = await VehicleService.GetVehicleAsync(_selectedVmfCode.Value);
    }

    private async Task SaveAsync()
    {
        if (_vehicle == null)
        {
            return;
        }

        _saving = true;
        try
        {
            var ok = await VehicleService.UpdateVehicleAsync(_vehicle.vmf_code, _vehicle);
            if (!ok)
            {
                await JSRuntime.InvokeVoidAsync("console.error", "Failed to update recovered vehicle details.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicle = null;
        _hasSearched = false;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }
}
