@page "/private-hire/reports/all-vehicles"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject PrivateHireApiService PrivateHireService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>All Private Hire Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Report On All Private Hire Vehicles
        </h1>
        <p class="page-description">Date Of Report: @DateTime.Now</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Back to Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Reg. No.</th>
                                <th>Model Description</th>
                                <th>Engine No.</th>
                                <th>Chassis No.</th>
                                <th>Site</th>
                                <th>Contracted To</th>
                                <th>Year Manufactured</th>
                                <th>Colour</th>
                                <th>Take On Date</th>
                                <th>Take On Odo</th>
                                <th>Return Date</th>
                                <th>Expiry Date (fuel card)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr>
                                    <td colspan="12">Loading records...</td>
                                </tr>
                            }
                            else if (_vehicles.Count == 0)
                            {
                                <tr>
                                    <td colspan="12">No records found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in PagedVehicles)
                                {
                                    <tr>
                                        <td>@ValueOrDash(row.registration_number)</td>
                                        <td>@ValueOrDash(row.make_model)</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>@GetSiteName(row.department_code)</td>
                                        <td>@ValueOrDash(row.contractor_name)</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>@FormatDate(row.hire_start_date)</td>
                                        <td>-</td>
                                        <td>@FormatDate(row.hire_end_date)</td>
                                        <td>-</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="form-hint" style="margin-top: 1rem; color: var(--fis-danger);">
                Total Number of Vehicles: @_vehicles.Count
            </div>
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private List<PrivateHireVehicleDto> _vehicles = new();
    private Dictionary<short, SiteResponseDto> _sitesByCode = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<PrivateHireVehicleDto> PagedVehicles => _vehicles.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_vehicles.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var sites = await SiteService.GetAllAsync();
            _sitesByCode = sites
                .Where(s => s.SiteCode > 0)
                .GroupBy(s => s.SiteCode)
                .ToDictionary(g => g.Key, g => g.First());

            _vehicles = await PrivateHireService.GetVehiclesAsync();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _vehicles = new();
            _sitesByCode = new();
            _page = 1;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading private hire vehicles report: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string GetSiteName(int siteCode)
    {
        if (siteCode <= 0)
        {
            return "-";
        }

        if (_sitesByCode.TryGetValue((short)siteCode, out var site))
        {
            return $"{site.Description} ({siteCode})";
        }

        return siteCode.ToString();
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
