@page "/private-hire/reports/all-vehicles"
@rendermode InteractiveServer

<PageTitle>All Private Hire Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            Report On All Private Hire Vehicles
        </h1>
        <p class="page-description">Date Of Report: @DateTime.Now</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Back to Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Reg. No.</th>
                                <th>Model Description</th>
                                <th>Engine No.</th>
                                <th>Chassis No.</th>
                                <th>Site</th>
                                <th>Contracted To</th>
                                <th>Year Manufactured</th>
                                <th>Colour</th>
                                <th>Take On Date</th>
                                <th>Take On Odo</th>
                                <th>Return Date</th>
                                <th>Expiry Date (fuel card)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="12">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="form-hint" style="margin-top: 1rem; color: var(--fis-danger);">
                Total Number of Vehicles: 0
            </div>
        </div>
    </div>
</div>
