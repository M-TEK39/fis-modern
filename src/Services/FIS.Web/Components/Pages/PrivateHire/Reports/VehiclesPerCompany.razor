@page "/private-hire/reports/vehicles-per-company"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Vehicles Per Hire Company - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-building"></i>
            Vehicles Per Hire Company
        </h1>
        <p class="page-description">Select a hire company for the report.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Back to Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p><strong>Select A Hire Company From The Drop Down List Below:</strong></p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Company</label>
                    <select class="form-select">
                        <option value="">Select...</option>
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Menu</a>
            </div>
            <LegacyEndpointActionPanel
                LegacyPath="Private_Hire/RPT_phv_vehicle_per_company1.aspx"
                Endpoint="api/privatehire/reports/vehicles-per-company"
                HttpMethod="GET"
                ButtonText="Run Vehicles per Company API"
                ReportType="private-hire-report-per-company" />
            <div class="form-hint" style="margin-top: 1rem;">Date Last Modified: [Legacy timestamp]</div>

            <div class="form-section" style="margin-top: 2rem;">
                <h3 class="form-section-title">
                    <i class="bx bx-list-ol"></i>
                    Vehicles Per Hire Company
                </h3>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Reg Number</th>
                                    <th>Contractor Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3">No records found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
