@page "/private-hire/reports/one-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>One Private Hire Vehicle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-search"></i>
            Report For One Private Hire Vehicle
        </h1>
        <p class="page-description">Report for a single vehicle (GP/registration number).</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Back to Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label"><strong>GP Number:</strong></label>
                    <input class="form-input" placeholder="Enter GP number" />
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Menu</a>
            </div>
            <LegacyEndpointActionPanel
                LegacyPath="Private_Hire/Get_gp.aspx"
                Endpoint="api/privatehire/search?searchTerm=GP"
                HttpMethod="GET"
                ButtonText="Run One Vehicle API"
                ReportType="private-hire-report-one-vehicle" />

            <div class="form-section" style="margin-top: 1.5rem;">
                <h3 class="form-section-title">REPORT FOR: [GP Number]</h3>
                <p class="form-hint">Date printed: @DateTime.Now</p>
            </div>

            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Reg. No.</th>
                                <th>Model Description</th>
                                <th>Engine No.</th>
                                <th>Chassis No.</th>
                                <th>Site</th>
                                <th>Contracted To</th>
                                <th>Year Manufactured</th>
                                <th>Colour</th>
                                <th>Take On Date</th>
                                <th>Take On Odo</th>
                                <th>Return Date</th>
                                <th>Expiry Date (fuel card)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="12">No records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
