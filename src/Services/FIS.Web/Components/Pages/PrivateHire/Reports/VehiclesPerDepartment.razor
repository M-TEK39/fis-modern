@page "/private-hire/reports/vehicles-per-department"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Private Hire Vehicles Per Department - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-group"></i>
            Private Hire Vehicles Per Department
        </h1>
        <p class="page-description">Select a department for the report.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Back to Reports</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p><strong>Select A Department From The Drop Down List Below:</strong></p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Department</label>
                    <select class="form-select">
                        <option value="0">Select...</option>
                    </select>
                </div>
            </div>
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm">Submit</button>
                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance?tab=reports">Menu</a>
            </div>
            <LegacyEndpointActionPanel
                LegacyPath="Private_Hire/RPT_phv_vehicle_per_dept1.aspx"
                Endpoint="api/privatehire/reports/vehicles-per-department"
                HttpMethod="GET"
                ButtonText="Run Vehicles per Department API"
                ReportType="private-hire-report-per-department" />
            <div class="form-hint" style="margin-top: 1rem;">Date Last Modified: [Legacy timestamp]</div>

            <div class="form-section" style="margin-top: 2rem;">
                <h3 class="form-section-title">
                    <i class="bx bx-buildings"></i>
                    Department / Site Results
                </h3>
                <p class="form-hint">Department: [Code] [Description] • Site: [Number] [Description]</p>
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Registration Number</th>
                                    <th>Model Description</th>
                                    <th>Colour</th>
                                    <th>Engine Number</th>
                                    <th>Chassis Number</th>
                                    <th>Take On Date</th>
                                    <th>Take On Odo</th>
                                    <th>Return Date</th>
                                    <th>Expiry Date (fuel card)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="9">No records found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-hint" style="margin-top: 1rem; color: var(--fis-danger);">
                    Total Number of Vehicles: 0
                </div>
            </div>
        </div>
    </div>
</div>
