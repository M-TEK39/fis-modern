@page "/private-hire"
@page "/Private_Hire/HV_menu.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject PrivateHireApiService PrivateHireService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Private Hire Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Private Hire Menu
        </h1>
        <p class="page-description">Private hire maintenance entry menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasPrivateHireVehiclesRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Private Hire Vehicles</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleMaintenance">
                <span>Maintenance</span>
                <i class="bx @(_showMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showMaintenance)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/private-hire/maintenance-menu">1) Maintain Private Hire Information</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/private-hire/demo-vehicles">2) Maintain Demo Vehicle Information</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <DataPreviewTable Title="Private Hire Vehicle Preview"
                      SearchPlaceholder="Search registration, contractor, department, status..."
                      EmptyMessage="No private hire vehicles match the current search or filter."
                      EmptyIcon="bx bx-car"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
    }
</div>

@code {
    private bool _hasPrivateHireVehiclesRole;
    private bool _showMaintenance = true;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("registration", "Registration"),
        new("makeModel", "Make / Model"),
        new("contractor", "Contractor"),
        new("department", "Department"),
        new("startDate", "Start Date"),
        new("endDate", "End Date"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Active hires", "statusGroup", "Active"),
        new("Retired hires", "statusGroup", "Retired"),
        new("Open-ended hires", "endDateStatus", "Open Ended"),
        new("Department-linked hires", "departmentStatus", "Department Linked")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasPrivateHireVehiclesRole = HasRole(authState.User, "Private Hire Vehicles");
        if (!_hasPrivateHireVehiclesRole)
        {
            _loading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private void ToggleMaintenance()
    {
        _showMaintenance = !_showMaintenance;
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var vehicles = await PrivateHireService.GetVehiclesAsync();
            _rows = vehicles
                .OrderBy(item => item.registration_number)
                .Select(item => new Dictionary<string, string?>
                {
                    ["registration"] = item.registration_number,
                    ["makeModel"] = item.make_model,
                    ["contractor"] = item.contractor_name,
                    ["department"] = item.department_name,
                    ["startDate"] = FormatDate(item.hire_start_date),
                    ["endDate"] = FormatDate(item.hire_end_date),
                    ["status"] = item.hire_status,
                    ["statusGroup"] = item.hire_end_date.HasValue || item.hire_status.Contains("retire", StringComparison.OrdinalIgnoreCase) ? "Retired" : "Active",
                    ["endDateStatus"] = item.hire_end_date.HasValue ? "End Date Set" : "Open Ended",
                    ["departmentStatus"] = item.department_code > 0 ? "Department Linked" : "No Department",
                    ["_href"] = $"/private-hire/maintenance-menu?registration={Uri.EscapeDataString(item.registration_number ?? string.Empty)}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading private hire preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
