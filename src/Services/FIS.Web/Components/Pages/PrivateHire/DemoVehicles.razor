@page "/private-hire/demo-vehicles"
@rendermode InteractiveServer
<PageTitle>Demo Vehicles - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Maintain Demo Vehicle Information
        </h1>
        <p class="page-description">Demo vehicle maintenance screen.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire">Back to Private Hire Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Use this screen to manage demo vehicle information.</p>
        </div>
    </div>
</div>
