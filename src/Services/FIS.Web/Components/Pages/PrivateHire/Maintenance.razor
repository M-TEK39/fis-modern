@page "/private-hire/maintenance"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Services
@using FIS.Web.Models
@inject PrivateHireApiService PrivateHireService

<PageTitle>Private Hire Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Private Hire Maintenance
        </h1>
        <p class="page-description">Private hire vehicle and contractor maintenance.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Back to Maintenance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "vehicles" ? "active" : "")" @onclick='() => SetActiveTab("vehicles")'>
            Private Hire Vehicles
        </button>
        <button class="tab @(_activeTab == "contractors" ? "active" : "")" @onclick='() => SetActiveTab("contractors")'>
            Private Hire Contractors
        </button>
        <button class="tab @(_activeTab == "reports" ? "active" : "")" @onclick='() => SetActiveTab("reports")'>
            Reports
        </button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "vehicles")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Private Hire Vehicles</h2>
                </div>
                <div class="form-card-body">
                    @if (!string.IsNullOrWhiteSpace(_actionMessage))
                    {
                        <div class="alert alert-info">@_actionMessage</div>
                    }
                    <div class="contract-action-group">
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("add")'>Add Vehicle</button>
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("edit")'>Edit Vehicle</button>
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("delete")'>Delete Vehicle</button>
                    </div>

                    @if (_vehicleMode == "add")
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Add A Private Hire Vehicle (without driver)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Password:</strong></label>
                                    <input type="password" class="form-input" maxlength="8" @bind="_addVehiclePassword" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("add-vehicle-password-check")'>Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Add An Existing Private Hire Vehicle (without driver)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>REG Number:</strong></label>
                                    <input class="form-input" placeholder="Enter registration" @bind="_vehicleSearch" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicles">Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Registration Matches</h3>
                            <div class="table-container">
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Reg. No.</th>
                                                <th>Take On Date</th>
                                                <th>Return Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (_vehicleMatches.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="4">No records found.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var match in PagedVehicleMatches)
                                                {
                                                    <tr>
                                                        <td>@ValueOrDash(match.registration_number)</td>
                                                        <td>@FormatDate(match.hire_start_date)</td>
                                                        <td>@FormatDate(match.hire_end_date)</td>
                                                        <td>
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => SelectVehicle(match)">Select</button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (TotalVehiclePages > 1)
                                {
                                    <div class="pagination-controls">
                                        <button class="btn btn-secondary btn-sm" @onclick="PreviousVehiclePage" disabled="@(_vehiclePage <= 1)">Previous</button>
                                        <span>Page @_vehiclePage of @TotalVehiclePages</span>
                                        <button class="btn btn-secondary btn-sm" @onclick="NextVehiclePage" disabled="@(_vehiclePage >= TotalVehiclePages)">Next</button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Vehicle Details (Add)</h3>
                            <div class="form-hint"><strong>Bold</strong> fields are required.</div>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Registration number</strong></label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.registration_number))" />
                                </div>
                                <div class="form-field form-group-full">
                                    <label class="form-label"><strong>Make &amp; Model</strong></label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.make_model))" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Site</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.department_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contracted to</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.department_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contractor (Hired from)</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.contractor_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Year Manufactured</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.hire_start_date?.Year.ToString()" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Colour</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Tank Capacity (Litres)</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Engine number</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Chassis number</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" value="@FormatDate(_selectedVehicle?.hire_start_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Odometer</strong></label>
                                    <input class="form-input" value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Km tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Hourly tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Daily tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Return Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" value="@FormatDate(_selectedVehicle?.hire_end_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Return Odometer</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("add-vehicle-save")'>Submit</button>
                            </div>
                        </div>
                    }
                    else if (_vehicleMode == "edit")
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Edit Private Hire Vehicle (without driver)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Password:</strong></label>
                                    <input type="password" class="form-input" maxlength="8" @bind="_editVehiclePassword" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("edit-vehicle-password-check")'>Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Find Vehicle to Edit</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>REG Number:</strong></label>
                                    <input class="form-input" placeholder="Enter registration" @bind="_vehicleSearch" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick="SearchVehicles">Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Registration Matches</h3>
                            <div class="table-container">
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Reg. No.</th>
                                                <th>Take On Date</th>
                                                <th>Return Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (_vehicleMatches.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="4">No records found.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var match in PagedVehicleMatches)
                                                {
                                                    <tr>
                                                        <td>@ValueOrDash(match.registration_number)</td>
                                                        <td>@FormatDate(match.hire_start_date)</td>
                                                        <td>@FormatDate(match.hire_end_date)</td>
                                                        <td>
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => SelectVehicle(match)">Select</button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (TotalVehiclePages > 1)
                                {
                                    <div class="pagination-controls">
                                        <button class="btn btn-secondary btn-sm" @onclick="PreviousVehiclePage" disabled="@(_vehiclePage <= 1)">Previous</button>
                                        <span>Page @_vehiclePage of @TotalVehiclePages</span>
                                        <button class="btn btn-secondary btn-sm" @onclick="NextVehiclePage" disabled="@(_vehiclePage >= TotalVehiclePages)">Next</button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Vehicle Details (Edit)</h3>
                            <div class="form-hint"><strong>Bold</strong> fields are required.</div>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Registration number</strong></label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.registration_number))" />
                                </div>
                                <div class="form-field form-group-full">
                                    <label class="form-label"><strong>Make &amp; Model</strong></label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Site</strong></label>
                                    <select class="form-select">
                                        <option value="0">Select...</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contracted to</strong></label>
                                    <select class="form-select">
                                        <option value="0">Select...</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contractor (Hired from)</strong></label>
                                    <select class="form-select">
                                        <option value="0">Select...</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Year Manufactured</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Colour</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Tank Capacity (Litres)</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Engine number</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Chassis number</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Odometer</strong></label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Km tariff</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Hourly tariff</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Daily tariff</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Return Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Return Odometer</label>
                                    <input class="form-input" />
                                </div>
                                <div class="form-field form-group-full">
                                    <label class="form-label">Expiry Date (fuel card)</label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.make_model))" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("edit-vehicle-load")'>Submit</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Delete A Private Hire Vehicle</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Password:</strong></label>
                                    <input type="password" class="form-input" maxlength="8" @bind="_deleteVehiclePassword" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("delete-vehicle-password-check")'>Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Find Vehicle to Delete</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>REG Number:</strong></label>
                                    <input class="form-input" placeholder="Enter registration" @bind="_vehicleSearch" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("delete-vehicle-load")'>Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Registration Matches</h3>
                            <div class="table-container">
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Reg. No.</th>
                                                <th>Take On Date</th>
                                                <th>Return Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="4">No records found.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Vehicle Details (Delete)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Registration Number</strong></label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.department_name" />
                                </div>
                                <div class="form-field form-group-full">
                                    <label class="form-label"><strong>Make &amp; Model</strong></label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.department_name" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Site</strong></label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.contractor_name" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contracted To</strong></label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contractor</strong></label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Year Manufactured</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Colour</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Tank Capacity</label>
                                    <input class="form-input" readonly value="@FormatDate(_selectedVehicle?.hire_start_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Engine Number</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Chassis Number</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Take On Date</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Take On Odometer</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">KM Tariff</label>
                                    <input class="form-input" readonly value="@FormatDate(_selectedVehicle?.hire_end_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Hourly Tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Daily Tariff</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Return Date</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Return Odometer</label>
                                    <input class="form-input" readonly />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-danger btn-sm" type="button" @onclick='() => HandleLegacySubmit("delete-vehicle-confirm")'>DELETE</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_activeTab == "contractors")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Private Hire Contractors</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-section">
                        <h3 class="form-section-title">Add New Contractor (Private Hire)</h3>
                        <div class="form-grid">
                            <div class="form-field form-group-full">
                                <label class="form-label"><strong>Name of Contractor:</strong></label>
                                <input class="form-input" @bind="_contractorName" />
                            </div>
                            <div class="form-field form-group-full">
                                <label class="form-label"><strong>Physical Address:</strong></label>
                                <input class="form-input" @bind="_contractorAddress" />
                            </div>
                            <div class="form-field form-group-full">
                                <label class="form-label"><strong>Postal Address:</strong></label>
                                <input class="form-input" @bind="_contractorPostalAddress" />
                            </div>
                            <div class="form-field">
                                <label class="form-label"><strong>Telephone number:</strong></label>
                                <input class="form-input" @bind="_contractorPhone" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Fax number:</label>
                                <input class="form-input" @bind="_contractorEmail" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">e-mail address:</label>
                                <input class="form-input" @bind="_contractorContactPerson" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Name of contact person:</label>
                                <input class="form-input" />
                            </div>
                            <div class="form-field">
                                <label class="form-label"><strong>Project name:</strong></label>
                                <input class="form-input" />
                            </div>
                            <div class="form-field">
                                <label class="form-label"><strong>Project begin date:</strong></label>
                                <input class="form-input" placeholder="Select date" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Project end date:</label>
                                <input class="form-input" placeholder="Select date" />
                            </div>
                        </div>
                        <div class="contract-action-group">
                            <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("add-contractor")'>Submit</button>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Edit Private Hire Contractor</h3>
                        <div class="form-grid">
                            <div class="form-field form-group-full">
                                <label class="form-label">Name of Contractor:</label>
                                <select class="form-select" @bind="_selectedContractorId">
                                    <option value="">Select contractor...</option>
                                    @foreach (var contractor in _contractors)
                                    {
                                        <option value="@contractor.contractor_id">@ValueOrDash(contractor.company_name)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="contract-action-group">
                            <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("edit-contractor-load")'>Submit</button>
                        </div>
                        <div class="form-grid fis-mt-1">
                            <div class="form-field form-group-full">
                                <label class="form-label">Physical Address:</label>
                                <input class="form-input" @bind="_contractorAddress" />
                            </div>
                            <div class="form-field form-group-full">
                                <label class="form-label">Postal Address:</label>
                                <input class="form-input" @bind="_contractorPostalAddress" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Telephone number:</label>
                                <input class="form-input" @bind="_contractorPhone" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Fax number:</label>
                                <input class="form-input" @bind="_contractorEmail" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">e-mail address:</label>
                                <input class="form-input" @bind="_contractorContactPerson" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Name of contact person:</label>
                                <input class="form-input" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Project name:</label>
                                <input class="form-input" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Project begin date:</label>
                                <input class="form-input" placeholder="Select date" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">Project end date:</label>
                                <input class="form-input" placeholder="Select date" />
                            </div>
                        </div>
                        <div class="contract-action-group">
                            <button class="btn btn-primary btn-sm" type="button" @onclick='() => HandleLegacySubmit("edit-contractor-save")'>Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Private Hire Reports</h2>
                </div>
                <div class="form-card-body">
                    <div class="menu-tiles">
                        <div class="menu-tile">
                            <div class="menu-tile-body">
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/all-vehicles">1) All Private Hire Vehicles</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/one-vehicle">2) One Private Hire Vehicle</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/contractors">3) Private Hire Contractors</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/vehicles-per-site">4) Private Hire Vehicles Per Site</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/vehicles-per-department">5) Private Hire Vehicles Per Department ( All )</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/vehicles-per-department-inservice">6) Private Hire Vehicles Per Department ( In Service )</a></div>
                                <div class="menu-item"><a class="menu-item-link" href="/private-hire/reports/vehicles-per-company">7) Private Hire Vehicles Per Hire Company</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _activeTab = "vehicles";
    private string _vehicleMode = "add";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Tab))
        {
            return;
        }

        switch (Tab.Trim().ToLowerInvariant())
        {
            case "vehicles":
                _activeTab = "vehicles";
                break;
            case "contractors":
                _activeTab = "contractors";
                break;
            case "reports":
                _activeTab = "reports";
                break;
        }
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
        _actionMessage = null;
    }

    private void SetVehicleMode(string mode)
    {
        _vehicleMode = mode;
        _vehiclePage = 1;
        _actionMessage = null;
    }

    private string _vehicleSearch = "";
    private string? _actionMessage;
    private string _addVehiclePassword = "";
    private string _editVehiclePassword = "";
    private string _deleteVehiclePassword = "";
    private int? _selectedContractorId;
    private List<PrivateHireContractorDto> _contractors = new();
    private string _contractorName = "";
    private string _contractorAddress = "";
    private string _contractorPostalAddress = "";
    private string _contractorPhone = "";
    private string _contractorEmail = "";
    private string _contractorContactPerson = "";
    private int _vehiclePage = 1;
    private const int _vehiclePageSize = 12;
    private List<PrivateHireVehicleDto> _vehicleMatches = new();
    private PrivateHireVehicleDto? _selectedVehicle;
    private IEnumerable<PrivateHireVehicleDto> PagedVehicleMatches => _vehicleMatches.Skip((_vehiclePage - 1) * _vehiclePageSize).Take(_vehiclePageSize);
    private int TotalVehiclePages => Math.Max(1, (int)Math.Ceiling(_vehicleMatches.Count / (double)_vehiclePageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
        await LoadContractors();
    }

    private async Task LoadVehicles()
    {
        var vehicles = await PrivateHireService.GetVehiclesAsync();
        _vehicleMatches = vehicles;
        _vehiclePage = 1;
    }

    private async Task SearchVehicles()
    {
        var vehicles = await PrivateHireService.GetVehiclesAsync();
        if (string.IsNullOrWhiteSpace(_vehicleSearch))
        {
            _vehicleMatches = vehicles;
            _vehiclePage = 1;
            return;
        }

        _vehicleMatches = vehicles.Where(v => v.registration_number.Contains(_vehicleSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        _vehiclePage = 1;
    }

    private async Task LoadContractors()
    {
        _contractors = await PrivateHireService.GetContractorsAsync();
    }

    private void SelectVehicle(PrivateHireVehicleDto vehicle)
    {
        _selectedVehicle = vehicle;
        _actionMessage = $"Selected vehicle {ValueOrDash(vehicle.registration_number)}.";
    }

    private async Task HandleLegacySubmit(string action)
    {
        try
        {
            switch (action)
            {
                case "add-vehicle-password-check":
                    _actionMessage = string.IsNullOrWhiteSpace(_addVehiclePassword)
                        ? "Password is required."
                        : "Password accepted. Continue with vehicle search and capture.";
                    break;
                case "edit-vehicle-password-check":
                    _actionMessage = string.IsNullOrWhiteSpace(_editVehiclePassword)
                        ? "Password is required."
                        : "Password accepted. Continue with vehicle search.";
                    break;
                case "delete-vehicle-password-check":
                    _actionMessage = string.IsNullOrWhiteSpace(_deleteVehiclePassword)
                        ? "Password is required."
                        : "Password accepted. Continue with vehicle search.";
                    break;
                case "add-vehicle-save":
                    if (_selectedVehicle is null)
                    {
                        _actionMessage = "Select a registration match first.";
                        break;
                    }

                    var createdVehicle = await PrivateHireService.CreateVehicleAsync(new PrivateHireVehicleDto
                    {
                        registration_number = _selectedVehicle.registration_number,
                        make_model = string.IsNullOrWhiteSpace(_selectedVehicle.make_model) ? "Unknown" : _selectedVehicle.make_model,
                        contractor_id = _selectedVehicle.contractor_id > 0 ? _selectedVehicle.contractor_id : 1,
                        contractor_name = _selectedVehicle.contractor_name,
                        department_code = _selectedVehicle.department_code > 0 ? _selectedVehicle.department_code : 1,
                        site_code = _selectedVehicle.site_code > 0 ? _selectedVehicle.site_code : _selectedVehicle.department_code,
                        department_name = _selectedVehicle.department_name,
                        hire_start_date = _selectedVehicle.hire_start_date ?? DateTime.Today,
                        hire_end_date = _selectedVehicle.hire_end_date,
                        monthly_rate = _selectedVehicle.monthly_rate,
                        hire_status = string.IsNullOrWhiteSpace(_selectedVehicle.hire_status) ? "Active" : _selectedVehicle.hire_status,
                        notes = _selectedVehicle.notes
                    });
                    await LoadVehicles();
                    _selectedVehicle = createdVehicle;
                    _actionMessage = $"Vehicle {ValueOrDash(createdVehicle.registration_number)} submitted.";
                    break;
                case "edit-vehicle-load":
                    _actionMessage = _selectedVehicle is null
                        ? "Select a registration match first."
                        : $"Loaded {ValueOrDash(_selectedVehicle.registration_number)} for editing.";
                    break;
                case "delete-vehicle-load":
                    await SearchVehicles();
                    _actionMessage = _vehicleMatches.Count == 0
                        ? "No registration matches found."
                        : $"Loaded {_vehicleMatches.Count} registration match(es).";
                    break;
                case "delete-vehicle-confirm":
                    if (_selectedVehicle is null || _selectedVehicle.vehicle_id <= 0)
                    {
                        _actionMessage = "Select a registration match first.";
                        break;
                    }

                    await PrivateHireService.DeleteVehicleAsync(_selectedVehicle.vehicle_id);
                    await LoadVehicles();
                    _actionMessage = $"Delete request submitted for {ValueOrDash(_selectedVehicle.registration_number)}.";
                    _selectedVehicle = null;
                    break;
                case "add-contractor":
                    if (string.IsNullOrWhiteSpace(_contractorName) || string.IsNullOrWhiteSpace(_contractorPhone) || string.IsNullOrWhiteSpace(_contractorContactPerson))
                    {
                        _actionMessage = "Contractor name, phone and contact person are required.";
                        break;
                    }

                    var created = await PrivateHireService.CreateContractorAsync(new PrivateHireContractorDto
                    {
                        company_name = _contractorName.Trim(),
                        address = _contractorAddress.Trim(),
                        business_registration = _contractorPostalAddress.Trim(),
                        phone = _contractorPhone.Trim(),
                        email = _contractorEmail.Trim(),
                        contact_person = _contractorContactPerson.Trim(),
                        status = "Active"
                    });
                    await LoadContractors();
                    _selectedContractorId = created.contractor_id;
                    _actionMessage = $"Contractor {ValueOrDash(created.company_name)} created.";
                    break;
                case "edit-contractor-load":
                    if (!_selectedContractorId.HasValue)
                    {
                        _actionMessage = "Select a contractor first.";
                        break;
                    }

                    var loaded = await PrivateHireService.GetContractorAsync(_selectedContractorId.Value);
                    if (loaded == null)
                    {
                        _actionMessage = "Selected contractor could not be loaded.";
                        break;
                    }

                    _contractorName = loaded.company_name;
                    _contractorAddress = loaded.address;
                    _contractorPostalAddress = loaded.business_registration;
                    _contractorPhone = loaded.phone;
                    _contractorEmail = loaded.email;
                    _contractorContactPerson = loaded.contact_person;
                    _actionMessage = $"Loaded contractor {ValueOrDash(loaded.company_name)}.";
                    break;
                case "edit-contractor-save":
                    if (!_selectedContractorId.HasValue)
                    {
                        _actionMessage = "Select a contractor first.";
                        break;
                    }

                    await PrivateHireService.UpdateContractorAsync(_selectedContractorId.Value, new PrivateHireContractorDto
                    {
                        contractor_id = _selectedContractorId.Value,
                        company_name = _contractorName.Trim(),
                        address = _contractorAddress.Trim(),
                        business_registration = _contractorPostalAddress.Trim(),
                        phone = _contractorPhone.Trim(),
                        email = _contractorEmail.Trim(),
                        contact_person = _contractorContactPerson.Trim(),
                        status = "Active"
                    });
                    await LoadContractors();
                    _actionMessage = $"Contractor {ValueOrDash(_contractorName)} updated.";
                    break;
                default:
                    _actionMessage = "Submit processed.";
                    break;
            }
        }
        catch (Exception ex)
        {
            _actionMessage = $"Submit failed: {ex.Message}";
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousVehiclePage()
    {
        if (_vehiclePage > 1)
        {
            _vehiclePage--;
        }
    }

    private void NextVehiclePage()
    {
        if (_vehiclePage < TotalVehiclePages)
        {
            _vehiclePage++;
        }
    }
}
