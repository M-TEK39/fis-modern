@page "/private-hire/maintenance"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Services
@using FIS.Web.Models
@inject PrivateHireApiService PrivateHireService

<PageTitle>Private Hire Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Private Hire Maintenance
        </h1>
        <p class="page-description">Private hire vehicle and contractor maintenance.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Back to Maintenance Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="tabs">
        <button class="tab @(_activeTab == "vehicles" ? "active" : "")" @onclick='() => SetActiveTab("vehicles")'>
            Private Hire Vehicles
        </button>
        <button class="tab @(_activeTab == "contractors" ? "active" : "")" @onclick='() => SetActiveTab("contractors")'>
            Private Hire Contractors
        </button>
        <button class="tab @(_activeTab == "reports" ? "active" : "")" @onclick='() => SetActiveTab("reports")'>
            Reports
        </button>
    </div>

    <div class="tab-content">
        @if (_activeTab == "vehicles")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Private Hire Vehicles</h2>
                </div>
                <div class="form-card-body">
                    <div class="contract-action-group">
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("add")'>Add Vehicle</button>
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("edit")'>Edit Vehicle</button>
                        <button class="btn btn-secondary btn-sm" @onclick='() => SetVehicleMode("delete")'>Delete Vehicle</button>
                    </div>

                    @if (_vehicleMode == "add")
                    {
                        <div class="form-section">
                            <h3 class="form-section-title">Add A Private Hire Vehicle (without driver)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Password:</strong></label>
                                    <input type="password" class="form-input" maxlength="8" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm">Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Add An Existing Private Hire Vehicle (without driver)</h3>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>REG Number:</strong></label>
                                    <input class="form-input" placeholder="Enter registration" @bind="_vehicleSearch" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm" @onclick="SearchVehicles">Submit</button>
                                <a class="btn btn-secondary btn-sm" href="/private-hire/maintenance-menu">Menu</a>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Registration Matches</h3>
                            <div class="table-container">
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Reg. No.</th>
                                                <th>Take On Date</th>
                                                <th>Return Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (_vehicleMatches.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="4">No records found.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var match in PagedVehicleMatches)
                                                {
                                                    <tr>
                                                        <td>@ValueOrDash(match.registration_number)</td>
                                                        <td>@FormatDate(match.hire_start_date)</td>
                                                        <td>@FormatDate(match.hire_end_date)</td>
                                                        <td>
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => SelectVehicle(match)">Select</button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (TotalVehiclePages > 1)
                                {
                                    <div class="pagination-controls">
                                        <button class="btn btn-secondary btn-sm" @onclick="PreviousVehiclePage" disabled="@(_vehiclePage <= 1)">Previous</button>
                                        <span>Page @_vehiclePage of @TotalVehiclePages</span>
                                        <button class="btn btn-secondary btn-sm" @onclick="NextVehiclePage" disabled="@(_vehiclePage >= TotalVehiclePages)">Next</button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="form-section-title">Vehicle Details (Add)</h3>
                            <div class="form-hint"><strong>Bold</strong> fields are required.</div>
                            <div class="form-grid">
                                <div class="form-field">
                                    <label class="form-label"><strong>Registration number</strong></label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.registration_number))" />
                                </div>
                                <div class="form-field form-group-full">
                                    <label class="form-label"><strong>Make &amp; Model</strong></label>
                                    <input class="form-input" readonly value="@(ValueOrDash(_selectedVehicle?.make_model))" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Site</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.department_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contracted to</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.department_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Contractor (Hired from)</strong></label>
                                    <select class="form-select">
                                        <option value="0">@(_selectedVehicle?.contractor_name ?? "Select...")</option>
                                    </select>
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Year Manufactured</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.hire_start_date?.Year.ToString()" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Colour</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Tank Capacity (Litres)</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Engine number</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Chassis number</label>
                                    <input class="form-input" readonly />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" value="@FormatDate(_selectedVehicle?.hire_start_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Take-on Odometer</strong></label>
                                    <input class="form-input" value="@_selectedVehicle?.notes" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Km tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Hourly tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Daily tariff</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.monthly_rate?.ToString("N2")" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label"><strong>Return Date</strong></label>
                                    <input class="form-input" readonly placeholder="Select date" value="@FormatDate(_selectedVehicle?.hire_end_date)" />
                                </div>
                                <div class="form-field">
                                    <label class="form-label">Return Odometer</label>
                                    <input class="form-input" readonly value="@_selectedVehicle?.notes" />
                                </div>
                            </div>
                            <div class="contract-action-group">
                                <button class="btn btn-primary btn-sm">Submit</button>
                            </div>
                        </div>
                    }
                    else if (_vehicleMode == "edit")
