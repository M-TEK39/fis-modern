@code {
    private string _activeTab = "vehicles";
    private string _vehicleMode = "add";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Tab))
        {
            return;
        }

        switch (Tab.Trim().ToLowerInvariant())
        {
            case "vehicles":
                _activeTab = "vehicles";
                break;
            case "contractors":
                _activeTab = "contractors";
                break;
            case "reports":
                _activeTab = "reports";
                break;
        }
    }

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }

    private void SetVehicleMode(string mode)
    {
        _vehicleMode = mode;
        _vehiclePage = 1;
    }

    private string _vehicleSearch = "";
    private int _vehiclePage = 1;
    private const int _vehiclePageSize = 12;
    private List<PrivateHireVehicleDto> _vehicleMatches = new();
    private PrivateHireVehicleDto? _selectedVehicle;
    private IEnumerable<PrivateHireVehicleDto> PagedVehicleMatches => _vehicleMatches.Skip((_vehiclePage - 1) * _vehiclePageSize).Take(_vehiclePageSize);
    private int TotalVehiclePages => Math.Max(1, (int)Math.Ceiling(_vehicleMatches.Count / (double)_vehiclePageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        var vehicles = await PrivateHireService.GetVehiclesAsync();
        _vehicleMatches = vehicles;
        _vehiclePage = 1;
    }

    private async Task SearchVehicles()
    {
        var vehicles = await PrivateHireService.GetVehiclesAsync();
        if (string.IsNullOrWhiteSpace(_vehicleSearch))
        {
            _vehicleMatches = vehicles;
            _vehiclePage = 1;
            return;
        }

        _vehicleMatches = vehicles.Where(v => v.registration_number.Contains(_vehicleSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        _vehiclePage = 1;
    }

    private void SelectVehicle(PrivateHireVehicleDto vehicle)
    {
        _selectedVehicle = vehicle;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void PreviousVehiclePage()
    {
        if (_vehiclePage > 1)
        {
            _vehiclePage--;
        }
    }

    private void NextVehiclePage()
    {
        if (_vehiclePage < TotalVehiclePages)
        {
            _vehiclePage++;
        }
    }
}
