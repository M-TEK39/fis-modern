@page "/vehicle-verification"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Vehicle Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Asset Verification
        </h1>
        <p class="page-description">Verification records. Static entries until verification API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadVerifications">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading verification records...</p>
        </div>
    }
    else if (_verifications.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-clipboard"></i>
            <h3>No verification records</h3>
            <p>Awaiting verification API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_verifications.Count Verification record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Verification #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Verifier</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var verification in _verifications)
                        {
                            <tr>
                                <td>@verification.Number</td>
                                <td>@verification.Vehicle</td>
                                <td><span class="badge">@verification.Status</span></td>
                                <td>@verification.Date.ToString("yyyy-MM-dd")</td>
                                <td>@verification.Verifier</td>
                                <td>@verification.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<VerificationItem> _verifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVerifications();
    }

    private Task LoadVerifications()
    {
        _loading = true;

        _verifications =
        [
            new("VER-2401-001", "ABC123GP", "Open", new DateTime(2025, 01, 12), "Auditor A", "Pending document upload."),
            new("VER-2401-002", "JKL456GP", "In Progress", new DateTime(2025, 01, 09), "Auditor B", "Physical check scheduled."),
            new("VER-2312-006", "MNO789GP", "Closed", new DateTime(2024, 12, 16), "Auditor A", "Closed and archived."),
            new("VER-2311-004", "PQR321GP", "Closed", new DateTime(2024, 11, 25), "Auditor C", "Legacy reference.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record VerificationItem(string Number, string Vehicle, string Status, DateTime Date, string Verifier, string Notes);
}
