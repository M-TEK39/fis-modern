@page "/vehicle-verification"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Asset Verification
        </h1>
        <p class="page-description">Asset Verification Maintenance Menu</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Asset Verification.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVerificationInfo">
                    <span>Asset Verification Maintenance Information / Help</span>
                    <i class="bx @(_showVerificationInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVerificationInfo)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/help">Asset Verification Maintenance Information / Help</a>
                        </div>
                    </div>
                }
            </div>
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVerificationMaintenance">
                    <span>Asset Verification Maintenance</span>
                    <i class="bx @(_showVerificationMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVerificationMaintenance)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/add">1) Add Asset Verification Details</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/edit">2) Edit Asset Verification Details</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _showVerificationInfo = true;
    private bool _showVerificationMaintenance = true;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;

        _authResolved = true;
    }

    private void ToggleVerificationInfo()
    {
        _showVerificationInfo = !_showVerificationInfo;
    }

    private void ToggleVerificationMaintenance()
    {
        _showVerificationMaintenance = !_showVerificationMaintenance;
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
