@page "/vehicle-verification"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject AssetVerificationApiService AssetVerificationService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Asset Verification
        </h1>
        <p class="page-description">Asset Verification Maintenance Menu</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Asset Verification.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVerificationInfo">
                    <span>Asset Verification Maintenance Information / Help</span>
                    <i class="bx @(_showVerificationInfo ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVerificationInfo)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/help">Asset Verification Maintenance Information / Help</a>
                        </div>
                    </div>
                }
            </div>
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleVerificationMaintenance">
                    <span>Asset Verification Maintenance</span>
                    <i class="bx @(_showVerificationMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showVerificationMaintenance)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/add">1) Add Asset Verification Details</a>
                        </div>
                        <div class="menu-item">
                            <a class="menu-item-link" href="/vehicle-verification/edit">2) Edit Asset Verification Details</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <DataPreviewTable Title="Asset Verification Preview"
                          SearchPlaceholder="Search registration, department, site, status, manager..."
                          EmptyMessage="No asset verification records match the current search or filter."
                          EmptyIcon="bx bx-clipboard"
                          IsLoading="_loading"
                          Columns="_columns"
                          Rows="_rows"
                          Filters="_filters" />
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _showVerificationInfo = true;
    private bool _showVerificationMaintenance = true;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("registration", "Registration"),
        new("vmfCode", "GG Code"),
        new("department", "Department"),
        new("site", "Site"),
        new("verificationDate", "Verified"),
        new("status", "Status"),
        new("manager", "Manager")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Verified vehicles", "verificationGroup", "Verified"),
        new("Pending verification", "verificationGroup", "Pending"),
        new("Vehicles with barcode", "barcodeStatus", "Barcode Captured"),
        new("Vehicles with petrol card", "petrolCardStatus", "Petrol Card")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (_hasVehicleAccess)
        {
            await LoadPreviewAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;

        _authResolved = true;
    }

    private void ToggleVerificationInfo()
    {
        _showVerificationInfo = !_showVerificationInfo;
    }

    private void ToggleVerificationMaintenance()
    {
        _showVerificationMaintenance = !_showVerificationMaintenance;
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var records = await AssetVerificationService.GetAllAsync<AssetVerificationRecord>();
            _rows = records
                .OrderByDescending(item => item.verification_date ?? item.date_last_verified ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["registration"] = item.vehicle_reg_no,
                    ["vmfCode"] = item.vmf_code?.ToString(),
                    ["department"] = item.department_name,
                    ["site"] = item.site_name ?? item.site_code?.ToString(),
                    ["verificationDate"] = FormatDate(item.verification_date ?? item.date_last_verified),
                    ["status"] = item.verification_status,
                    ["manager"] = item.responsible_manager,
                    ["verificationGroup"] = IsVerified(item.verification_status) ? "Verified" : "Pending",
                    ["barcodeStatus"] = string.IsNullOrWhiteSpace(item.barcode_number ?? item.barcode) ? "No Barcode" : "Barcode Captured",
                    ["petrolCardStatus"] = string.IsNullOrWhiteSpace(item.petrol_card) ? "No Petrol Card" : "Petrol Card"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading asset verification preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsVerified(string? status)
    {
        return status?.Contains("verified", StringComparison.OrdinalIgnoreCase) == true ||
            status?.Contains("complete", StringComparison.OrdinalIgnoreCase) == true;
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
