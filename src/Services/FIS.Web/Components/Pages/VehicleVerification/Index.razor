@page "/vehicle-verification"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject AssetVerificationApiService AssetVerificationService
@inject IJSRuntime JS

<PageTitle>Vehicle Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Vehicle Asset Verification
        </h1>
        <p class="page-description">Verification records from /api/assetverification.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadVerifications">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading verification records...</p>
        </div>
    }
    else if (_verifications.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-clipboard"></i>
            <h3>No verification records</h3>
            <p>Awaiting verification API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_verifications.Count Verification record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Verification #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Verifier</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var verification in _verifications)
                        {
                            <tr>
                                <td>@verification.Number</td>
                                <td>@verification.Vehicle</td>
                                <td><span class="badge">@verification.Status</span></td>
                                <td>@verification.Date.ToString("yyyy-MM-dd")</td>
                                <td>@verification.Verifier</td>
                                <td>@verification.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<VerificationItem> _verifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVerifications();
    }

    private async Task LoadVerifications()
    {
        _loading = true;
        try
        {
            var apiItems = await AssetVerificationService.GetAllAsync<AssetVerificationDto>();
            _verifications = apiItems.Select(v => new VerificationItem(
                Number: v.asset_verification_code.ToString(),
                Vehicle: v.vehicle_reg_no ?? v.vmf_code?.ToString() ?? "Unknown",
                Status: v.asset_verification_complete ? "Closed" : "Open",
                Date: v.verification_date ?? DateTime.MinValue,
                Verifier: v.responsible_manager ?? "N/A",
                Notes: v.verified_notes ?? v.site_name ?? string.Empty
            )).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading asset verifications: {ex.Message}");
            _verifications = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record VerificationItem(string Number, string Vehicle, string Status, DateTime Date, string Verifier, string Notes);

    private sealed class AssetVerificationDto
    {
        public int asset_verification_code { get; set; }
        public int? vmf_code { get; set; }
        public string? vehicle_reg_no { get; set; }
        public string? site_name { get; set; }
        public string? responsible_manager { get; set; }
        public string? verified_notes { get; set; }
        public bool asset_verification_complete { get; set; }
        public DateTime? verification_date { get; set; }
    }
}
