@page "/vehicle-verification/edit"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleLookupApiService VehicleLookupService
@inject NavigationManager Navigation

<PageTitle>Edit Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Edit Asset Verification
        </h1>
        <p class="page-description">Search and select a vehicle to proceed.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <EditForm Model="_formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Lookup Type</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="verificationEditSearchType" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="verificationEditSearchType" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                Reg Number
                            </label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Vehicle Number <span class="required">*</span></label>
                        <div class="fis-input-group-compact">
                            <InputText class="form-input" @bind-Value="_searchTerm" maxlength="16" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehicleAsync">Find</button>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Vehicle Match <span class="required">*</span></label>
                        <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                            <option value="">Select vehicle...</option>
                            @foreach (var vehicle in _vehicleMatches)
                            {
                                <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-error fis-alert-tight">
                        <i class="bx bx-error-circle"></i>
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Submit</button>
                    <button type="button" class="btn btn-secondary" @onclick="GoMenu">Menu</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private readonly object _formModel = new();
    private string _searchTerm = "";
    private string _searchMode = "GG";
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        if (!_selectedVmfCode.HasValue)
        {
            await SearchVehicleAsync();
        }

        if (!_selectedVmfCode.HasValue)
        {
            _errorMessage = "Select a vehicle before continuing.";
            return;
        }

        var selected = _vehicleMatches.FirstOrDefault(v => v.VmfCode == _selectedVmfCode.Value);
        if (selected == null)
        {
            _errorMessage = "Selected vehicle is no longer available. Search again.";
            return;
        }

        var query = _searchMode == "GG"
            ? GetGGNumber(selected)
            : selected.RegistrationNumber;
        query = string.IsNullOrWhiteSpace(query)
            ? (_searchMode == "GG" ? selected.RegistrationNumber : GetGGNumber(selected))
            : query;

        if (string.IsNullOrWhiteSpace(query))
        {
            _errorMessage = "Selected vehicle has no valid GG/GP identifier.";
            return;
        }

        _errorMessage = null;
        Navigation.NavigateTo($"/vehicle-verification/edit/details?gg={Uri.EscapeDataString(query)}");
    }

    private async Task SearchVehicleAsync()
    {
        _errorMessage = null;
        _selectedVmfCode = null;
        _vehicleMatches = new();

        var query = (_searchTerm ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _errorMessage = _searchMode == "GG" ? "Enter a GG number to search." : "Enter a GP number to search.";
            return;
        }

        var matches = await VehicleLookupService.SearchAsync(query);
        _vehicleMatches = FilterVehicleMatches(matches, query, _searchMode);
        if (_vehicleMatches.Count == 0)
        {
            _errorMessage = "No vehicles matched your search.";
        }
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchTerm = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _errorMessage = null;
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(GetGGNumber(vehicle));
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(GetGGNumber(v)) && GetGGNumber(v)!.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(GetGGNumber(v)?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private static string? GetGGNumber(VehicleLookupDto vehicle)
        => string.IsNullOrWhiteSpace(vehicle.GGNumber) ? vehicle.FleetNumber : vehicle.GGNumber;

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void GoMenu()
    {
        Navigation.NavigateTo("/vehicle-verification");
    }
}
