@page "/vehicle-verification/edit"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Edit Asset Verification - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-clipboard"></i>
            Edit Asset Verification
        </h1>
        <p class="page-description">Enter GG/GP number to proceed.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <EditForm OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">REG Number <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_ggNumber" maxlength="8" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-error" style="margin-top: 1rem;">
                        <i class="bx bx-error-circle"></i>
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Submit</button>
                    <button type="button" class="btn btn-secondary" @onclick="GoMenu">Menu</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private string _ggNumber = "";
    private string? _errorMessage;

    private void HandleSubmit()
    {
        var query = (_ggNumber ?? string.Empty).Trim();
        if (query.Length < 7 || query.Length > 8)
        {
            _errorMessage = "Please enter a valid GG/GP number.";
            return;
        }

        _errorMessage = null;
        Navigation.NavigateTo($"/vehicle-verification/edit/details?gg={Uri.EscapeDataString(query)}");
    }

    private void GoMenu()
    {
        Navigation.NavigateTo("/vehicle-verification");
    }
}
