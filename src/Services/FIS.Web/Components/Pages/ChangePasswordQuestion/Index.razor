@page "/change-password-question"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Change Password &amp; Question - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-key"></i>
            Change Password &amp; Question
        </h1>
        <p class="page-description">Legacy password and security question placeholder. Static entries until API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadEntries">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading password/question records...</p>
        </div>
    }
    else if (_entries.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-key"></i>
            <h3>No password/question updates</h3>
            <p>Awaiting API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_entries.Count Entry(ies)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th>Question</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr>
                                <td>@entry.User</td>
                                <td><span class="badge">@entry.Status</span></td>
                                <td>@entry.LastUpdated.ToString("yyyy-MM-dd")</td>
                                <td>@entry.Question</td>
                                <td>@entry.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<PasswordQuestionEntry> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private Task LoadEntries()
    {
        _loading = true;

        _entries =
        [
            new("admin", "Active", new DateTime(2025, 01, 12), "Favorite vehicle?", "Updated password and question."),
            new("support", "Pending", new DateTime(2025, 01, 10), "Mother's maiden name?", "Awaiting confirmation."),
            new("driver_mgr", "Expired", new DateTime(2024, 12, 15), "First school?", "Reset required."),
            new("audit", "Active", new DateTime(2024, 11, 28), "City of birth?", "Recent change.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record PasswordQuestionEntry(string User, string Status, DateTime LastUpdated, string Question, string Notes);
}
