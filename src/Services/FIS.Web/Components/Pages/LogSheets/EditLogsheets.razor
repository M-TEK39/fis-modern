@page "/log-sheets/edit"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject LogsheetApiService LogsheetService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Edit Logsheets - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit-alt"></i>
            Edit Logsheets
        </h1>
        <p class="page-description">Legacy Logs/RPT_Editlogsform.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Requisition Number</label>
            <input class="form-input" @bind="_requisition" />
        </div>
        <div class="form-row">
            <label class="form-label">Fleet Number</label>
            <input class="form-input" @bind="_fleetNumber" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SearchLogsheets">Search</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_logsheets.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-pencil"></i>
            <h3>No logsheets found</h3>
            <p>Search by requisition or fleet number.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logsheets.Count logsheet(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Requisition</th>
                            <th>VMF Code</th>
                            <th>Month</th>
                            <th>Odometer</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var logsheet in _logsheets)
                        {
                            <tr>
                                <td>@logsheet.rek_num</td>
                                <td>@logsheet.vmf_code</td>
                                <td>@logsheet.month.ToString("yyyy-MM-dd")</td>
                                <td>@logsheet.start_odo - @logsheet.end_odo</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => EditLogsheet(logsheet)">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showForm && _editing != null)
    {
        <Modal IsVisible="_showForm" Title="Edit Logsheet" ShowFooter="false" OnCancel="HideForm">
            <ChildContent>
                <div class="form-card">
                    <div class="form-row">
                        <label class="form-label">Requisition Number</label>
                        <input class="form-input" @bind="_editing.rek_num" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Month</label>
                        <input type="date" class="form-input" @bind="_editing.month" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Start Odometer</label>
                        <input type="number" class="form-input" @bind="_editing.start_odo" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">End Odometer</label>
                        <input type="number" class="form-input" @bind="_editing.end_odo" />
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SaveLogsheet">Submit</button>
                        <button class="btn btn-secondary" @onclick="HideForm">Cancel</button>
                    </div>
                </div>
            </ChildContent>
        </Modal>
    }
</div>


    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Editlogsform.aspx"
        Endpoint="api/logsheet/edit/1"
        HttpMethod="PUT"
        ButtonText="Test Logsheet Edit Endpoint"
        ReportType="logsheet-edit" />

@code {
    private bool _loading;
    private bool _showForm;
    private string _requisition = string.Empty;
    private string _fleetNumber = string.Empty;
    private List<LogsheetDto> _logsheets = new();
    private LogsheetDto? _editing;

    private async Task SearchLogsheets()
    {
        _loading = true;
        _logsheets = new List<LogsheetDto>();
        try
        {
            var all = await LogsheetService.GetAllAsync<LogsheetDto>();
            if (!string.IsNullOrWhiteSpace(_requisition))
            {
                _logsheets = all.Where(l => string.Equals(l.rek_num, _requisition, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            else if (!string.IsNullOrWhiteSpace(_fleetNumber))
            {
                var matches = await VehicleLookupService.SearchAsync(_fleetNumber);
                var vmfCode = matches.FirstOrDefault()?.VmfCode;
                if (vmfCode.HasValue)
                {
                    _logsheets = all.Where(l => l.vmf_code == vmfCode.Value).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void EditLogsheet(LogsheetDto logsheet)
    {
        _editing = new LogsheetDto
        {
            log_code = logsheet.log_code,
            vmf_code = logsheet.vmf_code,
            start_odo = logsheet.start_odo,
            end_odo = logsheet.end_odo,
            month = logsheet.month,
            site_code = logsheet.site_code,
            rek_num = logsheet.rek_num,
            days_used = logsheet.days_used,
            bund_num = logsheet.bund_num
        };
        _showForm = true;
    }

    private async Task SaveLogsheet()
    {
        if (_editing == null)
        {
            return;
        }

        try
        {
            await LogsheetService.UpdateAsync(_editing.log_code, _editing);
            _showForm = false;
            await SearchLogsheets();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private async Task HideForm()
    {
        _showForm = false;
        await InvokeAsync(StateHasChanged);
    }
}
