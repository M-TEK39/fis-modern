@page "/log-sheets/delete"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LogsheetApiService LogsheetService
@inject VehicleLookupApiService VehicleLookupService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Delete Logsheet - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete a Logsheet
        </h1>
        <p class="page-description">Logsheet delete workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Requisition Number</label>
            <input class="form-input" @bind="_requisition" />
        </div>
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
            <input class="form-input" @bind="_fleetNumber" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SearchLogsheets">Search</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_hasSearched && _logsheets.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-error-circle"></i>
            <h3>No logsheets found</h3>
            <p>Search for logsheets to delete.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logsheets.Count logsheet(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Requisition</th>
                            <th>Vehicle</th>
                            <th>Month</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var logsheet in PagedLogsheets)
                        {
                            <tr>
                                <td>@logsheet.rek_num</td>
                                <td>@GetVehicleLabel(logsheet.vmf_code)</td>
                                <td>@logsheet.month.ToString("yyyy-MM-dd")</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-delete" @onclick="() => DeleteLogsheet(logsheet)">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_logsheets.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_logsheets.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _hasSearched;
    private string _searchMode = "GG";
    private string _requisition = string.Empty;
    private string _fleetNumber = string.Empty;
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<LogsheetDto> _logsheets = new();
    private Dictionary<int, string> _vehicleLabelByVmf = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<LogsheetDto> PagedLogsheets => _logsheets.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_logsheets.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicleLookupAsync();
    }

    private async Task SearchLogsheets()
    {
        _loading = true;
        _hasSearched = true;
        _logsheets = new List<LogsheetDto>();
        try
        {
            var all = await LogsheetService.GetAllAsync<LogsheetDto>();
            if (!string.IsNullOrWhiteSpace(_requisition))
            {
                _logsheets = all.Where(l => string.Equals(l.rek_num, _requisition, StringComparison.OrdinalIgnoreCase)).ToList();
                _page = 1;
                _vehicleMatches = new();
                _selectedVmfCode = null;
            }
            else if (!string.IsNullOrWhiteSpace(_fleetNumber))
            {
                var searchTerm = _fleetNumber.Trim();
                var matches = await VehicleLookupService.SearchAsync(searchTerm);
                _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _searchMode);
                if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
                {
                    _selectedVmfCode = null;
                }
                if (_selectedVmfCode.HasValue)
                {
                    _logsheets = all.Where(l => l.vmf_code == _selectedVmfCode.Value).ToList();
                    _page = 1;
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteLogsheet(LogsheetDto logsheet)
    {
        try
        {
            await LogsheetService.DeleteAsync(logsheet.log_code);
            _logsheets.Remove(logsheet);
            if (_page > TotalPages)
            {
                _page = TotalPages;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _logsheets = new();
        _page = 1;
    }

    private async Task LoadVehicleLookupAsync()
    {
        var vehicles = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 5000);
        _vehicleLabelByVmf = vehicles.Data
            .GroupBy(v => v.vmf_code)
            .ToDictionary(
                g => g.Key,
                g => FormatVehicleLabel(g.First()));
    }

    private string GetVehicleLabel(int? vmfCode)
    {
        if (!vmfCode.HasValue)
        {
            return "-";
        }

        return _vehicleLabelByVmf.TryGetValue(vmfCode.Value, out var label)
            ? label
            : vmfCode.Value.ToString();
    }

    private static string FormatVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";
}
