@page "/log-sheets/delete"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LogsheetApiService LogsheetService
@inject VehicleLookupApiService VehicleLookupService
@inject IJSRuntime JSRuntime

<PageTitle>Delete Logsheet - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-trash"></i>
            Delete a Logsheet
        </h1>
        <p class="page-description">Legacy Logs/MNT_Logs_Delete.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Requisition Number</label>
            <input class="form-input" @bind="_requisition" />
        </div>
        <div class="form-row">
            <label class="form-label">Fleet Number</label>
            <input class="form-input" @bind="_fleetNumber" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SearchLogsheets">Search</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_logsheets.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-error-circle"></i>
            <h3>No logsheets found</h3>
            <p>Search for logsheets to delete.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logsheets.Count logsheet(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Requisition</th>
                            <th>VMF Code</th>
                            <th>Month</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var logsheet in _logsheets)
                        {
                            <tr>
                                <td>@logsheet.rek_num</td>
                                <td>@logsheet.vmf_code</td>
                                <td>@logsheet.month.ToString("yyyy-MM-dd")</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-delete" @onclick="() => DeleteLogsheet(logsheet)">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string _requisition = string.Empty;
    private string _fleetNumber = string.Empty;
    private List<LogsheetDto> _logsheets = new();

    private async Task SearchLogsheets()
    {
        _loading = true;
        _logsheets = new List<LogsheetDto>();
        try
        {
            var all = await LogsheetService.GetAllAsync<LogsheetDto>();
            if (!string.IsNullOrWhiteSpace(_requisition))
            {
                _logsheets = all.Where(l => string.Equals(l.rek_num, _requisition, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            else if (!string.IsNullOrWhiteSpace(_fleetNumber))
            {
                var matches = await VehicleLookupService.SearchAsync(_fleetNumber);
                var vmfCode = matches.FirstOrDefault()?.VmfCode;
                if (vmfCode.HasValue)
                {
                    _logsheets = all.Where(l => l.vmf_code == vmfCode.Value).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteLogsheet(LogsheetDto logsheet)
    {
        try
        {
            await LogsheetService.DeleteAsync(logsheet.log_code);
            _logsheets.Remove(logsheet);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }
}
