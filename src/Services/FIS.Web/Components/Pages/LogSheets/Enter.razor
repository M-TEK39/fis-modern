@page "/log-sheets/enter"
@page "/Logs/Log_Entry_A.aspx"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LogsheetApiService LogsheetService
@inject VehicleLookupApiService VehicleLookupService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Enter Logsheet - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit"></i>
            Enter a Logsheet
        </h1>
        <p class="page-description">Logsheet capture workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <h3 class="section-title">Step 1: Select Vehicle</h3>
        <div class="form-row">
            <label class="form-label">Batch Number</label>
            <input class="form-input" @bind="_bundNum" />
        </div>
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
            <input class="form-input" @bind="_vehicleSearch" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="LoadVehicle">Next</button>
        </div>
    </div>

    @if (_showForm)
    {
        <div class="form-card">
            <h3 class="section-title">Step 2: Enter Logsheet</h3>
            <div class="form-row">
                <label class="form-label">Requisition Number</label>
                <input class="form-input" @bind="_logsheet.rek_num" />
            </div>
            <div class="form-row">
                <label class="form-label">Logsheet From Date</label>
                <input type="date" class="form-input" @bind="_logsheet.month" />
            </div>
            <div class="form-row">
                <label class="form-label">Start Odometer</label>
                <input type="number" class="form-input" @bind="_logsheet.start_odo" />
            </div>
            <div class="form-row">
                <label class="form-label">End Odometer</label>
                <input type="number" class="form-input" @bind="_logsheet.end_odo" />
            </div>
            <div class="form-row">
                <label class="form-label">Days Used</label>
                <input type="number" class="form-input" @bind="_logsheet.days_used" />
            </div>
            <div class="form-row">
                <label class="form-label">Site</label>
                <select class="form-select" @bind="_logsheet.site_code">
                    <option value="">Select site</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SubmitLogsheet">Submit</button>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>Vehicle not found</h3>
            <p>@_statusMessage</p>
        </div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Processing...</p>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _showForm;
    private string _searchMode = "GG";
    private string _vehicleSearch = string.Empty;
    private string _bundNum = string.Empty;
    private string _statusMessage = string.Empty;
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private LogsheetDto _logsheet = new();
    private List<SiteResponseDto> _sites = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task LoadVehicle()
    {
        _statusMessage = string.Empty;
        _loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_vehicleSearch))
            {
                _vehicleMatches = new();
                _selectedVmfCode = null;
                _showForm = false;
                _statusMessage = "Enter a GG or GP number to search.";
                return;
            }

            var searchTerm = _vehicleSearch.Trim();
            var matches = await VehicleLookupService.SearchAsync(searchTerm);
            _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _searchMode);
            if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }

            if (!_selectedVmfCode.HasValue)
            {
                _showForm = false;
                _statusMessage = _vehicleMatches.Count == 0
                    ? "No vehicle was found for the GG/GP number entered."
                    : "Select a vehicle from the match list.";
                return;
            }

            _logsheet.vmf_code = _selectedVmfCode.Value;
            if (int.TryParse(_bundNum, out var bundle))
            {
                _logsheet.bund_num = bundle;
            }
            _showForm = true;
            _statusMessage = string.Empty;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitLogsheet()
    {
        _loading = true;
        try
        {
            await LogsheetService.CreateAsync(_logsheet);
            _logsheet = new LogsheetDto();
            _showForm = false;
            _vehicleSearch = string.Empty;
            _bundNum = string.Empty;
            _statusMessage = string.Empty;
            _vehicleMatches = new();
            _selectedVmfCode = null;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _showForm = false;
        _statusMessage = string.Empty;
    }
}
