@page "/log-sheets"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LogsheetApiService LogsheetService
@inject IJSRuntime JSRuntime

<PageTitle>Logsheet Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-table"></i>
            Logsheet Maintenance Menu
        </h1>
        <p class="page-description">Logsheet maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Logsheet Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/help">Logsheet Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Logsheet Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/enter">1) Enter a Logsheet</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/delete">3) Delete a Logsheet</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/reports/captured">4) Report: Logsheets captured</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/reports/total-km">5) Report: Total Km per Class Code</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-sheets/edit">8) Edit Logsheets</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Logsheet Preview"
                      SearchPlaceholder="Search GG code, requisition, bundle, site..."
                      EmptyMessage="No logsheets match the current search or filter."
                      EmptyIcon="bx bx-table"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("month", "Month"),
        new("vmfCode", "GG Code"),
        new("startOdo", "Start Odo"),
        new("endOdo", "End Odo"),
        new("daysUsed", "Days Used"),
        new("site", "Site"),
        new("requisition", "Requisition")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("With requisition", "requisitionStatus", "Requisition Captured"),
        new("Without requisition", "requisitionStatus", "No Requisition"),
        new("Usage days captured", "usageStatus", "Usage Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var logsheets = await LogsheetService.GetAllAsync<LogsheetDto>();
            _rows = logsheets
                .OrderByDescending(item => item.month)
                .Select(item => new Dictionary<string, string?>
                {
                    ["month"] = item.month.ToString("yyyy-MM"),
                    ["vmfCode"] = item.vmf_code.ToString(),
                    ["startOdo"] = item.start_odo.ToString("0"),
                    ["endOdo"] = item.end_odo.ToString("0"),
                    ["daysUsed"] = item.days_used?.ToString(),
                    ["site"] = item.site_code.ToString(),
                    ["requisition"] = item.rek_num,
                    ["requisitionStatus"] = string.IsNullOrWhiteSpace(item.rek_num) ? "No Requisition" : "Requisition Captured",
                    ["usageStatus"] = item.days_used.HasValue ? "Usage Captured" : "No Usage"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading logsheet preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
