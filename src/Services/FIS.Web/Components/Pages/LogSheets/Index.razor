@page "/log-sheets"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Log Sheets - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-table"></i>
            Log Sheets
        </h1>
        <p class="page-description">Log sheet summary. Static entries until log sheet API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadLogSheets">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading log sheets...</p>
        </div>
    }
    else if (_logSheets.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-table"></i>
            <h3>No log sheets</h3>
            <p>Awaiting log sheet API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logSheets.Count Log sheet(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Vehicle</th>
                            <th>Trips</th>
                            <th>Status</th>
                            <th>Submitted By</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sheet in _logSheets)
                        {
                            <tr>
                                <td>@sheet.Date.ToString("yyyy-MM-dd")</td>
                                <td>@sheet.Vehicle</td>
                                <td>@sheet.TripCount</td>
                                <td><span class="badge">@sheet.Status</span></td>
                                <td>@sheet.SubmittedBy</td>
                                <td>@sheet.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<LogSheetItem> _logSheets = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLogSheets();
    }

    private Task LoadLogSheets()
    {
        _loading = true;

        _logSheets =
        [
            new(new DateTime(2025, 01, 12), "ABC123GP", 4, "Open", "Depot North", "Awaiting supervisor sign-off."),
            new(new DateTime(2025, 01, 11), "JKL456GP", 3, "In Progress", "Depot South", "Pending odometer verification."),
            new(new DateTime(2024, 12, 15), "MNO789GP", 5, "Closed", "Depot North", "Archived."),
            new(new DateTime(2024, 11, 30), "PQR321GP", 2, "Closed", "Depot West", "Legacy log sheet reference.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record LogSheetItem(DateTime Date, string Vehicle, int TripCount, string Status, string SubmittedBy, string Notes);
}
