@using FIS.Web.Components.Shared
@page "/log-sheets/reports/total-km"
@rendermode InteractiveServer

<PageTitle>Total Km per Class Code - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-bar-chart-alt-2"></i>
            Report: Total Km per Class Code
        </h1>
        <p class="page-description">Legacy placeholder for Logs/RPT_log_per_year.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-chart"></i>
        <h3>Report pending</h3>
        <p>This page will mirror the legacy total kilometer report.</p>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="Logs/RPT_Log_per_year.aspx"
        Endpoint="api/logsheet/reports/total-km-per-class-code"
        HttpMethod="POST"
        ButtonText="Test Total KM per Class Code Endpoint"
        ReportType="logsheet-report-total-km" />

</div>
