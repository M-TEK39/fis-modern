@page "/vehicle-orders"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Vehicle Orders - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cart"></i>
            Vehicle Orders
        </h1>
        <p class="page-description">Vehicle Master Inception Maintenance</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Orders.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleInceptionMenu">
                    <span>Vehicle Master Inception Maintenance</span>
                    <i class="bx @(_showInceptionMenu ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showInceptionMenu)
                {
                    <div class="menu-tile-body">
                        @if (_canCaptureInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/create">1) Add / Edit New Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/gg-block-numbers">2) Add GG Block Number(s)</a>
                            </div>
                        }
                        @if (_canAuthorizeInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/authorize">Authorize Captured Vehicle Information</a>
                            </div>
                        }
                        <div class="menu-item">
                            <a class="menu-item-link" href="/home">Return to Main Report Page.</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _showInceptionMenu = true;
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _canCaptureInception;
    private bool _canAuthorizeInception;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;

        _canCaptureInception = HasRole(user, "vehicle inception capturer");
        _canAuthorizeInception = HasRole(user, "vehicle inception authorizer");

        if (_hasVehicleAccess && !_canCaptureInception && !_canAuthorizeInception)
        {
            _canCaptureInception = true;
            _canAuthorizeInception = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private void ToggleInceptionMenu()
    {
        _showInceptionMenu = !_showInceptionMenu;
    }
}
