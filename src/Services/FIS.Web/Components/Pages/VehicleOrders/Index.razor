@page "/vehicle-orders"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Orders - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cart"></i>
            Vehicle Orders
        </h1>
        <p class="page-description">Vehicle Master Inception Maintenance</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading access profile...</p>
        </div>
    }
    else if (!_hasVehicleAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>You do not have permission to access Vehicle Orders.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles fis-menu-tiles-bottom">
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleInceptionMenu">
                    <span>Vehicle Master Inception Maintenance</span>
                    <i class="bx @(_showInceptionMenu ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showInceptionMenu)
                {
                    <div class="menu-tile-body">
                        @if (_canCaptureInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/create">1) Add / Edit New Vehicle</a>
                            </div>
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/gg-block-numbers">2) Add GG Block Number(s)</a>
                            </div>
                        }
                        @if (_canAuthorizeInception)
                        {
                            <div class="menu-item">
                                <a class="menu-item-link" href="/vehicles/authorize">Authorize Captured Vehicle Information</a>
                            </div>
                        }
                        <div class="menu-item">
                            <a class="menu-item-link" href="/home">Return to Main Report Page.</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <DataPreviewTable Title="Vehicle Inception Preview"
                          SearchPlaceholder="Search GG number, registration, model, status..."
                          EmptyMessage="No vehicle inception records match the current search or filter."
                          EmptyIcon="bx bx-cart"
                          IsLoading="_loading"
                          Columns="_columns"
                          Rows="_rows"
                          Filters="_filters" />
    }
</div>

@code {
    private bool _showInceptionMenu = true;
    private bool _authResolved;
    private bool _hasVehicleAccess;
    private bool _canCaptureInception;
    private bool _canAuthorizeInception;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("fleetNumber", "GG Number"),
        new("registration", "Registration"),
        new("model", "Model"),
        new("type", "Type"),
        new("status", "Status"),
        new("capturedDate", "Captured")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Captured vehicles", "captureStatus", "Captured"),
        new("Pending capture date", "captureStatus", "Pending Capture"),
        new("Recovered vehicles", "recoveredStatus", "Recovered"),
        new("Renumbered vehicles", "renumberedStatus", "Renumbered")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (_hasVehicleAccess)
        {
            await LoadPreviewAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        _hasVehicleAccess =
            (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;

        _canCaptureInception = HasRole(user, "vehicle inception capturer");
        _canAuthorizeInception = HasRole(user, "vehicle inception authorizer");

        if (_hasVehicleAccess && !_canCaptureInception && !_canAuthorizeInception)
        {
            _canCaptureInception = true;
            _canAuthorizeInception = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private void ToggleInceptionMenu()
    {
        _showInceptionMenu = !_showInceptionMenu;
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var result = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 250);
            _rows = result.Data
                .OrderByDescending(item => item.captured_date ?? item.take_on_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["fleetNumber"] = item.fleet_number,
                    ["registration"] = item.registration_number,
                    ["model"] = item.model_name ?? item.model_code.ToString(),
                    ["type"] = item.type_name ?? item.type_code.ToString(),
                    ["status"] = item.status_description ?? item.vehicle_status_code.ToString(),
                    ["capturedDate"] = FormatDate(item.captured_date ?? item.take_on_date),
                    ["captureStatus"] = item.captured_date.HasValue || item.take_on_date.HasValue ? "Captured" : "Pending Capture",
                    ["recoveredStatus"] = string.IsNullOrWhiteSpace(item.recovered_gg_number) ? "Not Recovered" : "Recovered",
                    ["renumberedStatus"] = string.IsNullOrWhiteSpace(item.renumbered_to) ? "Not Renumbered" : "Renumbered"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading vehicle inception preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
