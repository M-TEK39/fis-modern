@page "/vehicle-orders"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject VehicleOrderApiService VehicleOrderService
@inject IJSRuntime JS

<PageTitle>Vehicle Orders - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-cart"></i>
            Vehicle Orders
        </h1>
        <p class="page-description">Vehicle Orders replaced by Vehicle Inception in legacy.</p>
    </div>
</div>

<div class="page-content">
    <span style="display:none">@_loading</span>
    <span style="display:none">@_orders.Count</span>
    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleInceptionMenu">
                <span>Vehicle Master Inception Maintenance</span>
                <i class="bx @(_showInceptionMenu ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showInceptionMenu)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/vehicles/create">1) Add / Edit New Vehicle</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/vehicles/gg-block-numbers">2) Add GG Block Number(s)</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/vehicles/authorize">Authorize Captured Vehicle Information</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/home">Return to Main Report Page.</a>
                    </div>
                    <div class="menu-item" style="margin-top:0.5rem;">
                        <span class="form-hint">Legacy access is role-based (capturer vs authorizer).</span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Existing API-driven table kept for future reuse once legacy module is confirmed. *@
    @*
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading vehicle orders...</p>
        </div>
    }
    else if (_orders.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-cart"></i>
            <h3>No vehicle orders</h3>
            <p>Awaiting vehicle order API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_orders.Count Order(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Ordered</th>
                            <th>Expected</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _orders)
                        {
                            <tr>
                                <td>@order.Number</td>
                                <td>@order.Vehicle</td>
                                <td><span class="badge">@order.Status</span></td>
                                <td>@order.Ordered.ToString("yyyy-MM-dd")</td>
                                <td>@order.Expected.ToString("yyyy-MM-dd")</td>
                                <td>@order.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    *@
</div>

@code {
    private bool _loading = true;
    private List<VehicleOrderItem> _orders = new();
    private bool _showInceptionMenu = true;

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            var apiItems = await VehicleOrderService.GetAllAsync<VehicleOrderDto>();
            _orders = apiItems.Select(o => new VehicleOrderItem(
                VmfCode: o.vmf_code,
                Number: o.vehicle_order_code.ToString(),
                Vehicle: o.vmf_code?.ToString() ?? "Unknown",
                Status: o.order_status ?? "Unknown",
                Ordered: o.order_date ?? DateTime.MinValue,
                Expected: o.delivery_date ?? o.order_date ?? DateTime.MinValue,
                Notes: o.order_notes ?? string.Empty
            )).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading vehicle orders: {ex.Message}");
            _orders = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleInceptionMenu()
    {
        _showInceptionMenu = !_showInceptionMenu;
    }

    private sealed record VehicleOrderItem(int? VmfCode, string Number, string Vehicle, string Status, DateTime Ordered, DateTime Expected, string Notes);

    private sealed class VehicleOrderDto
    {
        public int vehicle_order_code { get; set; }
        public int? vmf_code { get; set; }
        public string? order_status { get; set; }
        public DateTime? order_date { get; set; }
        public DateTime? delivery_date { get; set; }
        public string? order_notes { get; set; }
    }
}
