@page "/job-cards/repair-cost-report"
@rendermode InteractiveServer
@using FIS.Web.Services
@using FIS.Web.Models
@inject JobCardApiService JobCardService
@inject VehicleApiService VehicleService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Repair Cost Report</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-receipt"></i>
            Repair Cost Report
        </h1>
        <p class="page-description">Vehicle repair cost report for workshop and client department reconciliation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/capturer-default">Main Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Vehicle</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" type="text" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                    <div class="form-actions fis-mt-05">
                        <button class="btn btn-secondary btn-sm" type="button" disabled="@_loading" @onclick="LoadVehicleMatchesAsync">Search vehicle</button>
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Match</label>
                    <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                        <option value="">All vehicles</option>
                        @foreach (var vehicle in _vehicleMatches)
                        {
                            <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_selectedSiteCode">
                        <option value="">All sites</option>
                        @foreach (var site in _sites.OrderBy(s => s.Description))
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">From Date</label>
                    <input class="form-input" type="date" @bind="_fromDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">To Date</label>
                    <input class="form-input" type="date" @bind="_toDate" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" disabled="@_loading" @onclick="LoadAsync">Search</button>
                <button class="btn btn-secondary" disabled="@_loading" @onclick="ClearFilters">Clear</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading repair cost report...</p>
        </div>
    }
    else if (_report.Items.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No cost records found</h3>
            <p>Adjust filters or capture costs when closing job cards.</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Totals</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Labour Total</label>
                        <input class="form-input" value="@FormatCurrency(_report.TotalLabour)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Parts Total</label>
                        <input class="form-input" value="@FormatCurrency(_report.TotalParts)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Other Total</label>
                        <input class="form-input" value="@FormatCurrency(_report.TotalOther)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Grand Total</label>
                        <input class="form-input" value="@FormatCurrency(_report.GrandTotal)" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_report.Items.Count line item(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Card #</th>
                            <th>GG Number</th>
                            <th>Registration</th>
                            <th>Vehicle</th>
                            <th>Site</th>
                            <th>Service Provider</th>
                            <th>Invoice #</th>
                            <th>Invoice Date</th>
                            <th>Labour</th>
                            <th>Parts</th>
                            <th>Other</th>
                            <th>Total</th>
                            <th>Closed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr>
                                <td>@item.JobCardId</td>
                                <td>@ValueOrDash(item.GGNumber)</td>
                                <td>@ValueOrDash(item.RegistrationNumber)</td>
                                <td>@GetVehicleLabel(item)</td>
                                <td>@FormatSite(item.SiteCode)</td>
                                <td>@ValueOrDash(item.ServiceProvider)</td>
                                <td>@ValueOrDash(item.InvoiceNumber)</td>
                                <td>@FormatDate(item.InvoiceDate)</td>
                                <td>@FormatCurrency(item.LabourCost)</td>
                                <td>@FormatCurrency(item.PartsCost)</td>
                                <td>@FormatCurrency(item.OtherCost)</td>
                                <td>@FormatCurrency(item.TotalCost)</td>
                                <td>@FormatDate(item.DateClosed)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_report.Items.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_report.Items.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _isError;
    private string _message = string.Empty;
    private string _searchMode = "GG";
    private string _vehicleSearchTerm = string.Empty;
    private int? _selectedVmfCode;
    private int? _selectedSiteCode;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private JobCardRepairCostReportDto _report = new();
    private List<VehicleDto> _vehicleMatches = new();
    private List<SiteResponseDto> _sites = new();
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<JobCardRepairCostLineDto> PagedItems
        => _report.Items.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private int TotalPages
        => Math.Max(1, (int)Math.Ceiling(_report.Items.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            _report = await JobCardService.GetRepairCostReportAsync(
                _selectedVmfCode,
                _selectedSiteCode,
                _fromDate,
                _toDate);
            _page = 1;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Could not load repair cost report.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading repair cost report: {ex.Message}");
            _report = new JobCardRepairCostReportDto();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearFilters()
    {
        _vehicleSearchTerm = string.Empty;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _selectedSiteCode = null;
        _fromDate = null;
        _toDate = null;
        await LoadAsync();
    }

    private async Task LoadVehicleMatchesAsync()
    {
        _message = string.Empty;
        if (string.IsNullOrWhiteSpace(_vehicleSearchTerm))
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            return;
        }

        try
        {
            var keyword = _vehicleSearchTerm.Trim();
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);

            if (_vehicleMatches.All(v => v.vmf_code != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Could not search vehicles.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error searching vehicles: {ex.Message}");
            _vehicleMatches = new();
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string FormatCurrency(decimal value)
        => value.ToString("C2");

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(JobCardRepairCostLineDto item)
        => $"{ValueOrDash(item.GGNumber)} / {ValueOrDash(item.RegistrationNumber)} ({item.VmfCode?.ToString() ?? "-"})";

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }

    private string FormatSite(int? siteCode)
    {
        if (!siteCode.HasValue)
        {
            return "-";
        }

        var site = _sites.FirstOrDefault(s => s.SiteCode == siteCode.Value);
        return site is null ? siteCode.Value.ToString() : $"{site.Description} ({siteCode.Value})";
    }
}
