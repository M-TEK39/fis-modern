@page "/job-cards/print"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject JobCardApiService JobCardService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Print Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-printer"></i>
            Print Job Cards
        </h1>
        <p class="page-description">Enter GG Number to view authorized job cards ready for printing.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/capturer-default">Main Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading permissions...</p>
        </div>
    }
    else if (!_canCapturer)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>Your profile does not include Job Card capturer access.</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" @bind="_searchGg" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_loading">Search</button>
                    <button class="btn btn-secondary" @onclick="Clear" disabled="@_loading">Clear</button>
                    <button class="btn btn-secondary" @onclick="PrintAll" disabled="@(_filtered.Count == 0)">Print All Assigned Jobcards</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading job cards...</p>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="empty-state">
                <i class="bx bx-info-circle"></i>
                <h3>No Job Cards Found</h3>
                <p>No authorized job cards were found for printing.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <div class="table-header">
                    <span class="table-title">@_filtered.Count job card(s)</span>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Job Card #</th>
                                <th>GG Number</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Assigned Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr>
                                    <td>@item.JobCardId</td>
                                    <td>@ValueOrDash(item.GGNumber)</td>
                                    <td>@ValueOrDash(item.JobDescription)</td>
                                    <td>@ValueOrDash(item.Status)</td>
                                    <td>@ValueOrDash(item.AssignedToName)</td>
                                    <td>@FormatDate(item.AssignedDate)</td>
                                    <td class="actions-column">
                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="() => PrintRow(item)">
                                            Print
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_selected is not null)
        {
            <div class="form-card print-sheet">
                <div class="form-card-header">
                    <h2>Print Preview: Job Card @(_selected.JobCardId)</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Job Card Number</label>
                            <input class="form-input" value="@_selected.JobCardId" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">GG Number</label>
                            <input class="form-input" value="@ValueOrDash(_selected.GGNumber)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Registration Number</label>
                            <input class="form-input" value="@ValueOrDash(_selected.RegistrationNumber)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Status</label>
                            <input class="form-input" value="@ValueOrDash(_selected.Status)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Assigned To</label>
                            <input class="form-input" value="@ValueOrDash(_selected.AssignedToName)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Assigned Date</label>
                            <input class="form-input" value="@FormatDate(_selected.AssignedDate)" readonly />
                        </div>
                        <div class="form-field form-group-full">
                            <label class="form-label">Description</label>
                            <textarea class="form-input" rows="2" readonly>@ValueOrDash(_selected.JobDescription)</textarea>
                        </div>
                        <div class="form-field form-group-full">
                            <label class="form-label">Comments</label>
                            <textarea class="form-input" rows="3" readonly>@ValueOrDash(_selected.Comments)</textarea>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _authResolved;
    private bool _canCapturer;
    private bool _loading = true;
    private bool _isError;
    private string _searchGg = string.Empty;
    private string _message = string.Empty;
    private List<JobCardDto> _all = new();
    private List<JobCardDto> _filtered = new();
    private JobCardDto? _selected;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_canCapturer)
        {
            _loading = false;
            return;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var gg = _searchGg.Trim();
            _all = string.IsNullOrWhiteSpace(gg)
                ? await JobCardService.GetAllAsync()
                : await JobCardService.GetByGGNumberAsync(gg);

            _filtered = _all
                .Where(IsPrintableStatus)
                .OrderByDescending(x => x.DateCreated)
                .ToList();
            _selected = _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            _selected = null;
            _isError = true;
            _message = "Unable to load job cards.";
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading printable job cards: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void Clear()
    {
        _searchGg = string.Empty;
        _filtered = _all.Where(IsPrintableStatus).OrderByDescending(x => x.DateCreated).ToList();
        _selected = _filtered.FirstOrDefault();
    }

    private async Task PrintRow(JobCardDto item)
    {
        _selected = item;
        _message = "Request completed successfully.";
        _isError = false;
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task PrintAll()
    {
        if (_filtered.Count == 0)
        {
            _isError = true;
            _message = "No records available for printing.";
            return;
        }

        _selected = null;
        _message = "Request completed successfully.";
        _isError = false;
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static bool IsPrintableStatus(JobCardDto item)
    {
        if (item.StatusCode == 3)
        {
            return true;
        }

        var status = item.Status ?? string.Empty;
        return status.Contains("authorized", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canCapturer = HasRole(user, "jobcard capturer");
        if ((hasWorkshopBit || hasVehicleBit) && !_canCapturer)
        {
            _canCapturer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
}
