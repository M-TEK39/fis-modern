@page "/job-cards/cancel"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject JobCardApiService JobCardService
@inject UserApiService UserService
@inject IJSRuntime JSRuntime

<PageTitle>Cancel Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-x-circle"></i>
            Cancel Job Cards
        </h1>
        <p class="page-description">Search by GG number and review job cards before cancellation.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/capturer-default">Main Menu</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                    <div class="contract-search-radio">
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                            GG
                        </label>
                        <label class="form-radio-label">
                            <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                            GP
                        </label>
                    </div>
                    <input class="form-input" @bind="_searchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
                <button class="btn btn-secondary" @onclick="Clear">Clear</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading job cards...</p>
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-info-circle"></i>
            <h3>No Job Cards Found</h3>
            <p>No records available for cancellation.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_filtered.Count job card(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Card #</th>
                            <th>GG Number</th>
                            <th>Registration</th>
                            <th>Description</th>
                            <th>Assigned To</th>
                            <th>Assigned Date</th>
                            <th>Status</th>
                            <th>Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr>
                                <td>@item.JobCardId</td>
                                <td>@ValueOrDash(item.GGNumber)</td>
                                <td>@ValueOrDash(item.RegistrationNumber)</td>
                                <td>@ValueOrDash(item.JobDescription)</td>
                                <td>@FormatUser(item.AssignedTo, item.AssignedToName)</td>
                                <td>@FormatDate(item.AssignedDate)</td>
                                <td>@ValueOrDash(item.Status)</td>
                                <td>
                                    <input class="form-input" @bind="_cancelReasons[item.JobCardId]" placeholder="Optional reason" />
                                </td>
                                <td class="actions-column">
                                    <button class="btn btn-secondary btn-sm"
                                            disabled="@_actionRunning"
                                            @onclick="() => RequestCancellation(item)">
                                        Request Cancellation
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_filtered.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_filtered.Count | Page size: @_pageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _actionRunning;
    private bool _isError;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private string _message = string.Empty;
    private List<JobCardDto> _all = new();
    private List<JobCardDto> _filtered = new();
    private Dictionary<short, UserProfileDto> _userProfilesByCode = new();
    private int _page = 1;
    private readonly int _pageSize = 12;
    private readonly Dictionary<int, string> _cancelReasons = new();
    private IEnumerable<JobCardDto> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            var profiles = await UserService.GetAllProfilesAsync();
            _userProfilesByCode = profiles
                .Where(x => x.UserAccessCode > 0)
                .GroupBy(x => x.UserAccessCode)
                .ToDictionary(g => g.Key, g => g.First());

            _all = await JobCardService.GetAllAsync();
            var query = _searchTerm.Trim();
            _filtered = string.IsNullOrWhiteSpace(query)
                ? new(_all)
                : FilterItems(_all, query, _searchMode);

            foreach (var item in _filtered)
            {
                if (!_cancelReasons.ContainsKey(item.JobCardId))
                {
                    _cancelReasons[item.JobCardId] = string.Empty;
                }
            }
            _page = 1;
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading cancellable job cards: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void Clear()
    {
        _searchTerm = string.Empty;
        _filtered = new(_all);
        _page = 1;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchTerm = string.Empty;
        _filtered = new(_all);
        _page = 1;
    }

    private async Task RequestCancellation(JobCardDto item)
    {
        _actionRunning = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var reason = _cancelReasons.GetValueOrDefault(item.JobCardId);
            var result = await JobCardService.CancelAsync(item.JobCardId, reason);
            if (!result.Success)
            {
                _isError = true;
                _message = result.Message;
                return;
            }

            _message = "Request completed successfully.";
            await SearchAsync();
        }
        finally
        {
            _actionRunning = false;
        }
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static List<JobCardDto> FilterItems(List<JobCardDto> items, string query, string searchMode)
    {
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);
        return items
            .Where(x => isGp
                ? !string.IsNullOrWhiteSpace(x.RegistrationNumber) && x.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(x.GGNumber) && x.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => isGp
                ? string.Equals(x.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(x.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(x => x.JobCardId)
            .ToList();
    }

    private string FormatUser(int? userCode, string? fallback)
    {
        if (!userCode.HasValue || userCode.Value <= 0)
        {
            return ValueOrDash(fallback);
        }

        if (_userProfilesByCode.TryGetValue((short)userCode.Value, out var user))
        {
            var fullName = $"{user.FirstName} {user.LastName}".Trim();
            if (!string.IsNullOrWhiteSpace(fullName))
            {
                return fullName;
            }

            if (!string.IsNullOrWhiteSpace(user.Email))
            {
                return user.Email;
            }
        }

        return !string.IsNullOrWhiteSpace(fallback) ? fallback : $"User {userCode.Value}";
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
