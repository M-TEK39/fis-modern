@page "/job-cards/authorizer-vehicles"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject JobCardApiService JobCardService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Jobcard Authoriser</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-search-alt"></i>Jobcard Authoriser</h1>
        <p class="page-description">Filter job cards by GG number.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/authorizer-dashboard">Back</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_canAuthorizer)
    {
        <div class="empty-state"><i class="bx bx-lock-alt"></i><h3>Access restricted</h3><p>Your profile does not include Job Card authorizer access.</p></div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-row">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" @bind="_ggNumber" />
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="ApplyFilter">Search</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state"><div class="spinner"></div><p>Loading job cards...</p></div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="empty-state"><i class="bx bx-info-circle"></i><h3>No records</h3><p>No matching job cards found.</p></div>
        }
        else
        {
            <div class="table-container">
                <div class="table-header"><span class="table-title">@_filtered.Count job card(s)</span></div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Job Card ID</th>
                                <th>GG Number</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Authorizer</th>
                                <th>Reviewer Comment</th>
                                <th>Decline Reason</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr>
                                    <td>@item.JobCardId</td>
                                    <td>@ValueOrDash(item.GGNumber)</td>
                                    <td>@ValueOrDash(item.JobDescription)</td>
                                    <td>@ValueOrDash(item.Status)</td>
                                    <td>@ValueOrDash(item.AuthorizerName ?? item.Authorizer?.ToString())</td>
                                    <td>
                                        <input class="form-input" @bind="_reviewComments[item.JobCardId]" placeholder="Optional comment" />
                                    </td>
                                    <td>
                                        <input class="form-input" @bind="_declineReasons[item.JobCardId]" placeholder="Required when declining" />
                                    </td>
                                    <td class="actions-column">
                                        <div class="table-actions">
                                            <button class="btn btn-primary btn-sm"
                                                    disabled="@(_actionRunning || !CanReview(item))"
                                                    @onclick="() => ApproveAsync(item)">
                                                Approve
                                            </button>
                                            <button class="btn btn-secondary btn-sm"
                                                    disabled="@(_actionRunning || !CanReview(item))"
                                                    @onclick="() => DeclineAsync(item)">
                                                Decline
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _authResolved;
    private bool _canAuthorizer;
    private bool _loading = true;
    private bool _actionRunning;
    private bool _isError;
    private int? _currentUserAccessCode;
    private string _message = string.Empty;
    private string _ggNumber = string.Empty;
    private List<JobCardDto> _all = new();
    private List<JobCardDto> _filtered = new();
    private readonly Dictionary<int, string> _reviewComments = new();
    private readonly Dictionary<int, string> _declineReasons = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_canAuthorizer)
        {
            _loading = false;
            return;
        }

        try
        {
            _all = await JobCardService.GetAllAsync();
            _filtered = new List<JobCardDto>(_all);
            EnsureInputState();
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading job cards: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        var query = _ggNumber.Trim();
        _filtered = string.IsNullOrWhiteSpace(query)
            ? new List<JobCardDto>(_all)
            : _all.Where(x => string.Equals(x.GGNumber, query, StringComparison.OrdinalIgnoreCase)).ToList();
        EnsureInputState();
    }

    private void EnsureInputState()
    {
        foreach (var item in _filtered)
        {
            if (!_reviewComments.ContainsKey(item.JobCardId))
            {
                _reviewComments[item.JobCardId] = string.Empty;
            }

            if (!_declineReasons.ContainsKey(item.JobCardId))
            {
                _declineReasons[item.JobCardId] = string.Empty;
            }
        }
    }

    private bool CanReview(JobCardDto item)
    {
        if (_currentUserAccessCode is > 0 && item.CapturedByUserCode is > 0 && item.CapturedByUserCode == _currentUserAccessCode)
        {
            return false;
        }

        return item.StatusCode is 1 or 2
            || (item.Status?.Contains("pending", StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Status?.Contains("await", StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task ApproveAsync(JobCardDto item)
    {
        _actionRunning = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            if (!CanReview(item))
            {
                _isError = true;
                _message = "You cannot authorize or review your own job card.";
                return;
            }

            var comment = _reviewComments.GetValueOrDefault(item.JobCardId);
            var result = await JobCardService.AuthorizeAsync(item.JobCardId, comment);
            if (!result.Success)
            {
                _isError = true;
                _message = result.Message;
                return;
            }

            _message = "Request completed successfully.";
            _all = await JobCardService.GetAllAsync();
            ApplyFilter();
        }
        finally
        {
            _actionRunning = false;
        }
    }

    private async Task DeclineAsync(JobCardDto item)
    {
        _actionRunning = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            if (!CanReview(item))
            {
                _isError = true;
                _message = "You cannot authorize or review your own job card.";
                return;
            }

            var reason = _declineReasons.GetValueOrDefault(item.JobCardId);
            if (string.IsNullOrWhiteSpace(reason))
            {
                _isError = true;
                _message = "Decline reason is required.";
                return;
            }

            var result = await JobCardService.DeclineAsync(item.JobCardId, reason.Trim());
            if (!result.Success)
            {
                _isError = true;
                _message = result.Message;
                return;
            }

            _message = "Request completed successfully.";
            _all = await JobCardService.GetAllAsync();
            ApplyFilter();
        }
        finally
        {
            _actionRunning = false;
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            _currentUserAccessCode = userAccessCode;
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }
        else
        {
            _currentUserAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canAuthorizer = HasRole(user, "jobcard authorizer") || HasRole(user, "jobcard authoriser");
        if ((hasWorkshopBit || hasVehicleBit) && !_canAuthorizer)
        {
            _canAuthorizer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
