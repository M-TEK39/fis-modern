@page "/job-cards/authorizer-vehicles"
@rendermode InteractiveServer

<PageTitle>Jobcard Authoriser - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-check-shield"></i>
            Jobcard Authoriser
        </h1>
        <p class="page-description">Authoriser workspace for viewing jobcards per GG number and reviewing details.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Jobcard Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards">Back to Jobcard Menu</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards/authorizer-dashboard">AuthorizerDash</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards/capturer-default">Default Capturer</a>
                </div>
            </div>
        </div>
    </div>

    <div class="table-container" style="margin-bottom: 1.5rem;">
        <div class="table-header">
            <span class="table-title">Job Card Stats per GG Number</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Jobcards</th>
                        <th>Pending</th>
                        <th>Awaiting Authorisation</th>
                        <th>Authorised</th>
                        <th>In Progress</th>
                        <th>Cancelled</th>
                        <th>Failed</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="9">Awaiting jobcard authoriser stats API.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-container" style="margin-bottom: 1.5rem;">
        <div class="table-header">
            <span class="table-title">Job Card for Specific GG Number</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Jobcard Description</th>
                        <th>Jobcard Number</th>
                        <th>GG Number</th>
                        <th>Registration Number</th>
                        <th>Jobcard Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5">Select a GG number above to load jobcards.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-grid" style="grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; gap: 1.5rem;">
        <div class="card">
            <h3 style="margin-top: 0;">Jobcard Details</h3>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Jobcard Details</label>
                    <input class="form-input" value="Select a jobcard to view details" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">GG Number</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Received Date</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Vehicle Received By</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Barcode</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Jobcard Captured Date</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Jobcard Captured By</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Jobcard Number</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Jobcard Description</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Assigned To</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Date Assigned</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Damages</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Damages Comments</label>
                    <textarea class="form-input" rows="3" disabled></textarea>
                </div>
                <div class="form-field">
                    <label class="form-label">Jobcard Status</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field">
                    <label class="form-label">Priority</label>
                    <input class="form-input" value="-" disabled />
                </div>
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label class="form-label">Authoriser Details</label>
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Authoriser Name</label>
                            <input class="form-input" value="-" disabled />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Authoriser Date</label>
                            <input class="form-input" value="-" disabled />
                        </div>
                        <div class="form-field" style="grid-column: 1 / -1;">
                            <label class="form-label">Authoriser Comments</label>
                            <textarea class="form-input" rows="3" disabled></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-top: 0;">Authoriser Control</h3>
            <div class="form-grid">
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label class="form-label">Add Comment</label>
                    <textarea class="form-input" rows="4" placeholder="Authoriser comment"></textarea>
                </div>
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label class="form-label">Re-Assign To</label>
                    <input class="form-input" placeholder="Re-assign to" />
                </div>
                <div class="form-field" style="grid-column: 1 / -1;">
                    <label class="form-label">Re-Assigned Date</label>
                    <input class="form-input" placeholder="YYYY-MM-DD" />
                </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                <button class="btn btn-secondary" type="button" disabled>View Detailed Information</button>
                <button class="btn btn-primary" type="button" disabled>Authorise Job Card</button>
                <button class="btn btn-danger" type="button" disabled>Cancel Job Card</button>
            </div>
            <p class="form-hint" style="margin-top: 0.75rem;">Buttons activate once jobcard selection and API wiring are complete.</p>
        </div>
    </div>
</div>
