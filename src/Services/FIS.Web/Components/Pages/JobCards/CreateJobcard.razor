@page "/job-cards/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Models
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject JobCardApiService JobCardService
@inject ExtraCodeApiService ExtraCodeService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Create Job Card</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-plus-circle"></i>
            Create Job Card
        </h1>
        <p class="page-description">Select one or more categories and create job card entries for the selected vehicle.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/select-vehicle">Back to Vehicle List</a>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading permissions...</p>
        </div>
    }
    else if (!_canCapturer)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>Your profile does not include Job Card capturer access.</p>
            <a class="btn btn-secondary" href="/job-cards/capturer-default">Back to Capturer Menu</a>
        </div>
    }
    else if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading vehicle...</p>
        </div>
    }
    else if (_vehicle is null)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Select Vehicle</h2>
            </div>
            <div class="form-card-body">
                <p class="form-hint">Search by GG number or registration, then select vehicle to continue.</p>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Vehicle</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                GP
                            </label>
                        </div>
                        <div class="fis-input-group-compact">
                            <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="SearchVehiclesAsync">Find</button>
                        </div>
                        <select class="form-select fis-mt-05" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                            <option value="">Select vehicle...</option>
                            @foreach (var vehicle in _vehicleMatches)
                            {
                                <option value="@vehicle.vmf_code">@GetVehicleLabel(vehicle)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" @onclick="ContinueWithSelectedVehicle" disabled="@(!_selectedVmfCode.HasValue)">Continue</button>
                    <a class="btn btn-secondary" href="/job-cards/select-vehicle">Back to Vehicle List</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Vehicle Summary</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.fleet_number)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Registration Number</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.registration_number)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Model</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.model_name)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Year Model</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.year_manufactured?.ToString())" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">VIN Number</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.chassis_number)" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Engine Number</label>
                        <input class="form-input" value="@ValueOrDash(_vehicle.engine_number_1)" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <h2>Select Job Card Categories</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    @if (_jobCategories.Count == 0)
                    {
                        <p class="form-hint">No job categories configured. Configure extra codes in Validation Data.</p>
                    }
                    else
                    {
                        @foreach (var category in _jobCategories)
                        {
                            <label class="form-label form-checkbox">
                                <input type="checkbox" checked="@category.Selected" @onchange="(e) => SetCategory(category.ExtraCode, e.Value)" />
                                @category.Label
                            </label>
                        }
                    }
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(_saving || _jobCategories.Count == 0)">Create</button>
                    <button class="btn btn-secondary" @onclick="ViewExisting">View created job cards for this vehicle</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">
            <i class="bx @(_isError ? "bx-error-circle" : "bx-check-circle")"></i>
            <span>@_message</span>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "vmfCode")]
    public int? VmfCode { get; set; }

    private bool _authResolved;
    private bool _canCapturer;
    private bool _loading = true;
    private bool _saving;
    private bool _isError;
    private string _message = string.Empty;
    private VehicleDto? _vehicle;
    private List<JobCategoryOption> _jobCategories = new();
    private string _vehicleSearchTerm = string.Empty;
    private string _searchMode = "GG";
    private List<VehicleDto> _vehicleMatches = new();
    private int? _selectedVmfCode;

    protected override async Task OnParametersSetAsync()
    {
        await ResolveAccessAsync();
        if (!_canCapturer)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _message = string.Empty;
        _isError = false;

        await EnsureCategoriesLoadedAsync();

        if (!VmfCode.HasValue || VmfCode.Value <= 0)
        {
            _vehicle = null;
            _vehicleMatches = new();
            _selectedVmfCode = null;
            _loading = false;
            return;
        }

        _vehicle = await VehicleService.GetVehicleAsync(VmfCode.Value);
        _loading = false;
    }

    private async Task SearchVehiclesAsync()
    {
        _isError = false;
        _message = string.Empty;
        var keyword = _vehicleSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(keyword))
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            return;
        }

        try
        {
            var matches = await VehicleService.SearchVehiclesAsync(keyword);
            _vehicleMatches = FilterVehicleMatches(matches, keyword, _searchMode);
            if (_vehicleMatches.All(v => v.vmf_code != _selectedVmfCode))
            {
                _selectedVmfCode = null;
            }
        }
        catch (Exception ex)
        {
            _vehicleMatches = new();
            _selectedVmfCode = null;
            _isError = true;
            _message = "Unable to search vehicles.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void ContinueWithSelectedVehicle()
    {
        if (!_selectedVmfCode.HasValue || _selectedVmfCode.Value <= 0)
        {
            _isError = true;
            _message = "Select a vehicle to continue.";
            return;
        }

        Navigation.NavigateTo($"/job-cards/create?vmfCode={_selectedVmfCode.Value}");
    }

    private void SetCategory(short extraCode, object? value)
    {
        var option = _jobCategories.FirstOrDefault(x => x.ExtraCode == extraCode);
        if (option is null)
        {
            return;
        }

        option.Selected = value is bool isChecked && isChecked;
    }

    private async Task CreateAsync()
    {
        if (_vehicle is null)
        {
            _isError = true;
            _message = "Select a vehicle first.";
            return;
        }

        var selected = _jobCategories.Where(x => x.Selected).ToList();
        if (selected.Count == 0)
        {
            _isError = true;
            _message = "Select at least one job category.";
            return;
        }

        _saving = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var createdCount = 0;
            foreach (var category in selected)
            {
                var created = await JobCardService.CreateAsync(new CreateJobCardRequest
                {
                    vmf_code = _vehicle.vmf_code,
                    extra_code = category.ExtraCode,
                    jcs_comment = $"Captured from Job Card UI for {category.Label}",
                    damages = null,
                    priority = "N"
                });

                if (created != null)
                {
                    createdCount++;
                }
            }

            if (createdCount == 0)
            {
                _isError = true;
                _message = "Unable to create job card records.";
                return;
            }

            _message = "Request completed successfully.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = "Unable to start job card creation.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task EnsureCategoriesLoadedAsync()
    {
        if (_jobCategories.Count > 0)
        {
            return;
        }

        List<ExtraCodeDto> extras;
        try
        {
            extras = await ExtraCodeService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _jobCategories = new();
            _isError = true;
            _message = "Unable to load job card categories.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
            return;
        }

        if (extras.Count == 0)
        {
            _jobCategories = new();
            return;
        }

        _jobCategories = extras
            .OrderBy(x => x.extra_description)
            .Select(x => new JobCategoryOption
            {
                ExtraCode = (short)x.extra_code,
                Label = string.IsNullOrWhiteSpace(x.extra_description)
                    ? $"Extra Code {x.extra_code}"
                    : x.extra_description
            }).ToList();
    }

    private void ViewExisting()
    {
        var gg = _vehicle?.fleet_number;
        if (string.IsNullOrWhiteSpace(gg))
        {
            Navigation.NavigateTo("/job-cards/list");
            return;
        }

        Navigation.NavigateTo($"/job-cards/list?gg={Uri.EscapeDataString(gg)}");
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
    }

    private async Task ResolveAccessAsync()
    {
        if (_authResolved)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canCapturer = HasRole(user, "jobcard capturer");
        if ((hasWorkshopBit || hasVehicleBit) && !_canCapturer)
        {
            _canCapturer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private sealed class JobCategoryOption
    {
        public short ExtraCode { get; set; }
        public string Label { get; set; } = string.Empty;
        public bool Selected { get; set; }
    }
}
