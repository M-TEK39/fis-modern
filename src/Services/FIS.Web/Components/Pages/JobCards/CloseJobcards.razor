@page "/job-cards/close"
@rendermode InteractiveServer

<PageTitle>Close Jobcards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-check-circle"></i>
            Close Jobcards
        </h1>
        <p class="page-description">Locate jobcards ready for closing and update final status.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Jobcard Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards/capturer-default">Main Menu</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 1.5rem;">
        <div class="form-grid" style="align-items: end;">
            <div class="form-field">
                <label class="form-label">Enter Job Card Number</label>
                <input class="form-input" placeholder="Job Card Number" />
            </div>
            <div class="form-field">
                <button class="btn btn-primary" type="button">Search</button>
            </div>
        </div>
    </div>

    <div class="table-container" style="margin-bottom: 1.5rem;">
        <div class="table-header">
            <span class="table-title">Job Cards that can be Closed</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Job Card Number</th>
                        <th>Job Card Description</th>
                        <th>GG Number</th>
                        <th>Registration Number</th>
                        <th>Assigned To</th>
                        <th>Assigned Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6">Awaiting jobcard closing API.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-top: 0;">Job Card Details</h3>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">GG Number</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Job Card Number</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Job Card Description</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Job Card Capturer</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Last Captured Date</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Assigned To</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Assigned Date</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Authoriser</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Authorised Date</label>
                <input class="form-input" value="-" disabled />
            </div>
            <div class="form-field">
                <label class="form-label">Authoriser Comments</label>
                <textarea class="form-input" rows="3" disabled></textarea>
            </div>
            <div class="form-field">
                <label class="form-label">Status</label>
                <div class="form-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                    <label class="form-label form-checkbox"><input type="radio" name="closeStatus" /> Completed</label>
                    <label class="form-label form-checkbox"><input type="radio" name="closeStatus" /> Failed</label>
                </div>
            </div>
            <div class="form-field">
                <label class="form-label">Date Completed/Failed</label>
                <input class="form-input" placeholder="YYYY-MM-DD" />
            </div>
            <div class="form-field">
                <label class="form-label">Barcode</label>
                <input class="form-input" value="-" disabled />
            </div>
        </div>
        <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
            <button class="btn btn-primary" type="button" disabled>Close Job Card</button>
        </div>
        <p class="form-hint" style="margin-top: 0.5rem;">Close action will enable once jobcard APIs are wired.</p>
    </div>
</div>
