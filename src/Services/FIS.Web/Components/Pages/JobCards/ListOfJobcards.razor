@page "/job-cards/list"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject JobCardApiService JobCardService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>List of Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            List / Edit Job Cards
        </h1>
        <p class="page-description">Legacy flow: search GG number, select a job card, then review details.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/capturer-default">Main Menu</a>
        <a class="btn btn-secondary btn-sm" href="/job-cards/select-vehicle">Add New Job Card</a>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_canCapturer)
    {
        <div class="empty-state"><i class="bx bx-lock-alt"></i><h3>Access restricted</h3><p>Your profile does not include Job Card capturer access.</p></div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Search</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input" @bind="_searchGg" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Job Card Number</label>
                        <input class="form-input" @bind="_searchJobCard" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
                    <button class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading job cards...</p>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="empty-state">
                <i class="bx bx-info-circle"></i>
                <h3>No Job Cards Found</h3>
                <p>No records match the selected criteria.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <div class="table-header">
                    <span class="table-title">@_filtered.Count job card(s)</span>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Job Card #</th>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Assigned Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr>
                                    <td>@item.JobCardId</td>
                                    <td>@ValueOrDash(item.GGNumber)</td>
                                    <td>@ValueOrDash(item.RegistrationNumber)</td>
                                    <td>@ValueOrDash(item.JobDescription)</td>
                                    <td>@ValueOrDash(item.Status)</td>
                                    <td>@ValueOrDash(item.AssignedToName)</td>
                                    <td>@FormatDate(item.AssignedDate)</td>
                                    <td class="actions-column">
                                        <div class="table-actions">
                                            <button class="btn-icon btn-icon-view"
                                                    title="View details"
                                                    @onclick="() => SelectItem(item)">
                                                <i class="bx bx-show"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_selected is not null)
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Selected Job Card Details</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Job Card Number</label>
                            <input class="form-input" value="@_selected.JobCardId" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">GG Number</label>
                            <input class="form-input" value="@ValueOrDash(_selected.GGNumber)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Description</label>
                            <input class="form-input" value="@ValueOrDash(_selected.JobDescription)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Status</label>
                            <input class="form-input" value="@ValueOrDash(_selected.Status)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Authorizer</label>
                            <input class="form-input" value="@ValueOrDash(_selected.AuthorizerName ?? _selected.Authorizer?.ToString())" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Comments</label>
                            <textarea class="form-input" rows="3" readonly>@ValueOrDash(_selected.Comments)</textarea>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "gg")]
    public string? QueryGg { get; set; }

    private bool _authResolved;
    private bool _canCapturer;
    private bool _loading = true;
    private string _searchGg = string.Empty;
    private string _searchJobCard = string.Empty;
    private List<JobCardDto> _all = new();
    private List<JobCardDto> _filtered = new();
    private JobCardDto? _selected;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_canCapturer)
        {
            _loading = false;
            return;
        }

        if (!string.IsNullOrWhiteSpace(QueryGg))
        {
            _searchGg = QueryGg.Trim();
        }
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            _all = await JobCardService.GetAllAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            _selected = null;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading job cards: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        var gg = _searchGg.Trim();
        var card = _searchJobCard.Trim();

        _filtered = _all.Where(item =>
            (string.IsNullOrWhiteSpace(gg) || string.Equals(item.GGNumber, gg, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(card) || item.JobCardId.ToString().Contains(card, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private void ClearFilters()
    {
        _searchGg = string.Empty;
        _searchJobCard = string.Empty;
        _selected = null;
        _filtered = new(_all);
    }

    private void SelectItem(JobCardDto item)
    {
        _selected = item;
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canCapturer = HasRole(user, "jobcard capturer");
        if ((hasWorkshopBit || hasVehicleBit) && !_canCapturer)
        {
            _canCapturer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
}
