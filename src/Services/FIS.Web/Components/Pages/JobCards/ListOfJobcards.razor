@page "/job-cards/list"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@using FIS.Web.Models
@inject JobCardApiService JobCardService
@inject UserApiService UserService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>List of Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            List / Edit Job Cards
        </h1>
        <p class="page-description">Search GG/GP number, select a job card, then review details.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/job-cards/capturer-default">Main Menu</a>
        <a class="btn btn-secondary btn-sm" href="/job-cards/select-vehicle">Add New Job Card</a>
    </div>
</div>

<div class="page-content">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_canCapturer)
    {
        <div class="empty-state"><i class="bx bx-lock-alt"></i><h3>Access restricted</h3><p>Your profile does not include Job Card capturer access.</p></div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Search</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                                GP
                            </label>
                        </div>
                        <input class="form-input" @bind="_searchVehicleNumber" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Job Card Number</label>
                        <input class="form-input" @bind="_searchJobCard" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
                    <button class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading job cards...</p>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="empty-state">
                <i class="bx bx-info-circle"></i>
                <h3>No Job Cards Found</h3>
                <p>No records match the selected criteria.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <div class="table-header">
                    <span class="table-title">@_filtered.Count job card(s)</span>
                </div>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Job Card #</th>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Assigned Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr>
                                    <td>@item.JobCardId</td>
                                    <td>@ValueOrDash(item.GGNumber)</td>
                                    <td>@ValueOrDash(item.RegistrationNumber)</td>
                                    <td>@ValueOrDash(item.JobDescription)</td>
                                    <td>@ValueOrDash(item.Status)</td>
                                    <td>@FormatUser(item.AssignedTo, item.AssignedToName)</td>
                                    <td>@FormatDate(item.AssignedDate)</td>
                                    <td class="actions-column">
                                        <div class="table-actions">
                                            <button class="btn-icon btn-icon-view"
                                                    title="View details"
                                                    @onclick="() => SelectItem(item)">
                                                <i class="bx bx-show"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_filtered.Count > _pageSize)
                {
                    <div class="pagination">
                        <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                        <div class="pagination-info">Page @_page of @TotalPages</div>
                        <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                    </div>
                    <div class="pagination-meta">Total records: @_filtered.Count | Page size: @_pageSize</div>
                }
            </div>
        }

        @if (_selected is not null)
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>Selected Job Card Details</h2>
                </div>
                <div class="form-card-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">Job Card Number</label>
                            <input class="form-input" value="@_selected.JobCardId" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">GG Number</label>
                            <input class="form-input" value="@ValueOrDash(_selected.GGNumber)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Registration Number</label>
                            <input class="form-input" value="@ValueOrDash(_selected.RegistrationNumber)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Description</label>
                            <input class="form-input" value="@ValueOrDash(_selected.JobDescription)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Status</label>
                            <input class="form-input" value="@ValueOrDash(_selected.Status)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Authorizer</label>
                            <input class="form-input" value="@FormatUser(_selected.Authorizer, _selected.AuthorizerName)" readonly />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Comments</label>
                            <textarea class="form-input" rows="3" readonly>@ValueOrDash(_selected.Comments)</textarea>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Labour Cost</label>
                            <input class="form-input" type="number" min="0" step="0.01" @bind="_selectedLabourCost" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Parts Cost</label>
                            <input class="form-input" type="number" min="0" step="0.01" @bind="_selectedPartsCost" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Other Cost</label>
                            <input class="form-input" type="number" min="0" step="0.01" @bind="_selectedOtherCost" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Invoice Number</label>
                            <input class="form-input" @bind="_selectedInvoiceNumber" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Invoice Date</label>
                            <input class="form-input" type="date" @bind="_selectedInvoiceDate" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Service Provider</label>
                            <input class="form-input" @bind="_selectedServiceProvider" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary"
                                disabled="@(_actionRunning || _selected is null)"
                                @onclick="UpdateCostsAsync">
                            Update Costs
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "gg")]
    public string? QueryGg { get; set; }

    private bool _authResolved;
    private bool _canCapturer;
    private bool _loading = true;
    private bool _actionRunning;
    private bool _isError;
    private string _searchMode = "GG";
    private string _searchVehicleNumber = string.Empty;
    private string _searchJobCard = string.Empty;
    private string _message = string.Empty;
    private List<JobCardDto> _all = new();
    private List<JobCardDto> _filtered = new();
    private Dictionary<short, UserProfileDto> _userProfilesByCode = new();
    private int _page = 1;
    private readonly int _pageSize = 12;
    private JobCardDto? _selected;
    private decimal _selectedLabourCost;
    private decimal _selectedPartsCost;
    private decimal _selectedOtherCost;
    private string _selectedInvoiceNumber = string.Empty;
    private DateTime? _selectedInvoiceDate;
    private string _selectedServiceProvider = string.Empty;
    private IEnumerable<JobCardDto> PagedItems => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_canCapturer)
        {
            _loading = false;
            return;
        }

        var profiles = await UserService.GetAllProfilesAsync();
        _userProfilesByCode = profiles
            .Where(x => x.UserAccessCode > 0)
            .GroupBy(x => x.UserAccessCode)
            .ToDictionary(g => g.Key, g => g.First());

        if (!string.IsNullOrWhiteSpace(QueryGg))
        {
            _searchVehicleNumber = QueryGg.Trim();
        }
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            _all = await JobCardService.GetAllAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _all = new();
            _filtered = new();
            _selected = null;
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading job cards: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        var vehicleNumber = _searchVehicleNumber.Trim();
        var card = _searchJobCard.Trim();
        var isGp = string.Equals(_searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        _filtered = _all.Where(item =>
            (string.IsNullOrWhiteSpace(vehicleNumber) || (isGp
                ? string.Equals(item.RegistrationNumber, vehicleNumber, StringComparison.OrdinalIgnoreCase)
                : string.Equals(item.GGNumber, vehicleNumber, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(card) || item.JobCardId.ToString().Contains(card, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        _page = 1;
    }

    private void ClearFilters()
    {
        _searchVehicleNumber = string.Empty;
        _searchJobCard = string.Empty;
        _selected = null;
        _filtered = new(_all);
        _page = 1;
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _searchVehicleNumber = string.Empty;
        ApplyFilters();
    }

    private void SelectItem(JobCardDto item)
    {
        _selected = item;
        _selectedLabourCost = item.LabourCost ?? 0m;
        _selectedPartsCost = item.PartsCost ?? 0m;
        _selectedOtherCost = item.OtherCost ?? 0m;
        _selectedInvoiceNumber = item.InvoiceNumber ?? string.Empty;
        _selectedInvoiceDate = item.InvoiceDate;
        _selectedServiceProvider = item.ServiceProvider ?? string.Empty;
    }

    private async Task UpdateCostsAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _actionRunning = true;
        _isError = false;
        _message = string.Empty;
        try
        {
            var result = await JobCardService.UpdateCostsAsync(_selected.JobCardId, new JobCardCostRequest
            {
                labour_cost = _selectedLabourCost,
                parts_cost = _selectedPartsCost,
                other_cost = _selectedOtherCost,
                invoice_number = NullIfWhiteSpace(_selectedInvoiceNumber),
                invoice_date = _selectedInvoiceDate,
                service_provider = NullIfWhiteSpace(_selectedServiceProvider)
            });

            if (!result.Success)
            {
                _isError = true;
                _message = result.Message;
                return;
            }

            _message = "Request completed successfully.";
            var selectedJobCardId = _selected.JobCardId;
            await SearchAsync();
            _selected = _all.FirstOrDefault(x => x.JobCardId == selectedJobCardId);
            if (_selected is not null)
            {
                SelectItem(_selected);
            }
        }
        finally
        {
            _actionRunning = false;
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canCapturer = HasRole(user, "jobcard capturer");
        if ((hasWorkshopBit || hasVehicleBit) && !_canCapturer)
        {
            _canCapturer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string FormatUser(int? userCode, string? fallback)
    {
        if (!userCode.HasValue || userCode.Value <= 0)
        {
            return ValueOrDash(fallback);
        }

        if (_userProfilesByCode.TryGetValue((short)userCode.Value, out var user))
        {
            var fullName = $"{user.FirstName} {user.LastName}".Trim();
            if (!string.IsNullOrWhiteSpace(fullName))
            {
                return fullName;
            }

            if (!string.IsNullOrWhiteSpace(user.Email))
            {
                return user.Email;
            }
        }

        return !string.IsNullOrWhiteSpace(fallback) ? fallback : $"User {userCode.Value}";
    }

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
    private static string? NullIfWhiteSpace(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
