@page "/job-cards/select-vehicle"
@rendermode InteractiveServer
@using FIS.Web.Services
@inject VehicleApiService VehicleService

<PageTitle>Select Vehicle - Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Select a Vehicle to Create a Job Card
        </h1>
        <p class="page-description">Choose a vehicle before starting a new jobcard (legacy selection list).</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Jobcard Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards/capturer-default">Main Menu</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/job-cards/list">Edit Jobcard</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0;">Check the Columns You Want to View</h3>
        <div class="form-grid">
            <label class="form-label form-checkbox"><input type="checkbox" /> GG Number</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Registration Number</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Date Delivered</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Odo Reading</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> VIN Number</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Engine Number</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Model Description</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Year Model</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Class Description</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Hire Type</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Hired From</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Location</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Status</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Status Date</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Purchased From</label>
            <label class="form-label form-checkbox"><input type="checkbox" /> Purchased Date</label>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <span class="table-title">List of Available Vehicles</span>
        </div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>GG Number</th>
                        <th>Registration Number</th>
                        <th>Date Delivered</th>
                        <th>Odo Reading</th>
                        <th>VIN Number</th>
                        <th>Engine Number</th>
                        <th>Model</th>
                        <th>Year Model</th>
                        <th>Class Description</th>
                        <th>Hire Type</th>
                        <th>Hired From</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Status Date</th>
                        <th>Purchased From</th>
                        <th>Purchased Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr>
                            <td colspan="16">Loading vehicles...</td>
                        </tr>
                    }
                    else if (_vehicles.Count == 0)
                    {
                        <tr>
                            <td colspan="16">No vehicles found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var vehicle in _vehicles)
                        {
                            <tr>
                                <td>@ValueOrDash(vehicle.fleet_number)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@FormatDate(vehicle.take_on_date)</td>
                                <td>@ValueOrDash(vehicle.current_odo?.ToString())</td>
                                <td>@ValueOrDash(vehicle.chassis_number)</td>
                                <td>@ValueOrDash(vehicle.engine_number_1)</td>
                                <td>@ValueOrDash(vehicle.model_name)</td>
                                <td>@ValueOrDash(vehicle.year_manufactured?.ToString())</td>
                                <td>@ValueOrDash(vehicle.type_name)</td>
                                <td>@ValueOrDash(vehicle.status_description)</td>
                                <td>@ValueOrDash(vehicle.purchased_from)</td>
                                <td>@FormatDate(vehicle.purchase_date)</td>
                                <td colspan="4"></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private List<FIS.Web.Models.VehicleDto> _vehicles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        _loading = true;
        try
        {
            var result = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 50);
            _vehicles = result.Data;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
