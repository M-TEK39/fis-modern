@page "/job-cards/select-vehicle"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject VehicleApiService VehicleService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Select Vehicle - Job Cards</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Select a Vehicle to Create a Job Card
        </h1>
        <p class="page-description">Choose a vehicle before starting a new jobcard (legacy selection list).</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_canCapturer)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>Your profile does not include Job Card capturer access.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <div class="menu-tile-header">
                    <span>Jobcard Menu</span>
                </div>
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/job-cards/capturer-default">Main Menu</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/job-cards/list">Edit Jobcard</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <h2>Check the Columns You Want to View</h2>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <label class="form-label form-checkbox"><input type="checkbox" /> GG Number</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Registration Number</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Date Delivered</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Odo Reading</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> VIN Number</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Engine Number</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Model Description</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Year Model</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Class Description</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Hire Type</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Hired From</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Location</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Status</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Status Date</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Purchased From</label>
                    <label class="form-label form-checkbox"><input type="checkbox" /> Purchased Date</label>
                </div>
            </div>
        </div>

        <div class="table-container">
            <div class="table-header">
                <span class="table-title">List of Available Vehicles</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>GG Number</th>
                            <th>Registration Number</th>
                            <th>Date Delivered</th>
                            <th>Odo Reading</th>
                            <th>VIN Number</th>
                            <th>Engine Number</th>
                            <th>Model</th>
                            <th>Year Model</th>
                            <th>Class Description</th>
                            <th>Hire Type</th>
                            <th>Hired From</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Status Date</th>
                            <th>Purchased From</th>
                            <th>Purchased Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr>
                                <td colspan="17">Loading vehicles...</td>
                            </tr>
                        }
                        else if (_vehicles.Count == 0)
                        {
                            <tr>
                                <td colspan="17">No vehicles found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var vehicle in _vehicles)
                            {
                                <tr>
                                    <td>@ValueOrDash(vehicle.fleet_number)</td>
                                    <td>@ValueOrDash(vehicle.registration_number)</td>
                                    <td>@FormatDate(vehicle.take_on_date)</td>
                                    <td>@ValueOrDash(vehicle.current_odo?.ToString())</td>
                                    <td>@ValueOrDash(vehicle.chassis_number)</td>
                                    <td>@ValueOrDash(vehicle.engine_number_1)</td>
                                    <td>@ValueOrDash(vehicle.model_name)</td>
                                    <td>@ValueOrDash(vehicle.year_manufactured?.ToString())</td>
                                    <td>@ValueOrDash(vehicle.type_name)</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>@ValueOrDash(vehicle.location_description)</td>
                                    <td>@ValueOrDash(vehicle.status_description)</td>
                                    <td>@FormatDate(vehicle.vehicle_status_date)</td>
                                    <td>@ValueOrDash(vehicle.purchased_from)</td>
                                    <td>@FormatDate(vehicle.purchase_date)</td>
                                    <td class="actions-column">
                                        <div class="table-actions">
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="() => SelectVehicle(vehicle.vmf_code)">
                                                Select
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _canCapturer;
    private bool _loading = true;
    private List<FIS.Web.Models.VehicleDto> _vehicles = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (!_canCapturer)
        {
            _loading = false;
            return;
        }

        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        _loading = true;
        try
        {
            var result = await VehicleService.GetVehiclesAsync(pageNumber: 1, pageSize: 50);
            _vehicles = result.Data;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectVehicle(int vmfCode)
    {
        Navigation.NavigateTo($"/job-cards/create?vmfCode={vmfCode}");
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _canCapturer = HasRole(user, "jobcard capturer");
        if ((hasWorkshopBit || hasVehicleBit) && !_canCapturer)
        {
            _canCapturer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
