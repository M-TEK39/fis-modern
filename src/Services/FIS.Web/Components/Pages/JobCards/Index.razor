@page "/job-cards"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService

<PageTitle>Job Cards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-id-card"></i>Job Cards</h1>
        <p class="page-description">Job card main menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_hasJobCardAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>Your profile does not include Job Card access.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <button class="menu-tile-header">
                    <span>Job Cards Menu</span>
                    <i class="bx bx-chevron-down"></i>
                </button>
                <div class="menu-tile-body">
                    @if (_canAuthorizer)
                    {
                        <div class="menu-item"><a class="menu-item-link" href="/job-cards/authorizer-dashboard">Authorizers</a></div>
                    }
                    @if (_canCapturer)
                    {
                        <div class="menu-item"><a class="menu-item-link" href="/job-cards/capturer-default">Capturer</a></div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasJobCardAccess;
    private bool _canCapturer;
    private bool _canAuthorizer;

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _hasJobCardAccess = hasWorkshopBit || hasVehicleBit;

        _canCapturer = HasRole(user, "jobcard capturer");
        _canAuthorizer = HasRole(user, "jobcard authorizer") || HasRole(user, "jobcard authoriser");

        if (_hasJobCardAccess && !_canCapturer && !_canAuthorizer)
        {
            _canCapturer = true;
            _canAuthorizer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;
}
