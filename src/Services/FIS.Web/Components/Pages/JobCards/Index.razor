@page "/job-cards"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject WorkshopApiService WorkshopService
@inject IJSRuntime JS

<PageTitle>Job Cards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Job Cards
        </h1>
        <p class="page-description">Job card summary mapped from /api/workshop.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadJobCards">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles" style="margin-bottom: 1.5rem;">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleJobcardMenu">
                <span>Jobcard Menu</span>
                <i class="bx @(_showJobcardMenu ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showJobcardMenu)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/job-cards/authorizer-vehicles">View Authoriser Vehicles</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/job-cards/authorizer-dashboard">AuthorizerDash</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/job-cards/capturer-default">Default Capturer</a>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading job cards...</p>
        </div>
    }
    else if (_jobCards.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-id-card"></i>
            <h3>No job cards</h3>
            <p>No job cards are available.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_jobCards.Count Job card(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Card #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Assigned</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobCards)
                        {
                            <tr>
                                <td>@job.Number</td>
                                <td>@job.Vehicle</td>
                                <td><span class="badge">@job.Status</span></td>
                                <td>@FormatDate(job.Date)</td>
                                <td>@ValueOrDash(job.AssignedTo)</td>
                                <td>@ValueOrDash(job.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<JobCardItem> _jobCards = new();
    private bool _showJobcardMenu = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobCards();
    }

    private async Task LoadJobCards()
    {
        _loading = true;
        try
        {
            var apiItems = await WorkshopService.GetAllAsync<WorkshopDto>();
            _jobCards = apiItems.Select(w => new JobCardItem(
                Number: w.ww_code.ToString(),
                Vehicle: w.vmf_code?.ToString() ?? "Unknown",
                Status: w.complete_time.HasValue ? "Closed" : "Open",
                Date: w.receive_date,
                AssignedTo: "N/A",
                Notes: string.Empty
            )).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading job cards: {ex.Message}");
            _jobCards = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record JobCardItem(string Number, string Vehicle, string Status, DateTime? Date, string AssignedTo, string Notes);

    private sealed class WorkshopDto
    {
        public short ww_code { get; set; }
        public int? vmf_code { get; set; }
        public DateTime? receive_date { get; set; }
        public DateTime? complete_time { get; set; }
    }

    private void ToggleJobcardMenu()
    {
        _showJobcardMenu = !_showJobcardMenu;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
