@page "/job-cards"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Job Cards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Job Cards
        </h1>
        <p class="page-description">Job card summary. Static entries until job card API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadJobCards">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading job cards...</p>
        </div>
    }
    else if (_jobCards.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-id-card"></i>
            <h3>No job cards</h3>
            <p>Awaiting job card API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_jobCards.Count Job card(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Card #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Assigned</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobCards)
                        {
                            <tr>
                                <td>@job.Number</td>
                                <td>@job.Vehicle</td>
                                <td><span class="badge">@job.Status</span></td>
                                <td>@job.Date.ToString("yyyy-MM-dd")</td>
                                <td>@job.AssignedTo</td>
                                <td>@job.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<JobCardItem> _jobCards = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobCards();
    }

    private Task LoadJobCards()
    {
        _loading = true;

        _jobCards =
        [
            new("JC-2401-001", "ABC123GP", "Open", new DateTime(2025, 01, 12), "Technician A", "Awaiting authorisation."),
            new("JC-2401-002", "JKL456GP", "In Progress", new DateTime(2025, 01, 10), "Technician B", "Parts ordered."),
            new("JC-2312-015", "MNO789GP", "Closed", new DateTime(2024, 12, 14), "Technician A", "Completed and signed off."),
            new("JC-2311-009", "PQR321GP", "Reassigned", new DateTime(2024, 11, 22), "Technician C", "Reassigned for follow-up.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record JobCardItem(string Number, string Vehicle, string Status, DateTime Date, string AssignedTo, string Notes);
}
