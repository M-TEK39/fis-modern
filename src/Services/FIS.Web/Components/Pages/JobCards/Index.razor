@page "/job-cards"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject JobCardApiService JobCardService
@inject IJSRuntime JSRuntime

<PageTitle>Job Cards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title"><i class="bx bx-id-card"></i>Job Cards</h1>
        <p class="page-description">Job card main menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_authResolved)
    {
        <div class="loading-state"><div class="spinner"></div><p>Loading permissions...</p></div>
    }
    else if (!_hasJobCardAccess)
    {
        <div class="empty-state">
            <i class="bx bx-lock-alt"></i>
            <h3>Access restricted</h3>
            <p>Your profile does not include Job Card access.</p>
        </div>
    }
    else
    {
        <div class="menu-tiles">
            <div class="menu-tile">
                <button class="menu-tile-header">
                    <span>Job Cards Menu</span>
                    <i class="bx bx-chevron-down"></i>
                </button>
                <div class="menu-tile-body">
                    @if (_canAuthorizer)
                    {
                        <div class="menu-item"><a class="menu-item-link" href="/job-cards/authorizer-dashboard">Authorizers</a></div>
                    }
                    @if (_canCapturer)
                    {
                        <div class="menu-item"><a class="menu-item-link" href="/job-cards/capturer-default">Capturer</a></div>
                    }
                </div>
            </div>
        </div>

        <div class="table-container">
            <div class="table-header">
                <span class="table-title">All Job Cards Snapshot</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="RefreshJobCardOverviewAsync" disabled="@_loadingOverview">
                        <i class="bx bx-refresh"></i>
                        Refresh
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_overviewMessage))
            {
                <div class="alert @(_overviewError ? "alert-error" : "alert-success") fis-my-075">@_overviewMessage</div>
            }

            @if (_loadingOverview)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading job cards...</p>
                </div>
            }
            else if (_jobCardOverview.Count == 0)
            {
                <div class="empty-state">
                    <i class="bx bx-info-circle"></i>
                    <h3>No job cards found</h3>
                    <p>No job cards match the current filter selection.</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Job Card #</th>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Captured Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedJobCards)
                            {
                                <tr>
                                    <td>@row.JobCardId</td>
                                    <td>@ValueOrDash(row.GGNumber)</td>
                                    <td>@ValueOrDash(row.RegistrationNumber)</td>
                                    <td>@ValueOrDash(row.JobDescription)</td>
                                    <td>@ValueOrDash(row.Status)</td>
                                    <td>@FormatDate(row.DateCreated)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevOverviewPage" disabled="@(_overviewPage <= 1)">Previous</button>
                    <div class="pagination-info">Page @_overviewPage of @OverviewTotalPages</div>
                    <button class="pagination-btn" @onclick="NextOverviewPage" disabled="@(_overviewPage >= OverviewTotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_jobCardOverview.Count | Page size: @_overviewPageSize</div>
            }
        </div>
    }
</div>

@code {
    private bool _authResolved;
    private bool _hasJobCardAccess;
    private bool _canCapturer;
    private bool _canAuthorizer;
    private bool _loadingOverview;
    private bool _overviewError;
    private string _overviewMessage = string.Empty;
    private List<JobCardDto> _jobCardOverview = new();
    private int _overviewPage = 1;
    private readonly int _overviewPageSize = 12;

    private IEnumerable<JobCardDto> PagedJobCards
        => _jobCardOverview
            .Skip((_overviewPage - 1) * _overviewPageSize)
            .Take(_overviewPageSize);

    private int OverviewTotalPages
        => Math.Max(1, (int)Math.Ceiling(_jobCardOverview.Count / (double)_overviewPageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolveAccessAsync();
        if (_hasJobCardAccess)
        {
            await LoadOverviewAsync();
        }
    }

    private async Task ResolveAccessAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _authResolved = true;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        long accessLevel;
        if (!long.TryParse(accessLevelClaim, out accessLevel))
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var hasWorkshopBit = (accessLevel & LegacyPermissionBits.Workshop) == LegacyPermissionBits.Workshop;
        var hasVehicleBit = (accessLevel & LegacyPermissionBits.VehicleManagement) == LegacyPermissionBits.VehicleManagement;
        _hasJobCardAccess = hasWorkshopBit || hasVehicleBit;

        _canCapturer = HasRole(user, "jobcard capturer");
        _canAuthorizer = HasRole(user, "jobcard authorizer") || HasRole(user, "jobcard authoriser");

        if (_hasJobCardAccess && !_canCapturer && !_canAuthorizer)
        {
            _canCapturer = true;
            _canAuthorizer = true;
        }

        _authResolved = true;
    }

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }

    private static int? TryParseInt(string? value)
        => int.TryParse(value, out var parsed) ? parsed : null;

    private async Task LoadOverviewAsync()
    {
        _loadingOverview = true;
        _overviewError = false;
        _overviewMessage = string.Empty;
        try
        {
            _jobCardOverview = await JobCardService.GetAllAsync();
            _overviewPage = 1;
        }
        catch (Exception ex)
        {
            _jobCardOverview = new();
            _overviewError = true;
            _overviewMessage = "Unable to load job card overview.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loadingOverview = false;
        }
    }

    private async Task RefreshJobCardOverviewAsync()
    {
        await LoadOverviewAsync();
    }

    private void PrevOverviewPage()
    {
        if (_overviewPage > 1)
        {
            _overviewPage--;
        }
    }

    private void NextOverviewPage()
    {
        if (_overviewPage < OverviewTotalPages)
        {
            _overviewPage++;
        }
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";
}
