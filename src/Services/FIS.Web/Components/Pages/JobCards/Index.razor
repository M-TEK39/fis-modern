@page "/job-cards"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject WorkshopApiService WorkshopService
@inject IJSRuntime JS

<PageTitle>Job Cards - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Job Cards
        </h1>
        <p class="page-description">Job card summary mapped from /api/workshop.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadJobCards">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading job cards...</p>
        </div>
    }
    else if (_jobCards.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-id-card"></i>
            <h3>No job cards</h3>
            <p>Awaiting job card API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_jobCards.Count Job card(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Card #</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Assigned</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobCards)
                        {
                            <tr>
                                <td>@job.Number</td>
                                <td>@job.Vehicle</td>
                                <td><span class="badge">@job.Status</span></td>
                                <td>@job.Date.ToString("yyyy-MM-dd")</td>
                                <td>@job.AssignedTo</td>
                                <td>@job.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<JobCardItem> _jobCards = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobCards();
    }

    private async Task LoadJobCards()
    {
        _loading = true;
        try
        {
            var apiItems = await WorkshopService.GetAllAsync<WorkshopDto>();
            _jobCards = apiItems.Select(w => new JobCardItem(
                Number: w.workshop_code.ToString(),
                Vehicle: w.vmf_code?.ToString() ?? "Unknown",
                Status: w.workshop_status ?? "Unknown",
                Date: w.workshop_date ?? DateTime.MinValue,
                AssignedTo: w.workshop_tech ?? "N/A",
                Notes: w.workshop_notes ?? string.Empty
            )).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading job cards: {ex.Message}");
            _jobCards = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record JobCardItem(string Number, string Vehicle, string Status, DateTime Date, string AssignedTo, string Notes);

    private sealed class WorkshopDto
    {
        public int workshop_code { get; set; }
        public int? vmf_code { get; set; }
        public string? workshop_status { get; set; }
        public DateTime? workshop_date { get; set; }
        public string? workshop_tech { get; set; }
        public string? workshop_notes { get; set; }
    }
}
