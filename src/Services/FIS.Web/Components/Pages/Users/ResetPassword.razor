@page "/users/reset-password"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Reset User Password - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-lock"></i>
            Reset User Password
        </h1>
        <p class="page-description">Force password change for a selected user.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminForcePasswordContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/ResetUserPassword.aspx"
        Endpoint="api/auth/force-password"
        HttpMethod="POST"
        ButtonText="Test Force Password Endpoint"
        ReportType="useradmin-force-password" />

</div>
