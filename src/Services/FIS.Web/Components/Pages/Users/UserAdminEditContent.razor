@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@using System.Linq
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserApiService UserApiService
@inject SiteApiService SiteApiService

<div class="fis-flex-col-gap-125">
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Edit User Profile</h3>
                <p class="text-muted">Select a username to retrieve and update profile details.</p>
            </div>
            <a class="btn btn-secondary btn-sm"
               href="@UserAdminNavigation.GetMenuLink(Navigation)"
               @onclick="NavigateToMenu"
               @onclick:preventDefault="true">Back to Menu</a>
        </div>
        <div class="card-body">
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input" type="text" placeholder="Start typing for a list of valid users"
                           @bind="_selectedUsername"
                           autocomplete="off"
                           @onfocus="OnUserSearchFocus"
                           @onblur="OnUserSearchBlur" />
                    @if (_showUserSuggestions && FilteredUsernames.Count > 0)
                    {
                        <div class="search-suggestions" role="listbox" aria-label="User suggestions">
                            @foreach (var username in FilteredUsernames)
                            {
                                <button type="button"
                                        class="search-suggestion-item"
                                        @onmousedown:preventDefault="true"
                                        @onclick="() => SelectUsername(username)">
                                    @username
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="fis-mt-075">
                <button class="btn btn-primary btn-sm" type="button" @onclick="ShowEditProfile" disabled="@_loadingUser">
                    @(_loadingUser ? "Loading..." : "Edit")
                </button>
            </div>
        </div>
    </div>

    @if (_showEditProfile)
    {
        <div class="card">
            <div class="card-header">
                <div>
                    <h3>User Profile</h3>
                    <p class="text-muted">Update the user profile details.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">First Name</label>
                        <input class="form-input" type="text" @bind="_profile.FirstName" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Last Name</label>
                        <input class="form-input" type="text" @bind="_profile.LastName" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Site</label>
                        <select class="form-select" @bind="_profile.SiteCode" @bind:after="OnSiteChangedAsync">
                            <option value="">Select site</option>
                            @foreach (var site in _sites.OrderBy(s => s.Description))
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Position</label>
                        <select class="form-select" @bind="_profile.PositionCode">
                            <option value="">Select position</option>
                            @foreach (var positionCode in _positionCodes)
                            {
                                <option value="@positionCode">@($"Position ({positionCode})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal</label>
                        <input class="form-input" type="number" @bind="_profile.PersalNumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contract Number</label>
                        <input class="form-input" type="number" @bind="_profile.ContractNumber" />
                        <span class="text-muted">(if No PersalNo is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID</label>
                        <input class="form-input" type="number" @bind="_profile.SaIdNumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number</label>
                        <input class="form-input" type="number" @bind="_profile.PassportNumber" />
                        <span class="text-muted">(if No SA ID is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Email</label>
                        <input class="form-input" type="email" @bind="_profile.Email" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Tel</label>
                        <input class="form-input" type="text" @bind="_profile.Telephone" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Fax</label>
                        <input class="form-input" type="number" @bind="_profile.FaxNumber" />
                        <span class="text-muted">(optional)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Cell</label>
                        <input class="form-input" type="number" @bind="_profile.CellphoneNumber" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Client Approver Name</label>
                        <select class="form-select" @bind="_selectedApproverUserAccessCode" disabled="@(!_profile.SiteCode.HasValue || _siteApprovers.Count == 0)">
                            <option value="">@(_profile.SiteCode.HasValue ? "Select an Approver" : "Select site first")</option>
                            @foreach (var approver in _siteApprovers)
                            {
                                <option value="@approver.UserAccessCode">@ApproverDisplay(approver)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Last Edited By</label>
                        <input class="form-input" type="text" value="@_displayName" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <h3>Edit User Access Level</h3>
                    <p class="text-muted">Toggle access for the selected user.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    @foreach (var role in UserAdminRoleData.AccessOptions)
                    {
                        <label class="form-label form-checkbox">
                            <input type="checkbox"
                                   checked="@HasPermission(role.PermissionBit)"
                                   disabled />
                            <span>@role.Role</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-primary" type="button" @onclick="HandleSubmitChanges" disabled="@_saving">
                @(_saving ? "Saving..." : "Submit Changes")
            </button>
            <button class="btn btn-secondary" type="button" @onclick="ResetChanges">Reset Changes</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    }
</div>

@code {
    private bool _showEditProfile;
    private string _selectedUsername = "";
    private string _displayName = string.Empty;
    private UserProfileEditorModel _profile = new();
    private long _selectedAccessLevel;
    private int _selectedUserAccessCode;
    private bool _loadingUser;
    private bool _saving;
    private bool _showUserSuggestions;
    private string? _errorMessage;
    private string? _successMessage;
    private List<UserSummaryDto> _userSummaries = new();
    private List<SiteResponseDto> _sites = new();
    private List<byte> _positionCodes = new();
    private List<UserProfileDto> _profiles = new();
    private List<UserProfileDto> _siteApprovers = new();
    private short? _selectedApproverUserAccessCode;
    private List<string> FilteredUsernames => _userSummaries
        .Select(user => user.UserName ?? string.Empty)
        .Where(name => name.Length > 0)
        .Where(name => string.IsNullOrWhiteSpace(_selectedUsername) || name.Contains(_selectedUsername, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(20)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = ResolveDisplayName(authState.User);
        _profiles = await UserApiService.GetAllProfilesAsync();
        _userSummaries = _profiles.Select(profile => new UserSummaryDto
        {
            UserAccessCode = profile.UserAccessCode,
            UserName = profile.FirstName,
            Email = profile.Email,
            FirstName = profile.FirstName,
            LastName = profile.LastName,
            Telephone = profile.Telephone,
            LastLoginDate = profile.LastLogOn?.ToString("yyyy-MM-dd HH:mm")
        }).ToList();
        _positionCodes = _profiles
            .Where(profile => profile.PositionCode.HasValue)
            .Select(profile => profile.PositionCode!.Value)
            .Distinct()
            .OrderBy(code => code)
            .ToList();
        _sites = await SiteApiService.GetAllAsync();
        UpdateApproverOptions();
    }

    private async Task ShowEditProfile()
    {
        _errorMessage = null;
        _successMessage = null;
        _showUserSuggestions = false;
        if (string.IsNullOrWhiteSpace(_selectedUsername))
        {
            _errorMessage = "Username is required.";
            return;
        }

        _loadingUser = true;
        try
        {
            var match = _userSummaries.FirstOrDefault(u => string.Equals(u.UserName, _selectedUsername, StringComparison.OrdinalIgnoreCase));
            if (match == null)
            {
                _errorMessage = $"No profile could be found for user {_selectedUsername}.";
                _showEditProfile = false;
                return;
            }

            _selectedUserAccessCode = match.UserAccessCode;
            await LoadSelectedProfileAsync(match.UserAccessCode);
            UpdateApproverOptions();
            _showEditProfile = true;
        }
        finally
        {
            _loadingUser = false;
        }
    }

    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? string.Empty : email;
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private void OnUserSearchFocus(FocusEventArgs _)
    {
        _showUserSuggestions = true;
    }

    private async Task OnUserSearchBlur(FocusEventArgs _)
    {
        await Task.Delay(120);
        _showUserSuggestions = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectUsername(string username)
    {
        _selectedUsername = username;
        _showUserSuggestions = false;
    }

    private async Task HandleSubmitChanges()
    {
        _errorMessage = null;
        _successMessage = null;
        if (_selectedUserAccessCode <= 0)
        {
            _errorMessage = "Selected user not found.";
            return;
        }

        _saving = true;
        try
        {
            var updated = await UserApiService.UpdateProfileAsync(_selectedUserAccessCode, new UpdateUserProfileRequest
            {
                FirstName = _profile.FirstName,
                LastName = _profile.LastName,
                Email = _profile.Email,
                Telephone = _profile.Telephone,
                SiteCode = _profile.SiteCode,
                PositionCode = _profile.PositionCode,
                PersalNumber = _profile.PersalNumber,
                ContractNumber = _profile.ContractNumber,
                SaIdNumber = _profile.SaIdNumber,
                PassportNumber = _profile.PassportNumber,
                CellphoneNumber = _profile.CellphoneNumber,
                FaxNumber = _profile.FaxNumber
            });

            if (updated is not null)
            {
                ApplyProfile(updated);
            }

            _successMessage = "User profile updated in user_access_old1.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"User update failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetChanges()
    {
        _profile = new UserProfileEditorModel();
        _selectedAccessLevel = 0;
        _selectedApproverUserAccessCode = null;
        _siteApprovers = new();
        _errorMessage = null;
        _successMessage = null;
    }

    private async Task LoadSelectedProfileAsync(int userAccessCode)
    {
        var selected = await UserApiService.GetProfileAsync(userAccessCode);
        if (selected is null)
        {
            _errorMessage = "Could not load selected user profile.";
            return;
        }

        ApplyProfile(selected);
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyProfile(UserProfileDto profile)
    {
        _profile = new UserProfileEditorModel
        {
            FirstName = profile.FirstName ?? string.Empty,
            LastName = profile.LastName ?? string.Empty,
            Email = profile.Email ?? string.Empty,
            Telephone = profile.Telephone ?? string.Empty,
            SiteCode = profile.SiteCode,
            PositionCode = profile.PositionCode,
            PersalNumber = profile.PersalNumber,
            ContractNumber = profile.ContractNumber,
            SaIdNumber = profile.SaIdNumber,
            PassportNumber = profile.PassportNumber,
            CellphoneNumber = profile.CellphoneNumber,
            FaxNumber = profile.FaxNumber
        };

        _selectedAccessLevel = profile.AccessLevel;
        EnsureCurrentPositionCodeIsSelectable();
        UpdateApproverOptions();
    }

    private void EnsureCurrentPositionCodeIsSelectable()
    {
        if (!_profile.PositionCode.HasValue)
        {
            return;
        }

        if (_positionCodes.Contains(_profile.PositionCode.Value))
        {
            return;
        }

        _positionCodes.Add(_profile.PositionCode.Value);
        _positionCodes = _positionCodes.OrderBy(code => code).ToList();
    }

    private bool HasPermission(long? permissionBit)
    {
        if (permissionBit is null)
        {
            return false;
        }

        return (_selectedAccessLevel & permissionBit.Value) == permissionBit.Value;
    }

    private Task OnSiteChangedAsync()
    {
        UpdateApproverOptions();
        return Task.CompletedTask;
    }

    private void UpdateApproverOptions()
    {
        if (!_profile.SiteCode.HasValue)
        {
            _siteApprovers = new();
            _selectedApproverUserAccessCode = null;
            return;
        }

        _siteApprovers = _profiles
            .Where(profile => profile.SiteCode == _profile.SiteCode)
            .OrderBy(profile => profile.FirstName)
            .ThenBy(profile => profile.LastName)
            .ToList();

        if (_siteApprovers.All(profile => profile.UserAccessCode != _selectedApproverUserAccessCode))
        {
            _selectedApproverUserAccessCode = null;
        }
    }

    private static string ApproverDisplay(UserProfileDto approver)
    {
        var name = $"{approver.FirstName} {approver.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            name = approver.Email ?? "Unknown";
        }

        return $"{name} ({approver.UserAccessCode})";
    }

    private sealed class UserProfileEditorModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telephone { get; set; } = string.Empty;
        public short? SiteCode { get; set; }
        public byte? PositionCode { get; set; }
        public int? PersalNumber { get; set; }
        public int? ContractNumber { get; set; }
        public int? SaIdNumber { get; set; }
        public int? PassportNumber { get; set; }
        public int? CellphoneNumber { get; set; }
        public int? FaxNumber { get; set; }
    }
}
