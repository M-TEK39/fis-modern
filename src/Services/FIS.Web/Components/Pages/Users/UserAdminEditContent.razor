@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@using System.Linq
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserApiService UserApiService

<div style="display: flex; flex-direction: column; gap: 1.25rem;">
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Edit User Profile</h3>
                <p class="text-muted">Select a username to retrieve and update profile details.</p>
            </div>
            <a class="btn btn-secondary btn-sm"
               href="@UserAdminNavigation.GetMenuLink(Navigation)"
               @onclick="NavigateToMenu"
               @onclick:preventDefault="true">Back to Menu</a>
        </div>
        <div class="card-body">
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input" type="text" placeholder="Start typing for a list of valid users"
                           @bind="_selectedUsername" />
                </div>
            </div>
            <div style="margin-top: 0.75rem;">
                <button class="btn btn-primary btn-sm" type="button" @onclick="ShowEditProfile" disabled="@_loadingUser">
                    @(_loadingUser ? "Loading..." : "Edit")
                </button>
            </div>
        </div>
    </div>

    @if (_showEditProfile)
    {
        <div class="card">
            <div class="card-header">
                <div>
                    <h3>User Profile</h3>
                    <p class="text-muted">Update the user profile details.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">First Name</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Last Name</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Site</label>
                        <select class="form-select">
                            <option>Select a Site</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Position</label>
                        <select class="form-select">
                            <option>Select Position</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contract Number</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(if No PersalNo is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(if No SA ID is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Email</label>
                        <input class="form-input" type="email" @bind="_email" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Tel</label>
                        <input class="form-input" type="text" @bind="_telephone" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Fax</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(optional)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Cell</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Client Approver Name</label>
                        <select class="form-select">
                            <option>Select an Approver (after valid Site selection)</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Last Edited By</label>
                        <input class="form-input" type="text" value="@_displayName" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <h3>Edit User Access Level</h3>
                    <p class="text-muted">Toggle access for the selected user.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    @foreach (var role in UserAdminRoleData.Roles)
                    {
                        <label class="form-label form-checkbox">
                            <input type="checkbox" />
                            <span>@role</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-primary" type="button" @onclick="HandleSubmitChanges" disabled="@_saving">
                @(_saving ? "Saving..." : "Submit Changes")
            </button>
            <button class="btn btn-secondary" type="button" @onclick="ResetChanges">Reset Changes</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    }
</div>

@code {
    private bool _showEditProfile;
    private string _selectedUsername = "";
    private string _displayName = "Authenticated User";
    private string _email = string.Empty;
    private string _telephone = string.Empty;
    private bool _loadingUser;
    private bool _saving;
    private string? _errorMessage;
    private string? _successMessage;
    private List<UserSummaryDto> _userSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = ResolveDisplayName(authState.User);
        _userSummaries = await UserApiService.GetAllSummariesAsync();
    }

    private Task ShowEditProfile()
    {
        _errorMessage = null;
        _successMessage = null;
        if (string.IsNullOrWhiteSpace(_selectedUsername))
        {
            _errorMessage = "Username is required.";
            return Task.CompletedTask;
        }

        _loadingUser = true;
        try
        {
            var match = _userSummaries.FirstOrDefault(u => string.Equals(u.UserName, _selectedUsername, StringComparison.OrdinalIgnoreCase));
            if (match == null)
            {
                _errorMessage = $"No profile could be found for user {_selectedUsername}.";
                _showEditProfile = false;
                return Task.CompletedTask;
            }

            _email = match.Email ?? string.Empty;
            _telephone = match.Telephone ?? string.Empty;
            _showEditProfile = true;
        }
        finally
        {
            _loadingUser = false;
        }

        return Task.CompletedTask;
    }

    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? "Authenticated User" : email;
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private async Task HandleSubmitChanges()
    {
        _errorMessage = null;
        _successMessage = null;
        var match = _userSummaries.FirstOrDefault(u => string.Equals(u.UserName, _selectedUsername, StringComparison.OrdinalIgnoreCase));
        if (match == null)
        {
            _errorMessage = "Selected user not found.";
            return;
        }

        _saving = true;
        try
        {
            await UserApiService.UpdateAsync(match.UserAccessCode, _email, _telephone);
            _successMessage = "User updated successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"User update failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetChanges()
    {
        _email = string.Empty;
        _telephone = string.Empty;
        _errorMessage = null;
        _successMessage = null;
    }
}
