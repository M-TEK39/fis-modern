@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserApiService UserApiService
@inject SiteApiService SiteApiService

<div class="fis-flex-col-gap-125">
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Create New User Account</h3>
                <p class="text-muted">Enter the credentials required to create a new user account.</p>
            </div>
            <a class="btn btn-secondary btn-sm"
               href="@UserAdminNavigation.GetMenuLink(Navigation)"
               @onclick="NavigateToMenu"
               @onclick:preventDefault="true">Back to Menu</a>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">User Name</label>
                    <input class="form-input" type="text" @bind="_userName" />
                </div>
                <div class="form-field">
                    <label class="form-label">E-mail</label>
                    <input class="form-input" type="email" @bind="_email" />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h3>User Profile</h3>
                <p class="text-muted">Capture profile details exactly as required in the workflow.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">First Name</label>
                    <input class="form-input" type="text" @bind="_firstName" />
                </div>
                <div class="form-field">
                    <label class="form-label">Last Name</label>
                    <input class="form-input" type="text" @bind="_lastName" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Site</label>
                    <select class="form-select" @bind="_selectedSiteCode" @bind:after="OnSiteChangedAsync">
                        <option value="">Select site</option>
                        @foreach (var site in _sites.OrderBy(s => s.Description))
                        {
                            <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Position</label>
                    <select class="form-select" @bind="_selectedPositionCode">
                        <option value="">Select Position</option>
                        @foreach (var positionCode in _positionCodes)
                        {
                            <option value="@positionCode">@($"Position ({positionCode})")</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Persal</label>
                    <input class="form-input" type="number" @bind="_persalNumber" />
                </div>
                <div class="form-field">
                    <label class="form-label">Contract Number</label>
                    <input class="form-input" type="number" @bind="_contractNumber" />
                    <span class="text-muted">(if No PersalNo is available)</span>
                </div>
                <div class="form-field">
                    <label class="form-label">ID</label>
                    <input class="form-input" type="number" @bind="_saIdNumber" />
                </div>
                <div class="form-field">
                    <label class="form-label">Passport Number</label>
                    <input class="form-input" type="number" @bind="_passportNumber" />
                    <span class="text-muted">(if No SA ID is available)</span>
                </div>
                <div class="form-field">
                    <label class="form-label">Tel</label>
                    <input class="form-input" type="text" @bind="_telephone" />
                </div>
                <div class="form-field">
                    <label class="form-label">Fax</label>
                    <input class="form-input" type="number" @bind="_faxNumber" />
                    <span class="text-muted">(optional)</span>
                </div>
                <div class="form-field">
                    <label class="form-label">Cell</label>
                    <input class="form-input" type="number" @bind="_cellphoneNumber" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Client Approver Name</label>
                    <select class="form-select" @bind="_selectedApproverUserAccessCode" disabled="@(!_selectedSiteCode.HasValue || _siteApprovers.Count == 0)">
                        <option value="">@(_selectedSiteCode.HasValue ? "Select an Approver" : "Select site first")</option>
                        @foreach (var approver in _siteApprovers)
                        {
                            <option value="@approver.UserAccessCode">@ApproverDisplay(approver)</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Added By</label>
                    <input class="form-input" type="text" value="@_displayName" readonly />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h3>Access Level Data</h3>
                <p class="text-muted">Select module access for this user.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="form-grid">
                @foreach (var role in UserAdminRoleData.Roles)
                {
                    <label class="form-label form-checkbox">
                        <input type="checkbox" />
                        <span>@role</span>
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="page-actions">
        <button class="btn btn-primary" type="button" @onclick="HandleCreateUser" disabled="@_submitting">
            @(_submitting ? "Creating..." : "Create User")
        </button>
        <button class="btn btn-secondary" type="button" @onclick="ClearValues">Clear Values</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error-circle"></i>
            @_errorMessage
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success">
            @_successMessage
        </div>
    }
</div>

@code {
    private string _displayName = "Authenticated User";
    private string _userName = string.Empty;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _telephone = string.Empty;
    private short? _selectedSiteCode;
    private byte? _selectedPositionCode;
    private int? _persalNumber;
    private int? _contractNumber;
    private int? _saIdNumber;
    private int? _passportNumber;
    private int? _faxNumber;
    private int? _cellphoneNumber;
    private short? _selectedApproverUserAccessCode;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _submitting;
    private List<SiteResponseDto> _sites = new();
    private List<byte> _positionCodes = new();
    private List<UserProfileDto> _profiles = new();
    private List<UserProfileDto> _siteApprovers = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _displayName = ResolveDisplayName(authState.User);
        _sites = await SiteApiService.GetAllAsync();
        _profiles = await UserApiService.GetAllProfilesAsync();
        _positionCodes = _profiles
            .Where(profile => profile.PositionCode.HasValue)
            .Select(profile => profile.PositionCode!.Value)
            .Distinct()
            .OrderBy(code => code)
            .ToList();
        UpdateApproverOptions();
    }

    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? "Authenticated User" : email;
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private async Task HandleCreateUser()
    {
        _errorMessage = null;
        _successMessage = null;
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            _errorMessage = "First Name and Last Name are required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorMessage = "Email is required.";
            return;
        }

        _submitting = true;
        try
        {
            var created = await UserApiService.CreateAsync(_email, _telephone, _firstName, _lastName);
            if (created is null || created.UserAccessCode <= 0)
            {
                _errorMessage = "User creation failed.";
                return;
            }

            await UserApiService.UpdateProfileAsync(created.UserAccessCode, new UpdateUserProfileRequest
            {
                FirstName = _firstName,
                LastName = _lastName,
                Email = _email,
                Telephone = _telephone,
                SiteCode = _selectedSiteCode,
                PositionCode = _selectedPositionCode,
                PersalNumber = _persalNumber,
                ContractNumber = _contractNumber,
                SaIdNumber = _saIdNumber,
                PassportNumber = _passportNumber,
                CellphoneNumber = _cellphoneNumber,
                FaxNumber = _faxNumber
            });

            _successMessage = "User created successfully.";
            _profiles = await UserApiService.GetAllProfilesAsync();
            UpdateApproverOptions();
        }
        catch (Exception ex)
        {
            _errorMessage = $"User creation failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ClearValues()
    {
        _firstName = string.Empty;
        _lastName = string.Empty;
        _userName = string.Empty;
        _email = string.Empty;
        _telephone = string.Empty;
        _selectedSiteCode = null;
        _selectedPositionCode = null;
        _persalNumber = null;
        _contractNumber = null;
        _saIdNumber = null;
        _passportNumber = null;
        _faxNumber = null;
        _cellphoneNumber = null;
        _selectedApproverUserAccessCode = null;
        _siteApprovers = new();
        _errorMessage = null;
        _successMessage = null;
    }

    private Task OnSiteChangedAsync()
    {
        UpdateApproverOptions();
        return Task.CompletedTask;
    }

    private void UpdateApproverOptions()
    {
        if (!_selectedSiteCode.HasValue)
        {
            _siteApprovers = new();
            _selectedApproverUserAccessCode = null;
            return;
        }

        _siteApprovers = _profiles
            .Where(profile => profile.SiteCode == _selectedSiteCode)
            .OrderBy(profile => profile.FirstName)
            .ThenBy(profile => profile.LastName)
            .ToList();

        if (_siteApprovers.All(profile => profile.UserAccessCode != _selectedApproverUserAccessCode))
        {
            _selectedApproverUserAccessCode = null;
        }
    }

    private static string ApproverDisplay(UserProfileDto approver)
    {
        var name = $"{approver.FirstName} {approver.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            name = approver.Email ?? "Unknown";
        }

        return $"{name} ({approver.UserAccessCode})";
    }
}
