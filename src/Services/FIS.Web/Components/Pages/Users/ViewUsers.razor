@page "/users/view"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>View User Details - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-list-ul"></i>
            View User Details
        </h1>
        <p class="page-description">Browse user records and access key actions.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminViewUsersContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/UserAdmin.aspx"
        Endpoint="api/user"
        HttpMethod="GET"
        ButtonText="Test View Users Endpoint"
        ReportType="useradmin-view-users" />

</div>
