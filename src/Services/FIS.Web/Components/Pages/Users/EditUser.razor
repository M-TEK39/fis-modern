@page "/users/edit"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Edit User Profile - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-edit"></i>
            Edit User Profile
        </h1>
        <p class="page-description">Search and update existing user profiles and access.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminEditContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/EditProfile.aspx"
        Endpoint="api/user/1"
        HttpMethod="PUT"
        ButtonText="Test Edit User Endpoint"
        ReportType="useradmin-edit-user" />

</div>
