@page "/users/forgot-password"
@page "/forgot-password"
@rendermode InteractiveServer
@layout FIS.Web.Components.Layout.AuthLayout
@using FIS.Web.Components.Pages.Users
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Forgot Password - Fleet Information System</PageTitle>

<div class="auth-card auth-card-wide">
    <div class="auth-header">
        <h1>Forgot Password</h1>
        <p>Recover access to your Fleet Information System account.</p>
    </div>

    <UserAdminForgotPasswordContent PublicMode="true" />
</div>
