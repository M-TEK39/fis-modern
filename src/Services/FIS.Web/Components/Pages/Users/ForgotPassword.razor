@page "/users/forgot-password"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Forgot Password - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Forgot Password
        </h1>
        <p class="page-description">Legacy password recovery flow.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminForgotPasswordContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/ForgotPassword.aspx"
        Endpoint="api/auth/forgot-password/start"
        HttpMethod="POST"
        ButtonText="Test Forgot Password Start Endpoint"
        ReportType="useradmin-forgot-password" />

</div>
