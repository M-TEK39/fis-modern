@page "/users/add"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Add New User - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-plus"></i>
            Add New User
        </h1>
        <p class="page-description">Create a new user account and assign access levels.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminAddContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/AddNewUserProfile.aspx"
        Endpoint="api/user"
        HttpMethod="POST"
        ButtonText="Test Add User Endpoint"
        ReportType="useradmin-add-user" />

</div>
