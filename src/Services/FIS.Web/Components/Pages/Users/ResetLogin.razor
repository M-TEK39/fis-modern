@page "/users/reset-login"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Reset Login - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-refresh"></i>
            Reset Login
        </h1>
        <p class="page-description">Reset user password counters and unlock accounts.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminResetLoginContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/ResetLogin.aspx"
        Endpoint="api/auth/reset-login"
        HttpMethod="POST"
        ButtonText="Test Reset Login Endpoint"
        ReportType="useradmin-reset-login" />

</div>
