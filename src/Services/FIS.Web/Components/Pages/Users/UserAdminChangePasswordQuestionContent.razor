@using FIS.Web.Components.Pages.Users
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthApiService AuthApiService

<div class="card">
    <div class="card-header">
        <div>
            <h3>Change Password</h3>
            <p class="text-muted">Reset password, question, and answer for the new security methodology.</p>
        </div>
        <a class="btn btn-secondary btn-sm"
           href="@UserAdminNavigation.GetMenuLink(Navigation)"
           @onclick="NavigateToMenu"
           @onclick:preventDefault="true">Back to Menu</a>
    </div>
    <div class="card-body">
        <p class="text-muted">A new security methodology has been implemented, therefore you are required to reset your password, question and answer to accommodate the new security methodology.</p>
        <p class="text-muted">You have the option to change your password whenever you have the need but the password must be changed at least every month.</p>
        <div class="card" style="background: var(--fis-accent-soft); border-color: var(--fis-border); box-shadow: none;">
            <strong>Passwords have the following requirements:</strong>
            <ol style="margin-top: 0.5rem; padding-left: 1.2rem;">
                <li>It should never be shared with anyone!</li>
                <li>The length must be at least 8 characters</li>
                <li>It must contain at least 1 number</li>
                <li>It must contain at least 1 upper case letter</li>
                <li>It must contain at least 1 lower case letter</li>
                <li>It must contain at least 1 non alphanumeric character</li>
                <li>It cannot be the same as the previous 3 passwords</li>
            </ol>
        </div>
        <p class="text-muted">NOTE : After three incorrect password entries your username will be disabled for 60 minutes, before you may try again.</p>
        <p class="text-muted">You can use the Password reset function on the login page, should you forget your password.</p>
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Username</label>
                <input class="form-input" type="text" @bind="_username" />
            </div>
            <div class="form-field">
                <label class="form-label">Old Password</label>
                <input class="form-input" type="password" @bind="_oldPassword" />
            </div>
            <div class="form-field">
                <label class="form-label">New Password</label>
                <input class="form-input" type="password" @bind="_newPassword" />
            </div>
            <div class="form-field">
                <label class="form-label">Confirm New Password</label>
                <input class="form-input" type="password" @bind="_confirmNewPassword" />
            </div>
            <div class="form-field form-group-full">
                <label class="form-label">New Password Question</label>
                <select class="form-select" @bind="_securityQuestion">
                    <option>Select Question...</option>
                    <option>What was your childhood nickname?</option>
                    <option>What school did you attend for sixth grade?</option>
                    <option>What is your mother's maiden name?</option>
                    <option>In what city or town was your first job?</option>
                    <option>What is your spouse's mother's maiden name?</option>
                    <option>Who was your childhood hero?</option>
                    <option>What are the last 5 digits of your driver's license number?</option>
                    <option>What is your father's middle name?</option>
                    <option>What is the name of your favorite childhood friend?</option>
                    <option>What was the name of your first stuffed animal?</option>
                    <option>What colour was your first car?</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">New Password Answer</label>
                <input class="form-input" type="text" @bind="_securityAnswer" />
            </div>
            <div class="form-field">
                <label class="form-label">Email Address</label>
                <input class="form-input" type="email" @bind="_email" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" type="button" @onclick="HandleChangePassword" disabled="@_submitting">
            @(_submitting ? "Updating..." : "Change Password")
        </button>
        <a class="btn btn-secondary" href="/login">Cancel</a>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private string _username = "authenticated@local";
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private string _securityQuestion = "Select Question...";
    private string _securityAnswer = string.Empty;
    private string _email = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _username = ResolveUsername(authState.User);
        _email = ResolveEmail(authState.User);
    }

    private async Task HandleChangePassword()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_newPassword != _confirmNewPassword)
        {
            _errorMessage = "The Confirm New Password must match the New Password entry.";
            return;
        }

        if (_securityQuestion == "Select Question...")
        {
            _errorMessage = "Security question is required.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ChangePasswordQuestionAsync(new ChangePasswordQuestionRequest
            {
                Username = _username,
                OldPassword = _oldPassword,
                NewPassword = _newPassword,
                ConfirmNewPassword = _confirmNewPassword,
                SecurityQuestion = _securityQuestion,
                SecurityAnswer = _securityAnswer,
                Email = _email
            });

            if (response.Success)
            {
                _successMessage = response.Message ?? "Password successfully changed.";
                _oldPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmNewPassword = string.Empty;
                _securityAnswer = string.Empty;
            }
            else
            {
                _errorMessage = response.Message ?? "Password change failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Password change failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string ResolveUsername(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? "authenticated@local" : email;
    }

    private static string ResolveEmail(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value;

        return string.IsNullOrWhiteSpace(email) ? string.Empty : email;
    }
}
