@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@using System.Linq
@inject AuthApiService AuthApiService
@inject UserApiService UserApiService

<div class="card">
    <div class="card-header">
        <div>
            <h3>Search for the User you want to De-Activate or Activate</h3>
            <p class="text-muted">Manage user activation status.</p>
        </div>
        <a class="btn btn-secondary btn-sm"
           href="@UserAdminNavigation.GetMenuLink(Navigation)"
           @onclick="NavigateToMenu"
           @onclick:preventDefault="true">Back</a>
    </div>
    <div class="card-body">
        <div class="search-bar">
            <div class="search-input-wrapper">
                <i class="bx bx-search"></i>
                <input class="search-input" type="text" placeholder="Start typing for a list of valid users" @bind="_username" />
            </div>
        </div>
        <div class="fis-mt-075 fis-flex-wrap-gap-05">
            <button class="btn btn-secondary" type="button" @onclick="HandleDeactivate" disabled="@_submitting">De-Activate User</button>
            <button class="btn btn-secondary" type="button" @onclick="HandleDeactivateExpired" disabled="@_submitting">De-ActivateUser Expired Password</button>
            <button class="btn btn-secondary" type="button" @onclick="HandleActivate" disabled="@_submitting">Activate User</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
    private string _username = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _submitting;
    private List<UserSummaryDto> _userSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        _userSummaries = await UserApiService.GetAllSummariesAsync();
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private async Task HandleDeactivate()
    {
        await HandleUserAction(async () =>
        {
            var user = ResolveUser();
            await UserApiService.DeleteAsync(user.UserAccessCode);
        }, "User deactivated.");
    }

    private async Task HandleDeactivateExpired()
    {
        await HandleUserAction(async () =>
        {
            var user = ResolveUser();
            await AuthApiService.DeactivateExpiredPasswordAsync(new DeactivateExpiredPasswordRequest
            {
                Username = user.UserName ?? _username
            });
        }, "User deactivated.");
    }

    private async Task HandleActivate()
    {
        await HandleUserAction(async () =>
        {
            var user = ResolveUser();
            await AuthApiService.ActivateUserAsync(new ActivateUserRequest
            {
                Username = user.UserName ?? _username
            });
        }, "User activated.");
    }

    private async Task HandleUserAction(Func<Task> action, string successMessage)
    {
        _errorMessage = null;
        _successMessage = null;
        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "Username is required.";
            return;
        }

        _submitting = true;
        try
        {
            await action();
            _successMessage = successMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Operation failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private UserSummaryDto ResolveUser()
    {
        var match = _userSummaries.FirstOrDefault(u =>
            string.Equals(u.UserName, _username, StringComparison.OrdinalIgnoreCase));
        return match ?? new UserSummaryDto { UserName = _username };
    }
}
