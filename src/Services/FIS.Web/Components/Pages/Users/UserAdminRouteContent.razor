@using FIS.Web.Components.Pages.Users
@inject NavigationManager Navigation

@if (RouteKey != UserAdminRoutes.Menu)
{
    <div class="breadcrumb app-breadcrumbs">
        <a class="breadcrumb-link"
           href="@UserAdminNavigation.GetMenuLink(Navigation)"
           @onclick="NavigateToMenu"
           @onclick:preventDefault="true">
            User Admin Menu
        </a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">@GetRouteTitle(RouteKey)</span>
    </div>
}

@switch (RouteKey)
{
    case UserAdminRoutes.Edit:
        <UserAdminEditContent />
        break;
    case UserAdminRoutes.ResetLogin:
        <UserAdminResetLoginContent />
        break;
    case UserAdminRoutes.Deactivate:
        <UserAdminDeactivateContent />
        break;
    case UserAdminRoutes.ViewUsers:
        <UserAdminViewUsersContent />
        break;
    case UserAdminRoutes.ChangePasswordQuestion:
        <UserAdminChangePasswordQuestionContent />
        break;
    case UserAdminRoutes.ForcePassword:
        <UserAdminForcePasswordContent />
        break;
    case UserAdminRoutes.ForgotPassword:
        <UserAdminForgotPasswordContent />
        break;
    default:
        <UserAdminMenuContent />
        break;
}

@code {
    [Parameter]
    public string RouteKey { get; set; } = UserAdminRoutes.Menu;

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private static string GetRouteTitle(string routeKey) => routeKey switch
    {
        UserAdminRoutes.Edit => "Update or Modify User Details",
        UserAdminRoutes.ResetLogin => "Reset User Password Counter",
        UserAdminRoutes.Deactivate => "Delete (or De-Activate) User",
        UserAdminRoutes.ViewUsers => "View User Details",
        UserAdminRoutes.ChangePasswordQuestion => "Change Password and Password Question",
        UserAdminRoutes.ForcePassword => "Force Password Change",
        UserAdminRoutes.ForgotPassword => "Reset Password",
        _ => "User Admin"
    };
}
