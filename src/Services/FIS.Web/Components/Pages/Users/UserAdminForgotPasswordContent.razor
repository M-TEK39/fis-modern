@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@inject AuthApiService AuthApiService

<div class="card">
    <div class="card-header">
        <div>
            <h3>Forgot Your Password?</h3>
            <p class="text-muted">Password recovery flow.</p>
        </div>
        <a class="btn btn-secondary btn-sm"
           href="@UserAdminNavigation.GetMenuLink(Navigation)"
           @onclick="NavigateToMenu"
           @onclick:preventDefault="true">Back to Menu</a>
    </div>
    <div class="card-body">
        @if (_step == 1)
        {
            <p>Enter your username below.</p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Username</label>
                    <input class="form-input" type="text" @bind="_username" />
                    <span class="text-muted">Please contact your CallCenter and Check your login details.</span>
                </div>
            </div>
            <div class="fis-mt-075">
                <button class="btn btn-primary" type="button" @onclick="HandleStart" disabled="@_submitting">
                    @(_submitting ? "Loading..." : "Next")
                </button>
            </div>
        }
        else if (_step == 2)
        {
            <p>Identity Confirmation</p>
            <p>Provide the User`s answer to the question below.</p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">User Name</label>
                    <input class="form-input" type="text" value="@_username" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Question</label>
                    <input class="form-input" type="text" value="@_question" readonly />
                </div>
                <div class="form-field">
                    <label class="form-label">Answer</label>
                    <input class="form-input" type="text" @bind="_answer" />
                </div>
            </div>
            <div class="fis-mt-075 fis-flex-gap-05">
                <button class="btn btn-primary" type="button" @onclick="HandleConfirm" disabled="@_submitting">
                    @(_submitting ? "Submitting..." : "Submit")
                </button>
                <button class="btn btn-secondary" type="button" @onclick="() => SetStep(1)">Back</button>
            </div>
        }
        else
        {
            <p>New password generated.</p>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert alert-info">@_message</div>
            }
            <div class="fis-flex-gap-05">
                <button class="btn btn-secondary" type="button" @onclick="() => SetStep(2)">Try Again</button>
                <button class="btn btn-primary" type="button" @onclick="() => SetStep(1)">Return to Main Menu</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
    </div>
</div>

@code {
    private int _step = 1;
    private string _username = "";
    private string _answer = string.Empty;
    private string _question = string.Empty;
    private string? _errorMessage;
    private string? _message;
    private bool _submitting;
    
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void SetStep(int step)
    {
        _step = step;
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private async Task HandleStart()
    {
        _errorMessage = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "Username is required.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ForgotPasswordStartAsync(new ForgotPasswordStartRequest
            {
                Username = _username
            });

            if (response.Success)
            {
                _question = response.Question ?? "Security question unavailable.";
                _step = 2;
            }
            else
            {
                _errorMessage = response.Message ?? "Unable to find user.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to start password reset: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task HandleConfirm()
    {
        _errorMessage = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_answer))
        {
            _errorMessage = "Answer is required.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ForgotPasswordConfirmAsync(new ForgotPasswordConfirmRequest
            {
                Username = _username,
                Answer = _answer
            });

            if (response.Success)
            {
                _message = response.Message ?? "New password generated.";
                _step = 3;
            }
            else
            {
                _errorMessage = response.Message ?? "Password reset failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Password reset failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
