@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@inject AuthApiService AuthApiService

<div class="card">
    <div class="card-header">
        <div>
            <h3>Forgot Your Password?</h3>
            <p class="text-muted">We will email you a secure, one-time password reset link.</p>
        </div>
        <a class="btn btn-secondary btn-sm"
           href="@GetBackLink()"
           @onclick="NavigateBack"
           @onclick:preventDefault="true">@(PublicMode ? "Back to Sign In" : "Back to Menu")</a>
    </div>
    <div class="card-body">
        @if (_step == 1)
        {
            <p>Enter your username, email address, or user code.</p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label" for="forgot-password-identifier">Username or email</label>
                    <input id="forgot-password-identifier" class="form-input" type="text" @bind="_username" autocomplete="username" />
                    <span class="text-muted">The reset link is sent only to the email address registered for the account.</span>
                </div>
            </div>
            <div class="fis-mt-075">
                <button class="btn btn-primary" type="button" @onclick="HandleStart" disabled="@_submitting">
                    @(_submitting ? "Sending..." : "Send reset link")
                </button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert alert-info">@_message</div>
            }
            <p>Check your email for the reset link. You must open that link before choosing a new password.</p>
            <div class="fis-flex-gap-05">
                <button class="btn btn-secondary" type="button" @onclick="() => SetStep(1)">Try again</button>
                <a class="btn btn-primary" href="@GetBackLink()" @onclick="NavigateBack" @onclick:preventDefault="true">Return</a>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
    </div>
</div>

@code {
    private int _step = 1;
    private string _username = "";
    private string? _errorMessage;
    private string? _message;
    private bool _submitting;

    [Parameter]
    public bool PublicMode { get; set; }
    
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void SetStep(int step)
    {
        _step = step;
    }

    private string GetBackLink()
    {
        return PublicMode ? "/login" : UserAdminNavigation.GetMenuLink(Navigation);
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo(GetBackLink());
    }

    private async Task HandleStart()
    {
        _errorMessage = null;
        _message = null;
        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "Username is required.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ForgotPasswordStartAsync(new ForgotPasswordStartRequest
            {
                Username = _username
            });

            if (response.Success)
            {
                _message = response.Message ?? "If an account with a registered email address exists, a password reset link has been sent.";
                _step = 2;
            }
            else
            {
                _errorMessage = response.Message ?? "Unable to find user.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to start password reset: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

}
