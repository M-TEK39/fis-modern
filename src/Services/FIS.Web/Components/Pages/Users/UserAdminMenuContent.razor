@using FIS.Web.Components.Pages.Users
@inject NavigationManager Navigation

<div class="menu-tiles fis-mt-1">
    <div class="menu-tile">
        <div class="menu-tile-header">
            <span>User Admin Menu</span>
        </div>
        <div class="menu-tile-body">
            <div class="menu-item">
                <a class="menu-item-link"
                   href="/users/add"
                   @onclick="NavigateToAdd"
                   @onclick:preventDefault="true">1) Add New User</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="/users/edit"
                   @onclick="NavigateToEdit"
                   @onclick:preventDefault="true">2)  Update or Modify User Details</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="@UserAdminNavigation.GetLink(Navigation, UserAdminRoutes.ResetLogin)"
                   @onclick="() => NavigateTo(UserAdminRoutes.ResetLogin)"
                   @onclick:preventDefault="true">3) Reset User Password Counter</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="@UserAdminNavigation.GetLink(Navigation, UserAdminRoutes.Deactivate)"
                   @onclick="() => NavigateTo(UserAdminRoutes.Deactivate)"
                   @onclick:preventDefault="true">4) Delete (or De-Activate) User</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="@UserAdminNavigation.GetLink(Navigation, UserAdminRoutes.ViewUsers)"
                   @onclick="() => NavigateTo(UserAdminRoutes.ViewUsers)"
                   @onclick:preventDefault="true">5) View User Details</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="@UserAdminNavigation.GetLink(Navigation, UserAdminRoutes.ChangePasswordQuestion)"
                   @onclick="() => NavigateTo(UserAdminRoutes.ChangePasswordQuestion)"
                   @onclick:preventDefault="true">6) Change Password and Password Question</a>
            </div>
            <div class="menu-item">
                <a class="menu-item-link"
                   href="@UserAdminNavigation.GetLink(Navigation, UserAdminRoutes.ForcePassword)"
                   @onclick="() => NavigateTo(UserAdminRoutes.ForcePassword)"
                   @onclick:preventDefault="true">7) Force Password Change</a>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateTo(string target)
    {
        var link = UserAdminNavigation.GetLink(Navigation, target);
        Navigation.NavigateTo(link);
    }

    private void NavigateToAdd()
    {
        Navigation.NavigateTo("/users/add");
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo("/users/edit");
    }
}
