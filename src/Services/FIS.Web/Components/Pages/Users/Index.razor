@page "/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Components.Pages.Users

<PageTitle>User Administration - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-circle"></i>
            User Administration
        </h1>
        <p class="page-description">Legacy user administration menu and tools.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminRouteContent RouteKey="_routeKey" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "settings")]
    public string? Settings { get; set; }

    private string _routeKey = UserAdminRoutes.Menu;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Settings))
        {
            _routeKey = UserAdminRoutes.Menu;
            return;
        }

        if (Settings.StartsWith("users", StringComparison.OrdinalIgnoreCase))
        {
            _routeKey = UserAdminRoutes.FromPath("/" + Settings.TrimStart('/'));
            return;
        }

        _routeKey = UserAdminRoutes.Menu;
    }
}
