@page "/users"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject UserApiService UserService

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bxs-user-plus"></i>
            User Management
        </h1>
        <p class="page-description">Manage system users and their access permissions</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus"></i>
            Add User
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading users...</p>
        </div>
    }
    else if (_users.Count == 0)
    {
        <div class="empty-state">
            <h3>No users found</h3>
            <p>Get started by adding your first system user</p>
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus plus-icon"></i>
                Add User
            </button>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_users.Count User(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User Code</th>
                            <th>Email</th>
                            <th>Telephone</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td>@user.UserAccessCode</td>
                                <td>@user.Email</td>
                                <td>@user.TelephoneNumber</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(user)" title="Edit">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                        <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(user)" title="Delete">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<Modal IsVisible="_showDialog" 
       Title="@(_isEdit ? "Edit User" : "Add User")" 
       SubmitText="@(_isEdit ? "Update" : "Create")"
       IsSaving="_saving"
       OnSubmit="SaveUser" 
       OnCancel="HideDialog">
    <div class="form-grid">
        <div class="form-field">
            <label class="form-label">Email Address</label>
            <input type="email" @bind="_currentUser.Email" class="form-input" placeholder="Enter email address" />
        </div>
        <div class="form-field">
            <label class="form-label">Telephone Number</label>
            <input type="tel" @bind="_currentUser.TelephoneNumber" class="form-input" placeholder="Enter telephone number" />
        </div>
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm" 
                  Title="Confirm Delete" 
                  ConfirmText="Delete"
                  IsDeleting="_deleting"
                  OnConfirm="DeleteUser" 
                  OnCancel="HideDeleteDialog">
    <p>Are you sure you want to delete user code <strong>@_currentUser.UserAccessCode</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<ApiUserViewModel> _users = new();
    private ApiUserViewModel _currentUser = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;
    private bool _deleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        try
        {
            var users = await UserService.GetAllAsync();
            _users = users.Select(u => new ApiUserViewModel
            {
                UserAccessCode = u.UserAccessCode,
                Email = u.Email,
                TelephoneNumber = u.TelephoneNumber
            }).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowAddDialog()
    {
        _currentUser = new ApiUserViewModel();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(ApiUserViewModel user)
    {
        _currentUser = new ApiUserViewModel
        {
            UserAccessCode = user.UserAccessCode,
            Email = user.Email,
            TelephoneNumber = user.TelephoneNumber
        };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(ApiUserViewModel user)
    {
        _currentUser = user;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentUser = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveUser()
    {
        _saving = true;
        try
        {
            if (_isEdit && _currentUser.UserAccessCode.HasValue)
            {
                await UserService.UpdateAsync(_currentUser.UserAccessCode.Value, _currentUser.Email, _currentUser.TelephoneNumber);
            }
            else
            {
                await UserService.CreateAsync(_currentUser.Email, _currentUser.TelephoneNumber);
            }

            await LoadUsers();
            HideDialog();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteUser()
    {
        _deleting = true;
        try
        {
            if (_currentUser.UserAccessCode.HasValue)
            {
                await UserService.DeleteAsync(_currentUser.UserAccessCode.Value);
                await LoadUsers();
            }
        }
        finally
        {
            _deleting = false;
            HideDeleteDialog();
        }
    }

    private class ApiUserViewModel
    {
        public int? UserAccessCode { get; set; }
        public string? Email { get; set; }
        public string? TelephoneNumber { get; set; }
    }
}
