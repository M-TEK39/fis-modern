@page "/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Models
@using FIS.Web.Services
@inject UserApiService UserService
@inject IJSRuntime JSRuntime

<PageTitle>User Administration - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-circle"></i>
            User Administration
        </h1>
        <p class="page-description">User administration menu and tools.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminRouteContent RouteKey="_routeKey" />

    @if (_routeKey == UserAdminRoutes.Menu)
    {
        <DataPreviewTable Title="User Preview"
                          SearchPlaceholder="Search user name, email, site, position..."
                          EmptyMessage="No users match the current search or filter."
                          EmptyIcon="bx bx-user"
                          IsLoading="_loading"
                          Columns="_columns"
                          Rows="_rows"
                          Filters="_filters" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "settings")]
    public string? Settings { get; set; }

    private string _routeKey = UserAdminRoutes.Menu;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("user", "User"),
        new("email", "Email"),
        new("site", "Site"),
        new("position", "Position"),
        new("telephone", "Telephone"),
        new("lastLogin", "Last Login")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Users with email", "emailStatus", "Email Captured"),
        new("Users with telephone", "telephoneStatus", "Telephone Captured"),
        new("Users with recent login", "loginStatus", "Login Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Settings))
        {
            _routeKey = UserAdminRoutes.Menu;
            return;
        }

        if (Settings.StartsWith("users", StringComparison.OrdinalIgnoreCase))
        {
            _routeKey = UserAdminRoutes.FromPath("/" + Settings.TrimStart('/'));
            return;
        }

        _routeKey = UserAdminRoutes.Menu;
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var users = await UserService.GetAllSummariesAsync();
            _rows = users
                .OrderBy(item => item.LastName)
                .ThenBy(item => item.FirstName)
                .Select(item => new Dictionary<string, string?>
                {
                    ["user"] = $"{item.FirstName} {item.LastName}".Trim(),
                    ["email"] = item.Email,
                    ["site"] = item.SiteName,
                    ["position"] = item.Position,
                    ["telephone"] = item.Telephone,
                    ["lastLogin"] = item.LastLoginDate,
                    ["emailStatus"] = string.IsNullOrWhiteSpace(item.Email) ? "No Email" : "Email Captured",
                    ["telephoneStatus"] = string.IsNullOrWhiteSpace(item.Telephone) ? "No Telephone" : "Telephone Captured",
                    ["loginStatus"] = string.IsNullOrWhiteSpace(item.LastLoginDate) ? "No Login" : "Login Captured",
                    ["_href"] = $"/users?settings=users/edit&userAccessCode={item.UserAccessCode}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading user preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
