    private async Task HandleChangePasswordQuestion()
    {
        _changeErrorMessage = null;
        _changeSuccessMessage = null;

        if (_changeNewPassword != _changeConfirmPassword)
        {
            _changeErrorMessage = "The Confirm New Password must match the New Password entry.";
            return;
        }

        if (_changeSecurityQuestion == "Select Question...")
        {
            _changeErrorMessage = "Security question is required.";
            return;
        }

        _changeSubmitting = true;
        try
        {
            var response = await AuthApiService.ChangePasswordQuestionAsync(new ChangePasswordQuestionRequest
            {
                Username = _changeUsername,
                OldPassword = _changeOldPassword,
                NewPassword = _changeNewPassword,
                ConfirmNewPassword = _changeConfirmPassword,
                SecurityQuestion = _changeSecurityQuestion,
                SecurityAnswer = _changeSecurityAnswer,
                Email = _changeEmail
            });

            if (response.Success)
            {
                _changeSuccessMessage = response.Message ?? "Password successfully changed.";
                _changeOldPassword = string.Empty;
                _changeNewPassword = string.Empty;
                _changeConfirmPassword = string.Empty;
                _changeSecurityAnswer = string.Empty;
            }
            else
            {
                _changeErrorMessage = response.Message ?? "Password change failed.";
            }
        }
        catch (Exception ex)
        {
            _changeErrorMessage = $"Password change failed: {ex.Message}";
        }
        finally
