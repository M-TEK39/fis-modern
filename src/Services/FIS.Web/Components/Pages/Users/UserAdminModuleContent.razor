@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Models
@using FIS.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthApiService AuthApiService
@inject UserApiService UserApiService

@if (_activeView == ViewMenu)
{
    <div class="menu-tiles fis-mt-1">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>User Admin Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewAdd)">1) Add New User</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewEdit)">2)  Update or Modify User Details</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewResetLogin)">3) Reset User Password Counter</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewDeactivate)">4) Delete (or De-Activate) User</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewViewUsers)">5) View User Details</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewChangeV1)">6) Change Password and Password Question</a>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="#" @onclick:preventDefault="true" @onclick="() => GoTo(ViewForcePassword)">7) Force Password Change</a>
                </div>
            </div>
        </div>
    </div>
}
else if (_activeView == ViewAdd)
{
    <div class="fis-flex-col-gap-125">
        <div class="card">
            <div class="card-header">
                <div>
                    <h3>Create New User Account</h3>
                    <p class="text-muted">Enter the credentials required to create a new user account.</p>
                </div>
                <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back to Menu</button>
            </div>
            <div class="card-body">
                <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">User Name</label>
                    <input class="form-input" type="text" @bind="_addUserName" />
                </div>
                <div class="form-field">
                    <label class="form-label">E-mail</label>
                    <input class="form-input" type="email" @bind="_addEmail" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_addErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_addErrorMessage
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_addSuccessMessage))
            {
                <div class="alert alert-success">
                    @_addSuccessMessage
                </div>
            }
        </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <h3>User Profile</h3>
                    <p class="text-muted">Capture profile details exactly as required in the workflow.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">First Name</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Last Name</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Site</label>
                        <select class="form-select">
                            <option>Select a Site</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Position</label>
                        <select class="form-select">
                            <option>Select Position</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contract Number</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(if No PersalNo is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">ID</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(if No SA ID is available)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Tel</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Fax</label>
                        <input class="form-input" type="text" />
                        <span class="text-muted">(optional)</span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Cell</label>
                        <input class="form-input" type="text" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Client Approver Name</label>
                        <select class="form-select">
                            <option>Select an Approver (after valid Site selection)</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Added By</label>
                        <input class="form-input" type="text" value="@_displayName" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <h3>Access Level Data</h3>
                    <p class="text-muted">Select module access for this user.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    @foreach (var role in _accessRoles)
                    {
                        <label class="form-label form-checkbox">
                            <input type="checkbox" />
                            <span>@role</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-primary" type="button" @onclick="HandleAddUser" disabled="@_addSubmitting">
                @(_addSubmitting ? "Saving..." : "Create User")
            </button>
            <button class="btn btn-secondary" type="button" @onclick="ClearAddUserFields" disabled="@_addSubmitting">Clear Values</button>
        </div>
    </div>
}
else if (_activeView == ViewEdit)
{
    <div class="fis-flex-col-gap-125">
        <div class="card">
            <div class="card-header">
                <div>
                    <h3>Edit User Profile</h3>
                    <p class="text-muted">Select a username to retrieve and update profile details.</p>
                </div>
                <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back to Menu</button>
            </div>
            <div class="card-body">
                <div class="search-bar">
                    <div class="search-input-wrapper">
                        <i class="bx bx-search"></i>
                        <input class="search-input" type="text" placeholder="Start typing for a list of valid users"
                               @bind="_selectedUsername" />
                    </div>
                </div>
                <div class="fis-mt-075">
                    <button class="btn btn-primary btn-sm" type="button" @onclick="ShowEditProfile">Edit</button>
                </div>
            </div>
        </div>

        @if (_showEditProfile)
        {
            <div class="card">
                <div class="card-header">
                    <div>
                        <h3>User Profile</h3>
                        <p class="text-muted">Update the user profile details.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label class="form-label">First Name</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Last Name</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field form-group-full">
                            <label class="form-label">Site</label>
                            <select class="form-select">
                                <option>Select a Site</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Position</label>
                            <select class="form-select">
                                <option>Select Position</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Persal</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Contract Number</label>
                            <input class="form-input" type="text" />
                            <span class="text-muted">(if No PersalNo is available)</span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">ID</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Passport Number</label>
                            <input class="form-input" type="text" />
                            <span class="text-muted">(if No SA ID is available)</span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Email</label>
                            <input class="form-input" type="email" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Tel</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Fax</label>
                            <input class="form-input" type="text" />
                            <span class="text-muted">(optional)</span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Cell</label>
                            <input class="form-input" type="text" />
                        </div>
                        <div class="form-field form-group-full">
                            <label class="form-label">Client Approver Name</label>
                            <select class="form-select">
                                <option>Select an Approver (after valid Site selection)</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Last Edited By</label>
                            <input class="form-input" type="text" value="@_displayName" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div>
                        <h3>Edit User Access Level</h3>
                        <p class="text-muted">Toggle access for the selected user.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-grid">
                        @foreach (var role in _accessRoles)
                        {
                            <label class="form-label form-checkbox">
                                <input type="checkbox" />
                                <span>@role</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="page-actions">
                <button class="btn btn-primary" type="button" @onclick="HandleSubmitUserChanges" disabled="@_editSubmitting">
                    @(_editSubmitting ? "Saving..." : "Submit Changes")
                </button>
                <button class="btn btn-secondary" type="button" @onclick="ResetEditChanges" disabled="@_editSubmitting">Reset Changes</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_editErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_editErrorMessage
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_editSuccessMessage))
            {
                <div class="alert alert-success">
                    @_editSuccessMessage
                </div>
            }
        }
    </div>
}
else if (_activeView == ViewResetLogin)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Select the User you want to Reset</h3>
                <p class="text-muted">Reset the password counter for a user account.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back</button>
        </div>
        <div class="card-body">
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input" type="text" placeholder="Start typing for a list of valid users"
                           @bind="_selectedUsername" />
                </div>
            </div>
            <div class="fis-mt-075">
                <button class="btn btn-primary" type="button" @onclick="HandleResetLogin" disabled="@_adminActionSubmitting">
                    @(_adminActionSubmitting ? "Submitting..." : "Reset Login")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_adminActionError))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_adminActionError
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_adminActionSuccess))
            {
                <div class="alert alert-success">
                    @_adminActionSuccess
                </div>
            }
        </div>
    </div>
}
else if (_activeView == ViewDeactivate)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Search for the User you want to De-Activate or Activate</h3>
                <p class="text-muted">Manage user activation status.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back</button>
        </div>
        <div class="card-body">
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="bx bx-search"></i>
                    <input class="search-input" type="text" placeholder="Start typing for a list of valid users"
                           @bind="_selectedUsername" />
                </div>
            </div>
            <div class="fis-mt-075 fis-flex-wrap-gap-05">
                <button class="btn btn-secondary" type="button" @onclick="HandleDeactivateUser" disabled="@_adminActionSubmitting">De-Activate User</button>
                <button class="btn btn-secondary" type="button" @onclick="HandleDeactivateExpiredPassword" disabled="@_adminActionSubmitting">De-ActivateUser Expired Password</button>
                <button class="btn btn-secondary" type="button" @onclick="HandleActivateUser" disabled="@_adminActionSubmitting">Activate User</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_adminActionError))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_adminActionError
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_adminActionSuccess))
            {
                <div class="alert alert-success">
                    @_adminActionSuccess
                </div>
            }
        </div>
    </div>
}
else if (_activeView == ViewViewUsers)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>View Users' Details</h3>
                <p class="text-muted">Browse users by alphabetical filter.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back to Menu</button>
        </div>
        <div class="card-body">
            <div class="legacy-letter-list fis-mb-075">
                @foreach (var letter in _alphabet)
                {
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="() => SetAlphabet(letter)">@letter</button>
                }
            </div>
                <span class="text-muted">View users by clicking on a character -- Selected character is @_selectedAlphabet</span>
            </div>
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@FilteredUserRows.Count() User(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th>Lastname</th>
                            <th>Firstname</th>
                            <th>User Name</th>
                            <th>Site Name</th>
                            <th>Position</th>
                            <th>Telephone</th>
                            <th>LastLoginDate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedUserRows)
                        {
                            <tr>
                                <td class="actions-column">
                                    <button class="btn-icon btn-icon-edit" type="button" @onclick="() => ShowEditForUser(row.UserName)" title="Edit User Details">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                </td>
                                <td class="actions-column">
                                    <button class="btn-icon btn-icon-delete" type="button" @onclick="() => ShowDeactivateForUser(row.UserName)" title="De-Activate User">
                                        <i class="bx bx-user-x"></i>
                                    </button>
                                </td>
                                <td class="actions-column">
                                    <button class="btn-icon btn-icon-view" type="button" @onclick="() => ShowResetLoginForUser(row.UserName)" title="Reset Login">
                                        <i class="bx bx-refresh"></i>
                                    </button>
                                </td>
                                <td class="actions-column">
                                    <button class="btn-icon btn-icon-view" type="button" @onclick="() => ShowForgotPasswordForUser(row.UserName)" title="Reset Password">
                                        <i class="bx bx-help-circle"></i>
                                    </button>
                                </td>
                                <td>@row.LastName</td>
                                <td>@row.FirstName</td>
                                <td>@row.UserName</td>
                                <td>@row.SiteName</td>
                                <td>@row.Position</td>
                                <td>@row.Telephone</td>
                                <td>@row.LastLoginDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls fis-mt-1">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" type="button" @onclick="HandleAddUser" disabled="@_addSubmitting">
                @(_addSubmitting ? "Saving..." : "Add a New User")
            </button>
        </div>
    </div>
}
else if (_activeView == ViewChangeV1)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Change Password</h3>
                <p class="text-muted">Reset password, security question, and answer for the new security methodology.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back to Menu</button>
        </div>
        <div class="card-body">
            <p class="text-muted">A new security methodology has been implemented, therefore you are required to reset your password, question and answer to accommodate the new security methodology.</p>
            <p class="text-muted">You have the option to change your password whenever you have the need but the password must be changed at least every month.</p>
            <div class="card fis-card-muted">
                <strong>Passwords have the following requirements:</strong>
                <ol class="fis-list-top-05-pad12">
                    <li>It should never be shared with anyone!</li>
                    <li>The length must be at least 8 characters</li>
                    <li>It must contain at least 1 number</li>
                    <li>It must contain at least 1 upper case letter</li>
                    <li>It must contain at least 1 lower case letter</li>
                    <li>It must contain at least 1 non alphanumeric character</li>
                    <li>It cannot be the same as the previous 3 passwords</li>
                </ol>
            </div>
            <p class="text-muted">NOTE : After three incorrect password entries your username will be disabled for 60 minutes, before you may try again.</p>
            <p class="text-muted">You can use the Password reset function on the login page, should you forget your password.</p>
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Username</label>
                    <input class="form-input" type="text" @bind="_changeUsername" />
                </div>
                <div class="form-field">
                    <label class="form-label">Old Password</label>
                    <input class="form-input" type="password" @bind="_changeOldPassword" />
                </div>
                <div class="form-field">
                    <label class="form-label">New Password</label>
                    <input class="form-input" type="password" @bind="_changeNewPassword" />
                </div>
                <div class="form-field">
                    <label class="form-label">Confirm New Password</label>
                    <input class="form-input" type="password" @bind="_changeConfirmPassword" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">New Password Question</label>
                    <select class="form-select" @bind="_changeSecurityQuestion">
                        <option>Select Question...</option>
                        <option>What was your childhood nickname?</option>
                        <option>What school did you attend for sixth grade?</option>
                        <option>What is your mother's maiden name?</option>
                        <option>In what city or town was your first job?</option>
                        <option>What is your spouse's mother's maiden name?</option>
                        <option>Who was your childhood hero?</option>
                        <option>What are the last 5 digits of your driver's license number?</option>
                        <option>What is your father's middle name?</option>
                        <option>What is the name of your favorite childhood friend?</option>
                        <option>What was the name of your first stuffed animal?</option>
                        <option>What colour was your first car?</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">New Password Answer</label>
                    <input class="form-input" type="text" @bind="_changeSecurityAnswer" />
                </div>
                <div class="form-field">
                    <label class="form-label">Email Address</label>
                    <input class="form-input" type="email" @bind="_changeEmail" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_changeErrorMessage))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_changeErrorMessage
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_changeSuccessMessage))
            {
                <div class="alert alert-success">
                    @_changeSuccessMessage
                </div>
            }
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" type="button" @onclick="HandleChangePasswordQuestion" disabled="@_changeSubmitting">
                @(_changeSubmitting ? "Updating..." : "Change Password")
            </button>
            <a class="btn btn-secondary" href="/login">Cancel</a>
        </div>
    </div>
}
else if (_activeView == ViewForcePassword)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Reset User Password</h3>
                <p class="text-muted">Force reset the password for a selected user.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back</button>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Username</label>
                    <select class="form-select" @bind="_forcePasswordUsername">
                        <option value="">Please select an Username to edit</option>
                        @foreach (var user in _userSummaries)
                        {
                            <option value="@user.UserName">@user.UserName</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">New Password</label>
                    <input class="form-input" type="password" @bind="_forcePasswordNew" />
                </div>
                <div class="form-field">
                    <label class="form-label">Confirm Password</label>
                    <input class="form-input" type="password" @bind="_forcePasswordConfirm" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_forcePasswordError))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_forcePasswordError
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_forcePasswordSuccess))
            {
                <div class="alert alert-success">
                    @_forcePasswordSuccess
                </div>
            }
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" type="button" @onclick="HandleForcePassword" disabled="@_forcePasswordSubmitting">
                @(_forcePasswordSubmitting ? "Resetting..." : "Reset Password")
            </button>
        </div>
    </div>
}
else if (_activeView == ViewForgotPassword)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3>Forgot Your Password?</h3>
                <p class="text-muted">Password recovery flow.</p>
            </div>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="() => GoTo(ViewMenu)">Back to Menu</button>
        </div>
        <div class="card-body">
            @if (_forgotStep == 1)
            {
                <p>Enter your username below.</p>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Username</label>
                        <input class="form-input" type="text" @bind="_selectedUsername" />
                        <span class="text-muted">Please contact your CallCenter and Check your login details.</span>
                    </div>
                </div>
                <div class="fis-mt-075">
                    <button class="btn btn-primary" type="button" @onclick="HandleForgotPasswordStart" disabled="@_forgotSubmitting">
                        @(_forgotSubmitting ? "Loading..." : "Next")
                    </button>
                </div>
            }
            else if (_forgotStep == 2)
            {
                <p>Identity Confirmation</p>
                <p>Provide the User`s answer to the question below.</p>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">User Name</label>
                        <input class="form-input" type="text" value="@_selectedUsername" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Question</label>
                        <input class="form-input" type="text" value="@_forgotQuestion" readonly />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Answer</label>
                        <input class="form-input" type="text" @bind="_forgotAnswer" />
                    </div>
                </div>
                <div class="fis-mt-075 fis-flex-gap-05">
                    <button class="btn btn-primary" type="button" @onclick="HandleForgotPasswordConfirm" disabled="@_forgotSubmitting">
                        @(_forgotSubmitting ? "Submitting..." : "Submit")
                    </button>
                    <button class="btn btn-secondary" type="button" @onclick="() => SetForgotStep(1)">Back</button>
                </div>
            }
            else
            {
                <p>New password generated.</p>
                @if (!string.IsNullOrWhiteSpace(_forgotMessage))
                {
                    <div class="alert alert-info">@_forgotMessage</div>
                }
                <div class="fis-flex-gap-05">
                    <button class="btn btn-secondary" type="button" @onclick="() => SetForgotStep(2)">Try Again</button>
                    <button class="btn btn-primary" type="button" @onclick="() => GoTo(ViewMenu)">Return to Main Menu</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_forgotError))
            {
                <div class="alert alert-error">
                    <i class="bx bx-error-circle"></i>
                    @_forgotError
                </div>
            }
        </div>
    </div>
}

