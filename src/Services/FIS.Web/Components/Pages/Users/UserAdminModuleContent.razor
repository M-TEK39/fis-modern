        catch (Exception ex)
        {
            _addErrorMessage = $"User creation failed: {ex.Message}";
        }
        finally
        {
            _addSubmitting = false;
        }
    }

    private void ClearAddUserFields()
    {
        _addUserName = string.Empty;
        _addEmail = string.Empty;
        _addErrorMessage = null;
        _addSuccessMessage = null;
    }

    private async Task HandleSubmitUserChanges()
    {
        _editErrorMessage = null;
        _editSuccessMessage = null;
        if (string.IsNullOrWhiteSpace(_selectedUsername))
        {
            _editErrorMessage = "Select a user before submitting changes.";
            return;
        }

        var user = _userSummaries.FirstOrDefault(u => string.Equals(u.UserName, _selectedUsername, StringComparison.OrdinalIgnoreCase));
        if (user is null)
        {
            _editErrorMessage = "Selected user was not found.";
            return;
