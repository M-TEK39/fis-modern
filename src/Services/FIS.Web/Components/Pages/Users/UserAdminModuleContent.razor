    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        var email = ResolveUsername(user);
        return string.IsNullOrWhiteSpace(email) ? "Authenticated User" : email;
    }

    private static string ResolveUsername(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;

        return string.IsNullOrWhiteSpace(email) ? "authenticated@local" : email;
    }

    private static string ResolveEmail(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value;

        return string.IsNullOrWhiteSpace(email) ? string.Empty : email;
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed record UserRow(string LastName, string FirstName, string UserName, string SiteName, string Position, string Telephone, string LastLoginDate);
