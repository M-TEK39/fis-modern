@page "/users/change-password-question"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Change Password & Question - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-key"></i>
            Change Password &amp; Question
        </h1>
        <p class="page-description">Reset password, security question, and answer.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminChangePasswordQuestionContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/ChangeV1PasswordToV2Password.aspx"
        Endpoint="api/auth/change-password-question"
        HttpMethod="POST"
        ButtonText="Test Change Password Question Endpoint"
        ReportType="useradmin-change-password-question" />

</div>
