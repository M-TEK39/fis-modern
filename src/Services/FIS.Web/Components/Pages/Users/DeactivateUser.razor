@page "/users/deactivate"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Components.Shared

<PageTitle>Activate or De-Activate User - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-x"></i>
            Activate / De-Activate User
        </h1>
        <p class="page-description">Manage user activation status and expired passwords.</p>
    </div>
</div>

<div class="page-content">
    <UserAdminDeactivateContent />

    <LegacyEndpointActionPanel
        LegacyPath="UserAdmin/DeActivateUser.aspx"
        Endpoint="api/user/1"
        HttpMethod="DELETE"
        ButtonText="Test Deactivate User Endpoint"
        ReportType="useradmin-deactivate" />

</div>
