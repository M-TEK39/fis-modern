@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@using FIS.Web.Models
@using System.Linq
@inject AuthApiService AuthApiService
@inject UserApiService UserApiService

<div class="card">
    <div class="card-header">
        <div>
            <h3>Reset User Password</h3>
            <p class="text-muted">Force reset the password for a selected user.</p>
        </div>
        <a class="btn btn-secondary btn-sm"
           href="@UserAdminNavigation.GetMenuLink(Navigation)"
           @onclick="NavigateToMenu"
           @onclick:preventDefault="true">Back</a>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div class="form-field">
                <label class="form-label">Username</label>
                <select class="form-select" @bind="_username">
                    <option value="">Please select an Username to edit</option>
                    @foreach (var user in _userSummaries)
                    {
                        <option value="@user.UserName">@user.UserName</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label class="form-label">New Password</label>
                <input class="form-input" type="password" @bind="_newPassword" />
            </div>
            <div class="form-field">
                <label class="form-label">Confirm Password</label>
                <input class="form-input" type="password" @bind="_confirmPassword" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error">
                <i class="bx bx-error-circle"></i>
                @_errorMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">
                @_successMessage
            </div>
        }
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" type="button" @onclick="HandleResetPassword" disabled="@_submitting">
            @(_submitting ? "Resetting..." : "Reset Password")
        </button>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
    private string _username = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _submitting;
    private List<UserSummaryDto> _userSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        _userSummaries = await UserApiService.GetAllSummariesAsync();
    }

    private void NavigateToMenu()
    {
        Navigation.NavigateTo(UserAdminNavigation.GetMenuLink(Navigation));
    }

    private async Task HandleResetPassword()
    {
        _errorMessage = null;
        _successMessage = null;
        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "The Confirm Password must match the New Password entry.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "Please select a username.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await AuthApiService.ForcePasswordAsync(new ForcePasswordRequest
            {
                Username = _username,
                NewPassword = _newPassword
            });

            _successMessage = response.Success ? (response.Message ?? "Password reset successfully.") : null;
            _errorMessage = response.Success ? null : (response.Message ?? "Password reset failed.");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Password reset failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
