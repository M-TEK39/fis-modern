@page "/troubleshoot/approver-ranks"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>Maintain Trip Approvers RANKS - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-voice"></i>
            Maintain trip approvers RANKS
        </h1>
        <p class="page-description">Maintain approver rank definitions used in trip workflows.</p>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading approver ranks...</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_ranks.Count rank(s)</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="AddRank">Add Rank</button>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Rank name</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rank in PagedRanks)
                        {
                            <tr>
                                <td>
                                    <input class="form-input" @bind="rank.RankName" />
                                </td>
                                <td>
                                    <input class="form-input" @bind="rank.Description" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveRanks">Save Ranks</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">
            <i class="bx bx-info-circle"></i>
            <span>@_statusMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string? _statusMessage;
    private string? _errorMessage;
    private List<ApproverRankDto> _ranks = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<ApproverRankDto> PagedRanks => _ranks.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_ranks.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadRanks();
    }

    private async Task LoadRanks()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _ranks = await TroubleshootService.GetApproverRanksAsync();
            _page = 1;
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load approver ranks.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddRank()
    {
        _ranks.Add(new ApproverRankDto());
        _page = TotalPages;
    }

    private async Task SaveRanks()
    {
        _statusMessage = null;
        _errorMessage = null;
        try
        {
            _ranks = await TroubleshootService.SaveApproverRanksAsync(_ranks);
            _statusMessage = "Approver ranks saved.";
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to save approver ranks.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
