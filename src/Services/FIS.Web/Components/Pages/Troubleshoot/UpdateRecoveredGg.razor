@page "/troubleshoot/update-recovered-gg"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>Update Recovered (stolen) GG - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-shield-alt-2"></i>
            Update Recovered(stolen) GG
        </h1>
        <p class="page-description">Recovered vehicle update workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Vehicle GG/Registration</label>
                    <input class="form-input" @bind="_request.VehicleIdentifier" />
                </div>
                <div class="form-field form-group-full">
                    <label class="form-label">Notes</label>
                    <textarea class="form-textarea" @bind="_request.Notes"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="UpdateRecovered">Submit</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">
            <i class="bx bx-info-circle"></i>
            <span>@_statusMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    private string? _statusMessage;
    private string? _errorMessage;
    private UpdateRecoveredGgRequest _request = new();

    private async Task UpdateRecovered()
    {
        if (string.IsNullOrWhiteSpace(_request.VehicleIdentifier))
        {
            _errorMessage = "Please enter a vehicle identifier.";
            return;
        }

        _statusMessage = null;
        _errorMessage = null;
        try
        {
            await TroubleshootService.UpdateRecoveredGgAsync(_request);
            _statusMessage = "Recovered GG update submitted.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to update recovered GG.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }
}
