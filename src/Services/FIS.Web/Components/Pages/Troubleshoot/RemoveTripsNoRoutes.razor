@page "/troubleshoot/remove-trips-no-routes"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>Remove Trips Without Routes - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-route"></i>
            Remove Trips that have No routes
        </h1>
        <p class="page-description">Legacy flow for Trips/RemoveTripWithoutRoutes.aspx.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">From</label>
                    <input type="date" class="form-input" @bind="_request.FromDate" />
                </div>
                <div class="form-field">
                    <label class="form-label">To</label>
                    <input type="date" class="form-input" @bind="_request.ToDate" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-danger" @onclick="RemoveTrips">Remove Trips</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">
            <i class="bx bx-info-circle"></i>
            <span>@_statusMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    private string? _statusMessage;
    private string? _errorMessage;
    private RemoveTripsRequest _request = new();

    private async Task RemoveTrips()
    {
        _statusMessage = null;
        _errorMessage = null;
        try
        {
            await TroubleshootService.RemoveTripsWithoutRoutesAsync(_request);
            _statusMessage = "Remove trips request submitted.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to submit remove trips request.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }
}
