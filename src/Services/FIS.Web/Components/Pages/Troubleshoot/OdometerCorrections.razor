@page "/troubleshoot/odometer-corrections"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>ODOMeter Corrections - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-tachometer"></i>
            ODOMeter Corrections
        </h1>
        <p class="page-description">Search and review vehicle odometer corrections.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field">
                    <label class="form-label">Search criteria</label>
                    <select class="form-select" @bind="_searchRequest.SearchMode">
                        <option value="GG">Vehicle GG Number</option>
                        <option value="REG">Vehicle Registration</option>
                        <option value="TA">Trip Authority No.</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="form-label">Value</label>
                    <input class="form-input" @bind="_searchRequest.SearchValue" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchOdometer">Submit Details</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Searching odometer corrections...</p>
        </div>
    }
    else if (_results.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-tachometer"></i>
            <h3>No results yet</h3>
            <p>Provide search criteria to locate odometer corrections.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_results.Count result(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Trip Authority</th>
                            <th>Current Odometer</th>
                            <th>Last Odometer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedResults)
                        {
                            <tr>
                                <td>@(row.VehicleIdentifier ?? "-")</td>
                                <td>@(row.TripAuthorityNumber ?? "-")</td>
                                <td>@(row.CurrentOdometer?.ToString() ?? "-")</td>
                                <td>@(row.LastOdometer?.ToString() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string? _errorMessage;
    private OdometerCorrectionSearchRequest _searchRequest = new();
    private List<OdometerCorrectionResultDto> _results = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<OdometerCorrectionResultDto> PagedResults => _results.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_results.Count / (double)_pageSize));

    private async Task SearchOdometer()
    {
        if (string.IsNullOrWhiteSpace(_searchRequest.SearchValue))
        {
            _errorMessage = "Please enter a GG/Registration number or Trip Authority number.";
            return;
        }

        _loading = true;
        _errorMessage = null;
        try
        {
            _results = await TroubleshootService.SearchOdometerCorrectionsAsync(_searchRequest);
            _page = 1;
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to search odometer corrections.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
