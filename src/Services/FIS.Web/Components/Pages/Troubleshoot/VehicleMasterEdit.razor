@page "/troubleshoot/vehicle-master-edit"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>Vehicle Master Edit - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-car"></i>
            Vehicle Master Edit
        </h1>
        <p class="page-description">Search vehicles and review vehicle master records for edit operations.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <div class="form-grid">
                <div class="form-field form-group-full">
                    <label class="form-label">Vehicle GG/Registration</label>
                    <input class="form-input" @bind="_request.VehicleIdentifier" />
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SearchVehicle">Load Vehicle</button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading vehicle details...</p>
        </div>
    }
    else if (_vehicles.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-car"></i>
            <h3>No vehicle loaded</h3>
            <p>Enter a vehicle identifier to load details.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_vehicles.Count vehicle(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle (GG / GP / VMF)</th>
                            <th>Registration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in PagedVehicles)
                        {
                            <tr>
                                <td>@GetVehicleLabel(vehicle)</td>
                                <td>@ValueOrDash(vehicle.registration_number)</td>
                                <td>@vehicle.status_description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-controls" style="margin-top: 1rem;">
                <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                <div class="pagination-info">Page @_page of @TotalPages</div>
                <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string? _errorMessage;
    private VehicleMasterEditRequest _request = new();
    private List<VehicleDto> _vehicles = new();
    private int _page = 1;
    private const int _pageSize = 12;

    private IEnumerable<VehicleDto> PagedVehicles => _vehicles.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_vehicles.Count / (double)_pageSize));

    private async Task SearchVehicle()
    {
        if (string.IsNullOrWhiteSpace(_request.VehicleIdentifier))
        {
            _errorMessage = "Please enter a vehicle identifier.";
            return;
        }

        _loading = true;
        _errorMessage = null;
        try
        {
            _vehicles = await TroubleshootService.GetVehicleMasterEditAsync(_request);
            _page = 1;
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load vehicle details.";
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
