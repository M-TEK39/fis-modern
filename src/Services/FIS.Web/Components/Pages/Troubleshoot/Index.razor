@page "/troubleshoot"
@rendermode InteractiveServer

<PageTitle>Troubleshoot Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Troubleshoot Maintenance Menu
        </h1>
        <p class="page-description">Legacy troubleshoot maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Troubleshoot Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/help">Troubleshoot Maintenance Information / Help</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Troubleshoot Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/log">1) Troubleshoot Log</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/reports">2) Troubleshoot General Reports</a>
                    <span class="menu-item-badge">Legacy</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/vehicle-master-edit">3) Vehicle Master Edit</a>
