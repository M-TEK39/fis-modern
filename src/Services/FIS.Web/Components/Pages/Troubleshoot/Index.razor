@page "/troubleshoot"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject TroubleshootApiService TroubleshootService
@inject IJSRuntime JSRuntime

<PageTitle>Troubleshoot Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Troubleshoot Maintenance Menu
        </h1>
        <p class="page-description">Troubleshoot maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Troubleshoot Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/help">Troubleshoot Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Troubleshoot Menu</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/log">1) Troubleshoot Log</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/reports">2) Troubleshoot General Reports</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/vehicle-master-edit">3) Vehicle Master Edit</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/update-recovered-gg">4) Update Recovered(stolen) GG</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/odometer-corrections">5) ODOMeter Corrections</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/remove-trips-no-routes">6) Remove Trips that have No routes</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/troubleshoot/approver-ranks">7) Maintain trip approvers RANKS</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Troubleshoot User Preview"
                      SearchPlaceholder="Search user, site, access code..."
                      EmptyMessage="No troubleshoot users match the current search or filter."
                      EmptyIcon="bx bx-wrench"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("code", "Access Code"),
        new("name", "User"),
        new("site", "Site"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Site-linked users", "siteStatus", "Site Linked"),
        new("Users without site", "siteStatus", "No Site"),
        new("Named users", "nameStatus", "Name Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var users = await TroubleshootService.GetUsersAsync();
            _rows = users
                .OrderBy(item => item.Name)
                .Select(item => new Dictionary<string, string?>
                {
                    ["code"] = item.UserAccessCode.ToString(),
                    ["name"] = item.Name,
                    ["site"] = item.SiteDescription,
                    ["status"] = string.IsNullOrWhiteSpace(item.SiteDescription) ? "No Site" : "Site Linked",
                    ["siteStatus"] = string.IsNullOrWhiteSpace(item.SiteDescription) ? "No Site" : "Site Linked",
                    ["nameStatus"] = string.IsNullOrWhiteSpace(item.Name) ? "No Name" : "Name Captured",
                    ["_href"] = $"/troubleshoot/log?userAccessCode={item.UserAccessCode}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading troubleshoot preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
