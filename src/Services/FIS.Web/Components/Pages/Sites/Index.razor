@page "/sites"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject SiteApiService SiteService

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-map-pin"></i>
            Site Management
        </h1>
        <p class="page-description">Manage operational sites and locations</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <i class="bx bx-plus plus-icon"></i>
            Add Site
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading sites...</p>
        </div>
    }
    else if (_sites.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-map-pin"></i>
            <h3>No sites found</h3>
            <p>Get started by adding your first operational site</p>
            <button class="btn btn-primary" @onclick="ShowAddDialog">
                <i class="bx bx-plus plus-icon"></i>
                Add Site
            </button>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <div class="table-controls">
                    <button class="btn btn-primary" @onclick="ShowAddDialog">
                        <i class="bx bx-plus plus-icon"></i>
                        Add Site
                    </button>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Site Code</th>
                            <th>Site Name</th>
                            <th>Address</th>
                            <th>Contact Info</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var site in _sites)
                        {
                            <tr>
                                <td>@site.SiteCode</td>
                                <td>@site.Description</td>
                                <td>@site.Address</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(site.Telephone))
                                    {
                                        <span>📞 @site.Telephone</span>
                                    }
                                </td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => ShowEditDialog(site)" title="Edit">
                                            <i class="bx bx-edit"></i>
                                            <span>Edit</span>
                                        </button>
                                        <button class="btn-icon btn-icon-delete" @onclick="() => ShowDeleteDialog(site)" title="Delete">
                                            <i class="bx bx-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<Modal IsVisible="_showDialog"
       Title="@(_isEdit ? "Edit Site" : "Add Site")"
       OnCancel="HideDialog"
       OnSubmit="SaveSite"
       Model="_currentSite"
       IsSaving="_saving">
    <div class="form-grid">
        <div class="form-field">
            <label class="form-label">Site Description <span class="required">*</span></label>
            <input type="text" @bind="_currentSite.Description" class="form-input" placeholder="Enter site name/description" />
            <ValidationMessage For="() => _currentSite.Description" />
        </div>
        <div class="form-field">
            <label class="form-label">Site Address</label>
            <textarea @bind="_currentSite.Address" class="form-input" rows="3" placeholder="Enter complete address"></textarea>
        </div>
        <div class="form-field">
            <label class="form-label">Telephone Number</label>
            <input type="tel" @bind="_currentSite.Telephone" class="form-input" placeholder="Enter contact number" />
        </div>
    </div>
</Modal>

<ConfirmationModal IsVisible="_showDeleteConfirm"
                  Title="Confirm Delete"
                  OnCancel="HideDeleteDialog"
                  OnConfirm="DeleteSite"
                  IsDeleting="false">
    <p>Are you sure you want to delete <strong>@_currentSite.Description</strong>?</p>
    <p class="warning-text">This action cannot be undone.</p>
</ConfirmationModal>

@code {
    private List<SiteViewModel> _sites = new();
    private SiteViewModel _currentSite = new();
    private bool _loading = true;
    private bool _showDialog = false;
    private bool _showDeleteConfirm = false;
    private bool _isEdit = false;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSites();
    }

    private async Task LoadSites()
    {
        _loading = true;
        try
        {
            var sites = await SiteService.GetAllAsync();
            _sites = sites.Select(s => new SiteViewModel
            {
                SiteCode = s.SiteCode,
                DepartmentCode = s.DepartmentCode,
                Description = s.Description,
                Address = CombineAddress(s),
                Telephone = s.Telephone,
                IsActive = s.SiteActive
            }).ToList();
        }
        catch
        {
            _sites = new List<SiteViewModel>();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowAddDialog()
    {
        _currentSite = new SiteViewModel();
        _isEdit = false;
        _showDialog = true;
    }

    private void ShowEditDialog(SiteViewModel site)
    {
        _currentSite = new SiteViewModel
        {
            SiteCode = site.SiteCode,
            DepartmentCode = site.DepartmentCode,
            Description = site.Description,
            Address = site.Address,
            Telephone = site.Telephone,
            IsActive = site.IsActive
        };
        _isEdit = true;
        _showDialog = true;
    }

    private void ShowDeleteDialog(SiteViewModel site)
    {
        _currentSite = site;
        _showDeleteConfirm = true;
    }

    private void HideDialog()
    {
        _showDialog = false;
        _currentSite = new();
    }

    private void HideDeleteDialog()
    {
        _showDeleteConfirm = false;
    }

    private async Task SaveSite()
    {
        _saving = true;
        try
        {
            var request = new SiteRequestDto
            {
                Description = _currentSite.Description ?? string.Empty,
                Address1 = _currentSite.Address,
                Telephone = _currentSite.Telephone,
                DepartmentCode = _currentSite.DepartmentCode,
                SiteActive = _currentSite.IsActive
            };

            if (_isEdit && _currentSite.SiteCode.HasValue)
            {
                await SiteService.UpdateAsync((short)_currentSite.SiteCode.Value, request);
            }
            else
            {
                await SiteService.CreateAsync(request);
            }

            await LoadSites();
            HideDialog();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteSite()
    {
        try
        {
            if (_currentSite.SiteCode.HasValue)
            {
                await SiteService.DeleteAsync((short)_currentSite.SiteCode.Value);
            }
        }
        finally
        {
            HideDeleteDialog();
            await LoadSites();
        }
    }

    private static string? CombineAddress(SiteResponseDto dto)
    {
        var parts = new[] { dto.Address1, dto.Address2, dto.Address3 }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var combined = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(combined) ? null : combined;
    }

    private class SiteViewModel
    {
        public int? SiteCode { get; set; }
        public short? DepartmentCode { get; set; }
        [Required]
        public string? Description { get; set; }
        public string? Address { get; set; }
        public string? Telephone { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
