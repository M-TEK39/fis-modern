@page "/taxis/reports/{Mode}"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject TaxiApiService TaxiService
@inject IJSRuntime JS

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-file"></i>
            @_pageTitle
        </h1>
        <p class="page-description">@_pageDescription</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    @if (_isOneTaxiNumber)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>One Taxi Report</h2>
                <p>Enter the registration number of the taxi you wish to see.</p>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <div class="contract-search-radio">
                            <label class="form-radio-label">
                                <input type="radio" name="TaxiNumberType" checked="@(_oneTaxiLookupType == "GP")" @onchange='() => SetLookupType("GP")' />
                                GP
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="TaxiNumberType" checked="@(_oneTaxiLookupType == "GG")" @onchange='() => SetLookupType("GG")' />
                                GG
                            </label>
                            <label class="form-radio-label">
                                <input type="radio" name="TaxiNumberType" checked="@(_oneTaxiLookupType == "PRIVATE")" @onchange='() => SetLookupType("PRIVATE")' />
                                Private Number
                            </label>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Registration Number</label>
                        <input class="form-input fis-text-upper" maxlength="20" @bind="_oneTaxiSearch" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SearchOneTaxiAsync">Submit</button>
                    <a class="btn btn-secondary" href="/taxis">Menu</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @(_error ? "alert-error" : "alert-success") fis-mt-075">@_message</div>
                }
                <div class="table-container fis-mt-1">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Requisition</th>
                                    <th>Date</th>
                                    <th>Official</th>
                                    <th>Reg / GG</th>
                                    <th>Contractor</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_oneTaxiResults.Count == 0)
                                {
                                    <tr><td colspan="6">No records found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _oneTaxiResults)
                                    {
                                        <tr>
                                            <td>@ValueOrDash(row.rek_num)</td>
                                            <td>@FormatDate(row.date_required)</td>
                                            <td>@ValueOrDash(row.official)</td>
                                            <td>@ValueOrDash(row.vmf_code)</td>
                                            <td>@ValueOrDash(row.contractor_id?.ToString())</td>
                                            <td>@ValueOrDash(row.department_code?.ToString())</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_isLogsPerUser)
    {
        <div class="form-card fis-mb-15">
            <div class="form-card-header">
                <h2>Report: Taxi Requisitions/Logs Captured</h2>
                <p>Select a date range and user.</p>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">From</label>
                        <input class="form-input" placeholder="YYYY-MM-DD" @bind="_fromDateText" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">To</label>
                        <input class="form-input" placeholder="YYYY-MM-DD" @bind="_toDateText" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">User</label>
                        <select class="form-select" @bind="_selectedUserFilter">
                            <option value="">All users</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user">@user</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="ApplyLogsPerUserFilterAsync">Submit</button>
                    <button class="btn btn-secondary" @onclick="PrintAsync">Print</button>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <h2>Results</h2>
                <p>Report Date: @DateTime.Now</p>
            </div>
            <div class="form-card-body">
                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="bx bx-clipboard"></i>
                        Taxi Requisitions Captured
                    </h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Number</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_userCounts.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="2">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _userCounts)
                                        {
                                            <tr>
                                                <td>@row.Key</td>
                                                <td>@row.Value</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Total</th>
                                        <th>@_userCounts.Values.Sum()</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="bx bx-clipboard-check"></i>
                        Taxi Logs Captured
                    </h3>
                    <div class="table-container">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Number</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_userCounts.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="2">No records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in _userCounts)
                                        {
                                            <tr>
                                                <td>@row.Key</td>
                                                <td>@row.Value</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Total</th>
                                        <th>@_userCounts.Values.Sum()</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_isOldRequisitions)
    {
        <div class="form-card fis-mb-15">
            <div class="form-card-header">
                <h2>Old Requisitions For Period</h2>
                <p>Select a period to view older taxi requisitions.</p>
            </div>
                <div class="form-card-body">
                    <div class="alert alert-info">
                    Historical requisition records will populate once period filters are submitted.
                </div>
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">From</label>
                        <input class="form-input" placeholder="YYYY-MM-DD" @bind="_fromDateText" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">To</label>
                        <input class="form-input" placeholder="YYYY-MM-DD" @bind="_toDateText" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="ApplyOldRequisitionsFilterAsync">Submit</button>
                    <button class="btn btn-secondary" @onclick="PrintAsync">Print</button>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-body">
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Requisition</th>
                                    <th>Date</th>
                                    <th>Official</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_oldRequisitionRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in _oldRequisitionRows)
                                    {
                                        <tr>
                                            <td>@ValueOrDash(row.rek_num)</td>
                                            <td>@FormatDate(row.date_required)</td>
                                            <td>@ValueOrDash(row.official)</td>
                                            <td>@ValueOrDash(row.address_1)</td>
                                            <td>@ValueOrDash(row.address_2)</td>
                                            <td>@ValueOrDash(row.department_code?.ToString())</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_isTaxisPerCompany)
    {
        <div class="form-card fis-mb-15">
            <div class="form-card-header">
                <h2>Taxis Per Hire Company</h2>
                <p>Select a hire company from the drop down list below.</p>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Company</label>
                        <select class="form-select" @bind="_selectedContractorFilter">
                            <option value="">Select...</option>
                            @foreach (var contractor in ContractorOptions)
                            {
                                <option value="@contractor">@contractor</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="ApplyCompanyFilterAsync">Submit</button>
                    <a class="btn btn-secondary" href="/taxis">Menu</a>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-body">
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Reg Number</th>
                                    <th>Contractor Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_companyRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in _companyRows.Select((item, index) => new { item, index }))
                                    {
                                        <tr>
                                            <td>@(row.index + 1)</td>
                                            <td>@ValueOrDash(row.item.vmf_code)</td>
                                            <td>@ValueOrDash(row.item.contractor_id?.ToString())</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-actions">
                    <a class="btn btn-secondary" href="/taxis/reports/taxis-per-company">Back</a>
                    <a class="btn btn-secondary" href="/taxis">Menu</a>
                </div>
            </div>
        </div>
    }
    else if (_isTaxisPerDepartment)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Report On All Taxis In Various Departments</h2>
                <p>Date Of Report: @DateTime.Now</p>
            </div>
            <div class="form-card-body">
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Requisition Number</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_departmentRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in _departmentRows.Select((item, index) => new { item, index }))
                                    {
                                        <tr>
                                            <td>@(row.index + 1)</td>
                                            <td>@ValueOrDash(row.item.rek_num)</td>
                                            <td>@ValueOrDash(row.item.department_code?.ToString())</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-hint fis-mt-1">Page End</div>
                <div class="form-actions">
                    <a class="btn btn-secondary" href="#page-top">Page Top</a>
                </div>
                <a id="page-top"></a>
            </div>
        </div>
    }
    else if (_isTaxisInServicePerDepartment)
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Report On All Taxis In Service In Various Departments</h2>
                <p>Date Of Report: @DateTime.Now</p>
            </div>
            <div class="form-card-body">
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Requisition Number</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_inServiceDepartmentRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in _inServiceDepartmentRows.Select((item, index) => new { item, index }))
                                    {
                                        <tr>
                                            <td>@(row.index + 1)</td>
                                            <td>@ValueOrDash(row.item.rek_num)</td>
                                            <td>@ValueOrDash(row.item.department_code?.ToString())</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="form-hint fis-mt-1">Page End</div>
                <div class="form-actions">
                    <a class="btn btn-secondary" href="#page-top">Page Top</a>
                </div>
                <a id="page-top"></a>
            </div>
        </div>
    }
    else if (_isLogsRequisitionsStatus)
    {
        <div class="form-card fis-mb-15">
            <div class="form-card-header">
                <h2>Taxi Logs and Requisitions Statuses Reports Menu</h2>
                <p>Select a report type, then choose date range or financial year.</p>
            </div>
            <div class="form-card-body">
                <div class="menu-tiles">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-requisitions-status?type=all">1) All Taxi Logs and Requisitions Statuses Report.</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-requisitions-status?type=outstanding">2) Outstanding Taxi Logs vs Captured Requisitions.</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-requisitions-status?type=cancelled">3) Cancelled Requisitions.</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-requisitions-status?type=invoiced">4) Requisitions Captured With Logs Closed Off.</a>
                    </div>
                </div>
                <div class="form-actions">
                    <a class="btn btn-secondary" href="/taxis">Return to Main Report Page</a>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <h2>@_statusReportTitle</h2>
                <p>Select Type of Search</p>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label form-checkbox">
                            <input type="radio" name="statusRange" checked />
                            Date Range
                        </label>
                        <div class="form-grid fis-mt-075">
                            <div class="form-field">
                                <label class="form-label">Start Date</label>
                                <input class="form-input" @bind="_statusStartDateText" placeholder="YYYY-MM-DD" />
                            </div>
                            <div class="form-field">
                                <label class="form-label">End Date</label>
                                <input class="form-input" @bind="_statusEndDateText" placeholder="YYYY-MM-DD" />
                            </div>
                        </div>
                    </div>
                    <div class="form-field">
                        <label class="form-label form-checkbox">
                            <input type="radio" name="statusRange" />
                            Financial Year
                        </label>
                        <select class="form-select fis-mt-075">
                            <option value="">Select financial year</option>
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-secondary">Back</button>
                    <button class="btn btn-primary" @onclick="ApplyStatusFilterAsync">Submit</button>
                </div>
                <div class="table-container fis-mt-1">
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Requisition</th>
                                    <th>Date</th>
                                    <th>Official</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_statusRows.Count == 0)
                                {
                                    <tr><td colspan="4">No records found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _statusRows)
                                    {
                                        <tr>
                                            <td>@ValueOrDash(row.rek_num)</td>
                                            <td>@FormatDate(row.date_required)</td>
                                            <td>@ValueOrDash(row.official)</td>
                                            <td>@ValueOrDash(GetDerivedStatus(row))</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Taxi Reports";
    private string _pageDescription = "Taxi reports.";
    private string _statusReportTitle = "Report";
    private bool _isOneTaxiNumber;
    private bool _isLogsPerUser;
    private bool _isOldRequisitions;
    private bool _isTaxisPerCompany;
    private bool _isTaxisPerDepartment;
    private bool _isTaxisInServicePerDepartment;
    private bool _isLogsRequisitionsStatus;
    private string _message = string.Empty;
    private bool _error;
    private List<TaxiRequestDto> _requests = new();
    private List<TaxiRequestDto> _oneTaxiResults = new();
    private Dictionary<string, int> _userCounts = new(StringComparer.OrdinalIgnoreCase);
    private List<TaxiRequestDto> _oldRequisitionRows = new();
    private List<TaxiRequestDto> _companyRows = new();
    private List<TaxiRequestDto> _departmentRows = new();
    private List<TaxiRequestDto> _inServiceDepartmentRows = new();
    private List<TaxiRequestDto> _statusRows = new();
    private string _oneTaxiSearch = string.Empty;
    private string _oneTaxiLookupType = "GG";
    private string _fromDateText = string.Empty;
    private string _toDateText = string.Empty;
    private string _statusStartDateText = string.Empty;
    private string _statusEndDateText = string.Empty;
    private string _selectedUserFilter = string.Empty;
    private string _selectedContractorFilter = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _isOneTaxiNumber = Mode == "one-taxi-number";
        _isLogsPerUser = Mode == "logs-per-user";
        _isOldRequisitions = Mode == "old-requisitions";
        _isTaxisPerCompany = Mode == "taxis-per-company";
        _isTaxisPerDepartment = Mode == "taxis-per-department";
        _isTaxisInServicePerDepartment = Mode == "taxis-inservice-per-department";
        _isLogsRequisitionsStatus = Mode == "logs-requisitions-status";

        _pageTitle = Mode switch
        {
            "one-taxi-number" => "Report On One Taxi Number",
            "logs-per-user" => "Number Of Taxi Logs Captured Per User For Date",
            "old-requisitions" => "Old Requisitions For Period",
            "taxis-per-company" => "Taxis Per Hire Company",
            "taxis-per-department" => "List Of All Taxis In Various Departments",
            "taxis-inservice-per-department" => "List Of All Taxis In Service In Various Departments",
            "logs-requisitions-status" => "Taxi Logs and Requisitions Statuses Reports",
            _ => "Taxi Reports"
        };

        _pageDescription = Mode switch
        {
            "one-taxi-number" => "Search by taxi registration number.",
            "logs-per-user" => "Taxi requisitions and logs captured by user.",
            "old-requisitions" => "Requisitions report for a period.",
            "taxis-per-company" => "Report taxis per hire company.",
            "taxis-per-department" => "Report taxis by department.",
            "taxis-inservice-per-department" => "Report taxis in service by department.",
            "logs-requisitions-status" => "Status reports for taxi logs and requisitions.",
            _ => "Taxi reports."
        };

        _statusReportTitle = GetStatusReportTitle();

        await LoadRequestsAsync();
        ApplyInitialModeData();
    }

    private string GetStatusReportTitle()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("type", out var typeValue))
        {
            return typeValue.ToString() switch
            {
                "all" => "All Taxi Logs and Requisitions Statuses Report",
                "outstanding" => "Outstanding Taxi Logs vs Captured Requisitions",
                "cancelled" => "Cancelled Requisitions",
                "invoiced" => "Requisitions Captured With Logs Closed Off",
                _ => "Report"
            };
        }

        return "Report";
    }

    private async Task LoadRequestsAsync()
    {
        try
        {
            _requests = await TaxiService.GetAllAsync<TaxiRequestDto>();
            _error = false;
            _message = string.Empty;
        }
        catch (Exception ex)
        {
            _requests = new();
            _error = true;
            _message = $"Failed to load taxi report data: {ex.Message}";
        }
    }

    private void ApplyInitialModeData()
    {
        if (_isTaxisPerDepartment)
        {
            _departmentRows = _requests.Where(r => r.department_code is > 0).OrderBy(r => r.department_code).ThenByDescending(r => r.date_required).Take(300).ToList();
        }

        if (_isTaxisInServicePerDepartment)
        {
            _inServiceDepartmentRows = _requests.Where(r => r.department_code is > 0).OrderBy(r => r.department_code).ThenByDescending(r => r.date_required).Take(300).ToList();
        }
    }

    private async Task SearchOneTaxiAsync()
    {
        await Task.CompletedTask;

        var key = (_oneTaxiSearch ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(key))
        {
            _oneTaxiResults = new();
            _error = true;
            _message = "Enter a registration / GG / private number.";
            return;
        }

        _oneTaxiResults = _requests.Where(r => MatchTaxiNumber(r, key)).OrderByDescending(r => r.date_required).Take(200).ToList();
        _error = false;
        _message = _oneTaxiResults.Count == 0
            ? $"No taxi records found for {key.ToUpperInvariant()}."
            : $"{_oneTaxiResults.Count} record(s) found.";
    }

    private bool MatchTaxiNumber(TaxiRequestDto request, string value)
    {
        var comp = StringComparison.OrdinalIgnoreCase;
        var trimmed = value.Trim();

        return _oneTaxiLookupType switch
        {
            "GP" => (request.vmf_code ?? string.Empty).Contains(trimmed, comp) && (request.vmf_code ?? string.Empty).Contains("GP", comp),
            "GG" => (request.vmf_code ?? string.Empty).Contains(trimmed, comp) && (request.vmf_code ?? string.Empty).Contains("GG", comp),
            "PRIVATE" => (request.vmf_code ?? string.Empty).Contains(trimmed, comp),
            _ => (request.vmf_code ?? string.Empty).Contains(trimmed, comp)
        };
    }

    private void SetLookupType(string lookupType)
        => _oneTaxiLookupType = lookupType;

    private Task ApplyLogsPerUserFilterAsync()
    {
        var from = ParseDate(_fromDateText);
        var to = ParseDate(_toDateText);

        var filtered = _requests.Where(r => IsInDateRange(r.date_required, from, to));
        if (!string.IsNullOrWhiteSpace(_selectedUserFilter))
        {
            filtered = filtered.Where(r => string.Equals((r.official ?? string.Empty).Trim(), _selectedUserFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        _userCounts = filtered
            .GroupBy(r => ValueOrDash(r.official))
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);

        return Task.CompletedTask;
    }

    private Task ApplyOldRequisitionsFilterAsync()
    {
        var from = ParseDate(_fromDateText);
        var to = ParseDate(_toDateText);
        _oldRequisitionRows = _requests
            .Where(r => IsInDateRange(r.date_required, from, to))
            .OrderByDescending(r => r.date_required)
            .Take(500)
            .ToList();

        return Task.CompletedTask;
    }

    private Task ApplyCompanyFilterAsync()
    {
        if (short.TryParse(_selectedContractorFilter, out var contractorId))
        {
            _companyRows = _requests
                .Where(r => r.contractor_id == contractorId)
                .OrderByDescending(r => r.date_required)
                .Take(500)
                .ToList();
        }
        else
        {
            _companyRows = new();
        }

        return Task.CompletedTask;
    }

    private Task ApplyStatusFilterAsync()
    {
        var from = ParseDate(_statusStartDateText);
        var to = ParseDate(_statusEndDateText);

        var statusType = GetStatusType();
        _statusRows = _requests
            .Where(r => IsInDateRange(r.date_required, from, to))
            .Where(r => statusType == "all" || string.Equals(GetDerivedStatus(r), statusType, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.date_required)
            .Take(500)
            .ToList();

        return Task.CompletedTask;
    }

    private string GetStatusType()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("type", out var typeValue))
        {
            return typeValue.ToString().Trim().ToLowerInvariant();
        }

        return "all";
    }

    private static string GetDerivedStatus(TaxiRequestDto request)
    {
        if (string.IsNullOrWhiteSpace(request.rek_num))
        {
            return "outstanding";
        }

        return "all";
    }

    private Task PrintAsync()
        => JS.InvokeVoidAsync("window.print").AsTask();

    private static bool IsInDateRange(DateTime? value, DateTime? from, DateTime? to)
    {
        if (!value.HasValue)
        {
            return false;
        }

        var date = value.Value.Date;
        if (from.HasValue && date < from.Value.Date)
        {
            return false;
        }

        if (to.HasValue && date > to.Value.Date)
        {
            return false;
        }

        return true;
    }

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed.Date : null;

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private IEnumerable<string> UserOptions =>
        _requests.Select(r => (r.official ?? string.Empty).Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v);

    private IEnumerable<short> ContractorOptions =>
        _requests.Where(r => r.contractor_id is > 0)
            .Select(r => r.contractor_id!.Value)
            .Distinct()
            .OrderBy(v => v);

    private sealed class TaxiRequestDto
    {
        public int request_id { get; set; }
        public string? rek_num { get; set; }
        public short? contractor_id { get; set; }
        public string? vmf_code { get; set; }
        public short? department_code { get; set; }
        public DateTime? date_required { get; set; }
        public string? official { get; set; }
        public string? address_1 { get; set; }
        public string? address_2 { get; set; }
    }

}
