@page "/taxis/scan-requisition"
@rendermode InteractiveServer
<PageTitle>Scan Taxi Requisition - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-scan"></i>
            Scan Taxi Requisition
        </h1>
        <p class="page-description">Taxi requisition scanning.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Use this screen for taxi requisition document scanning.</p>
        </div>
    </div>
</div>
