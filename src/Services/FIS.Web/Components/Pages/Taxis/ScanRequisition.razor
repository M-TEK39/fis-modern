@page "/taxis/scan-requisition"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Scan Taxi Requisition - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-scan"></i>
            Scan Taxi Requisition
        </h1>
        <p class="page-description">Legacy taxi requisition scanning.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Scan requisition workflow to be aligned with legacy screen.</p>
            <LegacyEndpointActionPanel
                LegacyPath="Taxi_Scan_Docs/RekCert_Menu.aspx"
                Endpoint="api/taxi/scan-requisition"
                HttpMethod="POST"
                ButtonText="Run Scan Requisition API"
                ReportType="taxis-scan-requisition" />
        </div>
    </div>
</div>
