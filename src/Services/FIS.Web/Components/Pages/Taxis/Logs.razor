@page "/taxis/logs/{Mode}"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            @_pageTitle
        </h1>
        <p class="page-description">Legacy taxi log workflow.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">This screen will be aligned to the legacy taxi logsheet workflow.</p>
            <LegacyEndpointActionPanel
                LegacyPath="@GetLegacyPath()"
                Endpoint="@GetEndpoint()"
                HttpMethod="@GetHttpMethod()"
                ButtonText="Run Taxi Logs API"
                ReportType="taxis-logs" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Taxi Logs";

    protected override void OnParametersSet()
    {
        _pageTitle = Mode switch
        {
            "enter" => "Enter Taxi Logsheet",
            "edit" => "Edit Taxi Logsheet",
            "reprint" => "Reprint Taxi Log",
            "white-log" => "Enter Taxi White Log (GG vehicles not for claiming)",
            _ => "Taxi Logs"
        };
    }

    private string GetLegacyPath()
        => Mode switch
        {
            "enter" => "Taxis/Taxi_log_1.aspx",
            "edit" => "Taxis/Taxi_log_Edit_1.aspx",
            "reprint" => "Taxis/Reprint_Taxi_Log_1.aspx",
            "white-log" => "Taxis/white_log.aspx",
            _ => "Taxis/Taxi_menu.aspx"
        };

    private string GetEndpoint()
        => Mode switch
        {
            "enter" => "api/taxilogs",
            "edit" => "api/taxilogs/1",
            "reprint" => "api/taxilogs/print/1",
            "white-log" => "api/taxilogs/white-log",
            _ => "api/taxilogs"
        };

    private string GetHttpMethod()
        => Mode switch
        {
            "enter" => "POST",
            "edit" => "PUT",
            "white-log" => "POST",
            _ => "GET"
        };
}
