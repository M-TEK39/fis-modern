@page "/taxis/logs/{Mode}"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net.Http.Json
@using FIS.Web.Models
@using FIS.Web.Services
@inject TaxiLogApiService TaxiLogService
@inject VehicleApiService VehicleService
@inject HttpClient Http
@inject TokenService TokenService
@inject IJSRuntime JS

<PageTitle>@_pageTitle - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            @_pageTitle
        </h1>
        <p class="page-description">@_pageDescription</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading taxi log references...</p>
        </div>
    }
    else if (_isWhiteLogMode)
    {
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">GG Number</label>
                        <input class="form-input fis-uppercase" maxlength="8" @bind="_whiteLog.GgNumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver</label>
                        <input class="form-input" maxlength="30" @bind="_whiteLog.Driver" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Odometer</label>
                        <input class="form-input" type="number" min="0" @bind="_whiteLog.StartOdo" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Start Date</label>
                        <input class="form-input" type="date" @bind="_whiteLog.StartDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Odometer</label>
                        <input class="form-input" type="number" min="0" @bind="_whiteLog.EndOdo" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">End Date</label>
                        <input class="form-input" type="date" @bind="_whiteLog.EndDate" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SaveWhiteLogAsync" disabled="@_savingWhiteLog">Submit</button>
                    <button class="btn btn-secondary" @onclick="ResetWhiteLog" disabled="@_savingWhiteLog">Reset</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @(_error ? "alert-error" : "alert-success") fis-mt-075">@_message</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="form-card fis-mb-15">
            <div class="form-card-header">
                <h2>@(_isEditMode ? "Edit Taxi Log" : "Enter Taxi Log")</h2>
                <p>Enter the requisition number to continue.</p>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Requisition Number</label>
                        <input class="form-input fis-uppercase" maxlength="8" placeholder="Enter requisition number" @bind="_lookupRekNumber" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="LookupAsync" disabled="@_lookupLoading">Submit</button>
                    @if (_lookup != null)
                    {
                        <button class="btn btn-secondary" @onclick="ResetLogsheetForm">Reset</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @(_error ? "alert-error" : "alert-success") fis-mt-075">@_message</div>
                }
            </div>
        </div>

        @if (_lookup != null)
        {
            <div class="form-card">
                <div class="form-card-header">
                    <h2>@(_isEditMode ? "Edit Taxi Logsheet" : _isReprintMode ? "Reprint Taxi Logsheet" : "Enter Taxi Logsheet")</h2>
                    <p>Legacy taxi odometer capture for requisition <strong>@_lookup.RekNum</strong>.</p>
                </div>
                <div class="form-card-body">
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="bx bx-info-circle"></i>
                            Requisition Summary
                        </h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <tbody>
                                        <tr><th>Requisition Number</th><td>@ValueOrDash(_lookup.RekNum)</td></tr>
                                        <tr><th>Official</th><td>@ValueOrDash(_lookup.Official)</td></tr>
                                        <tr><th>Department</th><td>@DepartmentDisplay</td></tr>
                                        <tr><th>Date Required</th><td>@FormatDate(_lookup.DateRequired)</td></tr>
                                        <tr><th>Time Required</th><td>@FormatTime(_lookup.TimeRequired)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="bx bx-car"></i>
                            Service Details
                        </h3>
                        <div class="form-grid">
                            <div class="form-field">
                                <label class="form-label">Service Provider</label>
                                <select class="form-select" @bind="_form.ContractorId" disabled="@_isReprintMode">
                                    <option value="0">Select...</option>
                                    @foreach (var contractor in _references.Contractors)
                                    {
                                        <option value="@contractor.ContractorId">@contractor.ContractorName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-field">
                                <label class="form-label">Class</label>
                                <select class="form-select" @bind="_selectedVehicleTypeCodeString" disabled="@IsGgContractor">
                                    @if (IsGgContractor)
                                    {
                                        <option value="">Derived from GG vehicle</option>
                                    }
                                    else
                                    {
                                        <option value="">Select class...</option>
                                        <option value="0">Quoted tariff</option>
                                        @foreach (var classOption in FilteredClasses)
                                        {
                                            <option value="@classOption.ClassId">@classOption.Description</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-field">
                                <label class="form-label">Registration Number</label>
                                <input class="form-input fis-uppercase" maxlength="20" @bind="_form.RegistrationNumber" disabled="@_isReprintMode" />
                                @if (IsGgContractor && !string.IsNullOrWhiteSpace(_lookup.FleetNumber))
                                {
                                    <small class="form-hint">GG Fleet Number: @_lookup.FleetNumber</small>
                                }
                            </div>
                            <div class="form-field">
                                <label class="form-label">Driver</label>
                                <input class="form-input" maxlength="50" @bind="_form.Driver" disabled="@_isReprintMode" />
                            </div>
                            @if (ShowQuotedTariff)
                            {
                                <div class="form-field">
                                    <label class="form-label">Quoted Tariff</label>
                                    <input class="form-input" type="number" min="0" step="0.01" @bind="_form.QuotedTariff" disabled="@_isReprintMode" />
                                </div>
                            }
                            <div class="form-field">
                                <label class="form-label">Log Note</label>
                                <select class="form-select" @bind="_selectedLogNoteString" disabled="@_isReprintMode">
                                    <option value="">None</option>
                                    @foreach (var note in _references.Notes)
                                    {
                                        <option value="@note.NoteCode">@note.Description</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="bx bx-map"></i>
                            Driver Journey
                        </h3>
                        <div class="table-container">
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Odometer</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <th>Start of journey</th>
                                            <td><input class="form-input" type="number" min="0" @bind="_form.DriverStartOdo" disabled="@_isReprintMode" /></td>
                                            <td><input class="form-input" type="date" @bind="_form.DriverStartDate" disabled="@_isReprintMode" /></td>
                                            <td><input class="form-input" type="time" value="@_form.DriverStartTime" @onchange="OnDriverStartTimeChanged" disabled="@_isReprintMode" /></td>
                                        </tr>
                                        <tr>
                                            <th>End of journey</th>
                                            <td><input class="form-input" type="number" min="0" @bind="_form.DriverEndOdo" disabled="@_isReprintMode" /></td>
                                            <td><input class="form-input" type="date" @bind="_form.DriverEndDate" disabled="@_isReprintMode" /></td>
                                            <td><input class="form-input" type="time" value="@_form.DriverEndTime" @onchange="OnDriverEndTimeChanged" disabled="@_isReprintMode" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        @if (_isReprintMode)
                        {
                            <button class="btn btn-primary" @onclick="PrintAsync">Print</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="SaveLogsheetAsync" disabled="@_saving">@(_isEditMode ? "Update" : "Submit")</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string? Mode { get; set; }

    private string _pageTitle = "Taxi Logs";
    private string _pageDescription = "Taxi log workflow.";
    private bool _loading = true;
    private bool _lookupLoading;
    private bool _saving;
    private bool _savingWhiteLog;
    private bool _error;
    private bool _isWhiteLogMode;
    private bool _isEditMode;
    private bool _isReprintMode;
    private string _message = string.Empty;
    private string _lookupRekNumber = string.Empty;
    private TaxiLogReferenceModel _references = new();
    private TaxiLogLookupModel? _lookup;
    private TaxiLogSaveModel _form = CreateDefaultForm();
    private WhiteLogInput _whiteLog = WhiteLogInput.CreateDefault();

    protected override async Task OnInitializedAsync()
    {
        _references = await TaxiLogService.GetReferencesAsync<TaxiLogReferenceModel>() ?? new TaxiLogReferenceModel();
        _loading = false;
    }

    protected override void OnParametersSet()
    {
        var normalized = (Mode ?? string.Empty).Trim().ToLowerInvariant();
        _isWhiteLogMode = normalized == "white-log";
        _isEditMode = normalized == "edit";
        _isReprintMode = normalized == "reprint";

        _pageTitle = normalized switch
        {
            "enter" => "Enter Taxi Logsheet",
            "edit" => "Edit Taxi Logsheet",
            "reprint" => "Reprint Taxi Log",
            "white-log" => "Enter Taxi White Log (GG vehicles not for claiming)",
            _ => "Taxi Logs"
        };

        _pageDescription = normalized switch
        {
            "enter" => "Capture taxi odometer kilometres against a requisition.",
            "edit" => "Edit the existing taxi odometer log captured against a requisition.",
            "reprint" => "Reprint taxi log output.",
            "white-log" => "Capture kilometres for GG vehicles not used for claiming.",
            _ => "Taxi log workflow."
        };
    }

    private IEnumerable<TaxiLogClassOptionModel> FilteredClasses =>
        _references.Classes
            .Where(item => item.ContractorId == _form.ContractorId)
            .OrderBy(item => item.Description);

    private bool IsGgContractor => _form.ContractorId == 2;

    private bool ShowQuotedTariff => !IsGgContractor && !_form.VehicleTypeCode.HasValue;

    private string DepartmentDisplay => _lookup == null
        ? "-"
        : _lookup.DepartmentCode.HasValue
            ? $"{_lookup.DepartmentCode} - {ValueOrDash(_lookup.DepartmentName)}"
            : ValueOrDash(_lookup.DepartmentName);

    private string _selectedVehicleTypeCodeString
    {
        get => _form.VehicleTypeCode?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                _form.VehicleTypeCode = null;
                return;
            }

            if (short.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
            {
                _form.VehicleTypeCode = parsed == 0 ? null : parsed;
                if (parsed == 0)
                {
                    _form.QuotedTariff ??= 0;
                }
            }
        }
    }

    private string _selectedLogNoteString
    {
        get => _form.TaxiLogNoteCode?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                _form.TaxiLogNoteCode = null;
                return;
            }

            if (short.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
            {
                _form.TaxiLogNoteCode = parsed;
            }
        }
    }

    private async Task LookupAsync()
    {
        _error = false;
        _message = string.Empty;
        _lookup = null;

        if (string.IsNullOrWhiteSpace(_lookupRekNumber))
        {
            _error = true;
            _message = "Requisition number required.";
            return;
        }

        _lookupLoading = true;
        try
        {
            var mode = _isEditMode ? "edit" : _isReprintMode ? "reprint" : "enter";
            var lookup = await TaxiLogService.LookupAsync<TaxiLogLookupModel>(_lookupRekNumber, mode);
            if (lookup == null)
            {
                _error = true;
                _message = $"Requisition number {Normalize(_lookupRekNumber)} not found.";
                return;
            }

            _lookup = lookup;
            _form = CreateFormFromLookup(lookup);
            _lookupRekNumber = lookup.RekNum;
        }
        catch (HttpRequestException ex)
        {
            _error = true;
            _message = ex.Message;
        }
        finally
        {
            _lookupLoading = false;
        }
    }

    private async Task SaveLogsheetAsync()
    {
        _error = false;
        _message = string.Empty;

        if (_lookup == null)
        {
            _error = true;
            _message = "Load a requisition first.";
            return;
        }

        var validation = ValidateLogsheet();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            _error = true;
            _message = validation;
            return;
        }

        _saving = true;
        try
        {
            var payload = new
            {
                request_id = _form.RequestId,
                rek_num = Normalize(_form.RekNum),
                contractor_id = _form.ContractorId,
                vehicle_type_code = _form.VehicleTypeCode ?? 0,
                reg_num = Normalize(_form.RegistrationNumber),
                driver = _form.Driver?.Trim(),
                driver_start_odo = _form.DriverStartOdo,
                driver_end_odo = _form.DriverEndOdo,
                driver_start_date = _form.DriverStartDate,
                driver_end_date = _form.DriverEndDate,
                driver_start_time = ParseTime(_form.DriverStartTime),
                driver_end_time = ParseTime(_form.DriverEndTime),
                taxi_log_note_code = _form.TaxiLogNoteCode,
                quoted_tariff = ShowQuotedTariff ? _form.QuotedTariff : null
            };

            TaxiLogLookupModel? response;
            if (_isEditMode && _lookup.Log != null)
            {
                response = await TaxiLogService.UpdateAsync<object, TaxiLogLookupModel>(_lookup.Log.LogId, payload);
            }
            else
            {
                response = await TaxiLogService.CreateAsync<object, TaxiLogLookupModel>(payload);
            }

            if (response == null)
            {
                _error = true;
                _message = "Taxi log save failed.";
                return;
            }

            _lookup = response;
            _form = CreateFormFromLookup(response);
            _message = _isEditMode ? "Taxi log updated." : "Taxi log entered.";
        }
        catch (HttpRequestException ex)
        {
            _error = true;
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private string? ValidateLogsheet()
    {
        if (_form.ContractorId <= 0)
        {
            return "Service provider required.";
        }

        if (string.IsNullOrWhiteSpace(_form.RegistrationNumber))
        {
            return "Registration number required.";
        }

        if (string.IsNullOrWhiteSpace(_form.Driver))
        {
            return "Driver name required.";
        }

        if (_form.DriverStartOdo is null)
        {
            return "Please enter Driver Start odometer.";
        }

        if (_form.DriverEndOdo is null)
        {
            return "Please enter Driver End odometer.";
        }

        if (_form.DriverEndOdo <= _form.DriverStartOdo)
        {
            return "Driver start odometer greater than or equal to end odometer.";
        }

        if (_form.DriverStartDate is null || _form.DriverEndDate is null || string.IsNullOrWhiteSpace(_form.DriverStartTime) || string.IsNullOrWhiteSpace(_form.DriverEndTime))
        {
            return "Please complete Start/End date and time.";
        }

        if (!TimeSpan.TryParse(_form.DriverStartTime, CultureInfo.InvariantCulture, out var startTime) ||
            !TimeSpan.TryParse(_form.DriverEndTime, CultureInfo.InvariantCulture, out var endTime))
        {
            return "Please complete Start/End date and time.";
        }

        var start = _form.DriverStartDate.Value.Date.Add(startTime);
        var end = _form.DriverEndDate.Value.Date.Add(endTime);
        if (start >= end)
        {
            return "End of journey Date/time is less than Start of journey Date/time";
        }

        var distance = _form.DriverEndOdo.Value - _form.DriverStartOdo.Value;
        var totalHours = (decimal)(end - start).TotalHours;
        if (totalHours > 24m)
        {
            var minimumDistance = (totalHours / 24m) * 10m;
            if (distance < minimumDistance)
            {
                return $"Distance = {distance:0.##}km\nTime = {Math.Truncate(totalHours / 24m)} days\nOdometer or Date/Time values are incorrect.";
            }
        }

        var maximumDistance = totalHours * 120m;
        if (distance > maximumDistance)
        {
            return $"Distance = {distance:0.##}km\nTime = {totalHours:0.##} hours\nOdometer or Date/Time values are incorrect.";
        }

        if (!IsGgContractor && !_form.VehicleTypeCode.HasValue && _form.QuotedTariff is not > 0)
        {
            return "Quoted tariff amount must be entered.";
        }

        return null;
    }

    private void ResetLogsheetForm()
    {
        _lookup = null;
        _form = CreateDefaultForm();
        _message = string.Empty;
        _error = false;
    }

    private async Task SaveWhiteLogAsync()
    {
        _error = false;
        _message = string.Empty;

        var validation = ValidateWhiteLog();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            _error = true;
            _message = validation;
            return;
        }

        _savingWhiteLog = true;
        try
        {
            var gg = Normalize(_whiteLog.GgNumber);
            var vehicleMatches = await VehicleService.SearchVehiclesAsync(gg);
            var vehicle = vehicleMatches.FirstOrDefault(v => string.Equals((v.fleet_number ?? string.Empty).Trim(), gg, StringComparison.OrdinalIgnoreCase));
            if (vehicle == null)
            {
                _error = true;
                _message = $"{gg} not found.";
                return;
            }

            if (vehicle.type_code != 2)
            {
                _error = true;
                _message = $"{gg} is not a VIP Service vehicle.";
                return;
            }

            var payload = new
            {
                vmf_code = vehicle.vmf_code,
                start_odo = _whiteLog.StartOdo,
                end_odo = _whiteLog.EndOdo,
                start_date = _whiteLog.StartDate,
                end_date = _whiteLog.EndDate,
                driver = (_whiteLog.Driver ?? string.Empty).Trim()
            };

            AddAuthHeader();
            var response = await Http.PostAsJsonAsync("api/taxi/white-log", payload);
            if (response.IsSuccessStatusCode)
            {
                _message = "White log entered.";
                _error = false;
                ResetWhiteLog();
                return;
            }

            var body = await response.Content.ReadAsStringAsync();
            _error = true;
            _message = string.IsNullOrWhiteSpace(body)
                ? $"White log save failed ({(int)response.StatusCode})."
                : body;
        }
        catch (Exception ex)
        {
            _error = true;
            _message = $"White log save failed: {ex.Message}";
        }
        finally
        {
            _savingWhiteLog = false;
        }
    }

    private string? ValidateWhiteLog()
    {
        if (string.IsNullOrWhiteSpace(_whiteLog.GgNumber))
        {
            return "GG number required.";
        }

        if (string.IsNullOrWhiteSpace(_whiteLog.Driver))
        {
            return "Driver name required.";
        }

        if (_whiteLog.StartOdo is null)
        {
            return "Start odometer required.";
        }

        if (_whiteLog.EndOdo is null)
        {
            return "End odometer required.";
        }

        if (_whiteLog.StartDate is null)
        {
            return "Start date required.";
        }

        if (_whiteLog.EndDate is null)
        {
            return "End date required.";
        }

        if (_whiteLog.StartOdo >= _whiteLog.EndOdo)
        {
            return "End odometer must be more than start odometer.";
        }

        if (_whiteLog.EndDate < _whiteLog.StartDate)
        {
            return "Start date must be before end date.";
        }

        return null;
    }

    private void AddAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(TokenService.Token))
        {
            return;
        }

        Http.DefaultRequestHeaders.Remove("Cookie");
        Http.DefaultRequestHeaders.TryAddWithoutValidation("Cookie", $"FIS_Access_Token={TokenService.Token}");
    }

    private void ResetWhiteLog()
    {
        _whiteLog = WhiteLogInput.CreateDefault();
    }

    private Task PrintAsync()
        => JS.InvokeVoidAsync("window.print").AsTask();

    private TaxiLogSaveModel CreateFormFromLookup(TaxiLogLookupModel lookup)
    {
        return new TaxiLogSaveModel
        {
            RequestId = lookup.RequestId,
            RekNum = lookup.RekNum,
            ContractorId = lookup.ContractorId ?? 0,
            VehicleTypeCode = lookup.ContractorId == 2 ? null : lookup.VehicleTypeCode,
            RegistrationNumber = lookup.RegistrationNumber ?? lookup.FleetNumber ?? string.Empty,
            Driver = lookup.Driver ?? string.Empty,
            DriverStartOdo = lookup.Log?.DriverStartOdo,
            DriverEndOdo = lookup.Log?.DriverEndOdo,
            DriverStartDate = lookup.Log?.DriverStartDate ?? DateTime.Today,
            DriverEndDate = lookup.Log?.DriverEndDate ?? DateTime.Today,
            DriverStartTime = lookup.Log?.DriverStartTime ?? "08:00",
            DriverEndTime = lookup.Log?.DriverEndTime ?? "09:00",
            TaxiLogNoteCode = lookup.Log?.TaxiLogNoteCode,
            QuotedTariff = lookup.Log?.QuotedTariff
        };
    }

    private static TaxiLogSaveModel CreateDefaultForm() =>
        new()
        {
            DriverStartDate = DateTime.Today,
            DriverEndDate = DateTime.Today
        };

    private static string Normalize(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();

    private static TimeSpan ParseTime(string value) =>
        TimeSpan.Parse(value, CultureInfo.InvariantCulture);

    private void OnDriverStartTimeChanged(ChangeEventArgs args)
    {
        _form.DriverStartTime = args.Value?.ToString() ?? string.Empty;
    }

    private void OnDriverEndTimeChanged(ChangeEventArgs args)
    {
        _form.DriverEndTime = args.Value?.ToString() ?? string.Empty;
    }

    private static string FormatDate(DateTime? value) => value?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "-";

    private static string FormatTime(DateTime? value) => value?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "-";

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed class WhiteLogInput
    {
        public string GgNumber { get; set; } = string.Empty;
        public string Driver { get; set; } = string.Empty;
        public int? StartOdo { get; set; }
        public DateTime? StartDate { get; set; }
        public int? EndOdo { get; set; }
        public DateTime? EndDate { get; set; }

        public static WhiteLogInput CreateDefault()
            => new()
            {
                StartDate = DateTime.Today,
                EndDate = DateTime.Today
            };
    }
}
