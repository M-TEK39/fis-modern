@page "/taxis/maintenance/info"
@rendermode InteractiveServer

<PageTitle>Taxi Information Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Taxi Information Maintenance
        </h1>
        <p class="page-description">Taxi information maintenance.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Use this screen to maintain taxi information records.</p>
        </div>
    </div>
</div>
