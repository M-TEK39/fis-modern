@page "/taxis/maintenance/info"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Taxi Information Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-wrench"></i>
            Taxi Information Maintenance
        </h1>
        <p class="page-description">Legacy taxi information maintenance screen.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Taxi information maintenance to be aligned with legacy workflow.</p>
            <LegacyEndpointActionPanel
                LegacyPath="Private_Hire/MNT_menu.aspx"
                Endpoint="api/privatehire"
                HttpMethod="GET"
                ButtonText="Run Taxi Maintenance API"
                ReportType="taxis-maintenance" />
        </div>
    </div>
</div>
