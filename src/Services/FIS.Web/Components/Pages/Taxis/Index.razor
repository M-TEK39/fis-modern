@page "/taxis"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared
@using FIS.Web.Services
@inject TaxiApiService TaxiService
@inject IJSRuntime JS

<PageTitle>Taxis - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-taxi"></i>
            Taxis
        </h1>
        <p class="page-description">Taxi records summary from /api/taxi.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadTaxis">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading taxi records...</p>
        </div>
    }
    else if (_taxis.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-taxi"></i>
            <h3>No taxi records</h3>
            <p>Awaiting taxi API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_taxis.Count Taxi record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Taxi #</th>
                            <th>Driver</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var taxi in _taxis)
                        {
                            <tr>
                                <td>@taxi.Number</td>
                                <td>@taxi.Driver</td>
                                <td>@taxi.Vehicle</td>
                                <td><span class="badge">@taxi.Status</span></td>
                                <td>@taxi.Date.ToString("yyyy-MM-dd")</td>
                                <td>@taxi.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<TaxiItem> _taxis = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTaxis();
    }

    private async Task LoadTaxis()
    {
        _loading = true;
        try
        {
            var apiItems = await TaxiService.GetAllAsync<TaxiDto>();
            _taxis = apiItems.Select(t => new TaxiItem(
                Number: t.taxi_code.ToString(),
                Driver: t.driver_name ?? "Unknown",
                Vehicle: t.vmf_code?.ToString() ?? "Unknown",
                Status: t.taxi_status ?? "Unknown",
                Date: t.taxi_date ?? DateTime.MinValue,
                Notes: t.taxi_notes ?? string.Empty
            )).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading taxis: {ex.Message}");
            _taxis = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record TaxiItem(string Number, string Driver, string Vehicle, string Status, DateTime Date, string Notes);

    private sealed class TaxiDto
    {
        public int taxi_code { get; set; }
        public int? vmf_code { get; set; }
        public string? driver_name { get; set; }
        public string? taxi_status { get; set; }
        public DateTime? taxi_date { get; set; }
        public string? taxi_notes { get; set; }
    }
}
