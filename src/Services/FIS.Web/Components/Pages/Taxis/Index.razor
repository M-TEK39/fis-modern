@page "/taxis"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Taxis - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-taxi"></i>
            Taxis
        </h1>
        <p class="page-description">Taxi records summary. Static entries until taxi API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadTaxis">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading taxi records...</p>
        </div>
    }
    else if (_taxis.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-taxi"></i>
            <h3>No taxi records</h3>
            <p>Awaiting taxi API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_taxis.Count Taxi record(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Taxi #</th>
                            <th>Driver</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var taxi in _taxis)
                        {
                            <tr>
                                <td>@taxi.Number</td>
                                <td>@taxi.Driver</td>
                                <td>@taxi.Vehicle</td>
                                <td><span class="badge">@taxi.Status</span></td>
                                <td>@taxi.Date.ToString("yyyy-MM-dd")</td>
                                <td>@taxi.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<TaxiItem> _taxis = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTaxis();
    }

    private Task LoadTaxis()
    {
        _loading = true;

        _taxis =
        [
            new("TX-2401-001", "Driver: S. Nkosi", "ABC123GP", "Open", new DateTime(2025, 01, 12), "Pending posting."),
            new("TX-2401-002", "Driver: M. Dlamini", "JKL456GP", "In Progress", new DateTime(2025, 01, 10), "Awaiting journal detail."),
            new("TX-2312-010", "Driver: P. Naidoo", "MNO789GP", "Closed", new DateTime(2024, 12, 18), "Posted to finance."),
            new("TX-2311-007", "Driver: A. Smith", "PQR321GP", "Rebill Pending", new DateTime(2024, 11, 25), "Rebill workflow started.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record TaxiItem(string Number, string Driver, string Vehicle, string Status, DateTime Date, string Notes);
}
