@page "/taxis"
@page "/Taxis/Taxi_menu.aspx"
@page "/Taxi_menu.aspx"
@page "/Private_Hire/Taxi_menu.aspx"
@rendermode InteractiveServer
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TaxiApiService TaxiService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Taxi Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-taxi"></i>
            Taxi Maintenance Menu
        </h1>
        <p class="page-description">Taxi requisitions, logs, maintenance, and reports.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" @onclick="LoadTaxis">
            <i class="bx bx-refresh"></i>
            Refresh Summary
        </button>
    </div>
</div>

<div class="page-content">
    @if (!_hasPrivateHireVehiclesRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Private Hire Vehicles</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleHelp">
                <span>Taxi Maintenance Menu</span>
                <i class="bx @(_showHelp ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showHelp)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/help">Taxi Maintenance Information / Help</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleRequisitions">
                <span>Taxi Requisitions</span>
                <i class="bx @(_showRequisitions ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showRequisitions)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/enter">1) Enter Taxi Requisition</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/enter-prev-bas">1.1) Enter Taxi Requisition "using: Previous Fin Years BAS Codes"</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/edit">2) Edit Taxi Requisition</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/edit-prev-bas">2.1) Edit Taxi Requisition "using: Previous Fin Years BAS Codes"</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/cancel">3) Cancel Taxi Requisition</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/reprint">4) Re-Print A Requisition</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/pending">5) Pending Requests</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/requests/pending-jia">6) Pending JIA Pick-ups</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleLogs">
                <span>Taxi Logs</span>
                <i class="bx @(_showLogs ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showLogs)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/logs/enter">1) Enter Taxi logsheet</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/logs/edit">2) Edit Taxi Logsheet</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/logs/reprint">3) Reprint Taxi Log</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/logs/white-log">3) Enter Taxi "white log" (GG vehicles not for claiming)</a>
                    </div>
                </div>
            }
        </div>

        @if (_hasTaxiInformationMaintenanceRole)
        {
            <div class="menu-tile">
                <button class="menu-tile-header" @onclick="ToggleMaintenance">
                    <span>Maintenance</span>
                    <i class="bx @(_showMaintenance ? "bx-chevron-up" : "bx-chevron-down")"></i>
                </button>
                @if (_showMaintenance)
                {
                    <div class="menu-tile-body">
                        <div class="menu-item">
                            <a class="menu-item-link" href="/taxis/maintenance/info">1) Taxi Information Maintenance</a>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleReports">
                <span>Taxi Reports</span>
                <i class="bx @(_showReports ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showReports)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/one-taxi-number">1) Report On One Taxi Number.</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-per-user">2) Number Of Taxi Logs Captured Per User For Date.</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/old-requisitions">3) Old Requisitions For Period</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/taxis-per-company">4) Taxis Per Hire Company</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/taxis-per-department">5) List Of All Taxis In Various Departments</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/taxis-inservice-per-department">6) List Of All Taxis In Service In Various Departments</a>
                    </div>
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/reports/logs-requisitions-status">7) Taxi Logs and Requisitions Statuses Reports</a>
                    </div>
                </div>
            }
        </div>

        <div class="menu-tile">
            <button class="menu-tile-header" @onclick="ToggleOther">
                <span>Other Taxi Maintenance Options</span>
                <i class="bx @(_showOther ? "bx-chevron-up" : "bx-chevron-down")"></i>
            </button>
            @if (_showOther)
            {
                <div class="menu-tile-body">
                    <div class="menu-item">
                        <a class="menu-item-link" href="/taxis/scan-requisition">1) Scan Taxi Requisition</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="form-card fis-mt-15">
        <div class="form-card-header">
            <h2>Taxi Records Summary</h2>
        </div>
        <div class="form-card-body">
            @if (_loading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading taxi records...</p>
                </div>
            }
            else if (_taxis.Count == 0)
            {
                <div class="empty-state">
                    <i class="bx bx-taxi"></i>
                    <h3>No taxi records</h3>
                    <p>No taxi records match the current filter selection.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <div class="table-header">
                        <span class="table-title">@FilteredTaxis.Count Taxi record(s)</span>
                        <div class="table-controls">
                            <select class="form-select" @bind="_statusFilter" @bind:after="ApplyTaxiFilters">
                                <option value="">All taxi records</option>
                                <option value="pending">Pending records</option>
                                <option value="completed">Completed records</option>
                                <option value="withVehicle">Vehicle-linked records</option>
                                <option value="withDriver">Driver captured records</option>
                            </select>
                        </div>
                    </div>
                    <div class="search-bar">
                        <div class="search-input-wrapper">
                            <i class="bx bx-search"></i>
                            <input class="search-input"
                                   type="search"
                                   placeholder="Search taxi number, driver, vehicle, status, notes..."
                                   @bind="_searchTerm"
                                   @bind:event="oninput"
                                   @bind:after="ApplyTaxiFilters" />
                            @if (!string.IsNullOrWhiteSpace(_searchTerm))
                            {
                                <button type="button" class="search-clear" @onclick="ClearTaxiSearch" aria-label="Clear search">
                                    <i class="bx bx-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Taxi #</th>
                                    <th>Driver</th>
                                    <th>Vehicle</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var taxi in PagedTaxis)
                                {
                                    <tr>
                                    <td>@ValueOrDash(taxi.Number)</td>
                                    <td>@ValueOrDash(taxi.Driver)</td>
                                    <td>@ValueOrDash(taxi.Vehicle)</td>
                                    <td><span class="badge">@ValueOrDash(taxi.Status)</span></td>
                                    <td>@FormatDate(taxi.Date)</td>
                                    <td>@ValueOrDash(taxi.Notes)</td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                    <div class="pagination-controls fis-mt-1">
                        <button class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                        <div class="pagination-info">Page @_page of @TotalPages</div>
                        <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                    </div>
                    <div class="pagination-meta">Total records: @FilteredTaxis.Count | Page size: @_pageSize</div>
                </div>
            }
        </div>
    </div>
    }
</div>

@code {
    private bool _hasPrivateHireVehiclesRole;
    private bool _hasTaxiInformationMaintenanceRole;
    private bool _loading = true;
    private int _page = 1;
    private const int _pageSize = 12;
    private List<TaxiItem> _taxis = new();
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private List<TaxiItem> FilteredTaxis => _taxis
        .Where(MatchesSearch)
        .Where(MatchesFilter)
        .ToList();
    private IEnumerable<TaxiItem> PagedTaxis => FilteredTaxis.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTaxis.Count / (double)_pageSize));

    private bool _showHelp = true;
    private bool _showRequisitions = true;
    private bool _showLogs = true;
    private bool _showMaintenance = true;
    private bool _showReports = true;
    private bool _showOther = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _hasPrivateHireVehiclesRole = HasRole(user, "Private Hire Vehicles");
        _hasTaxiInformationMaintenanceRole = HasRole(user, "Taxi Information Maintenance");

        if (!_hasPrivateHireVehiclesRole)
        {
            _loading = false;
            return;
        }

        await LoadTaxis();
    }

    private async Task LoadTaxis()
    {
        _loading = true;
        try
        {
            var apiItems = await TaxiService.GetAllAsync<TaxiDto>();
            _taxis = apiItems.Select(t => new TaxiItem(
                Number: t.rek_num ?? t.request_id.ToString(),
                Driver: t.official ?? "Unknown",
                Vehicle: t.vmf_code ?? "Unknown",
                Status: t.rank ?? "Unknown",
                Date: t.date_required,
                Notes: t.address_1 ?? string.Empty
            )).ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Error loading taxis: {ex.Message}");
            _taxis = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleHelp() => _showHelp = !_showHelp;
    private void ToggleRequisitions() => _showRequisitions = !_showRequisitions;
    private void ToggleLogs() => _showLogs = !_showLogs;
    private void ToggleMaintenance() => _showMaintenance = !_showMaintenance;
    private void ToggleReports() => _showReports = !_showReports;
    private void ToggleOther() => _showOther = !_showOther;

    private void ApplyTaxiFilters()
    {
        _page = 1;
    }

    private void ClearTaxiSearch()
    {
        _searchTerm = string.Empty;
        _page = 1;
    }

    private bool MatchesSearch(TaxiItem item)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return true;
        }

        var search = _searchTerm.Trim();
        return Contains(item.Number, search) ||
            Contains(item.Driver, search) ||
            Contains(item.Vehicle, search) ||
            Contains(item.Status, search) ||
            Contains(item.Notes, search);
    }

    private bool MatchesFilter(TaxiItem item)
    {
        return _statusFilter switch
        {
            "pending" => Contains(item.Status, "pending") || Contains(item.Notes, "pending"),
            "completed" => Contains(item.Status, "complete") || Contains(item.Status, "closed"),
            "withVehicle" => !string.IsNullOrWhiteSpace(item.Vehicle) && !string.Equals(item.Vehicle, "Unknown", StringComparison.OrdinalIgnoreCase),
            "withDriver" => !string.IsNullOrWhiteSpace(item.Driver) && !string.Equals(item.Driver, "Unknown", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private sealed record TaxiItem(string Number, string Driver, string Vehicle, string Status, DateTime? Date, string Notes);

    private sealed class TaxiDto
    {
        public int request_id { get; set; }
        public string? rek_num { get; set; }
        public string? official { get; set; }
        public string? vmf_code { get; set; }
        public string? rank { get; set; }
        public DateTime? date_required { get; set; }
        public string? address_1 { get; set; }
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static bool Contains(string? value, string search)
        => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
