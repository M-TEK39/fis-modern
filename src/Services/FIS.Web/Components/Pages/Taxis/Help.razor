@page "/taxis/help"
@rendermode InteractiveServer

<PageTitle>Taxi Help - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Taxi Maintenance Information / Help
        </h1>
        <p class="page-description">Taxi help content.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="/taxis">Back to Taxi Menu</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-body">
            <p class="form-hint">Open the help document for taxi maintenance.</p>
            <a class="btn btn-secondary" href="/legacy/taxis/Doc_taxis.htm" target="_blank">Open Help</a>
        </div>
    </div>
</div>
