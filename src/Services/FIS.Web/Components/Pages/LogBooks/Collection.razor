@page "/log-books/collection"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@inject LogbookApiService LogbookService
@inject SiteApiService SiteService
@inject VehicleApiService VehicleService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Collection - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-collection"></i>
            Collection for Two or More Logbooks
        </h1>
        <p class="page-description">Logbook collection workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Receiver Name</label>
            <input class="form-input" @bind="_receiverName" />
        </div>
        <div class="form-row">
            <label class="form-label">Receiver Tel</label>
            <input class="form-input" @bind="_receiverTel" />
        </div>
        <div class="form-row">
            <label class="form-label">Site</label>
            <select class="form-select" @bind="_siteCode">
                <option value="">Select site</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label class="form-label">Handout Date</label>
            <input type="date" class="form-input" @bind="_handoutDate" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Search</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
            </div>
            <input class="form-input" @bind="_vehicleSearchTerm" placeholder="@(_searchMode == "GG" ? "GG number" : "GP number")" />
            <div class="form-actions" style="margin-top: 0.5rem;">
                <button class="btn btn-secondary btn-sm" type="button" @onclick="SearchVehiclesAsync" disabled="@_loading">Search vehicle</button>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Matches</label>
            <div class="table-container">
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>GG Number</th>
                                <th>Registration</th>
                                <th>Vehicle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_vehicleMatches.Count == 0)
                            {
                                <tr>
                                    <td colspan="4">Search to load vehicles.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vehicle in _vehicleMatches)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox"
                                                   checked="@_selectedVmfCodes.Contains(vehicle.vmf_code)"
                                                   @onchange="e => ToggleVehicleSelection(vehicle.vmf_code, e.Value)" />
                                        </td>
                                        <td>@ValueOrDash(vehicle.fleet_number)</td>
                                        <td>@ValueOrDash(vehicle.registration_number)</td>
                                        <td>@GetVehicleLabel(vehicle)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SubmitCollection">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Submitting...</p>
        </div>
    }
</div>

@code {
    private bool _loading;
    private string _searchMode = "GG";
    private string _receiverName = string.Empty;
    private string _receiverTel = string.Empty;
    private string _vehicleSearchTerm = string.Empty;
    private short? _siteCode;
    private DateTime? _handoutDate;
    private List<SiteResponseDto> _sites = new();
    private List<VehicleDto> _vehicleMatches = new();
    private HashSet<int> _selectedVmfCodes = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task SubmitCollection()
    {
        _loading = true;
        try
        {
            var vmfList = _selectedVmfCodes.OrderBy(code => code).ToList();
            foreach (var vmfCode in vmfList)
            {
                var payload = new LogbookDto
                {
                    vmf_code = vmfCode,
                    handout_date = _handoutDate,
                    site_code = _siteCode,
                    lb_receiver_name = _receiverName,
                    lb_tel_num = _receiverTel
                };

                await LogbookService.CreateAsync(payload);
            }

            _receiverName = string.Empty;
            _receiverTel = string.Empty;
            _vehicleSearchTerm = string.Empty;
            _siteCode = null;
            _handoutDate = null;
            _vehicleMatches = new();
            _selectedVmfCodes = new();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchVehiclesAsync()
    {
        if (string.IsNullOrWhiteSpace(_vehicleSearchTerm))
        {
            _vehicleMatches = new();
            _selectedVmfCodes.Clear();
            return;
        }

        var searchTerm = _vehicleSearchTerm.Trim();
        var matches = await VehicleService.SearchVehiclesAsync(searchTerm);
        _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _searchMode);
        _selectedVmfCodes = _vehicleMatches.Select(vehicle => vehicle.vmf_code).ToHashSet();
    }

    private void ToggleVehicleSelection(int vmfCode, object? value)
    {
        var isChecked = value is bool checkedValue && checkedValue;
        if (isChecked)
        {
            _selectedVmfCodes.Add(vmfCode);
            return;
        }

        _selectedVmfCodes.Remove(vmfCode);
    }

    private static string GetVehicleLabel(VehicleDto vehicle)
        => $"{ValueOrDash(vehicle.fleet_number)} / {ValueOrDash(vehicle.registration_number)} ({vehicle.vmf_code})";

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleDto> FilterVehicleMatches(List<VehicleDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.registration_number) && v.registration_number.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.fleet_number) && v.fleet_number.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.registration_number?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.fleet_number?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.vmf_code)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCodes.Clear();
    }
}
