@page "/log-books/collection"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject LogbookApiService LogbookService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Collection - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-collection"></i>
            Collection for Two or More Logbooks
        </h1>
        <p class="page-description">Legacy Logbook/MNT_logb2j_getpersdetail.aspx workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Receiver Name</label>
            <input class="form-input" @bind="_receiverName" />
        </div>
        <div class="form-row">
            <label class="form-label">Receiver Tel</label>
            <input class="form-input" @bind="_receiverTel" />
        </div>
        <div class="form-row">
            <label class="form-label">Site</label>
            <select class="form-select" @bind="_siteCode">
                <option value="">Select site</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.SiteCode">@site.DepartmentNumber - @site.Description</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label class="form-label">Handout Date</label>
            <input type="date" class="form-input" @bind="_handoutDate" />
        </div>
        <div class="form-row">
            <label class="form-label">VMF Codes (comma-separated)</label>
            <input class="form-input" @bind="_vmfCodes" placeholder="e.g. 123,456" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SubmitCollection">Submit</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Submitting...</p>
        </div>
    }
</div>


    <LegacyEndpointActionPanel
        LegacyPath="Logbook/MNT_logb2j_getpersdetail.aspx"
        Endpoint="api/logbook/collection"
        HttpMethod="POST"
        ButtonText="Test Logbook Collection Endpoint"
        ReportType="logbook-collection" />

@code {
    private bool _loading;
    private string _receiverName = string.Empty;
    private string _receiverTel = string.Empty;
    private string _vmfCodes = string.Empty;
    private short? _siteCode;
    private DateTime? _handoutDate;
    private List<SiteResponseDto> _sites = new();

    protected override async Task OnInitializedAsync()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task SubmitCollection()
    {
        _loading = true;
        try
        {
            var vmfList = ParseVmfCodes();
            foreach (var vmfCode in vmfList)
            {
                var payload = new LogbookDto
                {
                    vmf_code = vmfCode,
                    handout_date = _handoutDate,
                    site_code = _siteCode,
                    lb_receiver_name = _receiverName,
                    lb_tel_num = _receiverTel
                };

                await LogbookService.CreateAsync(payload);
            }

            _receiverName = string.Empty;
            _receiverTel = string.Empty;
            _vmfCodes = string.Empty;
            _siteCode = null;
            _handoutDate = null;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private List<int> ParseVmfCodes()
    {
        var list = new List<int>();
        if (string.IsNullOrWhiteSpace(_vmfCodes))
        {
            return list;
        }

        foreach (var part in _vmfCodes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var vmfCode))
            {
                list.Add(vmfCode);
            }
        }

        return list;
    }
}
