@page "/log-books"
@page "/logbook/MNTlogbk.aspx"
@page "/logbooks"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject LogbookApiService LogbookService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Maintenance Menu - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            Logbook Maintenance Menu
        </h1>
        <p class="page-description">Logbook maintenance menu.</p>
    </div>
</div>

<div class="page-content">
    @if (!_hasLogbooksRole)
    {
        <div class="alert alert-error">
            Access denied. Legacy parity: this menu requires the <strong>Logbooks</strong> role.
        </div>
    }
    else
    {
    <div class="menu-tiles">
        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Logbook Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-books/help">Logbook Maintenance Information / Help</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>

        <div class="menu-tile">
            <div class="menu-tile-header">
                <span>Logbook Maintenance Menu:</span>
            </div>
            <div class="menu-tile-body">
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-books/maintenance">1) Logbook Maintenance</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-books/collection">2) Collection for TWO or More Logbook's</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
                <div class="menu-item">
                    <a class="menu-item-link" href="/log-books/delete">3) Delete a Logbook Handout</a>
                    <span class="menu-item-badge">Menu</span>
                </div>
            </div>
        </div>
    </div>

    <DataPreviewTable Title="Logbook Handout Preview"
                      SearchPlaceholder="Search GG code, logbook range, receiver, comments..."
                      EmptyMessage="No logbook handouts match the current search or filter."
                      EmptyIcon="bx bx-notepad"
                      IsLoading="_loading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
    }
</div>

@code {
    private bool _hasLogbooksRole;
    private bool _loading = true;
    private List<Dictionary<string, string?>> _rows = new();

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("vmfCode", "GG Code"),
        new("begin", "Begin No."),
        new("end", "End No."),
        new("handoutDate", "Handout Date"),
        new("site", "Site"),
        new("receiver", "Receiver"),
        new("comment", "Comment")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Site-linked handouts", "siteStatus", "Site Linked"),
        new("Receiver captured", "receiverStatus", "Receiver Captured"),
        new("Handout date captured", "dateStatus", "Date Captured")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasLogbooksRole = HasRole(authState.User, "Logbooks");
        if (!_hasLogbooksRole)
        {
            _loading = false;
            return;
        }

        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        _loading = true;
        try
        {
            var logbooks = await LogbookService.GetAllAsync<LogbookDto>();
            _rows = logbooks
                .OrderByDescending(item => item.handout_date ?? DateTime.MinValue)
                .Select(item => new Dictionary<string, string?>
                {
                    ["vmfCode"] = item.vmf_code?.ToString(),
                    ["begin"] = item.begin_num,
                    ["end"] = item.end_num,
                    ["handoutDate"] = FormatDate(item.handout_date),
                    ["site"] = item.site_code?.ToString(),
                    ["receiver"] = item.lb_receiver_name,
                    ["comment"] = item.lb_comment,
                    ["siteStatus"] = item.site_code.HasValue ? "Site Linked" : "No Site",
                    ["receiverStatus"] = string.IsNullOrWhiteSpace(item.lb_receiver_name) ? "No Receiver" : "Receiver Captured",
                    ["dateStatus"] = item.handout_date.HasValue ? "Date Captured" : "No Date",
                    ["_href"] = $"/log-books/maintenance?vmfCode={item.vmf_code}&logbookCode={item.logbookcode}"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading logbook preview: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static bool HasRole(ClaimsPrincipal user, string role)
    {
        if (user.IsInRole(role))
        {
            return true;
        }

        var roleClaims = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type.Equals("role", StringComparison.OrdinalIgnoreCase) || c.Type.Equals("roles", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value);

        return roleClaims.Any(value =>
            value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Any(item => string.Equals(item, role, StringComparison.OrdinalIgnoreCase)));
    }
}
