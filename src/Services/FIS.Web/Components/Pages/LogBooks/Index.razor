@page "/log-books"
@rendermode InteractiveServer
@using FIS.Web.Components.Shared

<PageTitle>Log Books - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            Log Books
        </h1>
        <p class="page-description">Log book summary. Static entries until log book API is available.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="LoadLogBooks">
            <i class="bx bx-refresh"></i>
            Refresh
        </button>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading log books...</p>
        </div>
    }
    else if (_logBooks.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-notepad"></i>
            <h3>No log books</h3>
            <p>Awaiting log book API. Provide endpoint/fields to replace static data.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logBooks.Count Log book(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Period</th>
                            <th>Entries</th>
                            <th>Status</th>
                            <th>Updated</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _logBooks)
                        {
                            <tr>
                                <td>@log.Vehicle</td>
                                <td>@log.Period</td>
                                <td>@log.EntryCount</td>
                                <td><span class="badge">@log.Status</span></td>
                                <td>@log.UpdatedOn.ToString("yyyy-MM-dd")</td>
                                <td>@log.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<LogBookItem> _logBooks = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLogBooks();
    }

    private Task LoadLogBooks()
    {
        _loading = true;

        _logBooks =
        [
            new("ABC123GP", "Jan 2025", 18, "Open", new DateTime(2025, 01, 12), "Awaiting final sign-off."),
            new("JKL456GP", "Jan 2025", 12, "In Progress", new DateTime(2025, 01, 11), "Data being captured."),
            new("MNO789GP", "Dec 2024", 25, "Closed", new DateTime(2024, 12, 31), "Completed and archived."),
            new("PQR321GP", "Nov 2024", 9, "Closed", new DateTime(2024, 11, 30), "Legacy entry reference.")
        ];

        _loading = false;
        return Task.CompletedTask;
    }

    private sealed record LogBookItem(string Vehicle, string Period, int EntryCount, string Status, DateTime UpdatedOn, string Notes);
}
