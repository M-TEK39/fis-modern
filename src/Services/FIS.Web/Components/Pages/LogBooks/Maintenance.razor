@page "/log-books/maintenance"
@rendermode InteractiveServer
@using FIS.Web.Models
@using FIS.Web.Services
@using FIS.Web.Components.Shared
@inject LogbookApiService LogbookService
@inject VehicleLookupApiService VehicleLookupService
@inject SiteApiService SiteService
@inject IJSRuntime JSRuntime

<PageTitle>Logbook Maintenance - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-notepad"></i>
            Logbook Maintenance
        </h1>
        <p class="page-description">Logbook maintenance workflow.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-row">
            <label class="form-label">Number Type</label>
            <div class="contract-search-radio">
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GG")" @onchange='() => SetSearchMode("GG")' />
                    GG
                </label>
                <label class="form-radio-label">
                    <input type="radio" name="searchMode" checked="@(_searchMode == "GP")" @onchange='() => SetSearchMode("GP")' />
                    GP
                </label>
            </div>
        </div>
        <div class="form-row">
            <label class="form-label">@(_searchMode == "GG" ? "GG Number" : "GP Number")</label>
            <input class="form-input" @bind="_searchTerm" placeholder="@(_searchMode == "GG" ? "Enter GG number" : "Enter GP number")" />
        </div>
        <div class="form-row">
            <label class="form-label">Vehicle Match</label>
            <select class="form-select" @bind="_selectedVmfCode" disabled="@(_vehicleMatches.Count == 0)">
                <option value="">Select vehicle...</option>
                @foreach (var vehicle in _vehicleMatches)
                {
                    <option value="@vehicle.VmfCode">@VehicleOptionLabel(vehicle)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="SearchLogbooks">Find</button>
            <button class="btn btn-primary" @onclick="LoadSelectedVehicleLogbooksAsync" disabled="@(!_selectedVmfCode.HasValue)">Search</button>
            <button class="btn btn-secondary" @onclick="PrepareAdd">Add</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    }
    else if (_logbooks.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-note"></i>
            <h3>No logbooks found</h3>
            <p>Search by GG/GP number to view logbook handouts.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_logbooks.Count logbook(s)</span>
                <div class="table-controls">
                    <button class="btn btn-secondary btn-sm" @onclick="SearchLogbooks">
                        <i class="bx bx-refresh"></i>
                    </button>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Begin Number</th>
                            <th>End Number</th>
                            <th>Handout Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var logbook in PagedLogbooks)
                        {
                            <tr>
                                <td>@_vehicleLabel</td>
                                <td>@logbook.begin_num</td>
                                <td>@logbook.end_num</td>
                                <td>@FormatDate(logbook.handout_date)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <button class="btn-icon btn-icon-edit" @onclick="() => EditLogbook(logbook)">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_logbooks.Count > _pageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_logbooks.Count | Page size: @_pageSize</div>
            }
        </div>
    }

    @if (_showForm)
    {
        <Modal IsVisible="_showForm" Title="Logbook Maintenance" ShowFooter="false" OnCancel="HideForm">
            <ChildContent>
                <div class="form-card">
                    <div class="form-row">
                        <label class="form-label">Handout Date</label>
                        <input type="date" class="form-input" @bind="_form.handout_date" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Begin Number</label>
                        <input class="form-input" @bind="_form.begin_num" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">End Number</label>
                        <input class="form-input" @bind="_form.end_num" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Site</label>
                        <select class="form-select" @bind="_form.site_code">
                            <option value="">Select site</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.SiteCode">@($"{site.Description} ({site.SiteCode})")</option>
                            }
                        </select>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Receiver Name</label>
                        <input class="form-input" @bind="_form.lb_receiver_name" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Receiver Tel</label>
                        <input class="form-input" @bind="_form.lb_tel_num" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Comment</label>
                        <input class="form-input" @bind="_form.lb_comment" />
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SaveLogbook">Submit</button>
                        <button class="btn btn-secondary" @onclick="HideForm">Cancel</button>
                    </div>
                </div>
            </ChildContent>
        </Modal>
    }
</div>

@code {
    private bool _loading = true;
    private bool _showForm;
    private string _searchMode = "GG";
    private string _searchTerm = string.Empty;
    private string _vehicleLabel = string.Empty;
    private List<VehicleLookupDto> _vehicleMatches = new();
    private int? _selectedVmfCode;
    private List<LogbookDto> _logbooks = new();
    private List<SiteResponseDto> _sites = new();
    private LogbookDto _form = new();
    private LogbookDto? _editing;
    private int _page = 1;
    private readonly int _pageSize = 12;

    private IEnumerable<LogbookDto> PagedLogbooks => _logbooks.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_logbooks.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadSites();
        _loading = false;
    }

    private async Task LoadSites()
    {
        _sites = await SiteService.GetAllAsync();
    }

    private async Task SearchLogbooks()
    {
        _loading = true;
        _logbooks = new List<LogbookDto>();
        _vehicleLabel = string.Empty;
        try
        {
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var searchTerm = _searchTerm.Trim();
                var matches = await VehicleLookupService.SearchAsync(searchTerm);
                _vehicleMatches = FilterVehicleMatches(matches, searchTerm, _searchMode);
                if (_vehicleMatches.All(vehicle => vehicle.VmfCode != _selectedVmfCode))
                {
                    _selectedVmfCode = null;
                }

            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSelectedVehicleLogbooksAsync()
    {
        _loading = true;
        _logbooks = new List<LogbookDto>();
        _vehicleLabel = string.Empty;
        try
        {
            var selectedVehicle = _vehicleMatches.FirstOrDefault(x => x.VmfCode == _selectedVmfCode);
            if (selectedVehicle == null || selectedVehicle.VmfCode <= 0)
            {
                return;
            }

            _vehicleLabel = VehicleOptionLabel(selectedVehicle);
            var all = await LogbookService.GetAllAsync<LogbookDto>();
            _logbooks = all.Where(l => l.vmf_code == selectedVehicle.VmfCode).ToList();
            _page = 1;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void PrepareAdd()
    {
        _editing = null;
        _form = new LogbookDto();
        _showForm = true;
    }

    private void EditLogbook(LogbookDto logbook)
    {
        _editing = logbook;
        _form = new LogbookDto
        {
            logbookcode = logbook.logbookcode,
            vmf_code = logbook.vmf_code,
            begin_num = logbook.begin_num,
            end_num = logbook.end_num,
            handout_date = logbook.handout_date,
            site_code = logbook.site_code,
            lb_receiver_name = logbook.lb_receiver_name,
            lb_tel_num = logbook.lb_tel_num,
            lb_comment = logbook.lb_comment
        };
        _showForm = true;
    }

    private async Task SaveLogbook()
    {
        try
        {
            if (_editing == null)
            {
                _form.vmf_code ??= ResolveVmfCode();
                await LogbookService.CreateAsync(_form);
            }
            else
            {
                await LogbookService.UpdateAsync(_form.logbookcode, _form);
            }

            _showForm = false;
            await SearchLogbooks();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
    }

    private int? ResolveVmfCode()
    {
        if (_selectedVmfCode.HasValue && _selectedVmfCode.Value > 0)
        {
            return _selectedVmfCode.Value;
        }

        return null;
    }

    private async Task HideForm()
    {
        _showForm = false;
        await InvokeAsync(StateHasChanged);
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string VehicleOptionLabel(VehicleLookupDto vehicle)
    {
        var gg = ValueOrDash(vehicle.GGNumber);
        var reg = ValueOrDash(vehicle.RegistrationNumber);
        return $"{gg} / {reg} ({vehicle.VmfCode})";
    }

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static List<VehicleLookupDto> FilterVehicleMatches(List<VehicleLookupDto> matches, string keyword, string searchMode)
    {
        var query = keyword.Trim();
        var isGp = string.Equals(searchMode, "GP", StringComparison.OrdinalIgnoreCase);

        return matches
            .Where(v => isGp
                ? !string.IsNullOrWhiteSpace(v.RegistrationNumber) && v.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase)
                : !string.IsNullOrWhiteSpace(v.GGNumber) && v.GGNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(v => isGp
                ? string.Equals(v.RegistrationNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase)
                : string.Equals(v.GGNumber?.Trim(), query, StringComparison.OrdinalIgnoreCase))
            .ThenBy(v => v.VmfCode)
            .ToList();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        _vehicleMatches = new();
        _selectedVmfCode = null;
        _logbooks = new();
        _vehicleLabel = string.Empty;
        _page = 1;
    }

    private static string FormatDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("yyyy-MM-dd") : string.Empty;
}
