@using FIS.Web.Components.Shared
@page "/log-books/help"
@rendermode InteractiveServer

<PageTitle>Logbook Help - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-help-circle"></i>
            Logbook Maintenance Information / Help
        </h1>
        <p class="page-description">Legacy help placeholder.</p>
    </div>
</div>

<div class="page-content">
    <div class="empty-state">
        <i class="bx bx-book"></i>
        <h3>Help content pending</h3>
        <p>This page will mirror Logbook/Doc/Doc_logbooks.htm.</p>
    </div>

    <LegacyEndpointActionPanel
        LegacyPath="Logbook/Doc/Doc_Logbooks.htm"
        Endpoint="api/logbook/help"
        HttpMethod="GET"
        ButtonText="Test Logbook Help Endpoint"
        ReportType="logbook-help" />

</div>
