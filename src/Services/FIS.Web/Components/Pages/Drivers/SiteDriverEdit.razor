@page "/drivers/site-drivers/edit"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Drivers
@using FIS.Web.Models
@using FIS.Web.Services
@inject DriverApiService DriverService
@inject DriverLicenceApiService DriverLicenceService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService
@inject NavigationManager Navigation

<PageTitle>@PageTitleText - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            @PageTitleText
        </h1>
        <p class="page-description">Capture site driver details in the same sequence as the legacy maintenance screen.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="@DriverManagementNavigation.SiteDrivers(DepartmentCode, SiteCode)">
            <i class="bx bx-arrow-back"></i>
            Back
        </a>
    </div>
</div>

<div class="page-content">
    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading site driver details...</p>
        </div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-header">
                <h2>Site Driver Details</h2>
            </div>
            <div class="form-card-body">
                @if (_site is not null || _department is not null)
                {
                    <div class="alert alert-info fis-mb-1">
                        <i class="bx bx-map"></i>
                        <span>@ContextSummary</span>
                    </div>
                }

                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">First Name</label>
                        <input class="form-input" @bind="_model.driver_firstname" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Surname</label>
                        <input class="form-input" @bind="_model.driver_surname" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Persal Number</label>
                        <input class="form-input" @bind="_model.driver_persalnumber" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">South African ID</label>
                        <input class="form-input"
                               @bind="_model.driver_SA_id"
                               @bind:after='() => ClearValidationError(nameof(DriverDto.driver_SA_id))'
                               maxlength="13"
                               inputmode="numeric" />
                        <div class="form-hint">13 digits. Local validation checks the embedded birth date and checksum.</div>
                        @if (GetValidationError(nameof(DriverDto.driver_SA_id)) is { } saIdError)
                        {
                            <div class="form-error">@saIdError</div>
                        }
                    </div>
                    <div class="form-field">
                        <label class="form-label">Passport Number</label>
                        <input class="form-input"
                               @bind="_model.driver_passportnumber"
                               @bind:after='() => ClearValidationError(nameof(DriverDto.driver_passportnumber))'
                               autocapitalize="characters" />
                        <div class="form-hint">Passport numbers may contain letters and numbers; no fixed length is enforced here.</div>
                        @if (GetValidationError(nameof(DriverDto.driver_passportnumber)) is { } passportError)
                        {
                            <div class="form-error">@passportError</div>
                        }
                    </div>
                    <div class="form-field">
                        <label class="form-label">Contact Number</label>
                        <input class="form-input" @bind="_model.driver_contractnumber" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Licence Number</label>
                        <input class="form-input"
                               @bind="_model.driver_licence_number"
                               @bind:after='() => ClearValidationError(nameof(DriverDto.driver_licence_number))'
                               maxlength="12"
                               autocapitalize="characters" />
                        <div class="form-hint">Format: 8 digits followed by 4 letters, for example 12345678ABCD.</div>
                        @if (GetValidationError(nameof(DriverDto.driver_licence_number)) is { } licenceError)
                        {
                            <div class="form-error">@licenceError</div>
                        }
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Issue Date</label>
                        <InputDate class="form-input" @bind-Value="_model.driver_licence_issuedate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Last Verified Date</label>
                        <InputDate class="form-input" @bind-Value="_model.driver_licence_lastVerifiedDate" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Driver has PDP</label>
                        <label class="form-label form-checkbox">
                            <input type="checkbox" @bind="_model.driver_hasPDP" />
                            <span>PDP recorded</span>
                        </label>
                    </div>
                    <div class="form-field">
                        <label class="form-label">PDP Expiry Date</label>
                        <InputDate class="form-input" @bind-Value="_model.driver_PDP_ExpiryDate" disabled="@(!_model.driver_hasPDP)" />
                    </div>
                    <div class="form-field">
                        <label class="form-label">Licence Expiry Date</label>
                        <InputDate class="form-input" @bind-Value="_model.driver_licence_ExpiryDate" />
                    </div>
                    <div class="form-field form-group-full">
                        <label class="form-label">Driver Licence Type</label>
                        <select class="form-select" @bind="_model.driver_licence_type_id">
                            <option value="0">Select driver licence type</option>
                            @foreach (var licence in _driverLicences.OrderBy(item => item.description))
                            {
                                <option value="@licence.licence_code">@(string.IsNullOrWhiteSpace(licence.description) ? $"Licence {licence.licence_code}" : $"{licence.description} ({licence.licence_code})")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save Changes")
                    </button>
                    <a class="btn btn-secondary" href="@DriverManagementNavigation.SiteDrivers(DepartmentCode, SiteCode)">Cancel</a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-error fis-mt-1">
                <i class="bx bx-error-circle"></i>
                <span>@_errorMessage</span>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "departmentCode")]
    public string? DepartmentCodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "siteCode")]
    public string? SiteCodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "driverCode")]
    public string? DriverCodeQuery { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private readonly Dictionary<string, string> _validationErrors = new(StringComparer.OrdinalIgnoreCase);
    private DriverDto _model = NewDriver();
    private DepartmentDto? _department;
    private SiteResponseDto? _site;
    private List<DriverLicenceDto> _driverLicences = new();
    private short? DepartmentCode => DriverManagementNavigation.ParseNullableShort(DepartmentCodeQuery);
    private short? SiteCode => DriverManagementNavigation.ParseNullableShort(SiteCodeQuery);
    private int? DriverCode => DriverManagementNavigation.ParseNullableInt(DriverCodeQuery);

    private string PageTitleText => DriverCode.HasValue ? "Edit Site Driver" : "Add Site Driver";
    private string ContextSummary => $"{DriverManagementNavigation.BuildDepartmentLabel(_department)} / {DriverManagementNavigation.BuildSiteLabel(_site)}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        _validationErrors.Clear();

        try
        {
            if (!SiteCode.HasValue)
            {
                _errorMessage = "Select a department and site before editing site drivers.";
                return;
            }

            _site = await SiteService.GetByIdAsync(SiteCode.Value);
            var resolvedDepartmentCode = DepartmentCode ?? _site?.DepartmentCode;
            _department = resolvedDepartmentCode.HasValue
                ? await DepartmentService.GetDepartmentAsync(resolvedDepartmentCode.Value)
                : null;
            _driverLicences = await DriverLicenceService.GetAllAsync();

            if (DriverCode.HasValue)
            {
                var existing = await DriverService.GetDriverAsync(DriverCode.Value);
                if (existing is null)
                {
                    _errorMessage = "The selected site driver could not be loaded.";
                    _model = NewDriver();
                    return;
                }

                _model = existing;
            }
            else
            {
                _model = NewDriver();
                _model.site_code = SiteCode.Value;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load site driver details: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        NormalizeModel();

        if (!SiteCode.HasValue)
        {
            _errorMessage = "Select a department and site before editing site drivers.";
            return;
        }

        if (!Validate())
        {
            return;
        }

        _saving = true;
        _model.site_code = SiteCode.Value;
        _model.driver_active = true;

        try
        {
            var success = DriverCode.HasValue
                ? await DriverService.UpdateDriverAsync(DriverCode.Value, _model)
                : await DriverService.CreateDriverAsync(_model);

            if (!success)
            {
                _errorMessage = DriverCode.HasValue
                    ? "Unable to update site driver."
                    : "Unable to create site driver.";
                return;
            }

            Navigation.NavigateTo(DriverManagementNavigation.SiteDrivers(DepartmentCode, SiteCode));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to save site driver: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private bool Validate()
    {
        _validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(_model.driver_firstname))
        {
            AddValidationError(nameof(DriverDto.driver_firstname), "The first name is required.");
        }

        if (string.IsNullOrWhiteSpace(_model.driver_surname))
        {
            AddValidationError(nameof(DriverDto.driver_surname), "The surname is required.");
        }

        var hasSouthAfricanId = !string.IsNullOrWhiteSpace(_model.driver_SA_id);
        var hasPassportNumber = !string.IsNullOrWhiteSpace(_model.driver_passportnumber);

        if (!hasSouthAfricanId && !hasPassportNumber)
        {
            const string identityMessage = "Either a passport number or South African ID number must be specified.";
            AddValidationError(nameof(DriverDto.driver_SA_id), identityMessage);
            AddValidationError(nameof(DriverDto.driver_passportnumber), identityMessage);
        }
        else
        {
            if (DriverFieldValidation.ValidateSouthAfricanId(_model.driver_SA_id) is { } saIdError)
            {
                AddValidationError(nameof(DriverDto.driver_SA_id), saIdError);
            }

            if (DriverFieldValidation.ValidatePassportNumber(_model.driver_passportnumber) is { } passportError)
            {
                AddValidationError(nameof(DriverDto.driver_passportnumber), passportError);
            }
        }

        if (!_model.driver_licence_issuedate.HasValue)
        {
            AddValidationError(nameof(DriverDto.driver_licence_issuedate), "The licence issue date is required.");
        }

        if (!_model.driver_licence_lastVerifiedDate.HasValue)
        {
            AddValidationError(nameof(DriverDto.driver_licence_lastVerifiedDate), "The licence last verified date is required.");
        }

        if (DriverFieldValidation.ValidateLicenceNumber(_model.driver_licence_number) is { } licenceError)
        {
            AddValidationError(nameof(DriverDto.driver_licence_number), licenceError);
        }

        if (_model.driver_hasPDP && !_model.driver_PDP_ExpiryDate.HasValue)
        {
            AddValidationError(nameof(DriverDto.driver_PDP_ExpiryDate), "The PDP expiry date is required when the driver has PDP.");
        }

        if (_model.driver_licence_type_id <= 0)
        {
            AddValidationError(nameof(DriverDto.driver_licence_type_id), "The driver licence type is required.");
        }

        _errorMessage = _validationErrors.Count == 0
            ? null
            : "Correct the highlighted validation errors before saving.";

        return _validationErrors.Count == 0;
    }

    private static DriverDto NewDriver()
        => new()
        {
            driver_active = true,
            driver_hasPDP = false,
            driver_licence_issuedate = DateTime.Today,
            driver_licence_lastVerifiedDate = DateTime.Today
        };

    private void NormalizeModel()
    {
        _model.driver_firstname = NormalizeText(_model.driver_firstname);
        _model.driver_surname = NormalizeText(_model.driver_surname);
        _model.driver_persalnumber = NormalizeText(_model.driver_persalnumber);
        _model.driver_contractnumber = NormalizeText(_model.driver_contractnumber);
        _model.driver_SA_id = DriverFieldValidation.NormalizeSouthAfricanId(_model.driver_SA_id);
        _model.driver_passportnumber = DriverFieldValidation.NormalizePassportNumber(_model.driver_passportnumber);
        _model.driver_licence_number = DriverFieldValidation.NormalizeLicenceNumber(_model.driver_licence_number);
    }

    private void AddValidationError(string fieldName, string message)
        => _validationErrors[fieldName] = message;

    private void ClearValidationError(string fieldName)
    {
        if (_validationErrors.Remove(fieldName) && _validationErrors.Count == 0)
        {
            _errorMessage = null;
        }
    }

    private string? GetValidationError(string fieldName)
        => _validationErrors.TryGetValue(fieldName, out var error) ? error : null;

    private static string? NormalizeText(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
