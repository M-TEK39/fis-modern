@page "/drivers/authorisers"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Drivers
@using FIS.Web.Models
@using FIS.Web.Services
@inject UserApiService UserApiService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService

<PageTitle>Authoriser Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-user-check"></i>
            Authoriser Management
        </h1>
        <p class="page-description">Manage authorisers for the selected department and site.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="@DriverManagementNavigation.AuthoriserEdit(DepartmentCode, SiteCode)">
            <i class="bx bx-plus"></i>
            Add Authoriser
        </a>
        <a class="btn btn-secondary" href="@DriverManagementNavigation.Index(DepartmentCode, SiteCode)">
            <i class="bx bx-arrow-back"></i>
            Back
        </a>
    </div>
</div>

<div class="page-content">
    @if (_site is not null || _department is not null)
    {
        <div class="alert alert-info fis-mb-1">
            <i class="bx bx-map"></i>
            <span>@ContextSummary</span>
        </div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading authorisers...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error-circle"></i>
            <span>@_errorMessage</span>
        </div>
    }
    else if (_authorisers.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-user-x"></i>
            <h3>No authorisers found</h3>
            <p>Add the first authoriser for this site to match the legacy workflow.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_authorisers.Count authoriser(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Surname</th>
                            <th>Persal Number</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var authoriser in _authorisers)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(authoriser.FirstName) ? "-" : authoriser.FirstName)</td>
                                <td>@(string.IsNullOrWhiteSpace(authoriser.LastName) ? "-" : authoriser.LastName)</td>
                                <td>@(authoriser.PersalNumber?.ToString() ?? "-")</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn-icon btn-icon-edit"
                                           href="@DriverManagementNavigation.AuthoriserEdit(DepartmentCode, SiteCode, authoriser.UserAccessCode)"
                                           aria-label="Edit authoriser">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button class="btn-icon btn-icon-delete"
                                                type="button"
                                                aria-label="Delete authoriser"
                                                @onclick="() => DeleteAuthoriserAsync(authoriser.UserAccessCode)">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "departmentCode")]
    public string? DepartmentCodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "siteCode")]
    public string? SiteCodeQuery { get; set; }

    private bool _loading = true;
    private string? _errorMessage;
    private List<UserProfileDto> _authorisers = new();
    private DepartmentDto? _department;
    private SiteResponseDto? _site;
    private short? DepartmentCode => DriverManagementNavigation.ParseNullableShort(DepartmentCodeQuery);
    private short? SiteCode => DriverManagementNavigation.ParseNullableShort(SiteCodeQuery);

    private string ContextSummary => $"{DriverManagementNavigation.BuildDepartmentLabel(_department)} / {DriverManagementNavigation.BuildSiteLabel(_site)}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!SiteCode.HasValue)
        {
            _errorMessage = "Select a department and site before opening Authoriser Management.";
            _authorisers = new();
            _department = null;
            _site = null;
            _loading = false;
            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            _site = await SiteService.GetByIdAsync(SiteCode.Value);
            var resolvedDepartmentCode = DepartmentCode ?? _site?.DepartmentCode;
            _department = resolvedDepartmentCode.HasValue
                ? await DepartmentService.GetDepartmentAsync(resolvedDepartmentCode.Value)
                : null;

            _authorisers = (await UserApiService.GetProfilesBySiteAsync(SiteCode.Value))
                .OrderBy(profile => profile.FirstName)
                .ThenBy(profile => profile.LastName)
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load authorisers: {ex.Message}";
            _authorisers = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAuthoriserAsync(short userAccessCode)
    {
        _errorMessage = null;
        try
        {
            await UserApiService.DeleteAsync(userAccessCode);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to delete authoriser: {ex.Message}";
        }
    }
}
