@page "/drivers"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Drivers
@using FIS.Web.Models
@using FIS.Web.Services
@inject DepartmentApiService DepartmentService
@inject SiteApiService SiteService
@inject DriverApiService DriverService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Driver &amp; Authoriser Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Driver &amp; Authoriser Management
        </h1>
        <p class="page-description">Match the legacy Driver and Authoriser Management flow by selecting a department and site first.</p>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Driver and Authoriser Management</h2>
        </div>
        <div class="form-card-body">
            @if (_loading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading departments and sites...</p>
                </div>
            }
            else
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label">Department</label>
                        <select class="form-select" @bind="_selectedDepartmentCode" @bind:after="OnDepartmentChangedAsync">
                            <option value="">Select department</option>
                            @foreach (var department in _departments.OrderBy(item => item.department_description))
                            {
                                <option value="@department.department_code">@DriverManagementNavigation.BuildDepartmentLabel(department)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Site</label>
                        <select class="form-select" @bind="_selectedSiteCode" disabled="@(!_selectedDepartmentCode.HasValue)">
                            <option value="">@(_selectedDepartmentCode.HasValue ? "Select site" : "Select department first")</option>
                            @foreach (var site in AvailableSites)
                            {
                                <option value="@site.SiteCode">@DriverManagementNavigation.BuildSiteLabel(site)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_selectedSiteCode.HasValue)
                {
                    <div class="alert alert-info fis-mt-1">
                        <i class="bx bx-info-circle"></i>
                        <span>@SelectionSummary</span>
                    </div>
                }

                <div class="form-actions">
                    <button class="btn btn-primary" type="button" @onclick="OpenAuthorisers" disabled="@(!_selectedSiteCode.HasValue)">
                        Authoriser Management
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="OpenSiteDrivers" disabled="@(!_selectedSiteCode.HasValue)">
                        Site Driver Management
                    </button>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error fis-mt-1">
            <i class="bx bx-error-circle"></i>
            <span>@_errorMessage</span>
        </div>
    }

    <DataPreviewTable Title="Driver Preview"
                      SearchPlaceholder="Search driver name, licence, Persal, contract, site..."
                      EmptyMessage="No drivers match the current search or filter."
                      EmptyIcon="bx bx-id-card"
                      IsLoading="_previewLoading"
                      Columns="_columns"
                      Rows="_rows"
                      Filters="_filters" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "departmentCode")]
    public string? DepartmentCodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "siteCode")]
    public string? SiteCodeQuery { get; set; }

    private bool _loading = true;
    private bool _previewLoading = true;
    private string? _errorMessage;
    private List<DepartmentDto> _departments = new();
    private List<SiteResponseDto> _sites = new();
    private List<Dictionary<string, string?>> _rows = new();
    private short? _selectedDepartmentCode;
    private short? _selectedSiteCode;
    private short? DepartmentCode => DriverManagementNavigation.ParseNullableShort(DepartmentCodeQuery);
    private short? SiteCode => DriverManagementNavigation.ParseNullableShort(SiteCodeQuery);

    private IEnumerable<SiteResponseDto> AvailableSites => _sites
        .Where(site => !_selectedDepartmentCode.HasValue || site.DepartmentCode == _selectedDepartmentCode.Value)
        .OrderBy(site => site.Description);

    private readonly IReadOnlyList<DataPreviewColumn> _columns =
    [
        new("name", "Driver"),
        new("site", "Site"),
        new("licence", "Licence No."),
        new("licenceExpiry", "Licence Expiry"),
        new("pdp", "PDP"),
        new("status", "Status")
    ];

    private readonly IReadOnlyList<DataPreviewFilter> _filters =
    [
        new("Active drivers", "status", "Active"),
        new("Inactive drivers", "status", "Inactive"),
        new("Drivers with PDP", "pdpStatus", "PDP"),
        new("Licence expiry captured", "licenceStatus", "Expiry Captured")
    ];

    private string SelectionSummary
    {
        get
        {
            var department = _departments.FirstOrDefault(item => item.department_code == _selectedDepartmentCode);
            var site = _sites.FirstOrDefault(item => item.SiteCode == _selectedSiteCode);
            return $"Selected {DriverManagementNavigation.BuildDepartmentLabel(department)} / {DriverManagementNavigation.BuildSiteLabel(site)}.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _departments = await DepartmentService.GetDepartmentsAsync();
            _sites = await SiteService.GetAllAsync();
            ApplyIncomingSelection();
            await LoadPreviewAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to load driver and authoriser selections.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _loading = false;
            _previewLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        ApplyIncomingSelection();
    }

    private void ApplyIncomingSelection()
    {
        if (DepartmentCode.HasValue)
        {
            _selectedDepartmentCode = DepartmentCode.Value;
        }

        if (SiteCode.HasValue)
        {
            _selectedSiteCode = SiteCode.Value;
            var selectedSite = _sites.FirstOrDefault(site => site.SiteCode == SiteCode.Value);
            if (selectedSite?.DepartmentCode is short departmentCode)
            {
                _selectedDepartmentCode ??= departmentCode;
            }
        }

        if (_selectedSiteCode.HasValue && !AvailableSites.Any(site => site.SiteCode == _selectedSiteCode.Value))
        {
            _selectedSiteCode = null;
        }
    }

    private Task OnDepartmentChangedAsync()
    {
        if (_selectedSiteCode.HasValue && !AvailableSites.Any(site => site.SiteCode == _selectedSiteCode.Value))
        {
            _selectedSiteCode = null;
        }

        return Task.CompletedTask;
    }

    private void OpenAuthorisers()
    {
        Navigation.NavigateTo(DriverManagementNavigation.Authorisers(_selectedDepartmentCode, _selectedSiteCode));
    }

    private void OpenSiteDrivers()
    {
        Navigation.NavigateTo(DriverManagementNavigation.SiteDrivers(_selectedDepartmentCode, _selectedSiteCode));
    }

    private async Task LoadPreviewAsync()
    {
        _previewLoading = true;
        var drivers = await DriverService.GetDriversAsync();
        _rows = drivers
            .OrderBy(item => item.driver_surname)
            .ThenBy(item => item.driver_firstname)
            .Select(item => new Dictionary<string, string?>
            {
                ["name"] = $"{item.driver_surname}, {item.driver_firstname}".Trim(' ', ','),
                ["site"] = item.site_code.ToString(),
                ["licence"] = item.driver_licence_number,
                ["licenceExpiry"] = FormatDate(item.driver_licence_ExpiryDate),
                ["pdp"] = item.driver_hasPDP ? "Yes" : "No",
                ["status"] = item.driver_active ? "Active" : "Inactive",
                ["pdpStatus"] = item.driver_hasPDP ? "PDP" : "No PDP",
                ["licenceStatus"] = item.driver_licence_ExpiryDate.HasValue ? "Expiry Captured" : "No Expiry"
            })
            .ToList();
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");
}
