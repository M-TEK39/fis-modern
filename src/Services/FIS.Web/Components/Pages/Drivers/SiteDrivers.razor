@page "/drivers/site-drivers"
@rendermode InteractiveServer
@using FIS.Web.Components.Pages.Drivers
@using FIS.Web.Models
@using FIS.Web.Services
@inject DriverApiService DriverService
@inject SiteApiService SiteService
@inject DepartmentApiService DepartmentService

<PageTitle>Site Driver Management - Fleet Information System</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx bx-id-card"></i>
            Site Driver Management
        </h1>
        <p class="page-description">Maintain site driver records for the selected department and site.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="@DriverManagementNavigation.SiteDriverEdit(DepartmentCode, SiteCode)">
            <i class="bx bx-plus"></i>
            Add Site Driver
        </a>
        <a class="btn btn-secondary" href="@DriverManagementNavigation.Index(DepartmentCode, SiteCode)">
            <i class="bx bx-arrow-back"></i>
            Back
        </a>
    </div>
</div>

<div class="page-content">
    @if (_site is not null || _department is not null)
    {
        <div class="alert alert-info fis-mb-1">
            <i class="bx bx-map"></i>
            <span>@ContextSummary</span>
        </div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading site drivers...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-error">
            <i class="bx bx-error-circle"></i>
            <span>@_errorMessage</span>
        </div>
    }
    else if (_drivers.Count == 0)
    {
        <div class="empty-state">
            <i class="bx bx-user-plus"></i>
            <h3>No site drivers found</h3>
            <p>Add the first site driver for this site to match the legacy maintenance screen.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <div class="table-header">
                <span class="table-title">@_drivers.Count site driver(s)</span>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Surname</th>
                            <th>South African ID</th>
                            <th>Passport Number</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var driver in _drivers)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(driver.driver_firstname) ? "-" : driver.driver_firstname)</td>
                                <td>@(string.IsNullOrWhiteSpace(driver.driver_surname) ? "-" : driver.driver_surname)</td>
                                <td>@(string.IsNullOrWhiteSpace(driver.driver_SA_id) ? "-" : driver.driver_SA_id)</td>
                                <td>@(string.IsNullOrWhiteSpace(driver.driver_passportnumber) ? "-" : driver.driver_passportnumber)</td>
                                <td class="actions-column">
                                    <div class="table-actions">
                                        <a class="btn-icon btn-icon-edit"
                                           href="@DriverManagementNavigation.SiteDriverEdit(DepartmentCode, SiteCode, driver.site_driver_code)"
                                           aria-label="Edit site driver">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button class="btn-icon btn-icon-delete"
                                                type="button"
                                                aria-label="Delete site driver"
                                                @onclick="() => DeleteDriverAsync(driver.site_driver_code)">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "departmentCode")]
    public string? DepartmentCodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "siteCode")]
    public string? SiteCodeQuery { get; set; }

    private bool _loading = true;
    private string? _errorMessage;
    private List<DriverDto> _drivers = new();
    private DepartmentDto? _department;
    private SiteResponseDto? _site;
    private short? DepartmentCode => DriverManagementNavigation.ParseNullableShort(DepartmentCodeQuery);
    private short? SiteCode => DriverManagementNavigation.ParseNullableShort(SiteCodeQuery);

    private string ContextSummary => $"{DriverManagementNavigation.BuildDepartmentLabel(_department)} / {DriverManagementNavigation.BuildSiteLabel(_site)}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!SiteCode.HasValue)
        {
            _errorMessage = "Select a department and site before opening Site Driver Management.";
            _drivers = new();
            _department = null;
            _site = null;
            _loading = false;
            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            _site = await SiteService.GetByIdAsync(SiteCode.Value);
            var resolvedDepartmentCode = DepartmentCode ?? _site?.DepartmentCode;
            _department = resolvedDepartmentCode.HasValue
                ? await DepartmentService.GetDepartmentAsync(resolvedDepartmentCode.Value)
                : null;

            _drivers = (await DriverService.GetDriversAsync())
                .Where(driver => driver.site_code == SiteCode.Value)
                .OrderBy(driver => driver.driver_firstname)
                .ThenBy(driver => driver.driver_surname)
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load site drivers: {ex.Message}";
            _drivers = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteDriverAsync(int driverCode)
    {
        _errorMessage = null;
        try
        {
            var success = await DriverService.DeleteDriverAsync(driverCode);
            if (!success)
            {
                _errorMessage = "Unable to delete site driver.";
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to delete site driver: {ex.Message}";
        }
    }
}
