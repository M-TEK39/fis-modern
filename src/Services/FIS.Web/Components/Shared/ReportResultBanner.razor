@using Microsoft.AspNetCore.Components

<div class="report-result-banner">
    <div class="report-result-banner-info">
        <i class="bx bx-table"></i>
        <span>Showing legacy-style report results</span>
        @if (RecordCount.HasValue)
        {
            <span class="report-result-count">@RecordCount.Value.ToString("N0") record(s)</span>
        }
    </div>
    <button type="button" class="btn btn-secondary btn-sm" @onclick="HandleBack">
        <i class="bx bx-arrow-back"></i>
        Back to Filters
    </button>
</div>

@code {
    /// <summary>The base route (without query string) to navigate back to filter view.</summary>
    [Parameter, EditorRequired]
    public string FiltersUrl { get; set; } = string.Empty;

    /// <summary>Optional record count shown in the banner.</summary>
    [Parameter]
    public int? RecordCount { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void HandleBack()
    {
        Navigation.NavigateTo(FiltersUrl);
    }
}
