@namespace FIS.Web.Components.Shared
@inject NavigationManager NavigationManager

<div class="table-container">
    <div class="table-header">
        <span class="table-title">@Title</span>
        <div class="table-controls">
            @if (Filters.Count > 0)
            {
                <select class="form-select" value="@_activeFilter" @onchange="OnFilterChanged" aria-label="@($"{Title} filter")">
                    <option value="">All records</option>
                    @foreach (var filter in Filters)
                    {
                        <option value="@GetFilterValue(filter)">@filter.Label</option>
                    }
                </select>
            }
        </div>
    </div>

    <div class="search-bar">
        <div class="search-input-wrapper">
            <i class="bx bx-search"></i>
            <input type="search"
                   class="search-input"
                   value="@_searchTerm"
                   @oninput="OnSearchInput"
                   placeholder="@SearchPlaceholder" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button" class="search-clear" @onclick="ClearSearch" aria-label="Clear search">
                    <i class="bx bx-x"></i>
                </button>
            }
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading preview data...</p>
        </div>
    }
    else if (FilteredRows.Count == 0)
    {
        <div class="empty-state">
            <i class="@EmptyIcon"></i>
            <h3>No preview records found</h3>
            <p>@EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        @foreach (var column in Columns)
                        {
                            <th>@column.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PagedRows)
                    {
                        <tr class="@GetRowClass(row)"
                            role="@GetRowRole(row)"
                            tabindex="@GetRowTabIndex(row)"
                            @onclick="() => NavigateToRow(row)"
                            @onkeydown="args => NavigateToRowFromKeyboard(args, row)">
                            @foreach (var column in Columns)
                            {
                                <td>@GetValue(row, column.Key)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button type="button" class="pagination-btn" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
            <div class="pagination-info">Page @_page of @TotalPages</div>
            <button type="button" class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
        </div>
        <div class="pagination-meta">Total records: @FilteredRows.Count | Page size: @PageSize</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Data Preview";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search preview records...";
    [Parameter] public string EmptyMessage { get; set; } = "Adjust search or filters to find matching records.";
    [Parameter] public string EmptyIcon { get; set; } = "bx bx-table";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int PageSize { get; set; } = 12;
    [Parameter] public IReadOnlyList<DataPreviewColumn> Columns { get; set; } = [];
    [Parameter] public IReadOnlyList<Dictionary<string, string?>> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<DataPreviewFilter> Filters { get; set; } = [];

    private string _searchTerm = "";
    private string _activeFilter = "";
    private int _page = 1;

    private List<Dictionary<string, string?>> FilteredRows
    {
        get
        {
            IEnumerable<Dictionary<string, string?>> rows = Rows;

            if (!string.IsNullOrWhiteSpace(_activeFilter))
            {
                var filter = ResolveFilter(_activeFilter);
                if (filter is not null)
                {
                    rows = rows.Where(row => string.Equals(
                        GetValue(row, filter.ColumnKey),
                        filter.Value,
                        StringComparison.OrdinalIgnoreCase));
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var search = _searchTerm.Trim();
                rows = rows.Where(row => Columns.Any(column =>
                    GetValue(row, column.Key).Contains(search, StringComparison.OrdinalIgnoreCase)));
            }

            return rows.ToList();
        }
    }

    private IEnumerable<Dictionary<string, string?>> PagedRows => FilteredRows
        .Skip((_page - 1) * PageSize)
        .Take(PageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count / (double)PageSize));

    private static string? GetRowHref(Dictionary<string, string?> row)
    {
        return row.TryGetValue("_href", out var href) && !string.IsNullOrWhiteSpace(href)
            ? href
            : null;
    }

    private static string GetRowClass(Dictionary<string, string?> row)
    {
        return GetRowHref(row) is null ? "" : "clickable-row";
    }

    private static string? GetRowRole(Dictionary<string, string?> row)
    {
        return GetRowHref(row) is null ? null : "link";
    }

    private static int? GetRowTabIndex(Dictionary<string, string?> row)
    {
        return GetRowHref(row) is null ? null : 0;
    }

    private void NavigateToRow(Dictionary<string, string?> row)
    {
        var href = GetRowHref(row);
        if (!string.IsNullOrWhiteSpace(href))
        {
            NavigationManager.NavigateTo(href);
        }
    }

    private void NavigateToRowFromKeyboard(KeyboardEventArgs args, Dictionary<string, string?> row)
    {
        if (args.Key is "Enter" or " ")
        {
            NavigateToRow(row);
        }
    }

    private static string GetValue(Dictionary<string, string?> row, string key)
    {
        return row.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-";
    }

    private static string GetFilterValue(DataPreviewFilter filter)
    {
        return $"{filter.ColumnKey}|{filter.Value}";
    }

    private DataPreviewFilter? ResolveFilter(string encoded)
    {
        return Filters.FirstOrDefault(filter => string.Equals(GetFilterValue(filter), encoded, StringComparison.Ordinal));
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnFilterChanged(ChangeEventArgs args)
    {
        _activeFilter = args.Value?.ToString() ?? "";
        _page = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = "";
        _page = 1;
    }

    private void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }
}
