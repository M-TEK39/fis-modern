@using FIS.Web.Models
@using FIS.Web.Services
@using System.Text
@inject FinanceApiService FinanceService

<div class="form-section" style="margin-top: 1rem;">
    <h3 class="form-section-title">
        <i class="bx bx-link-external"></i>
        API Wiring
    </h3>
    <p class="form-hint">
        Legacy source: @LegacyPath
    </p>
    <div class="contract-action-group">
        <button class="btn btn-primary btn-sm" @onclick="RunAsync" disabled="@_running">
            @(_running ? "Running..." : ButtonText)
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert @(_error ? "alert-error" : "alert-success")" style="margin-top: 0.75rem;">
            @_status
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_responseBody))
    {
        <pre style="margin-top: 0.75rem; white-space: pre-wrap; max-height: 16rem; overflow: auto;">@_responseBody</pre>
    }
</div>

@code {
    [Parameter] public string LegacyPath { get; set; } = string.Empty;
    [Parameter] public string Endpoint { get; set; } = string.Empty;
    [Parameter] public string HttpMethod { get; set; } = "GET";
    [Parameter] public string ButtonText { get; set; } = "Run";
    [Parameter] public string ReportType { get; set; } = "legacy-endpoint";

    private bool _running;
    private bool _error;
    private string _status = string.Empty;
    private string _responseBody = string.Empty;

    private async Task RunAsync()
    {
        _running = true;
        _status = string.Empty;
        _responseBody = string.Empty;
        _error = false;

        FinanceApiResult result;
        if (string.Equals(HttpMethod, "POST", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.PostActionAsync(Endpoint, BuildPayload());
        }
        else if (string.Equals(HttpMethod, "PUT", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.PutActionAsync(Endpoint, BuildPayload());
        }
        else if (string.Equals(HttpMethod, "DELETE", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.DeleteActionAsync(Endpoint);
        }
        else
        {
            result = await FinanceService.GetActionAsync(Endpoint);
        }

        _error = !result.Success;
        _status = NormalizeForDisplay(result.Message);
        _responseBody = string.IsNullOrWhiteSpace(result.ResponseBody)
            ? string.Empty
            : NormalizeForDisplay(result.ResponseBody.Length > 3000
                ? result.ResponseBody[..3000]
                : result.ResponseBody);
        _running = false;
    }

    private object BuildPayload()
        => new
        {
            reportType = ReportType,
            legacyPath = LegacyPath
        };

    private static string NormalizeForDisplay(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        var builder = new StringBuilder(value.Length);
        foreach (var ch in value)
        {
            if (char.IsControl(ch) && ch != '\r' && ch != '\n' && ch != '\t')
            {
                continue;
            }

            builder.Append(ch);
        }

        return builder.ToString();
    }
}
