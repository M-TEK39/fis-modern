@if (IsVisible)
{
    <div class="modal-overlay">
        <div class="modal-dialog @(Size == ModalSize.Large ? "modal-large" : "")">
            <div class="modal-header">
                <h3 class="modal-title">@Title</h3>
                @if (ShowCloseButton)
                {
                    <button type="button" class="modal-close" @onclick="OnCancel" aria-label="Close">
                        <i class="bx bx-x"></i>
                    </button>
                }
            </div>
            @if (ShowFooter)
            {
                if (EditContext is not null)
                {
                    <EditForm EditContext="EditContext" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        @if (ShowValidationSummary)
                        {
                            <ValidationSummary class="validation-summary" />
                        }
                        <div class="modal-body">
                            @ChildContent
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@IsSaving">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@(IsSaving || DisableSubmit)">
                                @if (IsSaving)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>@(SaveText ?? "Saving...")</span>
                                }
                                else
                                {
                                    <span>@(SubmitText ?? "Save")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
                else if (Model is not null)
                {
                    <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        @if (ShowValidationSummary)
                        {
                            <ValidationSummary class="validation-summary" />
                        }
                        <div class="modal-body">
                            @ChildContent
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@IsSaving">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@(IsSaving || DisableSubmit)">
                                @if (IsSaving)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>@(SaveText ?? "Saving...")</span>
                                }
                                else
                                {
                                    <span>@(SubmitText ?? "Save")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                        <div class="modal-body">
                            @ChildContent
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@IsSaving">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@(IsSaving || DisableSubmit)">
                                @if (IsSaving)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>@(SaveText ?? "Saving...")</span>
                                }
                                else
                                {
                                    <span>@(SubmitText ?? "Save")</span>
                                }
                            </button>
                        </div>
                    </form>
                }
            }
            else
            {
                <div class="modal-body">
                    @ChildContent
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? SubmitText { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool DisableSubmit { get; set; }
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Normal;
    [Parameter] public object? Model { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public bool ShowValidationSummary { get; set; } = true;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public enum ModalSize
    {
        Normal,
        Large
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }
}
