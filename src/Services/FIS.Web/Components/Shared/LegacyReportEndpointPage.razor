@using FIS.Web.Models
@using FIS.Web.Services
@using System.Text
@inject FinanceApiService FinanceService

<PageTitle>@($"{Title} - Fleet Information System")</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="bx @Icon"></i>
            @Title
        </h1>
        <p class="page-description">@Description</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary btn-sm" href="@BackLink">Back</a>
    </div>
</div>

<div class="page-content">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Report Action</h2>
        </div>
        <div class="form-card-body">
            <div class="contract-action-group">
                <button class="btn btn-primary btn-sm" @onclick="RunAsync" disabled="@_running">
                    @(_running ? "Running..." : ActionText)
                </button>
                <a class="btn btn-secondary btn-sm" href="@BackLink">Back to Reports</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="alert @(_error ? "alert-error" : "alert-success")" style="margin-top:1rem;">
                    @_status
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_responseBody))
            {
                <pre style="margin-top:1rem; white-space:pre-wrap; max-height:22rem; overflow:auto;">@_responseBody</pre>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Report";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string LegacyPath { get; set; } = string.Empty;
    [Parameter] public string Endpoint { get; set; } = "api/Report/universal";
    [Parameter] public string HttpMethod { get; set; } = "POST";
    [Parameter] public string ReportType { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "bx-file";
    [Parameter] public string ActionText { get; set; } = "Run";
    [Parameter] public string BackLink { get; set; } = "/reports";

    private bool _running;
    private bool _error;
    private string _status = string.Empty;
    private string _responseBody = string.Empty;

    private async Task RunAsync()
    {
        _running = true;
        _error = false;
        _status = string.Empty;
        _responseBody = string.Empty;

        FinanceApiResult result;
        if (string.Equals(HttpMethod, "GET", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.GetActionAsync(Endpoint);
        }
        else if (string.Equals(HttpMethod, "DELETE", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.DeleteActionAsync(Endpoint);
        }
        else if (string.Equals(HttpMethod, "PUT", StringComparison.OrdinalIgnoreCase))
        {
            result = await FinanceService.PutActionAsync(Endpoint, BuildPayload());
        }
        else
        {
            result = await FinanceService.PostActionAsync(Endpoint, BuildPayload());
        }

        _error = !result.Success;
        _status = NormalizeForDisplay(result.Message);
        _responseBody = string.IsNullOrWhiteSpace(result.ResponseBody)
            ? string.Empty
            : NormalizeForDisplay(result.ResponseBody.Length > 4000
                ? result.ResponseBody[..4000]
                : result.ResponseBody);
        _running = false;
    }

    private object BuildPayload()
    {
        if (string.Equals(Endpoint, "api/Report/universal", StringComparison.OrdinalIgnoreCase))
        {
            return new
            {
                reportType = string.IsNullOrWhiteSpace(ReportType) ? "legacy-report" : ReportType,
                parameters = new Dictionary<string, object?>
                {
                    ["legacyPath"] = LegacyPath,
                    ["sourcePage"] = Title
                }
            };
        }

        return new
        {
            reportType = string.IsNullOrWhiteSpace(ReportType) ? "legacy-report" : ReportType,
            legacyPath = LegacyPath,
            sourcePage = Title
        };
    }

    private static string NormalizeForDisplay(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var endpointIndex = value.IndexOf("Endpoint:", StringComparison.OrdinalIgnoreCase);
        var sanitized = endpointIndex >= 0 ? value[..endpointIndex].TrimEnd(' ', '.', '|', '-') : value;
        var builder = new StringBuilder(sanitized.Length);
        foreach (var ch in sanitized)
        {
            if (char.IsControl(ch) && ch != '\r' && ch != '\n' && ch != '\t')
            {
                continue;
            }

            builder.Append(ch);
        }

        return builder.ToString().Trim();
    }
}
