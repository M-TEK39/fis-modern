@using FIS.Web.Models
@using FIS.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ReportApiService ReportService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<ReportResultBanner FiltersUrl="@FiltersUrl" RecordCount="@_result?.TotalCount" />

@if (_loading)
{
    <div class="loading-state fis-mt-15">
        <div class="spinner"></div>
        <p>Loading legacy report grid...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-error fis-alert-bottom fis-mt-15">
        <i class="bx bx-error-circle"></i>
        <span>@_errorMessage</span>
    </div>
}
else if (_result is not null)
{
    <div class="form-card fis-mt-15">
        <div class="form-card-body">
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; justify-content:space-between;">
                <div>
                    <div style="font-weight:600;">@_result.Title</div>
                    @if (!string.IsNullOrWhiteSpace(_result.LegacyTarget))
                    {
                        <div class="text-muted">Legacy target: @_result.LegacyTarget</div>
                    }
                </div>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
                    <span class="badge @(_result.IsApproximate ? "badge-warning" : "badge-success")">@(_result.IsApproximate ? "Approximate fallback" : "Legacy-aligned result")</span>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="DownloadCsvAsync" disabled="@(_result.Rows.Count == 0)">
                        <i class="bx bx-download"></i>
                        Download CSV
                    </button>
                </div>
            </div>

            @if (_result.IsApproximate && !string.IsNullOrWhiteSpace(_result.ApproximationReason))
            {
                <div class="alert alert-info fis-alert-tight fis-alert-bottom" style="margin-top:0.75rem;">
                    <i class="bx bx-info-circle"></i>
                    <span>@_result.ApproximationReason</span>
                </div>
            }
        </div>
    </div>

    @if (_result.Columns.Count == 0 || _result.Rows.Count == 0)
    {
        <div class="empty-state fis-mt-15">
            <i class="bx bx-table"></i>
            <h3>No report rows found</h3>
            <p>The legacy-style result set returned no rows for the current filters.</p>
        </div>
    }
    else
    {
        <div class="table-container fis-mt-15">
            <div class="table-header">
                <span class="table-title">@_result.Title</span>
                <div class="table-controls">
                    <span class="text-muted">Showing @_pagedRows.Count of @_result.TotalCount row(s)</span>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            @foreach (var column in _result.Columns)
                            {
                                <th>@column.Header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _pagedRows)
                        {
                            <tr>
                                @foreach (var column in _result.Columns)
                                {
                                    <td>@ValueOrDash(GetCell(row, column.Key))</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_result.Rows.Count > PageSize)
            {
                <div class="pagination">
                    <button class="pagination-btn" @onclick="PrevPage" disabled="@(_page <= 1)">Previous</button>
                    <div class="pagination-info">Page @_page of @TotalPages</div>
                    <button class="pagination-btn" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
                <div class="pagination-meta">Total records: @_result.TotalCount | Page size: @PageSize</div>
            }
        </div>
    }
}

@code {
    private LegacyDynamicReportDto? _result;
    private bool _loading;
    private string? _errorMessage;
    private string? _lastLoadedUri;
    private int _page = 1;

    [Parameter, EditorRequired]
    public string ReportKey { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string FiltersUrl { get; set; } = string.Empty;

    [Parameter]
    public int PageSize { get; set; } = 20;

    private IReadOnlyList<Dictionary<string, string?>> _pagedRows
        => _result?.Rows.Skip((_page - 1) * PageSize).Take(PageSize).ToList() ?? [];

    private int TotalPages
        => _result is null || _result.Rows.Count == 0
            ? 1
            : Math.Max(1, (int)Math.Ceiling(_result.Rows.Count / (double)PageSize));

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        if (_lastLoadedUri == uri && _result is not null)
        {
            return;
        }

        _lastLoadedUri = uri;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        _result = null;
        _page = 1;

        try
        {
            var filters = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query)
                .ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString(), StringComparer.OrdinalIgnoreCase);

            if (filters.ContainsKey("view"))
            {
                filters.Remove("view");
            }

            _result = await ReportService.GetLegacyDynamicReportAsync(ReportKey, filters);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load the legacy-style report grid: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (_result is null || _result.Columns.Count == 0)
        {
            return;
        }

        var lines = new List<string>
        {
            string.Join(",", _result.Columns.Select(column => CsvCell(column.Header)))
        };

        foreach (var row in _result.Rows)
        {
            lines.Add(string.Join(",", _result.Columns.Select(column => CsvCell(GetCell(row, column.Key)))));
        }

        var csv = string.Join(Environment.NewLine, lines);
        var safeKey = ReportKey.Replace(' ', '-').ToLowerInvariant();
        var fileName = $"{safeKey}_{DateTime.Now:yyyyMMdd_HHmm}.csv";
        await JSRuntime.InvokeVoidAsync("fisDownload.downloadText", fileName, csv, "text/csv;charset=utf-8");
    }

    private void PrevPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    private static string? GetCell(IReadOnlyDictionary<string, string?> row, string key)
        => row.TryGetValue(key, out var value) ? value : null;

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string CsvCell(string? value)
    {
        var safe = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }
}
