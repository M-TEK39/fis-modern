@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="user-profile">
    <AuthorizeView>
        <Authorized>
            <div class="user-info">
                <span class="user-name">@context.User.Identity?.Name</span>
                <form method="post" action="/Account/Logout" class="user-profile-form">
                    <button type="submit" class="btn btn-secondary btn-sm">
                        Sign out
                    </button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <a href="/login" class="btn btn-primary btn-sm">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<style>
    .user-profile {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem 1rem;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-name {
        font-weight: 500;
        color: var(--fis-text);
    }

    .user-profile-form {
        display: inline;
    }
</style>
