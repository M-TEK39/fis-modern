@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Security.Claims
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserAccessContextService UserAccessContextService
@inject TokenService TokenService

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="GuardNavigation">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{
                        // GuardNavigation handles redirects; avoid navigation side effects during render.
                        if (context.User?.Identity?.IsAuthenticated != true)
                        {
                            <p role="status">Redirecting to login...</p>
                        }
                        else
                        {
                            <p role="alert">Access denied. You don't have permission to view this page.</p>
                        }
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private static readonly HashSet<string> PublicRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "login",
        "login/legacy",
        "login-old",
        "forgot-password",
        "users/forgot-password",
        "reset-password",
        "terms",
        "signin-oidc",
        "microsoftidentity/account/signin",
        "microsoftidentity/account/signout",
        "signedout",
        "logout"
    };

    private static readonly (string Prefix, long PermissionBit)[] ProtectedRoutePermissions =
    [
        ("/vehicles", LegacyPermissionBits.VehicleManagement),
        ("/tracking", LegacyPermissionBits.VehicleManagement),
        ("/trip-authorities", LegacyPermissionBits.VehicleManagement),
        ("/trips", LegacyPermissionBits.VehicleManagement),
        ("/trip-query", LegacyPermissionBits.VehicleManagement),
        ("/taxis", LegacyPermissionBits.VehicleManagement),
        ("/accidents", LegacyPermissionBits.VehicleManagement),
        ("/licenses", LegacyPermissionBits.VehicleManagement),
        ("/losses", LegacyPermissionBits.VehicleManagement),
        ("/call-centre", LegacyPermissionBits.VehicleManagement),
        ("/full-maintenance-lease", LegacyPermissionBits.ContractManagement),
        ("/third-party", LegacyPermissionBits.ContractManagement),
        ("/finance", LegacyPermissionBits.Financial),
        ("/auction", LegacyPermissionBits.Financial),
        ("/reports", LegacyPermissionBits.Reports),
        ("/log-books", LegacyPermissionBits.Reports),
        ("/log-sheets", LegacyPermissionBits.Reports),
        ("/monitor", LegacyPermissionBits.Reports),
        ("/job-cards", LegacyPermissionBits.Workshop),
        ("/troubleshoot", LegacyPermissionBits.UserAdministration),
    ];

    private static bool IsPublicRoute(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        var normalized = path.Trim('/').ToLowerInvariant();
        return PublicRoutes.Contains(normalized);
    }

    private async Task GuardNavigation(NavigationContext context)
    {
        await TokenService.InitializeAsync();

        if (IsPublicRoute(context.Path))
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            try
            {
                Navigation.NavigateTo("/login", replace: true);
            }
            catch (TaskCanceledException)
            {
                // Circuit/browser navigation can be canceled during disconnect; no action needed.
            }
            return;
        }

        if (RequiresPasswordChange(authState.User) && !IsPasswordChangeRoute(context.Path))
        {
            try
            {
                Navigation.NavigateTo("/change-password", replace: true);
            }
            catch (TaskCanceledException)
            {
                // Circuit/browser navigation can be canceled during disconnect; no action needed.
            }
            return;
        }

        var requiredPermission = GetRequiredPermission(context.Path);
        if (requiredPermission is null)
        {
            return;
        }

        var user = authState.User;
        var accessLevel = ResolveAccessLevelFromClaims(user);
        if (accessLevel <= 0)
        {
            var userAccessCode = TryParseInt(user.FindFirst("user_access_code")?.Value);
            var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
            accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(userAccessCode, firstName);
        }

        var allowed = (accessLevel & requiredPermission.Value) == requiredPermission.Value;
        if (allowed)
        {
            return;
        }

        try
        {
            Navigation.NavigateTo("/home", replace: true);
        }
        catch (TaskCanceledException)
        {
            // Circuit/browser navigation can be canceled during disconnect; no action needed.
        }
    }

    private static long? GetRequiredPermission(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var normalized = "/" + path.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        foreach (var rule in ProtectedRoutePermissions)
        {
            if (normalized.StartsWith(rule.Prefix, StringComparison.OrdinalIgnoreCase))
            {
                return rule.PermissionBit;
            }
        }

        return null;
    }

    private static long ResolveAccessLevelFromClaims(ClaimsPrincipal user)
    {
        var claim = user.FindFirst("access_level")?.Value;
        return long.TryParse(claim, out var parsed) ? parsed : 0;
    }

    private static int? TryParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool IsPasswordChangeRoute(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        var normalized = "/" + path.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return normalized == "/change-password";
    }

    private static bool RequiresPasswordChange(ClaimsPrincipal user)
    {
        var value = user.FindFirst("password_change_required")?.Value;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return value.Equals("true", StringComparison.OrdinalIgnoreCase)
            || value.Equals("1", StringComparison.OrdinalIgnoreCase)
            || value.Equals("y", StringComparison.OrdinalIgnoreCase)
            || value.Equals("yes", StringComparison.OrdinalIgnoreCase);
    }
}
