@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using FIS.Web.Components.Pages.Users
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="legacy-shell">
    <aside class="legacy-sidebar" aria-label="Primary navigation">
        <NavLink class="legacy-brand legacy-brand-link" href="/home" Match="NavLinkMatch.All">
            <span class="brand-short">FIS</span>
            <p class="brand-line">Gauteng Provincial Government</p>
            <p class="brand-line strong">g-FleeT Management</p>
            <p class="brand-caption">Fleet Information System</p>
        </NavLink>

        <div class="legacy-nav-container">
            <NavMenu />
        </div>

        <SidebarFooter />
    </aside>

    <div class="legacy-main">
        <AppHeader />
        <main class="page-surface">
            @if (!_suppressBody)
            {
                @Body
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    <div>
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
    </div>
    <a class="dismiss" role="button" aria-label="Dismiss error">🗙</a>
</div>

@code {
    private bool _suppressBody;

    protected override void OnInitialized()
    {
        UpdateBodyVisibility();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        UpdateBodyVisibility();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBodyVisibility()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + (relative?.Split('?', '#')[0] ?? string.Empty).TrimEnd('/');

        if (path == "/")
        {
            _suppressBody = false;
            return;
        }

        _suppressBody = UserAdminRoutes.IsUserAdminPath(path)
            || path == "/change-password"
            || path == "/change-password-question";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
