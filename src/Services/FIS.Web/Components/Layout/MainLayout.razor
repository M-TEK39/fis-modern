@inherits LayoutComponentBase
@using FIS.Web.Components.Pages.Users
@using FIS.Web.Services
@inject NavigationManager Navigation
@inject TokenService TokenService
@inject SidebarStateService SidebarState
@inject IJSRuntime JSRuntime

<div class="legacy-shell">
    <aside class="legacy-sidebar" aria-label="Primary navigation">
        <div class="legacy-sidebar-header">
            <NavLink class="legacy-brand legacy-brand-link" href="/home" Match="NavLinkMatch.All">
                <span class="brand-short">FIS</span>
                <p class="brand-line">Gauteng Provincial Government</p>
                <p class="brand-line strong">g-FleeT Management</p>
                <p class="brand-caption">Fleet Information System</p>
            </NavLink>
            <button class="sidebar-toggle sidebar-toggle-inline"
                    type="button"
                    @onclick="ToggleSidebar"
                    aria-label="Toggle sidebar">
                <i class="@(SidebarState.IsCollapsed ? "bx bx-menu-alt-right" : "bx bx-menu-alt-left")" aria-hidden="true"></i>
            </button>
        </div>

        <div class="legacy-nav-container">
            <NavMenu />
        </div>

        <SidebarFooter />
    </aside>

    <div class="legacy-main">
        <AppHeader />
        <main class="page-surface">
            @if (!_suppressBody)
            {
                @Body
            }
        </main>
    </div>
</div>
<button class="sidebar-mobile-scrim"
    type="button"
    @onclick="CloseSidebar"
    aria-label="Close sidebar"></button>

<div id="blazor-error-ui">
    <div>
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
    </div>
    <a class="dismiss" role="button" aria-label="Dismiss error">🗙</a>
</div>

@code {
    private bool _suppressBody;

    protected override void OnInitialized()
    {
        UpdateBodyVisibility();
        SidebarState.Changed += HandleSidebarStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore JWT token from ProtectedSessionStorage into the circuit-scoped
            // TokenService (and HttpContext.Items relay) after a page refresh.
            await TokenService.InitializeAsync();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        UpdateBodyVisibility();
        _ = InvokeAsync(async () =>
        {
            var isMobileViewport = await JSRuntime.InvokeAsync<bool>("fisLayout.isMobileViewport");
            if (isMobileViewport)
            {
                SidebarState.SetCollapsed(true);
            }

            StateHasChanged();
        });
    }

    private void UpdateBodyVisibility()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + (relative?.Split('?', '#')[0] ?? string.Empty).TrimEnd('/');

        if (path == "/")
        {
            _suppressBody = false;
            return;
        }

        _suppressBody = UserAdminRoutes.IsUserAdminPath(path)
            || path == "/change-password"
            || path == "/change-password-question";
    }

    private void ToggleSidebar()
    {
        SidebarState.Toggle();
    }

    private void CloseSidebar()
    {
        SidebarState.SetCollapsed(true);
    }

    private void HandleSidebarStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SidebarState.Changed -= HandleSidebarStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
