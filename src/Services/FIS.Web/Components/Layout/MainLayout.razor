@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="legacy-shell">
    <aside class="legacy-sidebar" aria-label="Primary navigation">
        <NavLink class="legacy-brand legacy-brand-link" href="/home" Match="NavLinkMatch.All">
            <span class="brand-short">FIS</span>
            <p class="brand-line">Gauteng Provincial Government</p>
            <p class="brand-line strong">g-FleeT Management</p>
            <p class="brand-caption">Fleet Information System</p>
        </NavLink>

        <div class="legacy-nav-container">
            <NavMenu />
        </div>

        <SidebarFooter />
    </aside>

    <div class="legacy-main">
        <AppHeader />
        <main class="page-surface">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    <div>
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
    </div>
    <a class="dismiss" role="button" aria-label="Dismiss error">🗙</a>
</div>
