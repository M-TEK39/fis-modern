@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FIS.Web.Services
@implements IDisposable

<nav class="legacy-nav" aria-label="Fleet navigation">
    @foreach (var group in NavigationGroups)
    {
        var expanded = IsGroupExpanded(group);
        var groupVisible = IsGroupVisible(group);
        if (groupVisible)
        {
            <div class="nav-group @(expanded ? "expanded" : "collapsed")">
                <button class="nav-group-toggle"
                        type="button"
                        aria-expanded="@expanded"
                        aria-controls="nav-group-@group.Id"
                        @onclick="() => ToggleGroup(group.Id)">
                    <span class="nav-group-title">
                        <i class="@group.Icon" aria-hidden="true"></i>
                        <span>@group.Title</span>
                    </span>
                    <i class="bx bx-chevron-down nav-group-chevron @(expanded ? "expanded" : "")" aria-hidden="true"></i>
                </button>

                @if (expanded)
                {
                    <ul id="nav-group-@group.Id" class="nav-list">
                        @foreach (var item in group.Items.Where(CanView))
                        {
                            <li class="@GetItemClasses(item)">
                                <NavLink class="legacy-link" ActiveClass="active" href="@item.Href" Match="@item.Match">
                                    <i class="@item.Icon" aria-hidden="true"></i>
                                    <span class="legacy-label">@item.Title</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    }
</nav>

@code {
    private sealed record NavItem(
        string Title,
        string Href,
        string Icon,
        long? RequiredPermission = null,
        NavLinkMatch Match = NavLinkMatch.Prefix);
    private sealed record NavGroup(string Id, string Title, string Icon, IReadOnlyList<NavItem> Items);

    private static readonly IReadOnlyList<NavGroup> NavigationGroups =
    [
        new("general", "General", "bx bx-grid-alt",
        [
        new("Home", "/home", "bx bx-home", Match: NavLinkMatch.All),
            new("Manuals", "/manuals", "bx bx-book")
        ]),
        new("fleet-ops", "Fleet Operations", "bx bx-car",
        [
            new("Vehicle Master", "/vehicles", "bx bx-car", LegacyPermissionBits.VehicleManagement),
            new("Vehicle Orders", "/vehicle-orders", "bx bx-cart", LegacyPermissionBits.VehicleManagement),
            new("Vehicle Photos", "/vehicle-photos", "bx bx-image", LegacyPermissionBits.VehicleManagement),
            new("Vehicle Asset Verification", "/vehicle-verification", "bx bx-clipboard", LegacyPermissionBits.VehicleManagement),
            new("Full Maintenance Lease", "/full-maintenance-lease", "bx bx-cog", LegacyPermissionBits.ContractManagement),
            new("Workshop", "/workshop", "bx bx-wrench", LegacyPermissionBits.Workshop),
            new("Job Cards", "/job-cards", "bx bx-id-card", LegacyPermissionBits.Workshop),
            new("Validation Data", "/validation-data", "bx bx-check-shield", LegacyPermissionBits.VehicleManagement)
        ]),
        new("trips-hire", "Trips & Hire", "bx bx-navigation",
        [
            new("Trips", "/trips", "bx bx-navigation", LegacyPermissionBits.VehicleManagement),
            new("Trip Authorities", "/trip-authorities", "bx bx-clipboard", LegacyPermissionBits.VehicleManagement),
            new("Trip Queries", "/trip-query", "bx bx-question-mark", LegacyPermissionBits.VehicleManagement),
            new("Private Hire", "/private-hire", "bx bx-car", LegacyPermissionBits.VehicleManagement),
            new("Taxis", "/taxis", "bx bx-taxi", LegacyPermissionBits.VehicleManagement),
            new("Third Party Rentals", "/third-party", "bx bx-building-house", LegacyPermissionBits.ContractManagement)
        ]),
        new("incidents", "Incidents & Compliance", "bx bx-shield-quarter",
        [
            new("Accidents", "/accidents", "bx bxs-car-crash", LegacyPermissionBits.VehicleManagement),
            new("Licenses", "/licenses", "bx bxs-user-badge", LegacyPermissionBits.VehicleManagement),
            new("Losses", "/losses", "bx bx-x-circle", LegacyPermissionBits.VehicleManagement)
        ]),
        new("finance", "Finance & Contracts", "bx bx-wallet",
        [
            new("Finance", "/finance", "bx bx-wallet", LegacyPermissionBits.Financial),
            new("Fuel Cards", "/fuel-cards", "bx bx-credit-card", LegacyPermissionBits.Financial),
            new("Tariff Calculator", "/tariff-calculator", "bx bx-calculator", LegacyPermissionBits.Financial),
            new("Reports", "/reports", "bx bx-file-find", LegacyPermissionBits.Reports),
            new("Auction", "/auction", "bx bx-dollar", LegacyPermissionBits.Financial)
        ]),
        new("logs", "Logs & Monitoring", "bx bx-pulse",
        [
            new("Log Books", "/log-books", "bx bx-notepad", LegacyPermissionBits.Reports),
            new("Log Sheets", "/log-sheets", "bx bx-table", LegacyPermissionBits.Reports),
            new("Monitor", "/monitor", "bx bx-line-chart", LegacyPermissionBits.Reports),
            new("Tracking", "/tracking", "bx bx-radar", LegacyPermissionBits.VehicleManagement)
        ]),
        new("admin", "Admin & Reference", "bx bx-user-circle",
        [
            new("Call Centre", "/call-centre", "bx bx-phone-call", LegacyPermissionBits.VehicleManagement),
            new("Troubleshoot", "/troubleshoot", "bx bx-wrench", LegacyPermissionBits.UserAdministration),
            new("Notice Management", "/notice-management", "bx bx-bell", LegacyPermissionBits.UserAdministration),
            new("Change Password", "/change-password", "bx bx-lock-open"),
            new("Change Password and Question", "/change-password-question", "bx bx-shield-quarter")
        ])
    ];

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject]
    private UserAccessContextService UserAccessContextService { get; set; } = default!;

    private string _currentPath = "/";
    private long _userAccessLevel;
    private readonly HashSet<string> _expandedGroups = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        UpdateCurrentPath();
        await LoadUserAccessLevelAsync();
        InitializeExpandedGroups();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        await LoadUserAccessLevelAsync();
        ExpandActiveGroup();
        StateHasChanged();
    }

    private async Task LoadUserAccessLevelAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            _userAccessLevel = 0;
            return;
        }

        var accessLevelClaim = user.FindFirst("access_level")?.Value;
        if (long.TryParse(accessLevelClaim, out var accessLevel))
        {
            _userAccessLevel = accessLevel;
            return;
        }

        var userAccessCodeClaim = user.FindFirst("user_access_code")?.Value;
        int.TryParse(userAccessCodeClaim, out var userAccessCode);
        var firstName = user.FindFirst(ClaimTypes.GivenName)?.Value;
        _userAccessLevel = await UserAccessContextService.EnsureAccessLevelAsync(
            userAccessCode > 0 ? userAccessCode : null,
            firstName);
    }

    private void UpdateCurrentPath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        _currentPath = Normalize(relative);
    }

    private static string Normalize(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        var trimmed = path.Trim('/');
        return "/" + trimmed;
    }

    private void InitializeExpandedGroups()
    {
        _expandedGroups.Clear();
        if (NavigationGroups.Count > 0)
        {
            _expandedGroups.Add(NavigationGroups[0].Id);
        }

        ExpandActiveGroup();
    }

    private void ExpandActiveGroup()
    {
        var activeGroup = NavigationGroups.Where(IsGroupVisible).FirstOrDefault(IsGroupActive);
        if (activeGroup is not null)
        {
            _expandedGroups.Add(activeGroup.Id);
        }
    }

    private bool IsGroupExpanded(NavGroup group)
    {
        return _expandedGroups.Contains(group.Id);
    }

    private void ToggleGroup(string groupId)
    {
        if (!_expandedGroups.Add(groupId))
        {
            _expandedGroups.Remove(groupId);
        }
    }

    private bool IsGroupActive(NavGroup group)
    {
        return group.Items.Any(item => CanView(item) && IsActive(item));
    }

    private bool IsGroupVisible(NavGroup group)
    {
        return group.Items.Any(CanView);
    }

    private string GetItemClasses(NavItem item)
    {
        var classes = new List<string> { "nav-item" };
        if (IsActive(item))
        {
            classes.Add("active");
        }

        return string.Join(" ", classes);
    }

    private bool CanView(NavItem item)
    {
        if (item.RequiredPermission is null)
        {
            return true;
        }

        return (_userAccessLevel & item.RequiredPermission.Value) == item.RequiredPermission.Value;
    }

    private bool IsActive(NavItem item)
    {
        if (item.Match == NavLinkMatch.All)
        {
            return string.Equals(_currentPath, item.Href, StringComparison.OrdinalIgnoreCase);
        }

        return _currentPath.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
