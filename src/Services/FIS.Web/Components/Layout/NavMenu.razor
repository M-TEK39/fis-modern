@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

<nav class="legacy-nav" aria-label="Fleet navigation">
    <ul class="nav-list">
        @foreach (var item in NavigationItems)
        {
            <li class="@GetItemClasses(item)">
                @if (item.Disabled)
                {
                    <span class="legacy-link disabled" role="link" aria-disabled="true">
                        <i class="@item.Icon" aria-hidden="true"></i>
                        <span class="legacy-label">@item.Title</span>
                    </span>
                }
                else
                {
                    <NavLink class="legacy-link" ActiveClass="active" href="@item.Href" Match="@item.Match">
                        <i class="@item.Icon" aria-hidden="true"></i>
                        <span class="legacy-label">@item.Title</span>
                    </NavLink>
                }
            </li>
        }
    </ul>
</nav>

@code {
    private sealed record NavItem(string Title, string Href, string Icon, bool Disabled = false, NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly IReadOnlyList<NavItem> NavigationItems =
    [
        new("Home", "/", "bx bx-home", Match: NavLinkMatch.All),
        new("Manuals", "/manuals", "bx bx-book", Disabled: true),
        new("Accidents", "/accidents", "bx bx-car-crash", Disabled: false),
        new("Auction", "/auction", "bx bx-gavel", Disabled: true),
        new("Call Centre", "/call-centre", "bx bx-phone-call", Disabled: true),
        new("Clearance", "/clearance", "bx bx-shield-quarter", Disabled: true),
        new("Contracts", "/contracts", "bx bx-file", Disabled: false),
        new("Finance", "/finance", "bx bx-wallet", Disabled: true),
        new("Fines", "/fines", "bx bx-receipt", Disabled: true),
        new("Fuel Cards", "/fuel-cards", "bx bx-credit-card", Disabled: true),
        new("Job Cards", "/job-cards", "bx bx-id-card", Disabled: true),
        new("Licenses", "/licenses", "bx bx-id-badge", Disabled: true),
        new("Log Books", "/log-books", "bx bx-notepad", Disabled: true),
        new("Log Sheets", "/log-sheets", "bx bx-table", Disabled: true),
        new("Losses", "/losses", "bx bx-x-circle", Disabled: true),
        new("Monitor", "/monitor", "bx bx-line-chart", Disabled: true),
        new("Private Hire", "/private-hire", "bx bx-car", Disabled: false),
        new("Reports", "/reports", "bx bx-file-find", Disabled: true),
        new("Driver & Authoriser Mgmt", "/drivers", "bx bx-id", Disabled: false),
        new("Taxis", "/taxis", "bx bx-taxi", Disabled: true),
        new("Third Party Rentals", "/third-party", "bx bx-building-house", Disabled: true),
        new("Towing", "/towing", "bx bx-anchor", Disabled: true),
        new("Tracking", "/tracking", "bx bx-radar", Disabled: true),
        new("Trips", "/trips", "bx bx-navigation", Disabled: false),
        new("Trip Authorities", "/trip-authorities", "bx bx-clipboard", Disabled: true),
        new("Troubleshoot", "/troubleshoot", "bx bx-wrench", Disabled: true),
        new("Validation Data", "/reference-data", "bx bx-check-shield", Disabled: false),
        new("Vehicle Asset Verification", "/vehicle-verification", "bx bx-clipboard-check", Disabled: true),
        new("Vehicle Master", "/vehicles", "bx bx-car-mechanic", Disabled: false),
        new("Full Maintenance Lease", "/full-maintenance-lease", "bx bx-cog", Disabled: true),
        new("Vehicle Photos", "/vehicle-photos", "bx bx-image", Disabled: true),
        new("User Admin", "/users", "bx bx-user-circle", Disabled: false),
        new("Notice Management", "/notice-management", "bx bx-bell", Disabled: true),
        new("Change Password", "/change-password", "bx bx-lock", Disabled: true),
        new("Change Password & Question", "/change-password-question", "bx bx-key", Disabled: true)
    ];

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private string _currentPath = "/";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateCurrentPath();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        StateHasChanged();
    }

    private void UpdateCurrentPath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        _currentPath = Normalize(relative);
    }

    private static string Normalize(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        var trimmed = path.Trim('/');
        return "/" + trimmed;
    }

    private string GetItemClasses(NavItem item)
    {
        var classes = new List<string> { "nav-item" };
        if (item.Disabled)
        {
            classes.Add("disabled");
        }

        if (IsActive(item))
        {
            classes.Add("active");
        }

        return string.Join(" ", classes);
    }

    private bool IsActive(NavItem item)
    {
        if (item.Match == NavLinkMatch.All)
        {
            return string.Equals(_currentPath, item.Href, StringComparison.OrdinalIgnoreCase);
        }

        return _currentPath.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
