@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<header class="app-header">
    <div class="app-header-left">
        <button class="sidebar-toggle" type="button" @onclick="ToggleSidebar" aria-label="Toggle sidebar">
            <i class="@(_isCollapsed ? "bx bx-menu-alt-right" : "bx bx-menu-alt-left")" aria-hidden="true"></i>
        </button>
        <div class="app-breadcrumbs">
            <div class="breadcrumb">
                @for (var index = 0; index < _breadcrumbs.Count; index++)
                {
                    var crumb = _breadcrumbs[index];
                    if (!crumb.IsCurrent)
                    {
                        <button class="breadcrumb-link" type="button" @onclick="() => NavigateTo(crumb.Href)">
                            @crumb.Title
                        </button>
                        <span class="breadcrumb-separator">/</span>
                    }
                    else
                    {
                        <span class="breadcrumb-current">@crumb.Title</span>
                    }
                }
            </div>
        </div>
    </div>
</header>

@code {
    private sealed record BreadcrumbItem(string Title, string Href, bool IsCurrent);

    private static readonly Dictionary<string, string> SegmentLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["home"] = "Home",
        ["vehicles"] = "Vehicle",
        ["vehicle"] = "Vehicle",
        ["create"] = "Create",
        ["form"] = "Create",
        ["edit"] = "Edit",
        ["details"] = "Details",
        ["detail"] = "Details",
        ["contracts"] = "Contracts",
        ["drivers"] = "Drivers",
        ["users"] = "Users",
        ["trips"] = "Trips",
        ["accidents"] = "Accidents",
        ["reference-data"] = "Reference Data",
        ["fuel-cards"] = "Fuel Cards",
        ["vehicle-orders"] = "Vehicle Orders",
        ["vehicle-photos"] = "Vehicle Photos",
        ["vehicle-verification"] = "Vehicle Verification",
        ["full-maintenance-lease"] = "Full Maintenance Lease",
        ["private-hire"] = "Private Hire",
        ["trip-authorities"] = "Trip Authorities",
        ["trip-query"] = "Trip Query",
        ["log-books"] = "Log Books",
        ["log-sheets"] = "Log Sheets",
        ["monitor"] = "Monitor",
        ["tracking"] = "Tracking",
        ["towing"] = "Towing",
        ["finance"] = "Finance",
        ["reports"] = "Reports",
        ["licenses"] = "Licenses",
        ["fines"] = "Fines",
        ["losses"] = "Losses",
        ["clearance"] = "Clearance",
        ["auction"] = "Auction",
        ["call-centre"] = "Call Centre",
        ["troubleshoot"] = "Troubleshoot",
        ["notice-management"] = "Notice Management",
        ["sites"] = "Sites",
        ["departments"] = "Departments",
        ["locations"] = "Locations",
        ["workshop"] = "Workshop",
        ["job-cards"] = "Job Cards",
        ["manuals"] = "Manuals",
        ["terms"] = "Terms"
    };

    private readonly List<BreadcrumbItem> _breadcrumbs = new();
    private bool _isCollapsed;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateBreadcrumbs();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyCollapsedStateAsync();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private void UpdateBreadcrumbs()
    {
        _breadcrumbs.Clear();
        _breadcrumbs.Add(new BreadcrumbItem("Home", "/home", false));

        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var basePath = relative.Split('?', '#')[0].Trim('/');

        if (string.IsNullOrWhiteSpace(basePath) || basePath.Equals("home", StringComparison.OrdinalIgnoreCase))
        {
            _breadcrumbs.Clear();
            _breadcrumbs.Add(new BreadcrumbItem("Home", "/home", true));
            return;
        }

        var segments = basePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var pathBuilder = "";
        for (var index = 0; index < segments.Length; index++)
        {
            var segment = segments[index];
            pathBuilder += "/" + segment;
            var title = ResolveTitle(segment);
            var isCurrent = index == segments.Length - 1;
            _breadcrumbs.Add(new BreadcrumbItem(title, pathBuilder, isCurrent));
        }

        if (_breadcrumbs.Count > 0)
        {
            var last = _breadcrumbs[^1];
            _breadcrumbs[^1] = new BreadcrumbItem(last.Title, last.Href, true);
            if (_breadcrumbs.Count > 1)
            {
                var home = _breadcrumbs[0];
                _breadcrumbs[0] = new BreadcrumbItem(home.Title, home.Href, false);
            }
        }
    }

    private static string ResolveTitle(string segment)
    {
        if (SegmentLabels.TryGetValue(segment, out var label))
        {
            return label;
        }

        var words = segment.Replace("-", " ").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < words.Length; i++)
        {
            var word = words[i];
            words[i] = word.Length switch
            {
                0 => word,
                1 => word.ToUpperInvariant(),
                _ => char.ToUpperInvariant(word[0]) + word[1..]
            };
        }

        return string.Join(" ", words);
    }

    private void NavigateTo(string href)
    {
        NavigationManager.NavigateTo(href);
    }

    private async Task ToggleSidebar()
    {
        _isCollapsed = !_isCollapsed;
        await ApplyCollapsedStateAsync();
    }

    private async Task ApplyCollapsedStateAsync()
    {
        await JSRuntime.InvokeVoidAsync("fisLayout.setSidebarCollapsed", _isCollapsed);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
