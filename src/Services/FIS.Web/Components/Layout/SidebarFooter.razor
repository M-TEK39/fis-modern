@rendermode InteractiveServer
@using System.Security.Claims
@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@using FIS.Web.Components.Pages.ChangePassword
@using FIS.Web.Components.Pages.ChangePasswordQuestion
@using FIS.Web.Components.Pages.Users
@using Microsoft.AspNetCore.WebUtilities
@using FIS.Web.Services
@inject AuthApiService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserProfileApiService UserProfileApiService
@inject UserAccessContextService UserAccessContextService
@implements IDisposable

<div class="sidebar-footer">
    <div class="sidebar-user" role="button" tabindex="0" @onclick="ToggleUserMenu">
        <span class="sidebar-avatar" aria-hidden="true">@_avatarText</span>
        <span class="sidebar-user-meta">
            <span class="sidebar-user-name">@_userDisplayName</span>
            <span class="sidebar-user-role">@_userPosition</span>
        </span>
        <button class="sidebar-notification" type="button" @onclick="ToggleNotifications" @onclick:stopPropagation="true">
            <i class="bx bx-bell" aria-hidden="true"></i>
            <span class="notification-count">3</span>
        </button>
    </div>

</div>

@if (_showUserMenu)
{
    <button class="overlay-scrim" type="button" @onclick="CloseOverlays" aria-label="Close menu"></button>
    <div class="sidebar-user-menu" role="menu" aria-label="User menu">
        <button class="sidebar-user-card" type="button" @onclick="OpenSettingsFromMenu">
            <span class="sidebar-avatar">@_avatarText</span>
            <div class="sidebar-user-meta">
                <span class="sidebar-user-name">@_userDisplayName</span>
                <span class="sidebar-user-role">@_userPosition</span>
            </div>
        </button>
        <div class="sidebar-user-section">
            <a class="sidebar-user-item" href="/terms" @onclick="CloseUserMenu">
                <i class="bx bx-help-circle" aria-hidden="true"></i>
                <span>Help</span>
            </a>
            <a class="sidebar-user-item" href="#" @onclick="CloseUserMenu">
                <i class="bx bx-book" aria-hidden="true"></i>
                <span>Docs</span>
            </a>
            <button class="sidebar-user-item" type="button" @onclick="OpenSettingsFromMenu">
                <i class="bx bx-cog" aria-hidden="true"></i>
                <span>Settings</span>
            </button>
        </div>
        <div class="sidebar-user-section">
            <button class="sidebar-user-item danger" type="button" @onclick="HandleLogout">
                <i class="bx bx-log-out" aria-hidden="true"></i>
                <span>Logout</span>
            </button>
        </div>
    </div>
}

@if (_showNotifications)
{
    <button class="overlay-scrim" type="button" @onclick="CloseOverlays" aria-label="Close notifications"></button>
    <aside class="notification-sheet" role="dialog" aria-label="Notifications">
        <div class="notification-sheet-header">
            <div>
                <h3>Notifications</h3>
                <p>3 unread</p>
            </div>
            <button class="icon-button" type="button" @onclick="CloseNotifications" aria-label="Close notifications">
                <i class="bx bx-x" aria-hidden="true"></i>
            </button>
        </div>
        <div class="notification-sheet-tabs">
            <button class="tab-button active" type="button">All</button>
            <button class="tab-button" type="button">Unread</button>
        </div>
        <div class="notification-list">
            @foreach (var item in _notifications)
            {
                <div class="notification-item @(item.IsUnread ? "unread" : "")">
                    <div class="notification-dot"></div>
                    <div>
                        <div class="notification-title">@item.Title</div>
                        <div class="notification-meta">@item.Meta</div>
                    </div>
                </div>
            }
        </div>
    </aside>
}

@if (_showSettings)
{
    <button class="overlay-scrim" type="button" @onclick="CloseOverlays" aria-label="Close settings"></button>
    <div class="settings-dialog" role="dialog" aria-label="Settings">
        <div class="settings-dialog-header">
            <div>
                <h2>Settings</h2>
                <p>Manage your preferences and admin tools</p>
            </div>
            <button class="icon-button" type="button" @onclick="CloseSettings" aria-label="Close settings">
                <i class="bx bx-x" aria-hidden="true"></i>
            </button>
        </div>
        <div class="settings-dialog-body">
            <nav class="settings-sidebar">
                @foreach (var navSection in VisibleSettingsSections)
                {
                    <button class="settings-nav-item @(navSection.Id == _activeSection ? "active" : "")"
                            type="button"
                            @onclick="() => SetActiveSection(navSection.Id)">
                        <i class="@navSection.Icon" aria-hidden="true"></i>
                        <span>@navSection.Title</span>
                    </button>
                }
            </nav>
            <div class="settings-content">
                @if (_activeSection == "profile")
                {
                    <div class="settings-section">
                        <h3>Profile</h3>
                        <p>Details loaded from legacy user profile (`user_access_old1`).</p>
                        <div class="settings-grid">
                            <div>
                                <label class="form-label">First Name</label>
                                <input class="form-input" value="@_profileFirstName" readonly />
                            </div>
                            <div>
                                <label class="form-label">Last Name</label>
                                <input class="form-input" value="@_profileLastName" readonly />
                            </div>
                            <div>
                                <label class="form-label">Email</label>
                                <input class="form-input" value="@_userEmail" readonly />
                            </div>
                            <div>
                                <label class="form-label">Telephone</label>
                                <input class="form-input" value="@(_profileTelephone ?? string.Empty)" readonly />
                            </div>
                            <div>
                                <label class="form-label">Site Code</label>
                                <input class="form-input" value="@(_profileSiteCode?.ToString() ?? string.Empty)" readonly />
                            </div>
                            <div>
                                <label class="form-label">User Access Code</label>
                                <input class="form-input" value="@(_profileUserAccessCode?.ToString() ?? string.Empty)" readonly />
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSection == "preferences")
                {
                    <div class="settings-section">
                        <h3>Preferences</h3>
                        <p>Control how the dashboard behaves for your workflow.</p>
                        <div class="settings-grid">
                            <div>
                                <label class="form-label">Default landing page</label>
                                <select class="form-select">
                                    <option>Fleet Operations</option>
                                    <option>Trips & Hire</option>
                                    <option>Finance & Contracts</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Density</label>
                                <select class="form-select">
                                    <option>Comfortable</option>
                                    <option>Compact</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSection == "notifications")
                {
                    <div class="settings-section">
                        <h3>Notifications</h3>
                        <p>Configure alert rules for incidents, approvals, and expiring documents.</p>
                        <div class="settings-grid">
                            <div>
                                <label class="form-label">Email alerts</label>
                                <select class="form-select">
                                    <option>Immediate</option>
                                    <option>Daily summary</option>
                                    <option>Off</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">In-app alerts</label>
                                <select class="form-select">
                                    <option>All</option>
                                    <option>Critical only</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSection == "security")
                {
                    <div class="settings-section">
                        <h3>Security</h3>
                        <p>Review access, session, and audit requirements.</p>
                        <div class="settings-card">
                            <p>Multi-factor authentication is enforced by corporate policy.</p>
                            <p>Session timeout: 30 minutes of inactivity.</p>
                        </div>
                    </div>
                }
                else if (_activeSection == "appearance")
                {
                    <div class="settings-section">
                        <h3>Appearance</h3>
                        <p>Customize the look and feel for your workspace.</p>
                        <div class="settings-grid">
                            <div>
                                <label class="form-label">Theme</label>
                                <select class="form-select">
                                    <option>System</option>
                                    <option>Dark</option>
                                    <option>Light</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Sidebar density</label>
                                <select class="form-select">
                                    <option>Standard</option>
                                    <option>Condensed</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSection == "user-admin")
                {
                    <UserAdminRouteContent RouteKey="@GetUserAdminRouteKey()" />
                }
                else if (_activeSection == "passwords")
                {
                    <ChangePasswordContent />
                }
                else if (_activeSection == "passwords-question")
                {
                    <ChangePasswordQuestionContent />
                }
                else if (_activeSection == "logs")
                {
                    <div class="settings-section">
                        <h3>System Logs</h3>
                        <p>Review activity and audit trails for compliance.</p>
                        <div class="settings-card">
                            <p>Log retention: 24 months.</p>
                            <p>Export audit logs by month or department.</p>
                        </div>
                    </div>
                }
                else if (_activeSection == "reports")
                {
                    <div class="settings-section">
                        <h3>System Reports</h3>
                        <p>Configure automated operational and compliance reporting.</p>
                        <div class="settings-card">
                            <p>Weekly compliance digest: Mondays 06:00.</p>
                            <p>Monthly fleet summary: 1st business day.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private sealed record NotificationItem(string Title, string Meta, bool IsUnread);
    private sealed record SettingsSection(string Id, string Title, string Icon);

    private bool _showNotifications;
    private bool _showSettings;
    private bool _showUserMenu;
    private string _activeSection = "profile";
    private string _userDisplayName = string.Empty;
    private string _userEmail = string.Empty;
    private string _userPosition = string.Empty;
    private string _profileFirstName = string.Empty;
    private string _profileLastName = string.Empty;
    private string? _profileTelephone;
    private short? _profileSiteCode;
    private short? _profileUserAccessCode;
    private string _avatarText = "AU";
    private bool _canAccessUserAdmin;
    private long _accessLevel;

    private readonly IReadOnlyList<NotificationItem> _notifications =
    [
        new("Accident report submitted", "Claim #AC-2198 · 2h ago", true),
        new("Trip authority expiring", "Trip #TA-447 · Tomorrow", true),
        new("Vehicle clearance approved", "Vehicle VMC-302 · 1 day ago", false),
        new("Workshop job closed", "Job Card #JC-811 · 2 days ago", false)
    ];

    private readonly IReadOnlyList<SettingsSection> _settingsSections =
    [
        new("profile", "Profile", "bx bx-user"),
        new("user-admin", "User Admin", "bx bx-user-circle"),
        new("passwords", "Change Password", "bx bx-key"),
        new("passwords-question", "Password & Question", "bx bx-shield"),
    ];

    private IEnumerable<SettingsSection> VisibleSettingsSections =>
        _settingsSections.Where(section => section.Id != "user-admin" || _canAccessUserAdmin);

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAsync();
        SyncSettingsWithRoute();
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        await UpdateUserInfoAsync(authState.User);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await UpdateUserInfoAsync(authState.User);
    }

    private async Task UpdateUserInfoAsync(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.Identity?.Name;
        var firstNameClaim = user.FindFirst(ClaimTypes.GivenName)?.Value;
        var lastNameClaim = user.FindFirst(ClaimTypes.Surname)?.Value;
        var positionClaim = user.FindFirst("position")?.Value
            ?? user.FindFirst(ClaimTypes.Role)?.Value;
        var userAccessCodeClaim = user.FindFirst("user_access_code")?.Value;
        int.TryParse(userAccessCodeClaim, out var userAccessCode);

        _userEmail = email ?? string.Empty;
        _userPosition = string.IsNullOrWhiteSpace(positionClaim) ? "Position not set" : positionClaim;
        _profileFirstName = firstNameClaim ?? string.Empty;
        _profileLastName = lastNameClaim ?? string.Empty;

        _accessLevel = await UserAccessContextService.EnsureAccessLevelAsync(
            userAccessCode > 0 ? userAccessCode : null,
            firstNameClaim);
        _canAccessUserAdmin = (_accessLevel & LegacyPermissionBits.UserAdministration) == LegacyPermissionBits.UserAdministration;

        if (userAccessCode > 0)
        {
            var profile = await UserProfileApiService.GetByUserAccessCodeAsync(userAccessCode);
            if (profile is not null)
            {
                _profileUserAccessCode = profile.UserAccessCode;
                _profileFirstName = profile.FirstName ?? _profileFirstName;
                _profileLastName = profile.LastName ?? _profileLastName;
                _userEmail = profile.Email ?? _userEmail;
                _profileTelephone = profile.Telephone;
                _profileSiteCode = profile.SiteCode;
                _userPosition = profile.PositionCode.HasValue
                    ? $"Position {profile.PositionCode.Value}"
                    : _userPosition;
            }
        }

        _userDisplayName = BuildDisplayName(_profileFirstName, _profileLastName, _userEmail);
        _avatarText = GetAvatarText(_profileFirstName, _profileLastName, _userEmail);

        if (!_canAccessUserAdmin && _activeSection == "user-admin")
        {
            _activeSection = "profile";
        }
    }

    private static string BuildDisplayName(string? firstName, string? lastName, string? email)
    {
        var combined = $"{firstName} {lastName}".Trim();
        if (!string.IsNullOrWhiteSpace(combined))
        {
            return combined;
        }

        return string.IsNullOrWhiteSpace(email) ? "User" : email;
    }

    private static string GetAvatarText(string? firstName, string? lastName, string? email)
    {
        var left = string.IsNullOrWhiteSpace(firstName) ? string.Empty : firstName.Trim()[..1];
        var right = string.IsNullOrWhiteSpace(lastName) ? string.Empty : lastName.Trim()[..1];
        var initials = $"{left}{right}".ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(initials))
        {
            return initials;
        }

        if (string.IsNullOrWhiteSpace(email))
        {
            return "U";
        }

        var trimmed = email.Trim();
        return trimmed.Length >= 2
            ? trimmed[..2].ToUpperInvariant()
            : trimmed[..1].ToUpperInvariant();
    }

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
        if (_showUserMenu)
        {
            _showNotifications = false;
            _showSettings = false;
        }
    }

    private void ToggleNotifications()
    {
        _showNotifications = !_showNotifications;
        if (_showNotifications)
        {
            _showSettings = false;
            _showUserMenu = false;
        }
    }

    private void OpenSettings(string sectionId)
    {
        _activeSection = sectionId;
        _showSettings = true;
        _showNotifications = false;
        _showUserMenu = false;
    }

    private void OpenSettingsFromMenu()
    {
        OpenSettings("profile");
    }

    private void OpenSettingsFromFooter()
    {
        OpenSettings("preferences");
    }

    private void SetActiveSection(string sectionId)
    {
        if (sectionId == "user-admin" && !_canAccessUserAdmin)
        {
            _activeSection = "profile";
            return;
        }

        _activeSection = sectionId;
    }

    private void CloseNotifications()
    {
        _showNotifications = false;
    }

    private void CloseSettings()
    {
        _showSettings = false;
    }

    private void CloseUserMenu()
    {
        _showUserMenu = false;
    }

    private void CloseOverlays()
    {
        _showNotifications = false;
        _showSettings = false;
        _showUserMenu = false;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        SyncSettingsWithRoute();
        await InvokeAsync(StateHasChanged);
    }

    private void SyncSettingsWithRoute()
    {
        var uri = new Uri(Navigation.Uri);
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + (relative?.Split('?', '#')[0] ?? string.Empty).TrimEnd('/');

        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("settings", out var settingsValue))
        {
            var settings = settingsValue.ToString();
            if (!string.IsNullOrWhiteSpace(settings))
            {
                if (settings.StartsWith("users", StringComparison.OrdinalIgnoreCase))
                {
                    _activeSection = _canAccessUserAdmin ? "user-admin" : "profile";
                }
                else if (settings.Equals("passwords", StringComparison.OrdinalIgnoreCase))
                {
                    _activeSection = "passwords";
                }
                else if (settings.Equals("passwords-question", StringComparison.OrdinalIgnoreCase))
                {
                    _activeSection = "passwords-question";
                }

                _showSettings = true;
                _showNotifications = false;
                _showUserMenu = false;
                return;
            }
        }

        if (path == "/")
        {
            return;
        }

        if (UserAdminRoutes.IsUserAdminPath(path))
        {
            _activeSection = _canAccessUserAdmin ? "user-admin" : "profile";
            _showSettings = true;
            _showNotifications = false;
            _showUserMenu = false;
            return;
        }

        if (path == "/change-password")
        {
            _activeSection = "passwords";
            _showSettings = true;
            _showNotifications = false;
            _showUserMenu = false;
            return;
        }

        if (path == "/change-password-question")
        {
            _activeSection = "passwords-question";
            _showSettings = true;
            _showNotifications = false;
            _showUserMenu = false;
        }
    }

    private string GetUserAdminRouteKey()
    {
        if (!_canAccessUserAdmin)
        {
            return UserAdminRoutes.Menu;
        }

        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("settings", out var settingsValue))
        {
            var settings = settingsValue.ToString();
            if (!string.IsNullOrWhiteSpace(settings)
                && settings.StartsWith("users", StringComparison.OrdinalIgnoreCase))
            {
                return UserAdminRoutes.FromPath("/" + settings.TrimStart('/'));
            }
        }

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + (relative?.Split('?', '#')[0] ?? string.Empty).TrimEnd('/');

        return UserAdminRoutes.IsUserAdminPath(path)
            ? UserAdminRoutes.FromPath(path)
            : UserAdminRoutes.Menu;
    }

    private async Task HandleLogout()
    {
        // Clear JWT token (if using legacy auth)
        await AuthService.LogoutAsync();

        // For Entra ID users, redirect to Microsoft logout
        // For JWT users, redirect to login
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
