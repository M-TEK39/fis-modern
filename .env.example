# Copy this file to .env and fill in real values — NEVER commit .env

# ── External Windows SQL Server ─────────────────────────────────────────────
# 192.0.2.10 is a documentation-only address. Set DB_HOST in the deployment
# .env file to the private address or DNS name of the Windows SQL Server.
DB_HOST=192.0.2.10
DB_PORT=1433
DB_NAME=legacy
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_ENCRYPT=False
DB_TRUST_SERVER_CERTIFICATE=True

# Optional direct ASP.NET override for non-Docker runs:
# ConnectionStrings__Default="Server=192.0.2.10,1433;Database=legacy;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=False;TrustServerCertificate=True;"

# ── API / Web URL overrides ─────────────────────────────────────────────────
ApiSettings__BaseUrl=http://localhost:5010
ApiSettings__WebBaseUrl=http://localhost:3000

# ── Microsoft Entra ID / Azure AD ───────────────────────────────────────────
AzureAd__TenantId=YOUR_TENANT_ID
AzureAd__ClientId=YOUR_CLIENT_ID
AzureAd__ClientSecret=YOUR_CLIENT_SECRET
AzureAd__CallbackPath=/signin-microsoft

# ── JWT (legacy auth) ────────────────────────────────────────────────────────
# Generate a strong random key: openssl rand -base64 64
JwtSettings__SecretKey=YOUR_JWT_SECRET_KEY
# Keep expiry enforcement disabled until the deployed legacy dates have been
# checked; when enabled, the API reads modern expiry data first and PWD_Expires
# from user_access_old1 when the modern data is unavailable.
JwtSettings__EnforcePasswordExpiry=False
JwtSettings__PasswordExpiryDays=30

# ── Email (Microsoft Exchange Online via Microsoft Graph / Entra ID) ────────
EmailSettings__Provider=MicrosoftGraph
EmailSettings__GraphEndpoint=https://graph.microsoft.com/v1.0
EmailSettings__GraphAuthentication=managed-identity
EmailSettings__GraphManagedIdentityClientId=YOUR_USER_ASSIGNED_MANAGED_IDENTITY_CLIENT_ID
EmailSettings__GraphSenderUserPrincipalName=YOUR_EXCHANGE_SENDER_MAILBOX
# For a non-Azure host, use client-secret authentication instead:
# EmailSettings__GraphAuthentication=client-secret
# EmailSettings__GraphTenantId=YOUR_TENANT_ID
# EmailSettings__GraphClientId=YOUR_CLIENT_ID
# EmailSettings__GraphClientSecret=YOUR_CLIENT_SECRET
EmailSettings__PasswordResetBaseUrl=https://YOUR_FIS_HOST
EmailSettings__PasswordResetTokenLifetimeMinutes=30

# ── Email delivery overrides (optional; Graph remains the safe default) ───────
# Key Vault is the only admin-editable configuration store. The API uses its
# managed identity in production or `az login` locally. Without it, settings
# are read from this deployment environment only and cannot be changed in FIS.
SystemSettings__KeyVaultUri=https://YOUR_KEY_VAULT_NAME.vault.azure.net/
# Session access tokens always remain 15 minutes. These refresh defaults apply
# when the user does not/does select "Remember me" respectively.
SystemSettings__SessionRefreshLifetimeMinutes=480
SystemSettings__RememberRefreshLifetimeMinutes=10080
# Optional explicit Entra feature flag. Leave unset to preserve the existing
# behavior (enabled when complete AzureAd credentials are present).
# SystemSettings__EntraEnabled=true
# Ordered primary/fallback list. Use Graph, Smtp, and/or SendGrid.
EmailDelivery__ProviderOrder__0=Graph
EmailDelivery__ProviderOrder__1=Smtp
EmailDelivery__TimeoutSeconds=30
EmailDelivery__Smtp__Host=smtp.YOUR_DOMAIN
EmailDelivery__Smtp__Port=587
# Required: StartTls or SslOnConnect. Plaintext SMTP is rejected.
EmailDelivery__Smtp__TlsMode=StartTls
# Use password for authenticated SMTP, none for an approved relay, or
# GoogleOAuth2 with the write-only OAuth values below.
EmailDelivery__Smtp__Authentication=password
EmailDelivery__Smtp__Username=YOUR_SMTP_USERNAME
EmailDelivery__Smtp__Password=YOUR_SMTP_PASSWORD
EmailDelivery__Smtp__FromAddress=YOUR_SENDER_EMAIL
EmailDelivery__Smtp__FromName=FIS - Fleet Information System
# Google SMTP OAuth 2.0 (only when Authentication is GoogleOAuth2).
# EmailDelivery__Smtp__Host=smtp.gmail.com
# EmailDelivery__Smtp__GoogleOAuthClientId=YOUR_GOOGLE_OAUTH_CLIENT_ID
# EmailDelivery__Smtp__GoogleOAuthClientSecret=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# EmailDelivery__Smtp__GoogleOAuthRefreshToken=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN

# ── SendGrid (optional fallback for every FIS email type) ────────────────────
SendGrid__ApiKey=YOUR_SENDGRID_API_KEY
SendGrid__FromEmail=YOUR_SENDER_EMAIL
SendGrid__FromName=FIS - Fleet Information System

# ── Local Docker SQL Server ─────────────────────────────────────────────────
# Set these in your shell before `pnpm db:start` / `pnpm dev`. They are for the
# disposable fis_dev container only, not the external production database.
MSSQL_SA_PASSWORD=YOUR_LOCAL_SQL_SERVER_PASSWORD
MSSQL_DB_NAME=fis_dev
MSSQL_HOST_PORT=1433
